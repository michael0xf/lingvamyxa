external:
    fn: main () int
        [128]: char buffer
        long: long_value 7
        size_t: size_value 9U
        double: double_value 1.5
        int: written

        written: c.snprintf(buffer, c.sizeof(buffer), "%ld %zu %s %f", long_value, size_value, "ok", double_value)
        return: written < 0
    end: main
end: external
