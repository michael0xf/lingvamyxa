        @: int valueExternal 0
        @: int valueExternalB 0
        @: int valueB 0
        @: int probeValue 0
        const: LmOwnAllocationDescriptor: descriptor 0
        int: status 0

        threadA: lm_message_thread_new()
        threadB: lm_message_thread_new()
        if: threadA = 0 || threadB = 0
            status: 1
        if: status = 0 && (lm_message_thread_arena_count(threadA) != 1U || lm_message_thread_arena_count(threadB) != 1U)
