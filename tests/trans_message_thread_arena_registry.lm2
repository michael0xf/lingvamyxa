            if: valueExternalB = 0
                status: 16
            else:
                valueExternalB[0]: 22
            ---
        ---

        if: threadA != 0
            lm_message_thread_delete(threadA)
            threadA: 0
            autoA1: 0
            autoA2: 0
            manualA: 0
        if: status = 0 && (valueB[0] != 21 || valueExternalB[0] != 22 || externalArena\owner_thread != threadB || lm_message_thread_arena_count(threadB) != 2U)
            status: 17

        if: status = 0
