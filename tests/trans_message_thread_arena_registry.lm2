        if: status = 0 && lm_message_thread_init(threadA) != 1
            status: 3
        if: status = 0 && lm_message_thread_arena_count(threadA) != 1U
            status: 4

        if: status = 0
            autoA1: c.lm_own_arena_new(threadA, threadA)
            autoA2: c.lm_own_arena_new(threadA, threadA)
            manualA: c.lm_own_arena_new(threadA, threadA)
            externalArena: cast: (LmOwnArena) lm_own_new_zero(c.sizeof(c.LmOwnArena))
            if: autoA1 = 0 || autoA2 = 0 || manualA = 0 || externalArena = 0 || c.lm_own_arena_init(threadA, externalArena, threadA) != 0
                status: 5
        ---
        if: status = 0 && (lm_message_thread_arena_count(threadA) != 5U || autoA1\runtime_owned_shell != 1 || autoA2\runtime_owned_shell != 1 || manualA\runtime_owned_shell != 1 || externalArena\runtime_owned_shell != 0)
            status: 6

        if: status = 0
            valueA1: cast: (@: int) c.lm_own_arena_array_new_zero(threadA, autoA1, c.sizeof(valueA1[0]), 1U, 1U, 0U)
            valueA2: cast: (@: int) c.lm_own_arena_array_new_zero(threadA, autoA2, c.sizeof(valueA2[0]), 1U, 1U, 0U)
            valueManual: cast: (@: int) c.lm_own_arena_array_new_zero(threadA, manualA, c.sizeof(valueManual[0]), 1U, 1U, 0U)
