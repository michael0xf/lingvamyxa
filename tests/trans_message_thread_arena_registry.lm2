            valueB: cast: (@: int) c.lm_own_arena_array_new_zero(threadB, lm_message_thread_owner(threadB), c.sizeof(valueB[0]), 1U, 1U, 0U)
            if: valueA1 = 0 || valueA2 = 0 || valueManual = 0 || valueExternal = 0 || valueB = 0
                status: 7
        ---
        if: status = 0
            valueA1[0]: 11
            valueA2[0]: 12
            valueManual[0]: 13
            valueExternal[0]: 14
            valueB[0]: 21
