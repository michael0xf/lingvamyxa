            probeValue: cast: (@: int) c.lm_own_arena_array_new_zero(probe, probeRoot, c.sizeof(probeValue[0]), 1U, 1U, 0U)
            if: probeRoot = 0 || probeChild = 0 || probeValue = 0 || lm_message_thread_arena_count(probe) != 2U
