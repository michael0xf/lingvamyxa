        if: status = 0
            c.lm_own_arena_destroy(threadA, externalArena)
            if: lm_message_thread_arena_count(threadA) != 3U || externalArena\owner_thread != 0 || externalArena\allocations != 0 || externalArena\allocation_descriptors != 0 || externalArena\lazy_edges != 0 || externalArena\registry_previous != 0 || externalArena\registry_next != 0 || externalArena\runtime_owned_shell != 0
