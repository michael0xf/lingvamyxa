        if: status = 0 && c.lm_own_arena_init(threadA, externalArena, threadA) != 1
            status: 8
        if: status = 0 && c.lm_own_arena_init(threadB, externalArena, threadB) != 1
            status: 9
        if: status = 0
            descriptor: c.lm_own_arena_allocation_descriptor(threadA, externalArena, valueExternal)
            if: descriptor = 0 || descriptor\owner != externalArena || valueExternal[0] != 14 || externalArena\owner_thread != threadA || lm_message_thread_arena_count(threadA) != 5U
                status: 10
        ---

        if: status = 0
            c.lm_own_arena_destroy(threadB, autoA1)
            c.lm_own_arena_delete(threadB, externalArena)
            c.lm_own_arena_destroy(threadA, autoA1)
            c.lm_own_arena_delete(threadA, externalArena)
            descriptor: c.lm_own_arena_allocation_descriptor(threadA, autoA1, valueA1)
            if: descriptor = 0 || valueA1[0] != 11 || externalArena\owner_thread != threadA || lm_message_thread_arena_count(threadA) != 5U
