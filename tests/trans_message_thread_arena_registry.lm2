            c.lm_own_arena_delete(probe, probeRoot)
            descriptor: c.lm_own_arena_allocation_descriptor(probe, probeRoot, probeValue)
            if: lm_message_thread_owner(probe) != probeRoot || lm_message_thread_arena_count(probe) != 2U || descriptor = 0 || probeValue[0] != 31 || lm_message_thread_status(probe) != 1
                status: 20
        ---
        lm_message_thread_delete(probe)
        probe: 0

        if: status = 0
            reusable: lm_own_new_zero(c.sizeof(c.LmMessageThread))
            if: reusable = 0 || lm_message_thread_init(reusable) != 0 || lm_message_thread_arena_count(reusable) != 1U || lm_message_thread_init(reusable) != 1
                status: 21
        ---
        if: reusable != 0
            lm_message_thread_destroy(reusable)
            if: status = 0 && (lm_message_thread_owner(reusable) != 0 || lm_message_thread_arena_count(reusable) != 0U)
                status: 22
            if: status = 0 && lm_message_thread_init(reusable) != 0
                status: 23
            lm_message_thread_destroy(reusable)
            lm_own_delete(reusable, 0)
            reusable: 0
        ---

        if: threadB != 0
            lm_message_thread_delete(threadB)
            threadB: 0
        if: status = 0 && (externalArena\owner_thread != 0 || externalArena\allocations != 0 || externalArena\allocation_descriptors != 0 || externalArena\lazy_edges != 0 || externalArena\registry_previous != 0 || externalArena\registry_next != 0 || externalArena\runtime_owned_shell != 0)
            status: 24
