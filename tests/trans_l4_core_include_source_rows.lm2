external:
    fn: main () int
        int: saved_errno c.errno
        size_t: incoming_message_length_offset c.offsetof(c.IncomingMessage, c.length)

        if: c.sizeof(c.CHAR_BIT) = 0U
            return: 1
        if: c.FLT_RADIX < 2
            return: 2
        if: c.sizeof(c.va_list) = 0U
            return: 3
        if: c.LC_ALL < 0
            return: 4
        if: saved_errno != c.errno
            return: 5
        if: c.CLOCKS_PER_SEC <= 0
            return: 6
        if: c.sizeof(c.SIG_DFL) = 0U
            return: 7
        c.assert(c.CHAR_BIT > 0)
        if: c.sizeof(c.bool) = 0U
            return: 8
        if: c.HUGE_VAL <= 0.0
            return: 9
        if: c.sizeof(c.WEOF) = 0U
            return: 10
        if: incoming_message_length_offset >= c.sizeof(c.IncomingMessage)
            return: 11
        if: c.INT8_MAX < 1
            return: 12
        if: c.isalpha('A') = 0
            return: 13
        return: 0
    end: main
end: external
