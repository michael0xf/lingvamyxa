define
prototype

external:
    fn: lm_test_stdcall (int: value) int
        if: value != 41
            return: 0
        return: 0
    end: lm_test_stdcall
end: external

external:
    fn: main () int
        return: c.LM_TEST_REQUIRE_POINTER(c.lm_test_stdcall(41)) != c.sizeof(int)
    end: main
end: external
