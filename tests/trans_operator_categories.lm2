L2:
    fn: take (int: value) int
        return: value
    end: take

    fn: add (int: left; int: right) int
        return: left + right
    end: add

    external:
        fn: main () int
            int: i 3
            int: mask 6
            int: result 0

            result: take(i--)
            if: result != 3 || i != 2
                return: 1

            result: take(--i)
            if: result != 1 || i != 1
                return: 2

            result: take(++i)
            if: result != 2 || i != 2
                return: 3

            result: take(-i) + take(+i) + take(~0)
            if: result != -1
                return: 4

            result: add(1 + (-1), -1)
            if: result != -1
                return: 5

            result: add(1+2, 4-1)
            if: result != 6
                return: 6

            result: take(1 + --i)
            if: result != 2 || i != 1
                return: 7

            result: take(1 + -1)
            if: result != 0
                return: 8

            result: take(mask & 3) + take(mask | 1) + take(mask ^ 3)
            if: result != 14
                return: 9

            result: take(1<<3) + take(16>>2)
            if: result != 12
                return: 10
            return: 0
        end: main
    end: external
end: L2
