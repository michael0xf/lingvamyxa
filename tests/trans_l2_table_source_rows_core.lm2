        lm_p0_document_destroy(document)
    if: conflict_document != 0
        lm_p0_document_destroy(conflict_document)
    if: unmarked_document != 0
        lm_p0_document_destroy(unmarked_document)
    lm_trans_registry_destroy()
return: status
