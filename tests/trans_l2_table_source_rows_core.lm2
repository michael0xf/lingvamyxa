import: "lm2/trans_library.lm2"

external:
    fn: main () int
        return: lm_test_l2_table_source_rows_core()
    end: main
end: external

fn: lm_test_l2_table_source_registry_init () int
    lm_trans_registry_destroy()
    if: lm_trans_registry_init() != 0
        return: 1
    lm_trans_registry\identifiers: lm_trans_identifier_table_new()
    lm_trans_registry\value_arena: lm_own_new_zero(c.sizeof(lm_trans_registry\value_arena[0]))
    if: lm_trans_registry\identifiers = 0 || lm_trans_registry\value_arena = 0 || lm_own_arena_init(lm_trans_registry\value_arena, c.lm_lmx_message_thread) != 0
        lm_trans_registry_destroy()
        return: 1
    lm_trans_registry\loaded: 1
    lm_trans_registry\view_mode: 2
return: 0

fn: lm_test_l2_table_source_root_frame (const: (LmP0Document: document)) const: LmP0Frame
    const: LmP0Node: root
    const: LmP0Field: field

    root: lm_p0_document_root(document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
    field: lm_trans_l2_structure_first_present_field(root\as\structure)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_l2_structure_next_present_field(field) != 0
        return: 0
return: field\value\as\frame

fn: lm_test_l2_table_source_column_is (
    const: (LmTableColumnDescriptor: column)
    const: @(char name)
    const: @(char type_name)
    size_t: address_depth
    size_t: array_rank
    int: is_const
) int
    const: @: char descriptor

    if: column = 0 || column\name = 0 || column\type_name = 0 || c.strcmp(column\name, name) != 0 || c.strcmp(column\type_name, type_name) != 0 || column\address_depth != address_depth || column\array_rank != array_rank || column\is_const != is_const || lm_table_column_descriptor_descriptor_count(column) != 1U
        return: 0
    descriptor: lm_table_column_descriptor_descriptor_at(column, 0U)
return: descriptor != 0 && c.strcmp(descriptor, type_name) = 0

fn: lm_test_l2_table_source_path_cell (
    const: @(char path)
    size_t: fact_index
    size_t: expected_column
    const: (LmTableDescriptor: expected_descriptor)
    const: (LmTableCell: expected_key)
    const: (LmTableCell: expected_cell)
) int
    const: LmTableDescriptor: descriptor
    const: LmTableCell: key_cell
    const: LmTableCell: cell
    size_t: column_index
    int: covered

    descriptor: 0
    key_cell: 0
    covered: 0
    cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, path, c.strlen(path), fact_index, @ descriptor, @ column_index, @ key_cell, @ covered)
return: covered != 0 && descriptor = expected_descriptor && column_index = expected_column && key_cell = expected_key && cell = expected_cell

fn: lm_test_l2_table_relation_count (const: @(char table)) size_t
    const: LmOwnPtrStack: rows

    rows: lm_trans_registry_relation_stack_for_table(table)
    if: rows = 0
        return: 0U
return: rows\count

