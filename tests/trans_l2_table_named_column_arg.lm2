L2:
    table:
        name: namedArgTable
        columns: (int(name: "id"; value: "5")) (const: (@: char label))
        rows:
                 42  "forty-two"
    end: namedArgTable

    external:
        fn: main () int
            if: namedArgTable = 0 || namedArgTable\ptr = 0 || namedArgTable\length != 1U || namedArgTable[0] = 0
                return: 1
            if: namedArgTable[0]\id != 42 || namedArgTable[0]\label[0] != 'f'
                return: 2
            return: 0
        end: main
    end: external
end: L2
