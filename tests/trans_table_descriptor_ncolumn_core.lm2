import: "lm2/table_descriptor.lm2"

fn: lm_test_ncolumn_add_column (
    LmTableDescriptor: table
    const: @(char name)
    const: @(char type_name)
    size_t: address_depth
    size_t: array_rank
    int: is_const
    const: @(char first_descriptor)
    const: @(char second_descriptor)
) int
    LmTableColumnDescriptor: column

    column: lm_table_column_descriptor_new_slice(name, c.strlen(name), type_name, c.strlen(type_name), address_depth, array_rank, is_const)
    if: column = 0
        return: 1
    if: first_descriptor != 0 && lm_table_column_descriptor_add_descriptor_slice(column, first_descriptor, c.strlen(first_descriptor)) != 0
        lm_table_column_descriptor_delete_any(column)
        return: 1
    if: second_descriptor != 0 && lm_table_column_descriptor_add_descriptor_slice(column, second_descriptor, c.strlen(second_descriptor)) != 0
        lm_table_column_descriptor_delete_any(column)
        return: 1
    if: lm_table_descriptor_take_column(table, column) != 0
        lm_table_column_descriptor_delete_any(column)
        return: 1
return: 0

fn: lm_test_ncolumn_schema (const: @(char name)) LmTableDescriptor
    LmTableDescriptor: table

    table: lm_table_descriptor_new_empty_slice(name, c.strlen(name))
    if: table = 0
        return: 0
    if: lm_test_ncolumn_add_column(table, "class", "class", 0U, 0U, 0, "key", 0) != 0 || lm_test_ncolumn_add_column(table, "left.part", "char", 1U, 0U, 1, "payload", "ordered.second") != 0 || lm_test_ncolumn_add_column(table, "right", "char", 1U, 0U, 0, "payload", 0) != 0 || lm_test_ncolumn_add_column(table, "body", "LmP0Node", 1U, 0U, 1, "node", 0) != 0
        lm_table_descriptor_delete_any(table)
        return: 0
return: table

fn: lm_test_ncolumn_take_cell (LmTableRow: row; const: @(char atom); const: @(char value); const: @(void node); const: @(void source); int: explicit_none) int
    LmTableCell: cell

    cell: lm_table_cell_new_cstr(atom, value, node, source, explicit_none)
    if: cell = 0
        return: 1
    if: lm_table_row_take_cell(row, cell) != 0
        lm_table_cell_delete_any(cell)
        return: 1
return: 0

fn: lm_test_ncolumn_add_row (
    LmTableDescriptor: table
    const: @(char key)
    const: @(char left_atom)
    const: @(char left_value)
    const: @(char right_atom)
    const: @(char right_value)
    const: @(char body_atom)
    const: @(void body_node)
) int
    LmTableRow: row

    row: lm_table_row_new(0)
    if: row = 0
        return: 1
    if: lm_test_ncolumn_take_cell(row, key, key, 0, table, 0) != 0 || lm_test_ncolumn_take_cell(row, left_atom, left_value, 0, table, left_atom != 0 && c.strcmp(left_atom, "None") = 0) != 0 || lm_test_ncolumn_take_cell(row, right_atom, right_value, 0, table, right_atom != 0 && c.strcmp(right_atom, "None") = 0) != 0 || lm_test_ncolumn_take_cell(row, body_atom, 0, body_node, table, body_atom != 0 && c.strcmp(body_atom, "None") = 0) != 0
        lm_table_row_delete_any(row)
        return: 1
    if: lm_table_descriptor_take_materialized_row(table, row) != 0
        lm_table_row_delete_any(row)
        return: 1
return: 0

fn: lm_test_source_path_has_key (const: (LmRegistryView: view); const: @(char path); const: @(char key); @: int out_covered) int
return: lm_registry_view_source_path_has_key_slice(view, path, c.strlen(path), key, c.strlen(key), out_covered)

fn: lm_test_source_path_key_at (const: (LmRegistryView: view); const: @(char path); size_t: index; @: int out_covered) const: @: char
return: lm_registry_view_source_path_key_at_slice(view, path, c.strlen(path), index, out_covered)

fn: lm_test_source_path_cell_at (
    const: (LmRegistryView: view)
    const: @(char path)
    size_t: index
    const: @(LmTableDescriptor out_descriptor)
    @: size_t out_column_index
    const: @(LmTableCell out_key_cell)
    @: int out_covered
) const: LmTableCell
return: lm_registry_view_source_path_cell_at_slice(view, path, c.strlen(path), index, out_descriptor, out_column_index, out_key_cell, out_covered)

