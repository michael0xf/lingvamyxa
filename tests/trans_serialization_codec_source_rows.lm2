define

L1:
===
#define lm_test_symbol_token 15

#if !defined(LM_TEST_CODEC_DIRECT) || LM_TEST_CODEC_DIRECT != 11
#error "direct serialization codec source row differs"
#endif

#if !defined(LM_TEST_CODEC_FALLBACK) || LM_TEST_CODEC_FALLBACK != 12
#error "wrong-schema serialization codec did not use the facade value"
#endif

#if !defined(LM_TEST_CODEC_JOINED) || LM_TEST_CODEC_JOINED != 13
#error "wide joined serialization codec source row differs"
#endif

#if !defined(LM_TEST_CODEC_DEFAULT) || LM_TEST_CODEC_DEFAULT != 14
#error "default serialization codec source row differs"
#endif

#if !defined(LM_TEST_CODEC_NUMERIC_FALLBACK) || LM_TEST_CODEC_NUMERIC_FALLBACK != 15
#error "wrong-schema numeric codec did not use the facade value"
#endif

#if !defined(LM_TEST_CODEC_LEGACY) || LM_TEST_CODEC_LEGACY != 16
#error "legacy N2 serialization codec source row differs"
#endif
===

