define

external:
    fn: main () int
        if: c.LM_TEST_CODEC_DIRECT != 11
            return: 1
        if: c.LM_TEST_CODEC_FALLBACK != 12
            return: 2
        if: c.LM_TEST_CODEC_JOINED != 13
            return: 3
        if: c.LM_TEST_CODEC_DEFAULT != 14
            return: 4
        if: c.LM_TEST_CODEC_NUMERIC_FALLBACK != 15
            return: 5
        if: c.LM_TEST_CODEC_LEGACY != 16
            return: 6
        return: 0
    end: main
end: external
