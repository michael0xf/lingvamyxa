predef: "lm2/own_abi.lm2"
include
alias
forward
constant
fn
layout
prototype

external:
    fn: main () int
        []: int values 4 1 2 3 4
        [][]: int matrix 2 2
            []: 1 2
            []: 3 4

        if: values = 0 || values\length != 4U
            return: 1
        if: values[0] != 1 || values[3] != 4
            return: 2
        if: matrix = 0 || matrix\length != 4U
            return: 3
        return: 0
    end: main
end: external
