include: "trans_l2_table_structure_cell.support.h"

table:
    name: pointTable
    columns((Point: point) (int: tag))
    rows:
             Point:
                 x: 3
                 y: 4
             11
end: pointTable

external:
    fn: main () int
        if: pointTable\point\x != 3
            return: 1
        if: pointTable\tag != 11
            return: 2
        return: 0
    end: main
end: external
