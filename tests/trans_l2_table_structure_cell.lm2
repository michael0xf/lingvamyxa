table:
    source
    name: class
    columns: (class: class) (class: kind)
    rows:
             Point  layout
end: class

table:
    source
    name: Point
    columns: (class: class) (class: `field.class`)  (size_t: `field.index`)  (size_t: `field.address-depth`)
    rows:
             x  int  0  0
             y  int  1  0
end: Point

table:
    source
    name: `layout.backend`
    columns: (class: class) (class: backend)
    rows:
             Point  c.struct
end: `layout.backend`

table:
    source
    name: `class.reference-base`
    columns: (class: class) (int: value)
    rows:
             Point  1
end: `class.reference-base`

include: "trans_l2_table_structure_cell.support.h"

table:
    name: pointTable
    columns: (Point: point) (int: tag)
    rows:
             Point:
                 x: 3
                 y: 4
             11
end: pointTable

external:
    fn: main () int
        if: pointTable = 0 || pointTable\ptr = 0 || pointTable\length != 1U || pointTable[0] = 0 || pointTable[0]\point = 0
            return: 1
        if: pointTable[0]\point\x != 3 || pointTable[0]\point\y != 4
            return: 2
        if: pointTable[0]\tag != 11
            return: 3
        return: 0
    end: main
end: external
