L2:
    RecursiveShape:
        RecursiveShape: next
        int: value
    end: RecursiveShape

    external:
        fn: main () int
            RecursiveShape: recursiveShape
                next: 0
                value: 2
            end: recursiveShape
            return: recursiveShape = 0 || recursiveShape\next != 0 || recursiveShape\value != 2
        end: main
    end: external
end: L2
