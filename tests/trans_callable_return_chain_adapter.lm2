import: "lm2/own.lm2"

table:
    source
    name: `fn.thread-context.none`
    columns((class: class) (int: value))
    rows:
             delete_factory 1
end: `fn.thread-context.none`

fn: delete_factory () LmOwnDelete
    return: c.free
end: delete_factory

external:
    fn: main () int
        LmOwnPtrStack: stack

        stack: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
        if: stack = 0
            return: 1
        lm_own_ptr_stack_init(stack; delete_factory)
        lm_own_ptr_stack_destroy(stack)
        lm_own_delete(stack, 0)
        return: 0
    end: main
end: external
