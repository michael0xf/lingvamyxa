import: "lm2/trans_library.lm2"

external:
    fn: main () int
        return: lm_test_generated_abi_return_source_rows_core()
    end: main
end: external

fn: lm_test_generated_return_fact_at (size_t: index) LmTransRegistryFact
    const: LmRegistryViewRow: row

    row: lm_registry_view_fact_at(lm_trans_registry\view, index)
    if: row = 0 || row\source = 0
        return: 0
return: cast: (LmTransRegistryFact) row\source

fn: lm_test_generated_return_fact_is (
    const: (LmTransRegistryFact: fact)
    const: @(char table)
    const: @(char payload)
) int
return: fact != 0 && fact\table != 0 && c.strcmp(fact\table, table) = 0 && fact\key != 0 && c.strcmp(fact\key, "return") = 0 && fact\payload != 0 && c.strcmp(fact\payload, payload) = 0

fn: lm_test_generated_return_column_is (
    const: (LmTableColumnDescriptor: column)
    const: @(char name)
    const: @(char type_name)
    const: @(char descriptor)
) int
    const: @: char actual_descriptor

    if: column = 0 || column\name = 0 || column\type_name = 0 || c.strcmp(column\name, name) != 0 || c.strcmp(column\type_name, type_name) != 0 || lm_table_column_descriptor_descriptor_count(column) != 1U
        return: 0
    actual_descriptor: lm_table_column_descriptor_descriptor_at(column, 0U)
return: actual_descriptor != 0 && c.strcmp(actual_descriptor, descriptor) = 0

fn: lm_test_generated_return_path_cell_is (
    const: @(char path)
    const: (LmTransRegistryFact: fact)
) int
    const: LmTableCell: key_cell
    const: LmTableCell: value_cell
    int: covered

    key_cell: 0
    covered: 0
    value_cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, path, c.strlen(path), 0U, 0, 0, @ key_cell, @ covered)
    if: covered = 0 || key_cell = 0 || key_cell\value = 0 || key_cell\source != 0 || c.strcmp(key_cell\value, "return") != 0 || value_cell = 0 || value_cell\value = 0 || value_cell\source != fact || value_cell\value = fact\payload || c.strcmp(value_cell\value, fact\payload) != 0
        return: 0
return: 1

fn: lm_test_abi_return_take_explicit_source (
    const: @(char owner_name)
    const: @(char key_descriptor)
    const: @(char class_descriptor)
    const: (LmTransRegistryFact: class_fact)
    const: @(LmTableCell out_key_cell)
    const: @(LmTableCell out_class_cell)
) int
    LmTableDescriptor: descriptor
    LmTableRow: row
    LmTableCell: key_cell
    LmTableCell: class_cell
    LmTableCell: address_depth_cell
    LmTableCell: selected_key_cell
    LmTableCell: selected_class_cell
    int: status

    if: owner_name = 0 || key_descriptor = 0 || class_descriptor = 0 || class_fact = 0 || class_fact\key = 0 || class_fact\payload = 0 || out_key_cell = 0 || out_class_cell = 0
        return: 1
    out_key_cell[0]: 0
    out_class_cell[0]: 0

    descriptor: lm_table_descriptor_new_empty_slice(owner_name, c.strlen(owner_name))
    row: 0
    key_cell: 0
    class_cell: 0
    address_depth_cell: 0
    selected_key_cell: 0
    selected_class_cell: 0
    status: 0
    if: descriptor = 0 || lm_table_descriptor_add_column(descriptor, "class", key_descriptor) != 0 || lm_table_descriptor_add_column(descriptor, "return.class", class_descriptor) != 0 || lm_table_descriptor_add_column(descriptor, "return.address-depth", "size_t") != 0
        status: 1

    if: status = 0
        row: lm_table_row_new(0)
        key_cell: lm_table_cell_new_cstr(class_fact\key, class_fact\key, 0, 0, 0)
        class_cell: lm_table_cell_new_cstr(class_fact\payload, class_fact\payload, 0, class_fact, 0)
        address_depth_cell: lm_table_cell_new_cstr("None", 0, 0, 0, 1)
        selected_key_cell: key_cell
        selected_class_cell: class_cell
        if: row = 0 || key_cell = 0 || class_cell = 0 || address_depth_cell = 0
            status: 1
    ---

    if: status = 0
        if: lm_table_row_take_cell(row, key_cell) != 0
            status: 1
        else:
            key_cell: 0
    ---
    if: status = 0
        if: lm_table_row_take_cell(row, class_cell) != 0
            status: 1
        else:
            class_cell: 0
    ---
    if: status = 0
        if: lm_table_row_take_cell(row, address_depth_cell) != 0
            status: 1
        else:
            address_depth_cell: 0
    ---
    if: status = 0
        if: lm_table_descriptor_take_materialized_row(descriptor, row) != 0
            status: 1
        else:
            row: 0
    ---
    if: status = 0
        if: lm_registry_view_take_local_source_table(lm_trans_registry\view, descriptor) != 0
            status: 1
        else:
            descriptor: 0
            out_key_cell[0]: selected_key_cell
            out_class_cell[0]: selected_class_cell
    ---

    lm_table_cell_delete_any(address_depth_cell)
    lm_table_cell_delete_any(class_cell)
    lm_table_cell_delete_any(key_cell)
    lm_table_row_delete_any(row)
    lm_table_descriptor_delete_any(descriptor)
return: status

fn: lm_test_abi_return_explicit_source_reader () int
    LmP0Text: wide_owner
    LmP0Text: wide_key
    LmP0Text: wide_class
    LmP0Text: wrong_owner
    LmP0Text: wrong_key
    LmP0Text: wrong_class
    LmTransL4CallableType: resolved_type
    LmTransRegistryFact: wide_class_fact
    LmTransRegistryFact: wrong_class_fact
    const: LmTableCell: wide_key_cell
    const: LmTableCell: wide_class_cell
    const: LmTableCell: wrong_key_cell
    const: LmTableCell: wrong_class_cell
    const: LmTableCell: covered_cell
    const: LmTableCell: resolved_cell
    const: LmTableCell: resolved_key_cell
    int: covered
    int: status

    wide_owner: lm_trans_text_from_cstr("LmExplicitAbiReturn")
    wide_key: lm_trans_text_from_cstr("return")
    wide_class: lm_trans_text_from_cstr("long")
    wrong_owner: lm_trans_text_from_cstr("LmWrongAbiReturn")
    wrong_key: lm_trans_text_from_cstr("return")
    wrong_class: lm_trans_text_from_cstr("int")
    resolved_type: lm_trans_expr_callable_type_new()
    wide_class_fact: 0
    wrong_class_fact: 0
    wide_key_cell: 0
    wide_class_cell: 0
    wrong_key_cell: 0
    wrong_class_cell: 0
    resolved_key_cell: 0
    status: 0
    if: wide_owner = 0 || wide_key = 0 || wide_class = 0 || wrong_owner = 0 || wrong_key = 0 || wrong_class = 0 || resolved_type = 0
        status: 1

    if: status = 0 && lm_trans_registry_push_owner_relation_text_with_fact(wide_owner, ".return.class", wide_key, wide_class, @ wide_class_fact) != 0
        status: 1
    if: status = 0 && lm_test_abi_return_take_explicit_source("LmExplicitAbiReturn", "class", "class", wide_class_fact, @ wide_key_cell, @ wide_class_cell) != 0
        status: 1

    if: status = 0 && lm_trans_registry_push_owner_relation_text_with_fact(wrong_owner, ".return.class", wrong_key, wrong_class, @ wrong_class_fact) != 0
        status: 1
    if: status = 0 && lm_test_abi_return_take_explicit_source("LmWrongAbiReturn", "class", "char", wrong_class_fact, @ wrong_key_cell, @ wrong_class_cell) != 0
        status: 1

    lm_trans_registry\view_mode: 0
    if: status = 0 && lm_trans_callable_descriptor_return_type(0, wide_owner, resolved_type) = 0
        status: 1
    if: status = 0 && (resolved_type\class_name = 0 || resolved_type\class_name\data != wide_class_fact\payload || lm_trans_text_equals(resolved_type\class_name, "long") = 0 || resolved_type\address_depth != 0U || resolved_type\is_const != 0)
        status: 1

    lm_trans_registry\view_mode: 1
    if: status = 0 && lm_trans_callable_descriptor_return_type(0, wide_owner, resolved_type) = 0
        status: 1
    if: status = 0 && (resolved_type\class_name = 0 || resolved_type\class_name\data != wide_class_fact\payload || lm_trans_text_equals(resolved_type\class_name, "long") = 0 || resolved_type\address_depth != 0U || resolved_type\is_const != 0)
        status: 1

    lm_trans_registry\view_mode: 2
    resolved_cell: lm_trans_abi_source_text_cell(0, "LmExplicitAbiReturn.return.class", "class", wide_class_fact, @ resolved_key_cell)
    if: status = 0 && (resolved_cell != wide_class_cell || resolved_key_cell != wide_key_cell)
        status: 1
    if: status = 0 && lm_trans_callable_descriptor_return_type(0, wide_owner, resolved_type) = 0
        status: 1
    if: status = 0 && (resolved_type\class_name = 0 || resolved_type\class_name\data != wide_class_cell\value || resolved_type\class_name\data = wide_class_fact\payload || lm_trans_text_equals(resolved_type\class_name, "long") = 0 || resolved_type\address_depth != 0U || resolved_type\is_const != 0)
        status: 1

    covered: 0
    covered_cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, "LmWrongAbiReturn.return.class", c.strlen("LmWrongAbiReturn.return.class"), 0U, 0, 0, 0, @ covered)
    resolved_key_cell: wrong_key_cell
    resolved_cell: lm_trans_abi_source_text_cell(0, "LmWrongAbiReturn.return.class", "class", wrong_class_fact, @ resolved_key_cell)
    if: status = 0 && (covered = 0 || covered_cell != wrong_class_cell || resolved_cell != 0 || resolved_key_cell != 0)
        status: 1
    if: status = 0 && lm_trans_callable_descriptor_return_type(0, wrong_owner, resolved_type) = 0
        status: 1
    if: status = 0 && (resolved_type\class_name = 0 || resolved_type\class_name\data != wrong_class_fact\payload || resolved_type\class_name\data = wrong_class_cell\value || lm_trans_text_equals(resolved_type\class_name, "int") = 0 || resolved_type\address_depth != 0U || resolved_type\is_const != 0)
        status: 1

    lm_trans_expr_callable_type_delete(resolved_type)
    lm_trans_text_ref_destroy(@ wrong_class)
    lm_trans_text_ref_destroy(@ wrong_key)
    lm_trans_text_ref_destroy(@ wrong_owner)
    lm_trans_text_ref_destroy(@ wide_class)
    lm_trans_text_ref_destroy(@ wide_key)
    lm_trans_text_ref_destroy(@ wide_owner)
return: status

fn: lm_test_generated_abi_return_source_rows_core () int
    LmP0Text: scalar_name
    LmP0Text: pointer_name
    LmTransL4CallableType: scalar_type
    LmTransL4CallableType: pointer_type
    LmTransL4CallableType: resolved_type
    LmTransRegistryFact: scalar_class_fact
    LmTransRegistryFact: pointer_class_fact
    LmTransRegistryFact: pointer_depth_fact
    LmTransRegistryFact: pointer_const_fact
    const: LmTableDescriptor: descriptor
    const: LmTableRow: row
    const: LmTableCell: cell
    const: LmTableCell: scalar_source_key_cell
    const: LmTableCell: scalar_source_class_cell
    const: LmTableCell: pointer_source_key_cell
    const: LmTableCell: pointer_source_class_cell
    const: LmTableCell: resolved_cell
    const: LmTableCell: resolved_key_cell
    LmOwnPtrStack: selected_keys
    const: @: char source_key
    const: @: char resolved_class
    size_t: resolved_depth
    size_t: i
    int: resolved_const
    int: covered
    int: status

    lm_trans_registry_destroy()
    if: lm_trans_registry_init() != 0
        return: 1
    lm_trans_registry\identifiers: lm_trans_identifier_table_new()
    lm_trans_registry\value_arena: lm_own_new_zero(c.sizeof(lm_trans_registry\value_arena[0]))
    if: lm_trans_registry\identifiers = 0 || lm_trans_registry\value_arena = 0 || lm_own_arena_init(lm_trans_registry\value_arena, c.lm_lmx_message_thread) != 0
        lm_trans_registry_destroy()
        return: 1
    lm_trans_registry\loaded: 1
    lm_trans_registry\view_mode: 2

    scalar_name: lm_trans_text_from_cstr("LmGeneratedScalarReturn")
    pointer_name: lm_trans_text_from_cstr("LmGeneratedPointerReturn")
    scalar_type: lm_trans_expr_callable_type_new()
    pointer_type: lm_trans_expr_callable_type_new()
    resolved_type: lm_trans_expr_callable_type_new()
    selected_keys: 0
    scalar_source_key_cell: 0
    scalar_source_class_cell: 0
    pointer_source_key_cell: 0
    pointer_source_class_cell: 0
    resolved_key_cell: 0
    status: 0
    if: scalar_name = 0 || pointer_name = 0 || scalar_type = 0 || pointer_type = 0 || resolved_type = 0
        status: 1

    if: status = 0 && lm_trans_text_assign_cstr(scalar_type\class_name, "int") = 0
        status: 1
    if: status = 0
        pointer_type\address_depth: 1U
        pointer_type\is_const: 1
        if: lm_trans_text_assign_cstr(pointer_type\class_name, "char") = 0
            status: 1
    ---

    if: status = 0 && (lm_trans_registry_note_class_present(scalar_name) != 0 || lm_trans_registry_note_class_present(scalar_type\class_name) != 0 || lm_trans_registry_materialize_fn_descriptor_return(scalar_name, scalar_type) != 0)
        status: 1
    if: status = 0 && (lm_trans_registry_note_class_present(pointer_name) != 0 || lm_trans_registry_note_class_present(pointer_type\class_name) != 0 || lm_trans_registry_materialize_fn_descriptor_return(pointer_name, pointer_type) != 0)
        status: 1

    scalar_class_fact: lm_test_generated_return_fact_at(2U)
    pointer_class_fact: lm_test_generated_return_fact_at(5U)
    pointer_depth_fact: lm_test_generated_return_fact_at(6U)
    pointer_const_fact: lm_test_generated_return_fact_at(7U)
    if: status = 0 && (lm_trans_registry\loaded_fact_count != 8U || lm_registry_view_fact_count(lm_trans_registry\view) != 8U || lm_registry_view_source_table_count(lm_trans_registry\view) != 2U)
        status: 1
    if: status = 0 && (lm_test_generated_return_fact_is(scalar_class_fact, "LmGeneratedScalarReturn.return.class", "int") = 0 || lm_test_generated_return_fact_is(pointer_class_fact, "LmGeneratedPointerReturn.return.class", "char") = 0 || lm_test_generated_return_fact_is(pointer_depth_fact, "LmGeneratedPointerReturn.return.address-depth", "1") = 0 || lm_test_generated_return_fact_is(pointer_const_fact, "LmGeneratedPointerReturn.return.const", "1") = 0)
        status: 1

    i: 0U
    while: status = 0 && i < 2U
        descriptor: lm_registry_view_source_table_at(lm_trans_registry\view, i)
        if: descriptor = 0 || descriptor\name = 0 || lm_table_descriptor_column_count(descriptor) != 4U || lm_table_descriptor_materialized_row_count(descriptor) != 1U || lm_test_generated_return_column_is(lm_table_descriptor_column_at(descriptor, 0U), "name", "class", "class") = 0 || lm_test_generated_return_column_is(lm_table_descriptor_column_at(descriptor, 1U), "class", "class", "class") = 0 || lm_test_generated_return_column_is(lm_table_descriptor_column_at(descriptor, 2U), "address-depth", "size_t", "size_t") = 0 || lm_test_generated_return_column_is(lm_table_descriptor_column_at(descriptor, 3U), "const", "int", "int") = 0
            status: 1
            break
        if: (i = 0U && c.strcmp(descriptor\name, "LmGeneratedScalarReturn.return") != 0) || (i = 1U && c.strcmp(descriptor\name, "LmGeneratedPointerReturn.return") != 0)
            status: 1
            break
        row: lm_table_descriptor_materialized_row_at(descriptor, 0U)
        if: row = 0 || row\local_sequence != 0U || lm_table_row_cell_count(row) != 4U
            status: 1
            break
        i: i + 1U

    if: status = 0
        descriptor: lm_registry_view_source_table_at(lm_trans_registry\view, 0U)
        row: lm_table_descriptor_materialized_row_at(descriptor, 0U)
        cell: lm_table_row_cell_at(row, 2U)
        if: cell = 0 || cell\atom = 0 || c.strcmp(cell\atom, "None") != 0 || cell\value != 0 || cell\node != 0 || cell\source != 0 || cell\explicit_none = 0
            status: 1
        cell: lm_table_row_cell_at(row, 3U)
        if: cell = 0 || cell\atom = 0 || c.strcmp(cell\atom, "None") != 0 || cell\value != 0 || cell\node != 0 || cell\source != 0 || cell\explicit_none = 0
            status: 1
    ---

    if: status = 0 && (lm_test_generated_return_path_cell_is("LmGeneratedScalarReturn.return.class", scalar_class_fact) = 0 || lm_test_generated_return_path_cell_is("LmGeneratedPointerReturn.return.class", pointer_class_fact) = 0 || lm_test_generated_return_path_cell_is("LmGeneratedPointerReturn.return.address-depth", pointer_depth_fact) = 0 || lm_test_generated_return_path_cell_is("LmGeneratedPointerReturn.return.const", pointer_const_fact) = 0)
        status: 1

    covered: 0
    scalar_source_class_cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, "LmGeneratedScalarReturn.return.class", c.strlen("LmGeneratedScalarReturn.return.class"), 0U, 0, 0, @ scalar_source_key_cell, @ covered)
    if: status = 0 && (covered = 0 || scalar_source_key_cell = 0 || scalar_source_class_cell = 0)
        status: 1
    covered: 0
    pointer_source_class_cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, "LmGeneratedPointerReturn.return.class", c.strlen("LmGeneratedPointerReturn.return.class"), 0U, 0, 0, @ pointer_source_key_cell, @ covered)
    if: status = 0 && (covered = 0 || pointer_source_key_cell = 0 || pointer_source_class_cell = 0)
        status: 1

    resolved_cell: lm_trans_abi_source_text_cell(0, "LmGeneratedPointerReturn.return.class", "class", pointer_class_fact, @ resolved_key_cell)
    if: status = 0 && (resolved_cell != pointer_source_class_cell || resolved_key_cell != pointer_source_key_cell)
        status: 1

    if: status = 0
        covered: 0
        if: lm_registry_view_source_path_has_key_slice(lm_trans_registry\view, "LmGeneratedScalarReturn.return.address-depth", c.strlen("LmGeneratedScalarReturn.return.address-depth"), "return", 6U, @ covered) != 0 || covered = 0
            status: 1
        covered: 0
        if: lm_registry_view_source_path_has_key_slice(lm_trans_registry\view, "LmGeneratedScalarReturn.return.const", c.strlen("LmGeneratedScalarReturn.return.const"), "return", 6U, @ covered) != 0 || covered = 0
            status: 1
        covered: 1
        if: lm_registry_view_source_path_has_rows(lm_trans_registry\view, "LmGeneratedSub.return.class", @ covered) != 0 || covered != 0
            status: 1
    ---

    if: status = 0
        selected_keys: lm_trans_namespace_registry_source_relation_keys_new(0, pointer_name, "return.class")
        covered: 0
        source_key: lm_registry_view_source_path_key_at_slice(lm_trans_registry\view, "LmGeneratedPointerReturn.return.class", c.strlen("LmGeneratedPointerReturn.return.class"), 0U, @ covered)
        if: selected_keys = 0 || selected_keys\count != 1U || covered = 0 || source_key = 0 || lm_own_ptr_stack_at(selected_keys, 0U) != source_key || source_key = pointer_class_fact\key
            status: 1
    ---

    resolved_class: pointer_class_fact\payload
    resolved_depth: 99U
    resolved_const: 1
    if: status = 0 && (lm_trans_collect_abi_return(0, "LmGeneratedPointerReturn", -1, @ resolved_class, @ resolved_depth, @ resolved_const) != 3 || resolved_class != 0 || resolved_depth != 0U || resolved_const != 0)
        status: 1
    resolved_class: pointer_class_fact\payload
    resolved_depth: 99U
    resolved_const: 1
    if: status = 0 && (lm_trans_collect_abi_return(0, "LmGeneratedPointerReturn", 3, @ resolved_class, @ resolved_depth, @ resolved_const) != 3 || resolved_class != 0 || resolved_depth != 0U || resolved_const != 0)
        status: 1

    lm_trans_registry\view_mode: 0
    if: status = 0 && lm_trans_collect_abi_return(0, "LmGeneratedPointerReturn", 2, @ resolved_class, @ resolved_depth, @ resolved_const) != 0
        status: 1
    if: status = 0 && (resolved_class != pointer_class_fact\payload || c.strcmp(resolved_class, "char") != 0 || resolved_depth != 1U || resolved_const = 0)
        status: 1
    if: status = 0 && lm_trans_callable_descriptor_return_type(0, pointer_name, resolved_type) = 0
        status: 1
    if: status = 0 && (resolved_type\class_name = 0 || resolved_type\class_name\data != pointer_class_fact\payload || lm_trans_text_equals(resolved_type\class_name, "char") = 0 || resolved_type\address_depth != 1U || resolved_type\is_const = 0)
        status: 1

    lm_trans_registry\view_mode: 1
    if: status = 0 && lm_trans_collect_abi_return(0, "LmGeneratedPointerReturn", 2, @ resolved_class, @ resolved_depth, @ resolved_const) != 0
        status: 1
    if: status = 0 && (resolved_class != pointer_class_fact\payload || c.strcmp(resolved_class, "char") != 0 || resolved_depth != 1U || resolved_const = 0)
        status: 1
    if: status = 0 && lm_trans_callable_descriptor_return_type(0, pointer_name, resolved_type) = 0
        status: 1
    if: status = 0 && (resolved_type\class_name = 0 || resolved_type\class_name\data != pointer_class_fact\payload || lm_trans_text_equals(resolved_type\class_name, "char") = 0 || resolved_type\address_depth != 1U || resolved_type\is_const = 0)
        status: 1

    lm_trans_registry\view_mode: 2
    if: status = 0 && lm_trans_collect_abi_return(0, "LmGeneratedPointerReturn", 2, @ resolved_class, @ resolved_depth, @ resolved_const) != 0
        status: 1
    if: status = 0 && (resolved_class != pointer_source_class_cell\value || resolved_class = pointer_class_fact\payload || c.strcmp(resolved_class, "char") != 0 || resolved_depth != 1U || resolved_const = 0)
        status: 1
    if: status = 0 && lm_trans_callable_descriptor_return_type(0, pointer_name, resolved_type) = 0
        status: 1
    if: status = 0 && (resolved_type\class_name = 0 || resolved_type\class_name\data != pointer_source_class_cell\value || resolved_type\class_name\data = pointer_class_fact\payload || lm_trans_text_equals(resolved_type\class_name, "char") = 0 || resolved_type\address_depth != 1U || resolved_type\is_const = 0)
        status: 1
    if: status = 0 && lm_trans_callable_descriptor_return_type(0, scalar_name, resolved_type) = 0
        status: 1
    if: status = 0 && (resolved_type\class_name = 0 || resolved_type\class_name\data != scalar_source_class_cell\value || resolved_type\class_name\data = scalar_class_fact\payload || lm_trans_text_equals(resolved_type\class_name, "int") = 0 || resolved_type\address_depth != 0U || resolved_type\is_const != 0)
        status: 1

    if: status = 0 && lm_test_abi_return_explicit_source_reader() != 0
        status: 1

    if: status = 0 && (lm_trans_registry_assert_source_table_materialization() != 0 || lm_trans_registry_assert_view_parity() != 0)
        status: 1

    lm_trans_ptr_stack_delete(@ selected_keys)
    lm_trans_expr_callable_type_delete(resolved_type)
    lm_trans_expr_callable_type_delete(pointer_type)
    lm_trans_expr_callable_type_delete(scalar_type)
    lm_trans_text_ref_destroy(@ pointer_name)
    lm_trans_text_ref_destroy(@ scalar_name)
    lm_trans_registry_destroy()
return: status
