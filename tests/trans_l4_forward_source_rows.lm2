include: "trans_l4_forward_source_rows.support.h"

fn: lm_test_forward_source_rows () int
    c.struct: c.LmTestForwardLayout value
    c.struct: c.LmTestForwardJoined joined
    c.struct: c.LmTestForwardSchemaFallback fallback
    c.struct: c.LmTestForwardWideLayout wide
    c.union: c.LmTestForwardWideBackendOverlay wide_overlay
    c.struct: c.LmTestForwardWidePhysical wide_physical
    c.struct: c.LmTestForwardWideJoined wide_joined
    c.struct: c.LmTestForwardWideSchemaFallback wide_fallback
    LmTestForwardWideOtherOnly: wide_other 33
    LmTestForwardWideNone: wide_none 35
    LmTestForwardNone: absent 23

    c.value.value: 17
    c.joined.value: 19
    c.fallback.value: 21
    c.wide.value: 23
    c.wide_overlay.value: 25
    c.wide_physical.value: 27
    c.wide_joined.value: 29
    c.wide_fallback.value: 31
    return: c.value.value != 17 || c.joined.value != 19 || c.fallback.value != 21 || c.wide.value != 23 || c.wide_overlay.value != 25 || c.wide_physical.value != 27 || c.wide_joined.value != 29 || c.wide_fallback.value != 31 || wide_other != 33 || wide_none != 35 || absent != 23
end: lm_test_forward_source_rows

external:
    fn: main () int
        return: lm_test_forward_source_rows()
    end: main
end: external
