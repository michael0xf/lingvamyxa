include: "<stddef.h>" "<string.h>"
layout

fn: lm_test_layout_source_rows () int
    c.struct: c.LmTestSourceDepth depth
    c.struct: c.LmTestSourceQualified qualified
    c.struct: c.LmTestSourceJoined joined
    c.struct: c.LmTestSourceOuter outer
    c.struct: c.LmTestSourceWideArray wide_array
    c.struct: c.LmTestSourceWideOuter wide_outer

    c.depth.value: 7
    c.depth.next: 0
    c.qualified.text: "ok"
    c.qualified.value: 11
    c.joined.value: "joined"
    c.outer.items[1].value: 13
    c.wide_array.values[2]: 17
    c.wide_outer.items[1].value: 19
    if: c.offsetof(c.LmTestSourceOrdered, c.early) != 0U || c.offsetof(c.LmTestSourceOrdered, c.late) != 1U
        return: 1
    if: c.depth.value != 7 || c.depth.next != 0
        return: 2
    if: c.strcmp(c.qualified.text, "ok") != 0 || c.qualified.value != 11
        return: 3
    if: c.strcmp(c.joined.value, "joined") != 0
        return: 4
    if: c.offsetof(c.LmTestSourceOverlay, c.middle) != 0U || c.offsetof(c.LmTestSourceOverlay, c.tail) != 1U || c.offsetof(c.LmTestSourceOverlay, c.first) != 2U
        return: 5
    if: c.outer.items[1].value != 13
        return: 6
    if: c.wide_array.values[2] != 17 || c.wide_outer.items[1].value != 19
        return: 7
    return: 0
end: lm_test_layout_source_rows

external:
    fn: main () int
        return: lm_test_layout_source_rows()
    end: main
end: external
