layout

L1:
===
#include <stddef.h>
#include <string.h>

static int lm_test_layout_source_rows(void) {
    LmTestSourceDepth depth = { 7, 0 };
    LmTestSourceQualified qualified = { "ok", 11 };
    LmTestSourceOuter outer = { 0 };

    outer.items[1].value = 13;
    if (offsetof(LmTestSourceOrdered, early) != 0U ||
        offsetof(LmTestSourceOrdered, late) != 1U) {
        return 1;
    }
    if (depth.value != 7 || depth.next != 0) {
        return 2;
    }
    if (strcmp(qualified.text, "ok") != 0 || qualified.value != 11) {
        return 3;
    }
    if (offsetof(LmTestSourceOverlay, middle) != 0U ||
        offsetof(LmTestSourceOverlay, tail) != 1U ||
        offsetof(LmTestSourceOverlay, first) != 2U) {
        return 4;
    }
    if (outer.items[1].value != 13) {
        return 5;
    }
    return 0;
}
