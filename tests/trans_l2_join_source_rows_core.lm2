    target_native: lm_table_descriptor_materialized_row_at(target, 1U)
    target_source_b: lm_table_descriptor_materialized_row_at(target, 2U)
    target_direct: lm_table_descriptor_materialized_row_at(target, 3U)
    if: status = 0 && (source_a_first = 0 || source_a_native = 0 || source_b_first = 0 || middle_first = 0 || middle_native = 0 || middle_source_b = 0 || middle_direct = 0 || target_first = 0 || target_native = 0 || target_source_b = 0 || target_direct = 0)
        status: 1
    if: status = 0 && (source_a_first\source != 0 || source_a_native\source != 0 || source_b_first\source != 0 || middle_first\source != source_a_first || middle_native\source != source_a_native || middle_source_b\source != source_b_first || middle_direct\source != 0 || target_first\source != middle_first || target_native\source != middle_native || target_source_b\source != middle_source_b || target_direct\source != middle_direct)
        status: 1
    if: status = 0 && (source_a_first\source_native != 0 || source_a_native\source_native = 0 || middle_first\source_native != 0 || middle_native\source_native = 0 || target_first\source_native != 0 || target_native\source_native = 0)
        status: 1

    source_label: lm_table_row_cell_at(source_a_first, 1U)
    middle_label: lm_table_row_cell_at(middle_first, 1U)
    target_label: lm_table_row_cell_at(target_first, 1U)
    native_key: lm_table_row_cell_at(target_native, 0U)
    native_label: lm_table_row_cell_at(target_native, 1U)
    native_body: lm_table_row_cell_at(target_native, 2U)
    if: status = 0 && (source_label = 0 || middle_label = 0 || target_label = 0 || source_label = middle_label || middle_label = target_label || source_label\value = 0 || c.strcmp(source_label\value, "a") != 0 || middle_label\value = 0 || c.strcmp(middle_label\value, "a") != 0 || target_label\value = 0 || c.strcmp(target_label\value, "a") != 0)
        status: 1
    if: status = 0 && (native_key = 0 || native_key\value = 0 || c.strcmp(native_key\value, "nativeKey") != 0 || native_label = 0 || native_label\value != 0 || native_label\node = 0 || native_body = 0 || native_body\value != 0 || native_body\node = 0)
        status: 1

    covered: 0
    projected_covered: 0
    if: status = 0 && (lm_registry_view_source_path_has_key_slice(lm_trans_registry\view, "target.label", 12U, "nativeKey", 9U, @ covered) = 0 || covered = 0 || lm_registry_view_source_path_has_key_slice_mode(lm_trans_registry\view, "target.label", 12U, "nativeKey", 9U, 1, @ projected_covered) != 0 || projected_covered = 0)
        status: 1
    if: status = 0 && (lm_test_l2_join_relation_count("middle.label") != 3U || lm_test_l2_join_relation_count("middle.body") != 3U || lm_test_l2_join_relation_count("target.label") != 3U || lm_test_l2_join_relation_count("target.body") != 3U)
        status: 1

    alpha: lm_trans_text_from_cstr("alpha")
    source_fact: cast: (const: LmTransRegistryFact) source_label\source
    middle_fact: lm_trans_registry_lookup_row_in_identifiers(lm_trans_registry\identifiers, alpha, "middle.label")
    target_fact: lm_trans_registry_lookup_row_in_identifiers(lm_trans_registry\identifiers, alpha, "target.label")
    if: status = 0 && (alpha = 0 || source_fact = 0 || middle_fact = 0 || target_fact = 0 || middle_fact\source != source_fact || target_fact\source != middle_fact || lm_trans_registry_fact_has_source(target_fact, source_fact) = 0)
