    if: status = 0 && (lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, "class", 5U) != 0 || lm_trans_declare_l2_join(namespace_, conflict_frame) = 0)
        status: 1
    if: status = 0 && (lm_trans_registry\loaded_fact_count != loaded_fact_count || lm_registry_view_fact_count(lm_trans_registry\view) != view_fact_count || lm_registry_view_source_table_count(lm_trans_registry\view) != source_table_count || lm_trans_registry\view\mutation_generation != mutation_generation || lm_registry_view_class_count(lm_trans_registry\view) != class_count || lm_test_l2_join_relation_count("class") != class_relation_count || lm_test_l2_join_relation_count("class.kind") != class_kind_relation_count || lm_test_l2_join_relation_count("class.present") != class_present_relation_count || lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, "class", 5U) != 0)
        status: 1

    if: status = 0 && lm_test_l2_join_missing_source(namespace_) != 0
        status: 1
    if: status = 0 && lm_test_l2_join_incompatible_schema(namespace_) != 0
        status: 1
    if: status = 0 && lm_test_l2_join_facade_only_kind_conflict(namespace_) != 0
        status: 1
    if: status = 0 && lm_test_l2_join_emitter_is_source_only(namespace_) != 0
        status: 1
    if: status = 0 && lm_test_l2_join_self_snapshot(namespace_) != 0
        status: 1

    saved_native_label_node: cast: (const: LmP0Node) native_label\node
    lm_trans_namespace_delete(namespace_)
    namespace_: 0
    lm_p0_document_destroy(document)
    document: 0
    saved_native_label_field: 0
    if: saved_native_label_node != 0 && saved_native_label_node\kind = c.LM_P0_NODE_FRAME
        saved_native_label_field: lm_trans_l2_structure_first_present_field(saved_native_label_node\as\frame\body)
    if: status = 0 && (saved_native_label_node = 0 || saved_native_label_node\kind != c.LM_P0_NODE_FRAME || lm_trans_text_equals(saved_native_label_node\as\frame\head, "nativeLabel") = 0 || saved_native_label_field = 0 || saved_native_label_field\value = 0 || saved_native_label_field\value\kind != c.LM_P0_NODE_ATOM || lm_trans_text_equals(saved_native_label_field\value\as\atom, "nestedLabel") = 0)
        status: 1

    if: status = 0 && (lm_trans_registry_assert_source_table_materialization() != 0 || lm_trans_registry_assert_view_parity() != 0)
        status: 1

    lm_trans_text_ref_destroy(@ alpha)
    lm_trans_namespace_delete(namespace_)
    if: document != 0
        lm_p0_document_destroy(document)
    lm_trans_registry_destroy()
return: status
