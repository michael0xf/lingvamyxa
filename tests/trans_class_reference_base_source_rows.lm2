include: "trans_class_reference_base_source_rows.support.h"
layout

fn: lm_test_class_reference_base_source_rows () int
    c.struct: c.LmTestClassReferenceBasePhysicalScalars scalars
    c.struct: c.LmTestClassReferenceBase value

    c.scalars.direct: 7
    c.scalars.fallback: 8
    c.scalars.joined: 9.0f
    c.value.direct: @ c.scalars.direct
    c.value.fallback: @ c.scalars.fallback
    c.value.joined: @ c.scalars.joined
    return: c.value.direct[0] != 7 || c.value.fallback[0] != 8 || c.value.joined[0] != 9.0f
end: lm_test_class_reference_base_source_rows

fn: lm_test_reference_direct (short: value) int
    return: value != 0
end: lm_test_reference_direct

fn: lm_test_reference_fallback (long: value) int
    return: value != 0
end: lm_test_reference_fallback

fn: lm_test_reference_joined (float: value) int
    return: value != 0
end: lm_test_reference_joined

external:
    fn: main () int
        return: lm_test_class_reference_base_source_rows() || lm_test_reference_direct(0) || lm_test_reference_fallback(0) || lm_test_reference_joined(0)
    end: main
end: external
