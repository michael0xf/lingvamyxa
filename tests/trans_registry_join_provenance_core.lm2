fn: lm_test_registry_push_value_fact (
    const: @(char table_name)
    const: @(char key)
    const: @(char payload)
    const: (LmTransRegistryFact: source)
) LmTransRegistryFact
    LmP0Text: table_text
    LmP0Text: key_text
    LmP0Text: payload_text
    const: LmRegistryViewRow: view_row
    int: status

    table_text: lm_trans_text_from_cstr(table_name)
    key_text: lm_trans_text_from_cstr(key)
    payload_text: lm_trans_text_from_cstr(payload)
    if: table_text = 0 || key_text = 0 || payload_text = 0
        lm_trans_text_ref_destroy(@ table_text)
        lm_trans_text_ref_destroy(@ key_text)
        lm_trans_text_ref_destroy(@ payload_text)
        return: 0

    if: source != 0
        status: lm_trans_registry_push_row_values_from(table_text, key_text, payload_text, source)
    else:
        status: lm_trans_registry_push_row_values(table_text, key_text, payload_text)

    lm_trans_text_ref_destroy(@ table_text)
    lm_trans_text_ref_destroy(@ key_text)
    lm_trans_text_ref_destroy(@ payload_text)
    if: status != 0 || lm_trans_registry = 0 || lm_trans_registry\view = 0 || lm_trans_registry\loaded_fact_count = 0U
        return: 0

    view_row: lm_registry_view_fact_at(lm_trans_registry\view, lm_trans_registry\loaded_fact_count - 1U)
    if: view_row = 0
        return: 0
return: cast: (LmTransRegistryFact) view_row\source

fn: lm_test_registry_node_new (const: @(char spelling)) LmP0Node
    LmP0Text: spelling_text
    LmP0Node: node

    if: spelling = 0
        return: 0

    spelling_text: lm_trans_text_from_cstr(spelling)
    if: spelling_text = 0
        return: 0
    node: lm_trans_registry_synthetic_atom_node(spelling_text)
    lm_trans_text_ref_destroy(@ spelling_text)
return: node

fn: lm_test_registry_push_node_fact (
    const: @(char table_name)
    const: @(char key)
    const: (LmP0Node: payload_node)
    const: (LmTransRegistryFact: source)
) LmTransRegistryFact
    LmP0Text: table_text
    LmP0Text: key_text
    const: LmRegistryViewRow: view_row
    int: status

    table_text: lm_trans_text_from_cstr(table_name)
    key_text: lm_trans_text_from_cstr(key)
    if: table_text = 0 || key_text = 0 || payload_node = 0
        lm_trans_text_ref_destroy(@ table_text)
        lm_trans_text_ref_destroy(@ key_text)
        return: 0

    if: source != 0
        status: lm_trans_registry_push_row_node_values_from(table_text, key_text, payload_node, source)
    else:
        status: lm_trans_registry_push_row_node_values(table_text, key_text, payload_node)

    lm_trans_text_ref_destroy(@ table_text)
    lm_trans_text_ref_destroy(@ key_text)
    if: status != 0 || lm_trans_registry = 0 || lm_trans_registry\view = 0 || lm_trans_registry\loaded_fact_count = 0U
        return: 0

    view_row: lm_registry_view_fact_at(lm_trans_registry\view, lm_trans_registry\loaded_fact_count - 1U)
    if: view_row = 0
        return: 0
return: cast: (LmTransRegistryFact) view_row\source

fn: lm_test_registry_join_fact (const: @(char source_table); const: @(char target_table); const: @(char key)) LmTransRegistryFact
    LmP0Text: source_text
    LmP0Text: target_text
    LmP0Text: key_text
    LmTransRegistryFact: fact

    source_text: lm_trans_text_from_cstr(source_table)
    target_text: lm_trans_text_from_cstr(target_table)
    key_text: lm_trans_text_from_cstr(key)
    fact: 0
    if: source_text != 0 && target_text != 0 && key_text != 0 && lm_trans_registry_join_table(source_text, target_text) = 0
        fact: lm_trans_registry_lookup_row_in_identifiers(lm_trans_registry\identifiers, key_text, target_table)
    ---
    lm_trans_text_ref_destroy(@ source_text)
    lm_trans_text_ref_destroy(@ target_text)
    lm_trans_text_ref_destroy(@ key_text)
return: fact

