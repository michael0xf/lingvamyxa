L2:
    table:
        name: first
        columns: (const: (@: char text))
        rows:
                 "ok"
    end: first

    table:
        name: second
        columns: (const: (@: char text))
        rows:
                 (first[0]\text)
    end: second

    external:
        fn: main () int
            return: c.strcmp(second[0]\text; "ok") != 0
        end: main
    end: external
end: L2
