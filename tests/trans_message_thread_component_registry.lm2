sub: lm_test_component_destroy (LmTestThreadComponent: component)
    if: component != 0
        if: component\observer != 0
            if: lm_message_thread_owner(c.lm_lmx_message_thread) = 0
                component\observer[0]: -1
            else:
                component\observer[0]: component\observer[0] * 10 + component\marker
            ---
        lm_own_delete(component, 0)
end: lm_test_component_destroy

sub: lm_test_component_destroy_a (@: void component)
    lm_test_component_destroy(component)
end: lm_test_component_destroy_a

sub: lm_test_component_destroy_b (@: void component)
    lm_test_component_destroy(component)
end: lm_test_component_destroy_b

fn: lm_test_component_new (@: int observer; int: marker) LmTestThreadComponent
    LmTestThreadComponent: component

    component: lm_own_new_zero(c.sizeof(component[0]))
    if: component != 0
        component\observer: observer
        component\marker: marker
return: component

external:
    fn: main () int
        LmMessageThread: threadA 0
        LmMessageThread: threadB 0
        @: void reusable 0
        LmTestThreadComponent: a1 0
        LmTestThreadComponent: a2 0
        LmTestThreadComponent: aDuplicate 0
        LmTestThreadComponent: b1 0
        LmTestThreadComponent: b2 0
        LmTestThreadComponent: reusableComponent 0
        int: orderA 0
        int: orderB 0
        int: orderReusable 0
        int: status 0

        threadA: lm_message_thread_new()
        threadB: lm_message_thread_new()
        if: threadA = 0 || threadB = 0
            status: 1
        if: status = 0 && (lm_message_thread_component_count(threadA) != 0U || lm_message_thread_component_count(threadB) != 0U)
            status: 2

        if: status = 0
            a1: lm_test_component_new(@ orderA, 1)
            a2: lm_test_component_new(@ orderA, 2)
            aDuplicate: lm_test_component_new(@ orderA, 9)
            b1: lm_test_component_new(@ orderB, 3)
            b2: lm_test_component_new(@ orderB, 4)
            if: a1 = 0 || a2 = 0 || aDuplicate = 0 || b1 = 0 || b2 = 0
                status: 3
        ---

        if: status = 0 && c.lm_message_thread_component_attach(threadA, @ lm_test_component_destroy_a, a1) != 0
            status: 4
        if: status = 0
            a1: 0
        if: status = 0 && c.lm_message_thread_component_attach(threadA, @ lm_test_component_destroy_b, a2) != 0
            status: 5
        if: status = 0
            a2: 0
        if: status = 0 && c.lm_message_thread_component_attach(threadB, @ lm_test_component_destroy_a, b1) != 0
            status: 6
        if: status = 0
            b1: 0
        if: status = 0 && c.lm_message_thread_component_attach(threadB, @ lm_test_component_destroy_b, b2) != 0
            status: 7
        if: status = 0
            b2: 0

        if: status = 0 && c.lm_message_thread_component_attach(threadA, @ lm_test_component_destroy_a, aDuplicate) != 1
            status: 8
        if: status = 0 && (lm_message_thread_component_count(threadA) != 2U || lm_message_thread_component_count(threadB) != 2U)
            status: 9
        if: status = 0 && (c.lm_message_thread_component_get(threadA, @ lm_test_component_destroy_a) = 0 || c.lm_message_thread_component_get(threadA, @ lm_test_component_destroy_b) = 0 || c.lm_message_thread_component_get(threadB, @ lm_test_component_destroy_a) = 0 || c.lm_message_thread_component_get(threadB, @ lm_test_component_destroy_b) = 0)
            status: 10
        if: status = 0 && lm_message_thread_component_get(@ lm_test_component_destroy_a) != 0
            status: 11

        if: status = 0 && c.lm_message_thread_component_remove(threadB, @ lm_test_component_destroy_a) != 0
            status: 12
        if: status = 0 && (orderB != 3 || lm_message_thread_component_count(threadB) != 1U || c.lm_message_thread_component_get(threadB, @ lm_test_component_destroy_a) != 0 || c.lm_message_thread_component_get(threadB, @ lm_test_component_destroy_b) = 0)
            status: 13
        if: status = 0 && c.lm_message_thread_component_remove(threadB, @ lm_test_component_destroy_a) != 1
            status: 14

        if: threadA != 0
            lm_message_thread_delete(threadA)
            threadA: 0
        if: status = 0 && (orderA != 21 || orderB != 3 || lm_message_thread_component_count(threadB) != 1U)
            status: 15

        if: threadB != 0
            lm_message_thread_delete(threadB)
            threadB: 0
        if: status = 0 && orderB != 34
            status: 16

        if: status = 0
            reusable: lm_own_new_zero(c.sizeof(c.LmMessageThread))
            reusableComponent: lm_test_component_new(@ orderReusable, 5)
            if: reusable = 0 || reusableComponent = 0 || lm_message_thread_init(reusable) != 0 || c.lm_message_thread_component_attach(reusable, @ lm_test_component_destroy_a, reusableComponent) != 0
                status: 17
            else:
                reusableComponent: 0
            ---
        ---
        if: reusable != 0
            lm_message_thread_destroy(reusable)
            if: status = 0 && (orderReusable != 5 || lm_message_thread_component_count(reusable) != 0U || lm_message_thread_arena_count(reusable) != 0U || lm_message_thread_init(reusable) != 0)
                status: 18
            lm_message_thread_destroy(reusable)
            lm_own_delete(reusable, 0)
            reusable: 0
        ---

        lm_own_delete(a1, 0)
        lm_own_delete(a2, 0)
        lm_own_delete(aDuplicate, 0)
        lm_own_delete(b1, 0)
        lm_own_delete(b2, 0)
        lm_own_delete(reusableComponent, 0)
        if: threadA != 0
            lm_message_thread_delete(threadA)
        if: threadB != 0
            lm_message_thread_delete(threadB)
        return: status
    end: main
end: external
