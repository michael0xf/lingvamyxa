typedef struct LmFullCallHolder {
    LmUnaryCall callback;
} LmFullCallHolder;

typedef struct LmOverlayCallHolder {
    LmUnaryCall callback;
} LmOverlayCallHolder;

typedef struct LmSplitCallHolder {
    LmUnaryCall callback;
} LmSplitCallHolder;

typedef struct LmWrongDescriptorCallHolder {
    LmUnaryCall callback;
} LmWrongDescriptorCallHolder;

static int lm_test_increment(int value) {
    return value + 1;
}

static LmFullCallHolder lm_test_full_call_holder = { lm_test_increment };
static LmOverlayCallHolder lm_test_overlay_call_holder = { lm_test_increment };
static LmSplitCallHolder lm_test_split_call_holder = { lm_test_increment };
static LmWrongDescriptorCallHolder lm_test_wrong_descriptor_call_holder = { lm_test_increment };
===

