include: "trans_callable_field_chain_source_rows.support.h"

L2:
    fn: lm_test_increment (int: value) int
        return: value + 1
    end: lm_test_increment

    fn: callFull (const: @: LmFullCallHolder holder) int
        return: holder\callback(40)
    end: callFull

    fn: callOverlay (const: @: LmOverlayCallHolder holder) int
        return: holder\callback(41)
    end: callOverlay

    fn: callSplit (const: @: LmSplitCallHolder holder) int
        return: holder\callback(42)
    end: callSplit

    fn: callWrongDescriptor (const: @: LmWrongDescriptorCallHolder holder) int
        return: holder\callback(43)
    end: callWrongDescriptor

    external:
        fn: main () int
            c.struct: c.LmFullCallHolder full_holder
            c.struct: c.LmOverlayCallHolder overlay_holder
            c.struct: c.LmSplitCallHolder split_holder
            c.struct: c.LmWrongDescriptorCallHolder wrong_descriptor_holder

            c.full_holder.callback: @lm_test_increment
            c.overlay_holder.callback: @lm_test_increment
            c.split_holder.callback: @lm_test_increment
            c.wrong_descriptor_holder.callback: @lm_test_increment
            if: callFull(@ c.full_holder) != 41
                return: 1
            if: callOverlay(@ c.overlay_holder) != 42
                return: 2
            if: callSplit(@ c.split_holder) != 43
                return: 3
            if: callWrongDescriptor(@ c.wrong_descriptor_holder) != 44
                return: 4
            return: 0
        end: main
    end: external
end: L2
