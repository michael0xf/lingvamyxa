include: "<string.h>" "trans_l2_table_layout_source_rows.support.h"

table:
    name: layoutTable
    columns: (Plain: plain) (Qualified: qualified) (Partial: partial) (Overlay: overlay) (SplitOnly: split) (WrongSchema: wrong)
    rows:
             Plain:
                 value: 7
             Qualified:
                 text: "ok"
             Partial:
                 value: 5
             Overlay:
                 value: None
             SplitOnly:
                 flag: true
             WrongSchema:
                 value: 6
end: layoutTable

external:
    fn: main () int
        if: layoutTable = 0 || layoutTable\ptr = 0 || layoutTable\length != 1U || layoutTable[0] = 0
            return: 1
        if: layoutTable[0]\plain = 0 || layoutTable[0]\plain\value != 7
            return: 2
        if: layoutTable[0]\qualified = 0 || c.strcmp(layoutTable[0]\qualified\text, "ok") != 0
            return: 3
        if: layoutTable[0]\partial = 0 || layoutTable[0]\partial\value != 5
            return: 4
        if: layoutTable[0]\overlay = 0 || layoutTable[0]\overlay\value != -1
            return: 5
        if: layoutTable[0]\split = 0 || layoutTable[0]\split\flag != 1
            return: 6
        if: layoutTable[0]\wrong = 0 || layoutTable[0]\wrong\value != 6
            return: 7
        return: 0
    end: main
end: external
