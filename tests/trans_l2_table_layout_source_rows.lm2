include: "<string.h>" "trans_l2_table_layout_source_rows.support.h"

table:
    name: layoutTable
    columns((Plain: plain) (Qualified: qualified) (Partial: partial) (Overlay: overlay) (SplitOnly: split) (WrongSchema: wrong))
    rows:
             Plain:
                 value: 7
             Qualified:
                 text: "ok"
             Partial:
                 value: 5
             Overlay:
                 value: None
             SplitOnly:
                 flag: true
             WrongSchema:
                 value: 6
end: layoutTable

external:
    fn: main () int
        if: layoutTable\plain\value != 7
            return: 1
        if: c.strcmp(layoutTable\qualified\text, "ok") != 0
            return: 2
        if: layoutTable\partial\value != 5
            return: 3
        if: layoutTable\overlay\value != -1
            return: 4
        if: layoutTable\split\flag != 1
            return: 5
        if: layoutTable\wrong\value != 6
            return: 6
        return: 0
    end: main
end: external
