external:
    fn: main () int
        int: value 2
        int: postfix_result
        int: prefix_result
        int: infix_result
        int: index_result
        []: int values 2 7 8

        postfix_result: value postinc
        prefix_result: ! value
        infix_result: postfix_result + value
        index_result: values[0]
        return: postfix_result != 2 || prefix_result != -1 || infix_result != 2 || index_result != 7 || value != 1
    end: main
end: external
