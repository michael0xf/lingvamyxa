predef: "lm2/own_abi.lm2"
include
alias
forward
constant
layout
fn
prototype
include: "<string.h>"

table:
    source
    name: `fn.thread-context.managed`
    columns((class: class) (int: value))
    rows:
             lm_test_pool_actor_entry 1
             lm_test_pool_assert_entry 1
             lm_test_pool_delete_entry 1
end: `fn.thread-context.managed`

table:
    name: `forward.backend`
    columns((class: class) (class: backend))
    rows:
             LmTestPoolActor c.struct
end: `forward.backend`

table:
    name: `layout.backend`
    columns((class: class) (class: backend))
    rows:
             LmTestPoolActor c.struct
end: `layout.backend`

table:
    name: `class.reference-base`
    columns((class: class) (int: value))
    rows:
             LmTestPoolActor 1
end: `class.reference-base`

