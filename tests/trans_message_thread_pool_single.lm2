    name: `LmTestPoolActor.field.class`
    columns((class: class) (class: field))
    rows:
             actor           LmMessageThread
             turns          size_t
             target_turns   size_t
             stop_status    int
             identity_error int
             pool            LmMessageThreadPool
             foreign_pool    LmMessageThreadPool
             runtime      LmMessageThreadRuntime
             foreign_actor   LmMessageThread
             delete_result   int
             runtime_delete_result int
             foreign_join_result int
end: `LmTestPoolActor.field.class`

