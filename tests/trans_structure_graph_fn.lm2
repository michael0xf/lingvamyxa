predef: "lm2/own_abi.lm2"
include
alias
forward
constant
fn
layout
prototype

fn: AddX (int) int

fn: add (int: x) int
    return: x + 1
end: add

File:
    int: handle
    fn: close () int
end: File

external:
    fn: main () int
        File: f
            handle: 3
        end: f

        if: add(1) != 2
            return: 1
        if: f = 0 || f\handle != 3
            return: 2
        if: implements(f File File) != 1
            return: 3
        return: 0
    end: main
end: external
