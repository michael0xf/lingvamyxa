import: "lm2/own.lm2"

L4:
    table:
        name: `call.lowering`
        columns((class: class) (binding: handler))
        rows:
                 function  lm_trans_call_lower_statement
                 function  lm_trans_call_lower_value
                 function  None
    end: `call.lowering`

    table:
        name: `call.lowering`
