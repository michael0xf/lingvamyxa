import: "lm2/trans_library.lm2"

external:
    fn: main () int
        return: lm_test_generated_fn_source_rows_core()
    end: main
end: external

fn: lm_test_generated_fn_column_is (
    const: (LmTableColumnDescriptor: column)
    const: @(char name)
) int
    const: @: char descriptor

    if: column = 0 || column\name = 0 || column\type_name = 0 || c.strcmp(column\name, name) != 0 || c.strcmp(column\type_name, "class") != 0 || lm_table_column_descriptor_descriptor_count(column) != 1U
        return: 0
    descriptor: lm_table_column_descriptor_descriptor_at(column, 0U)
return: descriptor != 0 && c.strcmp(descriptor, "class") = 0

fn: lm_test_generated_fn_source_row_push (
    const: @(char key)
    const: @(char descriptor_value)
    const: @(char receiver_value)
    @: LmTransRegistryFact out_descriptor_fact
    @: LmTransRegistryFact out_receiver_fact
) int
    LmP0Text: table
    LmP0Text: key_text
    LmP0Text: payload
    int: status

    if: key = 0 || descriptor_value = 0 || receiver_value = 0 || out_descriptor_fact = 0 || out_receiver_fact = 0
        return: 1
    out_descriptor_fact[0]: 0
    out_receiver_fact[0]: 0

    table: lm_trans_text_from_cstr("fn.descriptor")
    key_text: lm_trans_text_from_cstr(key)
    payload: lm_trans_text_from_cstr(descriptor_value)
    status: 0
    if: table = 0 || key_text = 0 || payload = 0 || lm_trans_registry_push_row_values_with_fact(table, key_text, payload, out_descriptor_fact) != 0
        status: 1
    lm_trans_text_ref_destroy(@ table)
    lm_trans_text_ref_destroy(@ payload)

    if: status = 0
        table: lm_trans_text_from_cstr("fn.receiver")
        payload: lm_trans_text_from_cstr(receiver_value)
        if: table = 0 || payload = 0 || lm_trans_registry_push_row_values_with_fact(table, key_text, payload, out_receiver_fact) != 0
            status: 1
        lm_trans_text_ref_destroy(@ table)
        lm_trans_text_ref_destroy(@ payload)
    ---
    if: status = 0 && lm_trans_registry_materialize_generated_fn_source_row(key_text, out_descriptor_fact[0], out_receiver_fact[0]) != 0
        status: 1

    lm_trans_text_ref_destroy(@ key_text)
return: status

fn: lm_test_generated_fn_path_cell_is (
    const: @(char path)
    size_t: index
    const: @(char key)
    const: (LmTransRegistryFact: fact)
) int
    const: LmTableCell: key_cell
    const: LmTableCell: value_cell
    int: covered

    key_cell: 0
    covered: 0
    value_cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, path, c.strlen(path), index, 0, 0, @ key_cell, @ covered)
    if: covered = 0 || key_cell = 0 || key_cell\value = 0 || key_cell\source != 0 || c.strcmp(key_cell\value, key) != 0 || key_cell\value = fact\key || value_cell = 0 || value_cell\value = 0 || value_cell\source != fact || value_cell\value = fact\payload || c.strcmp(value_cell\value, fact\payload) != 0
        return: 0
return: 1

fn: lm_test_generated_fn_source_rows_core () int
    c.array: [2]: LmTransRegistryFact descriptor_facts
    c.array: [2]: LmTransRegistryFact receiver_facts
    c.array: const: [2]: @: char keys
    c.array: const: [2]: @: char descriptors
    c.array: const: [2]: @: char receivers
    const: LmTableDescriptor: table
    const: LmTableRow: row
    const: LmTableCell: receiver_cell
    LmOwnPtrStack: names
    LmP0Text: key_text
    const: @: char receiver_value
    size_t: i
    int: covered
    int: status

    lm_trans_registry_destroy()
    if: lm_trans_registry_init() != 0
        return: 1
    lm_trans_registry\identifiers: lm_trans_identifier_table_new()
    lm_trans_registry\value_arena: lm_own_new_zero(c.sizeof(lm_trans_registry\value_arena[0]))
    if: lm_trans_registry\identifiers = 0 || lm_trans_registry\value_arena = 0 || lm_own_arena_init(lm_trans_registry\value_arena, c.lm_lmx_message_thread) != 0
        lm_trans_registry_destroy()
        return: 1
    lm_trans_registry\loaded: 1
    lm_trans_registry\view_mode: 2

    keys[0]: "LmGeneratedCallable"
    keys[1]: "LmGeneratedProcedure"
    descriptors[0]: "callableDescriptor"
    descriptors[1]: "procedure"
    receivers[0]: "callable"
    receivers[1]: "sub"
    names: 0
    key_text: 0
    status: 0

    i: 0U
    while: i < 2U
        if: lm_test_generated_fn_source_row_push(keys[i], descriptors[i], receivers[i], @ descriptor_facts[i], @ receiver_facts[i]) != 0
            status: 1
            break
        i: i + 1U

    key_text: lm_trans_text_from_cstr(keys[0])
    if: status = 0 && (key_text = 0 || lm_trans_registry_materialize_generated_fn_source_row(key_text, descriptor_facts[0], receiver_facts[1]) = 0 || lm_registry_view_source_table_count(lm_trans_registry\view) != 2U)
        status: 1
    lm_trans_text_ref_destroy(@ key_text)

    if: status = 0 && (lm_trans_registry\loaded_fact_count != 4U || lm_registry_view_fact_count(lm_trans_registry\view) != 4U || lm_registry_view_source_table_count(lm_trans_registry\view) != 2U)
        status: 1

    i: 0U
    while: status = 0 && i < 2U
        table: lm_registry_view_source_table_at(lm_trans_registry\view, i)
        if: table = 0 || table\name = 0 || c.strcmp(table\name, "fn") != 0 || lm_table_descriptor_column_count(table) != 3U || lm_table_descriptor_materialized_row_count(table) != 1U || lm_test_generated_fn_column_is(lm_table_descriptor_column_at(table, 0U), "class") = 0 || lm_test_generated_fn_column_is(lm_table_descriptor_column_at(table, 1U), "descriptor") = 0 || lm_test_generated_fn_column_is(lm_table_descriptor_column_at(table, 2U), "receiver") = 0
            status: 1
            break
        row: lm_table_descriptor_materialized_row_at(table, 0U)
        if: row = 0 || row\local_sequence != 0U || lm_table_row_cell_count(row) != 3U
            status: 1
            break
        if: lm_test_generated_fn_path_cell_is("fn.descriptor", i, keys[i], descriptor_facts[i]) = 0 || lm_test_generated_fn_path_cell_is("fn.receiver", i, keys[i], receiver_facts[i]) = 0
            status: 1
            break
        i: i + 1U

    if: status = 0
        names: lm_trans_ptr_stack_new(lm_trans_free_any)
        if: names = 0 || lm_trans_registry_collect_source_relation_names(names, 0, "fn", "descriptor", "generated fn test", 0) != 0 || names\count != 2U || c.strcmp(lm_own_ptr_stack_at(names, 0U), keys[0]) != 0 || c.strcmp(lm_own_ptr_stack_at(names, 1U), keys[1]) != 0
            status: 1
    ---

    if: status = 0
        covered: 0
        if: lm_registry_view_source_path_key_at_slice(lm_trans_registry\view, "fn.descriptor", 13U, 2U, @ covered) != 0 || covered = 0
            status: 1
    ---

    key_text: lm_trans_text_from_cstr(keys[0])
    if: status = 0 && key_text = 0
        status: 1
    lm_trans_registry\view_mode: 0
    receiver_value: lm_trans_fn_receiver_value(0, key_text)
    if: status = 0 && receiver_value != receiver_facts[0]\payload
        status: 1
    lm_trans_registry\view_mode: 1
    receiver_value: lm_trans_fn_receiver_value(0, key_text)
    if: status = 0 && receiver_value != receiver_facts[0]\payload
        status: 1
    lm_trans_registry\view_mode: 2
    covered: 0
    receiver_cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, "fn.receiver", 11U, 0U, 0, 0, 0, @ covered)
    receiver_value: lm_trans_fn_receiver_value(0, key_text)
    if: status = 0 && (covered = 0 || receiver_cell = 0 || receiver_cell\value = 0 || receiver_value != receiver_cell\value || receiver_value = receiver_facts[0]\payload)
        status: 1

    if: status = 0 && (lm_trans_registry_assert_source_table_materialization() != 0 || lm_trans_registry_assert_view_parity() != 0)
        status: 1

    lm_trans_text_ref_destroy(@ key_text)
    lm_trans_ptr_stack_delete(@ names)
    lm_trans_registry_destroy()
return: status
