. . while: i < 3
. . . synchronized: @ lock
. . . . break
. . . i: i + 1
. . return: c.depth
. end: leaveByBreak
. fn: leaveByContinue () c.int
. . c.int: lock 0
. . c.int: i 0
. . while: i < 1
. . . i: i + 1
. . . synchronized: @ lock
. . . . continue
. . return: c.depth
. end: leaveByContinue
. external:
