. fn: leaveByReturn () int
. . int: lock 0
. . synchronized: @ lock
. . . return: 10 + lock
. . return: -1
. end: leaveByReturn
. fn: leaveByWrappedReturn () int
. . int: lock 0
. . synchronized: @ lock (return: 10 + lock)
. . return: -1
. end: leaveByWrappedReturn
. fn: leaveByBreak () int
. . int: lock 0
. . int: i 0
. . while: i < 3
. . . synchronized: @ lock
. . . . break
. . . i: i + 1
. . return: lock
. end: leaveByBreak
. fn: leaveByContinue () int
. . int: lock 0
. . int: i 0
. . while: i < 1
. . . i: i + 1
. . . synchronized: @ lock
. . . . continue
. . ---
. . return: lock
. end: leaveByContinue
. external:
. . fn: main () int
. . . int: result 0
. . . result: leaveByReturn() + leaveByWrappedReturn() + leaveByBreak() + leaveByContinue()
. . . c.printf: "%d\n" result
. . . return: result != 22
. . end: main
. end: external
