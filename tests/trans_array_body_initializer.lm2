L2:
    external:
        fn: main () int
            []: int values 4
                1 2
                3 4
            ---
            [][]: int matrix 2 2
                []: 1 2
                []: 3 4
            return: values[0] != 1 || values[3] != 4 || matrix[0][1] != 2 || matrix[1][0] != 3
        end: main
    end: external
end: L2
