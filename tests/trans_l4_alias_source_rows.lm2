alias

include: "<limits.h>" "trans_l4_alias_source_rows.support.h"

fn: lm_test_alias_source_rows () int
    LmTestAliasSource: source 3
    LmTestAliasPointer: pointer "ok"
    LmTestAliasValueOverlay: value_overlay c.UINT_MAX
    LmTestAliasBackendOverlay: backend_overlay 5L
    char: value 'x'
    @: char one @ value
    LmTestAliasDepthOverlay: depth_overlay @ one
    LmTestAliasConstOverlay: const_overlay 6
    LmTestAliasDuplicate: duplicate 1.5
    LmTestAliasLateNone: late_none "none"
    short: split_value 8
    LmTestAliasSplit: split @ split_value
    LmTestAliasJoined: joined "joined"
    LmTestAliasReordered: reordered 9L
    LmTestAliasSchemaFallback: schema_fallback 2.5

    return: source != 3 || pointer[0] != 'o' || value_overlay = 0U || backend_overlay != 5L || depth_overlay[0][0] != 'x' || const_overlay != 6 || duplicate <= 1.0 || duplicate >= 2.0 || late_none[0] != 'n' || split[0] != 8 || joined[0] != 'j' || reordered != 9L || schema_fallback <= 2.0 || schema_fallback >= 3.0
end: lm_test_alias_source_rows

external:
    fn: main () int
        return: lm_test_alias_source_rows()
    end: main
end: external
