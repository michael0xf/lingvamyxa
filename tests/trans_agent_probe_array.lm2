L2:
    fn: sum_array ([]: int values; int: count) int
        int: i 0
        int: total 0
        while: i < count
            total: total + values[i]
            i: i + 1
        return: total
    end: sum_array

    external:
        fn: main () int
            []: int arr 6 3 1 4 1 5 9

            if: arr[0] != 3
                return: 1
            if: arr[5] != 9
                return: 2
            if: sum_array(arr, 6) != 23
                return: 3

            arr[2]: 40
            if: arr[2] != 40
                return: 4
            if: sum_array(arr, 6) != 59
                return: 5
            return: 0
        end: main
    end: external
end: L2
