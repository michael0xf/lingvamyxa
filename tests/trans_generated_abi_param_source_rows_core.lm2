import: "lm2/trans_library.lm2"

external:
    fn: main () int
        return: lm_test_generated_abi_param_source_rows_core()
    end: main
end: external

fn: lm_test_generated_abi_fact_at (size_t: index) LmTransRegistryFact
    const: LmRegistryViewRow: row

    row: lm_registry_view_fact_at(lm_trans_registry\view, index)
    if: row = 0 || row\source = 0
        return: 0
return: cast: (LmTransRegistryFact) row\source

fn: lm_test_generated_abi_fact_is (
    const: (LmTransRegistryFact: fact)
    const: @(char table)
    const: @(char key)
    const: @(char payload)
) int
return: fact != 0 && fact\table != 0 && c.strcmp(fact\table, table) = 0 && fact\key != 0 && c.strcmp(fact\key, key) = 0 && fact\payload != 0 && c.strcmp(fact\payload, payload) = 0

fn: lm_test_generated_abi_column_is (
    const: (LmTableColumnDescriptor: column)
    const: @(char name)
    const: @(char type_name)
    const: @(char descriptor)
) int
    const: @: char actual_descriptor

    if: column = 0 || column\name = 0 || column\type_name = 0 || c.strcmp(column\name, name) != 0 || c.strcmp(column\type_name, type_name) != 0 || lm_table_column_descriptor_descriptor_count(column) != 1U
        return: 0
    actual_descriptor: lm_table_column_descriptor_descriptor_at(column, 0U)
return: actual_descriptor != 0 && c.strcmp(actual_descriptor, descriptor) = 0

fn: lm_test_generated_abi_path_cell_is (
    const: @(char path)
    size_t: index
    const: @(char key)
    const: (LmTransRegistryFact: fact)
) int
    const: LmTableCell: key_cell
    const: LmTableCell: value_cell
    int: covered

    key_cell: 0
    covered: 0
    value_cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, path, c.strlen(path), index, 0, 0, @ key_cell, @ covered)
    if: covered = 0 || key_cell = 0 || key_cell\value = 0 || key_cell\source != 0 || c.strcmp(key_cell\value, key) != 0 || value_cell = 0 || value_cell\value = 0 || value_cell\source != fact || value_cell\value = fact\payload || c.strcmp(value_cell\value, fact\payload) != 0
        return: 0
return: 1

fn: lm_test_abi_param_take_explicit_source (
    const: @(char owner_name)
    const: @(char key_descriptor)
    const: @(char class_descriptor)
    const: (LmTransRegistryFact: class_fact)
    const: (LmTransRegistryFact: index_fact)
    const: @(LmTableCell out_key_cell)
    const: @(LmTableCell out_class_cell)
) int
    LmTableDescriptor: descriptor
    LmTableRow: row
    LmTableCell: key_cell
    LmTableCell: class_cell
    LmTableCell: index_cell
    LmTableCell: selected_key_cell
    LmTableCell: selected_class_cell
    int: status

    if: owner_name = 0 || key_descriptor = 0 || class_descriptor = 0 || class_fact = 0 || class_fact\key = 0 || class_fact\payload = 0 || index_fact = 0 || index_fact\payload = 0 || out_key_cell = 0 || out_class_cell = 0
        return: 1
    out_key_cell[0]: 0
    out_class_cell[0]: 0

    descriptor: lm_table_descriptor_new_empty_slice(owner_name, c.strlen(owner_name))
    row: 0
    key_cell: 0
    class_cell: 0
    index_cell: 0
    selected_key_cell: 0
    selected_class_cell: 0
    status: 0
    if: descriptor = 0 || lm_table_descriptor_add_column(descriptor, "class", key_descriptor) != 0 || lm_table_descriptor_add_column(descriptor, "param.class", class_descriptor) != 0 || lm_table_descriptor_add_column(descriptor, "param.index", "size_t") != 0
        status: 1

    if: status = 0
        row: lm_table_row_new(0)
        key_cell: lm_table_cell_new_cstr(class_fact\key, class_fact\key, 0, 0, 0)
        class_cell: lm_table_cell_new_cstr(class_fact\payload, class_fact\payload, 0, class_fact, 0)
        index_cell: lm_table_cell_new_cstr(index_fact\payload, index_fact\payload, 0, index_fact, 0)
        selected_key_cell: key_cell
        selected_class_cell: class_cell
        if: row = 0 || key_cell = 0 || class_cell = 0 || index_cell = 0
            status: 1
    ---

    if: status = 0
        if: lm_table_row_take_cell(row, key_cell) != 0
            status: 1
        else:
            key_cell: 0
    ---
    if: status = 0
        if: lm_table_row_take_cell(row, class_cell) != 0
            status: 1
        else:
            class_cell: 0
    ---
    if: status = 0
        if: lm_table_row_take_cell(row, index_cell) != 0
            status: 1
        else:
            index_cell: 0
    ---
    if: status = 0
        if: lm_table_descriptor_take_materialized_row(descriptor, row) != 0
            status: 1
        else:
            row: 0
    ---
    if: status = 0
        if: lm_registry_view_take_local_source_table(lm_trans_registry\view, descriptor) != 0
            status: 1
        else:
            descriptor: 0
            out_key_cell[0]: selected_key_cell
            out_class_cell[0]: selected_class_cell
    ---

    lm_table_cell_delete_any(index_cell)
    lm_table_cell_delete_any(class_cell)
    lm_table_cell_delete_any(key_cell)
    lm_table_row_delete_any(row)
    lm_table_descriptor_delete_any(descriptor)
return: status

fn: lm_test_abi_param_explicit_source_reader () int
    LmP0Text: wide_owner
    LmP0Text: wide_param
    LmP0Text: wide_class
    LmP0Text: wrong_owner
    LmP0Text: wrong_param
    LmP0Text: wrong_class
    LmTransRegistryFact: wide_class_fact
    LmTransRegistryFact: wide_index_fact
    LmTransRegistryFact: wrong_class_fact
    LmTransRegistryFact: wrong_index_fact
    const: LmTableCell: wide_key_cell
    const: LmTableCell: wide_class_cell
    const: LmTableCell: wrong_key_cell
    const: LmTableCell: wrong_class_cell
    const: LmTableCell: covered_cell
    const: LmTableCell: resolved_cell
    const: LmTableCell: resolved_key_cell
    @: LmTransAbiParam params
    size_t: count
    int: covered
    int: status

    wide_owner: lm_trans_text_from_cstr("LmExplicitAbiParam")
    wide_param: lm_trans_text_from_cstr("value")
    wide_class: lm_trans_text_from_cstr("long")
    wrong_owner: lm_trans_text_from_cstr("LmWrongAbiParam")
    wrong_param: lm_trans_text_from_cstr("value")
    wrong_class: lm_trans_text_from_cstr("int")
    wide_class_fact: 0
    wide_index_fact: 0
    wrong_class_fact: 0
    wrong_index_fact: 0
    wide_key_cell: 0
    wide_class_cell: 0
    wrong_key_cell: 0
    wrong_class_cell: 0
    resolved_key_cell: 0
    params: lm_trans_l4_abi_params_new(1U)
    status: 0
    if: wide_owner = 0 || wide_param = 0 || wide_class = 0 || wrong_owner = 0 || wrong_param = 0 || wrong_class = 0 || params = 0
        status: 1

    if: status = 0 && (lm_trans_registry_push_owner_relation_text_with_fact(wide_owner, ".param.class", wide_param, wide_class, @ wide_class_fact) != 0 || lm_trans_registry_push_owner_relation_size_with_fact(wide_owner, ".param.index", wide_param, 0U, @ wide_index_fact) != 0)
        status: 1
    if: status = 0 && lm_test_abi_param_take_explicit_source("LmExplicitAbiParam", "class", "class", wide_class_fact, wide_index_fact, @ wide_key_cell, @ wide_class_cell) != 0
        status: 1

    if: status = 0 && (lm_trans_registry_push_owner_relation_text_with_fact(wrong_owner, ".param.class", wrong_param, wrong_class, @ wrong_class_fact) != 0 || lm_trans_registry_push_owner_relation_size_with_fact(wrong_owner, ".param.index", wrong_param, 0U, @ wrong_index_fact) != 0)
        status: 1
    if: status = 0 && lm_test_abi_param_take_explicit_source("LmWrongAbiParam", "class", "char", wrong_class_fact, wrong_index_fact, @ wrong_key_cell, @ wrong_class_cell) != 0
        status: 1

    lm_trans_registry\view_mode: 2
    count: 0U
    if: status = 0 && lm_trans_collect_abi_params(params, 1U, @ count, 0, "LmExplicitAbiParam", "explicit ABI source test") != 0
        status: 1
    if: status = 0 && (count != 1U || params[0]\name != wide_key_cell\value || params[0]\class_name != wide_class_cell\value || params[0]\name = wide_class_fact\key || params[0]\class_name = wide_class_fact\payload || params[0]\index != 0U || params[0]\address_depth != 0U || params[0]\is_const != 0)
        status: 1

    covered: 0
    covered_cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, "LmWrongAbiParam.param.class", c.strlen("LmWrongAbiParam.param.class"), 0U, 0, 0, 0, @ covered)
    resolved_cell: lm_trans_abi_source_text_cell(0, "LmWrongAbiParam.param.class", "class", wrong_class_fact, @ resolved_key_cell)
    if: status = 0 && (covered = 0 || covered_cell != wrong_class_cell || resolved_cell != 0 || resolved_key_cell != 0)
        status: 1

    count: 0U
    if: status = 0 && lm_trans_collect_abi_params(params, 1U, @ count, 0, "LmWrongAbiParam", "wrong-schema ABI source test") != 0
        status: 1
    if: status = 0 && (count != 1U || params[0]\name != wrong_class_fact\key || params[0]\class_name != wrong_class_fact\payload || params[0]\name = wrong_key_cell\value || params[0]\class_name = wrong_class_cell\value || params[0]\index != 0U)
        status: 1

    lm_trans_l4_abi_params_delete(params, 1U)
    lm_trans_text_ref_destroy(@ wrong_class)
    lm_trans_text_ref_destroy(@ wrong_param)
    lm_trans_text_ref_destroy(@ wrong_owner)
    lm_trans_text_ref_destroy(@ wide_class)
    lm_trans_text_ref_destroy(@ wide_param)
    lm_trans_text_ref_destroy(@ wide_owner)
return: status

fn: lm_test_generated_abi_param_source_rows_core () int
    LmP0Text: function_name
    LmTransFormalParam: scalar_param
    LmTransFormalParam: pointer_param
    LmTransRegistryFact: scalar_class_fact
    LmTransRegistryFact: scalar_index_fact
    LmTransRegistryFact: pointer_class_fact
    LmTransRegistryFact: pointer_index_fact
    LmTransRegistryFact: pointer_depth_fact
    LmTransRegistryFact: pointer_const_fact
    const: LmTableDescriptor: descriptor
    const: LmTableRow: row
    const: LmTableCell: cell
    const: LmTableCell: scalar_source_key_cell
    const: LmTableCell: scalar_source_class_cell
    const: LmTableCell: pointer_source_key_cell
    const: LmTableCell: pointer_source_class_cell
    LmOwnPtrStack: selected_keys
    @: LmTransAbiParam abi_params
    const: @: char source_key
    size_t: abi_count
    size_t: i
    int: covered
    int: status

    lm_trans_registry_destroy()
    if: lm_trans_registry_init() != 0
        return: 1
    lm_trans_registry\identifiers: lm_trans_identifier_table_new()
    lm_trans_registry\value_arena: lm_own_new_zero(c.sizeof(lm_trans_registry\value_arena[0]))
    if: lm_trans_registry\identifiers = 0 || lm_trans_registry\value_arena = 0 || lm_own_arena_init(lm_trans_registry\value_arena, c.lm_lmx_message_thread) != 0
        lm_trans_registry_destroy()
        return: 1
    lm_trans_registry\loaded: 1
    lm_trans_registry\view_mode: 2

    function_name: lm_trans_text_from_cstr("LmGeneratedAbiProbe")
    scalar_param: lm_trans_formal_param_new()
    pointer_param: lm_trans_formal_param_new()
    selected_keys: 0
    abi_params: lm_trans_l4_abi_params_new(2U)
    status: 0
    if: function_name = 0 || scalar_param = 0 || pointer_param = 0 || abi_params = 0
        status: 1

    if: status = 0
        scalar_param\has_name: 0
        if: lm_trans_text_assign_cstr(scalar_param\type\class_name, "int") = 0
            status: 1
    ---
    if: status = 0
        pointer_param\has_name: 1
        pointer_param\type\address_depth: 1U
        pointer_param\type\is_const: 1
        if: lm_trans_text_assign_cstr(pointer_param\name, "label") = 0 || lm_trans_text_assign_cstr(pointer_param\type\class_name, "char") = 0
            status: 1
    ---

    if: status = 0 && lm_trans_registry_materialize_fn_descriptor_param(function_name, scalar_param, 1U) != 0
        status: 1
    if: status = 0 && lm_trans_registry_materialize_fn_descriptor_param(function_name, pointer_param, 0U) != 0
        status: 1

    scalar_class_fact: lm_test_generated_abi_fact_at(0U)
    scalar_index_fact: lm_test_generated_abi_fact_at(1U)
    pointer_class_fact: lm_test_generated_abi_fact_at(3U)
    pointer_index_fact: lm_test_generated_abi_fact_at(4U)
    pointer_depth_fact: lm_test_generated_abi_fact_at(5U)
    pointer_const_fact: lm_test_generated_abi_fact_at(6U)
    if: status = 0 && (lm_trans_registry\loaded_fact_count != 8U || lm_registry_view_fact_count(lm_trans_registry\view) != 8U || lm_registry_view_source_table_count(lm_trans_registry\view) != 2U)
        status: 1
    if: status = 0 && (lm_test_generated_abi_fact_is(scalar_class_fact, "LmGeneratedAbiProbe.param.class", "arg1", "int") = 0 || lm_test_generated_abi_fact_is(scalar_index_fact, "LmGeneratedAbiProbe.param.index", "arg1", "1") = 0 || lm_test_generated_abi_fact_is(pointer_class_fact, "LmGeneratedAbiProbe.param.class", "label", "char") = 0 || lm_test_generated_abi_fact_is(pointer_index_fact, "LmGeneratedAbiProbe.param.index", "label", "0") = 0 || lm_test_generated_abi_fact_is(pointer_depth_fact, "LmGeneratedAbiProbe.param.address-depth", "label", "1") = 0 || lm_test_generated_abi_fact_is(pointer_const_fact, "LmGeneratedAbiProbe.param.const", "label", "1") = 0)
        status: 1

    i: 0U
    while: status = 0 && i < 2U
        descriptor: lm_registry_view_source_table_at(lm_trans_registry\view, i)
        if: descriptor = 0 || descriptor\name = 0 || c.strcmp(descriptor\name, "LmGeneratedAbiProbe.param") != 0 || lm_table_descriptor_column_count(descriptor) != 5U || lm_table_descriptor_materialized_row_count(descriptor) != 1U || lm_test_generated_abi_column_is(lm_table_descriptor_column_at(descriptor, 0U), "name", "class", "class") = 0 || lm_test_generated_abi_column_is(lm_table_descriptor_column_at(descriptor, 1U), "class", "class", "class") = 0 || lm_test_generated_abi_column_is(lm_table_descriptor_column_at(descriptor, 2U), "index", "size_t", "size_t") = 0 || lm_test_generated_abi_column_is(lm_table_descriptor_column_at(descriptor, 3U), "address-depth", "size_t", "size_t") = 0 || lm_test_generated_abi_column_is(lm_table_descriptor_column_at(descriptor, 4U), "const", "int", "int") = 0
            status: 1
            break
        row: lm_table_descriptor_materialized_row_at(descriptor, 0U)
        if: row = 0 || row\local_sequence != 0U || lm_table_row_cell_count(row) != 5U
            status: 1
            break
        i: i + 1U

    if: status = 0
        descriptor: lm_registry_view_source_table_at(lm_trans_registry\view, 0U)
        row: lm_table_descriptor_materialized_row_at(descriptor, 0U)
        cell: lm_table_row_cell_at(row, 3U)
        if: cell = 0 || cell\atom = 0 || c.strcmp(cell\atom, "None") != 0 || cell\value != 0 || cell\node != 0 || cell\source != 0 || cell\explicit_none = 0
            status: 1
        cell: lm_table_row_cell_at(row, 4U)
        if: cell = 0 || cell\atom = 0 || c.strcmp(cell\atom, "None") != 0 || cell\value != 0 || cell\node != 0 || cell\source != 0 || cell\explicit_none = 0
            status: 1
    ---

    if: status = 0 && (lm_test_generated_abi_path_cell_is("LmGeneratedAbiProbe.param.class", 0U, "arg1", scalar_class_fact) = 0 || lm_test_generated_abi_path_cell_is("LmGeneratedAbiProbe.param.class", 1U, "label", pointer_class_fact) = 0 || lm_test_generated_abi_path_cell_is("LmGeneratedAbiProbe.param.index", 0U, "arg1", scalar_index_fact) = 0 || lm_test_generated_abi_path_cell_is("LmGeneratedAbiProbe.param.index", 1U, "label", pointer_index_fact) = 0 || lm_test_generated_abi_path_cell_is("LmGeneratedAbiProbe.param.address-depth", 0U, "label", pointer_depth_fact) = 0 || lm_test_generated_abi_path_cell_is("LmGeneratedAbiProbe.param.const", 0U, "label", pointer_const_fact) = 0)
        status: 1

    scalar_source_key_cell: 0
    pointer_source_key_cell: 0
    covered: 0
    scalar_source_class_cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, "LmGeneratedAbiProbe.param.class", c.strlen("LmGeneratedAbiProbe.param.class"), 0U, 0, 0, @ scalar_source_key_cell, @ covered)
    if: status = 0 && (covered = 0 || scalar_source_key_cell = 0 || scalar_source_class_cell = 0)
        status: 1
    covered: 0
    pointer_source_class_cell: lm_registry_view_source_path_cell_at_slice(lm_trans_registry\view, "LmGeneratedAbiProbe.param.class", c.strlen("LmGeneratedAbiProbe.param.class"), 1U, 0, 0, @ pointer_source_key_cell, @ covered)
    if: status = 0 && (covered = 0 || pointer_source_key_cell = 0 || pointer_source_class_cell = 0)
        status: 1

    if: status = 0
        covered: 0
        if: lm_registry_view_source_path_has_key_slice(lm_trans_registry\view, "LmGeneratedAbiProbe.param.address-depth", c.strlen("LmGeneratedAbiProbe.param.address-depth"), "arg1", 4U, @ covered) != 0 || covered = 0
            status: 1
        covered: 0
        if: lm_registry_view_source_path_has_key_slice(lm_trans_registry\view, "LmGeneratedAbiProbe.param.const", c.strlen("LmGeneratedAbiProbe.param.const"), "arg1", 4U, @ covered) != 0 || covered = 0
            status: 1
    ---

    if: status = 0
        selected_keys: lm_trans_namespace_registry_source_relation_keys_new(0, function_name, "param.class")
        if: selected_keys = 0 || selected_keys\count != 2U
            status: 1
        else:
            i: 0U
            while: i < 2U
                covered: 0
                source_key: lm_registry_view_source_path_key_at_slice(lm_trans_registry\view, "LmGeneratedAbiProbe.param.class", c.strlen("LmGeneratedAbiProbe.param.class"), i, @ covered)
                if: covered = 0 || source_key = 0 || lm_own_ptr_stack_at(selected_keys, i) != source_key
                    status: 1
                    break
                i: i + 1U
            if: status = 0 && (lm_own_ptr_stack_at(selected_keys, 0U) = scalar_class_fact\key || lm_own_ptr_stack_at(selected_keys, 1U) = pointer_class_fact\key)
                status: 1
        ---
    ---

    lm_trans_registry\view_mode: 0
    abi_count: 0U
    if: status = 0 && lm_trans_collect_abi_params(abi_params, 2U, @ abi_count, 0, "LmGeneratedAbiProbe", "generated ABI legacy test") != 0
        status: 1
    if: status = 0 && (abi_count != 2U || abi_params[0]\name != pointer_class_fact\key || abi_params[0]\class_name != pointer_class_fact\payload || abi_params[1]\name != scalar_class_fact\key || abi_params[1]\class_name != scalar_class_fact\payload)
        status: 1

    lm_trans_registry\view_mode: 1
    abi_count: 0U
    if: status = 0 && lm_trans_collect_abi_params(abi_params, 2U, @ abi_count, 0, "LmGeneratedAbiProbe", "generated ABI parity test") != 0
        status: 1
    if: status = 0 && (abi_count != 2U || abi_params[0]\name != pointer_class_fact\key || abi_params[0]\class_name != pointer_class_fact\payload || abi_params[1]\name != scalar_class_fact\key || abi_params[1]\class_name != scalar_class_fact\payload)
        status: 1

    lm_trans_registry\view_mode: 2
    abi_count: 0U
    if: status = 0 && lm_trans_collect_abi_params(abi_params, 2U, @ abi_count, 0, "LmGeneratedAbiProbe", "generated ABI source test") != 0
        status: 1
    if: status = 0 && (abi_count != 2U || abi_params[0]\name = 0 || c.strcmp(abi_params[0]\name, "label") != 0 || abi_params[0]\class_name = 0 || c.strcmp(abi_params[0]\class_name, "char") != 0 || abi_params[0]\index != 0U || abi_params[0]\address_depth != 1U || abi_params[0]\is_const = 0 || abi_params[1]\name = 0 || c.strcmp(abi_params[1]\name, "arg1") != 0 || abi_params[1]\class_name = 0 || c.strcmp(abi_params[1]\class_name, "int") != 0 || abi_params[1]\index != 1U || abi_params[1]\address_depth != 0U || abi_params[1]\is_const != 0)
        status: 1
    if: status = 0 && (abi_params[0]\name != pointer_source_key_cell\value || abi_params[0]\class_name != pointer_source_class_cell\value || abi_params[1]\name != scalar_source_key_cell\value || abi_params[1]\class_name != scalar_source_class_cell\value || abi_params[0]\name = pointer_class_fact\key || abi_params[0]\class_name = pointer_class_fact\payload || abi_params[1]\name = scalar_class_fact\key || abi_params[1]\class_name = scalar_class_fact\payload)
        status: 1

    if: status = 0 && lm_test_abi_param_explicit_source_reader() != 0
        status: 1

    if: status = 0 && (lm_trans_registry_assert_source_table_materialization() != 0 || lm_trans_registry_assert_view_parity() != 0)
        status: 1

    lm_trans_l4_abi_params_delete(abi_params, 2U)
    lm_trans_ptr_stack_delete(@ selected_keys)
    lm_trans_formal_param_delete(pointer_param)
    lm_trans_formal_param_delete(scalar_param)
    lm_trans_text_ref_destroy(@ function_name)
    lm_trans_registry_destroy()
return: status
