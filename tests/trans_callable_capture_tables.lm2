import: "lm2/own.lm2"

table:
    source
    name: `callable.capture`
    columns((class: class) (serial: value))
    rows:
             AddX 1
end: `callable.capture`

table:
    source
    name: `callable.projection`
    columns((class: class) (projection: value))
    rows:
             AddX `c.closure-struct`
end: `callable.projection`

fn: AddX (int: value) int

fn: makeAdder (int: base) AddX
    fn: addX (int: value) int
        return: base + value
    ---
    return: addX
end: makeAdder

fn: callAdd (AddX: add) int
    return: add(3)
end: callAdd

external:
    fn: main () int
        return: callAdd(makeAdder(4)) != 7
    end: main
end: external
