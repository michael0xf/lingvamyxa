table:
    source
    name: `define.value`
    columns: (class: class) (@: char value)
    rows:
             `LM_TEST_ROOT_OWNER()`       "(lm_message_thread_owner(lm_lmx_message_thread))"
             `LM_TEST_CLOSURE_ENV(value)` "((value)->env)"
end: `define.value`

define

import: "lm2/own.lm2"

table:
    source
    name: `callable.capture`
    columns: (class: class) (serial: value)
    rows:
             AddX 1
end: `callable.capture`

table:
    source
    name: `callable.projection`
    columns: (class: class) (projection: value)
    rows:
             AddX `c.closure-struct`
end: `callable.projection`

fn: AddX (int: value) int

fn: makeAdder (@: AddX declared_closure; int: base) AddX
    fn: addX (int: value) int
        return: base + value
    ---
    declared_closure[0]: c.lm_lmx_nested_l1_parent_makeAdder_child_addX_i0_closure_value
    return: addX
end: makeAdder

fn: makeIncrementer () AddX
    fn: increment (int: value) int
        return: value + 1
    ---
    return: increment
end: makeIncrementer

fn: callAdd (AddX: add) int
    return: add(3)
end: callAdd

external:
    fn: main () int
        AddX: declaredClosure
        AddX: first makeAdder(@ declaredClosure, 4)
        if: first = 0 || first != declaredClosure
            return: 1
        if: c.lm_own_arena_allocation_descriptor(c.lm_lmx_message_thread, c.LM_TEST_ROOT_OWNER(), first) = 0 || c.lm_own_arena_allocation_descriptor(c.lm_lmx_message_thread, c.LM_TEST_ROOT_OWNER(), c.LM_TEST_CLOSURE_ENV(first)) = 0
            return: 2

        AddX: second makeAdder(@ declaredClosure, 8)
        if: second = 0 || second != declaredClosure
            return: 3
        if: c.lm_own_arena_allocation_descriptor(c.lm_lmx_message_thread, c.LM_TEST_ROOT_OWNER(), second) = 0 || c.lm_own_arena_allocation_descriptor(c.lm_lmx_message_thread, c.LM_TEST_ROOT_OWNER(), c.LM_TEST_CLOSURE_ENV(second)) = 0
            return: 4
        if: first = second
            return: 5

        AddX: captureless makeIncrementer()
        if: captureless = 0 || c.LM_TEST_CLOSURE_ENV(captureless) != 0
            return: 6
        if: c.lm_own_arena_allocation_descriptor(c.lm_lmx_message_thread, c.LM_TEST_ROOT_OWNER(), captureless) = 0
            return: 7
        return: callAdd(first) != 7 || callAdd(second) != 11 || callAdd(captureless) != 4
    end: main
end: external
