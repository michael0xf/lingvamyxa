typedef int LmClassKindWideJoined;
typedef int LmClassKindWideSchemaFallback;

#define lm_test_require_pointer(value) ((void)sizeof(*(value)), 0)

static void lm_test_class_kind_runtime_default(int value) {
    (void)value;
}
===

