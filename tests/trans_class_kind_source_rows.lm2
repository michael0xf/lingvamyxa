        return: c.lm_test_require_pointer(source_direct) || c.lm_test_require_pointer(source_schema_fallback) || c.lm_test_require_pointer(source_joined) || c.lm_test_require_pointer(compat_direct) || c.lm_test_require_pointer(compat_schema_fallback) || c.lm_test_require_pointer(compat_joined) || c.lm_test_require_pointer(wide_direct) || c.lm_test_require_pointer(wide_late_none) || c.lm_test_require_pointer(wide_reordered) || c.lm_test_require_pointer(wide_physical_overlay) || c.lm_test_require_pointer(wide_physical) || c.lm_test_require_pointer(wide_joined) || c.lm_test_require_pointer(wide_schema_fallback)
