                     external:
                         fn: lm_test_unit () int
                             return: 0
                         end: lm_test_unit
                     end: external
                 end: L2
    end: `unit.payload`
end: L4

alias
forward
layout
prototype
callable_alias
unit

guard: LM_TEST_GUARD
    "int lm_test_guard_value;\n"
end: guard

extern_c:
