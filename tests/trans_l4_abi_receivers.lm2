L4:
    table:
        name: `alias.backend`
        columns: class        (backend class)
        rows:
                 LmTestAlias  c.typedef
    end: `alias.backend`

    table:
        name: `alias.target`
        columns: class        (target class)
        rows:
                 LmTestAlias  int
    end: `alias.target`

    table:
        name: `forward.backend`
        columns: class          (backend class)
        rows:
                 LmTestForward  c.struct
    end: `forward.backend`

    table:
        name: `prototype.backend`
        columns: class        (backend class)
        rows:
                 lm_test_api  c.prototype
    end: `prototype.backend`

    table:
        name: `lm_test_api.return.class`
        columns: class   (return class)
        rows:
                 return  int
    end: `lm_test_api.return.class`

    table:
        name: `lm_test_api.param.class`
        columns: class  (param class)
        rows:
                 value  int
    end: `lm_test_api.param.class`

    table:
        name: `lm_test_api.param.index`
        columns: class  (index serial)
        rows:
                 value  0
    end: `lm_test_api.param.index`

    table:
        name: `callable_alias.backend`
        columns: class       (backend class)
        rows:
                 LmTestCall  c.function-pointer
    end: `callable_alias.backend`

    table:
        name: `LmTestCall.return.class`
        columns: class   (return class)
        rows:
                 return  int
    end: `LmTestCall.return.class`

    table:
        name: `LmTestCall.param.class`
        columns: class  (param class)
        rows:
                 value  int
    end: `LmTestCall.param.class`

    table:
        name: `LmTestCall.param.index`
        columns: class  (index serial)
        rows:
                 value  0
    end: `LmTestCall.param.index`

    table:
        name: `unit.backend`
        columns: class        (backend class)
        rows:
                 lm_test_unit c.static-unit
    end: `unit.backend`

    table:
        name: `unit.payload`
        columns: class        (payload char)
        rows:
                 lm_test_unit "int lm_test_unit(void) { return 0; }"
    end: `unit.payload`
end: L4

alias
forward
prototype
callable_alias
unit

guard: LM_TEST_GUARD
    "int lm_test_guard_value;\n"
end: guard

extern_c:
    "int lm_test_extern_value;\n"
end: extern_c
