        rows:
                 number 0
                 text   1
    end: `LmTestNodeAs.field.index`

    table:
        name: `LmTestNodeAs.field.address-depth`
        columns: class  (depth serial)
        rows:
                 text   1
    end: `LmTestNodeAs.field.address-depth`

    table:
        name: `alias.backend`
        columns: class        (backend class)
        rows:
                 LmTestAlias  c.typedef
    end: `alias.backend`

    table:
        name: `alias.target`
        columns: class        (target class)
        rows:
                 LmTestAlias  int
    end: `alias.target`

    table:
        name: `forward.backend`
        columns: class          (backend class)
        rows:
                 LmTestForward  c.struct
    end: `forward.backend`

    table:
        name: `prototype.backend`
