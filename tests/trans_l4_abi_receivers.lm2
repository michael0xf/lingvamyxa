        rows:
                 text   1
    end: `LmTestUnion.field.address-depth`

    table:
        name: `LmTestNode.field.class`
        columns: class  (field class)
        rows:
                 kind   int
    end: `LmTestNode.field.class`

    table:
        name: `LmTestNode.field.union`
        columns: class  (union class)
        rows:
                 as     LmTestNodeAs
    end: `LmTestNode.field.union`

    table:
        name: `LmTestNode.field.index`
        columns: class  (index serial)
        rows:
                 kind   0
                 as     1
    end: `LmTestNode.field.index`

    table:
        name: `LmTestNodeAs.field.class`
        columns: class  (field class)
        rows:
                 number int
                 text   char
    end: `LmTestNodeAs.field.class`

    table:
        name: `LmTestNodeAs.field.index`
