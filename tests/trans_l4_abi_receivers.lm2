L4:
    table:
        name: `layout.backend`
        columns: class          (backend class)
        rows:
                 LmTestLayout   c.struct
                 LmTestNamed    c.named-struct
                 LmTestUnion    c.union
                 LmTestNode     c.struct
    end: `layout.backend`

    table:
        name: `LmTestLayout.field.class`
        columns: class    (field class)
        rows:
                 message  char
                 next     LmTestForward
    end: `LmTestLayout.field.class`

    table:
        name: `LmTestLayout.field.index`
        columns: class    (index serial)
        rows:
                 message  0
                 next     1
    end: `LmTestLayout.field.index`

    table:
        name: `LmTestLayout.field.address-depth`
        columns: class    (depth serial)
        rows:
                 next     1
    end: `LmTestLayout.field.address-depth`

    table:
        name: `LmTestLayout.field.array-count`
        columns: class    (count serial)
        rows:
                 message  16
    end: `LmTestLayout.field.array-count`

    table:
        name: `LmTestNamed.field.class`
        columns: class  (field class)
        rows:
                 value  int
    end: `LmTestNamed.field.class`

    table:
        name: `LmTestNamed.field.index`
        columns: class  (index serial)
        rows:
                 value  0
    end: `LmTestNamed.field.index`

    table:
        name: `LmTestUnion.field.class`
        columns: class  (field class)
        rows:
                 value  int
                 text   char
    end: `LmTestUnion.field.class`

    table:
        name: `LmTestUnion.field.index`
        columns: class  (index serial)
        rows:
                 value  0
                 text   1
    end: `LmTestUnion.field.index`

    table:
        name: `LmTestUnion.field.address-depth`
