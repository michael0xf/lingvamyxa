===
#if LM_TEST_CONSTANT_SOURCE != 41
#error "full source constant value differs"
#endif

#if LM_TEST_CONSTANT_VALUE_OVERLAY != 6
#error "split constant value overlay was ignored"
#endif

#if LM_TEST_CONSTANT_BACKEND_OVERLAY != 9
#error "legacy any-c.define membership changed"
#endif

#if LM_TEST_CONSTANT_DUPLICATE != 8
#error "latest duplicate constant row was ignored"
#endif

#if LM_TEST_CONSTANT_SPLIT != 17
#error "split-only constant fallback was ignored"
#endif

#ifdef LM_TEST_CONSTANT_NONE
#error "None source cells unexpectedly emitted a constant"
#endif

#if LM_TEST_CONSTANT_WIDE_SOURCE != 31
#error "N-column constant source value differs"
#endif

#if LM_TEST_CONSTANT_WIDE_DUPLICATE != 39
#error "latest duplicate N-column constant row was ignored"
#endif

#if LM_TEST_CONSTANT_WIDE_LATE_NONE != 41
#error "N-column None cells unexpectedly removed an earlier constant"
#endif

#if LM_TEST_CONSTANT_WIDE_BACKEND_OVERLAY != 47
#error "N-column any-c.define membership or split value overlay changed"
#endif

#if LM_TEST_CONSTANT_WIDE_PHYSICAL != 53
#error "physical constant rows were not merged with N-column rows"
#endif

#if LM_TEST_CONSTANT_WIDE_JOINED != 59
#error "joined N-column constant row was not emitted"
#endif

#if LM_TEST_CONSTANT_WIDE_BACKEND_SCHEMA_FALLBACK != 61
#error "wrong-schema N-column backend did not fall back to the facade row"
#endif

#if LM_TEST_CONSTANT_WIDE_VALUE_SCHEMA_FALLBACK != 67
#error "wrong-schema N-column value did not fall back to the facade row"
#endif

#ifdef LM_TEST_CONSTANT_WIDE_NONE
#error "N-column None source cells unexpectedly emitted a constant"
#endif
