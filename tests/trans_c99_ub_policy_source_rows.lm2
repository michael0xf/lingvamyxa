external:
    fn: main () int
        [64]: char buffer
        int: signed_value 7
        unsigned: unsigned_value 9U
        int: written

        written: c.snprintf(buffer, c.sizeof(buffer), "%d %i %u", signed_value, signed_value, unsigned_value)
        return: written < 0
    end: main
end: external
