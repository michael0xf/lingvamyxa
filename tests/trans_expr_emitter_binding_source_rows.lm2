L4:
    table:
        name: `operator.postfix`
        columns((class: class) (@: char ansi_c) (binding: emitter))
        rows:
                 postinc  "++"  lm_trans_expr_emit_operator
    end: `operator.postfix`

    table:
        name: expr_emitter_binding
        columns((class: class) (class: binding_table))
        rows:
                 `operator.prefix`  `operator.infix.emitter`
                 `operator.prefix`  `operator.prefix.emitter`
                 `operator.prefix`  None
    end: expr_emitter_binding

    table:
        name: expr_emitter_binding
        columns((class: class) (@: char binding_table))
        rows:
                 `operator.postfix`  `operator.postfix.emitter`
    end: expr_emitter_binding

    table:
        name: `lm.test.expr_emitter_binding.seed`
        columns((class: class) (class: binding_table))
        rows:
                 `operator.infix`  `operator.infix.emitter`
    end: `lm.test.expr_emitter_binding.seed`

    join: (`lm.test.expr_emitter_binding.seed`) expr_emitter_binding
        columns((class: class) (class: binding_table))
        rows:
    end: expr_emitter_binding

    table:
        name: expr_emitter_binding
        columns((class: class) (class: binding_table))
        rows:
                 `operator.infix`  None
    end: expr_emitter_binding
end: L4

external:
    fn: main () int
        int: value 2
        int: postfix_result
        int: prefix_result
        int: infix_result

        postfix_result: value postinc
        prefix_result: ! value
        infix_result: postfix_result + value
        return: postfix_result != 2 || prefix_result != 0 || infix_result != 5 || value != 3
    end: main
end: external
