L2:
    OccurrenceValue:
        int: value
        @: char text
        int: value
    end: OccurrenceValue

    external:
        fn: main () int
            OccurrenceValue: occurrenceValue
                value: 10
                text: "ok"
                value: 20
            end: occurrenceValue

            if: occurrenceValue\[0]value != 10
                return: 1
            if: occurrenceValue\[1]value != 20
                return: 2
            if: occurrenceValue\value != 20
                return: 3
            if: occurrenceValue\text[1] != 'k'
                return: 4

            occurrenceValue\[0]value: 11
            if: occurrenceValue\[0]value != 11 || occurrenceValue\[1]value != 20 || occurrenceValue\value != 20
                return: 5

            occurrenceValue\value: 21
            if: occurrenceValue\[0]value != 11 || occurrenceValue\[1]value != 21 || occurrenceValue\value != 21
                return: 6

            occurrenceValue: 0
            return: occurrenceValue != 0
        end: main
    end: external
end: L2
