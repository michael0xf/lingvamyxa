L2:
    OccurrenceDynamic:
        int: value
        int: value
    end: OccurrenceDynamic

    fn: selectOccurrence (int: occurrence) int
        OccurrenceDynamic: occurrenceDynamic
            value: 1
            value: 2
        end: occurrenceDynamic
        return: occurrenceDynamic\[occurrence]value
    end: selectOccurrence

    external:
        fn: main () int
            return: selectOccurrence(1) != 2
        end: main
    end: external
end: L2
