L2:
    Holder:
        @: int value
    end: Holder

    fn: accept_char (@: char value) int
        return: value = 0
    end: accept_char

    table:
        name: t
        columns: (Holder: holder)
        rows:
                 Holder:
                     value: 0
    end: t

    external:
        fn: main () int
            return: accept_char(t[0]\holder\value)
        end: main
    end: external
end: L2
