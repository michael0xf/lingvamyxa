import: "lm2/own.lm2"

fn: IntSource () int

fn: AddX (int: value) int

fn: five () int
    return: 5
end: five

fn: addDefault (int: base 4; int: value 3) int
    return: base + value
end: addDefault

fn: addBase (int: base 4; int: value) int
    return: base + value
end: addBase

fn: defaultValues () []: int
    return: [2 4 6]
end: defaultValues

fn: pickLiteral ([3]: int values [2 4 6]; int: index 1) int
    return: values[index]
end: pickLiteral

fn: pickGenerated ([]: int values defaultValues(); int: index 2) int
    return: values[index]
end: pickGenerated

fn: callSource (IntSource: source five) int
    return: source()
end: callSource

