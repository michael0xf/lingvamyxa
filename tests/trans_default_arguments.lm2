end: callAdd

external:
    fn: main () int
        return: addDefault() != 7 || addDefault(10) != 13 || addDefault(; 8) != 12 || addDefault(value: 8) != 12 || callSource() != 5 || callAdd(addBase()) != 7 || pickLiteral() != 4 || pickLiteral(index: 2) != 6 || pickLiteral([2 4 6], 0) != 2 || pickGenerated() != 6
