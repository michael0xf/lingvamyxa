import: "lm4/own_abi.lm4"
include
alias
forward
constant
fn
layout
prototype

fn: values () []: int
    return: [1 2 3]
end: values

fn: matrix () [][]: int
    return: [[1 2] [3 4 5]]
end: matrix

fn: cubeValues () [][][]: int
    return: [[[1] [2 3]] [[4 5 6]]]
end: cubeValues

external:
    fn: main () int
        LmSlice: p
        LmSlice: m
        LmSlice: cube
        @: int pItems
        @@: int mItems
        @@@: int cubeItems
        const: LmOwnAllocationDescriptor: pDesc
        const: LmOwnAllocationDescriptor: rowDesc
        const: LmOwnAllocationDescriptor: cubeDesc
        p: values()
        m: matrix()
        cube: cubeValues()
        pItems: cast: (@: int) p\ptr
        mItems: cast: (@@: int) m\ptr
        cubeItems: cast: (@@@: int) cube\ptr
        pDesc: c.lm_own_allocation_descriptor(pItems)
        rowDesc: c.lm_own_allocation_descriptor(mItems[1])
        cubeDesc: c.lm_own_allocation_descriptor(cubeItems[0][1])
        return: p\length != 3 || m\length != 2 || cube\length != 2 || pItems[2] != 3 || mItems[0][1] != 2 || mItems[1][2] != 5 || cubeItems[0][1][1] != 3 || cubeItems[1][0][2] != 6 || pDesc = 0 || pDesc\rank != 1 || pDesc\level != 0 || pDesc\count != 3 || rowDesc = 0 || rowDesc\rank != 2 || rowDesc\level != 1 || rowDesc\count != 3 || cubeDesc = 0 || cubeDesc\rank != 3 || cubeDesc\level != 2 || cubeDesc\count != 2
    end: main
end: external
