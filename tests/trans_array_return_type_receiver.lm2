import: "lm4/own_abi.lm4"
include
alias
forward
constant
fn
layout
prototype

fn: values () []: int
    return: [1 2 3]
end: values

fn: matrix () [][]: int
    return: [[1 2] [3 4 5]]
end: matrix

fn: cubeValues () [][][]: int
    return: [[[1] [2 3]] [[4 5 6]]]
end: cubeValues

external:
    fn: main () int
        @: int p
        @@: int m
        @@@: int cube
        const: LmOwnAllocationDescriptor: pDesc
        const: LmOwnAllocationDescriptor: rowDesc
        const: LmOwnAllocationDescriptor: cubeDesc
        p: values()
        m: matrix()
        cube: cubeValues()
        pDesc: c.lm_own_allocation_descriptor(p)
        rowDesc: c.lm_own_allocation_descriptor(m[1])
        cubeDesc: c.lm_own_allocation_descriptor(cube[0][1])
        return: p[2] != 3 || m[0][1] != 2 || m[1][2] != 5 || cube[0][1][1] != 3 || cube[1][0][2] != 6 || pDesc = 0 || pDesc\rank != 1 || pDesc\level != 0 || pDesc\count != 3 || rowDesc = 0 || rowDesc\rank != 2 || rowDesc\level != 1 || rowDesc\count != 3 || cubeDesc = 0 || cubeDesc\rank != 3 || cubeDesc\level != 2 || cubeDesc\count != 2
    end: main
end: external
