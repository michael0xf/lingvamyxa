L2:
    thread: lm_test_builtin_thread (IncomingMessage: message)
        route: "/builtin"
        if: message\lmx = 0 || message\length = 0U
            stop: 11
            return:
        ---
    end: lm_test_builtin_thread

    external:
        fn: main () int
            return: 0
        end: main
    end: external
end: L2
