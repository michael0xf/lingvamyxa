L2:
    ifdef:
        LM_TEST_FM_CONDITIONAL_DIFFERENT:
            fm: pair () (int: left)
                return: (1)
            end: pair
        default:
            fm: pair () (double: right)
                return: (2.0)
            end: pair
    end: ifdef

    external:
        fn: main () int
            pairReturn: result pair()
            return: result = 0
        end: main
    end: external
end: L2
