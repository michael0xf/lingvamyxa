#include <stddef.h>

struct LmMergeCall { short call_value; };

static int lm_test_layout_backend_merge_consumers(void) {
    return offsetof(LmMergeCombined, direct_value) != 0U ||
           offsetof(LmMergeCombined, joined_value) <= offsetof(LmMergeCombined, direct_value) ||
           offsetof(LmMergeCombined, wide_value) <= offsetof(LmMergeCombined, joined_value) ||
           offsetof(LmMergeCombined, wide_joined_value) <= offsetof(LmMergeCombined, wide_value) ||
           offsetof(LmMergeCombined, call_value) <= offsetof(LmMergeCombined, wide_joined_value) ||
           offsetof(LmMergeCombined, local_value) <= offsetof(LmMergeCombined, call_value);
}
