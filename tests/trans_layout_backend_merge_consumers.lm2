forward

include: "<stddef.h>" "trans_layout_backend_merge_consumers.support.h"

fn: lm_test_layout_backend_merge_consumers () int
    return: c.offsetof(c.LmMergeCombined, c.direct_value) != 0U || c.offsetof(c.LmMergeCombined, c.joined_value) <= c.offsetof(c.LmMergeCombined, c.direct_value) || c.offsetof(c.LmMergeCombined, c.wide_value) <= c.offsetof(c.LmMergeCombined, c.joined_value) || c.offsetof(c.LmMergeCombined, c.wide_joined_value) <= c.offsetof(c.LmMergeCombined, c.wide_value) || c.offsetof(c.LmMergeCombined, c.call_value) <= c.offsetof(c.LmMergeCombined, c.wide_joined_value) || c.offsetof(c.LmMergeCombined, c.local_value) <= c.offsetof(c.LmMergeCombined, c.call_value)
end: lm_test_layout_backend_merge_consumers

fn: lm_make_merge_call () LmMergeCall
    return: 0
end: lm_make_merge_call

merge: (LmMergeDirect LmMergeJoined LmMergeWide LmMergeWideJoined lm_make_merge_call()) LmMergeCombined
    int: local_value 29
end: LmMergeCombined

external:
    fn: main () int
        return: lm_test_layout_backend_merge_consumers() || lm_make_merge_call() != 0 || LmMergeCombined\local_value != 29
    end: main
end: external
