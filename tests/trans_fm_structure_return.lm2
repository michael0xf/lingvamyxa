L2:
    FmResultProbe:
        @: void source 0
    end: FmResultProbe

    sub: lm_test_remember_fm_result (@: void value)
        c.lm_FmResultProbe\source: value
    end: lm_test_remember_fm_result

    fn: lm_test_is_fm_result (@: void value) int
        return: FmResultProbe\source = value
    end: lm_test_is_fm_result

    fm: pair () (int: left; int: right)
        lm_test_remember_fm_result(c.lm_fm_result)
        return: (1 2)
    end: pair

    fm: namedPair () (int: left; int: right)
        return: (right: 5; left: 4)
    end: namedPair

    fm: boxedUser () (User: value; int: marker)
        return: (User 7)
    end: boxedUser

    # The fm layout is registered after the declaration pass, so a referenced
    # Structure may be declared later in the same L2 module.
    User:
        int: age 9
    end: User

    external:
        fn: main () int
            pairReturn: first
            namedPairReturn: second
            pairReturn: again
            boxedUserReturn: boxed
            first: pair()
            if: lm_test_is_fm_result(cast: (@: void) first) = 0
                return: 1
            second: namedPair()
            again: pair()
            boxed: boxedUser()
            return: first = again || first\left != 1 || first\right != 2 || second\left != 4 || second\right != 5 || again\left != 1 || again\right != 2 || boxed\value != User || boxed\value\age != 9 || boxed\marker != 7
        end: main
    end: external
end: L2
