predef: "lm2/own_abi.lm2"
include
alias
forward
constant
fn
layout
prototype

File:
    int: handle
    fn: close () int
end: File

fn: manager (File: f) int
    return: f\close()
end: manager

external:
    fn: main () int
        File: f
            handle: 1
        end: f
        if: f = 0 || f\handle != 1
            return: 1
        if: f\close() != 0
            return: 2
        if: manager(f) != 0
            return: 3
        if: implements(f File File) != 1
            return: 4
        return: 0
    end: main
end: external
