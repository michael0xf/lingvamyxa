fn: lm_test_alias_join_tables (const: @(char source_table); const: @(char target_table)) int
    LmP0Text: source_text
    LmP0Text: target_text
    int: status

    source_text: lm_trans_text_from_cstr(source_table)
    target_text: lm_trans_text_from_cstr(target_table)
    status: 1
    if: source_text != 0 && target_text != 0
        status: lm_trans_registry_join_table(source_text, target_text)
    lm_trans_text_ref_destroy(@ source_text)
    lm_trans_text_ref_destroy(@ target_text)
return: status

fn: lm_test_alias_lookup_fact (const: @(char table_name); const: @(char key)) LmTransRegistryFact
    LmP0Text: key_text
