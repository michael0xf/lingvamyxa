    key_text: lm_trans_text_from_cstr(key)
    fact: 0
    if: key_text != 0
        fact: lm_trans_registry_lookup_row_in_identifiers(lm_trans_registry\identifiers, key_text, table_name)
    lm_trans_text_ref_destroy(@ key_text)
return: fact

