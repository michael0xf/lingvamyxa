L2:
    BridgeA:
        int: value
    end: BridgeA

    BridgeB:
        BridgeA: child
    end: BridgeB

    external:
        fn: main () int
            BridgeA: bridgeA
                value: 17
            end: bridgeA
            BridgeB: bridgeB
                child: bridgeA
            end: bridgeB
            return: bridgeA\value != 17 || bridgeB = 0 || bridgeB\child != bridgeA
        end: main
    end: external
end: L2
