import: "lm2/trans_library.lm2"

external:
    fn: main () int
        return: lm_test_anonymous_structure_namespace_core()
    end: main
end: external

fn: lm_test_anonymous_structure_root_frame (const: (LmP0Document: document)) const: LmP0Frame
    const: LmP0Node: root
    const: LmP0Field: field

    root: lm_p0_document_root(document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
    field: lm_trans_l2_structure_first_present_field(root\as\structure)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_l2_structure_next_present_field(field) != 0
        return: 0
return: field\value\as\frame

fn: lm_test_anonymous_structure_namespace_core () int
    const: @(char source)
    LmP0Document: document
    const: LmP0Frame: frame
    LmTransNamespace: namespace_
    LmP0Text: result_name
    const: LmTransSymbol: result_symbol
    const: LmTransSymbol: type_relation
    const: LmTransDescriptor: descriptor
    const: LmTransDescriptorField: first_field
    const: LmTransDescriptorField: second_field
    FILE: output
    size_t: baseline_fact_count
    size_t: baseline_view_fact_count
    size_t: baseline_source_table_count
    int: previous_executable_depth
    int: output_projection_entered
    int: namespace_scope_entered
    int: status

    source: "(): registryProbe\n    int: repeated 1\n    int: repeated 2\nend: registryProbe\n"
    document: 0
    namespace_: 0
    result_name: 0
    output: 0
    baseline_fact_count: 0U
    baseline_view_fact_count: 0U
    baseline_source_table_count: 0U
    previous_executable_depth: lm_trans_l2_executable_statement_depth
    output_projection_entered: 0
    namespace_scope_entered: 0
    status: 0

    lm_trans_registry_destroy()
    if: lm_trans_registry_load_for_source("tests/trans_anonymous_structure_namespace_core.lm2") != 0
        return: 1
    lm_trans_registry\view_mode: 2

    if: lm_p0_parse_string(source, @ document) != 0 || document = 0
        status: 1
    frame: lm_test_anonymous_structure_root_frame(document)
    namespace_: lm_trans_namespace_new()
    output: lm_trans_tmpfile()
    if: status = 0 && (frame = 0 || namespace_ = 0 || output = 0 || lm_trans_namespace_attach_registry(namespace_) != 0)
        status: 1

    if: status = 0
        baseline_fact_count: lm_trans_registry\loaded_fact_count
        baseline_view_fact_count: lm_registry_view_fact_count(lm_trans_registry\view)
        baseline_source_table_count: lm_registry_view_source_table_count(lm_trans_registry\view)
    if: status = 0 && lm_trans_typedef_projection_output_enter(0, output) != 0
        status: 1
    else:
        if: status = 0
            output_projection_entered: 1
        ---
    if: namespace_ != 0
        lm_trans_namespace_enter_scope(namespace_)
        namespace_scope_entered: 1

    lm_trans_l2_executable_statement_depth: previous_executable_depth + 1
    if: status = 0
        if: lm_trans_emit_anonymous_structure_construction(output, frame, 1U, namespace_) != 0
            status: 1
        ---
    lm_trans_l2_executable_statement_depth: previous_executable_depth

    result_name: lm_trans_text_from_cstr("registryProbe")
    result_symbol: lm_trans_namespace_find(namespace_, result_name)
    descriptor: lm_trans_namespace_descriptor(namespace_, result_name)
    type_relation: lm_trans_namespace_relation_symbol_latest(namespace_, result_name, "variable.type")
    first_field: lm_trans_descriptor_structural_field_by_index(descriptor, 0U)
    second_field: lm_trans_descriptor_structural_field_by_index(descriptor, 1U)

    if: status = 0 && (result_name = 0 || result_symbol = 0 || lm_trans_symbol_is(result_symbol, "variable") = 0 || result_symbol\descriptor != descriptor || descriptor = 0 || descriptor\has_structural_fields = 0 || descriptor\structural_fields = 0 || descriptor\structural_fields\count != 2U)
        status: 1
    if: status = 0 && (first_field = 0 || second_field = 0 || first_field\name = 0 || second_field\name = 0 || c.strcmp(first_field\name, "repeated") != 0 || c.strcmp(second_field\name, "repeated") != 0 || first_field\index != 0U || second_field\index != 1U)
        status: 1
    if: status = 0 && (type_relation = 0 || type_relation\has_c_name = 0 || type_relation\c_name = 0 || type_relation\c_name\data = 0 || c.strcmp(type_relation\c_name\data, "registryProbe") != 0)
        status: 1
    if: status = 0 && (lm_trans_descriptor_class_relation_value(descriptor, "lm.trans.c.type") = 0 || lm_trans_descriptor_class_relation_value(descriptor, "lm.trans.c.indexed-members") = 0 || c.strcmp(lm_trans_descriptor_class_relation_value(descriptor, "lm.trans.c.indexed-members"), "1") != 0)
        status: 1

    if: status = 0 && (lm_trans_registry\loaded_fact_count != baseline_fact_count || lm_registry_view_fact_count(lm_trans_registry\view) != baseline_view_fact_count || lm_registry_view_source_table_count(lm_trans_registry\view) != baseline_source_table_count)
        status: 1
    if: status = 0 && (lm_trans_registry_relation_stack_for_table("registryProbe.field.class") != 0 || lm_trans_registry_relation_stack_for_table("registryProbe.field.index") != 0 || lm_trans_registry_relation_stack_for_table("registryProbe.field.address-depth") != 0)
        status: 1

    lm_trans_text_ref_destroy(@ result_name)
    if: namespace_scope_entered
        lm_trans_namespace_leave_scope(namespace_)
    lm_trans_namespace_delete(namespace_)
    if: document != 0
        lm_p0_document_destroy(document)
    if: output_projection_entered && lm_trans_typedef_projection_output_leave() != 0
        status: 1
    if: output != 0
        c.fclose(output)
    lm_trans_registry_destroy()
return: status
