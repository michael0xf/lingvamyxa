    source
    name: `lm.test.class.semantic.seed`
    columns: (class: class) (int: marker) (@: char semantic)
    rows:
             long  7  opaqueHandle
end: `lm.test.class.semantic.seed`

join: (`lm.test.class.semantic.seed`) `lm.test.class.semantic.middle`
    columns: (class: class) (int: marker) (@: char semantic)
    rows:
end: `lm.test.class.semantic.middle`

join: (`lm.test.class.semantic.middle`) class
    columns: (class: class) (int: marker) (@: char semantic)
