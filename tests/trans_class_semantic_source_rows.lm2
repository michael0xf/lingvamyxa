table:
    source
    name: class
    columns: (class: class) (int: marker) (@: char semantic)
    rows:
             long  8  None
end: class

table:
    source
    name: `layout.backend`
    columns: (class: class) (class: backend)
    rows:
             LmTestClassSemantic  c.struct
end: `layout.backend`

table:
    source
    name: LmTestClassSemantic
    columns: (class: class) (class: `field.class`) (size_t: `field.index`)
    rows:
             direct    int    0
             fallback  short  1
             joined    long   2
end: LmTestClassSemantic

include: "trans_class_semantic_source_rows.support.h"
layout

fn: lm_test_class_semantic_source_rows () int
    c.struct: c.LmTestClassSemanticPhysicalScalars scalars
    c.struct: c.LmTestClassSemantic value

    c.scalars.fallback: 8
    c.scalars.joined: 9
    c.value.direct: 7
    c.value.fallback: @ c.scalars.fallback
    c.value.joined: @ c.scalars.joined
    return: c.value.direct != 7 || c.value.fallback[0] != 8 || c.value.joined[0] != 9
end: lm_test_class_semantic_source_rows

fn: lm_test_semantic_direct (int: value) int
    return: value != 7
end: lm_test_semantic_direct

fn: lm_test_semantic_fallback (short: value) int
    return: value != 0
end: lm_test_semantic_fallback

fn: lm_test_semantic_joined (long: value) int
    return: value != 0
end: lm_test_semantic_joined

external:
    fn: main () int
        return: lm_test_class_semantic_source_rows() || lm_test_semantic_direct(7) || lm_test_semantic_fallback(0) || lm_test_semantic_joined(0)
    end: main
end: external
