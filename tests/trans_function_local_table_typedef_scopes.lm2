L2:
    fn: lm_test_local_table_left () int
        table:
            name: sample
            columns: (int: left)
            rows:
                     11
        end: sample
        if: sample = 0 || sample\ptr = 0 || sample\length != 1U || sample[0] = 0
            return: 0
        return: sample[0]\left
    end: lm_test_local_table_left

    fn: lm_test_local_table_right () int
        table:
            name: sample
            columns: (int: right)
            rows:
                     22
        end: sample
        if: sample = 0 || sample\ptr = 0 || sample\length != 1U || sample[0] = 0
            return: 0
        return: sample[0]\right
    end: lm_test_local_table_right

    fn: lm_test_local_table_inner_shadow () int
        lm_l2_table_innerSample_row:
            int: outer
        end: lm_l2_table_innerSample_row
        lm_l2_table_innerSample_row: outerRow
            outer: 31
        end: outerRow
        if: 1 = 1
            table:
                name: innerSample
                columns: (int: inner)
                rows:
                         41
            end: innerSample
            if: innerSample = 0 || innerSample\ptr = 0 || innerSample\length != 1U || innerSample[0] = 0 || innerSample[0]\inner != 41
                return: 1
        end: if
        return: outerRow\outer
    end: lm_test_local_table_inner_shadow

    external:
        fn: main () int
            return: lm_test_local_table_left() != 11 || lm_test_local_table_right() != 22 || lm_test_local_table_inner_shadow() != 31
        end: main
    end: external
end: L2
