import: "lm2/own.lm2"

fn: IntSource () int

`lazy fn`: AddX (int: value) int

fn: five () int
    return: 5
end: five

fn: addBase (int: base; int: value) int
    return: base + value
end: addBase

fn: callSource (IntSource: source) int
    return: source()
end: callSource

fn: callAdd (AddX: add) int
    return: add(3)
end: callAdd

external:
    fn: main () int
        return: callSource(five) != 5 || callAdd(addBase(4)) != 7
    end: main
end: external
