import: "lm2/own.lm2"

callable: IntSource () int

callable: AddX (int: value) int

fn: five () int
    return: 5
end: five

fn: addBase (int: base; int: value) int
    return: base + value
end: addBase

fn: callSource (IntSource: source) int
    return: source()
end: callSource

fn: callAdd (AddX: add) int
    return: add(3)
end: callAdd

fn: binderInArena (AddX: add) int
    if: add = 0
        return: 1
    if: c.lm_own_arena_allocation_descriptor(c.lm_lmx_message_thread, lm_message_thread_owner(c.lm_lmx_message_thread), add) = 0
        return: 1
    return: 0
end: binderInArena

external:
    fn: main () int
        if: callSource(five) != 5 || callAdd(addBase(4)) != 7 || callAdd(partial(addBase, 4)) != 7
            return: 1
        if: binderInArena(partial(addBase, 4)) != 0
            return: 2
        return: 0
    end: main
end: external
