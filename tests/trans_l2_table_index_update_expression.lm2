L2:
    fn: table_index_update_expression () int
        table:
            name: t
            columns: (int: value)
            rows:
                     7
        end: t
        int: i 0
        int: value t[i++]\value
        return: value != 7 || i != 1
    end: table_index_update_expression

    external:
        fn: main () int
            return: table_index_update_expression()
        end: main
    end: external
end: L2
