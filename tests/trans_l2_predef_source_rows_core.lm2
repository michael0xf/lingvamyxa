import: "lm2/trans_library.lm2"

external:
    fn: main () int
        return: lm_test_l2_predef_source_rows_core()
    end: main
end: external

fn: lm_test_l2_predef_table_has_rows (const: @(char name); size_t: count) int
    const: LmTableDescriptor: descriptor

    descriptor: lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, name, c.strlen(name))
return: descriptor != 0 && lm_table_descriptor_materialized_row_count(descriptor) = count

fn: lm_test_l2_predef_table_has_one_row (const: @(char name)) int
    return: lm_test_l2_predef_table_has_rows(name, 1U)
end: lm_test_l2_predef_table_has_one_row

fn: lm_test_l2_default_core_is_source_table () int
    const: LmTableDescriptor: descriptor
    const: LmTableColumnDescriptor: key_column
    const: LmTableColumnDescriptor: value_column
    const: LmTableRow: row
    const: LmTableCell: key_cell
    const: LmTableCell: value_cell

    descriptor: lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, "class", 5U)
    if: descriptor = 0 || lm_table_descriptor_column_count(descriptor) != 2U || lm_table_descriptor_materialized_row_count(descriptor) < 180U
        return: 0

    key_column: lm_table_descriptor_column_at(descriptor, 0U)
    value_column: lm_table_descriptor_column_at(descriptor, 1U)
    if: key_column = 0 || key_column\name = 0 || key_column\type_name = 0 || c.strcmp(key_column\name, "class") != 0 || c.strcmp(key_column\type_name, "class") != 0 || value_column = 0 || value_column\name = 0 || value_column\type_name = 0 || c.strcmp(value_column\name, "kind") != 0 || c.strcmp(value_column\type_name, "class") != 0
        return: 0

    row: lm_table_descriptor_materialized_row_at(descriptor, 0U)
    key_cell: lm_table_row_cell_at(row, 0U)
    value_cell: lm_table_row_cell_at(row, 1U)
    if: key_cell = 0 || key_cell\value = 0 || c.strcmp(key_cell\value, "class") != 0 || value_cell = 0 || value_cell\value = 0 || c.strcmp(value_cell\value, "core") != 0
        return: 0

    row: lm_table_descriptor_materialized_row_at(descriptor, 179U)
    key_cell: lm_table_row_cell_at(row, 0U)
    value_cell: lm_table_row_cell_at(row, 1U)
return: key_cell != 0 && key_cell\value != 0 && c.strcmp(key_cell\value, "right") = 0 && value_cell != 0 && value_cell\value != 0 && c.strcmp(value_cell\value, "relation") = 0

fn: lm_test_l2_bootstrap_join_is_exact () int
    const: LmTableDescriptor: source
    const: LmTableDescriptor: target
    const: LmTableRow: source_row
    const: LmTableRow: base_row
    const: LmTableRow: copied_row
    const: LmTableRow: direct_row
    const: LmTableCell: key_cell
    const: LmTableCell: value_cell

    source: lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, "lmTestBootstrapSource", 21U)
    target: lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, "lmTestBootstrap", 15U)
    if: source = 0 || target = 0 || lm_table_descriptor_materialized_row_count(source) != 1U || lm_table_descriptor_materialized_row_count(target) != 3U
        return: 0

    source_row: lm_table_descriptor_materialized_row_at(source, 0U)
    base_row: lm_table_descriptor_materialized_row_at(target, 0U)
    copied_row: lm_table_descriptor_materialized_row_at(target, 1U)
    direct_row: lm_table_descriptor_materialized_row_at(target, 2U)
    if: source_row = 0 || base_row = 0 || copied_row = 0 || direct_row = 0 || source_row\source != 0 || base_row\source != 0 || copied_row\source != source_row || direct_row\source != 0
        return: 0

    key_cell: lm_table_row_cell_at(copied_row, 0U)
    value_cell: lm_table_row_cell_at(copied_row, 1U)
    if: key_cell = 0 || key_cell\value = 0 || c.strcmp(key_cell\value, "lmTestBootstrapCopied") != 0 || value_cell = 0 || value_cell\value = 0 || c.strcmp(value_cell\value, "primitive") != 0
        return: 0

    key_cell: lm_table_row_cell_at(direct_row, 0U)
    value_cell: lm_table_row_cell_at(direct_row, 1U)
return: key_cell != 0 && key_cell\value != 0 && c.strcmp(key_cell\value, "lmTestBootstrapDirect") = 0 && value_cell != 0 && value_cell\value != 0 && c.strcmp(value_cell\value, "relation") = 0

fn: lm_test_l2_bootstrap_candidate_order_is_exact () int
    const: @: char candidate

    candidate: lm_trans_registry_candidate_name(0U)
    if: candidate = 0 || c.strcmp(candidate, "lm2/trans_registry.lm2") != 0
        return: 0
    candidate: lm_trans_registry_candidate_name(1U)
    if: candidate = 0 || c.strcmp(candidate, "trans_registry.lm2") != 0
        return: 0
    candidate: lm_trans_registry_candidate_name(2U)
    if: candidate = 0 || c.strcmp(candidate, "trans_registry.lmx") != 0
        return: 0
    candidate: lm_trans_registry_candidate_name(3U)
    if: candidate = 0 || c.strcmp(candidate, "lm2/trans_registry.lmx") != 0
        return: 0
return: lm_trans_registry_candidate_name(4U) = 0

fn: lm_test_l2_trans_registry_profile_is_exact () int
    const: LmTableDescriptor: int8_table
    const: LmTableDescriptor: boolean_table
    const: LmTableDescriptor: category_table
    const: LmTableDescriptor: operator_table
    const: LmTableDescriptor: receiver_table
    const: LmTableRow: row
    const: LmTableCell: key_cell
    const: LmTableCell: value_cell
    const: LmTableCell: emitter_cell
    const: @: char receiver_binding

    int8_table: lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, "int8", 4U)
    boolean_table: lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, "Boolean", 7U)
    if: int8_table = 0 || lm_table_descriptor_column_count(int8_table) != 2U || lm_table_descriptor_materialized_row_count(int8_table) != 0U || boolean_table = 0 || lm_table_descriptor_column_count(boolean_table) != 2U || lm_table_descriptor_materialized_row_count(boolean_table) != 4U
        return: 0

    row: lm_table_descriptor_materialized_row_at(boolean_table, 0U)
    if: row = 0 || row\source != 0
        return: 0
    key_cell: lm_table_row_cell_at(row, 0U)
    value_cell: lm_table_row_cell_at(row, 1U)
    if: key_cell = 0 || key_cell\value = 0 || c.strcmp(key_cell\value, "None") != 0 || value_cell = 0 || value_cell\value = 0 || c.strcmp(value_cell\value, "-1") != 0
        return: 0

    row: lm_table_descriptor_materialized_row_at(boolean_table, 3U)
    if: row = 0 || row\source != 0
        return: 0
    key_cell: lm_table_row_cell_at(row, 0U)
    value_cell: lm_table_row_cell_at(row, 1U)
    if: key_cell = 0 || key_cell\value = 0 || c.strcmp(key_cell\value, "OK") != 0 || value_cell = 0 || value_cell\value = 0 || c.strcmp(value_cell\value, "1") != 0
        return: 0

    category_table: lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, "class.category", 14U)
    if: category_table = 0 || lm_table_descriptor_column_count(category_table) != 11U || lm_table_descriptor_materialized_row_count(category_table) != 9U
        return: 0

    operator_table: lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, "operator.infix", 14U)
    if: operator_table = 0 || lm_table_descriptor_column_count(operator_table) != 3U || lm_table_descriptor_materialized_row_count(operator_table) != 19U
        return: 0
    row: lm_table_descriptor_materialized_row_at(operator_table, 0U)
    if: row = 0 || row\source != 0
        return: 0
    key_cell: lm_table_row_cell_at(row, 0U)
    value_cell: lm_table_row_cell_at(row, 1U)
    emitter_cell: lm_table_row_cell_at(row, 2U)
    if: key_cell = 0 || key_cell\value = 0 || c.strcmp(key_cell\value, "+") != 0 || value_cell = 0 || value_cell\value = 0 || c.strcmp(value_cell\value, "+") != 0 || emitter_cell = 0 || emitter_cell\value = 0 || c.strcmp(emitter_cell\value, "lm_trans_expr_emit_operator") != 0
        return: 0

    receiver_table: lm_registry_view_find_local_source_table_slice(lm_trans_registry\view, "receiver.statement", 18U)
    receiver_binding: lm_trans_registry_lookup_exact(lm_trans_text_from_cstr("table"), "receiver.statement")
return: receiver_table != 0 && lm_table_descriptor_column_count(receiver_table) = 2U && receiver_binding != 0 && c.strcmp(receiver_binding, "lm_trans_statement_emit_table") = 0

fn: lm_test_l2_predef_source_row_count (const: @(char name)) size_t
    const: LmTableDescriptor: descriptor
    size_t: count
    size_t: index

    count: 0U
    index: 0U
    while: index < lm_registry_view_source_table_count(lm_trans_registry\view)
        descriptor: lm_registry_view_source_table_at(lm_trans_registry\view, index)
        if: descriptor != 0 && descriptor\name != 0 && c.strcmp(descriptor\name, name) = 0
            count: count + lm_table_descriptor_materialized_row_count(descriptor)
        index: index + 1U
return: count

fn: lm_test_l2_predef_source_key_row_count (const: @(char name); const: @(char key)) size_t
    const: LmTableDescriptor: descriptor
    const: LmTableRow: row
    const: LmTableCell: key_cell
    size_t: count
    size_t: row_index
    size_t: table_index

    count: 0U
    table_index: 0U
    while: table_index < lm_registry_view_source_table_count(lm_trans_registry\view)
        descriptor: lm_registry_view_source_table_at(lm_trans_registry\view, table_index)
        if: descriptor != 0 && descriptor\name != 0 && c.strcmp(descriptor\name, name) = 0
            row_index: 0U
            while: row_index < lm_table_descriptor_materialized_row_count(descriptor)
                row: lm_table_descriptor_materialized_row_at(descriptor, row_index)
                key_cell: lm_table_row_cell_at(row, 0U)
                if: key_cell != 0 && key_cell\value != 0 && c.strcmp(key_cell\value, key) = 0
                    count: count + 1U
                row_index: row_index + 1U
        ---
        table_index: table_index + 1U
return: count

fn: lm_test_l2_predef_metadata_is_exact () int
    const: @: char cleanup_receiver

    cleanup_receiver: lm_trans_registry_lookup_exact(lm_trans_text_from_cstr("LmTestPredefCleanup"), "fn.receiver")
    if: lm_test_l2_predef_table_has_rows("predefHeaders.item", 2U) = 0 || lm_test_l2_predef_table_has_one_row("prelude.sequence") = 0 || lm_test_l2_predef_table_has_rows("include", 2U) = 0 || lm_test_l2_predef_table_has_one_row("fn.external") = 0 || lm_test_l2_predef_table_has_one_row("functionPointerType") = 0
        return: 0
    if: lm_test_l2_predef_source_row_count("fn") != 5U || lm_test_l2_predef_source_key_row_count("fn", "LmTestPredefEquals") != 1U || lm_test_l2_predef_source_key_row_count("fn", "LmTestPredefMapper") != 1U || lm_test_l2_predef_source_key_row_count("fn", "LmTestPredefFunction") != 1U || lm_test_l2_predef_source_key_row_count("fn", "abs") != 1U || lm_test_l2_predef_source_key_row_count("fn", "LmTestPredefCleanup") != 1U || lm_test_l2_predef_source_key_row_count("fn", "lm_test_predef_value") != 0U
        return: 0
    if: lm_test_l2_predef_source_row_count("LmTestPredefEquals.param") != 2U || lm_test_l2_predef_source_row_count("LmTestPredefEquals.return") != 1U || lm_test_l2_predef_source_row_count("LmTestPredefMapper.param") != 1U || lm_test_l2_predef_source_row_count("LmTestPredefMapper.return") != 1U || lm_test_l2_predef_source_row_count("LmTestPredefFunction.param") != 1U || lm_test_l2_predef_source_row_count("LmTestPredefFunction.return") != 1U || lm_test_l2_predef_source_row_count("abs.param") != 1U || lm_test_l2_predef_source_row_count("abs.return") != 1U || lm_test_l2_predef_source_row_count("LmTestPredefCleanup.param") != 1U || lm_test_l2_predef_source_row_count("LmTestPredefCleanup.return") != 0U || lm_test_l2_predef_source_row_count("lm_test_predef_value.return") != 0U
        return: 0
    if: lm_test_l2_predef_source_key_row_count("class.kind", "LmTestPredefFunction") != 0U || lm_test_l2_predef_source_key_row_count("class.kind", "abs") != 0U || lm_test_l2_predef_source_key_row_count("class.kind", "LmTestPredefCleanup") != 1U || cleanup_receiver = 0 || c.strcmp(cleanup_receiver, "sub") != 0
        return: 0
return: 1

fn: lm_test_l2_predef_source_rows_core () int
    const: @(char source_path)
    LmP0Document: document
    const: LmP0Node: root
    LmTransNamespace: namespace_
    LmP0Text: helper_name
    const: LmTransSymbol: helper_symbol
    const: @: char bootstrap_kind
    size_t: bootstrap_source_count
    size_t: bootstrap_fact_count
    size_t: bootstrap_loaded_fact_count
    size_t: bootstrap_mutation_generation
    size_t: bootstrap_loaded_path_count
    FILE: prelude_file
    long: typedef_position
    int: bootstrap_loaded
    int: status
    int: typedef_projection_entered

    source_path: "tests/trans_l2_predef_import.lm2"
    document: 0
    namespace_: 0
    helper_name: 0
    helper_symbol: 0
    bootstrap_kind: 0
    bootstrap_source_count: 0U
    bootstrap_fact_count: 0U
    bootstrap_loaded_fact_count: 0U
    bootstrap_mutation_generation: 0U
    bootstrap_loaded_path_count: 0U
    prelude_file: 0
    bootstrap_loaded: 0
    status: 0
    typedef_projection_entered: 0

    if: lm_trans_registry_load_for_source(source_path) != 0 || lm_p0_parse_file(source_path, @ document) != 0 || document = 0
        if: document != 0
            lm_p0_document_destroy(document)
        lm_trans_registry_destroy()
        return: 1

    root: lm_p0_document_root(document)
    if: root = 0
        status: 1

    if: status = 0 && (lm_trans_registry_path_already_loaded("lm2/trans_registry.lm2") = 0 || lm_trans_registry_path_is_predefined("lm2/trans_registry.lm2") != 0 || lm_test_l2_trans_registry_profile_is_exact() = 0)
        status: 1

    if: status = 0 && (lm_trans_registry_path_already_loaded("lm2/core.lm2") = 0 || lm_trans_registry_path_is_predefined("lm2/core.lm2") != 0 || lm_test_l2_default_core_is_source_table() = 0 || lm_test_l2_bootstrap_candidate_order_is_exact() = 0)
        status: 1

    if: status = 0 && lm_trans_registry_load_bootstrap_file_path("tests/fixtures/l2_bootstrap_registry.lm2", 1, @ bootstrap_loaded) != 0
        status: 1
    bootstrap_kind: lm_trans_registry_lookup_exact(lm_trans_text_from_cstr("lmTestBootstrapValue"), "lmTestBootstrap")
    if: status = 0 && (bootstrap_loaded = 0 || lm_trans_registry_path_already_loaded("tests/fixtures/l2_bootstrap_registry.lm2") = 0 || lm_trans_registry_path_is_predefined("tests/fixtures/l2_bootstrap_registry.lm2") != 0 || lm_trans_registry\predefined_paths = 0 || lm_trans_registry\predefined_paths\count != 0U || lm_test_l2_bootstrap_join_is_exact() = 0 || bootstrap_kind = 0 || c.strcmp(bootstrap_kind, "descriptor") != 0)
        status: 1
    bootstrap_source_count: lm_registry_view_source_table_count(lm_trans_registry\view)
    bootstrap_fact_count: lm_registry_view_fact_count(lm_trans_registry\view)
    bootstrap_loaded_fact_count: lm_trans_registry\loaded_fact_count
    bootstrap_mutation_generation: lm_trans_registry\view\mutation_generation
    bootstrap_loaded_path_count: lm_trans_registry\loaded_paths\count
    bootstrap_loaded: 0
    if: status = 0 && (lm_trans_registry_load_bootstrap_file_path("tests/fixtures/l2_bootstrap_registry.lm2", 1, @ bootstrap_loaded) != 0 || bootstrap_loaded = 0 || lm_registry_view_source_table_count(lm_trans_registry\view) != bootstrap_source_count || lm_registry_view_fact_count(lm_trans_registry\view) != bootstrap_fact_count || lm_trans_registry\loaded_fact_count != bootstrap_loaded_fact_count || lm_trans_registry\view\mutation_generation != bootstrap_mutation_generation || lm_trans_registry\loaded_paths\count != bootstrap_loaded_path_count || lm_test_l2_bootstrap_join_is_exact() = 0)
        status: 1

    if: status = 0 && lm_trans_registry_load_inline_root(root, source_path) != 0
        status: 1

    if: status = 0 && (lm_trans_registry\predefined_paths = 0 || lm_trans_registry\predefined_paths\count != 1U || lm_trans_registry_path_is_predefined("tests/fixtures/l2_predef_registry.lm2") = 0)
        status: 1
    if: status = 0 && lm_test_l2_predef_metadata_is_exact() = 0
        status: 1

    if: status = 0 && lm_trans_registry_load_inline_root(root, source_path) != 0
        status: 1
    if: status = 0 && (lm_trans_registry\predefined_paths\count != 1U || lm_test_l2_predef_metadata_is_exact() = 0)
        status: 1

    lm_trans_declared_import_paths: lm_trans_ptr_stack_new(lm_own_delete_plain)
    lm_trans_declared_import_documents: lm_trans_ptr_stack_new(0)
    namespace_: lm_trans_namespace_new()
    lm_trans_current_source_path: source_path
    lm_trans_l2_table_materialization_suppression_depth: 0
    lm_trans_l2_conditional_import_depth: 0
    lm_trans_l2_conditional_emission_depth: 0
    if: status = 0
        if: lm_trans_typedef_projection_output_enter() != 0
            status: 1
        else:
            typedef_projection_entered: 1
        ---
    if: status = 0 && (lm_trans_declared_import_paths = 0 || lm_trans_declared_import_documents = 0 || namespace_ = 0 || lm_trans_namespace_attach_registry(namespace_) != 0 || lm_trans_declare_l2_import_root(namespace_, root, 1) != 0)
        status: 1

    helper_name: lm_trans_text_from_cstr("LmTestPredefEquals")
    helper_symbol: 0
    if: helper_name != 0
        helper_symbol: lm_trans_namespace_find(namespace_, helper_name)
    if: status = 0 && (helper_name = 0 || helper_symbol = 0 || lm_trans_symbol_is(helper_symbol, "callableDescriptor") = 0 || lm_trans_registry\predefined_paths\count != 1U || lm_test_l2_predef_metadata_is_exact() = 0)
        status: 1
    lm_trans_text_ref_destroy(@ helper_name)
    helper_name: lm_trans_text_from_cstr("LmTestPredefMapper")
    helper_symbol: 0
    if: helper_name != 0
        helper_symbol: lm_trans_namespace_find(namespace_, helper_name)
    if: status = 0 && (helper_name = 0 || helper_symbol = 0 || lm_trans_symbol_is(helper_symbol, "callableDescriptor") = 0)
        status: 1
    lm_trans_text_ref_destroy(@ helper_name)
    helper_name: lm_trans_text_from_cstr("LmTestPredefFunction")
    helper_symbol: 0
    if: helper_name != 0
        helper_symbol: lm_trans_namespace_find(namespace_, helper_name)
    if: status = 0 && (helper_name = 0 || helper_symbol = 0 || lm_trans_symbol_is(helper_symbol, "function") = 0 || helper_symbol\callable_is_external)
        status: 1
    lm_trans_text_ref_destroy(@ helper_name)
    helper_name: lm_trans_text_from_cstr("abs")
    helper_symbol: 0
    if: helper_name != 0
        helper_symbol: lm_trans_namespace_find(namespace_, helper_name)
    if: status = 0 && (helper_name = 0 || helper_symbol = 0 || lm_trans_symbol_is(helper_symbol, "function") = 0 || helper_symbol\callable_is_external = 0 || lm_trans_fn_is_external(namespace_, helper_name) = 0)
        status: 1
    lm_trans_text_ref_destroy(@ helper_name)
    helper_name: lm_trans_text_from_cstr("LmTestPredefCleanup")
    helper_symbol: 0
    if: helper_name != 0
        helper_symbol: lm_trans_namespace_find(namespace_, helper_name)
    if: status = 0 && (helper_name = 0 || helper_symbol = 0 || lm_trans_symbol_is(helper_symbol, "procedure") = 0 || helper_symbol\has_callable_shape = 0 || helper_symbol\callable_returns_value)
        status: 1
    lm_trans_text_ref_destroy(@ helper_name)
    helper_name: lm_trans_text_from_cstr("lm_test_predef_value")
    if: status = 0 && (helper_name = 0 || lm_trans_namespace_find(namespace_, helper_name) = 0)
        status: 1

    lm_trans_emitted_import_prelude_paths: lm_trans_ptr_stack_new(lm_own_delete_plain)
    prelude_file: c.tmpfile()
    if: status = 0 && (lm_trans_emitted_import_prelude_paths = 0 || prelude_file = 0 || lm_trans_emit_l2_import_root_prelude(prelude_file, root, 1, namespace_) != 0 || lm_test_l2_predef_metadata_is_exact() = 0)
        status: 1
    if: status = 0
        typedef_position: c.ftell(prelude_file)
        if: typedef_position < 0L || lm_trans_emit_l4_function_pointer_type_name(prelude_file, namespace_, "LmTestPredefEquals", "functionPointerType") != 0 || c.ftell(prelude_file) != typedef_position
            status: 1
    ---
    if: status = 0 && lm_test_l2_predef_metadata_is_exact() = 0
        status: 1
    if: status = 0 && (lm_trans_registry_assert_source_table_materialization() != 0 || lm_trans_registry_assert_view_parity() != 0)
        status: 1

    lm_trans_current_source_path: 0
    lm_trans_text_ref_destroy(@ helper_name)
    if: prelude_file != 0
        c.fclose(prelude_file)
    lm_trans_ptr_stack_delete(@ lm_trans_emitted_import_prelude_paths)
    lm_trans_namespace_delete(namespace_)
    lm_trans_import_documents_drain(lm_trans_declared_import_documents)
    lm_trans_ptr_stack_delete(@ lm_trans_declared_import_documents)
    lm_trans_ptr_stack_delete(@ lm_trans_declared_import_paths)
    if: typedef_projection_entered && lm_trans_typedef_projection_output_leave() != 0
        status: 1
    lm_p0_document_destroy(document)
    lm_trans_registry_destroy()
return: status
