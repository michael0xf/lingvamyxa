callable: AddX (int: value) int

fn: source () int
    return: 5
end: source

fn: take (int: value) int
    return: value
end: take

fn: addBase (int: base; int: value) int
    return: base + value
end: addBase

fn: callAdd (AddX: add) int
    return: add(3)
end: callAdd

fn: pick ([]: int values; int: index) int
    return: values[index]
end: pick

external:
    fn: main () int
        return: take(source) != 5 || callAdd(addBase(4)) != 7 || pick([7 8 9], 1) != 8
    end: main
end: external
