include
define
os
ifdef
forward
alias
constant
layout
fn
prototype
unit

import: "lm2/table_descriptor.lm2"

external:
    fn: main () int
        LmRegistryView: base
        LmRegistryView: local
        const: LmTableDescriptor: descriptor
        const: LmTableColumnDescriptor: column
        const: LmRegistryViewRow: row
        const: LmOwnPtrStack: source_rows
        const: @: char class_name
        int: covered
        int: status

        base: lm_registry_view_new(0)
        local: lm_registry_view_new(base)
        if: base = 0 || local = 0
            lm_registry_view_delete(local)
            lm_registry_view_delete(base)
            return: 1

        status: 0
        covered: 1
        if: lm_registry_view_source_path_has_rows(0, "invalid", @ covered) != 0 || covered != 0
            status: 1
        covered: 1
        if: lm_registry_view_source_path_has_key_slice(0, "invalid", 7U, "invalid", 7U, @ covered) != 0 || covered != 0
            status: 1
        covered: 1
        if: lm_registry_view_source_path_key_at_slice(0, "invalid", 7U, 0U, @ covered) != 0 || covered != 0
            status: 1
        if: lm_registry_view_take_local_source_table(0, 0) = 0 || lm_registry_view_append_materialized_rows(0, 0, "invalid", 7U) = 0
            status: 1
        if: lm_registry_view_class_add(0, "invalid") = 0 || lm_registry_view_class_has(0, "invalid") != 0 || lm_registry_view_class_has_slice(0, "invalid", 7U) != 0 || lm_registry_view_class_count(0) != 0U || lm_registry_view_class_at(0, 0U) != 0
            status: 1
        if: status = 0 && lm_registry_view_class_add(base, "BaseClass") != 0
            status: 1
        if: status = 0 && lm_registry_view_class_add(local, "LocalClass") != 0
            status: 1
        if: status = 0 && lm_registry_view_class_add(local, "LocalClass") != 0
            status: 1
        if: status = 0 && lm_registry_view_class_add(local, "LateSharedClass") != 0
            status: 1
        if: status = 0 && lm_registry_view_class_add(base, "LateSharedClass") != 0
            status: 1
        if: lm_registry_view_push_relation(base, "registry.view.core", "default", "baseDefault", 0, base) != 0
            status: 1
        if: status = 0 && lm_registry_view_push_relation(base, "registry.view.core", "inherited", "baseExact", 0, base) != 0
            status: 1
        if: status = 0 && lm_registry_view_push_relation(base, "registry.view.core", "shadow", "baseShadow", 0, base) != 0
            status: 1
        if: status = 0 && lm_registry_view_push_relation(local, "registry.view.core", "default", "localDefault", 0, local) != 0
            status: 1
        if: status = 0 && lm_registry_view_push_relation(local, "registry.view.core", "shadow", "localShadow", 0, local) != 0
            status: 1
        if: status = 0 && lm_registry_view_push_relation(local, "registry.view.core", "duplicate", "localFirst", 0, local) != 0
            status: 1
        if: status = 0 && lm_registry_view_push_relation(local, "registry.view.core", "duplicate", "localLast", 0, local) != 0
            status: 1
        if: status = 0 && lm_registry_view_push_relation(local, "registry.view.node", "node", 0, base, local) != 0
            status: 1
        if: status = 0 && lm_registry_view_push_relation(base, "registry.view.core", "lateBase", "lateBaseExact", 0, base) != 0
            status: 1
        if: status = 0 && lm_registry_view_push_relation(local, "class.present", "MirroredClass", "class", 0, local) != 0
            status: 1
        if: status = 0 && lm_registry_view_push_relation(local, "class.present", "default", "class", 0, local) != 0
            status: 1

        if: status = 0 && (lm_registry_view_class_has(local, "BaseClass") = 0 || lm_registry_view_class_has(local, "LocalClass") = 0 || lm_registry_view_class_has(local, "LateSharedClass") = 0 || lm_registry_view_class_has(local, "MirroredClass") = 0 || lm_registry_view_class_has_slice(local, "MirroredClass-tail", 13U) = 0 || lm_registry_view_class_has(local, "default") = 0 || lm_registry_view_class_has(local, "MissingClass") != 0)
            status: 1
        if: status = 0 && (lm_registry_view_class_has(base, "LocalClass") != 0 || lm_registry_view_class_has(base, "MirroredClass") != 0 || lm_registry_view_class_count(base) != 2U || lm_registry_view_class_count(local) != 5U)
            status: 1
        if: status = 0
            class_name: lm_registry_view_class_at(local, 0U)
            if: class_name = 0 || c.strcmp(class_name, "BaseClass") != 0
                status: 1
            ---
        if: status = 0
            class_name: lm_registry_view_class_at(local, 1U)
            if: class_name = 0 || c.strcmp(class_name, "LateSharedClass") != 0
                status: 1
            ---
        if: status = 0
            class_name: lm_registry_view_class_at(local, 2U)
            if: class_name = 0 || c.strcmp(class_name, "LocalClass") != 0
                status: 1
            ---
        if: status = 0
            class_name: lm_registry_view_class_at(local, 3U)
            if: class_name = 0 || c.strcmp(class_name, "MirroredClass") != 0
                status: 1
            ---
        if: status = 0
            class_name: lm_registry_view_class_at(local, 4U)
            if: class_name = 0 || c.strcmp(class_name, "default") != 0 || lm_registry_view_class_at(local, 5U) != 0
                status: 1
            ---

        if: status = 0
            row: lm_registry_view_lookup_exact(local, "inherited", "registry.view.core")
            if: row = 0 || row\payload = 0 || c.strcmp(row\payload, "baseExact") != 0
                status: 1
            ---
        if: status = 0
            row: lm_registry_view_lookup(local, "missing", "registry.view.core")
            if: row = 0 || row\payload = 0 || c.strcmp(row\payload, "localDefault") != 0
                status: 1
            ---
        if: status = 0
            row: lm_registry_view_lookup(local, "shadow", "registry.view.core")
            if: row = 0 || row\payload = 0 || c.strcmp(row\payload, "localShadow") != 0
                status: 1
            ---
        if: status = 0
            row: lm_registry_view_lookup(local, "duplicate", "registry.view.core")
            if: row = 0 || row\payload = 0 || c.strcmp(row\payload, "localLast") != 0
                status: 1
            ---
        if: status = 0
            row: lm_registry_view_lookup(local, "lateBase", "registry.view.core")
            if: row = 0 || row\payload = 0 || c.strcmp(row\payload, "lateBaseExact") != 0
                status: 1
            ---
        if: status = 0
            row: lm_registry_view_lookup_default(local, "registry.view.core")
            if: row = 0 || row\payload = 0 || c.strcmp(row\payload, "localDefault") != 0
                status: 1
            ---
        if: status = 0
            row: lm_registry_view_lookup_exact(local, "node", "registry.view.node")
            if: row = 0 || row\payload != 0 || row\payload_node != base
                status: 1
            ---
        if: status = 0 && lm_registry_view_lookup_text(local, "node", "registry.view.node") != 0
            status: 1

        if: status = 0 && lm_registry_view_matching_key_count(local, "registry.view.core", "duplicate") != 2U
            status: 1
        if: status = 0
            row: lm_registry_view_matching_key_at(local, "registry.view.core", "duplicate", 0U)
            if: row = 0 || row\payload = 0 || c.strcmp(row\payload, "localFirst") != 0
                status: 1
            ---

        if: status = 0 && (lm_registry_view_fact_count(local) != 11U || lm_registry_view_table_row_count(local, "registry.view.core") != 8U || lm_registry_view_table_has_rows(local, "registry.view.node") = 0)
            status: 1
        if: status = 0
            row: lm_registry_view_fact_at(local, 1U)
            if: row = 0 || row\key = 0 || c.strcmp(row\key, "inherited") != 0 || row\source != base
                status: 1
            ---
        if: status = 0
            row: lm_registry_view_table_row_at(local, "registry.view.core", 4U)
            if: row = 0 || row\key = 0 || c.strcmp(row\key, "default") != 0 || row\local_sequence != 0U
                status: 1
            ---
        if: status = 0
            row: lm_registry_view_table_row_at(local, "registry.view.core", 5U)
            if: row = 0 || row\key = 0 || c.strcmp(row\key, "shadow") != 0 || row\source != local
                status: 1
            ---

        descriptor: lm_registry_view_find_local_table_slice(local, "registry.view.core", 18U)
        if: status = 0 && (descriptor = 0 || lm_table_descriptor_column_count(descriptor) != 2U || lm_table_descriptor_row_count(descriptor) != 4U)
            status: 1
        source_rows: lm_registry_view_local_source_rows_slice(local, "registry.view.core", 18U)
        if: status = 0 && (source_rows = 0 || source_rows\count != 4U || lm_own_ptr_stack_at(source_rows, 0U) != local)
            status: 1
        if: status = 0
            column: lm_table_descriptor_column_at(descriptor, 0U)
            row: lm_table_descriptor_row_at(descriptor, 3U)
            if: column = 0 || column\name = 0 || c.strcmp(column\name, "class") != 0 || row = 0 || row\key = 0 || c.strcmp(row\key, "duplicate") != 0
                status: 1
            ---

        lm_registry_view_delete(local)
        lm_registry_view_delete(base)
    return: status
end: external
