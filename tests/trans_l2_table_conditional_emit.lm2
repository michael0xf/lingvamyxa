L2:
    table:
        source
        name: `define.value`
        columns: (class: class) (@: char value)
        rows:
                 LM_TEST_L2_TABLE_CONDITIONAL_EMIT  1
    end: `define.value`

    define

    ifdef:
        `LM_TEST_L2_TABLE_CONDITIONAL_EMIT`:
            table:
                name: conditionalEmitActive
                columns: (int: id) (const: (@: char label))
                rows:
                         17  "active"
            end: conditionalEmitActive

            fn: lm_test_l2_table_conditional_value () int
                if: conditionalEmitActive\id != 17
                    return: 1
                return: conditionalEmitActive\label[0] != 'a'
            end: lm_test_l2_table_conditional_value
        default:
            table:
                name: conditionalEmitDefault
                columns: (int: id) (const: (@: char label))
                rows:
                         23  "default"
            end: conditionalEmitDefault

            fn: lm_test_l2_table_conditional_value () int
                if: conditionalEmitDefault\id != 23
                    return: 1
                return: conditionalEmitDefault\label[0] != 'd'
            end: lm_test_l2_table_conditional_value
    end: ifdef

    external:
        fn: main () int
            return: lm_test_l2_table_conditional_value()
        end: main
    end: external
end: L2
