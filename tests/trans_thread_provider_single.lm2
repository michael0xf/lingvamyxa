fn: lm_test_single_host_entry (@: void argument) @: void
    LmTestHostContext: context
    @: void ignored_result

    context: argument
    if: context != 0
        context\counter: context\counter + 1
        lm_host_thread_delete(context\thread)
        context\nested_join_status: lm_host_thread_join(context\thread, @ ignored_result)
    return: argument
end: lm_test_single_host_entry

external:
    fn: main () int
        LmHostThread: thread 0
        LmMutex: mutex 0
        LmCondition: condition 0
        LmTestHostContext: context 0
        @: void result 0
        int: status 0
        int: is_single 0

        is_single: c.strcmp(lm_thread_provider_name(), "single") = 0
        if: is_single = 0 && c.strcmp(lm_thread_provider_name(), "pthread") != 0 && c.strcmp(lm_thread_provider_name(), "win32") != 0
            return: 1

        thread: lm_host_thread_new()
        mutex: lm_mutex_new()
        condition: lm_condition_new()
        context: lm_own_new_zero(c.sizeof(context[0]))
        if: thread = 0 || mutex = 0 || condition = 0 || context = 0
            status: 2

        if: status = 0
            context\thread: thread
            context\counter: 41

        if: status = 0 && lm_mutex_lock(mutex) != 0
            status: 3
        if: status = 0 && is_single && lm_condition_wait(condition, mutex) = 0
            status: 4
        if: status = 0 && lm_condition_signal(condition) != 0
            status: 5
        if: status = 0 && lm_condition_broadcast(condition) != 0
            status: 6
        if: status = 0 && lm_mutex_unlock(mutex) != 0
            status: 7

        if: status = 0 && lm_host_thread_start(thread, @ lm_test_single_host_entry, context) != 0
            status: 8
        if: status = 0 && lm_host_thread_start(thread, @ lm_test_single_host_entry, context) = 0
            status: 10
        if: status = 0 && lm_host_thread_join(thread, @ result) != 0
            status: 11
        if: status = 0 && result != context
            status: 12
        if: status = 0 && (context\counter != 42 || context\nested_join_status != 1)
            status: 9
        if: status = 0 && lm_host_thread_join(thread, @ result) = 0
            status: 13

        lm_condition_delete(condition)
        lm_mutex_delete(mutex)
        lm_host_thread_delete(thread)
        lm_own_delete(context, 0)
        return: status
    end: main
end: external
