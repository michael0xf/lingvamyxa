thread: lm_test_exit_target (IncomingMessage: message)
    route: "/exit-target"
    if: message\lmx = 0 || message\length != 2U
        stop: 11
        return:
    ---
    exit:
    int: continued 1
    assert: continued = 1
end: lm_test_exit_target

external:
    fn: main () int
        send: "/exit-target" "{}" 2U
    end: main
end: external
