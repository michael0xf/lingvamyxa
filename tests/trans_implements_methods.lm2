User:
    int: equals
    int: extra
end: User

Plain:
    int: toString
end: Plain

Equatable:
    int: equals
end: Equatable

Serializable:
    int: serialize
end: Serializable

MultiCandidate:
    int: first
    int: second
    int: extra
end: MultiCandidate

CompleteRequirement:
    int: first
    int: second
end: CompleteRequirement

IncompleteRequirement:
    int: first
    int: missing
end: IncompleteRequirement

`QuotedCandidate`:
    int: quotedField
end: `QuotedCandidate`

`QuotedRequirement`:
    int: quotedField
end: `QuotedRequirement`

SelfDescribing:
    int: inspect
end: SelfDescribing

external:
    fn: main () int
        assert: implements(User, Equatable) = 1
        assert: implements(Plain, Equatable) = 0
        assert: implements(User, Serializable) = 0
        assert: implements(MultiCandidate, CompleteRequirement) = 1
        assert: implements(MultiCandidate, IncompleteRequirement) = 0
        assert: implements(`QuotedCandidate`, `QuotedRequirement`) = 1
        assert: implements(SelfDescribing, SelfDescribing) = 1
        return: 0
    end: main
end: external
