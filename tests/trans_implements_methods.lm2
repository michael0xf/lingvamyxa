external:
    fn: main () int
        assert: implements(User, Equatable) = 1
        assert: implements(User, Serializable) = 1
        assert: implements(User, FlatCallable) = 1
        assert: implements(User, Hashable) = 1
        assert: implements(Plain, Equatable) = 0
        assert: implements(Plain, Stringable) = 1
        assert: implements(Plain, Hashable) = 1
        assert: implements(Plain, LegacyCallable) = 1
        assert: implements(Plain, Serializable) = 0
        assert: implements(`QuotedUser`, Equatable) = 1
        assert: implements(User, WideProtocol) = 1
        assert: implements(User, `WideProtocol`) = 1
        assert: implements(NoWideJoin, WideProtocol) = 0
        assert: implements(WideJoinedOnly, WideProtocol) = 0
        assert: implements(User, NoneOnlyProtocol) = 0
        assert: implements(User, NoneFallbackProtocol) = 1
        assert: implements(Plain, NoneFallbackProtocol) = 0
        assert: implements(User, LegacyMultiProtocol) = 1
        assert: implements(NoWideJoin, LegacyMultiProtocol) = 0
        assert: implements(LegacyAOnly, LegacyMultiProtocol) = 0
        assert: implements(LegacyBOnly, LegacyMultiProtocol) = 0
        assert: implements(User, PriorityProtocol) = 1
        assert: implements(LegacyPriorityOnly, PriorityProtocol) = 0
        assert: implements(User, PhysicalProtocol) = 1
        assert: implements(User, MixedProtocol) = 1
        assert: implements(MixedACOnly, MixedProtocol) = 0
        assert: implements(User, User) = 1
        assert: implements(User, Missing) = 0
        return: 0
    end: main
end: external
