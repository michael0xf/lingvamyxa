L2:
    table:
        source
        name: `define.value`
        columns((class: class) (@: char value))
        rows:
                 LM_TEST_TYPEDEF_PROJECTION_BRANCH  1
    end: `define.value`

    define

    table:
        name: functionPointerType
        columns((class: class) (int: value))
        rows:
                 LmTypedefProjectionAlternativeBranch  1
    end: functionPointerType

    ifdef:
        LM_TEST_TYPEDEF_PROJECTION_BRANCH:
            fn: LmTypedefProjectionAlternativeBranch (int: value) int
        default:
            fn: LmTypedefProjectionAlternativeBranch (double: value) double
    end: ifdef

    external:
        fn: main () int
            LmTypedefProjectionAlternativeBranch: value 0
            return: value != 0
        end: main
    end: external
end: L2
