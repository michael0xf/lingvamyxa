include: "<stddef.h>" "trans_layout_backend_source_rows.support.h"
layout

fn: lm_test_layout_backend_source_rows () int
    c.struct: c.LmLayoutBackendWideDirect direct
    c.struct: c.LmLayoutBackendWideDuplicate duplicate
    c.struct: c.LmLayoutBackendWideLateNone late_none
    c.union: c.LmLayoutBackendWideOverlay overlay
    c.struct: c.LmLayoutBackendWidePhysical physical
    c.struct: c.LmLayoutBackendWideJoined joined
    c.struct: c.LmLayoutBackendWideSchemaFallback schema_fallback
    c.struct: c.LmLayoutBackendWideReordered reordered
    LmLayoutBackendWideOtherOnly: other_only 20
    LmLayoutBackendWideNone: none 21

    c.direct.value: 11
    c.duplicate.first: 12
    c.duplicate.second: 13
    c.late_none.value: 14
    c.overlay.right: 15
    c.physical.value: 16
    c.joined.value: 17
    c.schema_fallback.value: 18
    c.reordered.value: 19
    if: c.direct.value != 11 || c.duplicate.first != 12 || c.duplicate.second != 13 || c.late_none.value != 14 || c.overlay.right != 15 || c.physical.value != 16 || c.joined.value != 17 || c.schema_fallback.value != 18 || c.reordered.value != 19 || other_only != 20 || none != 21
        return: 1
    if: c.offsetof(c.LmLayoutBackendWideDuplicate, c.second) <= c.offsetof(c.LmLayoutBackendWideDuplicate, c.first)
        return: 2
    if: c.offsetof(c.LmLayoutBackendWideOverlay, c.left) != 0U || c.offsetof(c.LmLayoutBackendWideOverlay, c.right) != 0U
        return: 3
    return: 0
end: lm_test_layout_backend_source_rows

external:
    fn: main () int
        return: lm_test_layout_backend_source_rows()
    end: main
end: external
