layout

L1:
===
#include <stddef.h>

typedef int LmLayoutBackendWideOtherOnly;
typedef int LmLayoutBackendWideNone;

static int lm_test_layout_backend_source_rows(void) {
    LmLayoutBackendWideDirect direct = { 11 };
    LmLayoutBackendWideDuplicate duplicate = { 12, 13 };
    LmLayoutBackendWideLateNone late_none = { 14 };
    LmLayoutBackendWideOverlay overlay = { 0 };
    LmLayoutBackendWidePhysical physical = { 16 };
    LmLayoutBackendWideJoined joined = { 17 };
    LmLayoutBackendWideSchemaFallback schema_fallback = { 18 };
    LmLayoutBackendWideReordered reordered = { 19 };
    LmLayoutBackendWideOtherOnly other_only = 20;
    LmLayoutBackendWideNone none = 21;

    overlay.right = 15;
    if (direct.value != 11 || duplicate.first != 12 || duplicate.second != 13 ||
        late_none.value != 14 || overlay.right != 15 || physical.value != 16 ||
        joined.value != 17 || schema_fallback.value != 18 || reordered.value != 19 ||
        other_only != 20 || none != 21) {
        return 1;
    }
    if (offsetof(LmLayoutBackendWideDuplicate, second) <=
        offsetof(LmLayoutBackendWideDuplicate, first)) {
        return 2;
    }
    if (offsetof(LmLayoutBackendWideOverlay, left) != 0U ||
        offsetof(LmLayoutBackendWideOverlay, right) != 0U) {
        return 3;
    }
    return 0;
}
===

external:
    fn: main () int
        return: c.lm_test_layout_backend_source_rows()
    end: main
end: external
