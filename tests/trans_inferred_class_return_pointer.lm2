static unsigned lm_test_direct_new_zero_calls;
static const void *lm_test_return_source;

void *lm_test_tracked_new_zero(size_t size) {
    ++lm_test_direct_new_zero_calls;
    return calloc(1U, size);
}

#define lm_own_new_zero(size) lm_test_tracked_new_zero(size)

static void lm_test_reset_direct_allocations(void) {
    lm_test_direct_new_zero_calls = 0U;
}

static unsigned lm_test_direct_allocations(void) {
    return lm_test_direct_new_zero_calls;
}

static void lm_test_remember_return_source(const void *source) {
    lm_test_return_source = source;
}

static int lm_test_is_return_source(const void *value) {
    return value == lm_test_return_source;
}
