L1:
    external:
        fn: main () int
            int: value 4
            @: int p
            @@: int pp
            p: @ value
            pp: @ p
            if: \p + 1 != 5
                return: 1
            if: \\pp != 4
                return: 2
            return: 0
        end: main
    end: external
end: L1
