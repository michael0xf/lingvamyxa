external:
    fn: main () int
        int: x, 5; y, 10
        if: x = 5
            int: a, 1; b, 2
            if: a + b != 3
                return: 1
        end: if
        int: n, 1
        while: n = 1
            int: c, 3; d, 4
            if: c + d != 7
                return: 2
            n: 0
        end: while
        if: x != 5 || y != 10
            return: 3
        return: 0
    end: main
end: external
