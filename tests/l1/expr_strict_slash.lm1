include: "l1src/p0.lm1.h" "<stdlib.h>"

fn: add_sz (size_t: a; size_t: b) size_t
    return: a + b
end: add_sz

external:
    fn: main () int
        @: LmP0Text p
        @@: LmP0Text pp
        size_t: value 3U
        @: size_t pv
        p: c.malloc(c.sizeof(c.LmP0Text))
        if: p = 0
            return: 1
        pp: @ p
        pv: @ value
        p\length: 2U
        \pp\length: 4U
        if: add_sz(p\length, \pv) != 7U
            c.free(p)
            return: 2
        if: p\length != 4U
            c.free(p)
            return: 3
        c.free(p)
        return: 0
    end: main
end: external
