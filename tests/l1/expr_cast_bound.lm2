L1:
    include: "l1src/p0.h"

    fn: id (int: x) int
        return: x
    end: id

    external:
        fn: main () int
            if: id(2 * (cast: (uchar) 128 + 128)) != 512
                return: 1
            if: id(2 * cast: (uchar) 128 + 128) != 512
                return: 2
            return: 0
        end: main
    end: external
end: L1
