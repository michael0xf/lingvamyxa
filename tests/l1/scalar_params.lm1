fn: take_d (double: x) double
fn: take_f (float: x) float
fn: take_u (ulong: n) ulong
fn: take_d (double: x) double
    return: x
end: take_d
fn: take_f (float: x) float
    return: x
end: take_f
fn: take_u (ulong: n) ulong
    return: n
end: take_u
external:
    fn: main () int
        if: take_d(1.5) != 1.5
            return: 1
        if: take_f(2.25) != 2.25
            return: 2
        if: take_u(42) != 42
            return: 3
        return: 0
    end: main
end: external
