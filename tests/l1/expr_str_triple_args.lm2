L1:
    fn: eqbytes (const: @(char a); const: @(char b)) int
        int: i 0
        if: a = 0 || b = 0
            return: 0
        while: 1
            if: a[i] != b[i]
                return: 0
            if: a[i] = 0
                return: 1
            i: i + 1
        return: 0
    end: eqbytes

    fn: pair (const: @(char a); const: @(char b)) int
        const: @(char want_a) "a\n) # not syntax\n\"\"\"\" stays data\nb"
        const: @(char want_b) "c"
        if: eqbytes(a, want_a) = 0
            return: 1
        if: eqbytes(b, want_b) = 0
            return: 2
        return: 0
    end: pair

    external:
        fn: main () int
            return: pair("""a
) # not syntax
"""" stays data
b""", '''c''')
        end: main
    end: external
end: L1
