import: "tests/l1/str_fence_lib.lm1"

fn: slen (const: @(char s)) int
    int: n 0
    if: s = 0
        return: -1
    while: s[n] != 0
        n: n + 1
    return: n
end: slen

fn: eqbytes (const: @(char a); const: @(char b)) int
    int: i 0
    if: a = 0 || b = 0
        return: 0
    while: 1
        if: a[i] != b[i]
            return: 0
        if: a[i] = 0
            return: 1
        i: i + 1
    return: 0
end: eqbytes

