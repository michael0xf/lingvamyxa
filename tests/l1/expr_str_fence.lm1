===
        const: @(char want_d) "alpha\n    beta"
        const: @(char want_e) "alpha\n=== literal content\nbeta"
        const: @(char want_imp) "from-import"
        if: eqbytes(d, want_d) = 0
            return: 1
        if: eqbytes(e, want_e) = 0
            return: 2
        if: eqbytes(imported_fence(), want_imp) = 0
            return: 3
        if: slen(f) != 9 || f[0] != 34 || f[1] != 34 || f[2] != 34 || f[3] != 97 || f[4] != 98 || f[5] != 99 || f[6] != 34 || f[7] != 34 || f[8] != 34 || f[9] != 0
            return: 6
        if: slen(eq) != 1 || eq[0] != 61 || eq[1] != 0
            return: 7
        if: slen(sl) != 1 || sl[0] != 92 || sl[1] != 0
            return: 8
        if: slen(br) != 1 || br[0] != 91 || br[1] != 0
            return: 9
        if: slen(inc) != 2 || inc[0] != 43 || inc[1] != 43 || inc[2] != 0
            return: 10
        if: slen(tb) != 2 || tb[0] != 9 || tb[1] != 48 || tb[2] != 0
            return: 11
        return: 0
    end: main
end: external
