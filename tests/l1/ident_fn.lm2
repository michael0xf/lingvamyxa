L1:
    fn: `add1` (int: `n`) int
    fn: add1 (int: n) int
        return: n + 1
    end: add1
    external:
        fn: main () int
            if: add1(6) != 7
                return: 1
            if: `add1`(6) != 7
                return: 2
            return: 0
        end: main
    end: external
end: L1
