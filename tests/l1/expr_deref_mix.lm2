L1:
    int: hits 0
    @: int gp 0

    fn: getp () @: int
        hits: hits + 1
        return: gp
    end: getp

    fn: add (int: a; int: b) int
        return: a + b
    end: add

    external:
        fn: main () int
            int: value 4
            @: int p
            p: @ value
            gp: @ value
            if: add(\getp(), 1) != 5
                return: 1
            if: hits != 1
                return: 2
            if: ! \p
                return: 3
            if: 4 != \p
                return: 4
            if: add(\ @ value, 1) != 5
                return: 5
            if: add(\ @ \ p, 1) != 5
                return: 6
            if: add(\ @ \ p + 1, 1) != 6
                return: 7
            return: 0
        end: main
    end: external
end: L1
