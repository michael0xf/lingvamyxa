external:
    fn: main () int
        int: `x`, 5; `y`, 10
        @: int `p` 0; `q` 0
        []: int `xs`, 2 1 2
        p: @ x
        q: p
        if: x != 5 || y != 10
            return: 1
        if: xs[0] != 1 || xs[1] != 2
            return: 2
        if: p[0] != 5
            return: 3
        if: q[0] != 5
            return: 4
        return: 0
    end: main
end: external
