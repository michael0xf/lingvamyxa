external:
    fn: main () int
        []: int arr 3 1 2 3; char letters 2 65 66; other 2 7 8
        if: arr[0] != 1 || arr[2] != 3
            return: 1
        if: letters[0] != 65 || letters[1] != 66
            return: 2
        if: other[0] != 7 || other[1] != 8
            return: 3
        return: 0
    end: main
end: external
