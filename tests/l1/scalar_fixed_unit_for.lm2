L1:
    include: "<stdint.h>"
    u64: g 4
    external:
        fn: main () int
            u32: sum 0
            for: u32(i, 1) (i <= 3) i++
                sum: sum + i
            if: g != 4
                return: 1
            if: sum != 6
                return: 2
            return: 0
        end: main
    end: external
end: L1
