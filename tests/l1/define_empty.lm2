L1:
    define: PRESENT
    ifdef:
        `defined(PRESENT)`:
            fn: v () int
                return: 1
            end: v
        default:
            fn: v () int
                return: 0
            end: v
    end: ifdef
    external:
        fn: main () int
            return: v()
        end: main
    end: external
end: L1
