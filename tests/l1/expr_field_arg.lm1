include: "l1src/p0.h" "<stdlib.h>"

fn: add_sz (size_t: a; size_t: b) size_t
    return: a + b
end: add_sz

external:
    fn: main () int
        @: LmP0Text p
        p: c.malloc(c.sizeof(c.LmP0Text))
        if: p = 0
            return: 1
        p\data: "ab"
        p\length: 2U
        if: add_sz(p\length, p\length) != 4U
            c.free(p)
            return: 2
        c.free(p)
        return: 0
    end: main
end: external
