L1:
    include: "<stdint.h>"
    fn: take_i8 (i8: x) i8
        return: x
    end: take_i8
    fn: take_i32 (i32: x) i32
        return: x
    end: take_i32
    external:
        fn: main () int
            i8: n -1
            const: i16: k -2
            i32: m -3
            @: i8 p
            []: i64 xs 2 4 8
            p: @ n
            xs[1]: -9
            if: take_i8(-5) != -5
                return: 1
            if: take_i32(-7) != -7
                return: 2
            if: n != -1 || k != -2 || m != -3
                return: 3
            if: p[0] != -1
                return: 4
            if: xs[0] != 4
                return: 5
            if: xs[1] >= 0
                return: 7
            if: (cast: (i8) -8) != -8
                return: 6
            return: 0
        end: main
    end: external
end: L1
