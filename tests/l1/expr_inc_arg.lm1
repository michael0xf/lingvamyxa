fn: take (int: value) int
    return: value
end: take

external:
    fn: main () int
        int: i 3
        int: a 2
        int: b 3
        int: r 0
        if: take(i--) != 3 || i != 2
            return: 1
        i: 3
        if: take(--i) != 2 || i != 2
            return: 2
        i: 3
        if: take(++i) != 4 || i != 4
            return: 3
        i: 3
        if: take(i++) != 3 || i != 4
            return: 4
        i: 3
        if: take(1 + --i) != 3 || i != 2
            return: 5
        r: a + ++b
        if: r != 6 || a != 2 || b != 4
            return: 6
        i: 3
        if: take(- --i) != -2 || i != 2
            return: 7
        i: 3
        if: take(+ ++i) != 4 || i != 4
            return: 8
        return: 0
    end: main
end: external
