fn: nested (int: value; int: mix) int
    return: value + mix
end: nested

fn: sum4 (int: a; int: b; int: c; int: d) int
    return: a + b + c + d
end: sum4

external:
    fn: main () int
        c.array: []: int arr 4
        int: a 2
        int: b 3
        int: c 5
        int: i 1
        int: index 1
        int: x 6
        int: y 3
        int: result 0
        arr[0]: 1
        arr[1]: 2
        arr[2]: 3
        arr[3]: 4
        result: sum4(a + b, c--, nested(++i, x | y), arr[index + 1])
        if: result != 22
            return: 1
        if: c != 4 || i != 2
            return: 2
        result: sum4((a + b) * 2, c + 1, nested(i--, x & y), arr[index])
        if: result != 21
            return: 3
        if: i != 1
            return: 4
        return: 0
    end: main
end: external
