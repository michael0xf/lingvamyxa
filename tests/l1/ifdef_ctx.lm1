ifdef:
    FLAG:
        include: "<stdio.h>"
        fn: v () int
            return: 1
        end: v
    default:
        fn: v () int
            return: 0
        end: v
end: ifdef

external:
    fn: main () int
        ifdef:
            FLAG:
                return: 4
            default:
                return: 5
        end: ifdef
    end: main
end: external
