L2:
    table:
        name: sampleTable
        columns: (int: id) (const: (@: char label))
        rows:
                 7  "seven"
                 9  "nine"
    end: sampleTable

    external:
        fn: main () int
            if: sampleTable = 0 || sampleTable\ptr = 0 || sampleTable\length != 2U || sampleTable[0] = 0 || sampleTable[1] = 0
                return: 1
            if: sampleTable[0]\id != 7 || sampleTable[0]\label[0] != 's'
                return: 2
            if: sampleTable[1]\id != 9 || sampleTable[1]\label[0] != 'n'
                return: 3
            return: 0
        end: main
    end: external
end: L2
