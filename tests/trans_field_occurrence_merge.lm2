L2:
    OccurrenceBase:
        int: value
        int: other
    end: OccurrenceBase

    merge: (OccurrenceBase) OccurrenceMerged
        int: value
    end: OccurrenceMerged

    external:
        fn: main () int
            OccurrenceBase: base
                value: 3
                other: 7
            end: base
            OccurrenceMerged: merged
                value: 0
                value: 4
            end: merged

            if: base\value != 3 || base\other != 7
                return: 3
            if: merged\[0]value != 0
                return: 1
            if: merged\[1]value != 4 || merged\value != 4
                return: 2
            merged\[0]value: 5
            return: merged\[0]value != 5 || merged\[1]value != 4
        end: main
    end: external
end: L2
