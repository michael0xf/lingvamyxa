    lm_trans_text_ref_destroy(@ payload)
return: status

fn: lm_test_root_first_node (const: (LmP0Document: document)) const: LmP0Node
    const: LmP0Node: root
    const: LmP0Field: field

    root: lm_p0_document_root(document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
    field: lm_trans_l2_structure_first_present_field(root\as\structure)
    if: field = 0
        return: 0
return: field\value

fn: lm_test_file_equals (FILE: file; const: @(char expected)) int
    @: char buffer
    size_t: expected_length
    long: length
    int: result

    if: file = 0 || expected = 0 || c.fflush(file) != 0 || c.fseek(file, 0L, c.SEEK_END) != 0
        return: 0
    length: c.ftell(file)
    expected_length: c.strlen(expected)
    if: length < 0L || c.fseek(file, 0L, c.SEEK_SET) != 0
        return: 0
    buffer: lm_own_new_zero((cast: size_t length) + 1U)
    if: buffer = 0
        return: 0
    if: length != 0L && c.fread(buffer, 1U, (cast: size_t length), file) != (cast: size_t length)
        lm_own_delete(buffer, 0)
        return: 0
    result: (cast: size_t length) = expected_length && c.memcmp(buffer, expected, expected_length) = 0
    if: result = 0
        c.fprintf(c.stderr, "unexpected structural projection output:\n%s\n", buffer)
    lm_own_delete(buffer, 0)
return: result

