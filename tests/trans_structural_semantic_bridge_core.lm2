    column_names: (cast: (@: LmP0Text) lm_own_new_zero(c.sizeof(column_names[0])))
    output: c.tmpfile()
    if: status = 0 && (type_node = 0 || type_node\kind != c.LM_P0_NODE_ATOM || field_node = 0 || field_node\kind != c.LM_P0_NODE_FRAME || abi_params = 0 || capture = 0 || declarator = 0 || column_types = 0 || column_names = 0 || output = 0)
        status: 1
    if: status = 0
        column_types[0]: lm_trans_expr_callable_type_new()
        column_names[0]: lm_trans_text_from_cstr("child")
        if: column_types[0] = 0 || column_names[0] = 0 || lm_trans_text_assign_cstr(column_types[0]\class_name, "ManualStructural") = 0 || lm_trans_text_assign_cstr(declarator\type_head, "ManualStructural") = 0 || lm_trans_text_assign_cstr(declarator\name, "declared") = 0
            status: 1
        ---
    if: status = 0
        expected_type\address_depth: 2U
        abi_params[0]\class_name: "ManualStructural"
        abi_params[0]\name: "abi_structural"
        abi_params[1]\class_name: "ExplicitAbiLayout"
        abi_params[1]\name: "abi_explicit"
        abi_params[1]\address_depth: 1U
        abi_params[2]\class_name: "c.ProjectionAbiLayout"
        abi_params[2]\name: "abi_projection"
        declarator\type_is_head: 1
        declarator\pointer_depth: 1U
        if: lm_trans_emit_type_node(output, type_node, namespace_) != 0 || lm_trans_put(output, "|") != 0 || lm_trans_emit_type_head_only(output, structural_name, namespace_) != 0 || lm_trans_put(output, "|") != 0 || lm_trans_emit_callable_type_named(output, expected_type, callable_name, namespace_) != 0 || lm_trans_put(output, "|") != 0 || lm_trans_emit_abi_params(output, abi_params, 3U, namespace_) != 0 || lm_trans_put(output, "|") != 0 || lm_trans_emit_c_declarator(output, declarator, namespace_, "structural projection test") != 0 || lm_trans_put(output, "|") != 0 || lm_trans_emit_capture_field(output, capture, 0U, 0U, namespace_) != 0 || lm_trans_put(output, "|") != 0 || lm_trans_emit_array_pointer_type(output, type_node, 2U, namespace_) != 0 || lm_trans_put(output, "|") != 0 || lm_trans_emit_struct_field(output, field_node, 0U, namespace_) != 0 || lm_trans_put(output, "|") != 0
            status: 1
        ---
    if: status = 0
        expected_type\address_depth: 0U
        if: lm_trans_emit_l2_table_row_type(output, "ManualRow", column_types, column_names, 1U, 0U, namespace_) != 0 || lm_trans_put(output, "|") != 0 || lm_trans_emit_named_structure_typedef(output, top_level_item\frame, 0U, namespace_) != 0 || lm_trans_put(output, "|") != 0 || lm_trans_emit_function_return_structure(output, function_name, lm_p0_document_root(field_document), namespace_) != 0 || lm_test_file_equals(output, projection_output) = 0
            status: 1
        ---

    lm_own_delete(merge_name, 0)
    if: output != 0
        c.fclose(output)
    lm_trans_l2_table_columns_destroy(column_types, column_names, 1U)
    lm_trans_statement_c_declarator_destroy(declarator)
    lm_trans_capture_destroy(capture)
    lm_trans_expr_abi_params_delete(abi_params, 3U)
    lm_trans_top_level_item_delete(top_level_item)
    lm_trans_top_level_item_delete(function_item)
    if: field_document != 0
        lm_p0_document_destroy(field_document)
    if: type_document != 0
        lm_p0_document_destroy(type_document)
    if: top_level_document != 0
        lm_p0_document_destroy(top_level_document)
    if: call_document != 0
        lm_p0_document_destroy(call_document)
    if: function_document != 0
        lm_p0_document_destroy(function_document)
    if: document != 0
        lm_p0_document_destroy(document)
    lm_trans_expr_callable_type_delete(expected_type)
    lm_own_delete(layout_field, 0)
    lm_trans_descriptor_delete(projection_descriptor)
    lm_trans_descriptor_delete(explicit_descriptor)
    lm_trans_text_ref_destroy(@ function_name)
    lm_trans_text_ref_destroy(@ capture_name)
    lm_trans_text_ref_destroy(@ callable_name)
    lm_trans_text_ref_destroy(@ unsupported_name)
    lm_trans_text_ref_destroy(@ explicit_name)
    lm_trans_text_ref_destroy(@ projection_name)
    lm_trans_text_ref_destroy(@ builtin_name)
    lm_trans_text_ref_destroy(@ conflict_name)
    lm_trans_text_ref_destroy(@ scope_name)
    lm_trans_text_ref_destroy(@ structural_name)
    lm_trans_text_ref_destroy(@ bridge_name)
    lm_trans_namespace_delete(namespace_)
    lm_trans_registry_destroy()
return: status
