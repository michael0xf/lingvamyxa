fn: lm_test_attach_empty_structural_descriptor (
    LmTransNamespace: namespace_
    const: @(char name)
) int
    LmP0Text: name_text
    LmTransDescriptor: descriptor
    int: status

    name_text: lm_trans_text_from_cstr(name)
    descriptor: lm_trans_descriptor_new()
    status: name_text = 0 || descriptor = 0
    if: status = 0
        status: lm_trans_namespace_declare(namespace_, name_text, "variable") != 0 || lm_trans_descriptor_mark_structural_fields(descriptor) != 0 || lm_trans_namespace_attach_descriptor(namespace_, name_text, descriptor) != 0
    if: status = 0
        descriptor: 0
    lm_trans_descriptor_delete(descriptor)
    lm_trans_text_ref_destroy(@ name_text)
return: status != 0

fn: lm_test_structural_owner_fact_count (
    const: @(char owner_name)
    const: @(char table_name)
) size_t
    const: LmRegistryViewRow: view_row
    const: LmTransRegistryFact: fact
    size_t: i
    size_t: count

    if: owner_name = 0 || table_name = 0 || lm_trans_registry = 0 || lm_trans_registry\view = 0
        return: 0U

    count: 0U
    i: 0U
    while: i < lm_registry_view_fact_count(lm_trans_registry\view)
        view_row: lm_registry_view_fact_at(lm_trans_registry\view, i)
        fact: 0
        if: view_row != 0
            fact: cast: (const: LmTransRegistryFact) view_row\source
        if: fact != 0 && fact\table != 0 && fact\key != 0 && c.strcmp(fact\table, table_name) = 0 && c.strcmp(fact\key, owner_name) = 0
            count: count + 1U
        i: i + 1U
return: count

fn: lm_test_structural_owner_source_row_count (
