L2:
    import: "fixtures/implements_namespace_descriptors.lm2"

    LocalCandidate:
        int: localField
        int: extra
    end: LocalCandidate

    LocalRequirement:
        int: localField
    end: LocalRequirement

    external:
        fn: main () int
            assert: implements(ImportedCandidate, ImportedRequirement) = 1
            assert: implements(LocalCandidate, LocalRequirement) = 1
            assert: implements(LocalCandidate, ImportedRequirement) = 0
            return: 0
        end: main
    end: external
end: L2
