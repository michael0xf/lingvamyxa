L2:
    fn: accept (@: int value) int
        return: value[0] != 7
    end: accept

    fn: test () int
        int: value 7
        @: int pointer (@ value)
        table:
            name: t
            columns: (@@: int pointers)
            rows:
                     (@ pointer)
        end: t
        return: accept(\ t[0]\pointers)
    end: test

    external:
        fn: main () int
            return: test()
        end: main
    end: external
end: L2
