{
  "version": 6,
  "configurePresets": [
    {
      "name": "lmx-debug",
      "displayName": "LMX Debug (MinGW)",
      "description": "Lightweight parser/debug configuration without Qt app or external runtime dependencies.",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/lmx-debug-config",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/mingw1310_64/bin/mingw32-make.exe",
        "BUILD_PRINT_TREE_LM0": "ON",
        "BUILD_TRANS_LM0": "ON",
        "BUILD_MAKE_LM0": "ON",
        "BUILD_BUILD_CORE_LM0": "ON",
        "BUILD_LINGVAMYXA_QT_APP": "OFF",
        "LINGVAMYXA_ENABLE_EXTERNAL_DEPS": "OFF"
      }
    },
    {
      "name": "lmx-debug-buildcore-full",
      "displayName": "LMX Debug + buildCore --full",
      "description": "Lightweight Qt/MinGW configure that passes --full to buildCore when runBuildCore.lm0 is built.",
      "inherits": "lmx-debug",
      "binaryDir": "${sourceDir}/lmx-debug-full-config",
      "cacheVariables": {
        "LINGVAMYXA_BUILDCORE_ARGS": "--full"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "lmx-debug",
      "displayName": "Build LMX Debug",
      "configurePreset": "lmx-debug",
      "targets": [
        "printTree.lm0",
        "trans.lm0",
        "make.lm0",
        "vcpkgFetch.lm0",
        "buildCore.lm0"
      ]
    },
    {
      "name": "run-buildcore",
      "displayName": "Run buildCore Bootstrap",
      "configurePreset": "lmx-debug",
      "targets": [
        "runBuildCore.lm0"
      ]
    },
    {
      "name": "run-buildcore-full",
      "displayName": "Run buildCore Full Bootstrap",
      "configurePreset": "lmx-debug-buildcore-full",
      "targets": [
        "runBuildCore.lm0"
      ]
    }
  ]
}
