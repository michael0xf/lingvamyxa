table:
    name: include
    columns: class             (target char)
    rows:
             l4_loader_stddef  "<stddef.h>"
             l4_loader_stdio   "<stdio.h>"
             l4_loader_stdlib  "<stdlib.h>"
             l4_loader_string  "<string.h>"
end: include

table:
    name: functionPointerType
    columns: class                  (value serial)
    rows:
             LmL4PushRow            1
             LmL4PushCell           1
             LmL4NoteKey            1
             LmL4PushColumnMetadata 1
             LmL4JoinTable          1
             LmL4FrameReceiver      1
end: functionPointerType

fn: LmL4FrameReceiver (
    const: LmL4Loader: loader
    @: void context
    const: LmP0Frame: frame
) int

fn: LmL4PushRow (
    @: void context
    const: LmP0Text: table_atom
    const: LmP0Text: key_atom
    const: LmP0Node: payload_node
) int

fn: LmL4PushCell (
    @: void context
    const: LmP0Text: table_name
    const: LmL4Column: column
    int: split_by_column
    const: LmP0Text: key_atom
    const: LmP0Node: payload_node
) int

fn: LmL4NoteKey (
    @: void context
    const: LmP0Text: table_name
    const: LmL4Column: column
    const: LmP0Text: key_atom
) int

fn: LmL4PushColumnMetadata (
    @: void context
    const: LmP0Text: table_name
    @: LmL4Column columns
    size_t: column_count
) int

fn: LmL4JoinTable (
    @: void context
    const: LmP0Text: source_table
    const: LmP0Text: target_table
) int

fn: lm_l4_table_from_frame (
    const: LmL4Loader: loader
    @: void context
    const: LmP0Frame: frame
) int

fn: lm_l4_join_from_frame (
    const: LmL4Loader: loader
    @: void context
    const: LmP0Frame: frame
) int

fn: lm_l4_row_from_frame (
    const: LmL4Loader: loader
    @: void context
    const: LmP0Frame: frame
) int

fn: lm_l4_load_rows (
    const: LmL4Loader: loader
    @: void context
    const: LmP0Structure: structure
) int

fn: lm_l4_load_root (
    const: LmL4Loader: loader
    @: void context
    const: LmP0Node: root
    int: implicit_l4
) int

fn: lm_l4_receiver_table (
    const: LmL4Loader: loader
    @: void context
    const: LmP0Frame: frame
) int

fn: lm_l4_receiver_join (
    const: LmL4Loader: loader
    @: void context
    const: LmP0Frame: frame
) int

fn: lm_l4_receiver_row (
    const: LmL4Loader: loader
    @: void context
    const: LmP0Frame: frame
) int

fn: lm_l4_receiver_ignore (
    const: LmL4Loader: loader
    @: void context
    const: LmP0Frame: frame
) int

