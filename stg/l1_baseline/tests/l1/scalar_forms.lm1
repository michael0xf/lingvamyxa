external:
    fn: main () int
        const: double: d 2.25
        float: f 1.5
        @: float fp
        []: ulong xs 2 1 2
        fp: @ f
        if: d != 2.25
            return: 1
        if: fp[0] != 1.5
            return: 2
        if: xs[0] != 1 || xs[1] != 2
            return: 3
        if: (cast: (ulong) 42) != 42
            return: 4
        if: (cast: (double) 2) != 2.0
            return: 5
        return: 0
    end: main
end: external
