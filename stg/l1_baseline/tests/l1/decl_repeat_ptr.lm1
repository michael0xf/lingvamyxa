external:
    fn: main () int
        char: ch 65
        @: int px 0; py 0; char pc 0
        @@: char ppa 0; ppb 0
        @@@: char pppa 0; pppb 0
        if: px != 0 || py != 0 || pc != 0 || ppa != 0 || ppb != 0 || pppa != 0 || pppb != 0
            return: 1
        pc: @ ch
        ppa: @ pc
        pppa: @ ppa
        if: pc[0] != 65
            return: 2
        if: ppa[0][0] != 65
            return: 3
        if: pppa[0][0][0] != 65
            return: 4
        return: 0
    end: main
end: external
