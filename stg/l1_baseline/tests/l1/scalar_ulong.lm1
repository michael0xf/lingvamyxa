include: "<stdlib.h>"
external:
    fn: main () int
        @: char end_index
        ulong: value
        end_index: 0
        value: c.strtoul("42", @ end_index, 10)
        if: end_index = 0
            return: 1
        if: end_index[0] != 0
            return: 2
        if: (cast: (size_t) value) != 42
            return: 3
        return: 0
    end: main
end: external
