include: "<stdio.h>"
include: "<string.h>"
external:
    fn: main () int
        c.array: [128]: char buffer
        long: long_value 7
        size_t: size_value 9U
        double: double_value 1.5
        int: written
        written: c.snprintf(buffer, c.sizeof(buffer), "%ld %zu %s %f", long_value, size_value, "ok", double_value)
        if: written < 0
            return: 1
        if: c.strcmp(buffer, "7 9 ok 1.500000") != 0
            return: 2
        if: buffer[15] != 0
            return: 3
        return: 0
    end: main
end: external
