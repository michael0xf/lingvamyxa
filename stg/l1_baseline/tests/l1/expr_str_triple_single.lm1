fn: take (const: @(char s)) const: @(char)
    return: s
end: take

fn: eqbytes (const: @(char a); const: @(char b)) int
    int: i 0
    if: a = 0 || b = 0
        return: 0
    while: 1
        if: a[i] != b[i]
            return: 0
        if: a[i] = 0
            return: 1
        i: i + 1
    return: 0
end: eqbytes

external:
    fn: main () int
        const: @(char s) '''single # not a comment
colon: stays data
paren ( stays data
backslash is raw: \' \n
same quote run: ''''
'''
        const: @(char want_s) "single # not a comment\ncolon: stays data\nparen ( stays data\nbackslash is raw: \\' \\n\nsame quote run: '''\n"
        const: @(char r) """one " two "" four """" five """"" done"""
        const: @(char want_r) "one \" two \"\" four \"\"\" five \"\"\"\" done"
        if: eqbytes(s, want_s) = 0
            return: 1
        if: eqbytes(r, want_r) = 0
            return: 2
        if: take(r)[0] != 111
            return: 3
        return: 0
    end: main
end: external
