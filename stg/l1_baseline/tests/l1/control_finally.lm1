int: g 0

fn: boom () int
    throws: Fail
    finally:
        g: 7
    throw: Fail(1)
    return: 0
end: boom

external:
    fn: main () int
        int: n 0
        int: p 0
        finally:
            n: n + 10
        n: n + 1
        p: boom()
        catch: Fail (int: bad)
            p: bad
        return: n != 11 || g != 7 || p != 1
    end: main
end: external
