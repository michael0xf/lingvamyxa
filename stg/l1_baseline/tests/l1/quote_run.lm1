include: "<stdio.h>"
external:
    fn: main () int
        c.puts("""a""""b""")
        c.puts('''a''''b''')
        c.puts("""x"y""")
        c.puts("""x""y""")
        c.puts("""x"""""y""")
        c.puts("""x""""""y""")
        c.puts("""a'b""")
        c.puts("""a\b""")
        return: 0
    end: main
end: external
