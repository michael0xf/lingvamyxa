fn: take (int: value) int
    return: value
end: take

external:
    fn: main () int
        c.array: []: int xs 4
        int: index 1
        @: int p
        xs[0]: 10
        xs[1]: 20
        xs[2]: 30
        xs[3]: 40
        p: @ index
        if: xs[\p] != 20
            return: 1
        if: take(xs[\p]) != 20
            return: 2
        return: xs[\p] != 20
    end: main
end: external
