external:
    fn: main () int
        []: int arr 3 1 2 3; other 3 4 5 6
        []: int xs 2 (1, 2); ys 2 (4, 5)
        arr[1]: 9
        if: arr[0] != 1 || arr[1] != 9 || arr[2] != 3
            return: 1
        if: other[0] != 4 || other[1] != 5 || other[2] != 6
            return: 2
        if: xs[0] != 1 || xs[1] != 2
            return: 3
        if: ys[0] != 4 || ys[1] != 5
            return: 4
        return: 0
    end: main
end: external
