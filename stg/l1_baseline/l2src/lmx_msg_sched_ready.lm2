predef: "l2src/lmx_msg_sched_ready.h.lm1"

# Clean-L2 source for l2src/lmx_msg_sched_ready.lm1. Same ABI, same behaviour:
# pure parent-local readiness list operations over LmxMsg sched_next /
# sched_queued; the caller owns synchronization and endpoint lifetime; head
# and tail are distinct writable cells of ONE parent (model §29: each parent
# serves its direct children; no global walker).
#
# Library unit: no entry. The three ABI names are REAL symbols: the only
# runtime caller is the executor's scheduling (lmx_message_exec.c); a unit's
# open path creates its Message without scheduling anything, so nothing
# reaches the wrappers before they are published.

sub: lmx_msg_sched_ready_enqueue (@@: LmxMsg head; @@: LmxMsg tail; @: LmxMsg child)
    @: LmxMsg current_tail
    if: head = 0 || tail = 0 || child = 0
        return
    if: child\sched_queued != 0
        return
    child\sched_queued: 1
    child\sched_next: 0
    current_tail: \tail
    if: current_tail != 0
        current_tail\sched_next: child
    else:
        \head: child
    ---
    \tail: child
end: lmx_msg_sched_ready_enqueue

fn: lmx_msg_sched_ready_dequeue (@@: LmxMsg head; @@: LmxMsg tail) @: LmxMsg
    @: LmxMsg child
    if: head = 0 || tail = 0
        return: 0
    child: \head
    if: child != 0
        \head: child\sched_next
        if: \head = 0
            \tail: 0
        ---
        child\sched_next: 0
        child\sched_queued: 0
    ---
    return: child
end: lmx_msg_sched_ready_dequeue

sub: lmx_msg_sched_ready_unlink (@@: LmxMsg head; @@: LmxMsg tail; @: LmxMsg child)
    @: LmxMsg prev 0
    @: LmxMsg item
    if: head = 0 || tail = 0 || child = 0
        return
    if: child\sched_queued = 0
        return
    item: \head
    while: item != 0
        if: item = child
            if: prev = 0
                \head: child\sched_next
            else:
                prev\sched_next: child\sched_next
            ---
            if: \tail = child
                \tail: prev
            ---
            child\sched_next: 0
            child\sched_queued: 0
            return
        ---
        prev: item
        item: item\sched_next
    ---
end: lmx_msg_sched_ready_unlink
