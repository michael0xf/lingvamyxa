predef: "l2src/lmx_pool.lm1"

# The interned character array. Lingvamyxa_spec.txt 2, 21.4; ABI 14.7.
#
# 2 works the example out in full: a primitive field
#
#     char: '!'
#
# may hold data == &all_chars_array['!']. Assigning that field changes its
# REFERENCE; it does not mutate the shared immutable character cell.
#
# 14.7 settles exactly this case - "interned immutable leaves naturally share
# their primitive address" - and leaves mutable cells, large numbers, byte
# buffers and foreign handles open. This unit implements only the settled half.
#
# It uses the same pool machinery as the growable arrays but a different
# discipline, and that contrast is the point. Here all 256 cells exist from init
# and are addressed by the character value itself, so the array never grows. A
# mutable variable of the same C type would live in a growing array instead.
# What makes an entry a char is the range it sits in, not which discipline put
# it there.
#
# Immutability is enforced by construction: filled once at init, no mutator.

@: LmxPool lmx_chars_pool 0

fn: lmx_chars_init () int
    @: char cells
    size_t: index
    if: lmx_chars_pool != 0
        return: 1
    lmx_chars_pool: (cast: (@: LmxPool) c.calloc(1U, c.sizeof(c.LmxPool)))
    if: lmx_chars_pool = 0
        return: 1
    if: lmx_pool_open(lmx_chars_pool, c.sizeof(cells[0]), 256U, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) != 0
        c.free(lmx_chars_pool)
        lmx_chars_pool: 0
        return: 1
    cells: (cast: (@: char) lmx_chars_pool\head\base)
    index: 0U
    while: index < 256U
        cells[index]: (cast: (char) index)
        index: index + 1U
    ---
return: 0

sub: lmx_chars_release ()
    if: lmx_chars_pool != 0
        lmx_pool_release(lmx_chars_pool)
        c.free(lmx_chars_pool)
    ---
    lmx_chars_pool: 0
end: lmx_chars_release

# The shared cell for a character value. Two fields holding the same character
# hold the same address; that sharing is the whole content of 14.7's settled
# half. Out of range yields nothing rather than a wrong cell.
fn: lmx_char_cell (int: value) @: void
    @: char cells
    if: lmx_chars_pool = 0
        return: 0
    if: value < 0
        return: 0
    if: value > 255
        return: 0
    cells: (cast: (@: char) lmx_chars_pool\head\base)
return: (cast: (@: void) (cells + value))

# Reads the character back through its address. Refuses anything the classifier
# does not call a char, so a pointer into another typed array cannot be read as
# one.
fn: lmx_char_value (@: void cell) int
    @: char p
    if: cell = 0
        return: -1
    if: lmx_type_of(cell) != c.LMX_TYPE_CHAR
        return: -1
    p: (cast: (@: char) cell)
    # Masked rather than cast through an unsigned char type. (cast: (unsigned
    # char) x) is a real L1 defect - it splits the type and emits
    # ((unsigned)charx). (cast: (uchar) x) is not a defect: L1 passes the alias
    # through and l1src/p0.lm1.h typedefs it, which this unit does not include and
    # should not. The mask depends on neither.
return: ((cast: (int) p[0]) & 255)
