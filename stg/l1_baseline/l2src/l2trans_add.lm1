# Parse/emit one two-int add leaf + typed call from §1.7 main.

fn: l2_ident (const: @(LmP0Text t)) int
    size_t: i
    unsigned: ch
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0
    ch: (cast: (unsigned) t\data[0])
    if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U)
        return: 0
    i: 1U
    while: i < t\length
        ch: (cast: (unsigned) t\data[i])
        if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U) && (ch < 48U || ch > 57U)
            return: 0
        i: i + 1U
    if: l2_text_eq(t, "main") || l2_text_eq(t, "fn") || l2_text_eq(t, "int") || l2_text_eq(t, "return")
        return: 0
return: 1

fn: l2_text_same (const: @(LmP0Text a); const: @(LmP0Text b)) int
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    if: a\length != b\length
        return: 0
return: c.memcmp(a\data, b\data, a\length) = 0

fn: l2_end_text (const: @(LmP0Frame frame); const: @(LmP0Text name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0 || name = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_same(field\value\as\atom, name)

fn: l2_mix (unsigned: h; const: @(LmP0Text t)) unsigned
    size_t: i
    if: t = 0 || t\data = 0
        return: h
    i: 0U
    while: i < t\length
        h: h * 131U + (cast: (unsigned) t\data[i])
        i: i + 1U
    h: h * 131U + 1U
return: h

fn: l2_int_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_name[0]: 0
    if: node = 0 || node\as = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f\value = 0 || f\value\as = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_name[0]: f\value\as\atom
return: 0

fn: l2_parse_add_fn (const: @(LmP0Node fn_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node params
    const: @: LmP0Node body
    @: LmP0Field p0
    @: LmP0Field p1
    const: @: LmP0Node ret
    @: LmP0Field r0
    @: LmP0Field r1
    @: LmP0Field r2
    if: fn_node = 0 || fn_node\as = 0 || fn_node\as\frame = 0
        return: l2_error(path, fn_node, "unsupported body")
    fr: fn_node\as\frame
    if: fr\body = 0 || l2_count_active(fr\body) != 4
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_ident(field\value\as\atom) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    l2_nm: field\value\as\atom
    if: l2_end_text(fr, l2_nm) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    params: field\value
    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE || params\as = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: params\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    if: l2_count_active(params\as\structure) != 2
        return: l2_error(path, fn_node, "incompatible entry signature")
    p0: l2_next_active(params\as\structure\first_field)
    p1: l2_next_active(p0\next)
    if: l2_int_formal(p0\value, path, @ l2_fa) != 0
        return: 1
    if: l2_int_formal(p1\value, path, @ l2_fb) != 0
        return: 1
    field: l2_next_active(field\next)
    if: field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(field\value\as\atom, "int") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: field\value
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: body\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    if: l2_count_active(body\as\structure) != 1
        return: l2_error(path, fn_node, "unsupported body")
    ret: l2_next_active(body\as\structure\first_field)\value
    if: l2_frame_head(ret, "return") = 0
        return: l2_error(path, ret, "unsupported body")
    if: ret\as\frame\trailer != 0
        return: l2_error(path, ret, "unsupported trailer")
    if: ret\as\frame\body = 0 || ret\as\frame\body\trailer != 0
        return: l2_error(path, ret, "unsupported trailer")
    if: l2_count_active(ret\as\frame\body) != 3
        return: l2_error(path, ret, "unsupported body")
    r0: l2_next_active(ret\as\frame\body\first_field)
    r1: l2_next_active(r0\next)
    r2: l2_next_active(r1\next)
    if: r0\value = 0 || r1\value = 0 || r2\value = 0
        return: l2_error(path, ret, "unsupported body")
    if: r0\value\kind != c.LM_P0_NODE_ATOM || r1\value\kind != c.LM_P0_NODE_ATOM || r2\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, ret, "unsupported body")
    if: l2_text_eq(r1\value\as\atom, "+") = 0
        return: l2_error(path, ret, "unsupported body")
    if: l2_text_same(r0\value\as\atom, l2_fa) = 0
        return: l2_error(path, r0\value, "unresolved name")
    if: l2_text_same(r2\value\as\atom, l2_fb) = 0
        return: l2_error(path, r2\value, "unresolved name")
    l2_sigv: 1U
    l2_sigv: l2_mix(l2_sigv, l2_nm)
    l2_sigv: l2_mix(l2_sigv, l2_fa)
    l2_sigv: l2_mix(l2_sigv, l2_fb)
return: 0

fn: l2_parse_main_call (const: @(LmP0Node main_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node body
    const: @: LmP0Node ret
    @: LmP0Field r0
    @: LmP0Field r1
    @: LmP0Field r2
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    int: n
    if: main_node = 0 || main_node\as = 0 || main_node\as\frame = 0
        return: l2_error(path, main_node, "unsupported body")
    fr: main_node\as\frame
    if: l2_end_named(fr, "main") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    if: fr\body = 0 || l2_count_active(fr\body) != 4
        return: l2_error(path, main_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, main_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(field\value\as\atom, "main") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    if: l2_empty_struct(field\value) = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(field\value\as\atom, "int") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: field\value
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, main_node, "unsupported body")
    if: body\as\structure\trailer != 0
        return: l2_error(path, main_node, "unsupported trailer")
    if: l2_count_active(body\as\structure) != 1
        return: l2_error(path, main_node, "unsupported body")
    ret: l2_next_active(body\as\structure\first_field)\value
    if: l2_frame_head(ret, "return") = 0
        return: l2_error(path, ret, "unsupported body")
    if: ret\as\frame\trailer != 0
        return: l2_error(path, ret, "unsupported trailer")
    if: ret\as\frame\body = 0 || ret\as\frame\body\trailer != 0
        return: l2_error(path, ret, "unsupported trailer")
    n: l2_count_active(ret\as\frame\body)
    r0: l2_next_active(ret\as\frame\body\first_field)
    if: r0 = 0 || r0\value = 0 || r0\value\kind != c.LM_P0_NODE_FRAME
        return: l2_error(path, ret, "unsupported body")
    call: r0\value\as\frame
    if: l2_text_same(call\head, l2_nm) = 0
        return: l2_error(path, r0\value, "unknown method")
    if: call\trailer != 0
        return: l2_error(path, r0\value, "unsupported trailer")
    if: call\body = 0
        return: l2_error(path, r0\value, "incompatible entry signature")
    if: call\body\trailer != 0
        return: l2_error(path, r0\value, "unsupported trailer")
    if: l2_count_active(call\body) != 2
        return: l2_error(path, r0\value, "incompatible entry signature")
    a0: l2_next_active(call\body\first_field)
    a1: l2_next_active(a0\next)
    if: a0\value = 0 || a1\value = 0 || a0\value\kind != c.LM_P0_NODE_ATOM || a1\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, r0\value, "incompatible entry signature")
    if: l2_digits(a0\value\as\atom) = 0 || l2_int_fits(a0\value\as\atom) = 0
        return: l2_error(path, a0\value, "incompatible entry signature")
    if: l2_digits(a1\value\as\atom) = 0 || l2_int_fits(a1\value\as\atom) = 0
        return: l2_error(path, a1\value, "incompatible entry signature")
    l2_xa: a0\value\as\atom
    l2_xb: a1\value\as\atom
    if: n = 1
        l2_xr: 0
        l2_leaf_mode: 2
        return: 0
    if: n != 3
        return: l2_error(path, ret, "unsupported body")
    r1: l2_next_active(r0\next)
    r2: l2_next_active(r1\next)
    if: r1\value = 0 || r2\value = 0 || r1\value\kind != c.LM_P0_NODE_ATOM || r2\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, ret, "unsupported body")
    if: l2_text_eq(r1\value\as\atom, "!=") = 0
        return: l2_error(path, ret, "unsupported body")
    if: l2_digits(r2\value\as\atom) = 0 || l2_int_fits(r2\value\as\atom) = 0
        return: l2_error(path, r2\value, "unsupported body")
    l2_xr: r2\value\as\atom
    l2_leaf_mode: 1
return: 0

fn: l2_parse_leaf (const: @(LmP0Node add_node); const: @(LmP0Node main_node); const: @(char path)) int
    l2_nm: 0
    l2_fa: 0
    l2_fb: 0
    l2_xa: 0
    l2_xb: 0
    l2_xr: 0
    l2_leaf_mode: 0
    l2_sigv: 0U
    if: l2_parse_add_fn(add_node, path) != 0
        return: 1
    if: l2_parse_main_call(main_node, path) != 0
        return: 1
return: 0

fn: l2_emit_leaf (const: @(char out_path)) int
    @: FILE out
    if: out_path = 0 || l2_nm = 0 || l2_fa = 0 || l2_fb = 0 || l2_xa = 0 || l2_xb = 0
        return: 1
    out: c.fopen(out_path, "wb")
    if: out = 0
        c.fprintf(c.stderr, "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: c.fputs("predef: \"l2src/lmx_branch.lm1\"\ninclude: \"l2src/lmx.h\" \"<stdio.h>\" \"<stdlib.h>\"\n\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fputs("fn: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_nm) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(" (@: Lmx node; int: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_fa) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("; int: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_fb) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(") int\n    if: node = 0\n        return: 0\n    return: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_fa) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(" + ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_fb) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("\nend: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_nm) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("\n\nexternal:\n    fn: main () int\n        @: Lmx unit 0\n        @: Lmx leaf 0\n        @: LmxMethod rec 0\n        int: got\n        if: lmx_ranges_init(8U) != 0\n            return: 1\n        rec: (cast: (@: LmxMethod) c.malloc(c.sizeof(c.LmxMethod)))\n        if: rec = 0\n            return: 1\n        rec\\addr: (cast: (LmxEntry) ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_nm) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(")\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fprintf(out, "        rec\\sig: %uU\n", l2_sigv) < 0
        c.fclose(out)
        return: 1
    if: c.fputs("        if: lmx_range_register((cast: (@: void) rec), (cast: (@: void) (rec + 1)), c.sizeof(c.LmxMethod), c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD) != 0\n            return: 1\n        unit: (cast: (@: Lmx) c.malloc(c.sizeof(c.Lmx)))\n        if: unit = 0\n            return: 1\n        lmx_cell_init(unit, 0, 0)\n        if: lmx_branch_open(unit, 1U) != 0\n            return: 1\n        leaf: lmx_branch_child(unit, 0U)\n        if: leaf = 0\n            return: 1\n        leaf\\data: (cast: (@: void) rec)\n        if: lmx_classify(leaf\\data) != c.LMX_KIND_METHOD\n            return: 1\n        if: rec\\sig != ", out) < 0
        c.fclose(out)
        return: 1
    if: c.fprintf(out, "%uU\n            return: 1\n        if: leaf\\node != unit\n            return: 1\n        got: ", l2_sigv) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_nm) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("(leaf\\node, ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_xa) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(", ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_xb) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(")\n", out) < 0
        c.fclose(out)
        return: 1
    if: l2_leaf_mode = 2 && c.fputs("        return: got\n", out) < 0
        c.fclose(out)
        return: 1
    if: l2_leaf_mode != 2 && c.fputs("        return: got != ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_leaf_mode != 2 && l2_write_text(out, l2_xr) != 0
        c.fclose(out)
        return: 1
    if: l2_leaf_mode != 2 && c.fputs("\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fputs("    end: main\nend: external\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fclose(out) != 0
        return: 1
return: 0
