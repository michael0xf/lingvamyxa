include: "l2src/lmx.h"
predef: "l2src/lmx_msg_storage.h.lm1"

# Owned ARRAY_OF_LMX/DESC/METHOD record using native pointer elements. An empty
# Array is a typed descriptor with len 0/data 0 and no backing range. Referent
# allocation/root publication remain the caller's responsibility.
prototype:
    fn: lmx_array_ref_new_owned (int: type; size_t: count; @@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: LmxArrayDesc
end: prototype

# Compatibility boundary for callers that specifically require a positive
# count. Generic graph code uses lmx_array_ref_new_owned.
prototype:
    fn: lmx_array_ref_new_positive_owned (int: type; size_t: count; @@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: LmxArrayDesc
end: prototype
