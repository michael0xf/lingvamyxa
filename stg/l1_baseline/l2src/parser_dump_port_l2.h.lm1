include: "l1src/p0.lm1.h"

# Header unit for the clean L2 port of l1src/parser.lm1's dump-printer
# family (parser-in-L2 port ticket, Stage c continued). lm_own_resize
# is L1-implemented (l1src/own.lm1, compiled into the same oracle
# object this L2 unit links against) -- Stage A rule: an LMX name
# needs a prototype: declaration here, never c.

prototype:
    fn: lm_own_resize (@: void object; size_t: size) @: void
end: prototype
