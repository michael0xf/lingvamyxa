include: "l2src/lmx_message.h" "l2src/lmx_message_exec.h"

fn: probe_scan2 (@: LmxMsgRuntime rt) int
    int: i 0
    int: n
    unsigned: a
    n: c.lmx_msg_exec_bind_n_locked(rt)
    while: i < n
        a: c.lmx_msg_exec_bind_addr_locked(rt, i)
        if: a != 0U && c.lmx_msg_exec_bind_held_locked(rt, i) = 0
            return: 1
        ---
        i: i + 1
    ---
    return: 0
end: probe_scan2
