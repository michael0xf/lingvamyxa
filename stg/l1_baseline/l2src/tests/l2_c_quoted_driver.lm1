include: "l2src/lmx.h" "<stdio.h>" "<stddef.h>"
prototype:
    fn: l2_m2 (@: Lmx node; const: @(char text); size_t: end_index; size_t: start) size_t
    fn: l2_m3 (@: Lmx node; const: @(char text); size_t: end_index; size_t: start) int
    fn: l2_m4 (@: Lmx node; const: @(char text); size_t: end_index; size_t: start) size_t
    fn: l2_m5 (@: Lmx node; const: @(char text); size_t: end_index; size_t: start) size_t
    fn: lm_p0_scan_c_quoted_token (const: @(char text); size_t: end_index; size_t: start) size_t
    fn: lm_p0_starts_c_prefixed_quote (const: @(char text); size_t: end_index; size_t: start) int
    fn: lm_p0_scan_c_char_token (const: @(char text); size_t: end_index; size_t: start) size_t
    fn: lm_p0_scan_c_prefixed_quote_token (const: @(char text); size_t: end_index; size_t: start) size_t
end: prototype

fn: l2_c_quoted_compare (@: Lmx unit; const: @(char text); size_t: end; size_t: start; @: int checks) int
    size_t: got
    size_t: expected
    int: prefix_got
    int: prefix_expected
    got: c.l2_m2(unit, text, end, start)
    expected: c.lm_p0_scan_c_quoted_token(text, end, start)
    if: got != expected
        c.printf("quoted mismatch end=%zu start=%zu got=%zu expected=%zu\n", end, start, got, expected)
        return: 1
    got: c.l2_m4(unit, text, end, start)
    expected: c.lm_p0_scan_c_char_token(text, end, start)
    if: got != expected
        c.printf("char mismatch end=%zu start=%zu got=%zu expected=%zu\n", end, start, got, expected)
        return: 1
    got: c.l2_m5(unit, text, end, start)
    expected: c.lm_p0_scan_c_prefixed_quote_token(text, end, start)
    if: got != expected
        c.printf("prefixed mismatch end=%zu start=%zu got=%zu expected=%zu\n", end, start, got, expected)
        return: 1
    prefix_got: c.l2_m3(unit, text, end, start)
    prefix_expected: c.lm_p0_starts_c_prefixed_quote(text, end, start)
    if: prefix_got != prefix_expected
        c.printf("prefix predicate mismatch end=%zu start=%zu got=%d expected=%d\n", end, start, prefix_got, prefix_expected)
        return: 1
    checks[0]: checks[0] + 4
return: 0

fn: l2_c_quoted_check (@: Lmx unit) int
    c.array: [8]: char bytes
    c.array: [8]: char alphabet
    size_t: length 0U
    size_t: variants 1U
    size_t: code
    size_t: digits
    size_t: i
    size_t: start
    int: quote_kind 0
    int: break_kind
    int: checks 0
    if: unit = 0
        return: 1
    alphabet[0]: 0
    alphabet[1]: 10
    alphabet[2]: 13
    alphabet[3]: 34
    alphabet[4]: 39
    alphabet[5]: 76
    alphabet[6]: 92
    alphabet[7]: 120
    # Explicit lengths admit embedded NUL; every possible start includes EOF.
    while: length <= 4U
        code: 0U
        while: code < variants
            digits: code
            i: 0U
            while: i < length
                bytes[i]: alphabet[digits % 8U]
                digits: digits / 8U
                i: i + 1U
            start: 0U
            while: start <= length
                if: l2_c_quoted_compare(unit, bytes, length, start, @ checks) != 0
                    return: 1
                start: start + 1U
            code: code + 1U
        length: length + 1U
        variants: variants * 8U
    ---
    if: l2_c_quoted_compare(unit, 0, 0U, 0U, @ checks) != 0
        return: 1
    # Longer explicit cases cover both quotes and each physical splice width.
    while: quote_kind < 2
        break_kind: 0
        while: break_kind < 3
            bytes[0]: 120
            bytes[1]: 76
            bytes[2]: (cast: (char) (34 + quote_kind * 5))
            bytes[3]: 92
            bytes[4]: 10
            bytes[5]: bytes[2]
            length: 6U
            if: break_kind = 1
                bytes[4]: 13
            if: break_kind = 2
                bytes[4]: 13
                bytes[5]: 10
                bytes[6]: bytes[2]
                length: 7U
            start: 0U
            while: start <= length
                if: l2_c_quoted_compare(unit, bytes, length, start, @ checks) != 0
                    return: 1
                start: start + 1U
            ---
            if: c.l2_m2(unit, bytes, length, 2U) != length || c.l2_m5(unit, bytes, length, 1U) != length
                return: 1
            checks: checks + 2
            break_kind: break_kind + 1
        quote_kind: quote_kind + 1
    ---
    bytes[0]: 34
    bytes[1]: (cast: (char) 128)
    bytes[2]: (cast: (char) 255)
    bytes[3]: 34
    if: l2_c_quoted_compare(unit, bytes, 4U, 0U, @ checks) != 0 || c.l2_m2(unit, bytes, 4U, 0U) != 4U
        return: 1
    bytes[1]: 10
    if: l2_c_quoted_compare(unit, bytes, 4U, 0U, @ checks) != 0 || c.l2_m2(unit, bytes, 4U, 0U) != 1U
        return: 1
    checks: checks + 2
    c.printf("C quoted L2 differential checks=%d PASS\n", checks)
return: 0
