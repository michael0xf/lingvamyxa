L2:
    int: counter 7
    size_t: total 11U
    char: tag 'A'

    fn: bump () int
        counter: counter + 1
        total: total + 2U
        tag: tag + 1
        return: counter
    end: bump

    fn: check () int
        if: counter != 7
            return: 81
        if: total != 11U
            return: 82
        if: tag != 'A'
            return: 83
        if: bump() != 8
            return: 84
        # The caller keeps its existing caches after a nested call.
        if: counter != 7 || total != 11U || tag != 'A'
            return: 85
        return: 0
    end: check

    fn: fresh () int
        if: counter != 8 || total != 13U || tag != 'B'
            return: 86
        return: 0
    end: fresh

    fn: main () int
        if: check() != 0
            return: 87
        return: fresh()
    end: main
end: L2
