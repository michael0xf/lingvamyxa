include: "l2src/lmx.h" "l2src/lmx_message.h" "l2src/lmx_message_exec.h" "<stdio.h>" "<stdlib.h>" "<string.h>"

# Decision 17 (Mikhail, 2026-09-14; model section 32, SPEC 19.29.6): a
# released branch is never retained, and release does not wait for the
# children. (1) A parent that releases a child starts a chain reaction down
# the subtree, and the branch's slots are freed by that chain, never at
# runtime_delete. (2) A child's self-close starts the same chain for its own
# subtree. (3) A parent whose own algorithm sets success while its children
# still run declares their work unneeded, and the chain closes and releases
# them. Written as acceptance first: on the runtime of 2026-09-14 (main
# 0fb56413) the three release checks are RED, because dispose_child only marks
# disposed=1 and a disposed child stays linked to its parent, which therefore
# never retires before runtime_delete (found during stage 3b-8). The test is
# opt-in in run_model_scenario36.ps1 (-Tests) until the lead's implementation
# lands; then it joins the default set.
#
# Host-driven: R (root) has P1, P2, P3; each has one child C. Every turn runs
# on the host's sequential mapping.

int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

# A turn that takes nothing and ends successfully; the closing path of
# end_turn handles a Message whose closing flag is set.
fn: turn_ok (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    if: ctx != 0
        return: 1
    return: lmx_msg_end_turn(rt, who, 1)

# The address is gone from the runtime: no Message resolves to it any more.
fn: gone (@: LmxMsgRuntime rt; LmxMsgAddr: a) int
    return: lmx_msg_find(rt, a) = 0

fn: main () int
    @: LmxMsgRuntime rt
    @: LmxMsg cm
    unsigned: r 0U
    unsigned: p1 0U
    unsigned: c1 0U
    unsigned: p2 0U
    unsigned: c2 0U
    unsigned: p3 0U
    unsigned: c3 0U
    uchar: ini 1
    int: st

    rt: lmx_msg_runtime_new()
    check(rt != 0 && lmx_msg_create(rt, 0U, 1U, @ ini, 1U, @ r) = c.LMX_MSG_OK, "R, the root, created")
    if: rt = 0 || r = 0U
        return: 2
    check(lmx_msg_create(rt, r, 2U, @ ini, 1U, @ p1) = c.LMX_MSG_OK && lmx_msg_create(rt, r, 3U, @ ini, 1U, @ p2) = c.LMX_MSG_OK && lmx_msg_create(rt, r, 4U, @ ini, 1U, @ p3) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, r, 1) = c.LMX_MSG_OK, "P1, P2, P3 created and published")
    check(lmx_msg_create(rt, p1, 5U, @ ini, 1U, @ c1) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, p1, 1) = c.LMX_MSG_OK, "C1 created by P1 and published")
    check(lmx_msg_create(rt, p2, 6U, @ ini, 1U, @ c2) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, p2, 1) = c.LMX_MSG_OK, "C2 created by P2 and published")
    check(lmx_msg_create(rt, p3, 7U, @ ini, 1U, @ c3) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, p3, 1) = c.LMX_MSG_OK, "C3 created by P3 and published")
    check(lmx_msg_exec_bind(rt, p1, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, c1, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, p2, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, c2, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, p3, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, c3, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK, "all six launched on the host's mapping")
    check(lmx_msg_child_n(rt, r) = 3 && lmx_msg_child_n(rt, p1) = 1 && lmx_msg_child_n(rt, p2) = 1 && lmx_msg_child_n(rt, p3) = 1, "the families as created")

    # --- (1) orderly: C1 completes, P1 disposes it; the disposed child leaves
    # its family and its slot; then P1 completes, R disposes P1; P1 is gone too.
    check(lmx_msg_complete(rt, c1) = c.LMX_MSG_OK, "C1 marks success")
    st: lmx_msg_run_child_turn(rt, c1)
    cm: lmx_msg_find(rt, c1)
    check((st = c.LMX_MSG_OK || st = 1) && cm != 0 && lmx_msg_handoff_ready(rt, c1) != 0 && lmx_msg_success_load(cm) != 0 && lmx_msg_running_load(cm) = 0, "C1 settled at its own end-turn: success, not running, handoff-ready")
    check(lmx_msg_dispose_child(rt, p1, c1) = c.LMX_MSG_OK, "P1 disposes C1")
    check(gone(rt, c1) != 0 && lmx_msg_child_n(rt, p1) = 0, "a disposed child leaves its family and its slot is released, not kept until runtime_delete")
    check(lmx_msg_complete(rt, p1) = c.LMX_MSG_OK, "P1 marks success")
    st: lmx_msg_run_child_turn(rt, p1)
    check((st = c.LMX_MSG_OK || st = 1) && lmx_msg_handoff_ready(rt, p1) != 0, "P1 settled at its own end-turn")
    check(lmx_msg_dispose_child(rt, r, p1) = c.LMX_MSG_OK, "R disposes P1")
    check(gone(rt, p1) != 0 && lmx_msg_child_n(rt, r) = 2, "the released parent is gone with its branch: R has two children left")

    # --- (2) forced: C2 still runs; R stops P2 and releases it; the chain
    # closes and releases C2 without R touching a grandchild.
    check(lmx_msg_emergency_cancel(rt, p2) = c.LMX_MSG_OK, "R stops P2 while C2 runs")
    st: lmx_msg_run_child_turn(rt, p2)
    cm: lmx_msg_find(rt, c2)
    check((st = c.LMX_MSG_OK || st = 1) && lmx_msg_state(rt, p2) = c.LMX_MSG_STATE_STOPPED && cm != 0 && lmx_msg_running_load(cm) = 0, "P2 stopped at its end-turn and requested C2's close: the chain, one level")
    st: lmx_msg_run_child_turn(rt, c2)
    check((st = c.LMX_MSG_OK || st = 1) && lmx_msg_state(rt, c2) = c.LMX_MSG_STATE_STOPPED, "C2 stopped at its own end-turn")
    check(lmx_msg_dispose_child(rt, r, p2) = c.LMX_MSG_OK, "R releases P2 without disposing C2 itself: release does not wait for the children")
    check(gone(rt, p2) != 0 && gone(rt, c2) != 0 && lmx_msg_child_n(rt, r) = 1, "the forced release freed the whole branch: P2 and C2 are gone")

    # --- (3) success with a running child: P3's own algorithm completes while
    # C3 runs; that declares C3's work unneeded, and the chain closes and
    # releases it.
    cm: lmx_msg_find(rt, c3)
    check(cm != 0 && lmx_msg_running_load(cm) != 0 && lmx_msg_complete(rt, p3) = c.LMX_MSG_OK, "P3 marks success while C3 still runs")
    st: lmx_msg_run_child_turn(rt, p3)
    check((st = c.LMX_MSG_OK || st = 1) && lmx_msg_handoff_ready(rt, p3) != 0 && lmx_msg_running_load(cm) = 0, "P3's end-turn closes C3: success with running children means their work is unneeded")
    st: lmx_msg_run_child_turn(rt, c3)
    check((st = c.LMX_MSG_OK || st = 1) && lmx_msg_state(rt, c3) = c.LMX_MSG_STATE_STOPPED, "C3 stopped at its own end-turn")
    check(lmx_msg_dispose_child(rt, r, p3) = c.LMX_MSG_OK, "R releases P3")
    check(gone(rt, p3) != 0 && gone(rt, c3) != 0 && lmx_msg_child_n(rt, r) = 0, "the successful parent's branch is freed by the chain: R has no children left")
    check(lmx_msg_find(rt, r) != 0 && lmx_msg_running_load(lmx_msg_find(rt, r)) != 0, "the root runs on")

    lmx_msg_runtime_delete(rt)
    c.printf("family release 17: %d checks, %d failures\n", checks, failures)
    if: failures != 0
        return: 1
    return: 0
