include: "l2src/lmx.h" "l2src/lmx_message.h" "l1src/p0.h" "<stdio.h>" "<stdlib.h>" "<string.h>" "<stdint.h>"
predef: "l2src/lmx_branch_owned.h.lm1" "l2src/lmx_value_owned.h.lm1" "l2src/lmx_owned_ranges.h.lm1" "l2src/lmx_msg_blocks.h.lm1"
prototype:
    fn: l2_program_entry (@: LmxMsg owner) int
    fn: candidate_ctx_lm_p0_parse_bytes (@: Lmx unit; const: @(char source); size_t: n; @@: LmP0Document out_document) int
    fn: lm_p0_parse_bytes (const: @(char source); size_t: n; @@: LmP0Document out_document) int
    fn: lm_p0_scan_c_char (@: LmP0Document document; const: @(char text); size_t: length; @: size_t index; size_t: line; size_t: base_column) int
    fn: lm_p0_scan_c_prefixed_quote (@: LmP0Document document; const: @(char text); size_t: length; @: size_t index; size_t: line; size_t: base_column) int
    fn: candidate_ctx_lm_p0_scan_c_char (@: Lmx unit; @: LmP0Document document; const: @(char text); size_t: length; @: size_t index; size_t: line; size_t: base_column) int
    fn: candidate_ctx_lm_p0_scan_c_prefixed_quote (@: Lmx unit; @: LmP0Document document; const: @(char text); size_t: length; @: size_t index; size_t: line; size_t: base_column) int
    fn: lm_p0_is_line_break (char: value) int
    fn: lm_p0_is_horizontal_space (char: value) int
    fn: lm_p0_is_field_space (char: value) int
    fn: lm_p0_is_field_separator (char: value) int
    fn: lm_p0_line_break_width_at (const: @(char source); size_t: length; size_t: index) size_t
    sub: lm_p0_position_in_slice (const: @(char text); size_t: length; size_t: index; size_t: base_line; size_t: base_column; @: size_t out_line; @: size_t out_column)
    fn: candidate_ctx_lm_p0_is_line_break (@: Lmx unit; char: value) int
    fn: candidate_ctx_lm_p0_is_horizontal_space (@: Lmx unit; char: value) int
    fn: candidate_ctx_lm_p0_is_field_space (@: Lmx unit; char: value) int
    fn: candidate_ctx_lm_p0_is_field_separator (@: Lmx unit; char: value) int
    fn: candidate_ctx_lm_p0_line_break_width_at (@: Lmx unit; const: @(char source); size_t: length; size_t: index) size_t
    sub: candidate_ctx_lm_p0_position_in_slice (@: Lmx unit; const: @(char text); size_t: length; size_t: index; size_t: base_line; size_t: base_column; @: size_t out_line; @: size_t out_column)
    sub: compare_node (const: @(LmP0Node got); const: @(LmP0Node expected))
    sub: compare_structure (const: @(LmP0Structure got); const: @(LmP0Structure expected))
    sub: compare_trailer (const: @(LmP0Trailer got); const: @(LmP0Trailer expected))
    fn: lm_p0_dump_alloc (const: @(LmP0Document document)) @: char
    fn: candidate_lm_p0_dump_alloc (const: @(LmP0Document document)) @: char
    sub: lm_p0_free (@: void ptr)
    sub: candidate_lm_p0_free (@: void ptr)
    sub: lm_p0_document_destroy (@: LmP0Document document)
    sub: candidate_lm_p0_document_destroy (@: LmP0Document document)
    sub: __real_free (@: void ptr)
    fn: __real_lmx_node_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: Lmx
    fn: __real_lmx_method_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: LmxMethod
end: prototype

# Test-only allocator observations; these are never an owner/context registry.
int: test_fail_node 0
int: test_fail_method 0
int: test_tracked 0
int: test_owner_start 0
[]: uintptr_t test_addresses 4096
[]: int test_frees 4096
int: test_cases 0
int: test_successes 0
int: test_errors 0
int: test_diagnostics 0
int: test_spans 0
int: test_layout 0

sub: require (int: condition; const: @(char label))
    if: condition = 0
        c.printf("FAIL %s\n", label)
        c.exit(2)
    ---
end: require

fn: __wrap_lmx_node_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: Lmx
    if: test_fail_node != 0
        test_fail_node: 0
        return: 0
return: c.__real_lmx_node_new_owned(blocks, ranges)

fn: __wrap_lmx_method_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: LmxMethod
    if: test_fail_method != 0
        test_fail_method: 0
        return: 0
return: c.__real_lmx_method_new_owned(blocks, ranges)

sub: __wrap_free (@: void ptr)
    int: i 0
    while: i < test_tracked
        if: test_addresses[i] = (cast: (uintptr_t) ptr)
            test_frees[i]: test_frees[i] + 1
            require(test_frees[i] = 1, "duplicate graph resource free")
        i: i + 1
    c.__real_free(ptr)
end: __wrap_free

sub: track (@: void ptr)
    int: i 0
    require(ptr != 0, "tracked null")
    while: i < test_tracked
        if: test_addresses[i] = (cast: (uintptr_t) ptr)
            # A range record can also be an owned block base. Observe the
            # physical allocation once; sharing across Messages is an error.
            require(i >= test_owner_start, "graph allocation shared across owners")
            return
        i: i + 1
    require(test_tracked < 4096, "test tracking capacity")
    test_addresses[test_tracked]: (cast: (uintptr_t) ptr)
    test_frees[test_tracked]: 0
    test_tracked: test_tracked + 1
end: track

sub: track_owner (@: LmxMsg owner)
    @: LmxMsgBlock block owner\blocks
    @: LmxOwnedRange range owner\ranges
    test_owner_start: test_tracked
    while: block != 0
        track(block\base)
        track(block)
        block: block\next
    while: range != 0
        track(range)
        range: range\next
end: track_owner

# Candidate API pin. owner is a dedicated scanner Message: its graph is empty
# or a scanner unit created by this entry; arbitrary application graphs are
# outside this temporary candidate interface's preconditions.
fn: l2_c_scanners_parse_bytes (@: LmxMsg owner; const: @(char source); size_t: n; @@: LmP0Document out_document) int
    @: Lmx unit
    if: out_document = 0
        return: 1
    out_document[0]: 0
    if: owner = 0
        return: 1
    unit: c.lmx_msg_graph(owner)
    if: unit = 0
        if: c.l2_program_entry(owner) != 0
            # The generated constructor can fail after set_graph. Its
            # allocations remain owned by Message until caller cleanup.
            c.lmx_msg_set_graph(owner, 0)
            return: 1
        unit: c.lmx_msg_graph(owner)
    ---
    if: unit = 0
        return: 1
return: c.candidate_ctx_lm_p0_parse_bytes(unit, source, n, out_document)

fn: hits (@: LmxMsg owner; int: index) int
    @: Lmx unit c.lmx_msg_graph(owner)
    @: Lmx cell
    if: unit = 0
        return: 0
    cell: lmx_branch_child_known(unit, (cast: (size_t) (16 + index)))
return: lmx_int_value_known(cell\data)

fn: total_hits (@: LmxMsg owner) int
    int: i 0
    int: total 0
    while: i < 16
        total: total + hits(owner, i)
        i: i + 1
return: total

sub: compare_trailer (const: @(LmP0Trailer got); const: @(LmP0Trailer expected))
    require((got = 0) = (expected = 0), "trailer null parity")
    if: got = 0
        return
    require(got\flags = expected\flags, "trailer flags")
    compare_structure(got\body, expected\body)
end: compare_trailer

sub: compare_structure (const: @(LmP0Structure got); const: @(LmP0Structure expected))
    const: @(LmP0Field g)
    const: @(LmP0Field e)
    require((got = 0) = (expected = 0), "structure null parity")
    if: got = 0
        return
    require(got\field_count = expected\field_count, "structure field count")
    g: got\first_field
    e: expected\first_field
    while: g != 0 && e != 0
        compare_node(g\value, e\value)
        g: g\next
        e: e\next
    require(g = 0 && e = 0, "field chain length")
    compare_trailer(got\trailer, expected\trailer)
end: compare_structure

sub: compare_node (const: @(LmP0Node got); const: @(LmP0Node expected))
    require((got = 0) = (expected = 0), "node null parity")
    if: got = 0
        return
    require(got\kind = expected\kind && got\flags = expected\flags, "node kind and flags")
    require((got\span = 0) = (expected\span = 0), "span null parity")
    if: got\span != 0
        require(got\span\line = expected\span\line && got\span\column = expected\span\column, "node line and column")
        require(got\span\offset = expected\span\offset && got\span\length = expected\span\length, "node offset and length")
        test_spans: test_spans + 1
    ---
    if: got\kind = c.LM_P0_NODE_STRUCTURE
        compare_structure(got\as\structure, expected\as\structure)
    if: got\kind = c.LM_P0_NODE_FRAME
        compare_structure(got\as\frame\body, expected\as\frame\body)
        compare_trailer(got\as\frame\trailer, expected\as\frame\trailer)
    ---
end: compare_node

sub: compare (@: LmxMsg owner; const: @(char source); size_t: length)
    @: LmP0Document got 0
    @: LmP0Document expected 0
    @: char gd
    @: char ed
    int: gs
    int: es
    gs: l2_c_scanners_parse_bytes(owner, source, length, @ got)
    es: c.lm_p0_parse_bytes(source, length, @ expected)
    c.printf("case=%d status=%d reference=%d\n", test_cases, gs, es)
    if: gs = 0
        test_successes: test_successes + 1
    else:
        test_errors: test_errors + 1
    ---
    if: gs != es
        c.printf("status mismatch case=%d got=%d expected=%d\n", test_cases, gs, es)
        c.exit(2)
    require((got = 0) = (expected = 0), "document null parity")
    if: got != 0
        require(got\diagnostic != 0 && expected\diagnostic != 0, "diagnostic storage")
        require(got\diagnostic\code = expected\diagnostic\code, "diagnostic code")
        require(got\diagnostic\line = expected\diagnostic\line && got\diagnostic\column = expected\diagnostic\column, "diagnostic location")
        require(c.strcmp(got\diagnostic\message, expected\diagnostic\message) = 0, "diagnostic text")
        compare_node(got\root, expected\root)
        gd: c.candidate_lm_p0_dump_alloc(got)
        ed: c.lm_p0_dump_alloc(expected)
        require(gd != 0 && ed != 0, "dump allocation")
        if: c.strcmp(gd, ed) != 0
            c.printf("AST mismatch case=%d\nGOT:\n%s\nEXPECTED:\n%s\n", test_cases, gd, ed)
            c.exit(2)
        c.candidate_lm_p0_free(gd)
        c.lm_p0_free(ed)
    ---
    c.candidate_lm_p0_document_destroy(got)
    c.lm_p0_document_destroy(expected)
    test_cases: test_cases + 1
end: compare

sub: compare_pair (@: LmxMsg a; @: LmxMsg b; const: @(char source))
    int: a_before total_hits(a)
    int: a_after
    int: b_before total_hits(b)
    @: Lmx au c.lmx_msg_graph(a)
    @: Lmx bu c.lmx_msg_graph(b)
    compare(a, source, c.strlen(source))
    require(total_hits(b) = b_before, "A changed B counters")
    a_after: total_hits(a)
    require(a_after >= a_before, "A counters lost")
    compare(b, source, c.strlen(source))
    require(total_hits(a) = a_after, "B changed A counters")
    if: au != 0
        require(c.lmx_msg_graph(a) = au, "A unit replaced")
    if: bu != 0
        require(c.lmx_msg_graph(b) = bu, "B unit replaced")
    au: c.lmx_msg_graph(a)
    bu: c.lmx_msg_graph(b)
    require(au != bu, "independent units")
    require(lmx_owned_ranges_find(a\ranges, au) != 0 && lmx_owned_ranges_find(b\ranges, au) = 0, "A owner locality")
    require(lmx_owned_ranges_find(b\ranges, bu) != 0 && lmx_owned_ranges_find(a\ranges, bu) = 0, "B owner locality")
end: compare_pair

# Exercise the real candidate adapters independently of parser recovery so
# every starting offset, slice limit and preserved first diagnostic is visible.
sub: compare_diagnostic (@: LmxMsg owner; int: prefixed; const: @(char text); size_t: length; size_t: start; size_t: line; size_t: column; int: prior)
    @: LmP0Document got 0
    @: LmP0Document expected 0
    @: Lmx unit c.lmx_msg_graph(owner)
    size_t: gi start
    size_t: ei start
    int: gs
    int: es
    require(c.lm_p0_parse_bytes("", 0U, @ got) = 0, "scratch diagnostic document")
    require(c.lm_p0_parse_bytes("", 0U, @ expected) = 0, "oracle diagnostic document")
    got\diagnostic\code: prior
    expected\diagnostic\code: prior
    got\diagnostic\line: 91U
    expected\diagnostic\line: 91U
    got\diagnostic\column: 73U
    expected\diagnostic\column: 73U
    c.strcpy(got\diagnostic\message, "first diagnostic sentinel")
    c.strcpy(expected\diagnostic\message, "first diagnostic sentinel")
    if: prefixed != 0
        gs: c.candidate_ctx_lm_p0_scan_c_prefixed_quote(unit, got, text, length, @ gi, line, column)
        es: c.lm_p0_scan_c_prefixed_quote(expected, text, length, @ ei, line, column)
    else:
        gs: c.candidate_ctx_lm_p0_scan_c_char(unit, got, text, length, @ gi, line, column)
        es: c.lm_p0_scan_c_char(expected, text, length, @ ei, line, column)
    ---
    require(gs = es && gi = ei, "wrapper result/index parity")
    if: gs = 0
        require(gi = start, "failure changed source index")
        if: prior = 0
            require(got\diagnostic\code = 4, "new quote diagnostic code")
        ---
    else:
        require(gi > start + 1U && gi <= length, "success did not advance index")
    ---
    require(got\diagnostic\code = expected\diagnostic\code, "wrapper diagnostic code")
    require(got\diagnostic\line = expected\diagnostic\line && got\diagnostic\column = expected\diagnostic\column, "wrapper diagnostic position")
    require(c.strcmp(got\diagnostic\message, expected\diagnostic\message) = 0, "wrapper diagnostic message")
    if: prior != 0 || gs != 0
        require(got\diagnostic\code = prior && got\diagnostic\line = 91U && got\diagnostic\column = 73U, "overwrote existing or successful diagnostic")
        require(c.strcmp(got\diagnostic\message, "first diagnostic sentinel") = 0, "overwrote first message")
    ---
    c.lm_p0_document_destroy(got)
    c.lm_p0_document_destroy(expected)
    test_diagnostics: test_diagnostics + 1
end: compare_diagnostic

sub: diagnostic_slices (@: LmxMsg a; @: LmxMsg b; const: @(char text))
    size_t: length c.strlen(text)
    size_t: limit 0U
    size_t: start
    int: mode
    int: a_after
    int: b_before
    while: limit <= length
        start: 0U
        while: start <= limit
            mode: 0
            while: mode < 2
                b_before: total_hits(b)
                compare_diagnostic(a, mode, text, limit, start, 7U, 23U, 0)
                require(total_hits(b) = b_before, "diagnostic A changed B")
                a_after: total_hits(a)
                compare_diagnostic(b, mode, text, limit, start, 31U, 5U, 19)
                require(total_hits(a) = a_after, "diagnostic B changed A")
                mode: mode + 1
            start: start + 1U
        limit: limit + 1U
end: diagnostic_slices

sub: layout_bytes (@: LmxMsg owner)
    @: Lmx unit c.lmx_msg_graph(owner)
    int: i 0
    char: value
    while: i < 256
        value: (cast: char i)
        require(c.candidate_ctx_lm_p0_is_line_break(unit, value) = c.lm_p0_is_line_break(value), "all-byte line break predicate")
        require(c.candidate_ctx_lm_p0_is_horizontal_space(unit, value) = c.lm_p0_is_horizontal_space(value), "all-byte horizontal predicate")
        require(c.candidate_ctx_lm_p0_is_field_space(unit, value) = c.lm_p0_is_field_space(value), "all-byte field space predicate")
        require(c.candidate_ctx_lm_p0_is_field_separator(unit, value) = c.lm_p0_is_field_separator(value), "all-byte separator predicate")
        test_layout: test_layout + 4
        i: i + 1
end: layout_bytes

sub: layout_position (@: LmxMsg owner; const: @(char text); size_t: length; size_t: index; size_t: line; size_t: column)
    @: Lmx unit c.lmx_msg_graph(owner)
    size_t: gl 999U
    size_t: gc 888U
    size_t: el 999U
    size_t: ec 888U
    require(c.candidate_ctx_lm_p0_line_break_width_at(unit, text, length, index) = c.lm_p0_line_break_width_at(text, length, index), "line break width parity")
    c.candidate_ctx_lm_p0_position_in_slice(unit, text, length, index, line, column, @ gl, @ gc)
    c.lm_p0_position_in_slice(text, length, index, line, column, @ el, @ ec)
    require(gl = el && gc = ec, "direct position parity")
    test_layout: test_layout + 2
end: layout_position

sub: layout_slices (@: LmxMsg a; @: LmxMsg b; const: @(char text))
    size_t: length c.strlen(text)
    size_t: skip 0U
    size_t: limit
    size_t: index
    int: b_before
    int: a_after
    while: skip <= length
        limit: 0U
        while: limit <= length - skip
            index: 0U
            while: index <= limit + 1U
                b_before: total_hits(b)
                layout_position(a, text + skip, limit, index, 1U, 1U)
                require(total_hits(b) = b_before, "layout A changed B")
                a_after: total_hits(a)
                layout_position(b, text + skip, limit, index, 17U, 31U)
                require(total_hits(a) = a_after, "layout B changed A")
                index: index + 1U
            limit: limit + 1U
        skip: skip + 1U
end: layout_slices

fn: make_owner (@: LmxMsgRuntime rt; unsigned: id) @: LmxMsg
    unsigned: addr 0U
    require(c.lmx_msg_create(rt, 0U, id, 0, 0U, @ addr) = c.LMX_MSG_OK, "create owner")
return: c.lmx_msg_find(rt, addr)

fn: main () int
    @: LmxMsgRuntime rt c.lmx_msg_runtime_new()
    @: LmxMsg a
    @: LmxMsg b
    @: LmxMsg failed_node
    @: LmxMsg failed_method
    @: LmP0Document doc 0
    int: i 0
    c.array: [5]: char nul_source
    require(rt != 0, "runtime")
    a: make_owner(rt, 11U)
    b: make_owner(rt, 12U)
    failed_node: make_owner(rt, 13U)
    failed_method: make_owner(rt, 14U)
    require(a != 0 && b != 0 && failed_node != 0 && failed_method != 0, "owner handles")
    compare_pair(a, b, "")
    compare_pair(a, b, "a\n")
    compare_pair(a, b, "x: 'a'\n")
    compare_pair(a, b, "x: L'a'\n")
    compare_pair(a, b, "x: L\"wide\"\n")
    compare_pair(a, b, "x: \"string\"\n")
    compare_pair(a, b, "x: c.foo\n")
    compare_pair(a, b, "x: c.array[1 + (2)]\n")
    compare_pair(a, b, "x: c.sizeof(int)\n")
    compare_pair(a, b, "x: c.sizeof((int)[2])\n")
    compare_pair(a, b, "x: c.sizeof(\")\")\n")
    compare_pair(a, b, "x: c.sizeof(L')')\n")
    compare_pair(a, b, "x: c.sizeof(@p)\n")
    compare_pair(a, b, "x: c.sizeof(\"c.x\")\n")
    compare_pair(a, b, "x: c.foo[ a[b] ]\n")
    compare_pair(a, b, "x: 'unterminated\n")
    compare_pair(a, b, "x: L'unterminated\n")
    compare_pair(a, b, "x: c.sizeof(\n")
    compare_pair(a, b, "x: c.foo[ unterminated\n")
    compare_pair(a, b, "x: c.foo; y: c.bar\n")
    compare_pair(a, b, "x: 'a\\\nb'\n")
    compare_pair(a, b, "x: L'a\\\r\nb'\n")
    compare_pair(a, b, "a:\n    x: c.sizeof(int)\n    y: L'x'\n")
    compare_pair(a, b, "x: c.foo # comment\n")
    compare_pair(a, b, "x: c.foo{bar}\n")
    compare_pair(a, b, "--\nx: c.foo\n")
    compare_pair(a, b, "a:\r    x: 'bad\r")
    compare_pair(a, b, "a:\r\n    x: L\"bad\r\n")
    compare_pair(a, b, "x: L'a\\\rb'\r")
    compare_pair(a, b, "a:\r\n    x: (a, b; c)\n    y: [1, 2]\r    z: L'a'\r\nend: a\n")
    compare_pair(a, b, "a:\n    b:\r\n        c: (x, (y, z))\r    ---\nend: a\r\n")
    compare_pair(a, b, "a: x; b: y, z\r\n# comment\rx: c.foo\n")
    compare_pair(a, b, "a:\n    x: (L\"unterminated\r\n")
    nul_source[0]: 120
    nul_source[1]: 58
    nul_source[2]: 0
    nul_source[3]: 99
    nul_source[4]: 10
    compare(a, nul_source, 5U)
    compare(b, 0, 0U)
    while: i < 16
        c.printf("scanner %d hits A=%d B=%d\n", i, hits(a, i), hits(b, i))
        i: i + 1
    require(test_successes > 10 && test_errors > 0, "corpus contains successful and diagnostic parses")
    i: 0
    while: i < 16
        require(hits(a, i) > 0 && hits(b, i) > 0, "all sixteen scanners reached by parsing")
        i: i + 1
    diagnostic_slices(a, b, "")
    diagnostic_slices(a, b, "'a'")
    diagnostic_slices(a, b, "L'a'")
    diagnostic_slices(a, b, "L\"a\"")
    diagnostic_slices(a, b, "xx\n'a")
    diagnostic_slices(a, b, "xx\rL'a")
    diagnostic_slices(a, b, "xx\r\nL\"a")
    diagnostic_slices(a, b, "'a\\\r\nb'")
    diagnostic_slices(a, b, "L'a\\\nb'")
    diagnostic_slices(a, b, "L'a\\\rb'")
    diagnostic_slices(a, b, "xx'\\''")
    c.printf("diagnostic wrapper slices=%d PASS\n", test_diagnostics)
    layout_bytes(a)
    layout_bytes(b)
    layout_slices(a, b, "")
    layout_slices(a, b, "x\ny\rz\r\nq")
    layout_slices(a, b, "\r\n\r\n")
    layout_slices(a, b, "\t x,;\n")
    layout_position(a, 0, 0U, 0U, 9U, 12U)
    layout_position(b, 0, 0U, 1U, 11U, 5U)
    c.printf("layout checks=%d PASS\n", test_layout)
    require(l2_c_scanners_parse_bytes(0, "", 0U, @ doc) = 1 && doc = 0, "null owner rejected")
    require(l2_c_scanners_parse_bytes(a, "", 0U, 0) = 1, "null out rejected")
    test_fail_node: 1
    require(l2_c_scanners_parse_bytes(failed_node, "x: c.foo\n", 9U, @ doc) = 1, "root allocation failure")
    require(test_fail_node = 0 && doc = 0 && c.lmx_msg_graph(failed_node) = 0, "failed root not published")
    compare(failed_node, "x: c.foo\n", 9U)
    test_fail_method: 1
    require(l2_c_scanners_parse_bytes(failed_method, "x: L'a'\n", 8U, @ doc) = 1, "method allocation failure")
    require(test_fail_method = 0 && doc = 0 && c.lmx_msg_graph(failed_method) = 0, "partial graph not published")
    compare(failed_method, "x: L'a'\n", 8U)
    track_owner(a)
    track_owner(b)
    track_owner(failed_node)
    track_owner(failed_method)
    require(test_tracked > 100, "graph lifetime coverage")
    c.lmx_msg_runtime_delete(rt)
    i: 0
    while: i < test_tracked
        require(test_frees[i] = 1, "graph resource not freed exactly once")
        i: i + 1
    c.printf("candidate scanner parity cases=%d freed=%d PASS\n", test_cases, test_tracked)
    require(test_spans > 100, "span traversal coverage")
    c.printf("node span comparisons=%d PASS\n", test_spans)
return: 0
