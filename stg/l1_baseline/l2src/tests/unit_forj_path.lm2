# CURRENT l2trans: unsupported loop.
# INTENDED L2: ordinary for Structure field j; parent reads for\j; last assigned 9.
# Probe surface is the established for: int(i, 0) (i < 10) i++ form, not compact for(...).
# P0 tree of int: j i is frame int(j, i); that is syntax/receiver separation, not a
# parser defect and not a rejection of the field model.
fn: test () int
    for: int(i, 0) (i < 10) i++
        int: j i
    end: for
    c.printf: "%d\n" for\j
    return: 0
end: test
fn: main () int
    return: test()
end: main
