include: "l2src/lmx.h" "l2src/lmx_message.h" "<stdio.h>" "<stdlib.h>" "<limits.h>"
predef: "l2src/lmx_branch_owned.h.lm1" "l2src/lmx_value_owned.h.lm1"

# Test-only linker wrapping. The generated program links the real Message core.
prototype:
    fn: l2_generated_main () int
    fn: __real_lmx_msg_runtime_new () @: LmxMsgRuntime
    fn: __real_lmx_msg_create (@: LmxMsgRuntime rt; LmxMsgAddr: parent; unsigned: id; const: @(uchar init); size_t: n; @: LmxMsgAddr out) int
    fn: __real_lmx_msg_find (@: LmxMsgRuntime rt; LmxMsgAddr: who) @: LmxMsg
    fn: __real_lmx_msg_set_graph (@: LmxMsg msg; @: Lmx unit) void
    fn: __real_lmx_msg_runtime_delete (@: LmxMsgRuntime rt) void
    fn: __real_malloc (size_t: n) @: void
    fn: __real_free (@: void p) void
    fn: __real_lmx_branch_open_owned (@: Lmx parent; size_t: children; @@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) int
    fn: __real_lmx_node_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: Lmx
    fn: __real_lmx_method_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: LmxMethod
    fn: __real_lmx_int_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: void
    fn: __real_lmx_size_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: void
end: prototype

int: test_mode 0
int: checks 0
int: news 0
int: creates 0
int: binds 0
int: deletes 0
int: alloc_failed 0
int: inside_branch 0
int: branch_fail_at 0
int: branch_alloc_attempts 0
int: branch_allocs 0
int: branch_frees 0
[]: uintptr_t branch_tracked 32
int: inside_value 0
int: value_attempts 0
int: value_allocs 0
int: value_frees 0
[]: uintptr_t value_tracked 32

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        c.printf("FAIL %s\n", label)
        c.exit(2)
    ---
end: check

fn: __wrap_lmx_msg_runtime_new () @: LmxMsgRuntime
    news: news + 1
    if: test_mode = 1
        return: 0
    return: c.__real_lmx_msg_runtime_new()

fn: __wrap_lmx_msg_create (@: LmxMsgRuntime rt; LmxMsgAddr: parent; unsigned: id; const: @(uchar init); size_t: n; @: LmxMsgAddr out) int
    check(news = 1 && creates = 0 && binds = 0, "one process runtime before create")
    check(rt != 0 && parent = 0U && id = 1U && init = 0 && n = 0U && out != 0, "root uses existing creation contract")
    if: test_mode = 2
        creates: creates + 1
        return: LMX_MSG_NOMEM
    int: result c.__real_lmx_msg_create(rt, parent, id, init, n, out)
    creates: creates + 1
    return: result

fn: __wrap_lmx_msg_find (@: LmxMsgRuntime rt; LmxMsgAddr: who) @: LmxMsg
    if: test_mode = 3
        return: 0
    return: c.__real_lmx_msg_find(rt, who)

sub: __wrap_lmx_msg_set_graph (@: LmxMsg msg; @: Lmx unit)
    check(news = 1 && creates = 1 && binds = 0 && deletes = 0, "binding occurs during live process entry")
    check(msg != 0 && unit != 0 && unit\node = 0 && unit\data != 0 && unit\len != 0U, "constructed lexical root retained unchanged")
    check(msg\blocks != 0 && msg\ranges != 0, "initial children admitted to Message storage")
    check(c.lmx_owned_ranges_find(msg\ranges, unit) != 0, "Message classifies its root occurrence")
    check(c.lmx_owned_ranges_find(msg\ranges, unit\data) != 0, "Message classifies its child block")
    c.__real_lmx_msg_set_graph(msg, unit)
    check(msg\graph = unit, "real Message stores exact graph root")
    binds: binds + 1
end: __wrap_lmx_msg_set_graph

sub: __wrap_lmx_msg_runtime_delete (@: LmxMsgRuntime rt)
    check(news = 1 && creates = 1 && deletes = 0 && rt != 0, "runtime deleted once after helper or create failure")
    if: binds != 0
        check(rt\root != 0 && rt\root\graph != 0, "bound graph still recorded at teardown")
        @: Lmx leaf c.lmx_branch_child_known(rt\root\graph, 0U)
        check(leaf != 0 && leaf\node = rt\root\graph, "callable lexical parent retained")
        if: test_mode != 5 && test_mode != 11
            @: LmxOwnedRange range c.lmx_owned_ranges_find(rt\root\ranges, leaf\data)
            check(range != 0 && range\kind = c.LMX_KIND_METHOD && range\type = c.LMX_TYPE_METHOD, "published method record classified by owner")
        ---
    ---
    deletes: deletes + 1
    c.__real_lmx_msg_runtime_delete(rt)
    check(branch_allocs = branch_frees, "teardown releases all owned branch allocations once")
    check(value_allocs = value_frees, "teardown releases all root and method allocations once")
end: __wrap_lmx_msg_runtime_delete

fn: __wrap_malloc (size_t: n) @: void
    @: void p
    int: index 0
    if: inside_value != 0
        value_attempts: value_attempts + 1
        if: alloc_failed = 0 && ((inside_value = 3 && test_mode >= 14 && test_mode <= 15 && value_attempts = test_mode - 13) || (inside_value = 4 && test_mode >= 16 && test_mode <= 17 && value_attempts = test_mode - 15))
            alloc_failed: 1
            return: 0
        ---
        if: (inside_value = 1 && ((test_mode = 9 && value_attempts = 1) || (test_mode = 10 && value_attempts = 2))) || (inside_value = 2 && ((test_mode = 5 && value_attempts = 1) || (test_mode = 11 && value_attempts = 2)))
            alloc_failed: 1
            return: 0
        ---
        p: c.__real_malloc(n)
        if: p != 0
            while: index < 32 && value_tracked[index] != 0U
                index: index + 1
            ---
            check(index < 32, "test typed allocation tracking capacity")
            value_tracked[index]: (cast: (uintptr_t) p)
            value_allocs: value_allocs + 1
        ---
        return: p
    ---
    if: inside_branch != 0
        branch_alloc_attempts: branch_alloc_attempts + 1
        if: branch_fail_at != 0 && branch_alloc_attempts = branch_fail_at
            alloc_failed: 1
            return: 0
        ---
        p: c.__real_malloc(n)
        if: p != 0
            while: index < 32 && branch_tracked[index] != 0U
                index: index + 1
            ---
            check(index < 32, "test allocation tracking capacity")
            branch_tracked[index]: (cast: (uintptr_t) p)
            branch_allocs: branch_allocs + 1
        ---
        return: p
    ---
    if: alloc_failed = 0 && creates != 0
        if: test_mode = 4 && binds = 0
            alloc_failed: 1
            return: 0
        ---
    ---
    return: c.__real_malloc(n)

sub: __wrap_free (@: void p)
    int: index 0
    if: p != 0
        while: index < 32
            if: value_tracked[index] = (cast: (uintptr_t) p)
                value_tracked[index]: 0U
                value_frees: value_frees + 1
                break
            ---
            index: index + 1
        ---
        index: 0
        while: index < 32
            if: branch_tracked[index] = (cast: (uintptr_t) p)
                branch_tracked[index]: 0U
                branch_frees: branch_frees + 1
                break
            ---
            index: index + 1
        ---
    ---
    c.__real_free(p)
end: __wrap_free

sub: value_admission_check (@: void value; size_t: stride; int: kind; int: type; @@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges; @: LmxMsgBlock old_blocks; @: LmxOwnedRange old_ranges)
    if: value = 0
        check(blocks[0] = old_blocks && ranges[0] = old_ranges, "failed typed construction preserves owner heads")
        return
    ---
    check(blocks[0] != old_blocks && blocks[0]\next = old_blocks, "typed block prepended without replacing prior storage")
    check(ranges[0] != old_ranges && ranges[0]\next = old_ranges, "typed range prepended without replacing prior metadata")
    check(ranges[0]\lo = value && ranges[0]\stride = stride && ranges[0]\kind = kind && ranges[0]\type = type, "typed range has exact address layout and tags")
    check((cast: (uintptr_t) value) % stride = (cast: (uintptr_t) blocks[0]\base) % stride, "typed offset preserves allocation alignment")
    check(c.lmx_owned_ranges_find(ranges[0], value) = ranges[0], "typed value found inside current owner")
end: value_admission_check

fn: __wrap_lmx_node_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: Lmx
    @: LmxMsgBlock old_blocks blocks[0]
    @: LmxOwnedRange old_ranges ranges[0]
    @: Lmx value
    inside_value: 1
    value_attempts: 0
    value: c.__real_lmx_node_new_owned(blocks, ranges)
    inside_value: 0
    value_admission_check((cast: (@: void) value), c.sizeof(c.Lmx), c.LMX_KIND_CHILDREN, c.LMX_TYPE_BRANCH, blocks, ranges, old_blocks, old_ranges)
    if: value != 0
        check(value\node = 0 && value\data = 0 && value\len = 0U, "fresh root initialized before caller publication")
    ---
    return: value

fn: __wrap_lmx_method_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: LmxMethod
    @: LmxMsgBlock old_blocks blocks[0]
    @: LmxOwnedRange old_ranges ranges[0]
    @: LmxMethod value
    inside_value: 2
    value_attempts: 0
    value: c.__real_lmx_method_new_owned(blocks, ranges)
    inside_value: 0
    value_admission_check((cast: (@: void) value), c.sizeof(c.LmxMethod), c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD, blocks, ranges, old_blocks, old_ranges)
    if: value != 0
        check(value\addr = 0 && value\sig = 0U, "fresh method initialized before caller publication")
    ---
    return: value

sub: value_contract ()
    @: LmxMsgBlock blocks 0
    @: LmxOwnedRange ranges 0
    @: LmxMsgBlock target_blocks 0
    @: LmxOwnedRange target_ranges 0
    @: Lmx unit
    @: LmxMethod method
    @: LmxOwnedRange invalid (cast: (@: LmxOwnedRange) c.malloc(c.sizeof(c.LmxOwnedRange)))
    @: LmxOwnedRange saved_range
    @: LmxMsgBlock saved_block
    check(invalid != 0, "test metadata allocated")
    check(c.__real_lmx_node_new_owned(0, @ ranges) = 0 && c.__real_lmx_method_new_owned(@ blocks, 0) = 0, "null typed owner slots rejected")
    check(blocks = 0 && ranges = 0, "null input leaves owner empty")
    unit: c.lmx_node_new_owned(@ blocks, @ ranges)
    check(unit != 0, "owned root constructed")
    saved_range: ranges
    saved_block: blocks
    invalid\lo: 0
    invalid\hi: 0
    invalid\stride: 0U
    invalid\kind: c.LMX_KIND_METHOD
    invalid\type: c.LMX_TYPE_METHOD
    invalid\next: ranges
    ranges: invalid
    check(c.lmx_method_new_owned(@ blocks, @ ranges) = 0, "malformed destination rejects typed admission")
    check(blocks = saved_block && ranges = invalid && invalid\next = saved_range, "rejected typed admission keeps existing owner intact")
    check(value_allocs - value_frees = 2, "rejected typed temporaries freed; root stays owned")
    ranges: saved_range
    method: c.lmx_method_new_owned(@ blocks, @ ranges)
    check(method != 0, "typed admission retries successfully")
    method\sig: 29U
    unit\data: (cast: (@: void) method)
    check(c.lmx_msg_storage_move_all(@ target_blocks, @ target_ranges, @ blocks, @ ranges) = c.LMX_MSG_STORAGE_OK, "typed storage transfers with existing owner operation")
    check(blocks = 0 && ranges = 0 && target_blocks != 0 && target_ranges != 0, "transfer empties prior owner and retains target lists")
    check(unit\node = 0 && unit\data = (cast: (@: void) method) && method\sig = 29U, "transfer preserves addresses lexical node and payload")
    check(c.lmx_owned_ranges_find(target_ranges, unit) != 0 && c.lmx_owned_ranges_find(target_ranges, method) != 0, "destination classifies transferred root and method")
    while: target_ranges != 0
        check(c.lmx_owned_ranges_remove(@ target_ranges, target_ranges) = c.LMX_OWNED_RANGES_OK, "retire typed range before payload")
    ---
    check(c.lmx_msg_blocks_dispose_all(@ target_blocks) = c.LMX_MSG_BLOCKS_OK, "release transferred typed storage")
    check(target_blocks = 0 && value_allocs = value_frees, "all typed allocations freed once")
    check(c.lmx_msg_blocks_dispose_all(@ target_blocks) = c.LMX_MSG_BLOCKS_OK, "repeat typed cleanup is empty")
    c.free(invalid)
end: value_contract

fn: __wrap_lmx_int_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: void
    @: LmxMsgBlock old_blocks blocks[0]
    @: LmxOwnedRange old_ranges ranges[0]
    @: void value
    int: zero 0
    inside_value: 3
    value_attempts: 0
    value: c.__real_lmx_int_new_owned(blocks, ranges)
    inside_value: 0
    value_admission_check(value, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT, blocks, ranges, old_blocks, old_ranges)
    if: value != 0
        check(c.lmx_int_value_known(value) = 0, "fresh int is zero")
    ---
    return: value

fn: __wrap_lmx_size_new_owned (@@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: void
    @: LmxMsgBlock old_blocks blocks[0]
    @: LmxOwnedRange old_ranges ranges[0]
    @: void value
    size_t: zero 0U
    inside_value: 4
    value_attempts: 0
    value: c.__real_lmx_size_new_owned(blocks, ranges)
    inside_value: 0
    value_admission_check(value, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_SIZE_T, blocks, ranges, old_blocks, old_ranges)
    if: value != 0
        check(c.lmx_size_value_known(value) = 0U, "fresh size_t is zero")
    ---
    return: value

sub: primitive_contract ()
    @: LmxMsgBlock blocks 0
    @: LmxOwnedRange ranges 0
    @: LmxMsgBlock target_blocks 0
    @: LmxOwnedRange target_ranges 0
    @: void a
    @: void b
    @: void count
    @: void saved
    @: int raw_int
    @: size_t raw_size
    check(c.__real_lmx_int_new_owned(0, @ ranges) = 0 && c.__real_lmx_size_new_owned(@ blocks, 0) = 0, "null primitive owner slots rejected")
    check(c.lmx_int_value_known(0) = 0 && c.lmx_size_value_known(0) = 0U, "null primitive reads keep existing zero result")
    check(c.lmx_int_store_known(0, 3) != 0 && c.lmx_size_store_known(0, 3U) != 0, "null primitive stores rejected")
    a: c.lmx_int_new_owned(@ blocks, @ ranges)
    if: test_mode = 14 || test_mode = 15
        check(a = 0 && alloc_failed = 1 && blocks = 0 && ranges = 0 && value_allocs = value_frees, "int OOM keeps owner empty and frees temporary storage")
        a: c.lmx_int_new_owned(@ blocks, @ ranges)
    ---
    check(a != 0, "int construction succeeds or retries")
    b: c.lmx_int_new_owned(@ blocks, @ ranges)
    check(b != 0 && b != a, "mutable int cells do not alias")
    count: c.lmx_size_new_owned(@ blocks, @ ranges)
    if: test_mode = 16 || test_mode = 17
        check(count = 0 && alloc_failed = 1 && value_allocs - value_frees = 4, "size_t OOM preserves two existing int cells")
        check(c.lmx_owned_ranges_find(ranges, a) != 0 && c.lmx_owned_ranges_find(ranges, b) != 0, "size_t OOM preserves prior ranges")
        count: c.lmx_size_new_owned(@ blocks, @ ranges)
    ---
    check(count != 0, "size_t construction succeeds or retries")
    saved: a
    check(c.lmx_int_store_known(a, c.INT_MIN) = 0 && c.lmx_int_value_known(a) = c.INT_MIN, "int lower bound retained")
    check(c.lmx_int_store_known(a, c.INT_MAX) = 0 && c.lmx_int_value_known(a) = c.INT_MAX, "int upper bound retained")
    check(a = saved && c.lmx_int_value_known(b) = 0, "stores retain address and independent second cell")
    raw_int: (cast: (@: int) a)
    raw_int[0]: -7
    check(c.lmx_int_value_known(a) = -7, "ordinary typed address sees actual int payload")
    check(c.lmx_size_store_known(count, (cast: (size_t) -1)) = 0 && c.lmx_size_value_known(count) = (cast: (size_t) -1), "size_t full width retained")
    raw_size: (cast: (@: size_t) count)
    raw_size[0]: 2147483648U
    check(c.lmx_size_value_known(count) = 2147483648U, "typed size_t address retains value above INT_MAX")
    check(c.lmx_msg_storage_move_all(@ target_blocks, @ target_ranges, @ blocks, @ ranges) = c.LMX_MSG_STORAGE_OK, "primitive storage uses existing transfer")
    check(blocks = 0 && ranges = 0 && c.lmx_owned_ranges_find(target_ranges, a) != 0 && c.lmx_owned_ranges_find(target_ranges, count) != 0, "new owner receives primitive ranges")
    check(c.lmx_int_value_known(a) = -7 && c.lmx_size_value_known(count) = 2147483648U, "transfer retains payloads and addresses")
    check(c.lmx_int_store_known(a, 9) = 0 && c.lmx_size_store_known(count, 11U) = 0, "transferred typed payloads stay writable without owner lookup")
    while: target_ranges != 0
        check(c.lmx_owned_ranges_remove(@ target_ranges, target_ranges) = c.LMX_OWNED_RANGES_OK, "primitive range retired before payload")
    ---
    check(c.lmx_msg_blocks_dispose_all(@ target_blocks) = c.LMX_MSG_BLOCKS_OK && value_allocs = value_frees, "all primitive allocations released exactly once")
    check(alloc_failed = (test_mode != 13), "expected primitive fault actually occurred")
end: primitive_contract

fn: __wrap_lmx_branch_open_owned (@: Lmx parent; size_t: children; @@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) int
    int: result
    @: LmxMsgBlock old_blocks blocks[0]
    @: LmxOwnedRange old_ranges ranges[0]
    @: void old_data parent\data
    size_t: old_len parent\len
    @: Lmx old_node parent\node
    size_t: index 0U
    @: Lmx child
    inside_branch: 1
    result: c.__real_lmx_branch_open_owned(parent, children, blocks, ranges)
    inside_branch: 0
    if: result != 0
        check(blocks[0] = old_blocks && ranges[0] = old_ranges, "failed admission preserves both destination heads")
        check(parent\node = old_node && parent\data = old_data && parent\len = old_len, "failed construction preserves parent")
        return: result
    ---
    check(blocks[0] != old_blocks && blocks[0]\next = old_blocks, "one block admitted without replacing old storage")
    check(ranges[0] != old_ranges && ranges[0]\next = old_ranges, "one range admitted without replacing old metadata")
    check(ranges[0]\lo = parent\data && ranges[0]\stride = c.sizeof(c.Lmx), "range describes exact typed child array")
    check(ranges[0]\kind = c.LMX_KIND_CHILDREN && ranges[0]\type = c.LMX_TYPE_BRANCH, "owned range has children domain")
    check((cast: (uintptr_t) parent\data) % c.sizeof(c.Lmx) = (cast: (uintptr_t) blocks[0]\base) % c.sizeof(c.Lmx), "child offset is a multiple of Lmx size")
    check(parent\node = old_node && parent\len = children, "success retains lexical parent and publishes length")
    while: index < children
        child: c.lmx_branch_child_known(parent, index)
        check(child != 0 && child\node = parent && child\len = 0U && child\data = 0, "new children initialized with actual lexical parent")
        check(c.lmx_owned_ranges_find(ranges[0], (cast: (@: void) child)) = ranges[0], "each child is classified inside owner")
        index: index + 1U
    ---
    return: 0

sub: branch_contract ()
    @: Lmx parent (cast: (@: Lmx) c.malloc(c.sizeof(c.Lmx)))
    @: Lmx second (cast: (@: Lmx) c.malloc(c.sizeof(c.Lmx)))
    @: LmxOwnedRange invalid (cast: (@: LmxOwnedRange) c.malloc(c.sizeof(c.LmxOwnedRange)))
    @: LmxMsgBlock blocks 0
    @: LmxOwnedRange ranges 0
    @: Lmx first
    @: LmxMsgBlock saved_block
    @: LmxOwnedRange saved_range
    int: result
    check(parent != 0 && second != 0 && invalid != 0, "test setup allocated")
    parent\node: 0
    parent\len: 0U
    parent\data: 0
    second\node: parent
    second\len: 0U
    second\data: 0
    check(c.__real_lmx_branch_open_owned(0, 2U, @ blocks, @ ranges) != 0, "null parent rejected")
    check(c.__real_lmx_branch_open_owned(parent, 2U, 0, @ ranges) != 0, "null owner rejected")
    check(c.lmx_branch_open_owned(parent, 0U, @ blocks, @ ranges) != 0, "zero children rejected")
    check(c.lmx_branch_open_owned(parent, (cast: (size_t) -1), @ blocks, @ ranges) != 0, "overflow rejected before allocation")
    check(branch_alloc_attempts = 0, "invalid shapes allocate nothing")
    check(c.lmx_branch_child_known(0, 0U) = 0 && c.lmx_branch_child_known(parent, 0U) = 0, "known accessor guards null and empty")
    check(c.lmx_branch_open_owned(parent, 2U, @ blocks, @ ranges) = 0, "first branch opened")
    first: c.lmx_branch_child_known(parent, 0U)
    check(c.lmx_branch_child_known(parent, 2U) = 0, "known accessor bounds checked")
    check(c.lmx_branch_open_owned(parent, 2U, @ blocks, @ ranges) != 0, "nonempty parent not overwritten")
    saved_block: blocks
    saved_range: ranges
    invalid\lo: 0
    invalid\hi: 0
    invalid\stride: 0U
    invalid\kind: c.LMX_KIND_CHILDREN
    invalid\type: c.LMX_TYPE_BRANCH
    invalid\next: ranges
    ranges: invalid
    result: c.lmx_branch_open_owned(second, 3U, @ blocks, @ ranges)
    check(result != 0 && blocks = saved_block && ranges = invalid && invalid\next = saved_range, "malformed destination rejects paired admission without mutation")
    check(branch_allocs - branch_frees = 2, "rejected prepared storage freed; first branch remains owned")
    ranges: saved_range
    check(c.lmx_branch_open_owned(second, 3U, @ blocks, @ ranges) = 0, "retry admits after invalid metadata removed")
    check(first = c.lmx_branch_child_known(parent, 0U) && first\node = parent, "growth never moves old child or rewrites node")
    check(second\node = parent, "independent branch creation preserves lexical hierarchy")
    while: ranges != 0
        check(c.lmx_owned_ranges_remove(@ ranges, ranges) = c.LMX_OWNED_RANGES_OK, "range retired before payload")
    ---
    check(c.lmx_msg_blocks_dispose_all(@ blocks) = c.LMX_MSG_BLOCKS_OK, "all owned blocks released")
    check(blocks = 0 && branch_allocs = branch_frees, "all successful and rejected allocations freed once")
    check(c.lmx_msg_blocks_dispose_all(@ blocks) = c.LMX_MSG_BLOCKS_OK, "repeat release sees empty owner")
    c.free(invalid)
    c.free(second)
    c.free(parent)
end: branch_contract

fn: main (int: argc; @@: char argv) int
    int: result
    check(argc = 2, "one mode argument")
    test_mode: c.atoi(argv[1])
    check(test_mode >= 0 && test_mode <= 17, "valid mode")
    if: test_mode >= 13
        primitive_contract()
        c.printf("root entry mode=%d checks=%d PASS\n", test_mode, checks)
        return: 0
    ---
    if: test_mode = 12
        value_contract()
        c.printf("root entry mode=%d checks=%d PASS\n", test_mode, checks)
        return: 0
    ---
    if: test_mode = 8
        branch_contract()
        c.printf("root entry mode=%d checks=%d PASS\n", test_mode, checks)
        return: 0
    ---
    if: test_mode = 6 || test_mode = 7
        branch_fail_at: test_mode - 5
    ---
    result: c.l2_generated_main()
    # unit_bool_and returns 1 after its method call. Failures also return 1;
    # counters distinguish actual entry and each failure boundary.
    check(result = 1 && news = 1, "program exit value preserved")
    if: test_mode = 1
        check(creates = 0 && binds = 0 && deletes = 0, "new failure has nothing to delete")
    else:
        check(creates = 1 && deletes = 1, "all other paths delete the runtime")
        if: test_mode = 0 || test_mode = 5 || test_mode = 11
            check(binds = 1, "expected graph binding")
        else:
            check(binds = 0, "failure precedes graph binding")
        ---
    ---
    if: test_mode = 4 || test_mode = 5 || test_mode = 6 || test_mode = 7 || test_mode = 9 || test_mode = 10 || test_mode = 11
        check(alloc_failed = 1, "allocation failure actually injected")
    else:
        check(alloc_failed = 0, "no allocation failure injected")
    ---
    c.printf("root entry mode=%d checks=%d PASS\n", test_mode, checks)
    return: 0
