predef: "l2src/tests/library_include_fn_nested.h.lm1"

# C functions declared one level down (in the header the predef'd .h.lm1
# includes) and two levels down (behind that header's own #include). Foreign C
# is spelled c.name and emitted as written; the translator reads no C header
# text to admit it, and the C compiler checks both declarations.

fn: l2_test_call_outer (int: x) int
    return: c.l2_test_outer_fn(x)
end: l2_test_call_outer

fn: l2_test_call_inner (int: x) int
    return: c.l2_test_inner_fn(x)
end: l2_test_call_inner
