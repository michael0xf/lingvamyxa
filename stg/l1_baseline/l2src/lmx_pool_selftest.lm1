predef: "l2src/lmx_pool.lm1"
include: "<stdio.h>"

# Checks the 2 service-entry table end to end: an entry handed out by a typed
# pool classifies as that pool's kind, from its address alone, and an Lmx cell
# holding the entry classifies identically. Nothing is stored on the cell to
# say what it holds.

[]: char chars_pool 4 65 66 67 68
[]: int backing 3 7 8 9

# A stand-in generated C entry. This unit stores its address in a method record
# and never calls it; invocation is 21.8 and a later unit. The body is not empty
# because an empty sub: body lowers to a prototype with no definition.
int: sample_calls 0

sub: sample_entry ()
    sample_calls: sample_calls + 1
end: sample_entry

fn: main () int
    @: LmxPool methods
    @: LmxPool arrays
    @: LmxPool chars_of
    @: LmxArrayDesc char_desc
    @: LmxMethod record
    @: LmxMethod second
    @: LmxMethod third
    @: LmxArrayDesc desc
    @: void slot
    int: failures
    size_t: cycle
    failures: 0

    if: lmx_ranges_init(8U) != 0
        c.printf("lmx: range table init failed\n")
        return: 1
    if: lmx_range_register((cast: (@: void) chars_pool), (cast: (@: void) (chars_pool + 4)), c.sizeof(chars_pool[0]), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) != 0
        c.printf("lmx: primitive pool registration failed\n")
        return: 1

    methods: (cast: (@: LmxPool) c.calloc(1U, c.sizeof(c.LmxPool)))
    arrays: (cast: (@: LmxPool) c.calloc(1U, c.sizeof(c.LmxPool)))
    chars_of: (cast: (@: LmxPool) c.calloc(1U, c.sizeof(c.LmxPool)))
    if: methods = 0 || arrays = 0 || chars_of = 0
        c.printf("lmx: pool header allocation failed\n")
        return: 1
    if: lmx_pool_open(methods, c.sizeof(c.LmxMethod), 2U, c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD) != 0
        c.printf("lmx: method pool open failed\n")
        return: 1
    if: lmx_pool_open(arrays, c.sizeof(c.LmxArrayDesc), 2U, c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_INT) != 0
        c.printf("lmx: array pool open failed\n")
        return: 1

    # 2 says N TYPED service arrays, and 6.5 spells out one per Array element
    # type. A second descriptor pool, same shape, different element type.
    if: lmx_pool_open(chars_of, c.sizeof(c.LmxArrayDesc), 2U, c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_CHAR) != 0
        c.printf("lmx: second array pool open failed\n")
        return: 1

    record: lmx_method_intern(methods, sample_entry, 1U)
    desc: lmx_array_desc_new(arrays, 3U, (cast: (@: void) backing))
    if: record = 0 || desc = 0
        c.printf("lmx: entry handout failed\n")
        return: 1

    # The whole claim of this unit: kind comes from the address, not the entry.
    if: lmx_classify(cast: (@: void) record) != c.LMX_KIND_METHOD
        c.printf("lmx: method record not classified as method\n")
        failures: failures + 1
    if: lmx_classify(cast: (@: void) desc) != c.LMX_KIND_ARRAY
        c.printf("lmx: array descriptor not classified as array\n")
        failures: failures + 1
    if: lmx_classify(cast: (@: void) (chars_pool + 1)) != c.LMX_KIND_PRIMITIVE
        c.printf("lmx: adding pools disturbed primitive classification\n")
        failures: failures + 1

    # The point of N being per type. Both descriptors are array descriptors and
    # read the same kind, yet the address alone tells which typed pool each came
    # from, with nothing stored in either to say so.
    char_desc: lmx_array_desc_new(chars_of, 2U, (cast: (@: void) chars_pool))
    if: char_desc = 0
        c.printf("lmx: char-array descriptor handout failed\n")
        return: 1
    if: lmx_classify(cast: (@: void) char_desc) != c.LMX_KIND_ARRAY
        c.printf("lmx: char-array descriptor is not an array\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) desc) != c.LMX_TYPE_ARRAY_OF_INT
        c.printf("lmx: int-array descriptor has the wrong type\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) char_desc) != c.LMX_TYPE_ARRAY_OF_CHAR
        c.printf("lmx: char-array descriptor has the wrong type\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) record) != c.LMX_TYPE_METHOD
        c.printf("lmx: method record has the wrong type\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) (chars_pool + 1)) != c.LMX_TYPE_CHAR
        c.printf("lmx: primitive cell has the wrong type\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) 0) != c.LMX_TYPE_NONE
        c.printf("lmx: null has a type\n")
        failures: failures + 1

    # A second entry from the same pool classifies the same and does not alias
    # the first. Both facts follow from the range, not from any stored tag.
    second: lmx_method_intern(methods, sample_entry, 2U)
    if: second = 0
        c.printf("lmx: second method record refused too early\n")
        failures: failures + 1
    if: second = record
        c.printf("lmx: pool handed out the same entry twice\n")
        failures: failures + 1
    if: lmx_classify(cast: (@: void) second) != c.LMX_KIND_METHOD
        c.printf("lmx: second method record not classified as method\n")
        failures: failures + 1

    # A non-const variable lives in the big array of its type, so the array
    # grows rather than refusing. It grows by adding a chunk, never by
    # reallocating, so every address handed out before the growth is still
    # valid and still classifies.
    third: lmx_method_intern(methods, sample_entry, 3U)
    if: third = 0
        c.printf("lmx: exhausted pool refused to grow\n")
        failures: failures + 1
    if: lmx_classify(cast: (@: void) third) != c.LMX_KIND_METHOD
        c.printf("lmx: entry from a new chunk is not classified\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) third) != c.LMX_TYPE_METHOD
        c.printf("lmx: entry from a new chunk lost its type\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) record) != c.LMX_TYPE_METHOD
        c.printf("lmx: growth invalidated an earlier entry\n")
        failures: failures + 1
    if: record\sig != 1U || second\sig != 2U || third\sig != 3U
        c.printf("lmx: growth disturbed the contents of earlier entries\n")
        failures: failures + 1
    if: lmx_pool_count(methods) != 3U
        c.printf("lmx: pool count wrong after growth\n")
        failures: failures + 1

    # 6.5 settles the descriptor's own len as element count, unlike the len in
    # the Lmx header, which this code still refuses to read.
    if: desc\len != 3U
        c.printf("lmx: descriptor length not preserved\n")
        failures: failures + 1
    if: desc\data != (cast: (@: void) backing)
        c.printf("lmx: descriptor storage pointer not preserved\n")
        failures: failures + 1

    # A child slot may hold the reference; the slot is not the entry, and
    # rebinding it changes only which entry that one field addresses.
    slot: (cast: (@: void) desc)
    if: lmx_classify(slot) != c.LMX_KIND_ARRAY
        c.printf("lmx: a slot holding a descriptor is not classified as array\n")
        failures: failures + 1
    slot: (cast: (@: void) record)
    if: lmx_classify(slot) != c.LMX_KIND_METHOD
        c.printf("lmx: the same slot holding a method record was not reclassified\n")
        failures: failures + 1
    if: lmx_classify((cast: (@: void) desc)) != c.LMX_KIND_ARRAY
        c.printf("lmx: rebinding the slot disturbed the descriptor entry\n")
        failures: failures + 1

    lmx_pool_release(methods)
    # Two method chunks removed, while both descriptor pools and static chars
    # remain registered. Never inspect or dereference a freed entry pointer.
    if: lmx_range_count != 3U
        c.printf("lmx: released method chunks remain registered\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) desc) != c.LMX_TYPE_ARRAY_OF_INT
        c.printf("lmx: unregister disturbed live int descriptors\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) char_desc) != c.LMX_TYPE_ARRAY_OF_CHAR
        c.printf("lmx: unregister disturbed live char descriptors\n")
        failures: failures + 1
    lmx_pool_release(arrays)
    lmx_pool_release(chars_of)
    c.free(chars_of)
    if: lmx_range_count != 1U
        c.printf("lmx: only static character range should remain\n")
        failures: failures + 1
    lmx_pool_release(methods)
    if: lmx_range_count != 1U
        c.printf("lmx: repeated release changed registry\n")
        failures: failures + 1

    # Repeated sequential allocations must not consume permanent range slots.
    cycle: 0U
    while: cycle < 32U
        if: lmx_pool_open(methods, c.sizeof(c.LmxMethod), 1U, c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD) != 0
            c.printf("lmx: registry exhausted after released pools cycle=%zu\n", cycle)
            failures: failures + 1
            break
        record: lmx_method_intern(methods, sample_entry, 9U)
        if: record = 0 || lmx_type_of(cast: (@: void) record) != c.LMX_TYPE_METHOD
            c.printf("lmx: reopened pool misclassified\n")
            failures: failures + 1
        lmx_pool_release(methods)
        cycle: cycle + 1U
    ---
    if: lmx_range_count != 1U
        c.printf("lmx: reopen cycles leaked registered ranges\n")
        failures: failures + 1
    if: lmx_range_unregister((cast: (@: void) chars_pool), (cast: (@: void) (chars_pool + 3))) = 0
        c.printf("lmx: partial range unregister should fail\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) (chars_pool + 1)) != c.LMX_TYPE_CHAR
        c.printf("lmx: failed unregister disturbed static range\n")
        failures: failures + 1
    if: lmx_range_unregister((cast: (@: void) chars_pool), (cast: (@: void) (chars_pool + 4))) != 0
        c.printf("lmx: exact range unregister failed\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) chars_pool) != c.LMX_TYPE_NONE || lmx_range_count != 0U
        c.printf("lmx: removed live storage still classified\n")
        failures: failures + 1
    if: lmx_range_unregister((cast: (@: void) chars_pool), (cast: (@: void) (chars_pool + 4))) = 0
        c.printf("lmx: duplicate unregister should fail\n")
        failures: failures + 1
    c.free(methods)
    c.free(arrays)
    lmx_ranges_release()

    if: failures != 0
        c.printf("lmx pool selftest FAILED checks=%d\n", failures)
        return: 1
    c.printf("lmx pool selftest ok\n")
    return: 0
