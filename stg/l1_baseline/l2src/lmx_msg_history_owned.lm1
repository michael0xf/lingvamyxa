predef: "l2src/lmx_msg_history_owned.h.lm1"
include: "l2src/lmx.h" "<stdlib.h>"

fn: lmx_msg_history_has (const: @(LmxMsgRoot head); @: void p) int
    while: head != 0
        if: head\p = p
            return: 1
        head: head\next
    ---
return: 0

fn: lmx_msg_history_kind (const: @(LmxOwnedRange rg)) int
return: rg != 0 && (rg\kind = LMX_KIND_ARRAY || rg\kind = LMX_KIND_CHILDREN || rg\kind = LMX_KIND_STRUCT)

sub: lmx_msg_history_dispose (@: LmxMsgRoot head)
    @: LmxMsgRoot next
    while: head != 0
        next: head\next
        c.free(head)
        head: next
    ---
end: lmx_msg_history_dispose

fn: lmx_msg_history_push (@@: LmxMsgRoot head; @: void p) int
    @: LmxMsgRoot node
    if: head = 0 || p = 0 || lmx_msg_history_has(head[0], p) != 0
        return: LMX_MSG_OK
    node: (cast: (@: LmxMsgRoot) c.malloc(c.sizeof(c.LmxMsgRoot)))
    if: node = 0
        return: LMX_MSG_NOMEM
    node\p: p
    node\roles: LMX_MSG_ROOT_HISTORY
    node\next: head[0]
    head[0]: node
return: LMX_MSG_OK

fn: lmx_msg_history_prepare (@: LmxMsg src; @@: LmxMsgRoot out) int
    @: LmxMsgRoot head 0
    @: LmxMsgRoot cur
    @: LmxOwnedRange rg
    if: out = 0
        return: LMX_MSG_INVALID
    out[0]: 0
    if: src = 0
        return: LMX_MSG_INVALID
    if: src\graph != 0
        rg: c.lmx_owned_ranges_find(src\ranges, src\graph)
        if: lmx_msg_history_kind(rg) != 0 && lmx_msg_history_push(@ head, src\graph) != LMX_MSG_OK
            lmx_msg_history_dispose(head)
            return: LMX_MSG_NOMEM
        ---
    ---
    cur: src\roots
    while: cur != 0
        if: cur\p != 0 && (cur\roles & LMX_MSG_ROOT_HISTORY) != 0U
            rg: c.lmx_owned_ranges_find(src\ranges, cur\p)
            if: lmx_msg_history_kind(rg) != 0 && lmx_msg_history_push(@ head, cur\p) != LMX_MSG_OK
                lmx_msg_history_dispose(head)
                return: LMX_MSG_NOMEM
            ---
        ---
        cur: cur\next
    ---
    out[0]: head
return: LMX_MSG_OK

sub: lmx_msg_history_commit (@: LmxMsg dst; @: LmxMsgRoot head)
    @: LmxMsgRoot next
    @: LmxMsgRoot have
    if: dst = 0
        lmx_msg_history_dispose(head)
        return
    while: head != 0
        next: head\next
        have: dst\roots
        while: have != 0 && have\p != head\p
            have: have\next
        ---
        if: have != 0
            have\roles: have\roles | LMX_MSG_ROOT_HISTORY
            c.free(head)
        else:
            head\roles: LMX_MSG_ROOT_HISTORY
            head\next: dst\roots
            dst\roots: head
        ---
        head: next
    ---
end: lmx_msg_history_commit
