# Clean-L2 source for l2src/lmx_msg_slots.lm1. Same ABI, same behaviour.
#
# Transitional allocation bookkeeping, NOT Message scheduling or address
# resolution. The caller owns a stable acyclic list and every record in it.
# No internal locking: the old _locked functions' caller obligation stands.
#
# Both operations are reads. The count is the owner's cached n, never a
# traversal, and the enumeration follows alloc_next only -- never root,
# first_child or next_sibling, which may point anywhere.
#
# The entry is a formality: the current emitter produces closed programs, so a
# module source still carries one. A reusable module emission mode is a later
# self-build boundary.

fn: slots_n (const: @(LmxMsgRuntime rt)) int
    if: rt = 0
        return: 0
    return: rt\n
end: slots_n

fn: slots_at (const: @(LmxMsgRuntime rt); int: i) LmxMsgAddr
    const: @(LmxMsg m)
    if: rt = 0 || i < 0
        return: 0U
    m: rt\slots
    while: m != 0 && i > 0
        m: m\alloc_next
        i: i - 1
    if: m = 0
        return: 0U
    return: m\addr
end: slots_at

fn: main () int
    return: 0
end: main
