include: "l2src/lmx.h"
predef: "l2src/lmx_msg_storage.h.lm1"

# Positive-length CHAR/INT arrays only. Not a source [] constructor or an
# empty-array representation choice. Descriptor and mutable backing are
# separate stable allocations; caller controls roots, shape and lifetime.
prototype:
    fn: lmx_array_new_positive_owned (int: type; size_t: count; @@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) @: LmxArrayDesc
end: prototype
