include: "l2src/lmx_message.h"
predef: "l2src/lmx_graph_copy_owned.h.lm1"

# Install a fresh used-graph copy into an exclusively held Message whose graph
# is still empty. Destination storage may already contain its immutable char
# table. The copier admits all new storage atomically; this wrapper publishes
# dest.graph only after that admission succeeds.
prototype:
    fn: lmx_msg_graph_copy_install (@: LmxMsg dest; @: Lmx source; @: LmxOwnedRange src_ranges; @: LmxOwnedRange eternal_ranges; @: char dst_chars) int
end: prototype
