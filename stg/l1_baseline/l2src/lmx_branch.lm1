predef: "l2src/lmx_chars.lm1"

# Child storage. Lingvamyxa_spec.txt 2, 19.20; ABI 3.3, 14.1, 14.22.
#
# A Structure's data addresses an ordered array of void * child pointers, and
# len is exactly their count, fixed at construction. There is deliberately no
# append: growing a Structure is not a thing that happens. A slot holds the
# address of its child's value in the typed array/range of that child's type;
# the address of the slot itself identifies nothing but slot storage.
#
# The block registers as one range of kind CHILDREN and type BRANCH, stride
# sizeof(void *), so a pointer into it classifies as slot storage the same way
# every other pointer is classified by its range.
#
# 19.20 gives the construction order this follows: allocate the slots with
# stable live addresses, then store each child's typed address into its slot.
# A nested Structure child carries its own header and its own node; this unit
# does not create one (see lmx_value_owned's lmx_struct_new_owned). Names are
# not involved at any point; a field is reached by its index, which the
# translator knows.
#
# This is the legacy global-range variant, kept for the Core suite. The
# Message-owned constructor is lmx_branch_owned.lm1, and copying a graph is
# lmx_graph_copy_owned.lm1; the old inline-header lmx_branch_copy is retired
# with the inline-child model and is not replaced here.

fn: lmx_branch_open (@: Lmx parent; size_t: children) int
    @@: void slots
    size_t: index
    if: parent = 0
        return: 1
    if: children = 0U
        return: 1
    if: children > ((cast: (size_t) -1) / c.sizeof(@: void))
        return: 1
    if: children > (cast: (size_t) 2147483647)
        return: 1
    slots: (cast: (@@: void) c.calloc(children, c.sizeof(@: void)))
    if: slots = 0
        return: 1
    if: lmx_range_register((cast: (@: void) slots), (cast: (@: void) (slots + children)), c.sizeof(@: void), c.LMX_KIND_CHILDREN, c.LMX_TYPE_BRANCH) != 0
        c.free(slots)
        return: 1
    index: 0U
    while: index < children
        slots[index]: 0
        index: index + 1U
    ---
    parent\data: (cast: (@: void) slots)
    parent\len: (cast: (int) children)
return: 0

sub: lmx_branch_release (@: Lmx parent)
    @@: void slots
    if: parent != 0
        if: parent\data != 0
            # Retire this slot array before freeing it; the objects the slots
            # address are not owned recursively by this operation.
            slots: (cast: (@@: void) parent\data)
            lmx_range_unregister(parent\data, (cast: (@: void) (slots + parent\len)))
            c.free(parent\data)
        ---
        parent\data: 0
        parent\len: 0
    ---
end: lmx_branch_release

# The address of a slot. The translator resolves a field name to this index;
# the runtime never sees a name. A store through the returned address rebinds
# that one child reference and never changes the field count (ABI 14.22).
fn: lmx_branch_slot (@: Lmx parent; size_t: index) @@: void
    if: parent = 0
        return: 0
    if: parent\data = 0
        return: 0
    if: lmx_type_of(parent\data) != c.LMX_TYPE_BRANCH
        return: 0
    if: parent\len < 0
        return: 0
    if: index >= (cast: (size_t) parent\len)
        return: 0
return: (cast: (@@: void) parent\data) + index

# The current child VALUE. Its type is whichever range this address falls in,
# which is never the range of the slot that holds it.
fn: lmx_branch_child (@: Lmx parent; size_t: index) @: void
    @@: void slot
    slot: lmx_branch_slot(parent, index)
    if: slot = 0
        return: 0
return: slot[0]

fn: lmx_branch_store (@: Lmx parent; size_t: index; @: void value) int
    @@: void slot
    slot: lmx_branch_slot(parent, index)
    if: slot = 0
        return: 1
    slot[0]: value
return: 0

# Only for a child the caller has already proven to be a Structure.
fn: lmx_branch_struct (@: Lmx parent; size_t: index) @: Lmx
return: (cast: (@: Lmx) lmx_branch_child(parent, index))

fn: lmx_branch_count (@: Lmx parent) size_t
    if: parent = 0
        return: 0U
    if: parent\data = 0
        return: 0U
    if: lmx_type_of(parent\data) != c.LMX_TYPE_BRANCH
        return: 0U
    if: parent\len < 0
        return: 0U
return: (cast: (size_t) parent\len)
