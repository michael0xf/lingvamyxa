@: FILE l2_out 0
const: @: char l2_src 0
# Where the generated L1 finds the runtime headers. The generated unit also
# predefs the module's OWN header by the path the caller gave, so a single
# working directory has to resolve both: a consumer outside stg/l1_baseline
# sets L2_RUNTIME_ROOT and everything else keeps the historical "l2src/".
const: @: char l2_rt_root "l2src/"
