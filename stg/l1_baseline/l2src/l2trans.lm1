fn: l2_dfs (int: u) int
    int: v 0
    if: l2_m_mark[u] = 1
        return: 1
    if: l2_m_mark[u] = 2
        return: 0
    l2_m_mark[u]: 1
    while: v < l2_m_n
        if: l2_m_edge[l2_edge_off(u, v)] != 0 && l2_dfs(v) != 0
            return: 1
        v: v + 1
