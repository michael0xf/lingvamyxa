# First and last field VALUE of a named Structure, walking by owner. A nested
# or reference field has no literal of its own and reads as zero, which is why
# the runtime content check only pins literal ends.
fn: l2_ns_first_value (int: ni) size_t
    int: k 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni
            return: l2_nsf_val[k]
        k: k + 1
    ---
return: 0U

fn: l2_ns_last_value (int: ni) size_t
    int: k 0
    size_t: v 0U
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni
            v: l2_nsf_val[k]
        k: k + 1
    ---
return: v

# Field KIND at each end of a named Structure: 0 size_t literal, 1 char literal,
# 2 inline nested Structure, 3 reference. Only kind 0 carries a size_t value the
# generated program can compare, so the ends of any other kind are left unpinned
# rather than compared against a value they do not hold.
fn: l2_ns_first_kind (int: ni) int
    int: k 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni
            return: l2_nsf_kind[k]
        k: k + 1
    ---
return: 0 - 1

fn: l2_ns_last_kind (int: ni) int
    int: k 0
    int: v 0 - 1
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni
            v: l2_nsf_kind[k]
        k: k + 1
    ---
return: v


# Rank of a unit-level declaration among unit-level declarations: nested
# entries interleave in the table but are not unit children.
fn: l2_ns_rank (int: ni) int
    int: i 0
    int: r 0
    while: i < ni
        if: l2_ns_parent[i] < 0 && l2_ns_eternal[i] < 0
            r: r + 1
        i: i + 1
    ---
return: r

fn: l2_ns_top_count () int
    int: i 0
    int: r 0
    while: i < l2_ns_n
        if: l2_ns_parent[i] < 0 && l2_ns_eternal[i] < 0
            r: r + 1
        i: i + 1
    ---
return: r

# Field index of a nested entry inside its parent, found by the field that
# refers to it; -1 for a unit-level entry.
fn: l2_ns_field_in_parent (int: ni) int
    int: par
    int: k 0
    int: slotix 0
    par: l2_ns_parent[ni]
    if: par < 0
        return: 0 - 1
    # Fields of one Structure are not contiguous: a nested body pushes its own
    # fields in between. Walk the whole table and count only this owner.
    slotix: 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = par
            if: l2_nsf_kind[k] = 2 && l2_nsf_ref[k] = ni
                return: slotix
            ---
            slotix: slotix + 1
        ---
        k: k + 1
    ---
return: 0 - 1


fn: l2_text_eq (const: @(LmP0Text text); const: @(char s)) int
    size_t: n
    if: text = 0 || s = 0
        return: 0
    n: c.strlen(s)
    if: text\data = 0
        return: n = 0U
return: text\length = n && c.memcmp(text\data, s, n) = 0

fn: l2_ignored (const: @(LmP0Node node)) int
    if: node = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_DISABLED
        return: 1
    if: (node\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX)) != 0U
        return: 1
return: 0

fn: l2_error (const: @(char path); const: @(LmP0Node node); const: @(char msg)) int
    size_t: line 1U
    size_t: column 1U
    if: node != 0 && node\span != 0
        line: node\span\line
        column: node\span\column
    if: path = 0
        path: ""
    c.fprintf(c.stderr, "l2trans error: %s:%zu:%zu: %s\n", path, line, column, msg)
    l2_diag_n: l2_diag_n + 1
    if: node != 0 && node\kind = c.LM_P0_NODE_ATOM && node\as != 0 && node\as\atom != 0
        c.fprintf(c.stderr, "l2trans detail: atom=%.*s\n", (cast: (int) node\as\atom\length), node\as\atom\data)
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\head != 0
        c.fprintf(c.stderr, "l2trans detail: frame=%.*s\n", (cast: (int) node\as\frame\head\length), node\as\frame\head\data)
return: 1

fn: l2_alloc_or (const: @(char path); const: @(LmP0Node at); const: @(char fallback)) int
    if: l2_alloc_err = 2
        return: l2_error(path, at, "size overflow")
    if: l2_alloc_err != 0
        return: l2_error(path, at, "out of memory")
return: l2_error(path, at, fallback)

fn: l2_xmalloc (size_t: n) @: void
    @: void p
    if: n = 0U
        return: 0
    if: l2_fail_left > 0
        l2_fail_left: l2_fail_left - 1
        if: l2_fail_left = 0
            l2_alloc_err: 1
            l2_alloc_fail_at: l2_alloc_n + 1
            l2_alloc_fail_kind: l2_alloc_kind
            return: 0
        ---
    p: c.malloc(n)
    if: p = 0
        l2_alloc_err: 1
        l2_alloc_fail_at: l2_alloc_n + 1
        l2_alloc_fail_kind: l2_alloc_kind
        return: 0
    l2_alloc_n: l2_alloc_n + 1
    l2_alloc_live: l2_alloc_live + 1
return: p

fn: l2_xfree (@: void p) int
    if: p = 0
        return: 0
    c.free(p)
    l2_free_n: l2_free_n + 1
    if: l2_alloc_live > 0
        l2_alloc_live: l2_alloc_live - 1
return: 0

fn: l2_prep_drop (@: char acts; @: char hides) int
    if: acts != 0
        l2_xfree((cast: (@: void) acts))
    if: hides != 0
        l2_xfree((cast: (@: void) hides))
return: 1

fn: l2_act_at (@: char base; int: i) @: char
    if: base = 0 || i < 0
        return: 0
return: base + (cast: (size_t) i) * 256U

fn: l2_release () int
    int: i 0
    unsigned: s 0U
    while: i < l2_m_cap
        l2_free_method(i)
        i: i + 1
    l2_meth_free()
    while: s < l2_intern_n
        if: l2_it_n[s] != 0
            l2_xfree((cast: (@: void) l2_it_n[s]))
        if: l2_it_nl[s] != 0
            l2_xfree((cast: (@: void) l2_it_nl[s]))
        if: l2_it_ty[s] != 0
            l2_xfree((cast: (@: void) l2_it_ty[s]))
        if: l2_it_hn[s] != 0
            l2_xfree((cast: (@: void) l2_it_hn[s]))
        if: l2_it_hnl[s] != 0
            l2_xfree((cast: (@: void) l2_it_hnl[s]))
        if: l2_it_hty[s] != 0
            l2_xfree((cast: (@: void) l2_it_hty[s]))
        l2_it_n[s]: 0
        l2_it_nl[s]: 0
        l2_it_ty[s]: 0
        l2_it_hn[s]: 0
        l2_it_hnl[s]: 0
        l2_it_hty[s]: 0
        s: s + 1U
    if: l2_it_ar != 0
        l2_xfree((cast: (@: void) l2_it_ar))
    if: l2_it_dyn != 0
        l2_xfree((cast: (@: void) l2_it_dyn))
    if: l2_it_ret != 0
        l2_xfree((cast: (@: void) l2_it_ret))
    if: l2_it_throws != 0
        l2_xfree((cast: (@: void) l2_it_throws))
    if: l2_it_n != 0
        l2_xfree((cast: (@: void) l2_it_n))
    if: l2_it_nl != 0
        l2_xfree((cast: (@: void) l2_it_nl))
    if: l2_it_ty != 0
        l2_xfree((cast: (@: void) l2_it_ty))
    if: l2_it_hn != 0
        l2_xfree((cast: (@: void) l2_it_hn))
    if: l2_it_hnl != 0
        l2_xfree((cast: (@: void) l2_it_hnl))
    if: l2_it_hty != 0
        l2_xfree((cast: (@: void) l2_it_hty))
    if: l2_m_throws != 0
        l2_xfree((cast: (@: void) l2_m_throws))
    l2_it_ar: 0
    l2_it_dyn: 0
    l2_it_ret: 0
    l2_it_throws: 0
    l2_it_n: 0
    l2_it_nl: 0
    l2_it_ty: 0
    l2_it_hn: 0
    l2_it_hnl: 0
    l2_it_hty: 0
    l2_m_throws: 0
    l2_intern_n: 0U
    l2_intern_cap: 0U
    l2_own_free()
    l2_scope_free()
    l2_indent_free()
    l2_pub_free()
    l2_for_free()
    l2_entry_free()
    l2_pd_free()
    l2_def_free()
    l2_cnt_free()
    l2_inc_free()
    l2_loc_free()
    l2_foreign_free()
return: 0

fn: l2_mul_ok (size_t: n; size_t: sz) int
    if: sz = 0U
        return: 1
    if: n > ((cast: (size_t) -1) / sz)
        return: 0
return: 1

fn: l2_mul3_ok (size_t: a; size_t: b; size_t: c) int
    size_t: p
    if: l2_mul_ok(a, b) = 0
        return: 0
    p: a * b
    if: l2_mul_ok(p, c) = 0
        return: 0
return: 1

fn: l2_own_off (int: mi; int: oi) size_t
    size_t: base
    size_t: cap
    size_t: idx
    if: mi < 0 || oi < 0 || l2_own_cap <= 0 || l2_m_cap <= 0 || mi >= l2_m_cap || oi >= l2_own_cap
        return: (cast: (size_t) -1)
    cap: (cast: (size_t) l2_own_cap)
    if: l2_mul_ok((cast: (size_t) mi), cap) = 0
        return: (cast: (size_t) -1)
    base: (cast: (size_t) mi) * cap
    idx: (cast: (size_t) oi)
    if: base + idx < base
        return: (cast: (size_t) -1)
return: base + idx

fn: l2_own_free () int
    if: l2_own_name != 0
        l2_xfree((cast: (@: void) l2_own_name))
    if: l2_own_ty != 0
        l2_xfree((cast: (@: void) l2_own_ty))
    if: l2_own_live != 0
        l2_xfree((cast: (@: void) l2_own_live))
    if: l2_own_mi != 0
        l2_xfree((cast: (@: void) l2_own_mi))
    if: l2_own_host != 0
        l2_xfree((cast: (@: void) l2_own_host))
    if: l2_own_decl != 0
        l2_xfree((cast: (@: void) l2_own_decl))
    if: l2_own_fid != 0
        l2_xfree((cast: (@: void) l2_own_fid))
    if: l2_own_fchild != 0
        l2_xfree((cast: (@: void) l2_own_fchild))
    if: l2_own_uchild != 0
        l2_xfree((cast: (@: void) l2_own_uchild))
    if: l2_m_uses != 0
        l2_xfree((cast: (@: void) l2_m_uses))
    if: l2_m_alias != 0
        l2_xfree((cast: (@: void) l2_m_alias))
    if: l2_m_pre != 0
        l2_xfree((cast: (@: void) l2_m_pre))
    if: l2_own_count != 0
        l2_xfree((cast: (@: void) l2_own_count))
    l2_own_count: 0
    l2_own_name: 0
    l2_own_ty: 0
    l2_own_live: 0
    l2_own_mi: 0
    l2_own_host: 0
    l2_own_decl: 0
    l2_own_fid: 0
    l2_own_fchild: 0
    l2_own_uchild: 0
    l2_m_uses: 0
    l2_m_alias: 0
    l2_m_pre: 0
    l2_own_n: 0
    l2_own_cap: 0
return: 0

fn: l2_own_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: rows
    size_t: psz
    size_t: nb
    size_t: ni
    size_t: nmeta
    size_t: oldcap
    size_t: off
    size_t: noff
    int: mi
    int: oi
    @@: LmP0Text nn 0
    @@: LmP0Text nc 0
    @: int nt 0
    @: int nl 0
    @: int nmi 0
    @@: LmP0Node nh 0
    @@: LmP0Node nd 0
    @: int nfid 0
    @: int nfch 0
    @: int nuch 0
    @: int nu 0
    @: int na 0
    @: int np 0
    if: need < 0
        return: 1
    if: need <= l2_own_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_own_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX) && need_u > (cast: (size_t) c.INT_MAX)
        l2_alloc_err: 2
        return: 1
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: need_u
    rows: 1U
    if: l2_m_cap > 0
        rows: (cast: (size_t) l2_m_cap)
    if: l2_mul_ok(rows, cap) = 0
        l2_alloc_err: 2
        return: 1
    nmeta: rows * cap
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(nmeta, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nc: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nt: (cast: (@: int) l2_xmalloc(ni))
    nl: (cast: (@: int) l2_xmalloc(ni))
    nmi: (cast: (@: int) l2_xmalloc(ni))
    nh: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nd: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nfid: (cast: (@: int) l2_xmalloc(ni))
    nfch: (cast: (@: int) l2_xmalloc(ni))
    nuch: (cast: (@: int) l2_xmalloc(ni))
    nu: (cast: (@: int) l2_xmalloc(nmeta * c.sizeof(c.int)))
    na: (cast: (@: int) l2_xmalloc(nmeta * c.sizeof(c.int)))
    np: (cast: (@: int) l2_xmalloc(nmeta * c.sizeof(c.int)))
    if: nn = 0 || nc = 0 || nt = 0 || nl = 0 || nmi = 0 || nh = 0 || nd = 0 || nfid = 0 || nfch = 0 || nuch = 0 || nu = 0 || na = 0 || np = 0
        if: nc != 0
            l2_xfree((cast: (@: void) nc))
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        if: nl != 0
            l2_xfree((cast: (@: void) nl))
        if: nmi != 0
            l2_xfree((cast: (@: void) nmi))
        if: nh != 0
            l2_xfree((cast: (@: void) nh))
        if: nd != 0
            l2_xfree((cast: (@: void) nd))
        if: nfid != 0
            l2_xfree((cast: (@: void) nfid))
        if: nfch != 0
            l2_xfree((cast: (@: void) nfch))
        if: nuch != 0
            l2_xfree((cast: (@: void) nuch))
        if: nu != 0
            l2_xfree((cast: (@: void) nu))
        if: na != 0
            l2_xfree((cast: (@: void) na))
        if: np != 0
            l2_xfree((cast: (@: void) np))
        return: 1
    c.memset((cast: (@: void) nn), 0, nb)
    c.memset((cast: (@: void) nc), 0, nb)
    c.memset((cast: (@: void) nt), 0, ni)
    c.memset((cast: (@: void) nl), 0, ni)
    c.memset((cast: (@: void) nh), 0, nb)
    c.memset((cast: (@: void) nd), 0, nb)
    oi: 0
    while: oi < (cast: (int) cap)
        nmi[oi]: -1
        nfid[oi]: -1
        nfch[oi]: -1
        nuch[oi]: -1
        oi: oi + 1
    c.memset((cast: (@: void) nu), 0, nmeta * c.sizeof(c.int))
    c.memset((cast: (@: void) np), 0, nmeta * c.sizeof(c.int))
    mi: 0
    while: mi < (cast: (int) rows)
        oi: 0
        while: oi < (cast: (int) cap)
            off: (cast: (size_t) mi) * cap
            off: off + (cast: (size_t) oi)
            na[off]: -1
            oi: oi + 1
        mi: mi + 1
    oldcap: (cast: (size_t) l2_own_cap)
    if: oldcap != 0U && l2_own_name != 0
        oi: 0
        while: oi < l2_own_n
            nn[oi]: l2_own_name[oi]
            nc[oi]: l2_own_count[oi]
            nt[oi]: l2_own_ty[oi]
            nl[oi]: l2_own_live[oi]
            nmi[oi]: l2_own_mi[oi]
            nh[oi]: l2_own_host[oi]
            nd[oi]: l2_own_decl[oi]
            nfid[oi]: l2_own_fid[oi]
            nfch[oi]: l2_own_fchild[oi]
            nuch[oi]: l2_own_uchild[oi]
            oi: oi + 1
        mi: 0
        while: mi < l2_m_cap
            oi: 0
            while: oi < l2_own_n
                off: (cast: (size_t) mi) * oldcap
                off: off + (cast: (size_t) oi)
                noff: (cast: (size_t) mi) * cap
                noff: noff + (cast: (size_t) oi)
                nu[noff]: l2_m_uses[off]
                na[noff]: l2_m_alias[off]
                np[noff]: l2_m_pre[off]
                oi: oi + 1
            mi: mi + 1
        l2_xfree((cast: (@: void) l2_own_name))
        l2_xfree((cast: (@: void) l2_own_count))
        l2_xfree((cast: (@: void) l2_own_ty))
        l2_xfree((cast: (@: void) l2_own_live))
        l2_xfree((cast: (@: void) l2_own_mi))
        l2_xfree((cast: (@: void) l2_own_host))
        l2_xfree((cast: (@: void) l2_own_decl))
        l2_xfree((cast: (@: void) l2_own_fid))
        l2_xfree((cast: (@: void) l2_own_fchild))
        l2_xfree((cast: (@: void) l2_own_uchild))
        l2_xfree((cast: (@: void) l2_m_uses))
        l2_xfree((cast: (@: void) l2_m_alias))
        l2_xfree((cast: (@: void) l2_m_pre))
    l2_own_name: nn
    l2_own_count: nc
    l2_own_ty: nt
    l2_own_live: nl
    l2_own_mi: nmi
    l2_own_host: nh
    l2_own_decl: nd
    l2_own_fid: nfid
    l2_own_fchild: nfch
    l2_own_uchild: nuch
    l2_m_uses: nu
    l2_m_alias: na
    l2_m_pre: np
    l2_own_cap: (cast: (int) cap)
return: 0

fn: l2_edge_off (int: a; int: b) size_t
    size_t: cap
    size_t: base
    if: a < 0 || b < 0 || l2_m_cap <= 0 || a >= l2_m_cap || b >= l2_m_cap
        return: (cast: (size_t) -1)
    cap: (cast: (size_t) l2_m_cap)
    if: l2_mul_ok((cast: (size_t) a), cap) = 0
        return: (cast: (size_t) -1)
    base: (cast: (size_t) a) * cap
    if: base + (cast: (size_t) b) < base
        return: (cast: (size_t) -1)
return: base + (cast: (size_t) b)

fn: l2_slot_off (int: mi; int: si) size_t
    size_t: base
    if: mi < 0 || si < 0 || si >= l2_slot_cap || l2_m_cap <= 0 || mi >= l2_m_cap
        return: (cast: (size_t) -1)
    if: l2_mul_ok((cast: (size_t) mi), (cast: (size_t) l2_slot_cap)) = 0
        return: (cast: (size_t) -1)
    base: (cast: (size_t) mi) * (cast: (size_t) l2_slot_cap)
    if: base + (cast: (size_t) si) < base
        return: (cast: (size_t) -1)
return: base + (cast: (size_t) si)

# Grow the per-method address-slot matrix transactionally. Four is only the
# first allocation size; source semantics have no slot-count limit.
fn: l2_slot_reserve (int: need) int
    size_t: cap
    size_t: oldcap
    size_t: rows
    size_t: count
    size_t: psz
    size_t: off
    size_t: noff
    @@: LmP0Text names 0
    @: int types 0
    int: i
    int: j
    if: need < 0 || l2_m_cap <= 0
        return: 1
    if: need <= l2_slot_cap
        return: 0
    cap: (cast: (size_t) l2_slot_cap)
    if: cap < 1U
        cap: 4U
    while: cap < (cast: (size_t) need)
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: (cast: (size_t) need)
    rows: (cast: (size_t) l2_m_cap)
    if: l2_mul_ok(rows, cap) = 0
        l2_alloc_err: 2
        return: 1
    count: rows * cap
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok(count, psz) = 0 || l2_mul_ok(count, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    l2_alloc_kind: 6
    names: (cast: (@@: LmP0Text) l2_xmalloc(count * psz))
    types: (cast: (@: int) l2_xmalloc(count * c.sizeof(c.int)))
    if: names = 0 || types = 0
        if: names != 0
            l2_xfree((cast: (@: void) names))
        if: types != 0
            l2_xfree((cast: (@: void) types))
        return: 1
    c.memset((cast: (@: void) names), 0, count * psz)
    c.memset((cast: (@: void) types), 0, count * c.sizeof(c.int))
    oldcap: (cast: (size_t) l2_slot_cap)
    i: 0
    # A method being collected occupies row l2_m_n until collection finishes,
    # so copy every allocated row rather than only committed methods.
    while: i < l2_m_cap
        j: 0
        while: j < l2_m_sn[i]
            off: (cast: (size_t) i) * oldcap + (cast: (size_t) j)
            noff: (cast: (size_t) i) * cap + (cast: (size_t) j)
            names[noff]: l2_sn[off]
            types[noff]: l2_st[off]
            j: j + 1
        i: i + 1
    if: l2_sn != 0
        l2_xfree((cast: (@: void) l2_sn))
    if: l2_st != 0
        l2_xfree((cast: (@: void) l2_st))
    l2_sn: names
    l2_st: types
    l2_slot_cap: (cast: (int) cap)
return: 0

fn: l2_meth_free () int
    if: l2_m_name != 0
        l2_xfree((cast: (@: void) l2_m_name))
    if: l2_m_f0 != 0
        l2_xfree((cast: (@: void) l2_m_f0))
    if: l2_m_f1 != 0
