                if: c.fprintf(l2_out, "    l2_q%d: (cast: (", k) < 0 || l2_emit_own_pointer_type(l2_out, l2_own_ty[k]) != 0 || c.fprintf(l2_out, ") lmx_pointer_value_known(l2_q%d_from[0]))\n", k) < 0
                    c.fclose(l2_out)
