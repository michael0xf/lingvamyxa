        return: 2
    c.memcpy(dest + at, t\data + base_end, t\length - base_end)
    at: at + t\length - base_end
    dest[at]: 0
return: 0

fn: l2_index_head (const: @(LmP0Text t); int: mi; @: int out_j) int
    size_t: i
    size_t: lb
    size_t: n
    int: j
    int: k
    int: ok 0
    if: t = 0 || t\data = 0 || out_j = 0
        return: 1
    n: t\length
    if: n < 4U
        return: 1
    if: t\data[n - 1U] != 93
        return: 1
    i: 0U
    lb: n
    while: i < n
        if: t\data[i] = 91
            lb: i
        i: i + 1U
    if: lb = n || lb = 0U
        return: 1
    if: lb + 1U >= n - 1U
        return: 2
    if: mi < 0
        k: 0
