                    c.fclose(l2_out)
                    return: 1
                if: l2_own_ty[oi] = 7 && c.fprintf(l2_out, "        slot[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_SIZE_T, %zuU, @ process_message\\blocks, @ process_message\\ranges)\n", l2_literal_value(l2_own_count[oi])) < 0
                    c.fclose(l2_out)
                    return: 1
                if: l2_own_ty[oi] = 37 && c.fprintf(l2_out, "        slot[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_ULONG, %zuU, @ process_message\\blocks, @ process_message\\ranges)\n", l2_literal_value(l2_own_count[oi])) < 0
                    c.fclose(l2_out)
                    return: 1
                if: l2_own_ty[oi] = 8 && c.fprintf(l2_out, "        slot[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR, %zuU, @ process_message\\blocks, @ process_message\\ranges)\n", l2_literal_value(l2_own_count[oi])) < 0
                    c.fclose(l2_out)
                    return: 1
                if: l2_own_ty[oi] >= 2000 && c.fprintf(l2_out, "        slot[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + %d, %zuU, @ process_message\\blocks, @ process_message\\ranges)\n", l2_own_ty[oi] - 2000, l2_literal_value(l2_own_count[oi])) < 0
                    c.fclose(l2_out)
                    return: 1
                if: c.fputs("        if: slot[0] = 0\n            return: 1\n", l2_out) < 0
                    c.fclose(l2_out)
                    return: 1
            ---
            oi: oi + 1
        ---
        k: k + 1
    ---
    i: 0
    while: i < l2_m_n
        # The callable's own Structure already exists; slot 0 takes the shared
        # descriptor, so the call passes that Structure and never the container.
        # The same record is also referenced from the root descriptor array.
        if: i = 0 && c.fprintf(l2_out, "        l2_methods: lmx_array_ref_new_positive_owned(c.LMX_TYPE_ARRAY_OF_METHOD, %uU, @ process_message\\blocks, @ process_message\\ranges)\n        if: l2_methods = 0\n            return: 1\n        l2_method_refs: (cast: (@@: LmxMethod) l2_methods\\data)\n", (cast: (unsigned) l2_m_n)) < 0
            c.fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        leaf: lmx_branch_struct_known(unit, %uU)\n        if: leaf = 0\n            return: 1\n", (cast: (unsigned) (l2_unit_base + i))) < 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs("        rec: lmx_method_new_owned(@ process_message\\blocks, @ process_message\\ranges)\n        if: rec = 0\n            return: 1\n        rec\\addr: (cast: (LmxEntry) ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            c.fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, ")\n        rec\\sig: %uU\n        if: lmx_branch_store_known(leaf, 0U, (cast: (@: void) rec)) != 0\n            return: 1\n        if: c.lmx_msg_bootstrap_method_admit(process_message, (cast: (@: void) rec)) != 0\n            return: 1\n        if: lmx_owned_ranges_find(c.lmx_msg_method_ranges(process_message), (cast: (@: void) rec)) = 0\n            return: 1\n        l2_method_refs[%uU]: rec\n        if: rec\\sig != %uU\n            return: 1\n", l2_m_sig[i], (cast: (unsigned) i), l2_m_sig[i]) < 0
            c.fclose(l2_out)
            return: 1
        i: i + 1
    # The eternal branches. Each root is built with node = 0, which is what
    # independent means. It then gets TWO references and neither reparents it:
    # an ordinary declaration-site child of the unit graph, and an entry in the
    # separate retention array, which never holds a descriptor (SPEC 9.1.4).
    if: l2_ebr_n != 0 && c.fprintf(l2_out, "        l2_branches: lmx_array_ref_new_positive_owned(c.LMX_TYPE_ARRAY_OF_LMX, %uU, @ process_message\\blocks, @ process_message\\ranges)\n        if: l2_branches = 0\n            return: 1\n        l2_branch_refs: (cast: (@@: Lmx) l2_branches\\data)\n", (cast: (unsigned) l2_ebr_n)) < 0
        c.fclose(l2_out)
        return: 1
    # Separation, checked by the generated program itself: ordinary graph
    # storage must never classify as eternal, or the metadata would admit the
    # whole graph as a terminal and a copy would silently share it.
    # Ordinary named Structures. Entries are created in table order, which puts
    # every parent before its nested entries. A unit-level entry is a child of
    # the unit; a nested one is built in place as a child of its parent, whose
    # pointer is already in l2_nsp, and its node is that parent. Leaf fields
    # are filled as they are met; references are wired in a second pass, so a
    # reference can only name an EARLIER unit-level declaration, which the
    # collector already guarantees.
    k: 0
    while: k < l2_ns_n
        if: l2_ns_parent[k] < 0 && l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        l2_nsp[%d]: lmx_struct_new_owned(unit, @ process_message\\blocks, @ process_message\\ranges)\n", k) < 0
            c.fclose(l2_out)
            return: 1
        # A qualified root has NO lexical parent: that is what independent
        # means. The generated program checks it before and after the
        # declaration-site store.
        if: l2_ns_parent[k] < 0 && l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        l2_nsp[%d]: lmx_node_new_owned(@ process_message\\blocks, @ process_message\\ranges)\n        if: l2_nsp[%d] = 0\n            return: 1\n        if: l2_nsp[%d]\\node != 0\n            return: 1\n", k, k, k) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_ns_parent[k] >= 0 && c.fprintf(l2_out, "        l2_nsp[%d]: lmx_struct_new_owned(l2_nsp[%d], @ process_message\\blocks, @ process_message\\ranges)\n", k, l2_ns_parent[k]) < 0
            c.fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        if: l2_nsp[%d] = 0\n            return: 1\n        if: lmx_branch_open_owned(l2_nsp[%d], %uU, @ process_message\\blocks, @ process_message\\ranges) != 0\n            return: 1\n", k, k, (cast: (unsigned) l2_ns_count[k])) < 0
            c.fclose(l2_out)
            return: 1
        # Every owned typed range reachable inside a qualified branch is
        # admitted through the Message classifier. No per-node flag, no
        # name, no registry: the admitted RANGE is the metadata.
        if: l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        if: lmx_owned_ranges_find(process_message\\ranges, (cast: (@: void) l2_nsp[%d])) = 0\n            return: 1\n        if: c.lmx_msg_bootstrap_eternal_admit(process_message, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n        if: lmx_owned_ranges_find(c.lmx_msg_eternal_ranges(process_message), (cast: (@: void) l2_nsp[%d])) = 0\n            return: 1\n", k, k, k) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_ns_parent[k] < 0 && l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        if: lmx_branch_store_known(unit, %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", (cast: (unsigned) (l2_ns_base + l2_ns_rank(k))), k) < 0
            c.fclose(l2_out)
            return: 1
        # TWO references to a qualified root and no more: the declaration
        # site in the unit graph, and one entry of the fixed retention
        # array. Neither reparents it.
        if: l2_ns_parent[k] < 0 && l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        l2_branch_refs[%uU]: l2_nsp[%d]\n        if: lmx_branch_store_known(unit, %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n        if: l2_nsp[%d]\\node != 0\n            return: 1\n        l2_ebr%u: l2_nsp[%d]\n", (cast: (unsigned) l2_ns_eternal[k]), k, (cast: (unsigned) (l2_unit_base + l2_m_n + 2 + l2_ns_eternal[k])), k, k, (cast: (unsigned) l2_ns_eternal[k]), k) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_ns_parent[k] >= 0 && c.fprintf(l2_out, "        if: lmx_branch_store_known(l2_nsp[%d], %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n        if: l2_nsp[%d]\\node != l2_nsp[%d]\n            return: 1\n", l2_ns_parent[k], (cast: (unsigned) l2_ns_field_in_parent(k)), k, k, l2_ns_parent[k]) < 0
            c.fclose(l2_out)
            return: 1
        oi: 0
        fx: 0
        while: fx < l2_nsf_n
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 0 && c.fprintf(l2_out, "        slot: lmx_branch_slot_known(l2_nsp[%d], %uU)\n        if: slot = 0\n            return: 1\n        slot[0]: lmx_size_new_owned(@ process_message\\blocks, @ process_message\\ranges)\n        if: slot[0] = 0\n            return: 1\n        if: lmx_size_store_known(slot[0], %zuU) != 0\n            return: 1\n", k, (cast: (unsigned) oi), l2_nsf_val[fx]) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_ns_eternal[k] >= 0 && l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 0 && c.fprintf(l2_out, "        if: c.lmx_msg_bootstrap_eternal_admit(process_message, slot[0]) != 0\n            return: 1\n        if: lmx_owned_ranges_find(c.lmx_msg_eternal_ranges(process_message), slot[0]) = 0\n            return: 1\n") < 0
                c.fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 1 && c.fprintf(l2_out, "        slot: lmx_branch_slot_known(l2_nsp[%d], %uU)\n        if: slot = 0\n            return: 1\n        slot[0]: lmx_char_cell_known(process_chars, %d)\n        if: slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi), (cast: (int) l2_nsf_val[fx])) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_ns_eternal[k] >= 0 && l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 1 && c.fprintf(l2_out, "        if: c.lmx_msg_bootstrap_eternal_admit(process_message, slot[0]) != 0\n            return: 1\n        if: lmx_owned_ranges_find(c.lmx_msg_eternal_ranges(process_message), slot[0]) = 0\n            return: 1\n") < 0
                c.fclose(l2_out)
                return: 1
            # An ARRAY field: one record plus its backing, both owned by the
            # Message. The copier already classifies them by address, so
            # nothing here is special to arrays beyond building them.
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 5 && l2_nsf_ref[fx] = 0 && c.fprintf(l2_out, "        slot: lmx_branch_slot_known(l2_nsp[%d], %uU)\n        if: slot = 0\n            return: 1\n        slot[0]: (cast: (@: void) lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, %zuU, @ process_message\\blocks, @ process_message\\ranges))\n        if: slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi), l2_nsf_val[fx]) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 5 && l2_nsf_ref[fx] = 1 && c.fprintf(l2_out, "        slot: lmx_branch_slot_known(l2_nsp[%d], %uU)\n        if: slot = 0\n            return: 1\n        slot[0]: (cast: (@: void) lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, %zuU, @ process_message\\blocks, @ process_message\\ranges))\n        if: slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi), l2_nsf_val[fx]) < 0
                c.fclose(l2_out)
                return: 1
            # Inside a qualified branch BOTH ranges are admitted: the record
            # and the backing it addresses.
            if: l2_ns_eternal[k] >= 0 && l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 5 && c.fprintf(l2_out, "        if: c.lmx_msg_bootstrap_eternal_admit(process_message, slot[0]) != 0\n            return: 1\n        if: (cast: (@: LmxArrayDesc) slot[0])\\data != 0 && c.lmx_msg_bootstrap_eternal_admit(process_message, (cast: (@: LmxArrayDesc) slot[0])\\data) != 0\n            return: 1\n        if: lmx_owned_ranges_find(c.lmx_msg_eternal_ranges(process_message), slot[0]) = 0\n            return: 1\n") < 0
                c.fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k
                oi: oi + 1
            ---
            fx: fx + 1
        ---
        k: k + 1
    ---
    # Second phase of construction: every entry already exists, so a reference
    # field may point anywhere -- forward, at its own declaration, around a
    # mutual cycle, or at a nested entry. Storing a reference does NOT reparent
    # the target, so the generated program checks the target's node against the
    # lexical parent it was built with: the unit for a unit-level declaration,
    # its own parent for a nested one.
    k: 0
    while: k < l2_ns_n
        oi: 0
        fx: 0
        while: fx < l2_nsf_n
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && c.fprintf(l2_out, "        if: lmx_branch_store_known(l2_nsp[%d], %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", k, (cast: (unsigned) oi), l2_nsf_ref[fx]) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_parent[l2_nsf_ref[fx]] < 0 && l2_ns_eternal[l2_nsf_ref[fx]] < 0 && c.fprintf(l2_out, "        if: l2_nsp[%d]\\node != unit\n            return: 1\n", l2_nsf_ref[fx]) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_parent[l2_nsf_ref[fx]] < 0 && l2_ns_eternal[l2_nsf_ref[fx]] >= 0 && c.fprintf(l2_out, "        if: l2_nsp[%d]\\node != 0\n            return: 1\n", l2_nsf_ref[fx]) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_parent[l2_nsf_ref[fx]] >= 0 && c.fprintf(l2_out, "        if: l2_nsp[%d]\\node != l2_nsp[%d]\n            return: 1\n", l2_nsf_ref[fx], l2_ns_parent[l2_nsf_ref[fx]]) < 0
                c.fclose(l2_out)
                return: 1
            # A CALLABLE field stores that method own Structure, the unit child
            # at l2_unit_base + mi. Storing it does not reparent it either, so
            # its node is checked the same way. merge then deep-copies it like
            # any other Structure, sharing only the descriptor at slot 0.
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 4 && c.fprintf(l2_out, "        if: lmx_branch_store_known(l2_nsp[%d], %uU, (cast: (@: void) lmx_branch_struct_known(unit, %uU))) != 0\n            return: 1\n        if: lmx_branch_struct_known(unit, %uU)\\node != unit\n            return: 1\n", k, (cast: (unsigned) oi), (cast: (unsigned) (l2_unit_base + l2_nsf_ref[fx])), (cast: (unsigned) (l2_unit_base + l2_nsf_ref[fx]))) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k
                oi: oi + 1
            ---
            fx: fx + 1
        ---
        k: k + 1
    ---
    if: l2_ebr_n != 0 && c.fprintf(l2_out, "        if: lmx_branch_store_known(unit, %uU, (cast: (@: void) l2_branches)) != 0\n            return: 1\n        if: l2_branches\\len != %uU\n            return: 1\n        if: lmx_owned_ranges_find(c.lmx_msg_eternal_ranges(process_message), (cast: (@: void) unit)) != 0\n            return: 1\n        if: lmx_owned_ranges_find(c.lmx_msg_eternal_ranges(process_message), (cast: (@: void) l2_branches)) != 0\n            return: 1\n        if: lmx_owned_ranges_find(c.lmx_msg_eternal_ranges(process_message), (cast: (@: void) l2_methods)) != 0\n            return: 1\n", (cast: (unsigned) (l2_unit_base + l2_m_n + 1)), (cast: (unsigned) l2_ebr_n)) < 0
        c.fclose(l2_out)
        return: 1
    # Publish the finished descriptor array into the first Message's graph. The
    # set is complete here and nothing appends to it afterwards.
    if: c.fprintf(l2_out, "        if: lmx_branch_store_known(unit, %uU, (cast: (@: void) l2_methods)) != 0\n            return: 1\n        if: l2_methods\\len != %uU\n            return: 1\n", (cast: (unsigned) (l2_unit_base + l2_m_n)), (cast: (unsigned) l2_m_n)) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "        if: %uU != %uU\n            return: 1\n", l2_intern_again, l2_sigv) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_m_arity[0] != 0 && c.fprintf(l2_out, "        if: %zuU = 0U\n            return: 1\n", l2_m_f0[0]\length) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("        # Closed-unit devirtualization: translator-bound child indices, no graph mutations after construction. rec.addr is METHOD-domain storage, not the call. Runtime does not memcmp formals. Evaluation order of actuals is materialized into temps before each call boundary. Hidden through-args, when present, follow declared formals in intern name order.\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    l2_tn: 0
    l2_call_node: "unit"
    l2_unit_ref: "unit"
    l2_cur_mi: 0 - 1
    k: 0
    while: k < l2_for_n
        if: l2_for_owner(k) < 0 && c.fprintf(l2_out, "        @: Lmx l2_h%d 0\n        l2_h%d: l2_b%d\n        if: l2_h%d = 0\n            return: 1\n", k, k, k, k) < 0
            c.fclose(l2_out)
            return: 1
        k: k + 1
    ---
    if: l2_own_n != 0 && c.fputs("        @@: void l2_xp 0\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_emit_body(l2_main_body, -1, "        ") != 0
        c.fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && c.fputs("        return: 0\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_main_node != 0 && l2_main_node\as != 0 && l2_emit_ret_tr(-1, "        ", l2_ret_tr(l2_main_node\as\frame)) != 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("    end: l2_program_entry\nend: external\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_library_mode != 0
        if: l2_emit_library_wrappers() != 0
            c.fclose(l2_out)
            return: 1
        ---
    else:
        if: c.fputs("external:\n    fn: main (", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_entry_n != 0 && c.fputs("int: argc; @@: char argv", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs(") int\n        @: LmxMsgRuntime process_runtime c.lmx_msg_runtime_new()\n        @: LmxMsg process_message 0\n        unsigned: process_addr 0U\n        int: process_result 1\n        if: process_runtime = 0\n            return: 1\n        if: c.lmx_msg_create(process_runtime, 0U, 1U, 0, 0U, @ process_addr) = c.LMX_MSG_OK\n            process_message: c.lmx_msg_find(process_runtime, process_addr)\n            if: process_message != 0\n                process_result: l2_program_entry(process_message", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_entry_n != 0 && c.fputs(", argc, argv", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs(")\n            ---\n        ---\n        c.lmx_msg_runtime_delete(process_runtime)\n        return: process_result\n    end: main\nend: external\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
    ---
    if: c.fclose(l2_out) != 0
        c.remove(l2_pub_tmp)
        return: 1
    bseq: 0U
    chk: c.fopen(l2_pub_bak, "rb")
    while: chk != 0
        c.fclose(chk)
        if: bseq = (cast: (size_t) -1)
            c.remove(l2_pub_tmp)
            return: 1
        bseq: bseq + 1U
        if: c.snprintf(l2_pub_bak, l2_pub_bak_cap, "%s.bak.%zu", out_path, bseq) < 0
            c.remove(l2_pub_tmp)
            return: 1
        chk: c.fopen(l2_pub_bak, "rb")
    ---
    chk: c.fopen(out_path, "rb")
    if: chk != 0
        had: 1
        c.fclose(chk)
    if: had != 0 && c.rename(out_path, l2_pub_bak) != 0
        c.remove(l2_pub_tmp)
        return: 1
    if: c.rename(l2_pub_tmp, out_path) != 0
        if: had != 0 && c.rename(l2_pub_bak, out_path) != 0
            c.fprintf(c.stderr, "l2trans error: publication failed; dest unrestored; backup at %s\n", l2_pub_bak)
            return: 1
        return: 1
    if: had != 0
        c.remove(l2_pub_bak)
return: 0

external:
    fn: main (int: argc; @@: char argv) int
        int: r
        @: FILE af
        const: @: char lg
        const: @: char rt
        c.setvbuf(c.stdout, 0, c._IONBF, 0)
        c.setvbuf(c.stderr, 0, c._IONBF, 0)
        if: argc != 3
            c.fputs("usage: l2trans.exe <source.lm2> <output.lm1>\n", c.stderr)
            return: 1
        rt: c.getenv("L2_RUNTIME_ROOT")
        if: rt != 0 && rt[0] != 0
            l2_rt_root: rt
        if: c.getenv("L2_FAIL_MALLOC") != 0
            l2_fail_left: c.atoi(c.getenv("L2_FAIL_MALLOC"))
        r: l2_translate(argv[1], argv[2])
        # A failure that printed no located diagnostic is still a failure the
        # user must see; a silent exit 1 names nothing to fix.
        if: r != 0 && l2_diag_n = 0
            c.fprintf(c.stderr, "l2trans error: %s: translation failed with no located diagnostic\n", argv[1])
        l2_release()
        lg: c.getenv("L2_ALLOC_LOG")
        if: lg != 0
            af: c.fopen(lg, "wb")
            if: af != 0
                c.fprintf(af, "n=%d free=%d live=%d fail_at=%d fail_kind=%d err=%d\n", l2_alloc_n, l2_free_n, l2_alloc_live, l2_alloc_fail_at, l2_alloc_fail_kind, l2_alloc_err)
                c.fclose(af)
            ---
        ---
    return: r
end: external
