        ---
    if: mi >= 0
        k: 0
        while: k < l2_own_n
            if: l2_own_mi[k] = mi && (l2_own_host[k] = 0 || l2_scope_has(l2_own_host[k])) && l2_own_name[k] != 0 && l2_own_name[k]\length = n - lb - 2U && c.memcmp(l2_own_name[k]\data, t\data + lb + 1U, n - lb - 2U) = 0 && (l2_own_ty[k] = 0 || l2_own_ty[k] = 1 || l2_own_ty[k] = 2 || l2_own_ty[k] = 3 || l2_own_ty[k] = 36)
                ok: 1
            k: k + 1
        ---
        k: 0
        while: k < l2_ml_n
            if: l2_ml_nm[k] != 0 && l2_ml_nm[k]\length = n - lb - 2U && c.memcmp(l2_ml_nm[k]\data, t\data + lb + 1U, n - lb - 2U) = 0 && (l2_ml_ty[k] = 0 || l2_ml_ty[k] = 1 || l2_ml_ty[k] = 2 || l2_ml_ty[k] = 3 || l2_ml_ty[k] = 10 || l2_ml_ty[k] = 34)
                ok: 1
            k: k + 1
        ---
        k: 0
        while: k < l2_m_arity[mi]
            if: l2_fn(mi, k) != 0 && l2_fn(mi, k)\length = n - lb - 2U && c.memcmp(l2_fn(mi, k)\data, t\data + lb + 1U, n - lb - 2U) = 0 && (l2_ft(mi, k) = 0 || l2_ft(mi, k) = 1 || l2_ft(mi, k) = 2 || l2_ft(mi, k) = 3 || l2_ft(mi, k) = 10 || l2_ft(mi, k) = 34 || l2_ft(mi, k) = 36)
                ok: 1
            if: l2_fn(mi, k) != 0 && l2_ft(mi, k) >= 100 && n - lb - 2U > l2_fn(mi, k)\length + 1U && c.memcmp(l2_fn(mi, k)\data, t\data + lb + 1U, l2_fn(mi, k)\length) = 0 && t\data[lb + 1U + l2_fn(mi, k)\length] = 92
                ok: 1
            k: k + 1
