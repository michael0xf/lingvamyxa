predef: "l1src/parser.lm1"
include: "<stdio.h>" "<string.h>" "<limits.h>" "<stdlib.h>"

# L2 -> L1 frontend: §1.7 main adapter, plus two-int no-throw methods under §21.8.

int: l2_leaf_mode 0
unsigned: l2_sigv 0U
unsigned: l2_intern_n 0U
unsigned: l2_intern_again 0U
unsigned: l2_intern_swap 0U
unsigned: l2_intern_probe 0U
int: l2_m_n 0
int: l2_own_n 0
int: l2_tn 0
int: l2_loop_depth 0
const: @: char l2_call_node 0
@: FILE l2_out 0
const: @: char l2_src 0
@: LmP0Structure l2_main_body 0

c.array: [8]: @: LmP0Text l2_m_name
c.array: [8]: @: LmP0Text l2_m_f0
c.array: [8]: @: LmP0Text l2_m_f1
c.array: [8]: @: LmP0Node l2_m_node
c.array: [8]: @: LmP0Node l2_m_body
c.array: [8]: unsigned l2_m_sig
c.array: [8]: int l2_m_mark
c.array: [8]: int l2_m_arity
c.array: [8]: int l2_m_dyn
c.array: [8]: int l2_m_ret
c.array: [8]: int l2_m_own
c.array: [32]: int l2_m_uses
c.array: [32]: int l2_m_alias
c.array: [32]: int l2_m_pre
c.array: [32]: @: LmP0Text l2_m_dn
c.array: [32]: int l2_m_dt
c.array: [4]: int l2_own_live
c.array: [4]: @: LmP0Text l2_own_name
c.array: [4]: int l2_own_ty
int: l2_need_p0 0
int: l2_need_query 0
int: l2_need_own 0
c.array: [8]: int l2_m_sn
c.array: [32]: @: LmP0Text l2_sn
c.array: [32]: int l2_st
c.array: [32]: @: LmP0Text l2_m_fn
c.array: [32]: int l2_m_ft
c.array: [64]: int l2_m_edge
c.array: [16]: int l2_it_ar
c.array: [16]: int l2_it_dyn
c.array: [64]: @: char l2_it_n
c.array: [64]: size_t l2_it_nl
c.array: [64]: int l2_it_ty
c.array: [64]: @: char l2_it_hn
c.array: [64]: size_t l2_it_hnl
c.array: [64]: int l2_it_hty
c.array: [256]: char l2_tok

prototype:
    fn: l2_collect_method (const: @(LmP0Node fn_node); const: @(char path)) int
    fn: l2_parse_unit (const: @(LmP0Node main_node); const: @(char path)) int
    fn: l2_emit_unit (const: @(char out_path)) int
    fn: l2_check_expr (const: @(LmP0Node node); int: mi; const: @(char path)) int
    fn: l2_check_fields (@: LmP0Field field; int: n; int: mi; const: @(char path); const: @(LmP0Node at)) int
    fn: l2_check_body (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth) int
    fn: l2_dfs (int: u) int
    fn: l2_prep (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    fn: l2_cat (@: char dest; const: @(char src)) int
    fn: l2_tok_temp (int: k; @: char dest) int
    fn: l2_tok_formal (int: mi; int: fi; @: char dest) int
    fn: l2_hidden_from (int: mi; int: callee; int: k; const: @(char ind); @: char dest) int
    fn: l2_emit_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    fn: l2_eval_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    fn: l2_eval_and (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    fn: l2_eval_cond (@: LmP0Field field; int: n; int: mi; const: @(char ind); const: @(char dest)) int
    fn: l2_fields_has_call (@: LmP0Field field; int: n) int
    fn: l2_node_has_call (const: @(LmP0Node node)) int
    fn: l2_advance (@: LmP0Field f; int: k) @: LmP0Field
    fn: l2_emit_expr (const: @(LmP0Node node); int: mi; const: @(char ind)) int
    fn: l2_emit_body (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    fn: l2_emit_checkpoint (int: mi; const: @(char ind)) int
    fn: l2_own_find (const: @(LmP0Text t)) int
    fn: l2_own_add (const: @(LmP0Text t); int: ty; const: @(char path); const: @(LmP0Node at)) int
    fn: l2_formal_find (int: mi; const: @(LmP0Text t)) int
    fn: l2_param_find (int: mi; const: @(LmP0Text t)) int
    fn: l2_dyn_find (int: mi; const: @(LmP0Text t)) int
    fn: l2_bind_own (int: mi; int: oi; const: @(char path); const: @(LmP0Node at)) int
    fn: l2_dyn_analyze (const: @(char path)) int
    fn: l2_dyn_local (const: @(char path)) int
    fn: l2_dyn_close (const: @(char path)) int
    fn: l2_dyn_step (const: @(char path); @: int changed) int
    fn: l2_dyn_typed (const: @(char path)) int
    fn: l2_scan_fields (@: LmP0Field field; int: n; int: mi; int: seen) int
    fn: l2_scan_node (const: @(LmP0Node node); int: mi; int: seen) int
    fn: l2_scan_body (const: @(LmP0Structure body); int: mi; @: int seen) int
    fn: l2_dyn_add (int: mi; const: @(LmP0Text t); int: ty) int
    fn: l2_collect_decls (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth; @: int sn) int
    fn: l2_slash_own (const: @(LmP0Text t)) int
    fn: l2_is_char_decl (const: @(LmP0Node stmt)) int
    fn: l2_own_decl_ty (const: @(LmP0Node stmt)) int
    fn: l2_slot_decl_ty (const: @(LmP0Node stmt)) int
    fn: l2_slot_find (int: mi; const: @(LmP0Text t)) int
    fn: l2_is_known (const: @(LmP0Text t)) int
    fn: l2_raw_head (const: @(LmP0Text t); int: mi; @: int out_j; @: int out_fld) int
    fn: l2_index_head (const: @(LmP0Text t); int: mi; @: int out_j) int
end: prototype

fn: l2_text_eq (const: @(LmP0Text text); const: @(char s)) int
    size_t: n
    if: text = 0 || s = 0
        return: 0
    n: c.strlen(s)
    if: text\data = 0
        return: n = 0U
return: text\length = n && c.memcmp(text\data, s, n) = 0

fn: l2_ignored (const: @(LmP0Node node)) int
    if: node = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_DISABLED
        return: 1
    if: (node\flags & c.LM_P0_NODE_INACTIVE) != 0U
        return: 1
return: 0

fn: l2_error (const: @(char path); const: @(LmP0Node node); const: @(char msg)) int
    size_t: line 1U
    size_t: column 1U
    if: node != 0 && node\span != 0
        line: node\span\line
        column: node\span\column
    if: path = 0
        path: ""
    c.fprintf(c.stderr, "l2trans error: %s:%zu:%zu: %s\n", path, line, column, msg)
return: 1

fn: l2_path_is_lm2 (const: @(char path)) int
    size_t: n
    if: path = 0
        return: 0
    n: c.strlen(path)
    if: n < 4U
        return: 0
    if: path[n - 4U] != 46
        return: 0
    if: path[n - 3U] != 108 && path[n - 3U] != 76
        return: 0
    if: path[n - 2U] != 109 && path[n - 2U] != 77
        return: 0
    if: path[n - 1U] != 50
        return: 0
return: 1

fn: l2_next_active (@: LmP0Field field) @: LmP0Field
    while: field != 0 && l2_ignored(field\value)
        field: field\next
return: field

fn: l2_count_active (const: @(LmP0Structure body)) int
    @: LmP0Field field
    int: n 0
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        n: n + 1
        field: l2_next_active(field\next)
return: n

fn: l2_write_sym (@: FILE out; int: i) int
    if: out = 0
        return: 1
    if: c.fprintf(out, "l2_m%d", i) < 0
        return: 1
return: 0

fn: l2_tok_sym (int: i; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_m%d", i) < 0
        return: 1
return: 0

fn: l2_digits (const: @(LmP0Text text)) int
    size_t: i
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    if: text\length > 1U && text\data[0] = 48
        return: 0
    i: 0U
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

fn: l2_num (const: @(LmP0Text text)) int
    size_t: n
    size_t: i
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    n: text\length
    if: text\data[n - 1U] = 85 || text\data[n - 1U] = 117
        n: n - 1U
    if: n = 0U
        return: 0
    if: n > 1U && text\data[0] = 48
        return: 0
    i: 0U
    while: i < n
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

fn: l2_int_fits (const: @(LmP0Text text)) int
    size_t: i
    int: acc 0
    int: d 0
    int: q
    int: r
    if: l2_digits(text) = 0
        return: 0
    q: c.INT_MAX / 10
    r: c.INT_MAX % 10
    i: 0U
    while: i < text\length
        d: text\data[i] - 48
        if: acc > q
            return: 0
        if: acc = q && d > r
            return: 0
        acc: acc * 10 + d
        i: i + 1U
return: 1

fn: l2_end_named (const: @(LmP0Frame frame); const: @(char name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(field\value\as\atom, name)

fn: l2_frame_head (const: @(LmP0Node node); const: @(char name)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 0
return: l2_text_eq(node\as\frame\head, name)

fn: l2_empty_struct (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_STRUCTURE || node\as = 0
        return: 0
return: l2_count_active(node\as\structure) = 0

fn: l2_quoted (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length < 2U
        return: 0
    if: t\data[0] != 34 || t\data[t\length - 1U] != 34
        return: 0
    if: t\length >= 6U && t\data[1] = 34 && t\data[2] = 34
        return: 0
return: 1

fn: l2_write_text (@: FILE out; const: @(LmP0Text t)) int
    if: out = 0 || t = 0 || t\data = 0
        return: 1
    if: t\length = 0U
        return: 0
    if: c.fwrite(t\data, 1U, t\length, out) != t\length
        return: 1
return: 0

fn: l2_check_puts (const: @(LmP0Node stmt); const: @(char path)) int
    const: @: LmP0Frame fr
    @: LmP0Field arg
    int: n
    if: l2_frame_head(stmt, "c.puts") = 0
        return: l2_error(path, stmt, "unsupported body")
    fr: stmt\as\frame
    if: fr\trailer != 0
        return: l2_error(path, stmt, "unsupported body")
    if: fr\body = 0
        return: l2_error(path, stmt, "unsupported argument")
    if: fr\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    n: l2_count_active(fr\body)
    if: n = 0
        return: l2_error(path, stmt, "unsupported argument")
    if: n != 1
        return: l2_error(path, stmt, "extra argument")
    arg: l2_next_active(fr\body\first_field)
    if: arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, stmt, "unsupported argument")
    if: l2_quoted(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "unsupported argument")
return: 0

fn: l2_take_return_stmt (const: @(LmP0Node stmt); const: @(char path); @@: LmP0Text out_lit) int
    const: @: LmP0Frame ret
    @: LmP0Field arg
    if: out_lit = 0
        return: l2_error(path, stmt, "internal: missing return slot")
    out_lit[0]: 0
    if: l2_frame_head(stmt, "return") = 0
        return: l2_error(path, stmt, "unsupported body")
    ret: stmt\as\frame
    if: ret\trailer != 0
        return: l2_error(path, stmt, "unsupported body")
    if: ret\body = 0 || l2_count_active(ret\body) != 1
        return: l2_error(path, stmt, "unsupported body")
    if: ret\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    arg: l2_next_active(ret\body\first_field)
    if: arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, stmt, "unsupported body")
    if: l2_digits(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "unsupported body")
    if: l2_int_fits(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "return literal not representable as int")
    out_lit[0]: arg\value\as\atom
return: 0

fn: l2_take_body (const: @(LmP0Node body_node); const: @(char path); @@: LmP0Text out_lit) int
    @: LmP0Field field
    @: LmP0Field nxt
    const: @: LmP0Node stmt
    if: out_lit = 0
        return: l2_error(path, body_node, "internal: missing return slot")
    out_lit[0]: 0
    if: body_node = 0 || body_node\kind != c.LM_P0_NODE_STRUCTURE || body_node\as = 0
        return: l2_error(path, body_node, "unsupported body")
    field: l2_next_active(body_node\as\structure\first_field)
    if: field = 0
        return: l2_error(path, body_node, "unsupported body")
    while: field != 0
        stmt: field\value
        nxt: l2_next_active(field\next)
        if: nxt = 0
            return: l2_take_return_stmt(stmt, path, out_lit)
        if: l2_frame_head(stmt, "return")
            return: l2_error(path, stmt, "unsupported body")
        if: l2_check_puts(stmt, path) != 0
            return: 1
        field: nxt
return: l2_error(path, body_node, "unsupported body")

fn: l2_take_main_lit (const: @(LmP0Node fn_node); const: @(char path); @@: LmP0Text out_lit; @@: LmP0Structure out_body) int
    @: LmP0Field field
    const: @: LmP0Frame fn_frame
    const: @: LmP0Node name
    const: @: LmP0Node params
    const: @: LmP0Node resty
    const: @: LmP0Node body
    if: out_body = 0
        return: l2_error(path, fn_node, "internal: missing body slot")
    out_body[0]: 0
    if: l2_frame_head(fn_node, "fn") = 0
        return: l2_error(path, fn_node, "unsupported body")
    fn_frame: fn_node\as\frame
    if: l2_end_named(fn_frame, "main") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fn_frame\body = 0 || l2_count_active(fn_frame\body) != 4
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(fn_frame\body\first_field)
    name: field\value
    if: name = 0 || name\kind != c.LM_P0_NODE_ATOM || l2_text_eq(name\as\atom, "main") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    params: field\value
    if: l2_empty_struct(params) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    resty: field\value
    if: resty = 0 || resty\kind != c.LM_P0_NODE_ATOM || l2_text_eq(resty\as\atom, "int") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: field\value
    if: l2_take_body(body, path, out_lit) != 0
        return: 1
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, fn_node, "unsupported body")
    out_body[0]: body\as\structure
return: 0

fn: l2_unit_from_root (const: @(LmP0Node root); const: @(char path); @@: LmP0Structure out_unit) int
    @: LmP0Field field
    const: @: LmP0Node item
    if: out_unit = 0
        return: l2_error(path, root, "internal: missing unit slot")
    out_unit[0]: 0
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE || root\as = 0 || root\as\structure = 0
        return: l2_error(path, root, "unsupported body")
    field: l2_next_active(root\as\structure\first_field)
    if: field = 0
        return: l2_error(path, root, "missing main")
    item: field\value
    if: l2_next_active(field\next) = 0 && l2_frame_head(item, "L2")
        if: l2_end_named(item\as\frame, "L2") = 0
            return: l2_error(path, item, "unsupported body")
        if: item\as\frame\body = 0
            return: l2_error(path, item, "missing main")
        out_unit[0]: item\as\frame\body
        return: 0
    if: l2_frame_head(item, "L1") || l2_frame_head(item, "L3")
        return: l2_error(path, item, "unsupported body")
    out_unit[0]: root\as\structure
return: 0

fn: l2_translate_unit (const: @(LmP0Structure unit); const: @(char path); @@: LmP0Text out_lit; @@: LmP0Structure out_body) int
    @: LmP0Field field
    @: LmP0Field nf
    @: LmP0Node item
    int: mains 0
    int: extras 0
    int: is_main 0
    @: LmP0Node main_node 0
    int: i
    if: out_lit = 0 || out_body = 0
        return: l2_error(path, 0, "internal: missing return slot")
    out_lit[0]: 0
    out_body[0]: 0
    l2_leaf_mode: 0
    l2_m_n: 0
    l2_own_n: 0
    l2_loop_depth: 0
    l2_need_p0: 0
    l2_need_query: 0
    l2_need_own: 0
    l2_intern_n: 0U
    l2_src: path
    i: 0
    while: i < 64
        l2_m_edge[i]: 0
        i: i + 1
    i: 0
    while: i < 32
        l2_m_uses[i]: 0
        l2_m_alias[i]: -1
        l2_m_pre[i]: 0
        l2_m_dt[i]: 0
        l2_m_dn[i]: 0
        i: i + 1
    i: 0
    while: i < 8
        l2_m_dyn[i]: 0
        i: i + 1
    if: unit = 0
        return: l2_error(path, 0, "missing main")
    if: unit\trailer != 0
        return: l2_error(path, 0, "unsupported trailer")
    field: l2_next_active(unit\first_field)
    while: field != 0
        item: field\value
        nf: 0
        is_main: 0
        if: l2_frame_head(item, "fn") != 0 && item\as\frame != 0 && item\as\frame\body != 0
            nf: l2_next_active(item\as\frame\body\first_field)
        if: nf != 0 && nf\value != 0 && nf\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(nf\value\as\atom, "main")
            is_main: 1
            mains: mains + 1
            main_node: item
        if: is_main = 0 && (l2_frame_head(item, "fn") != 0 || l2_frame_head(item, "sub") != 0) && l2_collect_method(item, path) != 0
            return: 1
        if: is_main = 0 && l2_frame_head(item, "fn") = 0 && l2_frame_head(item, "sub") = 0
            extras: extras + 1
        field: l2_next_active(field\next)
    if: mains > 1
        return: l2_error(path, main_node, "several main")
    if: mains = 0
        return: l2_error(path, 0, "missing main")
    if: extras != 0
        return: l2_error(path, main_node, "unsupported body")
    if: l2_m_n != 0
        return: l2_parse_unit(main_node, path)
return: l2_take_main_lit(main_node, path, out_lit, out_body)

fn: l2_emit_puts_line (@: FILE out; const: @(LmP0Node stmt)) int
    @: LmP0Field arg
    arg: l2_next_active(stmt\as\frame\body\first_field)
    if: c.fputs("        c.puts: ", out) < 0
        return: 1
    if: l2_write_text(out, arg\value\as\atom) != 0
        return: 1
    if: c.fputs("\n", out) < 0
        return: 1
return: 0

fn: l2_emit_l1 (const: @(char out_path); const: @(LmP0Structure body); const: @(LmP0Text lit)) int
    @: FILE out
    @: LmP0Field field
    @: LmP0Field nxt
    int: puts_n 0
    if: out_path = 0 || body = 0 || lit = 0 || lit\data = 0 || lit\length = 0U
        return: 1
    field: l2_next_active(body\first_field)
    while: field != 0
        nxt: l2_next_active(field\next)
        if: nxt != 0
            puts_n: puts_n + 1
        field: nxt
    out: c.fopen(out_path, "wb")
    if: out = 0
        c.fprintf(c.stderr, "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: puts_n != 0 && c.fputs("include: \"<stdio.h>\"\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fputs("external:\n    fn: main () int\n", out) < 0
        c.fclose(out)
        return: 1
    field: l2_next_active(body\first_field)
    while: field != 0
        nxt: l2_next_active(field\next)
        if: nxt != 0 && l2_emit_puts_line(out, field\value) != 0
            c.fclose(out)
            return: 1
        field: nxt
    if: c.fputs("        return: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, lit) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("\n    end: main\nend: external\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fclose(out) != 0
        return: 1
return: 0

fn: l2_translate (const: @(char in_path); const: @(char out_path)) int
    @: LmP0Document document 0
    const: @: LmP0Diagnostic diagnostic
    const: @: LmP0Node root
    @: LmP0Structure unit 0
    @: LmP0Structure body 0
    @: LmP0Text lit 0
    int: status
    if: l2_path_is_lm2(in_path) = 0
        c.fprintf(c.stderr, "l2trans error: %s:1:1: expected a .lm2 source\n", in_path)
        return: 1
    status: lm_p0_parse_file(in_path, @ document)
    if: status != 0
        diagnostic: lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf(c.stderr, "l2trans parse error %d at %zu:%zu: %s\n", diagnostic\code, diagnostic\line, diagnostic\column, diagnostic\message)
        else:
            c.fprintf(c.stderr, "l2trans parse error: %s\n", in_path)
        lm_p0_document_destroy(document)
        return: 1
    root: lm_p0_document_root(document)
    if: l2_unit_from_root(root, in_path, @ unit) != 0
        lm_p0_document_destroy(document)
        return: 1
    if: l2_translate_unit(unit, in_path, @ lit, @ body) != 0
        lm_p0_document_destroy(document)
        return: 1
    if: l2_leaf_mode != 0
        status: l2_emit_unit(out_path)
    else:
        status: l2_emit_l1(out_path, body, lit)
    lm_p0_document_destroy(document)
    if: status != 0
        return: 1
return: 0

# Parse/emit one two-int add leaf + typed call from §1.7 main.

fn: l2_ident (const: @(LmP0Text t)) int
    size_t: i
    unsigned: ch
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0
    ch: (cast: (unsigned) t\data[0])
    if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U)
        return: 0
    i: 1U
    while: i < t\length
        ch: (cast: (unsigned) t\data[i])
        if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U) && (ch < 48U || ch > 57U)
            return: 0
        i: i + 1U
    if: l2_text_eq(t, "main") || l2_text_eq(t, "fn") || l2_text_eq(t, "int") || l2_text_eq(t, "return") || l2_text_eq(t, "if") || l2_text_eq(t, "else") || l2_text_eq(t, "while") || l2_text_eq(t, "for") || l2_text_eq(t, "node")
        return: 0
return: 1

fn: l2_text_same (const: @(LmP0Text a); const: @(LmP0Text b)) int
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    if: a\length != b\length
        return: 0
return: c.memcmp(a\data, b\data, a\length) = 0

# Translator intern of the full canonical contract: L2_SIG_V0 schema
# plus exact ordered formal-name bytes. Method name is not interned.
# One table for the linked unit; not reset per method.
fn: l2_intern_match (unsigned: s; int: ar; const: @(char n0); size_t: l0; int: t0; const: @(char n1); size_t: l1; int: t1; const: @(char n2); size_t: l2n; int: t2; const: @(char n3); size_t: l3; int: t3) int
    unsigned: b
    if: s >= l2_intern_n || l2_it_ar[s] != ar || l2_it_dyn[s] != 0
        return: 0
    b: s * 4U
    if: ar >= 1 && (t0 != l2_it_ty[b] || l0 != l2_it_nl[b] || c.memcmp(n0, l2_it_n[b], l0) != 0)
        return: 0
    if: ar >= 2 && (t1 != l2_it_ty[b + 1U] || l1 != l2_it_nl[b + 1U] || c.memcmp(n1, l2_it_n[b + 1U], l1) != 0)
        return: 0
    if: ar >= 3 && (t2 != l2_it_ty[b + 2U] || l2n != l2_it_nl[b + 2U] || c.memcmp(n2, l2_it_n[b + 2U], l2n) != 0)
        return: 0
    if: ar >= 4 && (t3 != l2_it_ty[b + 3U] || l3 != l2_it_nl[b + 3U] || c.memcmp(n3, l2_it_n[b + 3U], l3) != 0)
        return: 0
return: 1

fn: l2_intern_store (int: ar; const: @(char n0); size_t: l0; int: t0; const: @(char n1); size_t: l1; int: t1; const: @(char n2); size_t: l2n; int: t2; const: @(char n3); size_t: l3; int: t3) unsigned
    unsigned: i 0U
    unsigned: b
    while: i < l2_intern_n
        if: l2_intern_match(i, ar, n0, l0, t0, n1, l1, t1, n2, l2n, t2, n3, l3, t3)
            return: i + 1U
        i: i + 1U
    if: l2_intern_n >= 16U || ar < 0 || ar > 4
        return: 0U
    b: l2_intern_n * 4U
    l2_it_ar[l2_intern_n]: ar
    l2_it_dyn[l2_intern_n]: 0
    if: ar >= 1
        l2_it_n[b]: (cast: (@: char) n0)
        l2_it_nl[b]: l0
        l2_it_ty[b]: t0
    if: ar >= 2
        l2_it_n[b + 1U]: (cast: (@: char) n1)
        l2_it_nl[b + 1U]: l1
        l2_it_ty[b + 1U]: t1
    if: ar >= 3
        l2_it_n[b + 2U]: (cast: (@: char) n2)
        l2_it_nl[b + 2U]: l2n
        l2_it_ty[b + 2U]: t2
    if: ar >= 4
        l2_it_n[b + 3U]: (cast: (@: char) n3)
        l2_it_nl[b + 3U]: l3
        l2_it_ty[b + 3U]: t3
    l2_intern_n: l2_intern_n + 1U
return: l2_intern_n

fn: l2_intern_pair (const: @(char a); size_t: na; const: @(char b); size_t: nb) unsigned
return: l2_intern_store(2, a, na, 0, b, nb, 0, 0, 0U, 0, 0, 0U, 0)

fn: l2_intern_eq_mi (unsigned: s; int: mi) int
    unsigned: b
    unsigned: uk
    int: k
    @: LmP0Text nm
    if: s >= l2_intern_n || mi < 0
        return: 0
    if: l2_it_ar[s] != l2_m_arity[mi] || l2_it_dyn[s] != l2_m_dyn[mi]
        return: 0
    b: s * 4U
    k: 0
    while: k < l2_m_arity[mi]
        nm: l2_m_fn[mi * 4 + k]
        if: nm = 0 || nm\data = 0
            return: 0
        uk: (cast: (unsigned) k)
        if: l2_m_ft[mi * 4 + k] != l2_it_ty[b + uk]
            return: 0
        if: nm\length != l2_it_nl[b + uk] || c.memcmp(nm\data, l2_it_n[b + uk], nm\length) != 0
            return: 0
        k: k + 1
    k: 0
    while: k < l2_m_dyn[mi]
        nm: l2_m_dn[mi * 4 + k]
        if: nm = 0 || nm\data = 0
            return: 0
        uk: (cast: (unsigned) k)
        if: l2_m_dt[mi * 4 + k] != l2_it_hty[b + uk]
            return: 0
        if: nm\length != l2_it_hnl[b + uk] || c.memcmp(nm\data, l2_it_hn[b + uk], nm\length) != 0
            return: 0
        k: k + 1
return: 1

fn: l2_intern_store_mi (int: mi) unsigned
    unsigned: i 0U
    unsigned: b
    unsigned: uk
    int: k
    @: LmP0Text nm
    while: i < l2_intern_n
        if: l2_intern_eq_mi(i, mi)
            return: i + 1U
        i: i + 1U
    if: l2_intern_n >= 16U
        return: 0U
    b: l2_intern_n * 4U
    l2_it_ar[l2_intern_n]: l2_m_arity[mi]
    l2_it_dyn[l2_intern_n]: l2_m_dyn[mi]
    k: 0
    while: k < l2_m_arity[mi]
        nm: l2_m_fn[mi * 4 + k]
        if: nm = 0 || nm\data = 0
            return: 0U
        uk: (cast: (unsigned) k)
        l2_it_n[b + uk]: (cast: (@: char) nm\data)
        l2_it_nl[b + uk]: nm\length
        l2_it_ty[b + uk]: l2_m_ft[mi * 4 + k]
        k: k + 1
    k: 0
    while: k < l2_m_dyn[mi]
        nm: l2_m_dn[mi * 4 + k]
        if: nm = 0 || nm\data = 0
            return: 0U
        uk: (cast: (unsigned) k)
        l2_it_hn[b + uk]: (cast: (@: char) nm\data)
        l2_it_hnl[b + uk]: nm\length
        l2_it_hty[b + uk]: l2_m_dt[mi * 4 + k]
        k: k + 1
    l2_intern_n: l2_intern_n + 1U
return: l2_intern_n

fn: l2_intern_mi (int: mi) unsigned
    @: LmP0Text a0 0
    @: LmP0Text a1 0
    @: LmP0Text a2 0
    @: LmP0Text a3 0
    int: ar
    if: mi < 0
        return: 0U
    if: l2_m_dyn[mi] != 0 || l2_m_arity[mi] = 0
        return: l2_intern_store_mi(mi)
    ar: l2_m_arity[mi]
    if: ar >= 1
        a0: l2_m_fn[mi * 4]
    if: ar >= 2
        a1: l2_m_fn[mi * 4 + 1]
    if: ar >= 3
        a2: l2_m_fn[mi * 4 + 2]
    if: ar >= 4
        a3: l2_m_fn[mi * 4 + 3]
    if: ar = 1
        return: l2_intern_store(1, a0\data, a0\length, l2_m_ft[mi * 4], 0, 0U, 0, 0, 0U, 0, 0, 0U, 0)
    if: ar = 2
        return: l2_intern_store(2, a0\data, a0\length, l2_m_ft[mi * 4], a1\data, a1\length, l2_m_ft[mi * 4 + 1], 0, 0U, 0, 0, 0U, 0)
    if: ar = 3
        return: l2_intern_store(3, a0\data, a0\length, l2_m_ft[mi * 4], a1\data, a1\length, l2_m_ft[mi * 4 + 1], a2\data, a2\length, l2_m_ft[mi * 4 + 2], 0, 0U, 0)
return: l2_intern_store(4, a0\data, a0\length, l2_m_ft[mi * 4], a1\data, a1\length, l2_m_ft[mi * 4 + 1], a2\data, a2\length, l2_m_ft[mi * 4 + 2], a3\data, a3\length, l2_m_ft[mi * 4 + 3])

fn: l2_find_method (const: @(LmP0Text name)) int
    int: i 0
    while: i < l2_m_n
        if: l2_text_same(l2_m_name[i], name)
            return: i
        i: i + 1
return: -1

fn: l2_own_find (const: @(LmP0Text t)) int
    int: i 0
    while: i < l2_own_n
        if: l2_text_same(l2_own_name[i], t)
            return: i
        i: i + 1
return: -1

fn: l2_own_add (const: @(LmP0Text t); int: ty; const: @(char path); const: @(LmP0Node at)) int
    int: i
    if: t = 0 || l2_ident(t) = 0
        if: l2_error(path, at, "incompatible entry signature") != 0
            return: -1
        return: -1
    i: l2_own_find(t)
    if: i >= 0 && l2_own_ty[i] != ty
        if: l2_error(path, at, "incompatible entry signature") != 0
            return: -1
        return: -1
    if: i >= 0
        return: i
    if: l2_own_n >= 4
        if: l2_error(path, at, "unsupported body") != 0
            return: -1
        return: -1
    l2_own_name[l2_own_n]: (cast: (@: LmP0Text) t)
    l2_own_ty[l2_own_n]: ty
    l2_own_n: l2_own_n + 1
return: l2_own_n - 1

fn: l2_formal_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_arity[mi]
        if: l2_text_same(l2_m_fn[mi * 4 + i], t)
            return: i
        i: i + 1
return: -1

fn: l2_dyn_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_dyn[mi]
        if: l2_text_same(l2_m_dn[mi * 4 + i], t)
            return: i
        i: i + 1
return: -1

fn: l2_param_find (int: mi; const: @(LmP0Text t)) int
    int: fi
    int: di
    fi: l2_formal_find(mi, t)
    if: fi >= 0
        return: fi
    di: l2_dyn_find(mi, t)
    if: di >= 0
        return: l2_m_arity[mi] + di
return: -1

fn: l2_bind_own (int: mi; int: oi; const: @(char path); const: @(LmP0Node at)) int
    int: fi 0
    if: mi < 0 || oi < 0
        return: 0
    while: fi < l2_m_arity[mi]
        if: l2_text_same(l2_m_fn[mi * 4 + fi], l2_own_name[oi])
            if: l2_m_ft[mi * 4 + fi] != l2_own_ty[oi]
                return: l2_error(path, at, "incompatible entry signature")
            l2_m_alias[mi * 4 + oi]: fi
        fi: fi + 1
    fi: 0
    while: fi < l2_m_dyn[mi]
        if: l2_text_same(l2_m_dn[mi * 4 + fi], l2_own_name[oi])
            if: l2_m_dt[mi * 4 + fi] != 0 && l2_m_dt[mi * 4 + fi] != l2_own_ty[oi]
                return: l2_error(path, at, "incompatible entry signature")
            l2_m_dt[mi * 4 + fi]: l2_own_ty[oi]
            l2_m_alias[mi * 4 + oi]: l2_m_arity[mi] + fi
        fi: fi + 1
return: 0

fn: l2_collect_decls (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth; @: int sn) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    @: LmP0Text fa
    int: j
    int: ty
    if: body = 0 || sn = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: l2_frame_head(stmt, "if")
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && depth > 0
            return: l2_error(path, stmt, "unsupported own declaration")
        if: l2_frame_head(stmt, "if") = 0 && l2_slot_decl_ty(stmt) != 0 && depth > 0
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && depth = 0
            ty: l2_own_decl_ty(stmt)
            fa: l2_next_active(stmt\as\frame\body\first_field)\value\as\atom
            j: l2_own_add(fa, ty, path, stmt)
            if: j < 0
                return: 1
            l2_m_uses[mi * 4 + j]: 1
            l2_m_own[mi]: l2_m_own[mi] + 1
            if: l2_bind_own(mi, j, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) = 0 && l2_slot_decl_ty(stmt) != 0 && depth = 0
            ty: l2_slot_decl_ty(stmt)
            fa: l2_next_active(l2_next_active(stmt\as\frame\body\first_field)\next)\value\as\atom
            if: sn[0] >= 4
                return: l2_error(path, stmt, "unsupported body")
            l2_sn[mi * 4 + sn[0]]: fa
            l2_st[mi * 4 + sn[0]]: ty
            if: ty = 5
                l2_need_p0: 1
            sn[0]: sn[0] + 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) = 0 && l2_slot_decl_ty(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_name_before (const: @(LmP0Text a); const: @(LmP0Text b)) int
    size_t: n
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    n: a\length
    if: b\length < n
        n: b\length
    if: c.memcmp(a\data, b\data, n) < 0
        return: 1
    if: c.memcmp(a\data, b\data, n) > 0
        return: 0
    if: a\length < b\length
        return: 1
return: 0

fn: l2_dyn_add (int: mi; const: @(LmP0Text t); int: ty) int
    int: k
    int: i
    if: mi < 0 || t = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 0
    k: l2_dyn_find(mi, t)
    if: k >= 0
        if: ty != 0 && l2_m_dt[mi * 4 + k] != 0 && l2_m_dt[mi * 4 + k] != ty
            return: 1
        if: ty != 0
            l2_m_dt[mi * 4 + k]: ty
        return: 0
    if: l2_m_dyn[mi] >= 4
        return: 1
    i: l2_m_dyn[mi]
    while: i > 0 && l2_name_before(t, l2_m_dn[mi * 4 + i - 1])
        l2_m_dn[mi * 4 + i]: l2_m_dn[mi * 4 + i - 1]
        l2_m_dt[mi * 4 + i]: l2_m_dt[mi * 4 + i - 1]
        i: i - 1
    l2_m_dn[mi * 4 + i]: (cast: (@: LmP0Text) t)
    l2_m_dt[mi * 4 + i]: ty
    l2_m_dyn[mi]: l2_m_dyn[mi] + 1
return: 0

fn: l2_scan_ident (int: mi; const: @(LmP0Text t); int: seen) int
    int: oi
    int: ty
    if: mi < 0 || t = 0 || l2_ident(t) = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 0
    if: l2_slot_find(mi, t) >= 0
        return: 0
    if: l2_find_method(t) >= 0
        return: 0
    if: l2_is_known(t)
        return: 0
    if: l2_text_eq(t, "return") || l2_text_eq(t, "if") || l2_text_eq(t, "else") || l2_text_eq(t, "while") || l2_text_eq(t, "for") || l2_text_eq(t, "continue") || l2_text_eq(t, "break") || l2_text_eq(t, "fn") || l2_text_eq(t, "sub") || l2_text_eq(t, "end") || l2_text_eq(t, "node") || l2_text_eq(t, "int") || l2_text_eq(t, "char") || l2_text_eq(t, "size_t") || l2_text_eq(t, "data") || l2_text_eq(t, "length")
        return: 0
    if: t\length >= 2U && t\data[0] = 99 && t\data[1] = 46
        return: 0
    oi: l2_own_find(t)
    if: oi >= 0 && l2_m_uses[mi * 4 + oi] != 0 && (seen & (1 << oi)) = 0
        l2_m_pre[mi * 4 + oi]: 1
        ty: l2_own_ty[oi]
        return: l2_dyn_add(mi, t, ty)
    if: oi >= 0 && l2_m_uses[mi * 4 + oi] != 0
        return: 0
    if: l2_dyn_add(mi, t, 0) != 0
        return: 1
return: 0

fn: l2_scan_node (const: @(LmP0Node node); int: mi; int: seen) int
    @: LmP0Field f
    int: n
    if: node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: l2_scan_ident(mi, node\as\atom, seen)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        f: node\as\structure\first_field
        n: l2_count_active(node\as\structure)
        return: l2_scan_fields(f, n, mi, seen)
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0
        if: l2_scan_ident(mi, node\as\frame\head, seen) != 0
            return: 1
        f: node\as\frame\body\first_field
        n: l2_count_active(node\as\frame\body)
        return: l2_scan_fields(f, n, mi, seen)
return: 0

fn: l2_scan_fields (@: LmP0Field field; int: n; int: mi; int: seen) int
    @: LmP0Field f
    int: i
    f: l2_next_active(field)
    i: 0
    while: i < n && f != 0
        if: l2_scan_node(f\value, mi, seen) != 0
            return: 1
        f: l2_next_active(f\next)
        i: i + 1
return: 0

fn: l2_scan_body (const: @(LmP0Structure body); int: mi; @: int seen) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Text fa
    int: n
    int: k
    int: oi
    int: ty
    int: sv
    if: body = 0 || seen = 0
        return: 0
    sv: seen[0]
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_scan_fields(fr\body\first_field, n - 1, mi, sv) != 0
                return: 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_scan_body(last\value\as\structure, mi, seen) != 0
                return: 1
            sv: seen[0]
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as != 0 && nxt\value\as\frame != 0 && l2_scan_body(nxt\value\as\frame\body, mi, seen) != 0
                return: 1
            sv: seen[0]
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: n >= 2 && l2_scan_fields(fr\body\first_field, n - 1, mi, sv) != 0
                return: 1
            if: n >= 2 && last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_scan_body(last\value\as\structure, mi, seen) != 0
                return: 1
            sv: seen[0]
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_own_decl_ty(stmt) != 0
            fa: l2_next_active(stmt\as\frame\body\first_field)\value\as\atom
            oi: l2_own_find(fa)
            if: oi >= 0
                seen[0]: seen[0] | (1 << oi)
                sv: seen[0]
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_own_decl_ty(stmt) = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_is_char_decl(stmt) = 0
            if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && l2_scan_ident(mi, stmt\as\frame\head, sv) != 0
                return: 1
            if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0 && l2_scan_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, sv) != 0
                return: 1
            field: l2_next_active(field\next)
return: 0

fn: l2_dyn_local (const: @(char path)) int
    int: i 0
    int: k
    int: oi
    int: seen
    while: i < l2_m_n
        seen: 0
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_scan_body(l2_m_body[i]\as\structure, i, @ seen) != 0
            return: l2_error(path, l2_m_node[i], "unsupported body")
        oi: 0
        while: oi < l2_own_n
            if: l2_m_uses[i * 4 + oi] != 0 && l2_m_pre[i * 4 + oi] != 0 && l2_dyn_add(i, l2_own_name[oi], l2_own_ty[oi]) != 0
                return: l2_error(path, l2_m_node[i], "unsupported body")
            if: l2_m_uses[i * 4 + oi] != 0 && l2_bind_own(i, oi, path, l2_m_node[i]) != 0
                return: 1
            oi: oi + 1
        i: i + 1
return: 0

fn: l2_dyn_step (const: @(char path); @: int changed) int
    int: m 0
    int: cidx
    int: k
    int: src
    int: ty
    int: before
    @: LmP0Text nm
    while: m < l2_m_n
        cidx: 0
        while: cidx < l2_m_n
            k: 0
            while: l2_m_edge[m * 8 + cidx] != 0 && k < l2_m_dyn[cidx]
                nm: l2_m_dn[cidx * 4 + k]
                ty: l2_m_dt[cidx * 4 + k]
                src: l2_param_find(m, nm)
                if: src < 0
                    src: l2_own_find(nm)
                if: src >= 0 && l2_param_find(m, nm) < 0 && l2_m_uses[m * 4 + src] != 0 && ty != 0 && l2_own_ty[src] != ty
                    return: l2_error(path, l2_m_node[m], "incompatible entry signature")
                if: src >= 0 && l2_param_find(m, nm) < 0 && l2_m_uses[m * 4 + src] != 0 && ty = 0
                    l2_m_dt[cidx * 4 + k]: l2_own_ty[src]
                    changed[0]: 1
                before: l2_m_dyn[m]
                if: l2_param_find(m, nm) < 0 && (src < 0 || l2_m_uses[m * 4 + src] = 0) && l2_dyn_add(m, nm, ty) != 0
                    return: l2_error(path, l2_m_node[m], "unsupported body")
                if: l2_m_dyn[m] != before
                    changed[0]: 1
                src: l2_param_find(m, nm)
                if: src >= 0 && src < l2_m_arity[m] && ty != 0 && l2_m_ft[m * 4 + src] != ty
                    return: l2_error(path, l2_m_node[m], "incompatible entry signature")
                if: src >= 0 && src < l2_m_arity[m] && ty = 0 && (l2_m_ft[m * 4 + src] = 1 || l2_m_ft[m * 4 + src] = 2)
                    l2_m_dt[cidx * 4 + k]: l2_m_ft[m * 4 + src]
                    changed[0]: 1
                if: src >= l2_m_arity[m] && ty != 0 && l2_m_dt[m * 4 + (src - l2_m_arity[m])] != 0 && l2_m_dt[m * 4 + (src - l2_m_arity[m])] != ty
                    return: l2_error(path, l2_m_node[m], "incompatible entry signature")
                if: src >= l2_m_arity[m] && ty != 0 && l2_m_dt[m * 4 + (src - l2_m_arity[m])] = 0
                    l2_m_dt[m * 4 + (src - l2_m_arity[m])]: ty
                    changed[0]: 1
                if: src >= l2_m_arity[m] && ty = 0 && l2_m_dt[m * 4 + (src - l2_m_arity[m])] != 0
                    l2_m_dt[cidx * 4 + k]: l2_m_dt[m * 4 + (src - l2_m_arity[m])]
                    changed[0]: 1
                k: k + 1
            cidx: cidx + 1
        m: m + 1
return: 0

fn: l2_dyn_typed (const: @(char path)) int
    int: m 0
    int: k
    while: m < l2_m_n
        k: 0
        while: k < l2_m_dyn[m]
            if: l2_m_dt[m * 4 + k] != 1 && l2_m_dt[m * 4 + k] != 2
                return: l2_error(path, l2_m_node[m], "unresolved name")
            k: k + 1
        m: m + 1
return: 0

fn: l2_dyn_close (const: @(char path)) int
    int: changed 1
    int: guard 0
    while: changed != 0 && guard < 32
        changed: 0
        guard: guard + 1
        if: l2_dyn_step(path, @ changed) != 0
            return: 1
return: l2_dyn_typed(path)

fn: l2_dyn_analyze (const: @(char path)) int
    if: l2_dyn_local(path) != 0
        return: 1
return: 0

fn: l2_raw_head (const: @(LmP0Text t); int: mi; @: int out_j; @: int out_fld) int
    size_t: i 0U
    size_t: sl 0U
    int: j
    if: t = 0 || t\data = 0 || mi < 0 || out_j = 0 || out_fld = 0
        return: 1
    sl: t\length
    while: i < t\length
        if: t\data[i] = 92
            sl: i
        i: i + 1U
    if: sl = 0U || sl = t\length || sl + 1U >= t\length
        return: 1
    j: 0
    while: j < l2_m_arity[mi]
        if: l2_m_fn[mi * 4 + j] != 0 && l2_m_fn[mi * 4 + j]\length = sl && c.memcmp(l2_m_fn[mi * 4 + j]\data, t\data, sl) = 0
            out_j[0]: j
            if: t\length - sl - 1U = 4U && c.memcmp(t\data + sl + 1U, "data", 4U) = 0
                out_fld[0]: 0
                return: 0
            if: t\length - sl - 1U = 6U && c.memcmp(t\data + sl + 1U, "length", 6U) = 0
                out_fld[0]: 1
                return: 0
            return: 2
        j: j + 1
    if: mi < 0
        return: 1
    j: 0
    while: j < l2_m_sn[mi]
        if: l2_sn[mi * 4 + j] != 0 && l2_sn[mi * 4 + j]\length = sl && c.memcmp(l2_sn[mi * 4 + j]\data, t\data, sl) = 0
            out_j[0]: j + 8
            if: t\length - sl - 1U = 4U && c.memcmp(t\data + sl + 1U, "data", 4U) = 0
                out_fld[0]: 0
                return: 0
            if: t\length - sl - 1U = 6U && c.memcmp(t\data + sl + 1U, "length", 6U) = 0
                out_fld[0]: 1
                return: 0
            return: 2
        j: j + 1
return: 1

fn: l2_index_head (const: @(LmP0Text t); int: mi; @: int out_j) int
    size_t: i
    size_t: lb
    size_t: n
    int: j
    if: t = 0 || t\data = 0 || out_j = 0
        return: 1
    n: t\length
    if: n < 4U
        return: 1
    if: t\data[n - 1U] != 93
        return: 1
    i: 0U
    lb: n
    while: i < n
        if: t\data[i] = 91
            lb: i
        i: i + 1U
    if: lb = n || lb = 0U
        return: 1
    if: lb + 1U >= n - 1U
        return: 2
    i: lb + 1U
    while: i < n - 1U
        if: t\data[i] < 48 || t\data[i] > 57
            return: 2
        i: i + 1U
    if: n - lb - 2U != 1U || t\data[lb + 1U] != 48
        return: 2
    if: mi < 0
        return: 3
    j: 0
    while: j < l2_m_arity[mi]
        if: l2_m_fn[mi * 4 + j] != 0 && l2_m_fn[mi * 4 + j]\length = lb && c.memcmp(l2_m_fn[mi * 4 + j]\data, t\data, lb) = 0
            if: l2_m_ft[mi * 4 + j] != 9
                return: 3
            out_j[0]: j
            return: 0
        j: j + 1
    return: 3
end: l2_index_head

fn: l2_slash_own (const: @(LmP0Text t)) int
    int: i 0
    size_t: n
    if: t = 0 || t\data = 0 || t\length < 6U
        return: -1
    if: t\data[0] != 110 || t\data[1] != 111 || t\data[2] != 100 || t\data[3] != 101 || t\data[4] != 92
        return: -1
    n: t\length - 5U
    while: i < l2_own_n
        if: l2_own_name[i] != 0 && l2_own_name[i]\length = n && c.memcmp(l2_own_name[i]\data, t\data + 5, n) = 0
            return: i
        i: i + 1
return: -1

fn: l2_own_decl_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    int: ty 0
    if: l2_frame_head(stmt, "char")
        ty: 1
    if: l2_frame_head(stmt, "size_t")
        ty: 2
    if: ty = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 1
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_ident(f\value\as\atom) = 0
        return: 0
return: ty

fn: l2_slot_decl_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    @: LmP0Field g
    if: l2_frame_head(stmt, "@") = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_ident(g\value\as\atom) = 0
        return: 0
    if: l2_text_eq(f\value\as\atom, "char")
        return: 3
    if: l2_text_eq(f\value\as\atom, "LmP0Text")
        return: 5
return: 0

fn: l2_slot_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_sn[mi]
        if: l2_text_same(l2_sn[mi * 4 + i], t)
            return: i
        i: i + 1
return: -1

fn: l2_is_char_decl (const: @(LmP0Node stmt)) int
    if: l2_own_decl_ty(stmt) != 0
        return: 1
    if: l2_slot_decl_ty(stmt) != 0
        return: 1
return: 0

fn: l2_is_plus (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "+") || l2_text_eq(t, "/") || l2_text_eq(t, "-") || l2_text_eq(t, "*")
        return: 1
return: 0

fn: l2_is_cmp (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "<") || l2_text_eq(t, ">") || l2_text_eq(t, "=") || l2_text_eq(t, "!=") || l2_text_eq(t, "<=") || l2_text_eq(t, ">=")
        return: 1
return: 0

fn: l2_is_andor (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "&&") || l2_text_eq(t, "||")
        return: 1
return: 0

fn: l2_is_brack (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "[") || l2_text_eq(t, "]")
        return: 1
return: 0

fn: l2_is_slash (const: @(LmP0Text t)) int
    if: t = 0 || t\length != 1U
        return: 0
    if: t\data[0] != 92
        return: 0
return: 1

fn: l2_is_known (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "c.strlen") || l2_text_eq(t, "c.memcmp") || l2_text_eq(t, "l2_immut_query_fill") || l2_text_eq(t, "l2_hash_compare_q")
        return: 1
    if: l2_text_eq(t, "c.sizeof") || l2_text_eq(t, "lm_own_new_zero") || l2_text_eq(t, "lm_own_copy_bytes") || l2_text_eq(t, "lm_own_delete")
        return: 1
return: 0

fn: l2_is_binop (const: @(LmP0Text t)) int
    if: l2_is_plus(t) || l2_is_cmp(t) || l2_is_andor(t)
        return: 1
return: 0

fn: l2_node_has_call (const: @(LmP0Node node)) int
    @: LmP0Field f
    if: node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && (l2_find_method(node\as\frame\head) >= 0 || l2_is_known(node\as\frame\head))
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0
        return: l2_fields_has_call(node\as\frame\body\first_field, l2_count_active(node\as\frame\body))
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        return: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
return: 0

fn: l2_fields_has_call (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i
    f: l2_next_active(field)
    i: 0
    while: i < n && f != 0
        if: l2_node_has_call(f\value)
            return: 1
        f: l2_next_active(f\next)
        i: i + 1
return: 0

fn: l2_is_or_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "||")

fn: l2_is_and_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "&&")

fn: l2_advance (@: LmP0Field f; int: k) @: LmP0Field
    int: i 0
    while: i < k && f != 0
        f: l2_next_active(f\next)
        i: i + 1
return: f

fn: l2_span_or (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_or_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_span_and (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_and_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_bump_ind (const: @(char ind); @: char dest) int
    size_t: ln
    if: dest = 0 || ind = 0
        return: 1
    ln: c.strlen(ind)
    if: ln + 5U >= 32U
        return: 1
    c.memcpy(dest, ind, ln)
    dest[ln]: 32
    dest[ln + 1U]: 32
    dest[ln + 2U]: 32
    dest[ln + 3U]: 32
    dest[ln + 4U]: 0
return: 0

fn: l2_new_temp (const: @(char ind); @: char dest) int
    int: t
    if: dest = 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_bool_set (const: @(char ind); const: @(char dest); const: @(char rhs)) int
    if: dest = 0 || rhs = 0 || ind = 0
        return: 1
    if: c.fprintf(l2_out, "%s%s: (%s) != 0\n", ind, dest, rhs) < 0
        return: 1
return: 0

fn: l2_eval_cond (@: LmP0Field field; int: n; int: mi; const: @(char ind); const: @(char dest)) int
    c.array: [256]: char scratch
    if: dest = 0
        return: 1
    scratch[0]: 0
    if: l2_eval_fields(field, n, mi, ind, scratch) != 0
        return: 1
return: l2_bool_set(ind, dest, scratch)

fn: l2_intern_prove (const: @(char path); const: @(LmP0Node node)) int
    unsigned: id
    int: two
    if: l2_m_n = 0
        return: 0
    id: l2_m_sig[0]
    l2_intern_again: l2_intern_mi(0)
    if: id = 0U || l2_intern_again != id
        return: l2_error(path, node, "intern broken")
    l2_intern_swap: 0U
    two: 0
    if: l2_m_arity[0] = 2 && l2_m_f0[0] != 0 && l2_m_f1[0] != 0
        two: 1
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0
        l2_intern_swap: l2_intern_pair(l2_m_f1[0]\data, l2_m_f1[0]\length, l2_m_f0[0]\data, l2_m_f0[0]\length)
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0 && (l2_intern_swap = 0U || l2_intern_swap = id)
        return: l2_error(path, node, "intern failed to distinguish swapped formals")
    l2_intern_probe: l2_intern_pair("a", 1U, "b", 1U)
    if: l2_intern_probe = 0U
        return: l2_error(path, node, "intern table full")
    if: two != 0 && l2_text_eq(l2_m_f0[0], "a") && l2_text_eq(l2_m_f1[0], "b") && l2_m_ft[0] = 0 && l2_intern_probe != id
        return: l2_error(path, node, "intern failed memcmp of equal names")
    if: two != 0 && (l2_text_eq(l2_m_f0[0], "a") = 0 || l2_text_eq(l2_m_f1[0], "b") = 0 || l2_m_ft[0] != 0) && l2_intern_probe = id
        return: l2_error(path, node, "intern false-equal distinct contracts")
    l2_sigv: id
return: 0

fn: l2_end_text (const: @(LmP0Frame frame); const: @(LmP0Text name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0 || name = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_same(field\value\as\atom, name)

fn: l2_int_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_name[0]: 0
    if: node = 0 || node\as = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int") = 0 && l2_frame_head(node, "char") = 0 && l2_frame_head(node, "size_t") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f\value = 0 || f\value\as = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_name[0]: f\value\as\atom
return: 0

fn: l2_typed_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name; @: int out_ty) int
    @: LmP0Field f
    @: LmP0Field g
    const: @: LmP0Node inner
    if: out_ty = 0 || out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int")
        out_ty[0]: 0
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "char")
        out_ty[0]: 1
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "size_t")
        out_ty[0]: 2
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "@")
        if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 2
            return: l2_error(path, node, "incompatible entry signature")
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, node, "incompatible entry signature")
        if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        if: l2_text_eq(f\value\as\atom, "size_t")
            out_ty[0]: 9
            out_name[0]: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "int") || l2_text_eq(f\value\as\atom, "char")
            return: l2_error(path, node, "incompatible entry signature")
        if: l2_text_eq(f\value\as\atom, "LmP0Text") = 0 && l2_text_eq(f\value\as\atom, "L2ImmutQuery") = 0
            return: l2_error(path, node, "unknown foreign type")
        if: l2_text_eq(f\value\as\atom, "LmP0Text")
            l2_need_p0: 1
            out_ty[0]: 5
        if: l2_text_eq(f\value\as\atom, "L2ImmutQuery")
            l2_need_query: 1
            out_ty[0]: 7
        out_name[0]: g\value\as\atom
        return: 0
    if: l2_frame_head(node, "const") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    inner: l2_next_active(node\as\frame\body\first_field)\value
    if: l2_frame_head(inner, "@") = 0 || inner\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_count_active(inner\as\frame\body) != 2
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(inner\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_text_eq(f\value\as\atom, "char") = 0 && l2_text_eq(f\value\as\atom, "LmP0Text") = 0 && l2_text_eq(f\value\as\atom, "L2ImmutQuery") = 0
        return: l2_error(path, node, "unknown foreign type")
    if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_text_eq(f\value\as\atom, "char")
        out_ty[0]: 3
    if: l2_text_eq(f\value\as\atom, "LmP0Text")
        out_ty[0]: 4
        l2_need_p0: 1
    if: l2_text_eq(f\value\as\atom, "L2ImmutQuery")
        out_ty[0]: 6
        l2_need_query: 1
    out_name[0]: g\value\as\atom
return: 0

fn: l2_collect_method (const: @(LmP0Node fn_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node params
    const: @: LmP0Node body
    @: LmP0Field p
    @: LmP0Text fa 0
    @: LmP0Text nm 0
    unsigned: id
    int: ar
    int: j
    int: ty
    int: k
    int: is_sub 0
    int: sn 0
    const: @: LmP0Node rty
    if: fn_node = 0 || fn_node\as = 0 || fn_node\as\frame = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: l2_m_n >= 8
        return: l2_error(path, fn_node, "too many methods")
    fr: fn_node\as\frame
    if: l2_frame_head(fn_node, "sub")
        is_sub: 1
    if: is_sub = 0 && (fr\body = 0 || l2_count_active(fr\body) != 4)
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub != 0 && (fr\body = 0 || l2_count_active(fr\body) != 3)
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_ident(field\value\as\atom) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    nm: field\value\as\atom
    if: l2_end_text(fr, nm) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_find_method(nm) >= 0
        return: l2_error(path, fn_node, "duplicate definition")
    if: nm\length >= 63U
        return: l2_error(path, fn_node, "name too long")
    field: l2_next_active(field\next)
    params: field\value
    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE || params\as = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: params\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    ar: l2_count_active(params\as\structure)
    if: ar < 0 || ar > 4
        return: l2_error(path, fn_node, "incompatible entry signature")
    p: l2_next_active(params\as\structure\first_field)
    j: 0
    while: j < ar
        ty: 0
        fa: 0
        if: p = 0 || l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            return: 1
        if: fa = 0 || fa\length >= 63U
            return: l2_error(path, fn_node, "name too long")
        k: 0
        while: k < j
            if: l2_text_same(fa, l2_m_fn[l2_m_n * 4 + k])
                return: l2_error(path, p\value, "duplicate formal")
            k: k + 1
        l2_m_fn[l2_m_n * 4 + j]: fa
        l2_m_ft[l2_m_n * 4 + j]: ty
        p: l2_next_active(p\next)
        j: j + 1
    l2_m_arity[l2_m_n]: ar
    l2_m_dyn[l2_m_n]: 0
    l2_m_f0[l2_m_n]: 0
    l2_m_f1[l2_m_n]: 0
    if: ar >= 1
        l2_m_f0[l2_m_n]: l2_m_fn[l2_m_n * 4]
    if: ar >= 2
        l2_m_f1[l2_m_n]: l2_m_fn[l2_m_n * 4 + 1]
    field: l2_next_active(field\next)
    if: is_sub != 0
        l2_m_ret[l2_m_n]: 8
    if: is_sub = 0 && field\value = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "int")
        l2_m_ret[l2_m_n]: 0
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "size_t")
        l2_m_ret[l2_m_n]: 2
    if: is_sub = 0 && l2_frame_head(field\value, "@")
        if: field\value\as\frame\body = 0 || l2_count_active(field\value\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rty: l2_next_active(field\value\as\frame\body\first_field)\value
        if: rty = 0 || rty\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, fn_node, "incompatible entry signature")
        if: l2_text_eq(rty\as\atom, "char")
            l2_m_ret[l2_m_n]: 3
        if: l2_text_eq(rty\as\atom, "LmP0Text")
            l2_m_ret[l2_m_n]: 5
            l2_need_p0: 1
        if: l2_text_eq(rty\as\atom, "char") = 0 && l2_text_eq(rty\as\atom, "LmP0Text") = 0
            return: l2_error(path, fn_node, "unknown foreign type")
        ---
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "int") = 0 && l2_text_eq(field\value\as\atom, "size_t") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0 && field\value\kind != c.LM_P0_NODE_ATOM && l2_frame_head(field\value, "@") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0
        field: l2_next_active(field\next)
    body: field\value
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: body\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    l2_m_name[l2_m_n]: nm
    l2_m_node[l2_m_n]: (cast: (@: LmP0Node) fn_node)
    l2_m_body[l2_m_n]: (cast: (@: LmP0Node) body)
    l2_m_sig[l2_m_n]: 0U
    l2_m_own[l2_m_n]: 0
    l2_m_sn[l2_m_n]: 0
    if: l2_collect_decls(body\as\structure, l2_m_n, path, 0, @ sn) != 0
        return: 1
    l2_m_sn[l2_m_n]: sn
    l2_m_n: l2_m_n + 1
return: 0

fn: l2_check_primary (const: @(LmP0Node node); int: mi; const: @(char path)) int
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    int: idx
    if: node = 0
        return: l2_error(path, node, "unsupported body")
    if: node\kind = c.LM_P0_NODE_ATOM
        if: l2_num(node\as\atom)
            return: 0
        if: l2_quoted(node\as\atom)
            return: 0
        if: l2_ident(node\as\atom) = 0
            return: l2_error(path, node, "unsupported body")
        if: mi >= 0 && l2_param_find(mi, node\as\atom) >= 0
            return: 0
        if: mi >= 0
            idx: 0
            while: idx < l2_own_n
                if: l2_m_uses[mi * 4 + idx] != 0 && l2_text_same(node\as\atom, l2_own_name[idx])
                    return: 0
                idx: idx + 1
            ---
        if: mi >= 0 && l2_slot_find(mi, node\as\atom) >= 0
            return: 0
        return: l2_error(path, node, "unresolved name")
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        return: l2_check_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, path, node)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: l2_error(path, node, "unsupported body")
    if: l2_frame_head(node, "while") || l2_frame_head(node, "for") || l2_frame_head(node, "continue") || l2_frame_head(node, "break")
        return: l2_error(path, node, "unsupported loop")
    if: l2_frame_head(node, "if") || l2_frame_head(node, "else") || l2_frame_head(node, "return") || l2_frame_head(node, "fn")
        return: l2_error(path, node, "unsupported body")
    call: node\as\frame
    if: call\head = 0
        return: l2_error(path, node, "unknown method")
    idx: l2_find_method(call\head)
    if: idx < 0 && l2_text_eq(call\head, "c.sizeof")
        if: call\body = 0 || l2_next_active(call\body\first_field) = 0
            return: l2_error(path, node, "incompatible entry signature")
        a0: l2_next_active(call\body\first_field)
        if: a0\value = 0 || a0\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, node, "unknown foreign type")
        if: l2_text_eq(a0\value\as\atom, "LmP0Text") = 0 && l2_text_eq(a0\value\as\atom, "c.LmP0Text") = 0
            return: l2_error(path, node, "unknown foreign type")
        return: 0
    if: idx < 0 && l2_is_known(call\head)
        if: l2_text_eq(call\head, "lm_own_new_zero") || l2_text_eq(call\head, "lm_own_copy_bytes") || l2_text_eq(call\head, "lm_own_delete")
            l2_need_own: 1
        if: call\body = 0
            return: l2_error(path, node, "incompatible entry signature")
        return: l2_check_fields(call\body\first_field, l2_count_active(call\body), mi, path, node)
    if: idx < 0
        return: l2_error(path, node, "unknown method")
    if: call\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: call\body = 0 || call\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: l2_count_active(call\body) != l2_m_arity[idx]
        return: l2_error(path, node, "incompatible entry signature")
    if: mi >= 0
        l2_m_edge[mi * 8 + idx]: 1
    a0: l2_next_active(call\body\first_field)
    while: a0 != 0
        if: a0\value = 0 || l2_check_primary(a0\value, mi, path) != 0
            return: 1
        a0: l2_next_active(a0\next)
return: 0

fn: l2_check_expr (const: @(LmP0Node node); int: mi; const: @(char path)) int
return: l2_check_primary(node, mi, path)

fn: l2_check_fields (@: LmP0Field field; int: n; int: mi; const: @(char path); const: @(LmP0Node at)) int
    @: LmP0Field f
    int: i
    int: skip
    int: after 0
    if: n <= 0
        return: l2_error(path, at, "unsupported body")
    f: l2_next_active(field)
    i: 0
    while: i < n
        if: f = 0 || f\value = 0
            return: l2_error(path, at, "unsupported body")
        skip: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM && (l2_is_binop(f\value\as\atom) || l2_is_brack(f\value\as\atom) || l2_is_slash(f\value\as\atom) || l2_num(f\value\as\atom))
            skip: 1
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            after: 1
        if: after != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom) = 0 && l2_ident(f\value\as\atom)
            if: l2_text_eq(f\value\as\atom, "data") = 0 && l2_text_eq(f\value\as\atom, "length") = 0
                return: l2_error(path, f\value, "unknown foreign field")
            skip: 1
            after: 0
        if: skip = 0 && l2_check_primary(f\value, mi, path) != 0
            return: 1
        i: i + 1
        f: l2_next_active(f\next)
return: 0

fn: l2_check_body (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    int: rj 0
    int: rf 0
    int: raw 1
    int: ix 1
    if: body = 0
        return: l2_error(path, 0, "unsupported body")
    if: mi < 0 && depth > 4
        return: l2_error(path, 0, "too deeply nested")
    if: mi >= 0 && depth > 5
        return: l2_error(path, 0, "too deeply nested")
    field: l2_next_active(body\first_field)
    if: field = 0
        return: l2_error(path, 0, "unsupported body")
    while: field != 0
        stmt: field\value
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "break")
            return: l2_error(path, stmt, "unsupported loop")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "continue") && l2_loop_depth = 0
            return: l2_error(path, stmt, "unsupported loop")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "continue")
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for") || l2_frame_head(stmt, "break") || l2_frame_head(stmt, "continue")
            return: l2_error(path, stmt, "unsupported loop")
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            if: fr\body = 0
                return: l2_error(path, stmt, "unsupported body")
            if: fr\trailer != 0 && l2_end_named(fr, "if") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            n: l2_count_active(fr\body)
            if: n < 2
                return: l2_error(path, stmt, "unsupported body")
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_check_fields(fr\body\first_field, n - 1, mi, path, stmt) != 0
                return: 1
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                return: 1
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as\frame\body = 0
                return: l2_error(path, nxt\value, "unsupported body")
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as\frame\trailer != 0 && l2_end_named(nxt\value\as\frame, "else") = 0
                return: l2_error(path, nxt\value, "unsupported trailer")
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && l2_check_body(nxt\value\as\frame\body, mi, path, depth + 1) != 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            if: fr\body = 0
                return: l2_error(path, stmt, "unsupported body")
            if: fr\trailer != 0 && l2_end_named(fr, "while") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            n: l2_count_active(fr\body)
            if: n < 2
                return: l2_error(path, stmt, "unsupported body")
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_check_fields(fr\body\first_field, n - 1, mi, path, stmt) != 0
                return: 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            l2_loop_depth: l2_loop_depth - 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && depth > 0
            return: l2_error(path, stmt, "unsupported own declaration")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        raw: 1
        ix: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
            ix: l2_index_head(stmt\as\frame\head, mi, @ rj)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (ix = 2 || ix = 3)
            return: l2_error(path, stmt, "unsupported index")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && stmt\as != 0 && stmt\as\frame != 0
            raw: l2_raw_head(stmt\as\frame\head, mi, @ rj, @ rf)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 2
            return: l2_error(path, stmt, "unknown foreign field")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 0 && mi >= 0 && rj < 8 && (l2_m_ft[mi * 4 + rj] = 4 || l2_m_ft[mi * 4 + rj] = 6)
            return: l2_error(path, stmt, "const write")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 0 && mi >= 0 && rj < 8 && l2_m_ft[mi * 4 + rj] != 5 && l2_m_ft[mi * 4 + rj] != 7
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 0 && mi >= 0 && rj >= 8 && l2_st[mi * 4 + rj - 8] != 5
            return: l2_error(path, stmt, "unknown foreign field")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && ix != 0 && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || (l2_own_find(stmt\as\frame\head) < 0 && l2_slot_find(mi, stmt\as\frame\head) < 0 && l2_slash_own(stmt\as\frame\head) < 0 && l2_find_method(stmt\as\frame\head) < 0 && l2_param_find(mi, stmt\as\frame\head) < 0 && raw != 0 && l2_is_known(stmt\as\frame\head) = 0))
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && fr\trailer != 0
            return: l2_error(path, stmt, "unsupported trailer")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (fr\body = 0 || fr\body\trailer != 0)
            return: l2_error(path, stmt, "unsupported trailer")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && mi >= 0 && l2_m_ret[mi] = 8
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_count_active(fr\body) = 1 && l2_next_active(fr\body\first_field)\value != 0 && l2_next_active(fr\body\first_field)\value\kind = c.LM_P0_NODE_FRAME && l2_find_method(l2_next_active(fr\body\first_field)\value\as\frame\head) >= 0 && l2_m_ret[l2_find_method(l2_next_active(fr\body\first_field)\value\as\frame\head)] = 8
            return: l2_error(path, stmt, "incompatible entry signature")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_find_method(fr\head) >= 0 && l2_check_primary(stmt, mi, path) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_find_method(fr\head) < 0 && l2_check_fields(fr\body\first_field, l2_count_active(fr\body), mi, path, stmt) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_dfs (int: u) int
    int: v 0
    if: l2_m_mark[u] = 1
        return: 1
    if: l2_m_mark[u] = 2
        return: 0
    l2_m_mark[u]: 1
    while: v < l2_m_n
        if: l2_m_edge[u * 8 + v] != 0 && l2_dfs(v) != 0
            return: 1
        v: v + 1
    l2_m_mark[u]: 2
return: 0

fn: l2_parse_unit (const: @(LmP0Node main_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node body
    int: i 0
    if: main_node = 0 || main_node\as = 0 || main_node\as\frame = 0
        return: l2_error(path, main_node, "unsupported body")
    fr: main_node\as\frame
    if: l2_end_named(fr, "main") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    if: fr\body = 0 || l2_count_active(fr\body) != 4
        return: l2_error(path, main_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, main_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(field\value\as\atom, "main") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    if: l2_empty_struct(field\value) = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(field\value\as\atom, "int") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: field\value
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, main_node, "unsupported body")
    if: body\as\structure\trailer != 0
        return: l2_error(path, main_node, "unsupported trailer")
    l2_main_body: body\as\structure
    if: l2_dyn_local(path) != 0
        return: 1
    while: i < l2_m_n
        if: l2_check_body(l2_m_body[i]\as\structure, i, path, 0) != 0
            return: 1
        i: i + 1
    if: l2_check_body(body\as\structure, -1, path, 0) != 0
        return: 1
    if: l2_dyn_close(path) != 0
        return: 1
    i: 0
    while: i < l2_m_n
        l2_m_sig[i]: l2_intern_mi(i)
        if: l2_m_sig[i] = 0U
            return: l2_error(path, l2_m_node[i], "intern table full")
        i: i + 1
    if: l2_m_n != 0 && l2_intern_prove(path, l2_m_node[0]) != 0
        return: 1
    i: 0
    while: i < l2_m_n
        l2_m_mark[i]: 0
        i: i + 1
    i: 0
    while: i < l2_m_n
        if: l2_dfs(i) != 0
            return: l2_error(path, l2_m_node[i], "unsupported recursion")
        i: i + 1
    l2_leaf_mode: 1
return: 0

fn: l2_tok_text (const: @(LmP0Text t); @: char dest) int
    if: t = 0 || t\data = 0 || dest = 0 || t\length >= 63U
        return: 1
    c.memcpy(dest, t\data, t\length)
    dest[t\length]: 0
return: 0

fn: l2_tok_temp (int: k; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", k) < 0
        return: 1
return: 0

fn: l2_cat (@: char dest; const: @(char src)) int
    size_t: nd
    size_t: ns
    if: dest = 0 || src = 0
        return: 1
    nd: c.strlen(dest)
    ns: c.strlen(src)
    if: nd + ns >= 255U
        return: 1
    c.memcpy(dest + nd, src, ns + 1U)
return: 0

fn: l2_hidden_from (int: mi; int: callee; int: k; const: @(char ind); @: char dest) int
    @: LmP0Text nm
    int: ty
    int: pi
    int: oi
    int: fi
    int: t
    int: child
    c.array: [32]: char deep
    if: dest = 0 || callee < 0 || k < 0 || k >= l2_m_dyn[callee]
        return: 1
    nm: l2_m_dn[callee * 4 + k]
    ty: l2_m_dt[callee * 4 + k]
    dest[0]: 0
    pi: -1
    if: mi >= 0
        pi: l2_param_find(mi, nm)
    if: pi >= 0
        return: l2_tok_formal(mi, pi, dest)
    oi: -1
    if: mi >= 0
        oi: l2_own_find(nm)
    fi: -1
    if: mi >= 0 && oi >= 0 && l2_m_uses[mi * 4 + oi] != 0
        fi: l2_m_alias[mi * 4 + oi]
    if: fi >= 0
        return: l2_tok_formal(mi, fi, dest)
    if: mi >= 0 && oi >= 0 && l2_m_uses[mi * 4 + oi] != 0 && c.sprintf(dest, "l2_q%d", oi) < 0
        return: 1
    if: mi >= 0 && oi >= 0 && l2_m_uses[mi * 4 + oi] != 0
        return: 0
    child: l2_own_find(nm)
    if: child < 0 || l2_call_node = 0
        return: 1
    if: l2_bump_ind(ind, deep) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_xp: lmx_branch_child(%s, %uU)\n%sif: l2_xp = 0\n", ind, l2_call_node, (cast: (unsigned) child), ind) < 0
        return: 1
    if: l2_emit_checkpoint(mi, deep) != 0
        return: 1
    if: mi >= 0 && l2_m_ret[mi] = 8 && c.fprintf(l2_out, "%sreturn\n", deep) < 0
        return: 1
    if: mi >= 0 && l2_m_ret[mi] = 2 && c.fprintf(l2_out, "%sreturn: 0U\n", deep) < 0
        return: 1
    if: (mi < 0 || (l2_m_ret[mi] != 2 && l2_m_ret[mi] != 8)) && c.fprintf(l2_out, "%sreturn: 0\n", deep) < 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: ty = 1 && c.fprintf(l2_out, "%schar: l2_t%d\n%sl2_t%d: (cast: (char) lmx_char_value(l2_xp\\data))\n", ind, t, ind, t) < 0
        return: 1
    if: ty = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: lmx_size_value(l2_xp\\data)\n", ind, t, ind, t) < 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", t) < 0
        return: 1
return: 0

fn: l2_tok_formal (int: mi; int: fi; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_p%d_%d", mi, fi) < 0
        return: 1
return: 0

fn: l2_tok_slot (int: mi; int: si; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_s%d_%d", mi, si) < 0
        return: 1
return: 0

fn: l2_prep (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    int: t
    int: idx
    int: n
    int: k
    c.array: [256]: char s0
    c.array: [256]: char s1
    c.array: [256]: char s2
    c.array: [256]: char s3
    c.array: [256]: char h0
    c.array: [256]: char h1
    c.array: [256]: char h2
    c.array: [256]: char h3
    if: node = 0 || dest = 0
        return: 1
    h0[0]: 0
    h1[0]: 0
    h2[0]: 0
    h3[0]: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        if: mi >= 0
            idx: l2_param_find(mi, node\as\atom)
            if: idx >= 0
                return: l2_tok_formal(mi, idx, dest)
            ---
        if: mi >= 0
            idx: 0
            while: idx < l2_own_n
                if: l2_m_uses[mi * 4 + idx] != 0 && l2_text_same(node\as\atom, l2_own_name[idx])
                    if: c.sprintf(dest, "l2_q%d", idx) < 0
                        return: 1
                    return: 0
                idx: idx + 1
            ---
        if: mi >= 0
            idx: l2_slot_find(mi, node\as\atom)
            if: idx >= 0
                return: l2_tok_slot(mi, idx, dest)
            ---
        return: l2_tok_text(node\as\atom, dest)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        if: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
            return: l2_eval_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, ind, dest)
        s2[0]: 0
        s3[0]: 0
        if: l2_emit_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, ind, s2) != 0
            return: 1
        if: l2_cat(s3, "(") != 0
            return: l2_error(l2_src, node, "expression too long")
        if: l2_cat(s3, s2) != 0
            return: l2_error(l2_src, node, "expression too long")
        if: l2_cat(s3, ")") != 0
            return: l2_error(l2_src, node, "expression too long")
        c.memcpy(dest, s3, 256U)
        return: 0
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
