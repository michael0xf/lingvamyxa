        return: 1
    if: c.fprintf(l2_out, "(%s", l2_call_node) < 0
        return: 1
    if: s0[0] != 0 && c.fprintf(l2_out, ", %s", s0) < 0
        return: 1
    if: s1[0] != 0 && c.fprintf(l2_out, ", %s", s1) < 0
        return: 1
    if: s2[0] != 0 && c.fprintf(l2_out, ", %s", s2) < 0
        return: 1
    if: s3[0] != 0 && c.fprintf(l2_out, ", %s", s3) < 0
        return: 1
    if: h0[0] != 0 && c.fprintf(l2_out, ", %s", h0) < 0
        return: 1
    if: h1[0] != 0 && c.fprintf(l2_out, ", %s", h1) < 0
        return: 1
    if: h2[0] != 0 && c.fprintf(l2_out, ", %s", h2) < 0
        return: 1
    if: h3[0] != 0 && c.fprintf(l2_out, ", %s", h3) < 0
        return: 1
    if: c.fputs(")\n", l2_out) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_emit_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Node at 0
    int: i
    int: ao
    int: after 0
    int: fld
    c.array: [256]: char buf
    c.array: [256]: char piece
    if: dest = 0
        return: 1
    buf[0]: 0
    if: n = 1
        return: l2_prep(l2_next_active(field)\value, mi, ind, dest)
    f: l2_next_active(field)
    i: 0
    ao: 0
    while: i < n && f != 0 && f\value != 0
        at: f\value
        fld: 0
        piece[0]: 0
        if: after != 0 && f\value\kind = c.LM_P0_NODE_ATOM && (l2_text_eq(f\value\as\atom, "data") || l2_text_eq(f\value\as\atom, "length"))
            fld: 1
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            if: l2_cat(buf, "\\") != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 1
            fld: 2
        if: fld = 1
            if: l2_tok_text(f\value\as\atom, piece) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_brack(f\value\as\atom)
            if: l2_tok_text(f\value\as\atom, piece) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            fld: 2
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
            if: l2_cat(buf, " ") != 0
                return: l2_error(l2_src, at, "expression too long")
            if: l2_tok_text(f\value\as\atom, piece) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            if: l2_cat(buf, " ") != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: l2_is_andor(f\value\as\atom)
            fld: 2
        if: fld = 0 && ao != 0 && f\value\kind = c.LM_P0_NODE_FRAME && l2_find_method(f\value\as\frame\head) >= 0
            return: 1
        if: fld = 0 && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_find_method(f\value\as\frame\head) < 0) && l2_prep(f\value, mi, ind, piece) != 0
            return: 1
        if: fld = 0 && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_find_method(f\value\as\frame\head) < 0) && l2_cat(buf, piece) != 0
            return: l2_error(l2_src, at, "expression too long")
        if: fld = 0
            ao: 0
            after: 0
        f: l2_next_active(f\next)
        i: i + 1
    c.memcpy(dest, buf, 256U)
return: 0

fn: l2_eval_and (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    c.array: [32]: char deep
    c.array: [256]: char rhs
    if: dest = 0 || n <= 0
        return: 1
    if: l2_bump_ind(ind, deep) != 0
        return: 1
    span: l2_span_and(field, n)
    if: span = n
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_emit_fields(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest, rhs) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_and(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s\n", ind, dest) < 0
            return: 1
        if: l2_emit_fields(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest, rhs) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

fn: l2_eval_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    c.array: [32]: char deep
    c.array: [256]: char rhs
    if: dest = 0 || n <= 0
        return: 1
    if: l2_fields_has_call(field, n) = 0
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_bump_ind(ind, deep) != 0
        return: 1
    span: l2_span_or(field, n)
    if: span = n
        return: l2_eval_and(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_eval_and(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest, rhs) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_or(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s = 0\n", ind, dest) < 0
            return: 1
        if: l2_eval_and(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest, rhs) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

fn: l2_emit_sig (int: mi) int
    int: j 0
    if: c.fputs(" (@: Lmx node", l2_out) < 0
        return: 1
    while: j < l2_m_arity[mi]
        if: l2_m_ft[mi * 4 + j] = 0 && c.fprintf(l2_out, "; int: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 1 && c.fprintf(l2_out, "; char: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 2 && c.fprintf(l2_out, "; size_t: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 3 && c.fprintf(l2_out, "; const: @(char l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 4 && c.fprintf(l2_out, "; const: @(LmP0Text l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 5 && c.fprintf(l2_out, "; @: LmP0Text l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 6 && c.fprintf(l2_out, "; const: @(L2ImmutQuery l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 7 && c.fprintf(l2_out, "; @: L2ImmutQuery l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 9 && c.fprintf(l2_out, "; @: size_t l2_p%d_%d", mi, j) < 0
            return: 1
        j: j + 1
    j: 0
    while: j < l2_m_dyn[mi]
        if: l2_m_dt[mi * 4 + j] = 1 && c.fprintf(l2_out, "; char: l2_p%d_%d", mi, l2_m_arity[mi] + j) < 0
            return: 1
        if: l2_m_dt[mi * 4 + j] = 2 && c.fprintf(l2_out, "; size_t: l2_p%d_%d", mi, l2_m_arity[mi] + j) < 0
            return: 1
        j: j + 1
    if: l2_m_ret[mi] = 2 && c.fputs(") size_t", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 3 && c.fputs(") @: char", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 5 && c.fputs(") @: LmP0Text", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 8 && c.fputs(")", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] != 2 && l2_m_ret[mi] != 3 && l2_m_ret[mi] != 5 && l2_m_ret[mi] != 8 && c.fputs(") int", l2_out) < 0
        return: 1
return: 0

fn: l2_emit_expr (const: @(LmP0Node node); int: mi; const: @(char ind)) int
return: l2_prep(node, mi, ind, l2_tok)

fn: l2_has_own_ty (int: ty) int
    int: i 0
    while: i < l2_own_n
        if: l2_own_ty[i] = ty
            return: 1
        i: i + 1
return: 0

fn: l2_emit_checkpoint (int: mi; const: @(char ind)) int
    int: i 0
    int: fi
    if: mi < 0 || ind = 0
        return: 0
    while: i < l2_own_n
        fi: l2_m_alias[mi * 4 + i]
        if: l2_m_uses[mi * 4 + i] != 0 && c.fprintf(l2_out, "%sif: l2_q%d_dirty != 0\n", ind, i) < 0
            return: 1
        if: l2_m_uses[mi * 4 + i] != 0 && l2_own_ty[i] = 1 && fi < 0 && c.fprintf(l2_out, "%s    l2_q%d_from\\data: lmx_char_cell((cast: (int) l2_q%d))\n", ind, i, i) < 0
            return: 1
        if: l2_m_uses[mi * 4 + i] != 0 && l2_own_ty[i] = 1 && fi >= 0 && c.fprintf(l2_out, "%s    l2_q%d_from\\data: lmx_char_cell((cast: (int) l2_p%d_%d))\n", ind, i, mi, fi) < 0
            return: 1
        if: l2_m_uses[mi * 4 + i] != 0 && l2_own_ty[i] = 2 && fi < 0 && c.fprintf(l2_out, "%s    if: lmx_size_store(l2_q%d_from\\data, l2_q%d) != 0\n%s        return: 0\n", ind, i, i, ind) < 0
            return: 1
        if: l2_m_uses[mi * 4 + i] != 0 && l2_own_ty[i] = 2 && fi >= 0 && c.fprintf(l2_out, "%s    if: lmx_size_store(l2_q%d_from\\data, l2_p%d_%d) != 0\n%s        return: 0\n", ind, i, mi, fi, ind) < 0
            return: 1
        if: l2_m_uses[mi * 4 + i] != 0 && c.fprintf(l2_out, "%s    l2_q%d_dirty: 0\n", ind, i) < 0
            return: 1
        i: i + 1
return: 0

fn: l2_emit_body (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    int: oi
    int: si
    int: fi
    int: sl
    int: rj 0
    int: rf 0
    int: raw 1
    int: ix 1
    size_t: ln
    c.array: [32]: char deep
    c.array: [32]: char wdeep
    c.array: [64]: char wcond
    c.array: [64]: char wkeep
    ln: c.strlen(ind)
    if: ln + 5U >= 32U
        return: 1
    c.memcpy(deep, ind, ln)
    deep[ln]: 32
    deep[ln + 1U]: 32
    deep[ln + 2U]: 32
    deep[ln + 3U]: 32
    deep[ln + 4U]: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        oi: -1
        si: -1
        fi: -1
        sl: -1
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_eval_fields(fr\body\first_field, n - 1, mi, ind, l2_tok) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", ind, l2_tok) < 0
                return: 1
            if: l2_emit_body(last\value\as\structure, mi, deep) != 0
                return: 1
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && c.fprintf(l2_out, "%selse:\n", ind) < 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && l2_emit_body(nxt\value\as\frame\body, mi, deep) != 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            wkeep[0]: 0
            wcond[0]: 0
            wdeep[0]: 0
            if: l2_bump_ind(deep, wdeep) != 0
                return: 1
            if: l2_new_temp(ind, wkeep) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wkeep) < 0
                return: 1
            if: l2_new_temp(ind, wcond) != 0
                return: 1
            if: c.fprintf(l2_out, "%swhile: %s\n", ind, wkeep) < 0
                return: 1
            if: l2_eval_cond(fr\body\first_field, n - 1, mi, deep, wcond) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wcond) < 0
                return: 1
            if: c.fprintf(l2_out, "%s    %s: 0\n", deep, wkeep) < 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", deep, wkeep) < 0
                return: 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_emit_body(last\value\as\structure, mi, wdeep) != 0
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            l2_loop_depth: l2_loop_depth - 1
            if: c.fprintf(l2_out, "%send: while\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "continue")
            if: c.fprintf(l2_out, "%scontinue\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        ix: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
            ix: l2_index_head(stmt\as\frame\head, mi, @ rj)
        if: ix = 0
            fr: stmt\as\frame
        if: ix = 0 && (fr\body = 0 || fr\trailer != 0)
            return: 1
        if: ix = 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: ix = 0 && c.fprintf(l2_out, "%sl2_p%d_%d[0]: %s\n", ind, mi, rj, l2_tok) < 0
            return: 1
        if: ix = 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "continue") || l2_frame_head(stmt, "break") || l2_frame_head(stmt, "for")
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0
            oi: l2_own_find(l2_next_active(stmt\as\frame\body\first_field)\value\as\atom)
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && mi >= 0
            l2_own_live[oi]: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && mi >= 0 && l2_m_alias[mi * 4 + oi] >= 0 && c.fprintf(l2_out, "%sl2_q%d_from: lmx_branch_child(node, %uU)\n%sif: l2_q%d_from = 0\n%s    return: 0\n", ind, oi, (cast: (unsigned) oi), ind, oi, ind) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (stmt = 0 || stmt\as = 0 || stmt\as\frame = 0)
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_emit_checkpoint(mi, ind) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && c.fprintf(l2_out, "%sreturn: %s\n", ind, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return")
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0
            oi: l2_own_find(fr\head)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && mi >= 0 && oi >= 0 && l2_m_uses[mi * 4 + oi] = 0
            oi: -1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0
            si: l2_slot_find(mi, fr\head)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0
            fi: l2_param_find(mi, fr\head)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && mi >= 0
            fi: l2_m_alias[mi * 4 + oi]
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && fi < 0 && c.fprintf(l2_out, "%sl2_q%d: %s\n", ind, oi, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && fi >= 0 && c.fprintf(l2_out, "%sl2_p%d_%d: %s\n", ind, mi, fi, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && fi < 0 && c.fprintf(l2_out, "%sl2_q%d_dirty: 1\n", ind, oi) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && fi >= 0 && l2_own_live[oi] != 0 && c.fprintf(l2_out, "%sl2_q%d_dirty: 1\n", ind, oi) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si >= 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si >= 0 && c.fprintf(l2_out, "%sl2_s%d_%d: %s\n", ind, mi, si, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si >= 0
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && fi >= 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && fi >= 0 && c.fprintf(l2_out, "%sl2_p%d_%d: %s\n", ind, mi, fi, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && fi >= 0
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && fi < 0 && l2_find_method(fr\head) >= 0 && l2_prep(stmt, mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_find_method(fr\head) >= 0
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_find_method(fr\head) < 0 && l2_is_known(fr\head) != 0 && l2_prep(stmt, mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_find_method(fr\head) < 0 && l2_is_known(fr\head) != 0
            field: l2_next_active(field\next)
        raw: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_find_method(fr\head) < 0 && l2_is_known(fr\head) = 0
            raw: l2_raw_head(fr\head, mi, @ rj, @ rf)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_find_method(fr\head) < 0 && l2_is_known(fr\head) = 0 && raw = 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_find_method(fr\head) < 0 && raw = 0 && rf = 0 && rj < 8 && c.fprintf(l2_out, "%sl2_p%d_%d\\data: %s\n", ind, mi, rj, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_find_method(fr\head) < 0 && raw = 0 && rf = 0 && rj >= 8 && c.fprintf(l2_out, "%sl2_s%d_%d\\data: %s\n", ind, mi, rj - 8, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_find_method(fr\head) < 0 && raw = 0 && rf = 1 && rj < 8 && c.fprintf(l2_out, "%sl2_p%d_%d\\length: %s\n", ind, mi, rj, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_find_method(fr\head) < 0 && raw = 0 && rf = 1 && rj >= 8 && c.fprintf(l2_out, "%sl2_s%d_%d\\length: %s\n", ind, mi, rj - 8, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_find_method(fr\head) < 0 && raw = 0
