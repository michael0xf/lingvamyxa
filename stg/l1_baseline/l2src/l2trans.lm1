return: dty

fn: l2_scope_free () int
    if: l2_scope_at != 0
        l2_xfree((cast: (@: void) l2_scope_at))
    l2_scope_at: 0
    l2_scope_n: 0
    l2_scope_cap: 0
return: 0

fn: l2_scope_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    @@: LmP0Node nn 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_scope_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_scope_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    if: nn = 0
        return: 1
    c.memset((cast: (@: void) nn), 0, nb)
    i: 0
    while: i < l2_scope_n
        nn[i]: l2_scope_at[i]
        i: i + 1
    if: l2_scope_at != 0
        l2_xfree((cast: (@: void) l2_scope_at))
    l2_scope_at: nn
    l2_scope_cap: (cast: (int) cap)
return: 0

fn: l2_scope_push (const: @(LmP0Node node)) int
    if: node = 0
        return: 1
    if: l2_scope_reserve(l2_scope_n + 1) != 0
        return: 1
    l2_scope_at[l2_scope_n]: (cast: (@: LmP0Node) node)
    l2_scope_n: l2_scope_n + 1
return: 0

fn: l2_scope_pop () int
    if: l2_scope_n <= 0
        return: 1
    l2_scope_n: l2_scope_n - 1
    l2_scope_at[l2_scope_n]: 0
return: 0

fn: l2_scope_has (const: @(LmP0Node node)) int
    int: i 0
    if: node = 0
        return: 0
    while: i < l2_scope_n
        if: l2_scope_at[i] = node
            return: 1
        i: i + 1
return: 0

fn: l2_scope_host () @: LmP0Node
    if: l2_scope_n <= 0
        return: 0
return: l2_scope_at[l2_scope_n - 1]

fn: l2_for_free () int
    if: l2_for_node != 0
        l2_xfree((cast: (@: void) l2_for_node))
    if: l2_for_uchild != 0
        l2_xfree((cast: (@: void) l2_for_uchild))
    if: l2_for_nkid != 0
        l2_xfree((cast: (@: void) l2_for_nkid))
    l2_for_node: 0
    l2_for_uchild: 0
    l2_for_nkid: 0
    l2_for_n: 0
    l2_for_cap: 0
return: 0

fn: l2_for_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    size_t: ni
    @@: LmP0Node nn 0
    @: int nu 0
    @: int nk 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_for_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_for_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nu: (cast: (@: int) l2_xmalloc(ni))
    nk: (cast: (@: int) l2_xmalloc(ni))
    if: nn = 0 || nu = 0 || nk = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nu != 0
            l2_xfree((cast: (@: void) nu))
        if: nk != 0
            l2_xfree((cast: (@: void) nk))
        return: 1
    c.memset((cast: (@: void) nn), 0, nb)
    i: 0
    while: i < (cast: (int) cap)
        nu[i]: -1
        nk[i]: 0
        i: i + 1
    i: 0
    while: i < l2_for_n
        nn[i]: l2_for_node[i]
        nu[i]: l2_for_uchild[i]
        nk[i]: l2_for_nkid[i]
        i: i + 1
    if: l2_for_node != 0
        l2_xfree((cast: (@: void) l2_for_node))
        l2_xfree((cast: (@: void) l2_for_uchild))
        l2_xfree((cast: (@: void) l2_for_nkid))
    l2_for_node: nn
    l2_for_uchild: nu
    l2_for_nkid: nk
    l2_for_cap: (cast: (int) cap)
return: 0

fn: l2_for_find (const: @(LmP0Node node)) int
    int: i 0
    if: node = 0
        return: -1
    while: i < l2_for_n
        if: l2_for_node[i] = node
            return: i
        i: i + 1
return: -1

fn: l2_for_add (const: @(LmP0Node node)) int
    int: i
    if: node = 0
        return: -1
    i: l2_for_find(node)
    if: i >= 0
        return: i
    if: l2_for_reserve(l2_for_n + 1) != 0
        return: -1
    l2_for_node[l2_for_n]: (cast: (@: LmP0Node) node)
    l2_for_uchild[l2_for_n]: -1
    l2_for_nkid[l2_for_n]: 0
    l2_for_n: l2_for_n + 1
return: l2_for_n - 1

fn: l2_layout_owns () int
    int: oi 0
    int: fid
    int: uch 0
    while: oi < l2_for_n
        l2_for_nkid[oi]: 0
        oi: oi + 1
    oi: 0
    while: oi < l2_own_n
        if: l2_own_host[oi] = 0
            l2_own_fid[oi]: -1
            l2_own_fchild[oi]: -1
            l2_own_uchild[oi]: uch
            uch: uch + 1
        if: l2_own_host[oi] != 0
            fid: l2_for_find(l2_own_host[oi])
            if: fid < 0
                fid: l2_for_add(l2_own_host[oi])
            if: fid < 0
                return: 1
            l2_own_fid[oi]: fid
            l2_own_fchild[oi]: l2_for_nkid[fid]
            l2_for_nkid[fid]: l2_for_nkid[fid] + 1
            l2_own_uchild[oi]: -1
        oi: oi + 1
    oi: 0
    while: oi < l2_for_n
        l2_for_uchild[oi]: uch
        uch: uch + 1
        oi: oi + 1
    l2_unit_base: uch
return: 0

fn: l2_for_cstyle (const: @(LmP0Node stmt)) int
    @: LmP0Field f0
    @: LmP0Field f1
    @: LmP0Field f2
    @: LmP0Field f3
    @: LmP0Field f4
    if: l2_frame_head(stmt, "for") = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 5
        return: 0
    f0: l2_next_active(stmt\as\frame\body\first_field)
    if: f0 = 0
        return: 0
    f1: l2_next_active(f0\next)
    if: f1 = 0
        return: 0
    f2: l2_next_active(f1\next)
    if: f2 = 0
        return: 0
    f3: l2_next_active(f2\next)
    if: f3 = 0
        return: 0
    f4: l2_next_active(f3\next)
    if: f4 = 0
        return: 0
    if: l2_own_decl_ty(f0\value) != 3
        return: 0
    if: f1\value = 0 || f1\value\kind != c.LM_P0_NODE_STRUCTURE || f1\value\as = 0
        return: 0
    if: f2\value = 0 || f2\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f2\value\as\atom) = 0
        return: 0
    if: f3\value = 0 || f3\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_text_eq(f3\value\as\atom, "++") = 0 && l2_text_eq(f3\value\as\atom, "--") = 0
        return: 0
    if: f4\value = 0 || f4\value\kind != c.LM_P0_NODE_STRUCTURE || f4\value\as = 0
        return: 0
return: 1

fn: l2_path_own (int: mi; const: @(LmP0Text left); const: @(LmP0Text right)) int
    int: i 0
    int: hit
    int: for_path
    int: node_path
    hit: -1
    for_path: 0
    node_path: 0
    if: mi < 0 || left = 0 || right = 0
        return: -1
    if: l2_text_eq(left, "for") != 0
        for_path: 1
    if: l2_text_eq(left, "node") != 0
        node_path: 1
    if: for_path = 0 && node_path = 0
        return: -1
    while: i < l2_own_n
        if: for_path != 0 && l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], right) && l2_own_host[i] != 0 && l2_frame_head(l2_own_host[i], "for") && hit >= 0
            return: -1
        if: for_path != 0 && l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], right) && l2_own_host[i] != 0 && l2_frame_head(l2_own_host[i], "for")
            hit: i
        if: node_path != 0 && l2_own_mi[i] = mi && l2_own_host[i] = 0 && l2_text_same(l2_own_name[i], right) && hit >= 0
            return: -1
        if: node_path != 0 && l2_own_mi[i] = mi && l2_own_host[i] = 0 && l2_text_same(l2_own_name[i], right)
            hit: i
        i: i + 1
return: hit

fn: l2_slot_decl_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    @: LmP0Field g
    if: l2_frame_head(stmt, "@") = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_ident(g\value\as\atom) = 0
        return: 0
    if: l2_text_eq(f\value\as\atom, "char")
        return: 3
    if: l2_text_eq(f\value\as\atom, "LmP0Text")
        return: 5
    if: l2_text_eq(f\value\as\atom, "size_t")
        return: 9
    if: l2_text_eq(f\value\as\atom, "LmP0IndentStack")
        l2_need_p0: 1
        return: 14
return: 0

fn: l2_slot_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_sn[mi]
        if: l2_text_same(l2_sn[l2_slot_off(mi, i)], t)
            return: i
        i: i + 1
return: -1

fn: l2_is_char_decl (const: @(LmP0Node stmt)) int
    if: l2_own_decl_ty(stmt) != 0
        return: 1
    if: l2_slot_decl_ty(stmt) != 0
        return: 1
return: 0

fn: l2_is_plus (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "+") || l2_text_eq(t, "/") || l2_text_eq(t, "-") || l2_text_eq(t, "*")
        return: 1
return: 0

fn: l2_is_cmp (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "<") || l2_text_eq(t, ">") || l2_text_eq(t, "=") || l2_text_eq(t, "!=") || l2_text_eq(t, "<=") || l2_text_eq(t, ">=")
        return: 1
return: 0

fn: l2_is_andor (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "&&") || l2_text_eq(t, "||")
        return: 1
return: 0

fn: l2_is_brack (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "[") || l2_text_eq(t, "]")
        return: 1
return: 0

fn: l2_is_slash (const: @(LmP0Text t)) int
    if: t = 0 || t\length != 1U
        return: 0
    if: t\data[0] != 92
        return: 0
return: 1

fn: l2_is_known (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "c.strlen") || l2_text_eq(t, "c.memcmp") || l2_text_eq(t, "l2_immut_query_fill") || l2_text_eq(t, "l2_hash_compare_q")
        return: 1
    if: l2_text_eq(t, "c.sizeof") || l2_text_eq(t, "lm_own_new_zero") || l2_text_eq(t, "lm_own_copy_bytes") || l2_text_eq(t, "lm_own_delete")
        return: 1
    if: l2_text_eq(t, "lm_own_resize") || l2_text_eq(t, "c.memset") || l2_text_eq(t, "c.memcpy")
        return: 1
    if: l2_text_eq(t, "c.lm_p0_set_diagnostic")
        l2_need_p0: 1
        l2_need_diag: 1
        return: 1
    if: l2_text_eq(t, "c.printf") || l2_text_eq(t, "c.fputs") || l2_text_eq(t, "c.fprintf") || l2_text_eq(t, "c.fflush") || l2_text_eq(t, "c.setvbuf")
        return: 1
return: 0

fn: l2_is_binop (const: @(LmP0Text t)) int
    if: l2_is_plus(t) || l2_is_cmp(t) || l2_is_andor(t)
        return: 1
return: 0

fn: l2_node_has_call (const: @(LmP0Node node)) int
    @: LmP0Field f
    if: node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && (l2_find_method(node\as\frame\head) >= 0 || l2_is_known(node\as\frame\head))
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0
        return: l2_fields_has_call(node\as\frame\body\first_field, l2_count_active(node\as\frame\body))
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        return: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
return: 0

fn: l2_fields_has_call (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i
    f: l2_next_active(field)
    i: 0
    while: i < n && f != 0
        if: l2_node_has_call(f\value)
            return: 1
        f: l2_next_active(f\next)
        i: i + 1
return: 0

fn: l2_is_or_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "||")

fn: l2_is_and_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "&&")

fn: l2_advance (@: LmP0Field f; int: k) @: LmP0Field
    int: i 0
    while: i < k && f != 0
        f: l2_next_active(f\next)
        i: i + 1
return: f

fn: l2_span_or (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_or_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_span_and (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_and_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_bump_ind (const: @(char ind); @: char dest) int
    size_t: ln
    if: dest = 0 || ind = 0
        return: 1
    ln: c.strlen(ind)
    if: ln + 5U >= 64U
        return: 1
    c.memcpy(dest, ind, ln)
    dest[ln]: 32
    dest[ln + 1U]: 32
    dest[ln + 2U]: 32
    dest[ln + 3U]: 32
    dest[ln + 4U]: 0
return: 0

fn: l2_new_temp (const: @(char ind); @: char dest) int
    int: t
    if: dest = 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_bool_set (const: @(char ind); const: @(char dest); const: @(char rhs)) int
    if: dest = 0 || rhs = 0 || ind = 0
        return: 1
    if: c.fprintf(l2_out, "%s%s: (%s) != 0\n", ind, dest, rhs) < 0
        return: 1
return: 0

fn: l2_eval_cond (@: LmP0Field field; int: n; int: mi; const: @(char ind); const: @(char dest)) int
    c.array: [256]: char scratch
    if: dest = 0
        return: 1
    scratch[0]: 0
    if: l2_eval_fields(field, n, mi, ind, scratch) != 0
        return: 1
return: l2_bool_set(ind, dest, scratch)

fn: l2_intern_prove (const: @(char path); const: @(LmP0Node node)) int
    unsigned: id
    int: two
    if: l2_mul3_ok(2U, 3U, 4U) = 0
        return: l2_error(path, node, "intern broken")
    if: l2_mul3_ok((cast: (size_t) -1), 2U, 1U) != 0
        return: l2_error(path, node, "intern broken")
    if: l2_m_n = 0
        return: 0
    id: l2_m_sig[0]
    l2_intern_again: l2_intern_mi(0)
    if: l2_intern_again = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: l2_intern_again = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: id = 0U || l2_intern_again != id
        return: l2_error(path, node, "intern broken")
    l2_intern_swap: 0U
    two: 0
    if: l2_m_arity[0] = 2 && l2_m_f0[0] != 0 && l2_m_f1[0] != 0
        two: 1
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0
        l2_intern_swap: l2_intern_pair(l2_m_f1[0]\data, l2_m_f1[0]\length, l2_m_f0[0]\data, l2_m_f0[0]\length)
    if: two != 0 && l2_intern_swap = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: two != 0 && l2_intern_swap = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0 && (l2_intern_swap = 0U || l2_intern_swap = id)
        return: l2_error(path, node, "intern failed to distinguish swapped formals")
    l2_intern_probe: l2_intern_pair("a", 1U, "b", 1U)
    if: l2_intern_probe = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: l2_intern_probe = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: l2_intern_probe = 0U
        return: l2_error(path, node, "intern table full")
    if: two != 0 && l2_text_eq(l2_m_f0[0], "a") && l2_text_eq(l2_m_f1[0], "b") && l2_ft(0, 0) = 0 && l2_intern_probe != id
        return: l2_error(path, node, "intern failed memcmp of equal names")
    if: two != 0 && (l2_text_eq(l2_m_f0[0], "a") = 0 || l2_text_eq(l2_m_f1[0], "b") = 0 || l2_ft(0, 0) != 0) && l2_intern_probe = id
        return: l2_error(path, node, "intern false-equal distinct contracts")
    l2_sigv: id
return: 0

fn: l2_end_text (const: @(LmP0Frame frame); const: @(LmP0Text name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0 || name = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_same(field\value\as\atom, name)

fn: l2_int_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_name[0]: 0
    if: node = 0 || node\as = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int") = 0 && l2_frame_head(node, "char") = 0 && l2_frame_head(node, "size_t") = 0 && l2_frame_head(node, "LmP0TrailerRole") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f\value = 0 || f\value\as = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_name[0]: f\value\as\atom
return: 0

fn: l2_typed_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name; @: int out_ty) int
    @: LmP0Field f
    @: LmP0Field g
    const: @: LmP0Node inner
    if: out_ty = 0 || out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int")
        out_ty[0]: 0
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "char")
        out_ty[0]: 1
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "size_t")
        out_ty[0]: 2
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "LmP0TrailerRole")
        out_ty[0]: 10
        l2_need_p0: 1
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "@@")
        if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 2
            return: l2_error(path, node, "incompatible entry signature")
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, node, "incompatible entry signature")
        if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        if: l2_text_eq(f\value\as\atom, "char")
            out_ty[0]: 17
            out_name[0]: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "void")
            out_ty[0]: 18
            out_name[0]: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "int")
            out_ty[0]: 19
            out_name[0]: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "size_t")
            out_ty[0]: 20
            out_name[0]: g\value\as\atom
            return: 0
        return: l2_error(path, node, "unknown foreign type")
    if: l2_frame_head(node, "@")
        if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 2
            return: l2_error(path, node, "incompatible entry signature")
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, node, "incompatible entry signature")
        if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        if: l2_text_eq(f\value\as\atom, "size_t")
            out_ty[0]: 9
            out_name[0]: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "int")
            out_ty[0]: 11
            out_name[0]: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "char")
            out_ty[0]: 12
            out_name[0]: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmP0Document")
            l2_need_p0: 1
            out_ty[0]: 13
            out_name[0]: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmP0IndentStack")
            l2_need_p0: 1
            out_ty[0]: 14
            out_name[0]: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "void")
            out_ty[0]: 16
            out_name[0]: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmP0Text") = 0 && l2_text_eq(f\value\as\atom, "L2ImmutQuery") = 0
            return: l2_error(path, node, "unknown foreign type")
        if: l2_text_eq(f\value\as\atom, "LmP0Text")
            l2_need_p0: 1
            out_ty[0]: 5
        if: l2_text_eq(f\value\as\atom, "L2ImmutQuery")
            l2_need_query: 1
            out_ty[0]: 7
        out_name[0]: g\value\as\atom
        return: 0
    if: l2_frame_head(node, "const") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    inner: l2_next_active(node\as\frame\body\first_field)\value
    if: l2_frame_head(inner, "@") = 0 || inner\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_count_active(inner\as\frame\body) != 2
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(inner\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_text_eq(f\value\as\atom, "char") = 0 && l2_text_eq(f\value\as\atom, "LmP0Text") = 0 && l2_text_eq(f\value\as\atom, "L2ImmutQuery") = 0 && l2_text_eq(f\value\as\atom, "LmP0IndentStack") = 0
        return: l2_error(path, node, "unknown foreign type")
    if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_text_eq(f\value\as\atom, "char")
        out_ty[0]: 3
    if: l2_text_eq(f\value\as\atom, "LmP0Text")
        out_ty[0]: 4
        l2_need_p0: 1
    if: l2_text_eq(f\value\as\atom, "L2ImmutQuery")
        out_ty[0]: 6
        l2_need_query: 1
    if: l2_text_eq(f\value\as\atom, "LmP0IndentStack")
        out_ty[0]: 15
        l2_need_p0: 1
    out_name[0]: g\value\as\atom
return: 0

fn: l2_collect_method (const: @(LmP0Node fn_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node params
    const: @: LmP0Node body
    @: LmP0Field p
    @: LmP0Text fa 0
    @: LmP0Text nm 0
    unsigned: id
    int: ar
    int: j
    int: ty
    int: k
    int: is_sub 0
    int: sn 0
    const: @: LmP0Node rty
    if: fn_node = 0 || fn_node\as = 0 || fn_node\as\frame = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: l2_m_n >= c.INT_MAX
        l2_alloc_err: 2
        return: l2_error(path, fn_node, "size overflow")
    if: l2_meth_reserve(l2_m_n + 1) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, fn_node, "size overflow")
        return: l2_error(path, fn_node, "out of memory")
    fr: fn_node\as\frame
    if: l2_frame_head(fn_node, "sub")
        is_sub: 1
    k: 0
    if: fr\body != 0
        k: l2_count_active(fr\body)
    if: is_sub = 0 && k != 4 && (k != 3 || l2_ret_tr(fr) = 0)
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub != 0 && k != 3 && (k != 2 || l2_ret_tr(fr) = 0)
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_ident(field\value\as\atom) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    nm: field\value\as\atom
    if: fr\trailer != 0 && l2_text_eq(fr\trailer\spelling, "end") = 0 && l2_text_eq(fr\trailer\spelling, "return") = 0
        return: l2_error(path, fn_node, "unsupported trailer")
    if: is_sub = 0 && l2_fn_close(fr, nm, "fn") != 0
        return: l2_error(path, fn_node, "end target does not match close target")
    if: is_sub != 0 && l2_fn_close(fr, nm, "sub") != 0
        return: l2_error(path, fn_node, "end target does not match close target")
    if: l2_find_method(nm) >= 0
        return: l2_error(path, fn_node, "duplicate definition")
    if: nm\length >= 63U
        return: l2_error(path, fn_node, "name too long")
    field: l2_next_active(field\next)
    params: field\value
    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE || params\as = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: params\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    ar: l2_count_active(params\as\structure)
    if: ar < 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_formals_alloc(l2_m_n, ar) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, fn_node, "size overflow")
        return: l2_error(path, fn_node, "out of memory")
    p: l2_next_active(params\as\structure\first_field)
    j: 0
    while: j < ar
        ty: 0
        fa: 0
        if: p = 0 || l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            l2_free_method(l2_m_n)
            return: 1
        if: fa = 0 || fa\length >= 63U
            l2_free_method(l2_m_n)
            return: l2_error(path, fn_node, "name too long")
        k: 0
        while: k < j
            if: l2_text_same(fa, l2_fn(l2_m_n, k))
                l2_free_method(l2_m_n)
                return: l2_error(path, p\value, "duplicate formal")
            k: k + 1
        if: l2_fn_set(l2_m_n, j, fa) != 0 || l2_ft_set(l2_m_n, j, ty) != 0
            l2_free_method(l2_m_n)
            return: l2_error(path, fn_node, "out of memory")
        p: l2_next_active(p\next)
        j: j + 1
    l2_m_arity[l2_m_n]: ar
    l2_m_dyn[l2_m_n]: 0
    l2_m_f0[l2_m_n]: 0
    l2_m_f1[l2_m_n]: 0
    if: ar >= 1
        l2_m_f0[l2_m_n]: l2_fn(l2_m_n, 0)
    if: ar >= 2
        l2_m_f1[l2_m_n]: l2_fn(l2_m_n, 1)
    field: l2_next_active(field\next)
    if: is_sub != 0
        l2_m_ret[l2_m_n]: 8
    if: is_sub = 0 && field\value = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "int")
        l2_m_ret[l2_m_n]: 0
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "size_t")
        l2_m_ret[l2_m_n]: 2
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "LmP0TrailerRole")
        l2_m_ret[l2_m_n]: 10
        l2_need_p0: 1
    if: is_sub = 0 && l2_frame_head(field\value, "@")
        if: field\value\as\frame\body = 0 || l2_count_active(field\value\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rty: l2_next_active(field\value\as\frame\body\first_field)\value
        if: rty = 0 || rty\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, fn_node, "incompatible entry signature")
        if: l2_text_eq(rty\as\atom, "char")
            l2_m_ret[l2_m_n]: 3
        if: l2_text_eq(rty\as\atom, "LmP0Text")
            l2_m_ret[l2_m_n]: 5
            l2_need_p0: 1
        if: l2_text_eq(rty\as\atom, "LmP0IndentStack")
            l2_m_ret[l2_m_n]: 13
            l2_need_p0: 1
        if: l2_text_eq(rty\as\atom, "char") = 0 && l2_text_eq(rty\as\atom, "LmP0Text") = 0 && l2_text_eq(rty\as\atom, "LmP0IndentStack") = 0
            return: l2_error(path, fn_node, "unknown foreign type")
        ---
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "int") = 0 && l2_text_eq(field\value\as\atom, "size_t") = 0 && l2_text_eq(field\value\as\atom, "LmP0TrailerRole") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0 && field\value\kind != c.LM_P0_NODE_ATOM && l2_frame_head(field\value, "@") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0
        field: l2_next_active(field\next)
    body: 0
    if: field != 0
        body: field\value
    if: body = 0 && l2_ret_tr(fr) = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: body != 0 && (body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0)
        return: l2_error(path, fn_node, "unsupported body")
    if: body != 0 && body\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    l2_m_name[l2_m_n]: nm
    l2_m_node[l2_m_n]: (cast: (@: LmP0Node) fn_node)
    l2_m_body[l2_m_n]: (cast: (@: LmP0Node) body)
    l2_m_sig[l2_m_n]: 0U
    l2_m_own[l2_m_n]: 0
    l2_m_sn[l2_m_n]: 0
    if: body != 0 && l2_collect_decls(body\as\structure, l2_m_n, path, 0, @ sn) != 0
        return: 1
    l2_m_sn[l2_m_n]: sn
    l2_m_n: l2_m_n + 1
return: 0

fn: l2_check_primary (const: @(LmP0Node node); int: mi; const: @(char path)) int
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    int: idx
    if: node = 0
        return: l2_error(path, node, "unsupported body")
    if: node\kind = c.LM_P0_NODE_ATOM
        if: l2_num(node\as\atom)
            return: 0
        if: l2_quoted(node\as\atom)
            return: 0
        if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
            return: 0
        if: l2_ident(node\as\atom) = 0
            return: l2_error(path, node, "unsupported body")
        if: mi >= 0 && l2_param_find(mi, node\as\atom) >= 0
            return: 0
        if: l2_entry_find(node\as\atom) >= 0
            return: 0
        if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
            return: 0
        if: mi >= 0
            idx: l2_own_find(mi, node\as\atom)
            if: idx >= 0 && l2_m_uses[l2_own_off(mi, idx)] != 0
                return: 0
            ---
        if: mi >= 0 && l2_slot_find(mi, node\as\atom) >= 0
            return: 0
        return: l2_error(path, node, "unresolved name")
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "@")
        return: l2_check_addr(node, mi, path)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        return: l2_check_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, path, node)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: l2_error(path, node, "unsupported body")
    if: l2_frame_head(node, "while") || l2_frame_head(node, "for") || l2_frame_head(node, "continue") || l2_frame_head(node, "break")
        return: l2_error(path, node, "unsupported loop")
    if: l2_frame_head(node, "if") || l2_frame_head(node, "else") || l2_frame_head(node, "return") || l2_frame_head(node, "fn")
        return: l2_error(path, node, "unsupported body")
    call: node\as\frame
    if: call\head = 0
        return: l2_error(path, node, "unknown method")
    idx: l2_find_method(call\head)
    if: idx < 0 && l2_text_eq(call\head, "c.sizeof")
