fn: l2_check_addr (const: @(LmP0Node node); int: mi; const: @(char path)) int
    @: LmP0Field f
    const: @: LmP0Text t
    int: idx
    int: oi
    if: node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    t: f\value\as\atom
    idx: -1
    if: mi >= 0
        idx: l2_param_find(mi, t)
    if: idx >= 0 && (l2_ft(mi, idx) = 9 || l2_ft(mi, idx) = 11 || l2_ft(mi, idx) = 12)
        return: l2_error(path, node, "unsupported address depth")
    if: idx >= 0 && (l2_ft(mi, idx) = 0 || l2_ft(mi, idx) = 1 || l2_ft(mi, idx) = 2)
        return: 0
    oi: -1
    if: mi >= 0
        oi: l2_own_find(mi, t)
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && (l2_own_ty[oi] = 0 || l2_own_ty[oi] = 1 || l2_own_ty[oi] = 2)
        return: 0
