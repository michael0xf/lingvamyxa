fn: l2_ml_find (const: @(LmP0Text t)) int
    int: i 0
    if: t = 0 || l2_ml_nm = 0
        return: 0 - 1
    while: i < l2_ml_n
        if: l2_text_same(l2_ml_nm[i], t)
            return: i
        i: i + 1
    ---
return: 0 - 1

fn: l2_ml_array_head (const: @(LmP0Text t)) int
    int: i 0
    @: LmP0Text name
    if: t = 0 || l2_ml_nm = 0 || l2_ml_ty = 0
        return: 0 - 1
    while: i < l2_ml_n
        name: l2_ml_nm[i]
        if: l2_ml_ty[i] = 22 && name != 0 && t\length > name\length && t\data[name\length] = 91 && c.memcmp(name\data, t\data, name\length) = 0
            return: i
        i: i + 1
return: 0 - 1

fn: l2_ml_add (const: @(LmP0Text t); int: ty; const: @(char path); const: @(LmP0Node at)) int
    @@: LmP0Text nn
    @: int nt
    size_t: want
    if: t = 0 || l2_ident(t) = 0
        return: l2_error(path, at, "unsupported body")
    want: (cast: (size_t) (l2_ml_n + 1))
    nn: (cast: (@@: LmP0Text) c.realloc((cast: (@: void) l2_ml_nm), want * c.sizeof(@: void)))
    if: nn = 0
        return: l2_error(path, at, "out of memory")
    l2_ml_nm: nn
    nt: (cast: (@: int) c.realloc((cast: (@: void) l2_ml_ty), want * c.sizeof(c.int)))
    if: nt = 0
        return: l2_error(path, at, "out of memory")
    l2_ml_ty: nt
    l2_ml_nm[l2_ml_n]: (cast: (@: LmP0Text) t)
    l2_ml_ty[l2_ml_n]: ty
    l2_ml_n: l2_ml_n + 1
return: 0

# The ONE deterministic collection of a method body's local declarations, so
# scan, check and emit see identical names and type codes. Descends into
# nested executable bodies because the other phases do.
fn: l2_ml_collect (const: @(LmP0Structure body); const: @(char path)) int
    @: LmP0Field field
    @: LmP0Field inner
    @: LmP0Node stmt
    @: LmP0Text nm 0
    @: LmP0Text count 0
    int: ty 0
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        # An address slot is not an activation local: @: char and its
        # companions in a method body are the 11.2.1 slot form and are
        # declared by the method preamble, not by this table.
        nm: 0
        count: 0
        if: l2_array_local(stmt, @ nm, @ count) = 0
            if: l2_ml_find(nm) < 0 && l2_ml_add(nm, 22, path, stmt) != 0
                return: 1
            ---
        else:
            if: l2_slot_decl_ty(stmt) = 0 && l2_ptr_local_ty(stmt, @ nm, @ ty) = 0 && l2_ml_find(nm) < 0 && l2_ml_add(nm, ty, path, stmt) != 0
                return: 1
            if: l2_const_local_ty(stmt, @ nm, @ ty) = 0 && l2_ml_find(nm) < 0 && l2_ml_add(nm, ty, path, stmt) != 0
                return: 1
            if: l2_fnptr_local(stmt, @ nm) = 0 && l2_ml_find(nm) < 0 && l2_ml_add(nm, 40, path, stmt) != 0
                return: 1
            if: l2_struct_local(stmt, @ nm) = 0 && l2_ml_find(nm) < 0 && l2_ml_add(nm, 41, path, stmt) != 0
                return: 1
            ---
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            inner: l2_next_active(stmt\as\frame\body\first_field)
            while: inner != 0
                if: inner\value != 0 && inner\value\kind = c.LM_P0_NODE_STRUCTURE && inner\value\as != 0 && l2_ml_collect(inner\value\as\structure, path) != 0
                    return: 1
                inner: l2_next_active(inner\next)
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# Clear, then collect. Separate from the recursive collector so a nested body
# cannot erase what its parent registered.
fn: l2_ml_rebuild (const: @(LmP0Structure body); const: @(char path)) int
    l2_ml_free()
return: l2_ml_collect(body, path)

fn: l2_loc_free () int
    if: l2_loc_nm != 0
