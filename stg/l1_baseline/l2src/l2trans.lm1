    if: mi >= 0 && oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && c.sprintf(dest, "l2_q%d", oi) < 0
        return: 1
    if: mi >= 0 && oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        return: 0
    child: l2_own_first(nm)
    if: child < 0 || l2_own_uchild[child] < 0 || l2_call_node = 0
        return: 1
