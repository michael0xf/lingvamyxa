            if: l2_loc_nm[k] != 0 && l2_loc_nm[k]\length = n - lb - 2U && c.memcmp(l2_loc_nm[k]\data, t\data + lb + 1U, n - lb - 2U) = 0 && (l2_loc_ty[k] = 0 || l2_loc_ty[k] = 1 || l2_loc_ty[k] = 2 || l2_loc_ty[k] = 3 || l2_loc_ty[k] = 10 || l2_loc_ty[k] = 34)
                ok: 1
