    l2_loc_cap: 0
return: 0

fn: l2_loc_find (const: @(LmP0Text t)) int
    int: i 0
    if: t = 0 || l2_loc_nm = 0
        return: -1
    while: i < l2_loc_n
        if: l2_text_same(l2_loc_nm[i], t)
            return: i
        ---
        i: i + 1
return: -1

fn: l2_pd_push (const: @(LmP0Text t); const: @(char path); const: @(LmP0Node at)) int
    int: cap
    size_t: nb
    size_t: psz
    @@: LmP0Text nn 0
    if: t = 0
        return: l2_error(path, at, "unsupported argument")
    cap: l2_pd_cap
    if: l2_pd_n >= cap
        if: cap < 1
            cap: 4
        ---
        if: cap > (c.INT_MAX / 2)
            return: l2_error(path, at, "size overflow")
        cap: cap * 2
        psz: c.sizeof(l2_ptr_probe)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0
            return: l2_error(path, at, "size overflow")
        nb: (cast: (size_t) cap) * psz
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        if: nn = 0
            return: l2_error(path, at, "out of memory")
        c.memset((cast: (@: void) nn), 0, nb)
        if: l2_pd != 0 && l2_pd_n > 0
            c.memcpy((cast: (@: void) nn), (cast: (@: void) l2_pd), (cast: (size_t) l2_pd_n) * psz)
        ---
        if: l2_pd != 0
            l2_xfree((cast: (@: void) l2_pd))
        ---
        l2_pd: nn
        l2_pd_cap: cap
    ---
    l2_pd[l2_pd_n]: (cast: (@: LmP0Text) t)
    l2_pd_n: l2_pd_n + 1
return: 0

fn: l2_def_push (const: @(LmP0Node item); const: @(char path)) int
