return: -1

fn: l2_own_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: t = 0
        return: -1
    if: mi >= 0
        while: i < l2_own_n
            if: l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], t) && l2_own_host[i] = 0
                return: i
            if: l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], t) && l2_scope_has(l2_own_host[i])
                return: i
            i: i + 1
        ---
    ---
    # A unit field is a child of the lexical root and is visible through the
    # callable's node chain.  Prefer a method/body occurrence above; only then
    # fall back to the unit occurrence with owner -1.
    i: 0
    while: i < l2_own_n
        if: l2_own_mi[i] < 0 && l2_own_host[i] = 0 && l2_text_same(l2_own_name[i], t)
            return: i
        i: i + 1
return: -1

fn: l2_own_find_host (int: mi; const: @(LmP0Text t); const: @(LmP0Node host)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_own_host[i] = host && l2_text_same(l2_own_name[i], t)
            return: i
        i: i + 1
return: -1

