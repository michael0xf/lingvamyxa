const: @: char l2_call_node 0
# Set while one call is being written: 1 when the callee was selected through
# a field path, so the reserved argument is the Structure in l2_pst.
int: l2_call_sel 0
int: l2_call_mi 0
int: l2_call_k 0
# How to spell the program unit Structure in the code being emitted right now.
# At program entry it is the local "unit"; inside a method body the reserved
# argument is that callable's own Structure M, whose lexical parent is the unit,
# so the unit is reached as node\node. Shared own fields live in the unit; a
# method's own fields live in M.
const: @: char l2_unit_ref 0
# Translation-known independent: const: immutable branch roots (SPEC 9.1.4,
# 7173). Each is a Structure built with node = 0 and retained by the first
# Message's fixed ARRAY_OF_LMX array. The set is closed at translation; nothing
# appends at runtime. Only size_t leaves are admitted at this stage.
int: l2_ebr_n 0
int: l2_merge_max 0
int: l2_merge_n 0
int: l2_mres_n 0
@@: LmP0Text l2_mres_name 0
int: l2_mres_base 0
@: int l2_mres_width 0
# Ordinary named Structures declared at unit level (SPEC 19.17 example, Codex
# decision 232413, option a): an otherwise unrecognized unit-level frame with a
# matching end is a declaration. Unused is valid. One unit child each, in
# source order, node = the unit.
int: l2_ns_n 0
@@: LmP0Text l2_ns_name 0
@: int l2_ns_first 0
@: int l2_ns_count 0
int: l2_ns_base 0
int: l2_nsf_n 0
@: size_t l2_nsf_val 0
# Field kinds: 0 size_t literal, 1 char literal (an interned cell pointer),
# 2 an inline nested Structure built in place, 3 a reference to an earlier
# named Structure shared by pointer. l2_nsf_ref indexes l2_ns for 2 and 3.
@: int l2_nsf_kind 0
@: int l2_nsf_ref 0
@: int l2_nsf_owner 0
# -1 for a unit-level declaration; otherwise the l2_ns index of the
# containing Structure, which is also its node.
@: int l2_ns_parent 0
# 1 once a declaration's body is fully read. A reference field may only name a
# COMPLETED earlier unit-level declaration: without this an entry could name
# itself or an enclosing one and close a cycle through the unit graph.
# The name a reference field was written with. Resolution is DEFERRED to a pass
# over the whole unit, so a reference may name a declaration that appears later,
# its own declaration, an enclosing one, or a nested one: the graph model admits
# aliases and cycles and the copier preserves them. Only an unknown or an
# ambiguous name is an error.
# Which qualified branch this entry belongs to, or -1 for an ordinary
# declaration. A qualified entry is NOT an ordinary unit child: its root is
# built with node = 0 and every owned range inside it is admitted.
@: int l2_ns_eternal 0
@@: LmP0Text l2_nsf_name 0
# The name the field itself was declared with, which is what a source field
# path spells.
@@: LmP0Text l2_nsf_fname 0
int: l2_ns_has_char 0
# Set when any declaration holds an array field. The emitted call needs its
# emitted predef under the SAME condition: without it the constructor is
# called with no prototype and its pointer is truncated to int.
int: l2_ns_has_array 0
@: int l2_m_throws 0
@: size_t l2_mres_first 0
@: size_t l2_mres_last 0
@: int l2_mres_fok 0
@: int l2_mres_lok 0
# One row per RESULT SLOT, in result order: which bound result it belongs to,
# the name the contributing field was declared with, that field's kind, and the
# entry a nested or reference field names. The merged result has no names of its
# own, so a source field path is resolved through the field that CONTRIBUTED the
# slot. A qualified-branch operand contributes one anonymous row.
@: int l2_mrs_res 0
@@: LmP0Text l2_mrs_name 0
@: int l2_mrs_kind 0
@: int l2_mrs_ent 0
int: l2_mrs_n 0
int: l2_ebr_cap 0
@@: LmP0Text l2_ebr_name 0
@@: LmP0Text l2_ebr_leaf 0
@: size_t l2_ebr_val 0
# Which method's body is being emitted, or -1 for the program entry. Only that
# method reaches its own fields through the reserved argument; anyone else must
# select the owning callable's Structure out of the unit first.
int: l2_cur_mi 0 - 1
