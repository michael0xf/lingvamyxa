        return: 1
    i: 0
    while: i < l2_m_n
        l2_m_mark[i]: 0
        i: i + 1
    i: 0
    while: i < l2_m_n
        if: l2_dfs(i) != 0
            return: l2_error(path, l2_m_node[i], "unsupported recursion")
        i: i + 1
