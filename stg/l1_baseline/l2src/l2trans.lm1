    if: ty = 28 && ((n = 4U && c.memcmp(name, "root", 4U) = 0) || (n = 5U && c.memcmp(name, "slots", 5U) = 0) || (n = 1U && c.memcmp(name, "n", 1U) = 0) || (n = 9U && c.memcmp(name, "transport", 9U) = 0) || (n = 14U && c.memcmp(name, "transport_tail", 14U) = 0) || (n = 9U && c.memcmp(name, "host_head", 9U) = 0) || (n = 9U && c.memcmp(name, "host_tail", 9U) = 0) || (n = 9U && c.memcmp(name, "host_sync", 9U) = 0) || (n = 4U && c.memcmp(name, "exec", 4U) = 0) || (n = 9U && c.memcmp(name, "next_addr", 9U) = 0) || (n = 5U && c.memcmp(name, "clock", 5U) = 0) || (n = 10U && c.memcmp(name, "clock_test", 10U) = 0) || (n = 8U && c.memcmp(name, "root_seq", 8U) = 0))
