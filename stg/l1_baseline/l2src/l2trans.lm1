fn: l2_check_fields (@: LmP0Field field; int: n; int: mi; const: @(char path); const: @(LmP0Node at)) int
    @: LmP0Field f
    @: LmP0Field p1
    @: LmP0Field p2
    int: i
    int: skip
    int: after 0
    int: po
    if: n <= 0
        return: l2_error(path, at, "unsupported body")
    f: l2_next_active(field)
    i: 0
    while: i < n
        if: f = 0 || f\value = 0
            return: l2_error(path, at, "unsupported body")
        skip: 0
        p1: 0
        p2: 0
        po: -1
        if: f\value\kind = c.LM_P0_NODE_ATOM
            p1: l2_next_active(f\next)
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
