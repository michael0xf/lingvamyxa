            return: 1
        a0: l2_next_active(call\body\first_field)
        if: a0 = 0 || a0\value = 0 || a0\value\kind != c.LM_P0_NODE_ATOM
            return: 1
        if: l2_text_eq(a0\value\as\atom, "LmP0Text") = 0 && l2_text_eq(a0\value\as\atom, "c.LmP0Text") = 0
            return: 1
        if: c.sprintf(dest, "c.sizeof(c.LmP0Text)") < 0
            return: 1
        return: 0
    if: idx < 0 && l2_text_eq(call\head, "lm_own_new_zero")
        l2_need_own: 1
        if: call\body = 0
            return: 1
        if: l2_emit_fields(call\body\first_field, l2_count_active(call\body), mi, ind, s0) != 0
            return: 1
        if: l2_emit_checkpoint(mi, ind) != 0
            return: 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%s@: LmP0Text l2_t%d\n%sl2_t%d: (cast: (@: LmP0Text) lm_own_new_zero(%s))\n", ind, t, ind, t, s0) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    if: idx < 0 && l2_text_eq(call\head, "lm_own_copy_bytes")
        l2_need_own: 1
        if: call\body = 0
            return: 1
        a0: l2_next_active(call\body\first_field)
        s0[0]: 0
        s1[0]: 0
        t: 0
        while: a0 != 0 && t < 2
            n: 1
            if: t = 0 && l2_prep(a0\value, mi, ind, s0) != 0
                return: 1
            if: t = 1 && l2_prep(a0\value, mi, ind, s1) != 0
                return: 1
            a0: l2_next_active(a0\next)
            t: t + 1
        if: l2_emit_checkpoint(mi, ind) != 0
            return: 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%s@: char l2_t%d\n%sl2_t%d: lm_own_copy_bytes(%s, %s)\n", ind, t, ind, t, s0, s1) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    if: idx < 0 && l2_text_eq(call\head, "lm_own_delete")
        l2_need_own: 1
        if: call\body = 0
            return: 1
        a0: l2_next_active(call\body\first_field)
        s0[0]: 0
        s1[0]: 0
        t: 0
        while: a0 != 0 && t < 2
            if: t = 0 && l2_prep(a0\value, mi, ind, s0) != 0
                return: 1
            if: t = 1 && l2_prep(a0\value, mi, ind, s1) != 0
                return: 1
            a0: l2_next_active(a0\next)
            t: t + 1
        if: l2_emit_checkpoint(mi, ind) != 0
            return: 1
        if: c.fprintf(l2_out, "%slm_own_delete(%s, %s)\n", ind, s0, s1) < 0
            return: 1
        dest[0]: 0
        return: 0
    if: idx < 0 && l2_text_eq(call\head, "c.strlen")
        if: call\body = 0
            return: 1
        s0[0]: 0
        if: l2_emit_fields(call\body\first_field, l2_count_active(call\body), mi, ind, s0) != 0
            return: 1
        if: l2_emit_checkpoint(mi, ind) != 0
            return: 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: c.strlen(%s)\n", ind, t, ind, t, s0) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    if: idx < 0 && l2_text_eq(call\head, "c.memcmp")
        if: call\body = 0
            return: 1
        a0: l2_next_active(call\body\first_field)
        s0[0]: 0
        s1[0]: 0
        s2[0]: 0
        t: 0
        while: a0 != 0 && t < 3
            n: 1
            a1: 0
            if: a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && l2_ident(a0\value\as\atom)
                a1: l2_next_active(a0\next)
            if: a1 != 0 && a1\value != 0 && a1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(a1\value\as\atom)
                n: 3
            if: t = 0 && l2_emit_fields(a0, n, mi, ind, s0) != 0
                return: 1
            if: t = 1 && l2_emit_fields(a0, n, mi, ind, s1) != 0
                return: 1
            if: t = 2 && l2_emit_fields(a0, n, mi, ind, s2) != 0
                return: 1
            k: 0
            while: k < n
                a0: l2_next_active(a0\next)
                k: k + 1
            t: t + 1
        if: l2_emit_checkpoint(mi, ind) != 0
            return: 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: c.memcmp(%s, %s, %s)\n", ind, t, ind, t, s0, s1, s2) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    if: idx < 0 && l2_text_eq(call\head, "l2_immut_query_fill")
        if: call\body = 0
            return: 1
        a0: l2_next_active(call\body\first_field)
        s0[0]: 0
        s1[0]: 0
        t: 0
        while: a0 != 0 && t < 2
            n: 1
            a1: 0
            if: a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && l2_ident(a0\value\as\atom)
                a1: l2_next_active(a0\next)
            if: a1 != 0 && a1\value != 0 && a1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(a1\value\as\atom)
                n: 3
            if: t = 0 && l2_emit_fields(a0, n, mi, ind, s0) != 0
                return: 1
            if: t = 1 && l2_emit_fields(a0, n, mi, ind, s1) != 0
                return: 1
            k: 0
            while: k < n
                a0: l2_next_active(a0\next)
                k: k + 1
            t: t + 1
        if: l2_emit_checkpoint(mi, ind) != 0
            return: 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: l2_immut_query_fill(%s, %s)\n", ind, t, ind, t, s0, s1) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    if: idx < 0 && l2_text_eq(call\head, "l2_hash_compare_q")
        if: call\body = 0
            return: 1
        a0: l2_next_active(call\body\first_field)
        s0[0]: 0
        s1[0]: 0
        t: 0
        while: a0 != 0 && t < 2
            n: 1
            a1: 0
            if: a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && l2_ident(a0\value\as\atom)
                a1: l2_next_active(a0\next)
            if: a1 != 0 && a1\value != 0 && a1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(a1\value\as\atom)
                n: 3
            if: t = 0 && l2_emit_fields(a0, n, mi, ind, s0) != 0
                return: 1
            if: t = 1 && l2_emit_fields(a0, n, mi, ind, s1) != 0
                return: 1
            k: 0
            while: k < n
                a0: l2_next_active(a0\next)
                k: k + 1
            t: t + 1
        if: l2_emit_checkpoint(mi, ind) != 0
            return: 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: l2_hash_compare_q(%s, %s)\n", ind, t, ind, t, s0, s1) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    if: idx < 0
        return: 1
    a0: l2_next_active(call\body\first_field)
    t: 0
    s0[0]: 0
    s1[0]: 0
    s2[0]: 0
    s3[0]: 0
    while: a0 != 0
        if: t = 0 && l2_prep(a0\value, mi, ind, s0) != 0
            return: 1
        if: t = 1 && l2_prep(a0\value, mi, ind, s1) != 0
            return: 1
        if: t = 2 && l2_prep(a0\value, mi, ind, s2) != 0
            return: 1
        if: t = 3 && l2_prep(a0\value, mi, ind, s3) != 0
            return: 1
        t: t + 1
        a0: l2_next_active(a0\next)
    h0[0]: 0
    h1[0]: 0
    h2[0]: 0
    h3[0]: 0
    if: l2_m_dyn[idx] > 0 && l2_hidden_from(mi, idx, 0, ind, h0) != 0
        return: 1
    if: l2_m_dyn[idx] > 1 && l2_hidden_from(mi, idx, 1, ind, h1) != 0
        return: 1
    if: l2_m_dyn[idx] > 2 && l2_hidden_from(mi, idx, 2, ind, h2) != 0
        return: 1
    if: l2_m_dyn[idx] > 3 && l2_hidden_from(mi, idx, 3, ind, h3) != 0
        return: 1
    if: l2_emit_checkpoint(mi, ind) != 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_m_ret[idx] = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n", ind, t) < 0
        return: 1
    if: l2_m_ret[idx] = 3 && c.fprintf(l2_out, "%s@: char l2_t%d\n", ind, t) < 0
        return: 1
    if: l2_m_ret[idx] = 5 && c.fprintf(l2_out, "%s@: LmP0Text l2_t%d\n", ind, t) < 0
        return: 1
    if: l2_m_ret[idx] != 2 && l2_m_ret[idx] != 3 && l2_m_ret[idx] != 5 && l2_m_ret[idx] != 8 && c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: 1
    if: l2_m_ret[idx] = 8 && c.fprintf(l2_out, "%s", ind) < 0
        return: 1
    if: l2_m_ret[idx] != 8 && c.fprintf(l2_out, "%sl2_t%d: ", ind, t) < 0
        return: 1
