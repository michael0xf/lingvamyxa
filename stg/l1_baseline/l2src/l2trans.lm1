    if: l2_m_throws = 0
        return: l2_error(path, main_node, "out of memory")
    i: 0
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            l2_m_throws[i]: l2_body_throws(l2_m_body[i]\as\structure)
        i: i + 1
    ---
    i: 0
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, path) != 0
            return: 1
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_check_body(l2_m_body[i]\as\structure, i, path, 0) != 0
            return: 1
        if: l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_check_ret_tr(i, path, l2_ret_tr(l2_m_node[i]\as\frame), l2_m_node[i]) != 0
            return: 1
        i: i + 1
    if: body != 0 && body\as != 0 && l2_check_body(body\as\structure, -1, path, 0) != 0
        return: 1
    if: l2_check_ret_tr(-1, path, l2_ret_tr(fr), main_node) != 0
        return: 1
    if: l2_throws_close() != 0
        return: 1
    if: l2_dyn_close(path) != 0
        return: 1
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    i: 0
    while: i < l2_m_n
        l2_m_sig[i]: l2_intern_mi(i)
        if: l2_m_sig[i] = 0U && l2_alloc_err = 2
            return: l2_error(path, l2_m_node[i], "size overflow")
        if: l2_m_sig[i] = 0U
            return: l2_error(path, l2_m_node[i], "out of memory")
        i: i + 1
    if: l2_m_n != 0 && l2_intern_prove(path, l2_m_node[0]) != 0
        return: 1
    l2_leaf_mode: 1
return: 0

fn: l2_tok_text (const: @(LmP0Text t); @: char dest; size_t: cap) int
    @: char buf 0
    size_t: n 0U
    int: rc
    if: t = 0 || t\data = 0 || dest = 0 || cap = 0U
        return: 1
    if: l2_triple_q(t) != 0
        if: l2_decode_triple_body(t, @ buf, @ n) != 0
            return: 1
        if: buf = 0
            return: l2_fmt_l1_string(dest, cap, "", 0U)
        rc: l2_fmt_l1_string(dest, cap, buf, n)
        l2_xfree((cast: (@: void) buf))
        return: rc
    if: t\length + 1U > cap
        return: 1
    c.memcpy(dest, t\data, t\length)
    dest[t\length]: 0
return: 0

fn: l2_tok_temp (int: k; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", k) < 0
        return: 1
return: 0

fn: l2_cat (@: char dest; const: @(char src)) int
    size_t: nd
    size_t: ns
    if: dest = 0 || src = 0
        return: 1
    nd: c.strlen(dest)
    ns: c.strlen(src)
    if: nd + ns >= 255U
        return: 1
    c.memcpy(dest + nd, src, ns + 1U)
return: 0

fn: l2_hidden_from (int: mi; int: callee; int: k; const: @(char ind); @: char dest) int
    @: LmP0Text nm
    int: ty
    int: pi
    int: oi
    int: fi
    int: t
    int: child
    @: char deep 0
    if: dest = 0 || callee < 0 || k < 0 || k >= l2_m_dyn[callee]
