return: -1

fn: l2_own_first (const: @(LmP0Text t)) int
    int: i 0
    while: i < l2_own_n
        if: l2_own_host[i] = 0 && l2_text_same(l2_own_name[i], t)
            return: i
        i: i + 1
return: -1

fn: l2_own_add (int: mi; const: @(LmP0Text t); int: ty; const: @(char path); const: @(LmP0Node at); int: shared) int
    int: i
    if: mi < 0 || t = 0 || l2_ident(t) = 0
        if: l2_error(path, at, "incompatible entry signature") != 0
            return: -1
        return: -1
    i: -1
    if: shared != 0
        i: l2_own_first(t)
    if: shared = 0
        i: l2_own_find_host(mi, t, l2_scope_host())
    if: i >= 0 && l2_own_ty[i] != ty
        if: l2_error(path, at, "incompatible entry signature") != 0
            return: -1
        return: -1
    if: i >= 0
        return: i
    if: l2_own_n >= c.INT_MAX
        l2_alloc_err: 2
        if: l2_alloc_or(path, at, "unsupported body") != 0
            return: -1
        return: -1
    if: l2_own_reserve(l2_own_n + 1) != 0
        if: l2_alloc_or(path, at, "unsupported body") != 0
            return: -1
        return: -1
    if: l2_own_n >= l2_own_cap
        l2_alloc_err: 2
        if: l2_alloc_or(path, at, "unsupported body") != 0
            return: -1
        return: -1
    l2_own_name[l2_own_n]: (cast: (@: LmP0Text) t)
    l2_own_ty[l2_own_n]: ty
    l2_own_live[l2_own_n]: 0
    l2_own_mi[l2_own_n]: mi
    l2_own_host[l2_own_n]: l2_scope_host()
    l2_own_fid[l2_own_n]: -1
    l2_own_fchild[l2_own_n]: -1
    l2_own_uchild[l2_own_n]: -1
    if: shared != 0
        l2_own_mi[l2_own_n]: -1
        l2_own_host[l2_own_n]: 0
    l2_own_n: l2_own_n + 1
return: l2_own_n - 1

fn: l2_entry_free () int
    if: l2_entry_nm != 0
        l2_xfree((cast: (@: void) l2_entry_nm))
    if: l2_entry_ty != 0
        l2_xfree((cast: (@: void) l2_entry_ty))
    ---
    l2_entry_nm: 0
    l2_entry_ty: 0
    l2_entry_n: 0
    l2_entry_cap: 0
return: 0

fn: l2_entry_reserve (int: need) int
    size_t: nb
    size_t: ni
    size_t: psz
    @@: LmP0Text nn 0
    @: int nt 0
    if: need < 0
        return: 1
    if: need <= l2_entry_cap
        return: 0
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok((cast: (size_t) need), psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok((cast: (size_t) need), c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: (cast: (size_t) need) * psz
    ni: (cast: (size_t) need) * c.sizeof(c.int)
    l2_alloc_kind: 1
    nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nt: (cast: (@: int) l2_xmalloc(ni))
    if: nn = 0 || nt = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        ---
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        ---
        l2_entry_free()
        return: 1
    c.memset((cast: (@: void) nn), 0, nb)
    c.memset((cast: (@: void) nt), 0, ni)
    if: l2_entry_nm != 0 && l2_entry_n > 0
        c.memcpy((cast: (@: void) nn), (cast: (@: void) l2_entry_nm), (cast: (size_t) l2_entry_n) * psz)
    ---
    if: l2_entry_ty != 0 && l2_entry_n > 0
        c.memcpy((cast: (@: void) nt), (cast: (@: void) l2_entry_ty), (cast: (size_t) l2_entry_n) * c.sizeof(c.int))
    ---
    if: l2_entry_nm != 0
        l2_xfree((cast: (@: void) l2_entry_nm))
    ---
    if: l2_entry_ty != 0
        l2_xfree((cast: (@: void) l2_entry_ty))
    ---
    l2_entry_nm: nn
    l2_entry_ty: nt
    l2_entry_cap: need
return: 0

fn: l2_entry_find (const: @(LmP0Text t)) int
    int: i 0
    if: t = 0 || l2_entry_nm = 0
        return: -1
    while: i < l2_entry_n
        if: l2_text_same(l2_entry_nm[i], t)
            return: i
        ---
        i: i + 1
return: -1

fn: l2_parse_entry_formals (const: @(LmP0Node params); const: @(char path)) int
    @: LmP0Field p
    @: LmP0Text fa 0
    int: ar
    int: j
    int: k
    int: ty
    l2_entry_free()
    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE || params\as = 0
        return: l2_error(path, params, "incompatible entry signature")
    if: params\as\structure\trailer != 0
        return: l2_error(path, params, "unsupported trailer")
    ar: l2_count_active(params\as\structure)
    if: ar < 1
        return: l2_error(path, params, "incompatible entry signature")
    if: l2_entry_reserve(ar) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, params, "size overflow")
        return: l2_error(path, params, "out of memory")
    p: l2_next_active(params\as\structure\first_field)
    j: 0
    while: j < ar
        ty: 0
        fa: 0
        if: p = 0 || l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            l2_entry_free()
            return: 1
        if: fa = 0 || fa\length >= 63U
            l2_entry_free()
            return: l2_error(path, params, "name too long")
        k: 0
        while: k < j
            if: l2_text_same(fa, l2_entry_nm[k])
                l2_entry_free()
                return: l2_error(path, p\value, "duplicate formal")
            ---
            k: k + 1
        l2_entry_nm[j]: fa
        l2_entry_ty[j]: ty
        p: l2_next_active(p\next)
        j: j + 1
    l2_entry_n: ar
    if: ar != 2 || l2_entry_ty[0] != 0 || l2_entry_ty[1] != 17
        l2_entry_free()
        return: l2_error(path, params, "incompatible entry signature")
    ---
return: 0

fn: l2_write_entry_sig (@: FILE out) int
    int: j 0
    int: ty
    if: out = 0
        return: 1
    if: c.fputs("external:\n    fn: main (", out) < 0
        return: 1
    while: j < l2_entry_n
        if: j != 0 && c.fputs("; ", out) < 0
            return: 1
        ty: l2_entry_ty[j]
        if: ty = 0 && c.fputs("int: ", out) < 0
            return: 1
        if: ty = 1 && c.fputs("char: ", out) < 0
            return: 1
        if: ty = 2 && c.fputs("size_t: ", out) < 0
            return: 1
        if: ty = 3 && c.fputs("const: @(char ", out) < 0
            return: 1
        if: ty = 12 && c.fputs("@: char ", out) < 0
            return: 1
        if: ty = 16 && c.fputs("@: void ", out) < 0
            return: 1
        if: ty = 17 && c.fputs("@@: char ", out) < 0
            return: 1
        if: ty = 18 && c.fputs("@@: void ", out) < 0
            return: 1
        if: ty = 19 && c.fputs("@@: int ", out) < 0
            return: 1
        if: ty = 20 && c.fputs("@@: size_t ", out) < 0
            return: 1
        if: ty != 0 && ty != 1 && ty != 2 && ty != 3 && ty != 12 && ty != 16 && ty != 17 && ty != 18 && ty != 19 && ty != 20
            return: 1
        if: l2_write_text(out, l2_entry_nm[j]) != 0
            return: 1
        if: ty = 3 && c.fputs(")", out) < 0
            return: 1
        j: j + 1
    if: c.fputs(") int\n", out) < 0
        return: 1
return: 0

fn: l2_formal_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_arity[mi]
        if: l2_text_same(l2_fn(mi, i), t)
            return: i
        i: i + 1
return: -1

fn: l2_dyn_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_dyn[mi]
        if: l2_text_same(l2_dn(mi, i), t)
            return: i
        i: i + 1
return: -1

fn: l2_param_find (int: mi; const: @(LmP0Text t)) int
    int: fi
    int: di
    fi: l2_formal_find(mi, t)
    if: fi >= 0
        return: fi
    di: l2_dyn_find(mi, t)
    if: di >= 0
        return: l2_m_arity[mi] + di
return: -1

fn: l2_param_ty (int: mi; const: @(LmP0Text t)) int
    int: fi
    int: di
    if: mi < 0 || t = 0
        return: 0
    fi: l2_formal_find(mi, t)
    if: fi >= 0
        return: l2_ft(mi, fi)
    di: l2_dyn_find(mi, t)
    if: di >= 0
        return: l2_dt(mi, di)
return: 0

fn: l2_is_asgn (const: @(LmP0Node stmt)) int
    const: @: LmP0Text h
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    h: stmt\as\frame\head
    if: h = 0 || l2_ident(h) = 0
        return: 0
    if: l2_frame_head(stmt, "if") || l2_frame_head(stmt, "else") || l2_frame_head(stmt, "while") || l2_frame_head(stmt, "for") || l2_frame_head(stmt, "return") || l2_frame_head(stmt, "fn") || l2_frame_head(stmt, "sub") || l2_frame_head(stmt, "end") || l2_frame_head(stmt, "char") || l2_frame_head(stmt, "size_t") || l2_frame_head(stmt, "@")
        return: 0
    if: l2_find_method(h) >= 0 || l2_is_known(h)
        return: 0
    if: h\length >= 2U && h\data[0] = 99 && h\data[1] = 46
        return: 0
    if: stmt\as\frame\body = 0
        return: 0
return: 1

fn: l2_collect_asgn_body (const: @(LmP0Structure body); int: mi; const: @(char path)) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Text fa
    int: n
    int: k
    int: j
    int: ty
    int: used
    if: body = 0 || mi < 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                return: 1
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as != 0 && nxt\value\as\frame != 0 && l2_collect_asgn_body(nxt\value\as\frame\body, mi, path) != 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: n >= 2 && last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                return: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_scope_push(stmt) != 0
                return: l2_error(path, stmt, "too deeply nested")
            last: l2_next_active(stmt\as\frame\body\first_field)
            k: 1
            while: k < 5
                last: l2_next_active(last\next)
                k: k + 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt)
            fa: stmt\as\frame\head
            ty: l2_param_ty(mi, fa)
            j: -1
            used: 0
            if: ty = 1 || ty = 2
                j: l2_own_add(mi, fa, ty, path, stmt, 0)
            if: (ty = 1 || ty = 2) && j < 0
                return: 1
            if: (ty = 1 || ty = 2) && l2_own_off(mi, j) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            if: ty = 1 || ty = 2
                used: l2_m_uses[l2_own_off(mi, j)]
            if: ty = 1 || ty = 2
                l2_m_uses[l2_own_off(mi, j)]: 1
            if: (ty = 1 || ty = 2) && used = 0
                l2_m_own[mi]: l2_m_own[mi] + 1
            if: (ty = 1 || ty = 2) && l2_bind_own(mi, j, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_collect_asgn_binds (const: @(char path)) int
    int: i 0
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_collect_asgn_body(l2_m_body[i]\as\structure, i, path) != 0
            return: 1
        i: i + 1
return: 0

fn: l2_bind_own (int: mi; int: oi; const: @(char path); const: @(LmP0Node at)) int
    int: fi 0
    if: mi < 0 || oi < 0
        return: 0
    while: fi < l2_m_arity[mi]
        if: l2_text_same(l2_fn(mi, fi), l2_own_name[oi])
            if: l2_ft(mi, fi) != l2_own_ty[oi]
                return: l2_error(path, at, "incompatible entry signature")
            l2_m_alias[l2_own_off(mi, oi)]: fi
        fi: fi + 1
    fi: 0
    while: fi < l2_m_dyn[mi]
        if: l2_text_same(l2_dn(mi, fi), l2_own_name[oi])
            if: l2_dt(mi, fi) != 0 && l2_dt(mi, fi) != l2_own_ty[oi]
                return: l2_error(path, at, "incompatible entry signature")
            if: l2_dt_set(mi, fi, l2_own_ty[oi]) != 0
                return: 1
            l2_m_alias[l2_own_off(mi, oi)]: l2_m_arity[mi] + fi
        fi: fi + 1
return: 0

fn: l2_collect_decls (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth; @: int sn) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    @: LmP0Text fa
    int: j
    int: ty
    if: body = 0 || sn = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: l2_frame_head(stmt, "if")
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_for_add(stmt) < 0
                return: l2_error(path, stmt, "out of memory")
            if: l2_scope_push(stmt) != 0
                return: l2_error(path, stmt, "too deeply nested")
            nxt: l2_next_active(stmt\as\frame\body\first_field)
