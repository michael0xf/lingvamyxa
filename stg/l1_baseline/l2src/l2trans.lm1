predef: "l1src/parser.lm1"
include: "<stdio.h>" "<string.h>" "<limits.h>" "<stdlib.h>"

# L2 -> L1 frontend: §1.7 main adapter, plus two-int no-throw methods under §21.8.

int: l2_leaf_mode 0
unsigned: l2_sigv 0U
unsigned: l2_intern_n 0U
unsigned: l2_intern_again 0U
unsigned: l2_intern_swap 0U
unsigned: l2_intern_probe 0U
int: l2_m_n 0
int: l2_own_n 0
int: l2_tn 0
const: @: char l2_call_node 0
@: FILE l2_out 0
const: @: char l2_src 0
@: LmP0Structure l2_main_body 0

c.array: [8]: @: LmP0Text l2_m_name
c.array: [8]: @: LmP0Text l2_m_f0
c.array: [8]: @: LmP0Text l2_m_f1
c.array: [8]: @: LmP0Node l2_m_node
c.array: [8]: @: LmP0Node l2_m_body
c.array: [8]: unsigned l2_m_sig
c.array: [8]: int l2_m_mark
c.array: [8]: int l2_m_arity
c.array: [8]: int l2_m_ret
c.array: [8]: int l2_m_own
c.array: [32]: int l2_m_uses
c.array: [4]: @: LmP0Text l2_own_name
c.array: [32]: @: LmP0Text l2_m_fn
c.array: [32]: int l2_m_ft
c.array: [64]: int l2_m_edge
c.array: [16]: int l2_it_ar
c.array: [64]: @: char l2_it_n
c.array: [64]: size_t l2_it_nl
c.array: [64]: int l2_it_ty
c.array: [256]: char l2_tok
c.array: [256]: char l2_lhs
c.array: [256]: char l2_rhs

prototype:
    fn: l2_collect_method (const: @(LmP0Node fn_node); const: @(char path)) int
    fn: l2_parse_unit (const: @(LmP0Node main_node); const: @(char path)) int
    fn: l2_emit_unit (const: @(char out_path)) int
    fn: l2_check_expr (const: @(LmP0Node node); int: mi; const: @(char path)) int
    fn: l2_check_fields (@: LmP0Field field; int: n; int: mi; const: @(char path); const: @(LmP0Node at)) int
    fn: l2_check_body (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth) int
    fn: l2_dfs (int: u) int
    fn: l2_prep (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    fn: l2_cat (@: char dest; const: @(char src)) int
    fn: l2_tok_temp (int: k; @: char dest) int
    fn: l2_emit_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    fn: l2_eval_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    fn: l2_eval_and (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    fn: l2_fields_has_call (@: LmP0Field field; int: n) int
    fn: l2_node_has_call (const: @(LmP0Node node)) int
    fn: l2_advance (@: LmP0Field f; int: k) @: LmP0Field
    fn: l2_emit_expr (const: @(LmP0Node node); int: mi; const: @(char ind)) int
    fn: l2_emit_body (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    fn: l2_emit_checkpoint (int: mi; const: @(char ind)) int
    fn: l2_own_find (const: @(LmP0Text t)) int
    fn: l2_own_add (const: @(LmP0Text t); const: @(char path); const: @(LmP0Node at)) int
    fn: l2_slash_own (const: @(LmP0Text t)) int
    fn: l2_is_char_decl (const: @(LmP0Node stmt)) int
end: prototype

fn: l2_text_eq (const: @(LmP0Text text); const: @(char s)) int
    size_t: n
    if: text = 0 || s = 0
        return: 0
    n: c.strlen(s)
    if: text\data = 0
        return: n = 0U
return: text\length = n && c.memcmp(text\data, s, n) = 0

fn: l2_ignored (const: @(LmP0Node node)) int
    if: node = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_DISABLED
        return: 1
    if: (node\flags & c.LM_P0_NODE_INACTIVE) != 0U
        return: 1
return: 0

fn: l2_error (const: @(char path); const: @(LmP0Node node); const: @(char msg)) int
    size_t: line 1U
    size_t: column 1U
    if: node != 0 && node\span != 0
        line: node\span\line
        column: node\span\column
    if: path = 0
        path: ""
    c.fprintf(c.stderr, "l2trans error: %s:%zu:%zu: %s\n", path, line, column, msg)
return: 1

fn: l2_path_is_lm2 (const: @(char path)) int
    size_t: n
    if: path = 0
        return: 0
    n: c.strlen(path)
    if: n < 4U
        return: 0
    if: path[n - 4U] != 46
        return: 0
    if: path[n - 3U] != 108 && path[n - 3U] != 76
        return: 0
    if: path[n - 2U] != 109 && path[n - 2U] != 77
        return: 0
    if: path[n - 1U] != 50
        return: 0
return: 1

fn: l2_next_active (@: LmP0Field field) @: LmP0Field
    while: field != 0 && l2_ignored(field\value)
        field: field\next
return: field

fn: l2_count_active (const: @(LmP0Structure body)) int
    @: LmP0Field field
    int: n 0
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        n: n + 1
        field: l2_next_active(field\next)
return: n

fn: l2_write_sym (@: FILE out; int: i) int
    if: out = 0
        return: 1
    if: c.fprintf(out, "l2_m%d", i) < 0
        return: 1
return: 0

fn: l2_tok_sym (int: i; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_m%d", i) < 0
        return: 1
return: 0

fn: l2_digits (const: @(LmP0Text text)) int
    size_t: i
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    if: text\length > 1U && text\data[0] = 48
        return: 0
    i: 0U
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

fn: l2_num (const: @(LmP0Text text)) int
    size_t: n
    size_t: i
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    n: text\length
    if: text\data[n - 1U] = 85 || text\data[n - 1U] = 117
        n: n - 1U
    if: n = 0U
        return: 0
    if: n > 1U && text\data[0] = 48
        return: 0
    i: 0U
    while: i < n
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

fn: l2_int_fits (const: @(LmP0Text text)) int
    size_t: i
    int: acc 0
    int: d 0
    int: q
    int: r
    if: l2_digits(text) = 0
        return: 0
    q: c.INT_MAX / 10
    r: c.INT_MAX % 10
    i: 0U
    while: i < text\length
        d: text\data[i] - 48
        if: acc > q
            return: 0
        if: acc = q && d > r
            return: 0
        acc: acc * 10 + d
        i: i + 1U
return: 1

fn: l2_end_named (const: @(LmP0Frame frame); const: @(char name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(field\value\as\atom, name)

fn: l2_frame_head (const: @(LmP0Node node); const: @(char name)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 0
return: l2_text_eq(node\as\frame\head, name)

fn: l2_empty_struct (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_STRUCTURE || node\as = 0
        return: 0
return: l2_count_active(node\as\structure) = 0

fn: l2_quoted (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length < 2U
        return: 0
    if: t\data[0] != 34 || t\data[t\length - 1U] != 34
        return: 0
    if: t\length >= 6U && t\data[1] = 34 && t\data[2] = 34
        return: 0
return: 1

fn: l2_write_text (@: FILE out; const: @(LmP0Text t)) int
    if: out = 0 || t = 0 || t\data = 0
        return: 1
    if: t\length = 0U
        return: 0
    if: c.fwrite(t\data, 1U, t\length, out) != t\length
        return: 1
return: 0

fn: l2_check_puts (const: @(LmP0Node stmt); const: @(char path)) int
    const: @: LmP0Frame fr
    @: LmP0Field arg
    int: n
    if: l2_frame_head(stmt, "c.puts") = 0
        return: l2_error(path, stmt, "unsupported body")
    fr: stmt\as\frame
    if: fr\trailer != 0
        return: l2_error(path, stmt, "unsupported body")
    if: fr\body = 0
        return: l2_error(path, stmt, "unsupported argument")
    if: fr\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    n: l2_count_active(fr\body)
    if: n = 0
        return: l2_error(path, stmt, "unsupported argument")
    if: n != 1
        return: l2_error(path, stmt, "extra argument")
    arg: l2_next_active(fr\body\first_field)
    if: arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, stmt, "unsupported argument")
    if: l2_quoted(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "unsupported argument")
return: 0

fn: l2_take_return_stmt (const: @(LmP0Node stmt); const: @(char path); @@: LmP0Text out_lit) int
    const: @: LmP0Frame ret
    @: LmP0Field arg
    if: out_lit = 0
        return: l2_error(path, stmt, "internal: missing return slot")
    out_lit[0]: 0
    if: l2_frame_head(stmt, "return") = 0
        return: l2_error(path, stmt, "unsupported body")
    ret: stmt\as\frame
    if: ret\trailer != 0
        return: l2_error(path, stmt, "unsupported body")
    if: ret\body = 0 || l2_count_active(ret\body) != 1
        return: l2_error(path, stmt, "unsupported body")
    if: ret\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    arg: l2_next_active(ret\body\first_field)
    if: arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, stmt, "unsupported body")
    if: l2_digits(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "unsupported body")
    if: l2_int_fits(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "return literal not representable as int")
    out_lit[0]: arg\value\as\atom
return: 0

fn: l2_take_body (const: @(LmP0Node body_node); const: @(char path); @@: LmP0Text out_lit) int
    @: LmP0Field field
    @: LmP0Field nxt
    const: @: LmP0Node stmt
    if: out_lit = 0
        return: l2_error(path, body_node, "internal: missing return slot")
    out_lit[0]: 0
    if: body_node = 0 || body_node\kind != c.LM_P0_NODE_STRUCTURE || body_node\as = 0
        return: l2_error(path, body_node, "unsupported body")
    field: l2_next_active(body_node\as\structure\first_field)
    if: field = 0
        return: l2_error(path, body_node, "unsupported body")
    while: field != 0
        stmt: field\value
        nxt: l2_next_active(field\next)
        if: nxt = 0
            return: l2_take_return_stmt(stmt, path, out_lit)
        if: l2_frame_head(stmt, "return")
            return: l2_error(path, stmt, "unsupported body")
        if: l2_check_puts(stmt, path) != 0
            return: 1
        field: nxt
return: l2_error(path, body_node, "unsupported body")

fn: l2_take_main_lit (const: @(LmP0Node fn_node); const: @(char path); @@: LmP0Text out_lit; @@: LmP0Structure out_body) int
    @: LmP0Field field
    const: @: LmP0Frame fn_frame
    const: @: LmP0Node name
    const: @: LmP0Node params
    const: @: LmP0Node resty
    const: @: LmP0Node body
    if: out_body = 0
        return: l2_error(path, fn_node, "internal: missing body slot")
    out_body[0]: 0
    if: l2_frame_head(fn_node, "fn") = 0
        return: l2_error(path, fn_node, "unsupported body")
    fn_frame: fn_node\as\frame
    if: l2_end_named(fn_frame, "main") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fn_frame\body = 0 || l2_count_active(fn_frame\body) != 4
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(fn_frame\body\first_field)
    name: field\value
    if: name = 0 || name\kind != c.LM_P0_NODE_ATOM || l2_text_eq(name\as\atom, "main") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    params: field\value
    if: l2_empty_struct(params) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    resty: field\value
    if: resty = 0 || resty\kind != c.LM_P0_NODE_ATOM || l2_text_eq(resty\as\atom, "int") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: field\value
    if: l2_take_body(body, path, out_lit) != 0
        return: 1
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, fn_node, "unsupported body")
    out_body[0]: body\as\structure
return: 0

fn: l2_unit_from_root (const: @(LmP0Node root); const: @(char path); @@: LmP0Structure out_unit) int
    @: LmP0Field field
    const: @: LmP0Node item
    if: out_unit = 0
        return: l2_error(path, root, "internal: missing unit slot")
    out_unit[0]: 0
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE || root\as = 0 || root\as\structure = 0
        return: l2_error(path, root, "unsupported body")
    field: l2_next_active(root\as\structure\first_field)
    if: field = 0
        return: l2_error(path, root, "missing main")
    item: field\value
    if: l2_next_active(field\next) = 0 && l2_frame_head(item, "L2")
        if: l2_end_named(item\as\frame, "L2") = 0
            return: l2_error(path, item, "unsupported body")
        if: item\as\frame\body = 0
            return: l2_error(path, item, "missing main")
        out_unit[0]: item\as\frame\body
        return: 0
    if: l2_frame_head(item, "L1") || l2_frame_head(item, "L3")
        return: l2_error(path, item, "unsupported body")
    out_unit[0]: root\as\structure
return: 0

fn: l2_translate_unit (const: @(LmP0Structure unit); const: @(char path); @@: LmP0Text out_lit; @@: LmP0Structure out_body) int
    @: LmP0Field field
    @: LmP0Field nf
    @: LmP0Node item
    int: mains 0
    int: extras 0
    int: is_main 0
    @: LmP0Node main_node 0
    int: i
    if: out_lit = 0 || out_body = 0
        return: l2_error(path, 0, "internal: missing return slot")
    out_lit[0]: 0
    out_body[0]: 0
    l2_leaf_mode: 0
    l2_m_n: 0
    l2_own_n: 0
    l2_intern_n: 0U
    l2_src: path
    i: 0
    while: i < 64
        l2_m_edge[i]: 0
        i: i + 1
    i: 0
    while: i < 32
        l2_m_uses[i]: 0
        i: i + 1
    if: unit = 0
        return: l2_error(path, 0, "missing main")
    if: unit\trailer != 0
        return: l2_error(path, 0, "unsupported trailer")
    field: l2_next_active(unit\first_field)
    while: field != 0
        item: field\value
        nf: 0
        is_main: 0
        if: l2_frame_head(item, "fn") != 0 && item\as\frame != 0 && item\as\frame\body != 0
            nf: l2_next_active(item\as\frame\body\first_field)
        if: nf != 0 && nf\value != 0 && nf\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(nf\value\as\atom, "main")
            is_main: 1
            mains: mains + 1
            main_node: item
        if: is_main = 0 && l2_frame_head(item, "fn") != 0 && l2_collect_method(item, path) != 0
            return: 1
        if: is_main = 0 && l2_frame_head(item, "fn") = 0
            extras: extras + 1
        field: l2_next_active(field\next)
    if: mains > 1
        return: l2_error(path, main_node, "several main")
    if: mains = 0
        return: l2_error(path, 0, "missing main")
    if: extras != 0
        return: l2_error(path, main_node, "unsupported body")
    if: l2_m_n != 0
        return: l2_parse_unit(main_node, path)
return: l2_take_main_lit(main_node, path, out_lit, out_body)

fn: l2_emit_puts_line (@: FILE out; const: @(LmP0Node stmt)) int
    @: LmP0Field arg
    arg: l2_next_active(stmt\as\frame\body\first_field)
    if: c.fputs("        c.puts: ", out) < 0
        return: 1
    if: l2_write_text(out, arg\value\as\atom) != 0
        return: 1
    if: c.fputs("\n", out) < 0
        return: 1
return: 0

fn: l2_emit_l1 (const: @(char out_path); const: @(LmP0Structure body); const: @(LmP0Text lit)) int
    @: FILE out
    @: LmP0Field field
    @: LmP0Field nxt
    int: puts_n 0
    if: out_path = 0 || body = 0 || lit = 0 || lit\data = 0 || lit\length = 0U
        return: 1
    field: l2_next_active(body\first_field)
    while: field != 0
        nxt: l2_next_active(field\next)
        if: nxt != 0
            puts_n: puts_n + 1
        field: nxt
    out: c.fopen(out_path, "wb")
    if: out = 0
        c.fprintf(c.stderr, "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: puts_n != 0 && c.fputs("include: \"<stdio.h>\"\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fputs("external:\n    fn: main () int\n", out) < 0
        c.fclose(out)
        return: 1
    field: l2_next_active(body\first_field)
    while: field != 0
        nxt: l2_next_active(field\next)
        if: nxt != 0 && l2_emit_puts_line(out, field\value) != 0
            c.fclose(out)
            return: 1
        field: nxt
    if: c.fputs("        return: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, lit) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("\n    end: main\nend: external\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fclose(out) != 0
        return: 1
return: 0

fn: l2_translate (const: @(char in_path); const: @(char out_path)) int
    @: LmP0Document document 0
    const: @: LmP0Diagnostic diagnostic
    const: @: LmP0Node root
    @: LmP0Structure unit 0
    @: LmP0Structure body 0
    @: LmP0Text lit 0
    int: status
    if: l2_path_is_lm2(in_path) = 0
        c.fprintf(c.stderr, "l2trans error: %s:1:1: expected a .lm2 source\n", in_path)
        return: 1
    status: lm_p0_parse_file(in_path, @ document)
    if: status != 0
        diagnostic: lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf(c.stderr, "l2trans parse error %d at %zu:%zu: %s\n", diagnostic\code, diagnostic\line, diagnostic\column, diagnostic\message)
        else:
            c.fprintf(c.stderr, "l2trans parse error: %s\n", in_path)
        lm_p0_document_destroy(document)
        return: 1
    root: lm_p0_document_root(document)
    if: l2_unit_from_root(root, in_path, @ unit) != 0
        lm_p0_document_destroy(document)
        return: 1
    if: l2_translate_unit(unit, in_path, @ lit, @ body) != 0
        lm_p0_document_destroy(document)
        return: 1
    if: l2_leaf_mode != 0
        status: l2_emit_unit(out_path)
    else:
        status: l2_emit_l1(out_path, body, lit)
    lm_p0_document_destroy(document)
    if: status != 0
        return: 1
return: 0

# Parse/emit one two-int add leaf + typed call from §1.7 main.

fn: l2_ident (const: @(LmP0Text t)) int
    size_t: i
    unsigned: ch
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0
    ch: (cast: (unsigned) t\data[0])
    if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U)
        return: 0
    i: 1U
    while: i < t\length
        ch: (cast: (unsigned) t\data[i])
        if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U) && (ch < 48U || ch > 57U)
            return: 0
        i: i + 1U
    if: l2_text_eq(t, "main") || l2_text_eq(t, "fn") || l2_text_eq(t, "int") || l2_text_eq(t, "return") || l2_text_eq(t, "if") || l2_text_eq(t, "else") || l2_text_eq(t, "while") || l2_text_eq(t, "for") || l2_text_eq(t, "node")
        return: 0
return: 1

fn: l2_text_same (const: @(LmP0Text a); const: @(LmP0Text b)) int
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    if: a\length != b\length
        return: 0
return: c.memcmp(a\data, b\data, a\length) = 0

# Translator intern of the full canonical contract: L2_SIG_V0 schema
# plus exact ordered formal-name bytes. Method name is not interned.
# One table for the linked unit; not reset per method.
fn: l2_intern_match (unsigned: s; int: ar; const: @(char n0); size_t: l0; int: t0; const: @(char n1); size_t: l1; int: t1; const: @(char n2); size_t: l2n; int: t2; const: @(char n3); size_t: l3; int: t3) int
    unsigned: b
    if: s >= l2_intern_n || l2_it_ar[s] != ar
        return: 0
    b: s * 4U
    if: ar >= 1 && (t0 != l2_it_ty[b] || l0 != l2_it_nl[b] || c.memcmp(n0, l2_it_n[b], l0) != 0)
        return: 0
    if: ar >= 2 && (t1 != l2_it_ty[b + 1U] || l1 != l2_it_nl[b + 1U] || c.memcmp(n1, l2_it_n[b + 1U], l1) != 0)
        return: 0
    if: ar >= 3 && (t2 != l2_it_ty[b + 2U] || l2n != l2_it_nl[b + 2U] || c.memcmp(n2, l2_it_n[b + 2U], l2n) != 0)
        return: 0
    if: ar >= 4 && (t3 != l2_it_ty[b + 3U] || l3 != l2_it_nl[b + 3U] || c.memcmp(n3, l2_it_n[b + 3U], l3) != 0)
        return: 0
return: 1

fn: l2_intern_store (int: ar; const: @(char n0); size_t: l0; int: t0; const: @(char n1); size_t: l1; int: t1; const: @(char n2); size_t: l2n; int: t2; const: @(char n3); size_t: l3; int: t3) unsigned
    unsigned: i 0U
    unsigned: b
    while: i < l2_intern_n
        if: l2_intern_match(i, ar, n0, l0, t0, n1, l1, t1, n2, l2n, t2, n3, l3, t3)
            return: i + 1U
        i: i + 1U
    if: l2_intern_n >= 16U || ar < 1 || ar > 4
        return: 0U
    b: l2_intern_n * 4U
    l2_it_ar[l2_intern_n]: ar
    if: ar >= 1
        l2_it_n[b]: (cast: (@: char) n0)
        l2_it_nl[b]: l0
        l2_it_ty[b]: t0
    if: ar >= 2
        l2_it_n[b + 1U]: (cast: (@: char) n1)
        l2_it_nl[b + 1U]: l1
        l2_it_ty[b + 1U]: t1
    if: ar >= 3
        l2_it_n[b + 2U]: (cast: (@: char) n2)
        l2_it_nl[b + 2U]: l2n
        l2_it_ty[b + 2U]: t2
    if: ar >= 4
        l2_it_n[b + 3U]: (cast: (@: char) n3)
        l2_it_nl[b + 3U]: l3
        l2_it_ty[b + 3U]: t3
    l2_intern_n: l2_intern_n + 1U
return: l2_intern_n

fn: l2_intern_pair (const: @(char a); size_t: na; const: @(char b); size_t: nb) unsigned
return: l2_intern_store(2, a, na, 0, b, nb, 0, 0, 0U, 0, 0, 0U, 0)

fn: l2_intern_mi (int: mi) unsigned
    @: LmP0Text a0 0
    @: LmP0Text a1 0
    @: LmP0Text a2 0
    @: LmP0Text a3 0
    int: ar
    ar: l2_m_arity[mi]
    if: ar >= 1
        a0: l2_m_fn[mi * 4]
    if: ar >= 2
        a1: l2_m_fn[mi * 4 + 1]
    if: ar >= 3
        a2: l2_m_fn[mi * 4 + 2]
    if: ar >= 4
        a3: l2_m_fn[mi * 4 + 3]
    if: ar = 1
        return: l2_intern_store(1, a0\data, a0\length, l2_m_ft[mi * 4], 0, 0U, 0, 0, 0U, 0, 0, 0U, 0)
    if: ar = 2
        return: l2_intern_store(2, a0\data, a0\length, l2_m_ft[mi * 4], a1\data, a1\length, l2_m_ft[mi * 4 + 1], 0, 0U, 0, 0, 0U, 0)
    if: ar = 3
        return: l2_intern_store(3, a0\data, a0\length, l2_m_ft[mi * 4], a1\data, a1\length, l2_m_ft[mi * 4 + 1], a2\data, a2\length, l2_m_ft[mi * 4 + 2], 0, 0U, 0)
return: l2_intern_store(4, a0\data, a0\length, l2_m_ft[mi * 4], a1\data, a1\length, l2_m_ft[mi * 4 + 1], a2\data, a2\length, l2_m_ft[mi * 4 + 2], a3\data, a3\length, l2_m_ft[mi * 4 + 3])

fn: l2_find_method (const: @(LmP0Text name)) int
    int: i 0
    while: i < l2_m_n
        if: l2_text_same(l2_m_name[i], name)
            return: i
        i: i + 1
return: -1

fn: l2_own_find (const: @(LmP0Text t)) int
    int: i 0
    while: i < l2_own_n
        if: l2_text_same(l2_own_name[i], t)
            return: i
        i: i + 1
return: -1

fn: l2_own_add (const: @(LmP0Text t); const: @(char path); const: @(LmP0Node at)) int
    int: i
    if: t = 0 || l2_ident(t) = 0
        return: l2_error(path, at, "incompatible entry signature")
    i: l2_own_find(t)
    if: i >= 0
        return: i
    if: l2_own_n >= 4
        return: l2_error(path, at, "unsupported body")
    l2_own_name[l2_own_n]: (cast: (@: LmP0Text) t)
    l2_own_n: l2_own_n + 1
return: l2_own_n - 1

fn: l2_slash_own (const: @(LmP0Text t)) int
    int: i 0
    size_t: n
    if: t = 0 || t\data = 0 || t\length < 6U
        return: -1
    if: t\data[0] != 110 || t\data[1] != 111 || t\data[2] != 100 || t\data[3] != 101 || t\data[4] != 92
        return: -1
    n: t\length - 5U
    while: i < l2_own_n
        if: l2_own_name[i] != 0 && l2_own_name[i]\length = n && c.memcmp(l2_own_name[i]\data, t\data + 5, n) = 0
            return: i
        i: i + 1
return: -1

fn: l2_is_char_decl (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    if: l2_frame_head(stmt, "char") = 0
        return: 0
    if: stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 1
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_ident(f\value\as\atom) = 0
        return: 0
return: 1

fn: l2_is_plus (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "+") || l2_text_eq(t, "/") || l2_text_eq(t, "-")
        return: 1
return: 0

fn: l2_is_cmp (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "<") || l2_text_eq(t, ">") || l2_text_eq(t, "=") || l2_text_eq(t, "!=") || l2_text_eq(t, "<=") || l2_text_eq(t, ">=")
        return: 1
return: 0

fn: l2_is_andor (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "&&") || l2_text_eq(t, "||")
        return: 1
return: 0

fn: l2_is_brack (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "[") || l2_text_eq(t, "]")
        return: 1
return: 0

fn: l2_is_binop (const: @(LmP0Text t)) int
    if: l2_is_plus(t) || l2_is_cmp(t) || l2_is_andor(t)
        return: 1
return: 0

fn: l2_node_has_call (const: @(LmP0Node node)) int
    @: LmP0Field f
    if: node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && l2_find_method(node\as\frame\head) >= 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0
        return: l2_fields_has_call(node\as\frame\body\first_field, l2_count_active(node\as\frame\body))
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        return: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
return: 0

fn: l2_fields_has_call (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i
    f: l2_next_active(field)
    i: 0
    while: i < n && f != 0
        if: l2_node_has_call(f\value)
            return: 1
        f: l2_next_active(f\next)
        i: i + 1
return: 0

fn: l2_is_or_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "||")

fn: l2_is_and_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "&&")

fn: l2_advance (@: LmP0Field f; int: k) @: LmP0Field
    int: i 0
    while: i < k && f != 0
        f: l2_next_active(f\next)
        i: i + 1
return: f

fn: l2_span_or (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_or_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_span_and (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_and_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_bump_ind (const: @(char ind); @: char dest) int
    size_t: ln
    if: dest = 0 || ind = 0
        return: 1
    ln: c.strlen(ind)
    if: ln + 5U >= 32U
        return: 1
    c.memcpy(dest, ind, ln)
    dest[ln]: 32
    dest[ln + 1U]: 32
    dest[ln + 2U]: 32
    dest[ln + 3U]: 32
    dest[ln + 4U]: 0
return: 0

fn: l2_new_temp (const: @(char ind); @: char dest) int
    int: t
    if: dest = 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_bool_set (const: @(char ind); const: @(char dest); const: @(char rhs)) int
    if: dest = 0 || rhs = 0 || ind = 0
        return: 1
    if: c.fprintf(l2_out, "%s%s: (%s) != 0\n", ind, dest, rhs) < 0
        return: 1
return: 0

fn: l2_intern_prove (const: @(char path); const: @(LmP0Node node)) int
    unsigned: id
    int: two
    if: l2_m_n = 0
        return: 0
    id: l2_m_sig[0]
    l2_intern_again: l2_intern_mi(0)
    if: id = 0U || l2_intern_again != id
        return: l2_error(path, node, "intern broken")
    l2_intern_swap: 0U
    two: 0
    if: l2_m_arity[0] = 2 && l2_m_f0[0] != 0 && l2_m_f1[0] != 0
        two: 1
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0
        l2_intern_swap: l2_intern_pair(l2_m_f1[0]\data, l2_m_f1[0]\length, l2_m_f0[0]\data, l2_m_f0[0]\length)
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0 && (l2_intern_swap = 0U || l2_intern_swap = id)
        return: l2_error(path, node, "intern failed to distinguish swapped formals")
    l2_intern_probe: l2_intern_pair("a", 1U, "b", 1U)
    if: l2_intern_probe = 0U
        return: l2_error(path, node, "intern table full")
    if: two != 0 && l2_text_eq(l2_m_f0[0], "a") && l2_text_eq(l2_m_f1[0], "b") && l2_m_ft[0] = 0 && l2_intern_probe != id
        return: l2_error(path, node, "intern failed memcmp of equal names")
    if: two != 0 && (l2_text_eq(l2_m_f0[0], "a") = 0 || l2_text_eq(l2_m_f1[0], "b") = 0 || l2_m_ft[0] != 0) && l2_intern_probe = id
        return: l2_error(path, node, "intern false-equal distinct contracts")
    l2_sigv: id
return: 0

fn: l2_end_text (const: @(LmP0Frame frame); const: @(LmP0Text name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0 || name = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_same(field\value\as\atom, name)

fn: l2_int_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_name[0]: 0
    if: node = 0 || node\as = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int") = 0 && l2_frame_head(node, "char") = 0 && l2_frame_head(node, "size_t") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f\value = 0 || f\value\as = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_name[0]: f\value\as\atom
return: 0

fn: l2_typed_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name; @: int out_ty) int
    @: LmP0Field f
    @: LmP0Field g
    const: @: LmP0Node inner
    if: out_ty = 0 || out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int")
        out_ty[0]: 0
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "char")
        out_ty[0]: 1
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "size_t")
        out_ty[0]: 2
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "const") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    inner: l2_next_active(node\as\frame\body\first_field)\value
    if: l2_frame_head(inner, "@") = 0 || inner\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_count_active(inner\as\frame\body) != 2
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(inner\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(f\value\as\atom, "char") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_ty[0]: 3
    out_name[0]: g\value\as\atom
return: 0

fn: l2_collect_method (const: @(LmP0Node fn_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node params
    const: @: LmP0Node body
    @: LmP0Field p
    @: LmP0Text fa 0
    @: LmP0Text nm 0
    unsigned: id
    int: ar
    int: j
    int: ty
    int: k
    if: fn_node = 0 || fn_node\as = 0 || fn_node\as\frame = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: l2_m_n >= 8
        return: l2_error(path, fn_node, "too many methods")
    fr: fn_node\as\frame
    if: fr\body = 0 || l2_count_active(fr\body) != 4
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_ident(field\value\as\atom) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    nm: field\value\as\atom
    if: l2_end_text(fr, nm) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_find_method(nm) >= 0
        return: l2_error(path, fn_node, "duplicate definition")
    if: nm\length >= 63U
        return: l2_error(path, fn_node, "name too long")
    field: l2_next_active(field\next)
    params: field\value
    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE || params\as = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: params\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    ar: l2_count_active(params\as\structure)
    if: ar < 1 || ar > 4
        return: l2_error(path, fn_node, "incompatible entry signature")
    p: l2_next_active(params\as\structure\first_field)
    j: 0
    while: j < ar
        ty: 0
        fa: 0
        if: p = 0 || l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            return: 1
        if: fa = 0 || fa\length >= 63U
            return: l2_error(path, fn_node, "name too long")
        k: 0
        while: k < j
            if: l2_text_same(fa, l2_m_fn[l2_m_n * 4 + k])
                return: l2_error(path, p\value, "duplicate formal")
            k: k + 1
        l2_m_fn[l2_m_n * 4 + j]: fa
        l2_m_ft[l2_m_n * 4 + j]: ty
        p: l2_next_active(p\next)
        j: j + 1
    l2_m_arity[l2_m_n]: ar
    l2_m_f0[l2_m_n]: l2_m_fn[l2_m_n * 4]
    l2_m_f1[l2_m_n]: 0
    if: ar >= 2
        l2_m_f1[l2_m_n]: l2_m_fn[l2_m_n * 4 + 1]
    field: l2_next_active(field\next)
    if: field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_text_eq(field\value\as\atom, "int")
        l2_m_ret[l2_m_n]: 0
    if: l2_text_eq(field\value\as\atom, "size_t")
        l2_m_ret[l2_m_n]: 2
    if: l2_text_eq(field\value\as\atom, "int") = 0 && l2_text_eq(field\value\as\atom, "size_t") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: field\value
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: body\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    id: l2_intern_mi(l2_m_n)
    if: id = 0U
        return: l2_error(path, fn_node, "intern table full")
    l2_m_name[l2_m_n]: nm
    l2_m_node[l2_m_n]: (cast: (@: LmP0Node) fn_node)
    l2_m_body[l2_m_n]: (cast: (@: LmP0Node) body)
    l2_m_sig[l2_m_n]: id
    l2_m_own[l2_m_n]: 0
    p: l2_next_active(body\as\structure\first_field)
    while: p != 0 && l2_is_char_decl(p\value)
        fa: 0
        fa: l2_next_active(p\value\as\frame\body\first_field)\value\as\atom
        j: l2_own_add(fa, path, p\value)
        if: j < 0
            return: 1
        l2_m_uses[l2_m_n * 4 + j]: 1
        l2_m_own[l2_m_n]: l2_m_own[l2_m_n] + 1
        p: l2_next_active(p\next)
    ---
    l2_m_n: l2_m_n + 1
return: 0

fn: l2_check_primary (const: @(LmP0Node node); int: mi; const: @(char path)) int
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    int: idx
    if: node = 0
        return: l2_error(path, node, "unsupported body")
    if: node\kind = c.LM_P0_NODE_ATOM
        if: l2_num(node\as\atom)
            return: 0
        if: l2_ident(node\as\atom) = 0
            return: l2_error(path, node, "unsupported body")
        if: mi >= 0
            idx: 0
            while: idx < l2_m_arity[mi]
                if: l2_text_same(node\as\atom, l2_m_fn[mi * 4 + idx])
                    return: 0
                idx: idx + 1
            ---
        if: mi >= 0
            idx: 0
            while: idx < l2_own_n
                if: l2_m_uses[mi * 4 + idx] != 0 && l2_text_same(node\as\atom, l2_own_name[idx])
                    return: 0
                idx: idx + 1
            ---
        return: l2_error(path, node, "unresolved name")
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        return: l2_check_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, path, node)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: l2_error(path, node, "unsupported body")
    if: l2_frame_head(node, "while") || l2_frame_head(node, "for")
        return: l2_error(path, node, "unsupported loop")
    if: l2_frame_head(node, "if") || l2_frame_head(node, "else") || l2_frame_head(node, "return") || l2_frame_head(node, "fn")
        return: l2_error(path, node, "unsupported body")
    call: node\as\frame
    if: call\head = 0
        return: l2_error(path, node, "unknown method")
    idx: l2_find_method(call\head)
    if: idx < 0
        return: l2_error(path, node, "unknown method")
    if: call\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: call\body = 0 || call\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: l2_count_active(call\body) != l2_m_arity[idx]
        return: l2_error(path, node, "incompatible entry signature")
    if: mi >= 0
        l2_m_edge[mi * 8 + idx]: 1
    a0: l2_next_active(call\body\first_field)
    while: a0 != 0
        if: a0\value = 0 || l2_check_primary(a0\value, mi, path) != 0
            return: 1
        a0: l2_next_active(a0\next)
return: 0

fn: l2_check_expr (const: @(LmP0Node node); int: mi; const: @(char path)) int
return: l2_check_primary(node, mi, path)

fn: l2_check_fields (@: LmP0Field field; int: n; int: mi; const: @(char path); const: @(LmP0Node at)) int
    @: LmP0Field f
    int: i
    int: skip
    if: n <= 0
        return: l2_error(path, at, "unsupported body")
    f: l2_next_active(field)
    i: 0
    while: i < n
        if: f = 0 || f\value = 0
            return: l2_error(path, at, "unsupported body")
        skip: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM && (l2_is_binop(f\value\as\atom) || l2_is_brack(f\value\as\atom) || l2_num(f\value\as\atom))
            skip: 1
        if: skip = 0 && l2_check_primary(f\value, mi, path) != 0
            return: 1
        i: i + 1
        f: l2_next_active(f\next)
return: 0

fn: l2_check_body (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    if: body = 0
        return: l2_error(path, 0, "unsupported body")
    if: mi < 0 && depth > 4
        return: l2_error(path, 0, "too deeply nested")
    if: mi >= 0 && depth > 5
        return: l2_error(path, 0, "too deeply nested")
    field: l2_next_active(body\first_field)
    if: field = 0
        return: l2_error(path, 0, "unsupported body")
    while: field != 0
        stmt: field\value
        if: l2_frame_head(stmt, "while") || l2_frame_head(stmt, "for")
            return: l2_error(path, stmt, "unsupported loop")
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            if: fr\body = 0
                return: l2_error(path, stmt, "unsupported body")
            if: fr\trailer != 0 && l2_end_named(fr, "if") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            n: l2_count_active(fr\body)
            if: n < 2
                return: l2_error(path, stmt, "unsupported body")
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_check_fields(fr\body\first_field, n - 1, mi, path, stmt) != 0
                return: 1
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                return: 1
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as\frame\body = 0
                return: l2_error(path, nxt\value, "unsupported body")
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as\frame\trailer != 0 && l2_end_named(nxt\value\as\frame, "else") = 0
                return: l2_error(path, nxt\value, "unsupported trailer")
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && l2_check_body(nxt\value\as\frame\body, mi, path, depth + 1) != 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || (l2_own_find(stmt\as\frame\head) < 0 && l2_slash_own(stmt\as\frame\head) < 0 && l2_find_method(stmt\as\frame\head) < 0))
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && fr\trailer != 0
            return: l2_error(path, stmt, "unsupported trailer")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (fr\body = 0 || fr\body\trailer != 0)
            return: l2_error(path, stmt, "unsupported trailer")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_find_method(fr\head) >= 0 && l2_check_primary(stmt, mi, path) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_find_method(fr\head) < 0 && l2_check_fields(fr\body\first_field, l2_count_active(fr\body), mi, path, stmt) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_dfs (int: u) int
    int: v 0
    if: l2_m_mark[u] = 1
        return: 1
    if: l2_m_mark[u] = 2
        return: 0
    l2_m_mark[u]: 1
    while: v < l2_m_n
        if: l2_m_edge[u * 8 + v] != 0 && l2_dfs(v) != 0
            return: 1
        v: v + 1
    l2_m_mark[u]: 2
return: 0

fn: l2_parse_unit (const: @(LmP0Node main_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node body
    int: i 0
    if: main_node = 0 || main_node\as = 0 || main_node\as\frame = 0
        return: l2_error(path, main_node, "unsupported body")
    fr: main_node\as\frame
    if: l2_end_named(fr, "main") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    if: fr\body = 0 || l2_count_active(fr\body) != 4
        return: l2_error(path, main_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, main_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(field\value\as\atom, "main") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    if: l2_empty_struct(field\value) = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(field\value\as\atom, "int") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: field\value
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, main_node, "unsupported body")
    if: body\as\structure\trailer != 0
        return: l2_error(path, main_node, "unsupported trailer")
    l2_main_body: body\as\structure
    if: l2_intern_prove(path, l2_m_node[0]) != 0
        return: 1
    while: i < l2_m_n
        if: l2_check_body(l2_m_body[i]\as\structure, i, path, 0) != 0
            return: 1
        i: i + 1
    if: l2_check_body(body\as\structure, -1, path, 0) != 0
        return: 1
    i: 0
    while: i < l2_m_n
        l2_m_mark[i]: 0
        i: i + 1
    i: 0
    while: i < l2_m_n
        if: l2_dfs(i) != 0
            return: l2_error(path, l2_m_node[i], "unsupported recursion")
        i: i + 1
    l2_leaf_mode: 1
return: 0

fn: l2_tok_text (const: @(LmP0Text t); @: char dest) int
    if: t = 0 || t\data = 0 || dest = 0 || t\length >= 63U
        return: 1
    c.memcpy(dest, t\data, t\length)
    dest[t\length]: 0
return: 0

fn: l2_tok_temp (int: k; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", k) < 0
        return: 1
return: 0

fn: l2_cat (@: char dest; const: @(char src)) int
    size_t: nd
    size_t: ns
    if: dest = 0 || src = 0
        return: 1
    nd: c.strlen(dest)
    ns: c.strlen(src)
    if: nd + ns >= 255U
        return: 1
    c.memcpy(dest + nd, src, ns + 1U)
return: 0

fn: l2_tok_formal (int: mi; int: fi; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_p%d_%d", mi, fi) < 0
        return: 1
return: 0

fn: l2_prep (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    int: t
    int: idx
    c.array: [64]: char saved
    if: node = 0 || dest = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_ATOM
        if: mi >= 0
            idx: 0
            while: idx < l2_m_arity[mi]
                if: l2_text_same(node\as\atom, l2_m_fn[mi * 4 + idx])
                    return: l2_tok_formal(mi, idx, dest)
                idx: idx + 1
            ---
        if: mi >= 0
            idx: 0
            while: idx < l2_own_n
                if: l2_m_uses[mi * 4 + idx] != 0 && l2_text_same(node\as\atom, l2_own_name[idx])
                    if: c.sprintf(dest, "l2_q%d", idx) < 0
                        return: 1
                    return: 0
                idx: idx + 1
            ---
        return: l2_tok_text(node\as\atom, dest)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        if: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
            return: l2_eval_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, ind, dest)
        if: l2_cat(dest, "(") != 0
            return: 1
        if: l2_emit_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, ind, l2_lhs) != 0
            return: 1
        if: l2_cat(dest, l2_lhs) != 0
            return: 1
        return: l2_cat(dest, ")")
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 1
    call: node\as\frame
    idx: l2_find_method(call\head)
    if: idx < 0
        return: 1
    a0: l2_next_active(call\body\first_field)
    c.array: [64]: char s0
    c.array: [64]: char s1
    c.array: [64]: char s2
    c.array: [64]: char s3
    t: 0
    s0[0]: 0
    s1[0]: 0
    s2[0]: 0
    s3[0]: 0
    while: a0 != 0
        if: t = 0 && l2_prep(a0\value, mi, ind, s0) != 0
            return: 1
        if: t = 1 && l2_prep(a0\value, mi, ind, s1) != 0
            return: 1
        if: t = 2 && l2_prep(a0\value, mi, ind, s2) != 0
            return: 1
        if: t = 3 && l2_prep(a0\value, mi, ind, s3) != 0
            return: 1
        t: t + 1
        a0: l2_next_active(a0\next)
    if: l2_emit_checkpoint(mi, ind) != 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_m_ret[idx] = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n", ind, t) < 0
        return: 1
    if: l2_m_ret[idx] != 2 && c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_t%d: ", ind, t) < 0
        return: 1
    if: l2_write_sym(l2_out, idx) != 0
        return: 1
    if: c.fprintf(l2_out, "(%s", l2_call_node) < 0
        return: 1
    if: s0[0] != 0 && c.fprintf(l2_out, ", %s", s0) < 0
        return: 1
    if: s1[0] != 0 && c.fprintf(l2_out, ", %s", s1) < 0
        return: 1
    if: s2[0] != 0 && c.fprintf(l2_out, ", %s", s2) < 0
        return: 1
    if: s3[0] != 0 && c.fprintf(l2_out, ", %s", s3) < 0
        return: 1
    if: c.fputs(")\n", l2_out) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_inline_call (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field a0
    int: cidx
    c.array: [64]: char one
    if: node = 0 || node\as = 0 || dest = 0
        return: 1
    cidx: l2_find_method(node\as\frame\head)
    if: cidx < 0
        return: 1
    if: l2_tok_sym(cidx, one) != 0 || l2_cat(dest, one) != 0
        return: 1
    if: l2_cat(dest, "(") != 0 || l2_cat(dest, l2_call_node) != 0
        return: 1
    a0: l2_next_active(node\as\frame\body\first_field)
    while: a0 != 0
        if: l2_prep(a0\value, mi, ind, one) != 0
            return: 1
        if: l2_cat(dest, ", ") != 0 || l2_cat(dest, one) != 0
            return: 1
        a0: l2_next_active(a0\next)
    if: l2_cat(dest, ")") != 0
        return: 1
return: 0

fn: l2_emit_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    int: i
    int: ao
    c.array: [256]: char buf
    if: dest = 0
        return: 1
    dest[0]: 0
    buf[0]: 0
    if: n = 1
        return: l2_prep(l2_next_active(field)\value, mi, ind, dest)
    f: l2_next_active(field)
    i: 0
    ao: 0
    while: i < n && f != 0 && f\value != 0
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_brack(f\value\as\atom)
            if: l2_tok_text(f\value\as\atom, l2_lhs) != 0 || l2_cat(buf, l2_lhs) != 0
                return: 1
            ao: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
            if: l2_cat(buf, " ") != 0
                return: 1
            if: l2_tok_text(f\value\as\atom, l2_lhs) != 0 || l2_cat(buf, l2_lhs) != 0
                return: 1
            if: l2_cat(buf, " ") != 0
                return: 1
            ao: l2_is_andor(f\value\as\atom)
        if: (f\value\kind != c.LM_P0_NODE_ATOM || (l2_is_brack(f\value\as\atom) = 0 && l2_is_binop(f\value\as\atom) = 0)) && ao != 0 && f\value\kind = c.LM_P0_NODE_FRAME && l2_find_method(f\value\as\frame\head) >= 0 && l2_inline_call(f\value, mi, ind, buf) != 0
            return: 1
        if: (f\value\kind != c.LM_P0_NODE_ATOM || (l2_is_brack(f\value\as\atom) = 0 && l2_is_binop(f\value\as\atom) = 0)) && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_find_method(f\value\as\frame\head) < 0) && l2_prep(f\value, mi, ind, l2_rhs) != 0
            return: 1
        if: (f\value\kind != c.LM_P0_NODE_ATOM || (l2_is_brack(f\value\as\atom) = 0 && l2_is_binop(f\value\as\atom) = 0)) && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_find_method(f\value\as\frame\head) < 0) && l2_cat(buf, l2_rhs) != 0
            return: 1
        if: f\value\kind != c.LM_P0_NODE_ATOM || (l2_is_brack(f\value\as\atom) = 0 && l2_is_binop(f\value\as\atom) = 0)
            ao: 0
        f: l2_next_active(f\next)
        i: i + 1
    c.memcpy(dest, buf, 256U)
return: 0

fn: l2_eval_and (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    c.array: [32]: char deep
    c.array: [256]: char rhs
    if: dest = 0 || n <= 0
        return: 1
    if: l2_bump_ind(ind, deep) != 0
        return: 1
    span: l2_span_and(field, n)
    if: span = n
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_emit_fields(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest, rhs) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_and(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s\n", ind, dest) < 0
            return: 1
        if: l2_emit_fields(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest, rhs) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

fn: l2_eval_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    c.array: [32]: char deep
    c.array: [256]: char rhs
    if: dest = 0 || n <= 0
        return: 1
    if: l2_fields_has_call(field, n) = 0
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_bump_ind(ind, deep) != 0
        return: 1
    span: l2_span_or(field, n)
    if: span = n
        return: l2_eval_and(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_eval_and(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest, rhs) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_or(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s = 0\n", ind, dest) < 0
            return: 1
        if: l2_eval_and(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest, rhs) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

fn: l2_emit_sig (int: mi) int
    int: j 0
    if: c.fputs(" (@: Lmx node", l2_out) < 0
        return: 1
    while: j < l2_m_arity[mi]
        if: l2_m_ft[mi * 4 + j] = 0 && c.fprintf(l2_out, "; int: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 1 && c.fprintf(l2_out, "; char: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 2 && c.fprintf(l2_out, "; size_t: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_m_ft[mi * 4 + j] = 3 && c.fprintf(l2_out, "; const: @(char l2_p%d_%d)", mi, j) < 0
            return: 1
        j: j + 1
    if: l2_m_ret[mi] = 2 && c.fputs(") size_t", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] != 2 && c.fputs(") int", l2_out) < 0
        return: 1
return: 0

fn: l2_emit_expr (const: @(LmP0Node node); int: mi; const: @(char ind)) int
return: l2_prep(node, mi, ind, l2_tok)

fn: l2_emit_checkpoint (int: mi; const: @(char ind)) int
    int: i 0
    if: mi < 0 || ind = 0
        return: 0
    while: i < l2_own_n
        if: l2_m_uses[mi * 4 + i] != 0 && c.fprintf(l2_out, "%sif: l2_q%d_dirty != 0\n", ind, i) < 0
            return: 1
        if: l2_m_uses[mi * 4 + i] != 0 && c.fprintf(l2_out, "%s    l2_q%d_from\\data: lmx_char_cell((cast: (int) l2_q%d))\n", ind, i, i) < 0
            return: 1
        if: l2_m_uses[mi * 4 + i] != 0 && c.fprintf(l2_out, "%s    l2_q%d_dirty: 0\n", ind, i) < 0
            return: 1
        i: i + 1
return: 0

fn: l2_emit_body (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    int: oi
    size_t: ln
    c.array: [32]: char deep
    ln: c.strlen(ind)
    if: ln + 5U >= 32U
        return: 1
    c.memcpy(deep, ind, ln)
    deep[ln]: 32
    deep[ln + 1U]: 32
    deep[ln + 2U]: 32
    deep[ln + 3U]: 32
    deep[ln + 4U]: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_eval_fields(fr\body\first_field, n - 1, mi, ind, l2_tok) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", ind, l2_tok) < 0
                return: 1
            if: l2_emit_body(last\value\as\structure, mi, deep) != 0
                return: 1
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && c.fprintf(l2_out, "%selse:\n", ind) < 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && l2_emit_body(nxt\value\as\frame\body, mi, deep) != 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_emit_checkpoint(mi, ind) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && c.fprintf(l2_out, "%sreturn: %s\n", ind, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return")
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0
            oi: l2_own_find(fr\head)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && c.fprintf(l2_out, "%sl2_q%d: %s\n", ind, oi, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && c.fprintf(l2_out, "%sl2_q%d_dirty: 1\n", ind, oi) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && l2_find_method(fr\head) >= 0 && l2_prep(stmt, mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && l2_find_method(fr\head) >= 0
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && l2_find_method(fr\head) < 0
            oi: l2_slash_own(fr\head)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_own_find(fr\head) < 0 && l2_find_method(fr\head) < 0 && oi < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_own_find(fr\head) < 0 && l2_find_method(fr\head) < 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_own_find(fr\head) < 0 && l2_find_method(fr\head) < 0 && c.fprintf(l2_out, "%sl2_xp: lmx_branch_child(node, %uU)\n", ind, (cast: (unsigned) oi)) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_own_find(fr\head) < 0 && l2_find_method(fr\head) < 0 && c.fprintf(l2_out, "%sif: l2_xp = 0\n", ind) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_own_find(fr\head) < 0 && l2_find_method(fr\head) < 0 && l2_emit_checkpoint(mi, deep) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_own_find(fr\head) < 0 && l2_find_method(fr\head) < 0 && l2_m_ret[mi] = 2 && c.fprintf(l2_out, "%s    return: 0U\n", ind) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_own_find(fr\head) < 0 && l2_find_method(fr\head) < 0 && l2_m_ret[mi] != 2 && c.fprintf(l2_out, "%s    return: 0\n", ind) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_own_find(fr\head) < 0 && l2_find_method(fr\head) < 0 && c.fprintf(l2_out, "%sl2_xp\\data: lmx_char_cell((cast: (int) %s))\n", ind, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_own_find(fr\head) < 0 && l2_find_method(fr\head) < 0
            field: l2_next_active(field\next)
return: 0

fn: l2_emit_unit (const: @(char out_path)) int
    int: i 0
    int: k
    unsigned: n
    unsigned: cap
    unsigned: kids
    int: bseq
    size_t: pn
    c.array: [512]: char tmp
    c.array: [512]: char bak
    @: FILE chk
    int: had 0
    if: out_path = 0 || l2_m_n = 0 || l2_main_body = 0
        return: 1
    n: (cast: (unsigned) l2_m_n)
    pn: c.strlen(out_path)
    if: pn + 5U >= 512U
        return: 1
    c.memcpy(tmp, out_path, pn)
    tmp[pn]: 46
    tmp[pn + 1U]: 116
    tmp[pn + 2U]: 109
    tmp[pn + 3U]: 112
    tmp[pn + 4U]: 0
    l2_out: c.fopen(tmp, "wb")
    if: l2_out = 0
        c.fprintf(c.stderr, "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: c.fputs("predef: \"l2src/lmx_branch.lm1\"\ninclude: \"l2src/lmx.h\" \"<stdio.h>\" \"<stdlib.h>\" \"<string.h>\"\n\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("# interned contract: rec.sig is translator intern id of the full canonical contract.\n# L2_SIG_V0 schema plus arity and exact ordered source formal names/types (int, char, size_t, const char*). Throws-none, no dyn/varargs. Method name is not interned.\n# Mapping: id 1 := first interned contract of this unit. l2_sig_f0/f1 are method 0's first two source names (empty if arity is below that).\n# Linked-program intern only, not inter-module canonicalization. One intern table for the unit, not reset per method.\n# Runtime: no memcmp; closed-unit devirtualization. Formal names are the intern entry for rec.sig.\nconst: @(char l2_sig_f0) \"", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_write_text(l2_out, l2_m_f0[0]) != 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("\"\nconst: @(char l2_sig_f1) \"", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_m_f1[0] != 0 && l2_write_text(l2_out, l2_m_f1[0]) != 0
        c.fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "\"\nunsigned: l2_intern_id %uU\nunsigned: l2_intern_again %uU\nunsigned: l2_intern_swap %uU\nunsigned: l2_intern_probe %uU\n", l2_sigv, l2_intern_again, l2_intern_swap, l2_intern_probe) < 0
        c.fclose(l2_out)
        return: 1
    k: 0
    while: k < l2_own_n
        if: c.fprintf(l2_out, "const: @(char l2_own%d) \"", k) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_text(l2_out, l2_own_name[k]) != 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs("\"\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        k: k + 1
    ---
    if: c.fputs("\nprototype:\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    while: i < l2_m_n
        if: c.fputs("    fn: ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            c.fclose(l2_out)
            return: 1
        if: l2_emit_sig(i) != 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs("\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        i: i + 1
    if: c.fputs("end: prototype\n\n# Backend method symbols are l2_m{i}; intern and find_method keep source names. c.malloc stays the foreign door.\n# Publication: write tmp; if dest.bak exists pick dest.bak.N; rename dest to that bak; rename tmp to dest; on fail restore bak or report its path. Not atomic. No recursive FS. Foreign bak is not deleted.\n# OwnUsed char fields are children of callable->node; C cache is typed char; graph data is all_chars cell. Dirty-only checkpoint after actuals, immediately before the executed call, and before return. Explicit node\\name writes the graph, not the cache. &&/|| with calls use guarded if/temps; skipped RHS does not prep nested actuals. Pure &&/|| stay L1 C expressions.\n\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_m_n
        if: c.fputs("fn: ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            c.fclose(l2_out)
            return: 1
        if: l2_emit_sig(i) != 0
            c.fclose(l2_out)
            return: 1
        if: l2_m_ret[i] = 2 && c.fputs("\n    if: node = 0\n        return: 0U\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_m_ret[i] != 2 && c.fputs("\n    if: node = 0\n        return: 0\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        k: 0
        while: k < l2_own_n
            if: l2_m_uses[i * 4 + k] != 0 && c.fprintf(l2_out, "    char: l2_q%d\n    @: Lmx l2_q%d_from 0\n    int: l2_q%d_dirty 0\n", k, k, k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_m_uses[i * 4 + k] != 0 && c.fprintf(l2_out, "    l2_q%d_from: lmx_branch_child(node, %uU)\n    if: l2_q%d_from = 0\n        return: 0\n    l2_q%d: (cast: (char) lmx_char_value(l2_q%d_from\\data))\n", k, (cast: (unsigned) k), k, k, k) < 0
                c.fclose(l2_out)
                return: 1
            k: k + 1
        ---
        if: l2_own_n != 0 && c.fputs("    @: Lmx l2_xp 0\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        l2_tn: 0
        l2_call_node: "node"
        if: l2_emit_body(l2_m_body[i]\as\structure, i, "    ") != 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs("end: ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs("\n\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        i: i + 1
    cap: n + 1U
    if: l2_own_n != 0
        cap: n + 2U
    kids: n + (cast: (unsigned) l2_own_n)
    if: c.fprintf(l2_out, "external:\n    fn: main () int\n        @: Lmx unit 0\n        @: Lmx leaf 0\n        @: LmxMethod rec 0\n        if: lmx_ranges_init(%uU) != 0\n            return: 1\n", cap) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_own_n != 0 && c.fputs("        if: lmx_chars_init() != 0\n            return: 1\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "        unit: (cast: (@: Lmx) c.malloc(c.sizeof(c.Lmx)))\n        if: unit = 0\n            return: 1\n        lmx_cell_init(unit, 0, 0)\n        if: lmx_branch_open(unit, %uU) != 0\n            return: 1\n", kids) < 0
        c.fclose(l2_out)
        return: 1
    k: 0
    while: k < l2_own_n
        if: c.fprintf(l2_out, "        leaf: lmx_branch_child(unit, %uU)\n        if: leaf = 0\n            return: 1\n        leaf\\data: lmx_char_cell(0)\n        if: lmx_type_of(leaf\\data) != c.LMX_TYPE_CHAR\n            return: 1\n", (cast: (unsigned) k)) < 0
            c.fclose(l2_out)
            return: 1
        k: k + 1
    ---
    i: 0
    while: i < l2_m_n
        if: c.fputs("        rec: (cast: (@: LmxMethod) c.malloc(c.sizeof(c.LmxMethod)))\n        if: rec = 0\n            return: 1\n        rec\\addr: (cast: (LmxEntry) ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            c.fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, ")\n        rec\\sig: %uU\n        if: lmx_range_register((cast: (@: void) rec), (cast: (@: void) (rec + 1)), c.sizeof(c.LmxMethod), c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD) != 0\n            return: 1\n        leaf: lmx_branch_child(unit, %uU)\n        if: leaf = 0\n            return: 1\n        leaf\\data: (cast: (@: void) rec)\n        if: lmx_classify(leaf\\data) != c.LMX_KIND_METHOD\n            return: 1\n        if: rec\\sig != %uU\n            return: 1\n        if: leaf\\node != unit\n            return: 1\n", l2_m_sig[i], (cast: (unsigned) (l2_own_n + i)), l2_m_sig[i]) < 0
            c.fclose(l2_out)
            return: 1
        i: i + 1
    if: c.fputs("        if: l2_intern_again != l2_intern_id\n            return: 1\n        if: l2_sig_f0[0] = 0\n            return: 1\n        # Closed-unit devirtualization: translator-bound child indices, no graph mutations after construction. rec.addr is METHOD-domain storage, not the call. Runtime does not memcmp formals. Evaluation order of actuals is materialized into temps before each call boundary.\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    l2_tn: 0
    l2_call_node: "unit"
    if: l2_emit_body(l2_main_body, -1, "        ") != 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("    end: main\nend: external\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fclose(l2_out) != 0
        c.remove(tmp)
        return: 1
    if: pn + 8U >= 512U
        c.remove(tmp)
        return: 1
    c.memcpy(bak, out_path, pn)
    bak[pn]: 46
    bak[pn + 1U]: 98
    bak[pn + 2U]: 97
    bak[pn + 3U]: 107
    bak[pn + 4U]: 0
    bseq: 0
    chk: c.fopen(bak, "rb")
    while: chk != 0
        c.fclose(chk)
        bseq: bseq + 1
        if: bseq > 99
            c.remove(tmp)
            return: 1
        if: c.sprintf(bak, "%s.bak.%d", out_path, bseq) < 0
            c.remove(tmp)
            return: 1
        chk: c.fopen(bak, "rb")
    ---
    chk: c.fopen(out_path, "rb")
    if: chk != 0
        had: 1
        c.fclose(chk)
    if: had != 0 && c.rename(out_path, bak) != 0
        c.remove(tmp)
        return: 1
    if: c.rename(tmp, out_path) != 0
        if: had != 0 && c.rename(bak, out_path) != 0
            c.fprintf(c.stderr, "l2trans error: publication failed; dest unrestored; backup at %s\n", bak)
            return: 1
        return: 1
    if: had != 0
        c.remove(bak)
return: 0

external:
    fn: main (int: argc; @@: char argv) int
        c.setvbuf(c.stdout, 0, c._IONBF, 0)
        c.setvbuf(c.stderr, 0, c._IONBF, 0)
        if: argc != 3
            c.fputs("usage: l2trans.exe <source.lm2> <output.lm1>\n", c.stderr)
            return: 1
    return: l2_translate(argv[1], argv[2])
end: external
