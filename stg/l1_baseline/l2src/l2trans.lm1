        c.fclose(l2_out)
        return: 1
    if: l2_emit_body(l2_main_body, -1, "        ") != 0
        c.fclose(l2_out)
        return: 1
    if: l2_main_node != 0 && l2_main_node\as != 0 && l2_emit_ret_tr(-1, "        ", l2_ret_tr(l2_main_node\as\frame)) != 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("    end: main\nend: external\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fclose(l2_out) != 0
        c.remove(tmp)
        return: 1
    if: pn + 8U >= 512U
        c.remove(tmp)
        return: 1
    c.memcpy(bak, out_path, pn)
    bak[pn]: 46
    bak[pn + 1U]: 98
    bak[pn + 2U]: 97
    bak[pn + 3U]: 107
    bak[pn + 4U]: 0
    bseq: 0
    chk: c.fopen(bak, "rb")
    while: chk != 0
        c.fclose(chk)
        bseq: bseq + 1
        if: bseq > 99
            c.remove(tmp)
            return: 1
        if: c.sprintf(bak, "%s.bak.%d", out_path, bseq) < 0
            c.remove(tmp)
            return: 1
        chk: c.fopen(bak, "rb")
    ---
    chk: c.fopen(out_path, "rb")
    if: chk != 0
        had: 1
        c.fclose(chk)
    if: had != 0 && c.rename(out_path, bak) != 0
        c.remove(tmp)
        return: 1
    if: c.rename(tmp, out_path) != 0
        if: had != 0 && c.rename(bak, out_path) != 0
            c.fprintf(c.stderr, "l2trans error: publication failed; dest unrestored; backup at %s\n", bak)
            return: 1
        return: 1
    if: had != 0
        c.remove(bak)
return: 0

external:
    fn: main (int: argc; @@: char argv) int
        int: r
        @: FILE af
        const: @: char lg
        c.setvbuf(c.stdout, 0, c._IONBF, 0)
        c.setvbuf(c.stderr, 0, c._IONBF, 0)
        if: argc != 3
            c.fputs("usage: l2trans.exe <source.lm2> <output.lm1>\n", c.stderr)
            return: 1
        if: c.getenv("L2_FAIL_MALLOC") != 0
            l2_fail_left: c.atoi(c.getenv("L2_FAIL_MALLOC"))
        r: l2_translate(argv[1], argv[2])
        l2_release()
        lg: c.getenv("L2_ALLOC_LOG")
        if: lg != 0
            af: c.fopen(lg, "wb")
            if: af != 0
                c.fprintf(af, "n=%d free=%d live=%d fail_at=%d fail_kind=%d err=%d\n", l2_alloc_n, l2_free_n, l2_alloc_live, l2_alloc_fail_at, l2_alloc_fail_kind, l2_alloc_err)
                c.fclose(af)
            ---
        ---
    return: r
end: external
