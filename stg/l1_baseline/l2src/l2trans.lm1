    if: l2_m_ret[idx] = 36 && c.fprintf(l2_out, "%sulong: l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 3 && c.fprintf(l2_out, "%s@: char l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 16 && c.fprintf(l2_out, "%s@: void l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 35 && c.fprintf(l2_out, "%sconst: @(char l2_t%d)\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 32 && c.fprintf(l2_out, "%s@@: char l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] >= 100 && l2_emit_foreign_temp(l2_out, l2_m_ret[idx], ind, t) != 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 5 && c.fprintf(l2_out, "%s@: LmP0Text l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 10 && c.fprintf(l2_out, "%sLmP0TrailerRole: l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 13 && c.fprintf(l2_out, "%s@: LmP0IndentStack l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_ret_uns(idx) = 0 && l2_m_ret[idx] != 3 && l2_m_ret[idx] != 5 && l2_m_ret[idx] != 8 && l2_m_ret[idx] != 10 && l2_m_ret[idx] != 13 && l2_m_ret[idx] != 16 && l2_m_ret[idx] != 32 && l2_m_ret[idx] != 35 && l2_m_ret[idx] < 100 && c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_throws[idx] != 0 && c.fprintf(l2_out, "%sint: l2_ts%d 0\n%s@: Lmx l2_te%d 0\n", ind, t, ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 8 && l2_m_throws[idx] = 0 && c.fprintf(l2_out, "%s", ind) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] != 8 && l2_m_throws[idx] = 0 && c.fprintf(l2_out, "%sl2_t%d: ", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_throws[idx] != 0 && c.fprintf(l2_out, "%sl2_ts%d: ", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_write_sym(l2_out, idx) != 0
        return: l2_prep_drop(acts, hides)
    # The reserved argument is the SELECTED CALLABLE's own Structure, never the
    # caller's. It is the unit child at l2_unit_base + idx; the descriptor sits
    # in its slot 0 and its own fields follow.
    if: l2_call_sel = 0 && c.fprintf(l2_out, "(lmx_branch_struct_known(%s, %uU)", l2_unit_ref, (cast: (unsigned) (l2_unit_base + idx))) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_call_sel != 0 && c.fputs("(l2_pst", l2_out) < 0
        return: l2_prep_drop(acts, hides)
    ai: 0
    while: ai < nact
        if: c.fprintf(l2_out, ", %s", l2_act_at(acts, ai)) < 0
            return: l2_prep_drop(acts, hides)
        ai: ai + 1
    ai: 0
    while: ai < nhid
        if: c.fprintf(l2_out, ", %s", l2_act_at(hides, ai)) < 0
            return: l2_prep_drop(acts, hides)
        ai: ai + 1
    if: l2_m_throws[idx] != 0 && c.fputs(", process_message", l2_out) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_throws[idx] != 0 && l2_m_ret[idx] != 8 && c.fprintf(l2_out, ", @ l2_t%d", t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_throws[idx] != 0 && c.fprintf(l2_out, ", @ l2_te%d", t) < 0
        return: l2_prep_drop(acts, hides)
    l2_prep_drop(acts, hides)
    if: c.fputs(")\n", l2_out) < 0
        return: 1
    # Publish writes already known to this activation after the call and before
    # a following explicit node\field read. Merely taking an address does not
    # mark a graph-backed own cache dirty.
    if: l2_emit_checkpoint(mi, ind) != 0
        return: 1
    if: l2_m_throws[idx] != 0 && mi >= 0 && c.fprintf(l2_out, "%sif: l2_ts%d != 0\n%s    l2_out_throw[0]: l2_te%d\n%s    return: l2_ts%d\n", ind, t, ind, t, ind, t) < 0
        return: 1
    if: l2_m_throws[idx] != 0 && mi < 0 && c.fprintf(l2_out, "%sif: l2_ts%d != 0\n%s    return: 70\n", ind, t, ind) < 0
        return: 1
return: l2_tok_temp(t, dest)

# Follow the admitted unit-child/descriptor/backing contract, without allocation,
# scalar dirty caches, intern lookup, or descriptor rebinding.
fn: l2_emit_array_ptr (int: oi; const: @(char ind); @: char dest) int
    int: t
    const: @(char element) "int"
    @: LmP0Field type_field
    if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0 || (l2_own_fid[oi] < 0 && l2_own_uchild[oi] < 0) || dest = 0
        c.fprintf(c.stderr, "l2trans detail: array pointer unavailable oi=%d\n", oi)
        return: 1
    if: l2_own_ty[oi] = 5
        element: "char"
    if: l2_own_ty[oi] = 7
        element: "size_t"
    if: l2_own_ty[oi] = 37
        element: "ulong"
    if: l2_own_ty[oi] = 8
        type_field: l2_next_active(l2_own_decl[oi]\as\frame\body\first_field)
        if: type_field = 0 || type_field\value = 0 || type_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "l2trans detail: imported array type spelling unavailable oi=%d\n", oi)
            return: 1
        ---
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%s@@: void l2_a%d_leaf\n%s@: LmxArrayDesc l2_a%d_desc\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_ty[oi] != 8 && l2_own_ty[oi] < 2000 && c.fprintf(l2_out, "%s@: %s l2_a%d_data\n", ind, element, t) < 0
        return: 1
    if: l2_own_ty[oi] = 8
        if: c.fprintf(l2_out, "%s@: ", ind) < 0 || l2_write_text(l2_out, type_field\value\as\atom) != 0 || c.fprintf(l2_out, " l2_a%d_data\n", t) < 0
            return: 1
        ---
    if: l2_own_ty[oi] >= 2000
        if: c.fputs(ind, l2_out) < 0 || l2_emit_own_pointer_array_data_type(l2_out, l2_own_ty[oi]) != 0 || c.fprintf(l2_out, " l2_a%d_data\n", t) < 0
            return: 1
    ---
    if: l2_own_fid[oi] >= 0 && c.fprintf(l2_out, "%sl2_a%d_leaf: lmx_branch_slot_known(l2_h%d, %uU)\n", ind, t, l2_own_fid[oi], (cast: (unsigned) l2_own_fchild[oi])) < 0
        return: 1
    if: l2_own_fid[oi] < 0 && c.fprintf(l2_out, "%sl2_a%d_leaf: lmx_branch_slot_known(%s, %uU)\n", ind, t, l2_own_ctr(oi), (cast: (unsigned) l2_own_uchild[oi])) < 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_a%d_desc: (cast: (@: LmxArrayDesc) l2_a%d_leaf[0])\n", ind, t, t) < 0
        return: 1
    if: l2_own_ty[oi] != 8 && l2_own_ty[oi] < 2000 && c.fprintf(l2_out, "%sl2_a%d_data: (cast: (@: %s) l2_a%d_desc\\data)\n", ind, t, element, t) < 0
        return: 1
    if: l2_own_ty[oi] = 8
        if: c.fprintf(l2_out, "%sl2_a%d_data: (cast: (@: ", ind, t) < 0 || l2_write_text(l2_out, type_field\value\as\atom) != 0 || c.fprintf(l2_out, ") l2_a%d_desc\\data)\n", t) < 0
            return: 1
        ---
    if: l2_own_ty[oi] >= 2000
        if: c.fprintf(l2_out, "%sl2_a%d_data: (cast: (", ind, t) < 0 || l2_emit_own_pointer_array_data_type(l2_out, l2_own_ty[oi]) != 0 || c.fprintf(l2_out, ") l2_a%d_desc\\data)\n", t) < 0
            return: 1
        ---
    if: c.sprintf(dest, "l2_a%d_data", t) < 0
        return: 1
return: 0

fn: l2_emit_array_length (int: oi; const: @(char ind); @: char dest) int
    int: t
    if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0 || (l2_own_fid[oi] < 0 && l2_own_uchild[oi] < 0) || dest = 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%s@@: void l2_a%d_leaf\n%s@: LmxArrayDesc l2_a%d_desc\n%ssize_t: l2_t%d\n", ind, t, ind, t, ind, t) < 0
        return: 1
    if: l2_own_fid[oi] >= 0 && c.fprintf(l2_out, "%sl2_a%d_leaf: lmx_branch_slot_known(l2_h%d, %uU)\n", ind, t, l2_own_fid[oi], (cast: (unsigned) l2_own_fchild[oi])) < 0
        return: 1
    if: l2_own_fid[oi] < 0 && c.fprintf(l2_out, "%sl2_a%d_leaf: lmx_branch_slot_known(%s, %uU)\n", ind, t, l2_own_ctr(oi), (cast: (unsigned) l2_own_uchild[oi])) < 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_a%d_desc: (cast: (@: LmxArrayDesc) l2_a%d_leaf[0])\n%sl2_t%d: l2_a%d_desc\\len\n", ind, t, t, ind, t, t) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_emit_array_load (int: oi; size_t: index; const: @(char ind); @: char dest) int
    int: t
    const: @(char element) "int"
    c.array: [256]: char ptr
    if: l2_emit_array_ptr(oi, ind, ptr) != 0
        return: 1
    if: l2_own_ty[oi] = 5
        element: "char"
    if: l2_own_ty[oi] = 7
        element: "size_t"
    if: l2_own_ty[oi] = 37
        element: "ulong"
    if: l2_own_ty[oi] = 8
        # The admitted imported type is an unsigned-char alias. Keep its exact
        # spelling for ABI pointers, but widen a loaded value to L2's ordinary
        # unsigned scalar because L1 has no scalar unsigned-char declaration.
        element: "unsigned"
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_own_ty[oi] < 2000 && c.fprintf(l2_out, "%s%s: l2_t%d\n", ind, element, t) < 0
        return: 1
    if: l2_own_ty[oi] >= 2000
        if: c.fputs(ind, l2_out) < 0 || l2_emit_own_pointer_type(l2_out, l2_own_ty[oi] - 1000) != 0 || c.fprintf(l2_out, " l2_t%d\n", t) < 0
            return: 1
    ---
    if: c.fprintf(l2_out, "%sl2_t%d: %s[%zuU]\n", ind, t, ptr, index) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_emit_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Node at 0
    int: i
    int: ao
    int: after 0
    int: fld
    int: po
    int: have_value 0
    size_t: array_index
    int: array_count
    c.array: [256]: char buf
    c.array: [256]: char piece
    if: dest = 0
        return: 1
    buf[0]: 0
    if: n = 1
        return: l2_prep(l2_next_active(field)\value, mi, ind, dest)
    f: l2_next_active(field)
    i: 0
    ao: 0
    while: i < n && f != 0 && f\value != 0
        at: f\value
        if: l2_own_index_tail(f, mi, @ po, @ array_index, @ p2, @ array_count) = 0
            if: l2_emit_array_load(po, array_index, ind, piece) != 0 || l2_cat(buf, piece) != 0
                return: 1
            ao: 0
            after: 0
            have_value: 1
            i: i + array_count
            f: p2
            continue
        fld: 0
        piece[0]: 0
        p1: 0
        p2: 0
        po: -1
        if: f\value\kind = c.LM_P0_NODE_ATOM
            p1: l2_next_active(f\next)
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM
            po: l2_path_own(mi, f\value\as\atom, p2\value\as\atom)
        if: po >= 0
            if: l2_emit_path_load(mi, po, ind, piece) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
            have_value: 1
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        if: after != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom)
            fld: 1
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "@")
            if: l2_cat(buf, "@ ") != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
            have_value: 0
            i: i + 1
            f: l2_next_active(f\next)
            continue
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            if: l2_cat(buf, "\\") != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            if: have_value != 0
                after: 1
            else:
                after: 0
            ---
            fld: 2
        if: fld = 1
            if: l2_tok_text(f\value\as\atom, piece, 256U) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
            have_value: 1
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_brack(f\value\as\atom)
            if: l2_tok_text(f\value\as\atom, piece, 256U) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            fld: 2
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
            if: l2_cat(buf, " ") != 0
                return: l2_error(l2_src, at, "expression too long")
            if: l2_tok_text(f\value\as\atom, piece, 256U) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            if: l2_cat(buf, " ") != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: l2_is_andor(f\value\as\atom)
            have_value: 0
            fld: 2
        if: fld = 0 && ao != 0 && f\value\kind = c.LM_P0_NODE_FRAME && l2_find_method(f\value\as\frame\head) >= 0
            return: 1
        if: fld = 0 && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_find_method(f\value\as\frame\head) < 0) && l2_prep(f\value, mi, ind, piece) != 0
            return: 1
        if: fld = 0 && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_find_method(f\value\as\frame\head) < 0) && l2_cat(buf, piece) != 0
            return: l2_error(l2_src, at, "expression too long")
        if: fld = 0
            ao: 0
            after: 0
            have_value: 1
        f: l2_next_active(f\next)
        i: i + 1
    c.memcpy(dest, buf, 256U)
return: 0

fn: l2_eval_and (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    @: char deep 0
    c.array: [256]: char rhs
    if: dest = 0 || n <= 0
        return: 1
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    span: l2_span_and(field, n)
    if: span = n
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_emit_fields(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest, rhs) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_and(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s\n", ind, dest) < 0
            return: 1
        if: l2_emit_fields(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest, rhs) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

fn: l2_eval_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    @: char deep 0
    c.array: [256]: char rhs
    if: dest = 0 || n <= 0
        return: 1
    if: l2_fields_has_call(field, n) = 0
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    span: l2_span_or(field, n)
    if: span = n
        return: l2_eval_and(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_eval_and(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest, rhs) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_or(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s = 0\n", ind, dest) < 0
            return: 1
        if: l2_eval_and(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest, rhs) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

fn: l2_emit_sig (int: mi) int
    int: j 0
    if: c.fputs(" (@: Lmx node", l2_out) < 0
        return: 1
    while: j < l2_m_arity[mi]
        if: l2_ft(mi, j) = 0 && c.fprintf(l2_out, "; int: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 1 && c.fprintf(l2_out, "; char: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 2 && c.fprintf(l2_out, "; size_t: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 34 && c.fprintf(l2_out, "; unsigned: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 36 && c.fprintf(l2_out, "; ulong: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 3 && c.fprintf(l2_out, "; const: @(char l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 4 && c.fprintf(l2_out, "; const: @(LmP0Text l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 5 && c.fprintf(l2_out, "; @: LmP0Text l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 6 && c.fprintf(l2_out, "; const: @(L2ImmutQuery l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 7 && c.fprintf(l2_out, "; @: L2ImmutQuery l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 9 && c.fprintf(l2_out, "; @: size_t l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 10 && c.fprintf(l2_out, "; LmP0TrailerRole: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 11 && c.fprintf(l2_out, "; @: int l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 12 && c.fprintf(l2_out, "; @: char l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 13 && c.fprintf(l2_out, "; @: LmP0Document l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 14 && c.fprintf(l2_out, "; @: LmP0IndentStack l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 15 && c.fprintf(l2_out, "; const: @(LmP0IndentStack l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 16 && c.fprintf(l2_out, "; @: void l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 17 && c.fprintf(l2_out, "; @@: char l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 18 && c.fprintf(l2_out, "; @@: void l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 19 && c.fprintf(l2_out, "; @@: int l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 24 && c.fprintf(l2_out, "; @@: unsigned l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 39 && c.fprintf(l2_out, "; @@: ulong l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 26 && c.fprintf(l2_out, "; @@: LmxMsgBlock l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 28 && c.fprintf(l2_out, "; const: @(LmxMsgRuntime l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 29 && c.fprintf(l2_out, "; const: @(LmxMsg l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 30 && c.fprintf(l2_out, "; const: @(LmxMsgCopy l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 31 && c.fprintf(l2_out, "; @@: LmxMsgCopy l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 27 && c.fprintf(l2_out, "; @@: LmxOwnedRange l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 25 && c.fprintf(l2_out, "; @: unsigned l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 38 && c.fprintf(l2_out, "; @: ulong l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 20 && c.fprintf(l2_out, "; @@: size_t l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) >= 100 && l2_emit_foreign_formal(l2_out, l2_ft(mi, j), mi, j) != 0
            return: 1
        j: j + 1
    j: 0
    while: j < l2_m_dyn[mi]
        if: l2_dt(mi, j) = 1 && c.fprintf(l2_out, "; char: l2_p%d_%d", mi, l2_m_arity[mi] + j) < 0
            return: 1
        if: l2_dt(mi, j) = 2 && c.fprintf(l2_out, "; size_t: l2_p%d_%d", mi, l2_m_arity[mi] + j) < 0
            return: 1
        j: j + 1
    # `merge:` contributes the executing Message to the existing dynamic-input
    # group. Call-graph closure marks every method that must forward it.
    if: l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fputs("; @: LmxMsg process_message", l2_out) < 0
        return: 1
    # Declared-throw ABI: the outputs follow every input, the normal result
    # first and the throw payload last, and the control status is the return.
    # A callable that cannot throw keeps its direct return unchanged.
    if: l2_m_throws != 0 && l2_m_throws[mi] != 0
        if: l2_m_ret[mi] = 2 && c.fputs("; @: size_t l2_out_result", l2_out) < 0
            return: 1
        if: l2_m_ret[mi] = 30 && c.fputs("; @: unsigned l2_out_result", l2_out) < 0
            return: 1
        if: l2_m_ret[mi] = 33 && c.fputs("; @: unsigned l2_out_result", l2_out) < 0
            return: 1
        if: l2_m_ret[mi] = 36 && c.fputs("; @: ulong l2_out_result", l2_out) < 0
            return: 1
        if: l2_m_ret[mi] = 3 && c.fputs("; @@: char l2_out_result", l2_out) < 0
            return: 1
        if: l2_m_ret[mi] = 16 && c.fputs("; @@: void l2_out_result", l2_out) < 0
            return: 1
        if: l2_m_ret[mi] = 35 && c.fputs("; const: @@(char l2_out_result)", l2_out) < 0
            return: 1
        if: l2_m_ret[mi] = 32 && c.fputs("; @@@: char l2_out_result", l2_out) < 0
            return: 1
        if: l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 3 && l2_m_ret[mi] != 8 && l2_m_ret[mi] != 16 && l2_m_ret[mi] != 32 && l2_m_ret[mi] != 35 && c.fputs("; @: int l2_out_result", l2_out) < 0
            return: 1
        if: c.fputs("; @@: Lmx l2_out_throw) int", l2_out) < 0
            return: 1
        return: 0
    ---
    if: l2_m_ret[mi] = 2 && c.fputs(") size_t", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 30 && c.fputs(") LmxMsgAddr", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 33 && c.fputs(") unsigned", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 36 && c.fputs(") ulong", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 3 && c.fputs(") @: char", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 16 && c.fputs(") @: void", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 35 && c.fputs(") const: @(char)", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 32 && c.fputs(") @@: char", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] >= 100 && l2_emit_foreign_return(l2_out, l2_m_ret[mi]) != 0
        return: 1
    if: l2_m_ret[mi] = 5 && c.fputs(") @: LmP0Text", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 8 && c.fputs(")", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 10 && c.fputs(") LmP0TrailerRole", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 13 && c.fputs(") @: LmP0IndentStack", l2_out) < 0
        return: 1
    if: l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 3 && l2_m_ret[mi] != 5 && l2_m_ret[mi] != 8 && l2_m_ret[mi] != 10 && l2_m_ret[mi] != 13 && l2_m_ret[mi] != 16 && l2_m_ret[mi] != 32 && l2_m_ret[mi] != 35 && l2_m_ret[mi] < 100 && c.fputs(") int", l2_out) < 0
        return: 1
return: 0

fn: l2_emit_expr (const: @(LmP0Node node); int: mi; const: @(char ind)) int
return: l2_prep(node, mi, ind, l2_tok)

# Public C/L1 adapter signature for a source method. The callable's graph
# Structure remains an internal reserved argument and is therefore omitted.
fn: l2_emit_public_sig (int: mi) int
    int: j 0
    int: ty
    const: @(char sep) ""
    if: c.fputs(" (", l2_out) < 0
        return: 1
    while: j < l2_m_arity[mi]
        ty: l2_ft(mi, j)
        if: j != 0
            sep: "; "
        if: ty = 0 && c.fprintf(l2_out, "%sint: ", sep) < 0
            return: 1
        if: ty = 1 && c.fprintf(l2_out, "%schar: ", sep) < 0
            return: 1
        if: ty = 2 && c.fprintf(l2_out, "%ssize_t: ", sep) < 0
            return: 1
        if: ty = 34 && c.fprintf(l2_out, "%sunsigned: ", sep) < 0
            return: 1
        if: ty = 36 && c.fprintf(l2_out, "%sulong: ", sep) < 0
            return: 1
        if: ty = 3 && c.fprintf(l2_out, "%sconst: @(char ", sep) < 0
            return: 1
        if: ty = 5 && c.fprintf(l2_out, "%s@: LmP0Text ", sep) < 0
            return: 1
        if: ty = 9 && c.fprintf(l2_out, "%s@: size_t ", sep) < 0
            return: 1
        if: ty = 11 && c.fprintf(l2_out, "%s@: int ", sep) < 0
            return: 1
        if: ty = 12 && c.fprintf(l2_out, "%s@: char ", sep) < 0
            return: 1
        if: ty = 16 && c.fprintf(l2_out, "%s@: void ", sep) < 0
            return: 1
        if: ty = 17 && c.fprintf(l2_out, "%s@@: char ", sep) < 0
            return: 1
        if: ty = 18 && c.fprintf(l2_out, "%s@@: void ", sep) < 0
            return: 1
        if: ty = 19 && c.fprintf(l2_out, "%s@@: int ", sep) < 0
            return: 1
        if: ty = 20 && c.fprintf(l2_out, "%s@@: size_t ", sep) < 0
            return: 1
        if: ty = 24 && c.fprintf(l2_out, "%s@@: unsigned ", sep) < 0
            return: 1
        if: ty = 39 && c.fprintf(l2_out, "%s@@: ulong ", sep) < 0
            return: 1
        if: ty = 25 && c.fprintf(l2_out, "%s@: unsigned ", sep) < 0
            return: 1
        if: ty = 38 && c.fprintf(l2_out, "%s@: ulong ", sep) < 0
            return: 1
        if: ty = 26 && c.fprintf(l2_out, "%s@@: LmxMsgBlock ", sep) < 0
            return: 1
        if: ty = 27 && c.fprintf(l2_out, "%s@@: LmxOwnedRange ", sep) < 0
            return: 1
        if: ty = 28 && c.fprintf(l2_out, "%sconst: @(LmxMsgRuntime ", sep) < 0
            return: 1
        if: ty = 29 && c.fprintf(l2_out, "%sconst: @(LmxMsg ", sep) < 0
            return: 1
        if: ty = 30 && c.fprintf(l2_out, "%sconst: @(LmxMsgCopy ", sep) < 0
            return: 1
        if: ty = 31 && c.fprintf(l2_out, "%s@@: LmxMsgCopy ", sep) < 0
            return: 1
        if: ty = 4 && c.fprintf(l2_out, "%sconst: @(LmP0Text ", sep) < 0
            return: 1
        if: ty = 6 && c.fprintf(l2_out, "%sconst: @(L2ImmutQuery ", sep) < 0
            return: 1
        if: ty = 7 && c.fprintf(l2_out, "%s@: L2ImmutQuery ", sep) < 0
            return: 1
        if: ty = 10 && c.fprintf(l2_out, "%sLmP0TrailerRole: ", sep) < 0
            return: 1
        if: ty = 13 && c.fprintf(l2_out, "%s@: LmP0Document ", sep) < 0
            return: 1
        if: ty = 14 && c.fprintf(l2_out, "%s@: LmP0IndentStack ", sep) < 0
            return: 1
        if: ty = 15 && c.fprintf(l2_out, "%sconst: @(LmP0IndentStack ", sep) < 0
            return: 1
        if: ty >= 100
            if: l2_emit_foreign_named(l2_out, ty, sep, l2_fn(mi, j)) != 0
                return: 1
            ---
        else:
            if: ty != 0 && ty != 1 && ty != 2 && ty != 3 && ty != 4 && ty != 5 && ty != 6 && ty != 7 && ty != 9 && ty != 10 && ty != 11 && ty != 12 && ty != 13 && ty != 14 && ty != 15 && ty != 16 && ty != 17 && ty != 18 && ty != 19 && ty != 20 && ty != 24 && ty != 25 && ty != 26 && ty != 27 && ty != 28 && ty != 29 && ty != 30 && ty != 31 && ty != 34 && ty != 36 && ty != 38 && ty != 39
                c.fprintf(c.stderr, "l2trans: a library signature cannot spell formal type %d\n", ty)
                return: 1
            if: l2_write_text(l2_out, l2_fn(mi, j)) != 0
                return: 1
            if: (ty = 3 || ty = 4 || ty = 6 || ty = 15 || ty = 28 || ty = 29 || ty = 30) && c.fputs(")", l2_out) < 0
                return: 1
        ---
        j: j + 1
    ---
    if: l2_m_ret[mi] = 2 && c.fputs(") size_t", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 30 && c.fputs(") LmxMsgAddr", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 33 && c.fputs(") unsigned", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 36 && c.fputs(") ulong", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 3 && c.fputs(") @: char", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 16 && c.fputs(") @: void", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 35 && c.fputs(") const: @(char)", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 32 && c.fputs(") @@: char", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] >= 100 && l2_emit_foreign_return(l2_out, l2_m_ret[mi]) != 0
        return: 1
    if: l2_m_ret[mi] = 5 && c.fputs(") @: LmP0Text", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 8 && c.fputs(")", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 10 && c.fputs(") LmP0TrailerRole", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 13 && c.fputs(") @: LmP0IndentStack", l2_out) < 0
        return: 1
    if: l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 3 && l2_m_ret[mi] != 5 && l2_m_ret[mi] != 8 && l2_m_ret[mi] != 10 && l2_m_ret[mi] != 13 && l2_m_ret[mi] != 16 && l2_m_ret[mi] != 32 && l2_m_ret[mi] != 35 && l2_m_ret[mi] < 100 && c.fputs(") int", l2_out) < 0
        return: 1
return: 0

fn: l2_emit_library_wrappers () int
    int: i 0
    int: j
    if: c.fputs("\n@: LmxMsgRuntime l2_library_runtime 0\n@: LmxMsg l2_library_message 0\n@: Lmx l2_library_unit 0\n\nfn: l2_library_open () int\n    unsigned: process_addr 0U\n    if: l2_library_runtime != 0\n        return: 0\n    l2_library_runtime: c.lmx_msg_runtime_new()\n    if: l2_library_runtime = 0\n        return: 1\n    if: c.lmx_msg_create(l2_library_runtime, 0U, 1U, 0, 0U, @ process_addr) != c.LMX_MSG_OK\n        c.lmx_msg_runtime_delete(l2_library_runtime)\n        l2_library_runtime: 0\n        return: 1\n    l2_library_message: c.lmx_msg_find(l2_library_runtime, process_addr)\n    if: l2_library_message = 0 || l2_program_entry(l2_library_message) != 0\n        c.lmx_msg_runtime_delete(l2_library_runtime)\n        l2_library_runtime: 0\n        l2_library_message: 0\n        return: 1\n    l2_library_unit: c.lmx_msg_graph(l2_library_message)\n    if: l2_library_unit = 0\n        c.lmx_msg_runtime_delete(l2_library_runtime)\n        l2_library_runtime: 0\n        l2_library_message: 0\n        return: 1\n    return: 0\n\n", l2_out) < 0
        return: 1
    while: i < l2_m_n
        if: c.fputs("external:\n", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 8 && c.fputs("    sub: ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] != 8 && c.fputs("    fn: ", l2_out) < 0
            return: 1
        if: l2_write_text(l2_out, l2_m_name[i]) != 0 || l2_emit_public_sig(i) != 0 || c.fputs("\n", l2_out) < 0
            return: 1
        if: c.fputs("        if: l2_library_open() != 0\n", l2_out) < 0
            return: 1
        # A failed open is reported on every call and then follows the abort
        # policy, exactly as a failed checkpoint publication does; it is never
        # a silent zero.
        if: c.fprintf(l2_out, "            c.fprintf(c.stderr, \"lmx: library open failed: l2_u%08X%08X ", l2_module_hash_a, l2_module_hash_b) < 0 || l2_write_text(l2_out, l2_m_name[i]) != 0
            return: 1
        if: c.fputs("\\n\")\n            if: c.lmx_msg_poll_abort() != 0\n                c.abort()\n", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 8 && c.fputs("            return\n        ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 2 && c.fputs("            return: 0U\n        return: ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] != 2 && l2_m_ret[i] != 8 && c.fputs("            return: 0\n        return: ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 8 && c.fputs("", l2_out) < 0
            return: 1
        if: l2_write_sym(l2_out, i) != 0 || c.fprintf(l2_out, "(lmx_branch_struct_known(l2_library_unit, %uU)", (cast: (unsigned) (l2_unit_base + i))) < 0
            return: 1
        j: 0
        while: j < l2_m_arity[i]
            if: c.fputs(", ", l2_out) < 0 || l2_write_text(l2_out, l2_fn(i, j)) != 0
                return: 1
            j: j + 1
        if: c.fputs(")\n", l2_out) < 0
            return: 1
        if: c.fputs("end: external\n\n", l2_out) < 0
            return: 1
        i: i + 1
return: 0

fn: l2_has_own_ty (int: ty) int
    int: i 0
    while: i < l2_own_n
        if: l2_own_ty[i] = ty
            return: 1
        i: i + 1
return: 0

fn: l2_has_pointer_array () int
    int: i 0
    while: i < l2_own_n
        if: l2_own_ty[i] >= 2000
            return: 1
        i: i + 1
return: 0

fn: l2_emit_poll (int: mi; const: @(char ind)) int
    if: ind = 0
        return: 0
    if: mi >= 0 && l2_m_ret[mi] = 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sif: c.lmx_msg_poll_escape() != 0\n%s    return\n", ind, ind) < 0
        return: 1
    if: mi >= 0 && l2_m_ret[mi] = 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sif: c.lmx_msg_poll_escape() != 0\n%s    return: 0\n", ind, ind) < 0
        return: 1
    if: (mi < 0 || l2_m_ret[mi] != 8) && c.fprintf(l2_out, "%sif: c.lmx_msg_poll_escape() != 0\n%s    return: 0\n", ind, ind) < 0
        return: 1
return: 0

fn: l2_emit_checkpoint (int: mi; const: @(char ind)) int
    int: i 0
    int: fi
    if: mi < 0 || ind = 0
        return: 0
    while: i < l2_own_n
        if: l2_own_is_array(l2_own_ty[i]) != 0
            i: i + 1
            continue
        fi: l2_m_alias[l2_own_off(mi, i)]
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && c.fprintf(l2_out, "%sif: l2_q%d_dirty != 0\n", ind, i) < 0
            return: 1
        # SPEC 21.6 / ABI 14.23, confirmed 2026-09-12: a failure to publish an
        # already-bound dirty own field is checkpoint failure and takes the
        # diagnostic route, never a silent success or a plain return. Entry
        # admission of a missing field is a separate case, not handled here.
        #
        # The route is the existing turn diagnostic root: lmx_msg_poll_abort
        # escapes to it when one is installed, which fails this Message's turn
        # under the executor's ordinary handling and leaves the host and other
        # Messages running (SPEC 19.13). It returns nonzero only when no such
        # root exists, and then the process has no Message boundary to honour
        # and abort is the last resort. A standalone generated program calls
        # its entry directly and therefore has no root; see FABLE_GRAPH_ABI.txt.
        #
        # A failed store leaves ITS OWN field as it was: the char path checks
        # the rebind before assigning the slot, and the int/size_t helpers do
        # not write on a rejected cell. Fields published earlier in this same
        # checkpoint keep their new values; no rollback is claimed or required.
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && c.fprintf(l2_out, "%s    if: l2_q%d_from = 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint lost own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, ind, i, ind, ind) < 0
            return: 1
        # Each diagnostic block above ends two source levels deeper than the
        # next statement, so it needs an explicit tail cutter (L1 closes at
        # most one level without one).
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && c.fprintf(l2_out, "%s    ---\n", ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 1 && fi < 0 && c.fprintf(l2_out, "%s    if: lmx_char_rebind_known(l2_q%d_from[0], (cast: (int) (cast: (uchar) l2_q%d))) = 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n%s    ---\n%s    l2_q%d_from[0]: lmx_char_rebind_known(l2_q%d_from[0], (cast: (int) (cast: (uchar) l2_q%d)))\n", ind, i, i, ind, i, ind, ind, ind, ind, i, i, i) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 1 && fi >= 0 && c.fprintf(l2_out, "%s    if: lmx_char_rebind_known(l2_q%d_from[0], (cast: (int) (cast: (uchar) l2_p%d_%d))) = 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n%s    ---\n%s    l2_q%d_from[0]: lmx_char_rebind_known(l2_q%d_from[0], (cast: (int) (cast: (uchar) l2_p%d_%d)))\n", ind, i, mi, fi, ind, i, ind, ind, ind, ind, i, i, mi, fi) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 2 && fi < 0 && c.fprintf(l2_out, "%s    if: lmx_size_store_known(l2_q%d_from[0], l2_q%d) != 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, i, ind, i, ind, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 2 && fi >= 0 && c.fprintf(l2_out, "%s    if: lmx_size_store_known(l2_q%d_from[0], l2_p%d_%d) != 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, mi, fi, ind, i, ind, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 0 && fi < 0 && c.fprintf(l2_out, "%s    if: lmx_int_store_known(l2_q%d_from[0], l2_q%d) != 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, i, ind, i, ind, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 0 && fi >= 0 && c.fprintf(l2_out, "%s    if: lmx_int_store_known(l2_q%d_from[0], l2_p%d_%d) != 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, mi, fi, ind, i, ind, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 3 && fi < 0 && c.fprintf(l2_out, "%s    if: lmx_unsigned_store_known(l2_q%d_from[0], l2_q%d) != 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, i, ind, i, ind, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 36 && fi < 0 && c.fprintf(l2_out, "%s    if: lmx_ulong_store_known(l2_q%d_from[0], l2_q%d) != 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, i, ind, i, ind, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 3 && fi >= 0 && c.fprintf(l2_out, "%s    if: lmx_unsigned_store_known(l2_q%d_from[0], l2_p%d_%d) != 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, mi, fi, ind, i, ind, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 36 && fi >= 0 && c.fprintf(l2_out, "%s    if: lmx_ulong_store_known(l2_q%d_from[0], l2_p%d_%d) != 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, mi, fi, ind, i, ind, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_is_pointer(l2_own_ty[i]) != 0 && fi < 0 && c.fprintf(l2_out, "%s    if: lmx_pointer_store_known(l2_q%d_from[0], (cast: (@: void) l2_q%d)) != 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, i, ind, i, ind, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_is_pointer(l2_own_ty[i]) != 0 && fi >= 0 && c.fprintf(l2_out, "%s    if: lmx_pointer_store_known(l2_q%d_from[0], (cast: (@: void) l2_p%d_%d)) != 0\n%s        c.fprintf(c.stderr, \"lmx: checkpoint store failed for own field %d\\n\")\n%s        if: c.lmx_msg_poll_abort() != 0\n%s            c.abort()\n", ind, i, mi, fi, ind, i, ind, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] != 1 && c.fprintf(l2_out, "%s    ---\n", ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && c.fprintf(l2_out, "%s    l2_q%d_dirty: 0\n", ind, i) < 0
            return: 1
        i: i + 1
return: 0

fn: l2_emit_path_load (int: mi; int: oi; const: @(char ind); @: char dest) int
    int: t
    int: fid
    @: char deep 0
    if: dest = 0 || oi < 0 || ind = 0
        return: 1
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    fid: l2_own_fid[oi]
    if: fid >= 0 && c.fprintf(l2_out, "%sl2_xp: lmx_branch_slot_known(l2_h%d, %uU)\n", ind, fid, (cast: (unsigned) l2_own_fchild[oi])) < 0
        return: 1
    if: fid < 0 && l2_own_uchild[oi] < 0
        return: 1
    if: fid < 0 && c.fprintf(l2_out, "%sl2_xp: lmx_branch_slot_known(%s, %uU)\n", ind, l2_own_ctr(oi), (cast: (unsigned) l2_own_uchild[oi])) < 0
        return: 1
    if: c.fprintf(l2_out, "%sif: l2_xp = 0\n", ind) < 0
        return: 1
    if: l2_emit_checkpoint(mi, deep) != 0
        return: 1
    if: mi >= 0 && l2_m_ret[mi] = 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn\n", deep) < 0
        return: 1
    if: mi >= 0 && l2_m_ret[mi] = 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sreturn: 0\n", deep) < 0
        return: 1
    if: mi >= 0 && l2_ret_uns(mi) != 0 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn: 0U\n", deep) < 0
        return: 1
    if: mi >= 0 && l2_ret_uns(mi) != 0 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: 0U\n%sreturn: 0\n", deep, deep) < 0
        return: 1
    if: (mi < 0 || (l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0))) && c.fprintf(l2_out, "%sreturn: 0\n", deep) < 0
        return: 1
    if: mi >= 0 && l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: 0\n%sreturn: 0\n", deep, deep) < 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_own_ty[oi] = 0 && c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: lmx_int_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 1 && c.fprintf(l2_out, "%schar: l2_t%d\n%sl2_t%d: (cast: (char) lmx_char_value_known(l2_xp[0]))\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: lmx_size_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 3 && c.fprintf(l2_out, "%sunsigned: l2_t%d\n%sl2_t%d: lmx_unsigned_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 36 && c.fprintf(l2_out, "%sulong: l2_t%d\n%sl2_t%d: lmx_ulong_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_is_pointer(l2_own_ty[oi]) != 0
        if: c.fputs(ind, l2_out) < 0 || l2_emit_own_pointer_type(l2_out, l2_own_ty[oi]) != 0 || c.fprintf(l2_out, " l2_t%d\n%sl2_t%d: (cast: (", t, ind, t) < 0 || l2_emit_own_pointer_type(l2_out, l2_own_ty[oi]) != 0 || c.fputs(") lmx_pointer_value_known(l2_xp[0]))\n", l2_out) < 0
            return: 1
    ---
    if: c.sprintf(dest, "l2_t%d", t) < 0
        return: 1
return: 0

fn: l2_index_tail (@: LmP0Field f; @@: LmP0Field out_idx; @@: LmP0Field out_after) int
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Field p3
    if: out_idx = 0 || out_after = 0
        return: 1
    \out_idx: 0
    \out_after: 0
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 1
    if: l2_ident(f\value\as\atom) = 0
        return: 1
    p1: l2_next_active(f\next)
    if: p1 = 0 || p1\value = 0 || p1\value\kind != c.LM_P0_NODE_ATOM || p1\value\as = 0
        return: 1
    if: l2_text_eq(p1\value\as\atom, "[") = 0
        return: 1
    p2: l2_next_active(p1\next)
    if: p2 = 0 || p2\value = 0
        return: 1
    p3: l2_next_active(p2\next)
    if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || p3\value\as = 0
        return: 1
    if: l2_text_eq(p3\value\as\atom, "]") = 0
        return: 1
    \out_idx: p2
    \out_after: l2_next_active(p3\next)
return: 0

fn: l2_addr_tail (@: LmP0Field f; int: mi; @@: LmP0Field out_name; @@: LmP0Field out_after) int
    @: LmP0Field p1
    @: LmP0Field p2
    if: out_name = 0 || out_after = 0
        return: 1
    \out_name: 0
    \out_after: 0
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 1
    if: l2_text_eq(f\value\as\atom, "@") = 0
        return: 1
    p1: l2_next_active(f\next)
    if: p1 = 0 || p1\value = 0 || p1\value\kind != c.LM_P0_NODE_ATOM || p1\value\as = 0
        return: 1
    if: l2_ident(p1\value\as\atom) = 0
        return: 1
    # In `@ value\field`, address-taking covers the complete postfix path.
    # Do not consume only `@ value` and strand the following separator.
    p2: l2_next_active(p1\next)
    if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p2\value\as\atom)
        return: 1
    if: mi >= 0 && l2_ml_find(p1\value\as\atom) < 0 && l2_loc_find(p1\value\as\atom) < 0 && l2_entry_find(p1\value\as\atom) < 0
        return: 1
    if: mi < 0 && l2_loc_find(p1\value\as\atom) < 0 && l2_entry_find(p1\value\as\atom) < 0
        return: 1
    \out_name: p1
    \out_after: p2
return: 0

fn: l2_ccall_box_int (const: @(LmP0Node node); int: mi) int
    int: ei
    int: fi
    int: oi
    int: si
    int: ty
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0
        return: 0
    if: l2_quoted(node\as\atom) != 0
        return: 0
    if: l2_num(node\as\atom)
        return: 0
    if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
        return: 0
    ei: l2_entry_find(node\as\atom)
    if: ei >= 0 && l2_entry_ty != 0
        ty: l2_entry_ty[ei]
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    ei: l2_loc_find(node\as\atom)
    if: ei >= 0 && l2_loc_ty != 0
        ty: l2_loc_ty[ei]
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    if: mi >= 0
        ei: l2_ml_find(node\as\atom)
        if: ei >= 0
            ty: l2_ml_ty[ei]
            if: ty = 0 || ty = 1
                return: 1
            return: 0
        ---
        fi: l2_param_find(mi, node\as\atom)
        if: fi >= 0
            ty: l2_param_ty(mi, node\as\atom)
            if: ty = 0 || ty = 1
                return: 1
            return: 0
        oi: l2_own_find(mi, node\as\atom)
        if: oi >= 0
            ty: l2_own_ty[oi]
            if: ty = 0 || ty = 1
                return: 1
            return: 0
        si: l2_slot_find(mi, node\as\atom)
        if: si >= 0
            ty: l2_st[l2_slot_off(mi, si)]
            if: ty = 0 || ty = 1
                return: 1
            return: 0
        ---
    ---
return: 1

fn: l2_emit_ccall (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    int: array_own
    size_t: array_index
    int: array_count
    @: LmP0Field f
    @: LmP0Field p1
    @: LmP0Field p2
    int: n
    int: i
    int: span
    int: si
    int: po
    int: hj
    int: hf
    size_t: root_len
    size_t: suffix_len
    int: first 1
    c.array: [256]: char buf
    c.array: [256]: char piece
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 1
    buf[0]: 0
    hj: -1
    hf: -1
    if: mi >= 0 && l2_raw_head(stmt\as\frame\head, mi, @ hj, @ hf) = 0 && hf = 5 && hj < l2_m_arity[mi]
        if: c.sprintf(buf, "l2_p%d_%d", mi, hj) < 0
            return: 1
        root_len: l2_fn(mi, hj)\length
        if: root_len >= stmt\as\frame\head\length
            return: 1
        suffix_len: stmt\as\frame\head\length - root_len
        if: suffix_len >= 256U
            return: 1
        c.memcpy(piece, stmt\as\frame\head\data + root_len, suffix_len)
        piece[suffix_len]: 0
        if: l2_cat(buf, piece) != 0
            return: 1
        ---
    if: mi >= 0 && hj >= l2_m_arity[mi] && hf = 5 && hj < l2_m_arity[mi] + l2_m_sn[mi]
        if: c.sprintf(buf, "l2_s%d_%d", mi, hj - l2_m_arity[mi]) < 0
            return: 1
        root_len: l2_sn[l2_slot_off(mi, hj - l2_m_arity[mi])]\length
        if: root_len >= stmt\as\frame\head\length
            return: 1
        suffix_len: stmt\as\frame\head\length - root_len
        if: suffix_len >= 256U
            return: 1
        c.memcpy(piece, stmt\as\frame\head\data + root_len, suffix_len)
        piece[suffix_len]: 0
        if: l2_cat(buf, piece) != 0
            return: 1
        ---
    if: mi < 0 || hj < 0 || hf != 5 || hj >= l2_m_arity[mi] + l2_m_sn[mi]
        if: l2_tok_text(stmt\as\frame\head, buf, 256U) != 0
            return: 1
        ---
    if: l2_cat(buf, "(") != 0
        return: 1
    n: l2_count_active(stmt\as\frame\body)
    f: l2_next_active(stmt\as\frame\body\first_field)
    i: 0
    while: i < n && f != 0 && f\value != 0
        if: l2_own_index_tail(f, mi, @ array_own, @ array_index, @ p2, @ array_count) = 0
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_emit_array_load(array_own, array_index, ind, piece) != 0 || l2_cat(buf, piece) != 0
                return: 1
            first: 0
            i: i + array_count
            f: p2
            continue
        piece[0]: 0
        p1: 0
        p2: 0
        po: -1
        if: f\value\kind = c.LM_P0_NODE_ATOM
            p1: l2_next_active(f\next)
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM
            po: l2_path_own(mi, f\value\as\atom, p2\value\as\atom)
        if: po >= 0
            if: l2_emit_path_load(mi, po, ind, piece) != 0
                return: 1
            i: i + 2
            f: p2
        if: po < 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_loc_find(f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
            if: p2 = 0 || p2\value = 0 || p2\value\kind != c.LM_P0_NODE_ATOM || l2_diag_field(p2\value\as\atom) = 0
                return: 1
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_prep(f\value, mi, ind, piece) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            if: l2_cat(buf, "\\") != 0
                return: 1
            piece[0]: 0
            if: l2_tok_text(p2\value\as\atom, piece, 256U) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            first: 0
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        ---
        if: po < 0 && l2_index_tail(f, @ p1, @ p2) = 0
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_prep(f\value, mi, ind, piece) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            if: l2_cat(buf, "[") != 0
                return: 1
            piece[0]: 0
            if: l2_prep(p1\value, mi, ind, piece) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            if: l2_cat(buf, "]") != 0
                return: 1
            first: 0
            i: i + 4
            f: p2
            continue
        ---
        if: po < 0 && l2_addr_tail(f, mi, @ p1, @ p2) = 0
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_cat(buf, "@ ") != 0
                return: 1
            piece[0]: 0
            if: l2_prep(p1\value, mi, ind, piece) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            first: 0
            i: i + 2
            f: p2
            continue
        ---
        span: l2_expr_span(f)
        if: po < 0 && span > 1
            piece[0]: 0
            if: l2_emit_fields(f, span, mi, ind, piece) != 0
                return: 1
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            first: 0
            si: 0
            while: si < span && f != 0
                f: l2_next_active(f\next)
                si: si + 1
            ---
            i: i + span
            continue
        ---
        if: po < 0 && l2_prep(f\value, mi, ind, piece) != 0
            return: 1
        if: po < 0 && l2_ccall_box_int(f\value, mi) != 0 && l2_new_temp(ind, l2_tok) != 0
            return: 1
        if: po < 0 && l2_ccall_box_int(f\value, mi) != 0 && c.fprintf(l2_out, "%s%s: %s\n", ind, l2_tok, piece) < 0
            return: 1
        if: po < 0 && l2_ccall_box_int(f\value, mi) != 0
            c.memcpy(piece, l2_tok, 256U)
        if: first = 0 && l2_cat(buf, ", ") != 0
            return: 1
        if: l2_cat(buf, piece) != 0
            return: 1
        first: 0
        i: i + 1
        f: l2_next_active(f\next)
    if: l2_cat(buf, ")") != 0
        return: 1
    if: l2_emit_checkpoint(mi, ind) != 0
        return: 1
    if: l2_ccall_into != 0
        c.memcpy(l2_ccall_into, buf, 256U)
        l2_ccall_into: 0
        return: 0
    ---
    if: c.fprintf(l2_out, "%s%s\n", ind, buf) < 0
        return: 1
return: 0

# Step one actual forward: span fields from here.
fn: l2_skip_span (@: LmP0Field a; int: span) @: LmP0Field
    int: i 0
    while: i < span && a != 0
        a: l2_next_active(a\next)
        i: i + 1
    ---
return: a

# The call through a function-pointer local: head(actual, actual). Each actual
# may itself be a field read, so the actuals are walked by span rather than by
# field.
fn: l2_emit_fnptr_call (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    const: @: LmP0Frame fr
    @: LmP0Field a
    int: span
    int: first 1
    c.array: [256]: char buf
    c.array: [256]: char piece
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0
        return: 1
    fr: stmt\as\frame
    buf[0]: 0
    if: fr\body != 0
        a: l2_next_active(fr\body\first_field)
        while: a != 0
            span: l2_expr_span(a)
            if: span < 1
                return: 1
            piece[0]: 0
            if: l2_emit_fields(a, span, mi, ind, piece) != 0
                return: 1
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            first: 0
            a: l2_skip_span(a, span)
        ---
    ---
    if: l2_emit_checkpoint(mi, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%s", ind) < 0
        return: 1
    if: l2_write_text(l2_out, fr\head) != 0
        return: 1
    if: c.fprintf(l2_out, "(%s)\n", buf) < 0
        return: 1
return: 0

fn: l2_emit_loc_stmt (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    @: LmP0Text lnm 0
    @: LmP0Text lsz 0
    int: lty 0
    @: LmP0Field initf
    @: LmP0Field last
    const: @: LmP0Frame fr
    int: ei
    size_t: nl
    if: stmt = 0
        return: 1
    if: mi >= 0 && l2_array_local(stmt, @ lnm, @ lsz) != 0 && (l2_ptr_local_ty(stmt, @ lnm, @ lty) != 0 || l2_ml_find(lnm) < 0) && (l2_const_local_ty(stmt, @ lnm, @ lty) != 0 || l2_ml_find(lnm) < 0) && (l2_fnptr_local(stmt, @ lnm) != 0 || l2_ml_find(lnm) < 0) && (l2_struct_local(stmt, @ lnm) != 0 || l2_ml_find(lnm) < 0) && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || l2_ml_find(stmt\as\frame\head) < 0) && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || l2_ml_array_head(stmt\as\frame\head) < 0)
        return: 1
    if: l2_array_local(stmt, @ lnm, @ lsz) = 0
        if: mi >= 0 && (l2_ml_find(lnm) < 0 || l2_ml_ty[l2_ml_find(lnm)] != 22)
            return: 2
        if: c.fprintf(l2_out, "%sc.array: []: char ", ind) < 0
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: c.fputs(" ", l2_out) < 0
            return: 2
        if: l2_write_text(l2_out, lsz) != 0
            return: 2
        if: c.fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
        ei: 0
        while: mi < 0 && ei < l2_loc_n && l2_loc_nm != 0 && l2_loc_ty != 0
            lnm: l2_loc_nm[ei]
            nl: 0U
            if: lnm != 0
                nl: lnm\length
            ---
            if: l2_loc_ty[ei] = 22 && lnm != 0 && stmt\as\frame\head\length > nl && stmt\as\frame\head\data[nl] = 91 && c.memcmp(lnm\data, stmt\as\frame\head\data, nl) = 0
                if: c.fprintf(l2_out, "%s", ind) < 0
                    return: 2
                if: l2_write_text(l2_out, stmt\as\frame\head) != 0
                    return: 2
                if: stmt\as\frame\body = 0 || l2_eval_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, ind, l2_tok) != 0
                    return: 2
                if: c.fprintf(l2_out, ": %s\n", l2_tok) < 0
                    return: 2
                return: 0
            ---
            ei: ei + 1
        ---
        if: mi >= 0 && l2_ml_array_head(stmt\as\frame\head) >= 0
            if: c.fprintf(l2_out, "%s", ind) < 0
                return: 2
            if: l2_write_text(l2_out, stmt\as\frame\head) != 0
                return: 2
            if: stmt\as\frame\body = 0 || l2_eval_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, ind, l2_tok) != 0
                return: 2
            if: c.fprintf(l2_out, ": %s\n", l2_tok) < 0
                return: 2
            return: 0
        ---
    ---
    if: l2_frame_head(stmt, "immutable")
        if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
            return: 2
        if: c.fprintf(l2_out, "%simmutable:\n", ind) < 0
            return: 2
        initf: l2_next_active(stmt\as\frame\body\first_field)
        while: initf != 0
            if: l2_ptr_local_ty(initf\value, @ lnm, @ lty) != 0
                return: 2
            if: c.fprintf(l2_out, "%s    @: char ", ind) < 0
                return: 2
            if: l2_write_text(l2_out, lnm) != 0
                return: 2
            last: l2_next_active(initf\value\as\frame\body\first_field)
            last: l2_next_active(last\next)
            last: l2_next_active(last\next)
            if: last = 0 || last\value = 0 || l2_prep(last\value, mi, ind, l2_tok) != 0
                return: 2
            if: c.fprintf(l2_out, " %s\n", l2_tok) < 0
                return: 2
            initf: l2_next_active(initf\next)
        return: 0
    if: l2_const_local_ty(stmt, @ lnm, @ lty) = 0
        if: lty >= 100
            if: l2_emit_foreign_named(l2_out, lty, ind, lnm) != 0 || c.fputs("\n", l2_out) < 0
                return: 2
            return: 0
        ---
        if: lty = 3 && c.fprintf(l2_out, "%sconst: @(char ", ind) < 0
            return: 2
        if: lty = 21 && c.fprintf(l2_out, "%sconst: @(LmP0Diagnostic ", ind) < 0
            return: 2
        if: lty = 29 && c.fprintf(l2_out, "%sconst: @(LmxMsg ", ind) < 0
            return: 2
        if: lty != 3 && lty != 21 && lty != 29
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: c.fputs(")\n", l2_out) < 0
            return: 2
        return: 0
    # A call through a function-pointer local, before the assignment path: the
    # head names what is CALLED, not what is assigned to.
    if: mi >= 0 && stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0 && l2_ml_find(stmt\as\frame\head) >= 0 && l2_ml_ty[l2_ml_find(stmt\as\frame\head)] = 40 && (stmt\as\frame\flags & c.LM_P0_FRAME_COMPACT) != 0U
        if: l2_emit_fnptr_call(stmt, mi, ind) != 0
            return: 2
        return: 0
    # A function-pointer local: the header names the type, so the emitted
    # declaration spells it exactly as the header does.
    if: l2_fnptr_local(stmt, @ lnm) = 0
        if: c.fprintf(l2_out, "%s", ind) < 0
            return: 2
        if: l2_write_text(l2_out, stmt\as\frame\head) != 0
            return: 2
        if: c.fputs(": ", l2_out) < 0
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && l2_emit_fields(l2_next_active(stmt\as\frame\body\first_field)\next, l2_count_active(stmt\as\frame\body) - 1, mi, ind, l2_tok) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && c.fprintf(l2_out, " %s", l2_tok) < 0
            return: 2
        if: c.fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: l2_struct_local(stmt, @ lnm) = 0
        if: c.fprintf(l2_out, "%s", ind) < 0
            return: 2
        if: l2_write_text(l2_out, stmt\as\frame\head) != 0
            return: 2
        if: c.fputs(": ", l2_out) < 0
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && l2_emit_fields(l2_next_active(stmt\as\frame\body\first_field)\next, l2_count_active(stmt\as\frame\body) - 1, mi, ind, l2_tok) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && c.fprintf(l2_out, " %s", l2_tok) < 0
            return: 2
        if: c.fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: l2_ptr_local_ty(stmt, @ lnm, @ lty) = 0
        if: lty >= 100
            if: l2_emit_foreign_named(l2_out, lty, ind, lnm) != 0
                return: 2
            if: l2_count_active(stmt\as\frame\body) = 3
                initf: l2_next_active(stmt\as\frame\body\first_field)
                initf: l2_next_active(initf\next)
                initf: l2_next_active(initf\next)
                if: initf = 0 || l2_prep(initf\value, mi, ind, l2_tok) != 0 || c.fprintf(l2_out, " %s", l2_tok) < 0
                    return: 2
            ---
            if: c.fputs("\n", l2_out) < 0
                return: 2
            return: 0
        ---
        if: lty = 12 && c.fprintf(l2_out, "%s@: char ", ind) < 0
            return: 2
        if: lty = 9 && c.fprintf(l2_out, "%s@: size_t ", ind) < 0
            return: 2
        if: lty = 11 && c.fprintf(l2_out, "%s@: int ", ind) < 0
            return: 2
        if: lty = 13 && c.fprintf(l2_out, "%s@: LmP0Document ", ind) < 0
            return: 2
        if: lty = 16 && c.fprintf(l2_out, "%s@: void ", ind) < 0
            return: 2
        if: lty = 23 && c.fprintf(l2_out, "%s@: FILE ", ind) < 0
            return: 1
        if: lty = 25 && c.fprintf(l2_out, "%s@: unsigned ", ind) < 0
            return: 1
        if: lty = 38 && c.fprintf(l2_out, "%s@: ulong ", ind) < 0
            return: 1
        if: lty = 17 && c.fprintf(l2_out, "%s@@: char ", ind) < 0
            return: 2
        if: lty = 18 && c.fprintf(l2_out, "%s@@: void ", ind) < 0
            return: 2
        if: lty = 19 && c.fprintf(l2_out, "%s@@: int ", ind) < 0
            return: 2
        if: lty = 20 && c.fprintf(l2_out, "%s@@: size_t ", ind) < 0
            return: 2
        if: lty = 24 && c.fprintf(l2_out, "%s@@: unsigned ", ind) < 0
            return: 2
        if: lty = 39 && c.fprintf(l2_out, "%s@@: ulong ", ind) < 0
            return: 2
        if: lty != 9 && lty != 11 && lty != 12 && lty != 13 && lty != 16 && lty != 17 && lty != 18 && lty != 19 && lty != 20 && lty != 23 && lty != 24 && lty != 25 && lty != 38 && lty != 39
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) = 3
            initf: l2_next_active(stmt\as\frame\body\first_field)
            initf: l2_next_active(initf\next)
            initf: l2_next_active(initf\next)
            if: initf = 0 || l2_prep(initf\value, mi, ind, l2_tok) != 0
                return: 2
            if: c.fprintf(l2_out, " %s", l2_tok) < 0
                return: 2
        ---
        if: c.fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: l2_own_decl_ty(stmt) != 0
        lnm: l2_next_active(stmt\as\frame\body\first_field)\value\as\atom
        lty: l2_own_store_ty(l2_own_decl_ty(stmt))
        if: lty = 0 && c.fprintf(l2_out, "%sint: ", ind) < 0
            return: 2
        if: lty = 1 && c.fprintf(l2_out, "%schar: ", ind) < 0
            return: 2
        if: lty = 2 && c.fprintf(l2_out, "%ssize_t: ", ind) < 0
            return: 2
        if: lty != 0 && lty != 1 && lty != 2
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) = 2
            initf: l2_next_active(stmt\as\frame\body\first_field)
            initf: l2_next_active(initf\next)
            if: initf = 0 || l2_prep(initf\value, mi, ind, l2_tok) != 0
                return: 2
            if: c.fprintf(l2_out, " %s", l2_tok) < 0
                return: 2
        ---
        if: c.fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0
        return: 1
    fr: stmt\as\frame
    if: mi < 0 && l2_loc_find(fr\head) < 0
        return: 1
    if: mi >= 0 && l2_ml_find(fr\head) < 0
        return: 1
    if: fr\body = 0
        return: 2
    initf: l2_next_active(fr\body\first_field)
    if: l2_count_active(fr\body) = 1 && initf != 0 && initf\value != 0 && initf\value\kind = c.LM_P0_NODE_FRAME && initf\value\as != 0 && initf\value\as\frame != 0 && l2_is_known(initf\value\as\frame\head)
        l2_ccall_into: l2_tok
        if: l2_emit_ccall(initf\value, mi, ind) != 0
            l2_ccall_into: 0
            return: 2
        ---
    if: l2_count_active(fr\body) != 1 || initf = 0 || initf\value = 0 || initf\value\kind != c.LM_P0_NODE_FRAME || l2_is_known(initf\value\as\frame\head) = 0
        if: l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 2
        ---
    ---
    if: c.fprintf(l2_out, "%s", ind) < 0
        return: 2
    if: l2_write_text(l2_out, fr\head) != 0
        return: 2
    if: c.fprintf(l2_out, ": %s\n", l2_tok) < 0
        return: 2
return: 0

    # Widest merge in a body, found before the entry preamble is written, because
# the operand array is a local of that preamble. Recurses through the frames
# that carry nested bodies.
# The settled form is an outer result-name frame whose single body element is a
# merge frame: R: merge: A B. The statement head is R, not merge. This pass
# finds them before the entry preamble is written, because the operand array and
# the result slots are fixed there.
# Printed tree of R: merge: A with a result body, from printTree:
#
#   frame head="R" body=structure fields=2
#     frame head="merge" body=structure fields=1
#       atom "A"
#     structure fields=1
#       frame head="size_t" ...
#
# The result body is a SIBLING of the merge frame inside R, not a child of it.
# Without a body, R holds the merge frame alone.
fn: l2_merge_frame (const: @(LmP0Node stmt)) @: LmP0Node
    @: LmP0Field f
    int: n
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    if: stmt\as\frame\body = 0
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: n != 1 && n != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || l2_frame_head(f\value, "merge") = 0
        return: 0
return: f\value

# The result body fields, or 0 when the form has none.
fn: l2_merge_body (const: @(LmP0Node stmt)) @: LmP0Structure
    @: LmP0Field f
    if: l2_merge_frame(stmt) = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 2
        return: 0
    f: l2_next_active(l2_next_active(stmt\as\frame\body\first_field)\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0
        return: 0
return: f\value\as\structure

# Operand count of a merge frame: the leading atoms only. A trailing STRUCTURE
# holds the result body fields and is never an operand.
fn: l2_merge_arity (const: @(LmP0Node mf)) int
    @: LmP0Field f
    int: n 0
    if: mf = 0 || mf\as = 0 || mf\as\frame = 0 || mf\as\frame\body = 0
        return: 0
    f: l2_next_active(mf\as\frame\body\first_field)
    while: f != 0
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: n
        n: n + 1
        f: l2_next_active(f\next)
    ---
return: n

fn: l2_mres_find (const: @(LmP0Text t) ) int
    int: i 0
    while: i < l2_mres_n
        if: l2_text_same(l2_mres_name[i], t)
            return: i
        i: i + 1
    ---
return: 0 - 1

# Nested bodies of an ordinary frame: if, while and for carry their statements
# in a STRUCTURE node among the frame fields.
fn: l2_merge_nested (const: @(LmP0Structure fields)) int
    @: LmP0Field f
    if: fields = 0
        return: 0
    f: l2_next_active(fields\first_field)
    while: f != 0
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_STRUCTURE && f\value\as != 0
            if: l2_merge_scan(f\value\as\structure) != 0
                return: 1
            ---
        ---
        f: l2_next_active(f\next)
    ---
return: 0

# Does a body contain a merge anywhere? A method that does declares
# throws merge(args) and therefore takes the full declared-throw ABI; every
# other callable keeps its direct return, so nothing else changes shape.
fn: l2_body_throws (const: @(LmP0Structure body)) int
    @: LmP0Field field
    @: LmP0Field inner
    @: LmP0Node stmt
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: l2_merge_frame(stmt) != 0
            return: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            inner: l2_next_active(stmt\as\frame\body\first_field)
            while: inner != 0
                if: inner\value != 0 && inner\value\kind = c.LM_P0_NODE_STRUCTURE && inner\value\as != 0
                    if: l2_body_throws(inner\value\as\structure) != 0
                        return: 1
                    ---
                ---
                inner: l2_next_active(inner\next)
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# A call that can throw makes its caller throwing as well. The same closure is
# the current-Message dynamic dependency closure: entry supplies the Message,
# and every throwing method receives and forwards it.
fn: l2_throws_close () int
    int: changed 1
    int: caller
    int: callee
    while: changed != 0
        changed: 0
        caller: 0
        while: caller < l2_m_n
            callee: 0
            while: callee < l2_m_n
                if: l2_m_edge[l2_edge_off(caller, callee)] != 0 && l2_m_throws[callee] != 0 && l2_m_throws[caller] = 0
                    l2_m_throws[caller]: 1
                    changed: 1
                callee: callee + 1
            caller: caller + 1
        ---
    ---
return: 0

# Build the result-slot map for one merge statement: each operand's fields in
# result order, then the body fields. Runs in the PRE-SCAN, because a method
# lowered before main may already read a field of the result.
fn: l2_mrs_build (int: res; const: @(LmP0Node stmt); const: @(LmP0Node mf)) int
    const: @: LmP0Frame fr
    @: LmP0Field last
    @: LmP0Field bf
    @: LmP0Structure bd
    int: n
    int: k 0
    int: oi
    int: ni
    int: sl
    if: mf = 0 || mf\as = 0 || mf\as\frame = 0 || mf\as\frame\body = 0
        return: 0
    fr: mf\as\frame
    n: l2_merge_arity(mf)
    last: l2_next_active(fr\body\first_field)
    while: k < n && last != 0
        if: last\value = 0 || last\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        oi: l2_ebr_find(last\value\as\atom)
        ni: l2_ns_find(last\value\as\atom)
        if: ni >= 0 && l2_ns_parent[ni] >= 0
            ni: 0 - 1
        sl: l2_mres_find(last\value\as\atom)
        if: oi >= 0 && l2_mrs_take_entry(res, l2_ebr_root(oi)) != 0
            return: 1
        if: oi < 0 && ni >= 0 && l2_mrs_take_entry(res, ni) != 0
            return: 1
        if: oi < 0 && ni < 0 && sl >= 0 && l2_mrs_take_result(res, sl) != 0
            return: 1
        last: l2_next_active(last\next)
        k: k + 1
    ---
    bd: l2_merge_body(stmt)
    bf: 0
    if: bd != 0
        bf: l2_next_active(bd\first_field)
    while: bf != 0
        if: bf\value = 0 || bf\value\kind != c.LM_P0_NODE_FRAME || bf\value\as = 0 || bf\value\as\frame = 0 || bf\value\as\frame\body = 0
            return: 0
        if: l2_mrs_push(res, l2_next_active(bf\value\as\frame\body\first_field)\value\as\atom, 0, 0 - 1) != 0
            return: 1
        bf: l2_next_active(bf\next)
    ---
return: 0

fn: l2_merge_scan (const: @(LmP0Structure body)) int
    @: LmP0Field field
    @: LmP0Node stmt
    @: LmP0Node mf
    @@: LmP0Text grown
    @: int widths 0
    @: size_t firsts 0
    @: size_t lasts 0
    int: n
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        mf: l2_merge_frame(stmt)
        if: mf != 0
            n: l2_merge_arity(mf)
            if: n > l2_merge_max
                l2_merge_max: n
            if: l2_mres_find(stmt\as\frame\head) < 0
                grown: (cast: (@@: LmP0Text) c.realloc((cast: (@: void) l2_mres_name), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(@: void)))
                if: grown = 0
                    return: 1
                l2_mres_name: grown
                widths: (cast: (@: int) c.realloc((cast: (@: void) l2_mres_width), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.int)))
                if: widths = 0
                    return: 1
                l2_mres_width: widths
                l2_mres_width[l2_mres_n]: 0
                firsts: (cast: (@: size_t) c.realloc((cast: (@: void) l2_mres_first), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.size_t)))
                lasts: (cast: (@: size_t) c.realloc((cast: (@: void) l2_mres_last), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.size_t)))
                if: firsts = 0 || lasts = 0
                    return: 1
                l2_mres_first: firsts
                l2_mres_last: lasts
                l2_mres_first[l2_mres_n]: 0U
                l2_mres_last[l2_mres_n]: 0U
                widths: (cast: (@: int) c.realloc((cast: (@: void) l2_mres_fok), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.int)))
                if: widths = 0
                    return: 1
                l2_mres_fok: widths
                widths: (cast: (@: int) c.realloc((cast: (@: void) l2_mres_lok), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.int)))
                if: widths = 0
                    return: 1
                l2_mres_lok: widths
                l2_mres_fok[l2_mres_n]: 1
                l2_mres_lok[l2_mres_n]: 1
                l2_mres_name[l2_mres_n]: (cast: (@: LmP0Text) stmt\as\frame\head)
                l2_mres_n: l2_mres_n + 1
                if: l2_mrs_build(l2_mres_n - 1, stmt, mf) != 0
                    return: 1
            ---
        ---
        if: mf = 0 && stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            if: l2_merge_nested(stmt\as\frame\body) != 0
                return: 1
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

fn: l2_emit_body (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    int: array_own
    size_t: array_index
    c.array: [256]: char array_ptr
    c.array: [256]: char index_tok
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    int: oi
    int: si
    int: fi
    int: sl
    int: rj 0
    int: rf 0
    int: raw 1
    int: ix 1
    int: pd 1
    int: need_cut 0
    @: LmP0Structure bd 0
    int: bw 0
    int: msf 0
    size_t: l2_pn 0U
    size_t: l2_pv 0U
    int: l2_pkind 0
    int: l2_pni 0
    int: l2_pres 0
    int: l2_pdst 0
    int: l2_pown 0
    c.array: [256]: char l2_pbuf
    c.array: [256]: char l2_pnm
    c.array: [256]: char pdest
    int: aj 0
    int: aj2 0
    int: am 0
    int: at 0
    int: au 0
    int: bfok 1
    int: blok 1
    size_t: bfirst 0U
    size_t: blast 0U
    size_t: bbody 0U
    int: bat 0
    int: ni 0
    @: LmP0Field bf 0
    int: bn 0
    @: char deep 0
    @: char wdeep 0
    c.array: [64]: char wcond
    c.array: [64]: char wkeep
    c.array: [64]: char wfirst
    if: body = 0
        return: 0
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        pd: 1
        if: l2_frame_head(stmt, "return") && need_cut != 0 && c.fprintf(l2_out, "%s---\n", ind) < 0
            return: 1
        if: l2_frame_head(stmt, "return") = 0 && l2_frame_head(stmt, "if") = 0
            need_cut: 0
        oi: -1
        si: -1
        fi: -1
        sl: -1
        # 19.17 merge at its execution site, settled form R: merge: A B. The
        # statement head is the RESULT NAME; the merge frame is its single body
        # element. Leading atoms are operands; a trailing Structure would be the
        # result body fields and is refused below rather than silently dropped.
        #
        # In a source method, process_message is the compiler-selected dynamic
        # input carried by METHOD.sig. Failure writes the throw graph and returns
        # declared-throw status without publishing the ordinary result.
        if: l2_merge_frame(stmt) != 0
            fr: l2_merge_frame(stmt)\as\frame
            n: l2_merge_arity(l2_merge_frame(stmt))
            if: n < 1
                return: l2_error(l2_src, stmt, "merge needs at least one operand")
            # The result body, when present, is built as a small Structure whose
            # children are the declared fields in source order, and handed to the
            # helper as its body operand. Only a size_t leaf is admitted, the same
            # restriction the qualified branches carry.
            bw: 0
            bfok: 1
            blok: 1
            bfirst: 0U
            blast: 0U
            bbody: 0U
            bd: l2_merge_body(stmt)
            bn: 0
            if: bd != 0
                bn: l2_count_active(bd)
            if: bd != 0 && bn = 0
                return: l2_error(l2_src, stmt, "an empty merge result body is not a field list")
            if: bd != 0 && c.fprintf(l2_out, "%sl2_mbody: lmx_node_new_owned(@ process_message\\blocks, @ process_message\\ranges)\n%sif: l2_mbody = 0\n%s    return: 1\n%sif: lmx_branch_open_owned(l2_mbody, %dU, @ process_message\\blocks, @ process_message\\ranges) != 0\n%s    return: 1\n", ind, ind, ind, ind, bn, ind) < 0
                return: 1
            bf: 0
            if: bd != 0
                bf: l2_next_active(bd\first_field)
            k: 0
            while: bf != 0
                if: l2_frame_head(bf\value, "size_t") = 0 || l2_count_active(bf\value\as\frame\body) != 2
                    return: l2_error(l2_src, stmt, "unsupported merge result body field")
                last: l2_next_active(bf\value\as\frame\body\first_field)
                last: l2_next_active(last\next)
                if: last\value = 0 || last\value\kind != c.LM_P0_NODE_ATOM || l2_num(last\value\as\atom) = 0
                    return: l2_error(l2_src, stmt, "a merge result body field needs a literal")
                bbody: l2_literal_value(last\value\as\atom)
                if: c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mbody, %dU)\n%sif: l2_mxp = 0\n%s    return: 1\n%sl2_mxp[0]: lmx_size_new_owned(@ process_message\\blocks, @ process_message\\ranges)\n%sif: l2_mxp[0] = 0\n%s    return: 1\n%sif: lmx_size_store_known(l2_mxp[0], %zuU) != 0\n%s    return: 1\n", ind, k, ind, ind, ind, ind, ind, ind, l2_literal_value(last\value\as\atom), ind) < 0
                    return: 1
                bf: l2_next_active(bf\next)
                k: k + 1
            ---
            msf: l2_mres_find(stmt\as\frame\head)
            if: msf < 0
                return: l2_error(l2_src, stmt, "merge result name was not reserved")
            last: l2_next_active(fr\body\first_field)
            k: 0
            while: k < n
                oi: l2_ebr_find(last\value\as\atom)
                # The operand must be identified BEFORE its width and literals are
                # read: this lookup used to sit at the bottom of the loop, so every
                # named operand contributed the PREVIOUS operand's fields.
                ni: l2_ns_find(last\value\as\atom)
                if: ni >= 0 && l2_ns_parent[ni] >= 0
                    ni: 0 - 1
                if: ni >= 0 && l2_ns_eternal[ni] >= 0
                    ni: 0 - 1
                sl: l2_mres_find(last\value\as\atom)
                # The result-slot map was built in the pre-scan, because a
                # method lowered before main may already read a field of this
                # result. Nothing to add here.
                # Expected result width, known at translation: every qualified branch in
                # this subset has exactly one child, and a bound result has the width its
                # own merge produced.
                if: oi >= 0
                    bw: bw + l2_ns_count[l2_ebr_root(oi)]
                ---
                if: oi >= 0 && k = 0
                    bfirst: l2_ns_first_value(l2_ebr_root(oi))
                    bfok: 0
                    if: l2_ns_first_kind(l2_ebr_root(oi)) = 0
                        bfok: 1
                    if: l2_ns_first_kind(l2_ebr_root(oi)) = 1
                        bfok: 2
                ---
                if: oi >= 0
                    blast: l2_ns_last_value(l2_ebr_root(oi))
                    blok: 0
                    if: l2_ns_last_kind(l2_ebr_root(oi)) = 0
                        blok: 1
                    if: l2_ns_last_kind(l2_ebr_root(oi)) = 1
                        blok: 2
                ---
                if: oi < 0 && sl >= 0
                    bw: bw + l2_mres_width[sl]
                ---
                if: oi < 0 && sl < 0 && ni >= 0
                    bw: bw + l2_ns_count[ni]
                ---
                if: oi < 0 && sl < 0 && ni >= 0 && k = 0
                    bfirst: l2_ns_first_value(ni)
                    bfok: 0
                    if: l2_ns_first_kind(ni) = 0
                        bfok: 1
                    if: l2_ns_first_kind(ni) = 1
                        bfok: 2
                ---
                if: oi < 0 && sl < 0 && ni >= 0
                    blast: l2_ns_last_value(ni)
                    blok: 0
                    if: l2_ns_last_kind(ni) = 0
                        blok: 1
                    if: l2_ns_last_kind(ni) = 1
                        blok: 2
                ---
                if: oi < 0 && sl >= 0 && k = 0
                    bfirst: l2_mres_first[sl]
                    bfok: l2_mres_fok[sl]
                ---
                if: oi < 0 && sl >= 0
                    blast: l2_mres_last[sl]
                    blok: l2_mres_lok[sl]
                ---
                if: oi < 0 && sl < 0 && ni < 0
                    return: l2_error(l2_src, stmt, "unknown merge operand")
                if: oi >= 0 && c.fprintf(l2_out, "%sl2_mops[%dU]: lmx_branch_struct_known(%s, %uU)\n", ind, k, l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_m_n + 2 + oi))) < 0
                    return: 1
                if: oi < 0 && sl >= 0 && c.fprintf(l2_out, "%sl2_mops[%dU]: lmx_branch_struct_known(%s, %uU)\n", ind, k, l2_unit_ref, (cast: (unsigned) (l2_mres_base + sl))) < 0
                    return: 1
                if: oi < 0 && sl < 0 && c.fprintf(l2_out, "%sl2_mops[%dU]: lmx_branch_struct_known(%s, %uU)\n", ind, k, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni)))) < 0
                    return: 1
                last: l2_next_active(last\next)
                k: k + 1
            ---
            if: bd = 0 && c.fprintf(l2_out, "%sl2_mbody: 0\n", ind) < 0
                return: 1
            bw: bw + bn
            # A body field, when present, is the LAST child of the result, so it wins
            # over the last operand.
            if: bn != 0
                blast: bbody
                blok: 1
            ---
            sl: l2_mres_find(stmt\as\frame\head)
            if: sl < 0
                return: l2_error(l2_src, stmt, "merge result name was not reserved")
            if: c.fprintf(l2_out, "%sl2_mstatus: c.lmx_merge_owned(l2_mops, %dU, l2_mbody, %s, process_message\\ranges, c.lmx_msg_eternal_ranges(process_message), c.lmx_msg_method_ranges(process_message), 0, @ process_message\\blocks, @ process_message\\ranges, @ l2_mresult)\n", ind, n, l2_unit_ref) < 0
                return: 1
            if: mi < 0 && c.fprintf(l2_out, "%sif: l2_mstatus != 0 || l2_mresult = 0\n%s    return: 70\n", ind, ind) < 0
                return: 1
            if: mi >= 0 && c.fprintf(l2_out, "%sif: l2_mstatus != 0 || l2_mresult = 0\n%s    l2_out_throw[0]: node\n%s    return: 1\n", ind, ind, ind) < 0
                return: 1
            # The generated program checks the SHAPE it was promised: the result width
            # is the sum of the operand child counts plus the body fields, all known
            # here. Without this the merge could succeed and produce anything.
            if: c.fprintf(l2_out, "%sif: l2_mresult\\len != %d\n%s    return: 71\n", ind, bw, ind) < 0
                return: 1
            l2_mres_width[sl]: bw
            # Second walk, now that the result exists: every qualified-branch operand
            # contributes one child at a known offset, so its value is checked at THAT
            # index. This pins the order of those operands, not only the two ends.
            last: l2_next_active(fr\body\first_field)
            k: 0
            bat: 0
            while: k < n
                oi: l2_ebr_find(last\value\as\atom)
                if: oi >= 0 && l2_ns_first_kind(l2_ebr_root(oi)) = 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_size_value_known(l2_mxp[0]) != %zuU\n%s    return: 74\n", ind, bat, ind, l2_ns_first_value(l2_ebr_root(oi)), ind) < 0
                    return: 1
                if: oi >= 0 && l2_ns_first_kind(l2_ebr_root(oi)) = 1 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_char_value_known(l2_mxp[0]) != %d\n%s    return: 74\n", ind, bat, ind, (cast: (int) l2_ns_first_value(l2_ebr_root(oi))), ind) < 0
                    return: 1
                # AN ADMITTED BRANCH IS A TERMINAL. merge copies ordinary
                # mutable state around it but keeps these exact addresses,
                # which is the only thing that makes sharing it safe.
                aj: 0
                while: oi >= 0 && aj < l2_ns_count[l2_ebr_root(oi)]
                    if: c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sl2_myp: lmx_branch_slot_known(lmx_branch_struct_known(%s, %uU), %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] != l2_myp[0]\n%s    return: 80\n", ind, bat + aj, ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_m_n + 2 + oi)), aj, ind, ind) < 0
                        return: 1
                    aj: aj + 1
                ---
                if: oi >= 0
                    bat: bat + l2_ns_count[l2_ebr_root(oi)]
                ---
                ni: l2_ns_find(last\value\as\atom)
                if: ni >= 0 && l2_ns_parent[ni] >= 0
                    ni: 0 - 1
                if: ni >= 0 && l2_ns_eternal[ni] >= 0
                    ni: 0 - 1
                if: oi < 0 && ni >= 0 && l2_ns_first_kind(ni) = 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_size_value_known(l2_mxp[0]) != %zuU\n%s    return: 74\n", ind, bat, ind, l2_ns_first_value(ni), ind) < 0
                    return: 1
                if: oi < 0 && ni >= 0 && l2_ns_first_kind(ni) = 1 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_char_value_known(l2_mxp[0]) != %d\n%s    return: 74\n", ind, bat, ind, (cast: (int) l2_ns_first_value(ni)), ind) < 0
                    return: 1
                # ALIASES AND CYCLES THROUGH THE COMMON COPY MAP. Slot bat+j
                # of the result is the copy of the entry that field j of this
                # operand names. If that entry in turn names an entry u which
                # this operand also names at slot j2, then ONE map means the two
                # paths must arrive at the SAME copy. A merge that copied the
                # graph twice, or broke a cycle, fails here instead of passing.
                aj: 0
                while: ni >= 0 && aj < l2_ns_count[ni]
                    at: l2_ns_field_ref(ni, aj)
                    am: 0
                    while: at >= 0 && am < l2_ns_count[at]
                        au: l2_ns_field_ref(at, am)
                        aj2: 0 - 1
                        if: au >= 0
                            aj2: l2_ns_slot_of_ref(ni, au)
                        if: aj2 >= 0 && c.fprintf(l2_out, "%sl2_malias: lmx_branch_struct_known(l2_mresult, %dU)\n%sif: l2_malias = 0\n%s    return: 75\n%sl2_mxp: lmx_branch_slot_known(l2_malias, %dU)\n%sl2_myp: lmx_branch_slot_known(l2_mresult, %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] != l2_myp[0]\n%s    return: 75\n", ind, bat + aj, ind, ind, ind, am, ind, bat + aj2, ind, ind) < 0
                            return: 1
                        am: am + 1
                    ---
                    aj: aj + 1
                ---
                # A CALLABLE field that came through merge. The copy is a
                # DIFFERENT occurrence with its own mutable storage, and the
                # METHOD descriptor at child 0 is the SAME root-owned terminal,
                # never cloned. Checked in the generated program because both
                # are addresses, not values.
                aj: 0
                while: ni >= 0 && aj < l2_ns_count[ni]
                    at: l2_ns_field_kind(ni, aj)
                    au: l2_ns_field_mi(ni, aj)
                    if: at = 4 && c.fprintf(l2_out, "%sl2_malias: lmx_branch_struct_known(l2_mresult, %dU)\n%sif: l2_malias = 0 || l2_malias = lmx_branch_struct_known(%s, %uU)\n%s    return: 77\n", ind, bat + aj, ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + au)), ind) < 0
                        return: 1
                    if: at = 4 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_malias, 0U)\n%sl2_myp: lmx_branch_slot_known(lmx_branch_struct_known(%s, %uU), 0U)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] != l2_myp[0]\n%s    return: 78\n", ind, ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + au)), ind, ind) < 0
                        return: 1
                    if: at = 4 && l2_first_own_child(au) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_malias, %uU)\n%sl2_myp: lmx_branch_slot_known(lmx_branch_struct_known(%s, %uU), %uU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] = l2_myp[0]\n%s    return: 79\n", ind, (cast: (unsigned) l2_first_own_child(au)), ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + au)), (cast: (unsigned) l2_first_own_child(au)), ind, ind) < 0
                        return: 1
                    aj: aj + 1
                ---
                aj: 0
                while: ni >= 0 && aj < l2_ns_count[ni]
                    if: l2_ns_field_kind(ni, aj) = 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sl2_myp: lmx_branch_slot_known(lmx_branch_struct_known(%s, %uU), %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] = l2_myp[0]\n%s    return: 90\n", ind, bat + aj, ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni))), aj, ind, ind) < 0
                        return: 1
                    if: l2_ns_field_kind(ni, aj) = 5 && l2_ns_field_len(ni, aj) > 0U && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sl2_myp: lmx_branch_slot_known(lmx_branch_struct_known(%s, %uU), %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] = l2_myp[0]\n%s    return: 91\n%sif: (cast: (@: LmxArrayDesc) l2_mxp[0])\\len != %zuU\n%s    return: 91\n%sif: (cast: (@: LmxArrayDesc) l2_mxp[0])\\data = (cast: (@: LmxArrayDesc) l2_myp[0])\\data\n%s    return: 91\n", ind, bat + aj, ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni))), aj, ind, ind, ind, l2_ns_field_len(ni, aj), ind, ind, ind) < 0
                        return: 1
                    if: l2_ns_field_kind(ni, aj) = 5 && l2_ns_field_len(ni, aj) = 0U && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sl2_myp: lmx_branch_slot_known(lmx_branch_struct_known(%s, %uU), %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] = l2_myp[0]\n%s    return: 91\n%sif: (cast: (@: LmxArrayDesc) l2_mxp[0])\\len != 0U || (cast: (@: LmxArrayDesc) l2_mxp[0])\\data != 0 || (cast: (@: LmxArrayDesc) l2_myp[0])\\data != 0\n%s    return: 91\n", ind, bat + aj, ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni))), aj, ind, ind, ind, ind) < 0
                        return: 1
                    if: l2_ns_field_kind(ni, aj) = 3 && l2_ns_eternal[l2_ns_field_ref(ni, aj)] >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sif: l2_mxp = 0 || l2_mxp[0] != (cast: (@: void) lmx_branch_struct_known(%s, %uU))\n%s    return: 80\n", ind, bat + aj, ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_m_n + 2 + l2_ns_eternal[l2_ns_field_ref(ni, aj)])), ind) < 0
                        return: 1
                    aj: aj + 1
                ---
                if: oi < 0 && ni >= 0
                    bat: bat + l2_ns_count[ni]
                ---
                if: oi < 0 && ni < 0
                    bat: bat + l2_mres_width[l2_mres_find(last\value\as\atom)]
                ---
                last: l2_next_active(last\next)
                k: k + 1
            ---
            l2_mres_first[sl]: bfirst
            l2_mres_last[sl]: blast
            l2_mres_fok[sl]: bfok
            l2_mres_lok[sl]: blok
            # and the CONTENT it was promised: the first child carries the first
            # operand first field, the last child the last field of the body when there
            # is one, otherwise of the last operand. A shape check alone would pass a
            # copy that moved the right number of wrong values.
            if: bfok = 1 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, 0U)\n%sif: l2_mxp = 0 || lmx_size_value_known(l2_mxp[0]) != %zuU\n%s    return: 72\n", ind, ind, bfirst, ind) < 0
                return: 1
            if: bfok = 2 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, 0U)\n%sif: l2_mxp = 0 || lmx_char_value_known(l2_mxp[0]) != %d\n%s    return: 72\n", ind, ind, (cast: (int) bfirst), ind) < 0
                return: 1
            if: blok = 1 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_size_value_known(l2_mxp[0]) != %zuU\n%s    return: 73\n", ind, bw - 1, ind, blast, ind) < 0
                return: 1
            if: blok = 2 && c.fprintf(l2_out, "%sl2_mxp: lmx_branch_slot_known(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_char_value_known(l2_mxp[0]) != %d\n%s    return: 73\n", ind, bw - 1, ind, (cast: (int) blast), ind) < 0
                return: 1
            # The result is bound under its source name: a reserved unit child.
            if: c.fprintf(l2_out, "%sif: lmx_branch_store_known(%s, %uU, (cast: (@: void) l2_mresult)) != 0\n%s    return: 1\n", ind, l2_unit_ref, (cast: (unsigned) (l2_mres_base + sl)), ind) < 0
                return: 1
            l2_merge_n: l2_merge_n + 1
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        ---
        # ---------------------------------------------------------------
        # FIELD PATHS. In UPDATE position the whole path is the statement head
        # and the single body item is the value:  R\x: 5U
        # In VALUE position it is the body of an ordinary assignment, spelled
        # as atoms around separator atoms:        v: R\x
        # Both roots are reserved children of the program UNIT, which inside a
        # method is the callable's lexical parent rather than a name in scope.
        # l2_emit_path spells that root through l2_unit_ref, so the same walk
        # serves the entry and a method body with no second category.
        # ---------------------------------------------------------------
        l2_pn: 0U
        if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && l2_is_path_head(stmt\as\frame\head) != 0 && l2_head_is_call(stmt\as\frame\head, stmt\as\frame\body, stmt\as\frame\flags) = 0 && l2_slash_own(stmt\as\frame\head) < 0 && l2_slash_for(mi, stmt\as\frame\head) < 0
            if: l2_path_in_eternal(stmt\as\frame\head\data, stmt\as\frame\head\length) != 0
                return: l2_error(l2_src, stmt, "an eternal branch field cannot be updated")
            if: l2_emit_path(stmt\as\frame\head\data, stmt\as\frame\head\length, mi, ind, stmt, @ l2_pkind) != 0
                return: 1
            if: l2_path_rhs(stmt\as\frame\body, l2_pkind, @ l2_pv) != 0
                return: l2_error(l2_src, stmt, "unsupported field path value")
            # A size_t assignment writes the addressed cell IN PLACE. A char
            # assignment REBINDS the field pointer cell to the cell of the new
            # character; the character bytes of the table are never written.
            if: l2_pkind = 0 && c.fprintf(l2_out, "%sif: lmx_size_store_known(l2_pxp[0], %zuU) != 0\n", ind, l2_pv) < 0
                return: 1
            if: l2_pkind = 1 && c.fprintf(l2_out, "%sl2_pxp[0]: lmx_char_rebind_known(l2_pxp[0], %d)\n%sif: l2_pxp[0] = 0\n", ind, (cast: (int) l2_pv), ind) < 0
                return: 1
            if: l2_emit_path_bail(mi, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        ---
        if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            l2_pn: l2_join_path(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), l2_pbuf, 255U)
        if: l2_pn != 0U && l2_path_root(l2_pbuf, l2_pn, @ l2_pni, @ l2_pres) = 0
            if: l2_emit_path(l2_pbuf, l2_pn, mi, ind, stmt, @ l2_pkind) != 0
                return: 1
            # The destination is an entry LOCAL or, inside a method, an OWN
            # field: a cached value with a dirty flag, published at the next
            # checkpoint exactly like any other own-field assignment. Nothing
            # here is a new category.
            l2_pdst: 0 - 1
            l2_pown: 0 - 1
            if: mi < 0
                l2_pdst: l2_loc_find(stmt\as\frame\head)
            if: mi >= 0
                l2_pown: l2_own_find(mi, stmt\as\frame\head)
            if: l2_pdst < 0 && l2_pown < 0
                return: l2_error(l2_src, stmt, "a field path value needs a declared destination")
            if: l2_pdst >= 0 && l2_pkind = 0 && l2_loc_ty[l2_pdst] != 2
                return: l2_error(l2_src, stmt, "a size_t field needs a size_t local")
            if: l2_pdst >= 0 && l2_pkind = 1 && l2_loc_ty[l2_pdst] != 1
                return: l2_error(l2_src, stmt, "a char field needs a char local")
            if: l2_pown >= 0 && l2_pkind = 0 && l2_own_ty[l2_pown] != 2
                return: l2_error(l2_src, stmt, "a size_t field needs a size_t local")
            if: l2_pown >= 0 && l2_pkind = 1 && l2_own_ty[l2_pown] != 1
                return: l2_error(l2_src, stmt, "a char field needs a char local")
            if: l2_pdst >= 0 && l2_tok_text(stmt\as\frame\head, l2_pnm, 256U) != 0
                return: 1
            if: l2_pown >= 0 && c.sprintf(l2_pnm, "l2_q%d", l2_pown) < 0
                return: 1
            if: l2_pkind = 0 && c.fprintf(l2_out, "%s%s: lmx_size_value_known(l2_pxp[0])\n", ind, l2_pnm) < 0
                return: 1
            if: l2_pkind = 1 && c.fprintf(l2_out, "%s%s: (cast: (char) lmx_char_value_known(l2_pxp[0]))\n", ind, l2_pnm) < 0
                return: 1
            if: l2_pown >= 0 && c.fprintf(l2_out, "%sl2_q%d_dirty: 1\n", ind, l2_pown) < 0
                return: 1
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        ---

        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_eval_fields(fr\body\first_field, n - 1, mi, ind, l2_tok) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", ind, l2_tok) < 0
                return: 1
            if: l2_scope_push(last\value) != 0
                return: 1
            if: l2_emit_body(last\value\as\structure, mi, deep) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            # The P0 tree has already consumed indentation cutters, so every
            # emitted nested body needs an explicit L1 cutter before its next
            # sibling. Depending on fr.trailer loses source `---` tokens.
            if: c.fprintf(l2_out, "%s---\n", deep) < 0
                return: 1
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && c.fprintf(l2_out, "%selse:\n", ind) < 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                if: l2_scope_push(nxt\value) != 0
                    return: 1
                if: l2_emit_body(nxt\value\as\frame\body, mi, deep) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
                if: c.fprintf(l2_out, "%s---\n", deep) < 0
                    return: 1
                ---
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            need_cut: 1
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            wkeep[0]: 0
            wcond[0]: 0
            if: l2_bump_ind(deep, @ wdeep) != 0
                return: 1
            if: l2_new_temp(ind, wkeep) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wkeep) < 0
                return: 1
            if: l2_new_temp(ind, wcond) != 0
                return: 1
            if: c.fprintf(l2_out, "%swhile: %s\n", ind, wkeep) < 0
                return: 1
            if: l2_eval_cond(fr\body\first_field, n - 1, mi, deep, wcond) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wcond) < 0
                return: 1
            if: c.fprintf(l2_out, "%s    %s: 0\n", deep, wkeep) < 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", deep, wkeep) < 0
                return: 1
            if: l2_emit_poll(mi, wdeep) != 0
                return: 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_scope_push(last\value) != 0
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            if: l2_emit_body(last\value\as\structure, mi, wdeep) != 0
                l2_scope_pop()
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            l2_scope_pop()
            l2_loop_depth: l2_loop_depth - 1
            if: c.fprintf(l2_out, "%send: while\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for")
            fr: stmt\as\frame
            if: l2_for_cstyle(stmt) = 0
                return: 1
            last: l2_next_active(fr\body\first_field)
            if: l2_scope_push(stmt) != 0
                return: 1
            wkeep[0]: 0
            wcond[0]: 0
            wfirst[0]: 0
            if: l2_bump_ind(deep, @ wdeep) != 0
                l2_scope_pop()
                return: 1
            oi: l2_own_find(mi, l2_next_active(last\value\as\frame\body\first_field)\value\as\atom)
            if: oi < 0
                l2_scope_pop()
                return: 1
            if: l2_eval_fields(l2_next_active(l2_next_active(last\value\as\frame\body\first_field)\next), 1, mi, ind, l2_tok) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sl2_q%d: %s\n%sl2_q%d_dirty: 1\n", ind, oi, l2_tok, ind, oi) < 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: l2_new_temp(ind, wkeep) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: l2_new_temp(ind, wfirst) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wfirst) < 0
                l2_scope_pop()
                return: 1
            if: l2_new_temp(ind, wcond) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%swhile: %s\n", ind, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wfirst) < 0
                l2_scope_pop()
                return: 1
            nxt: l2_next_active(last\next)
            if: nxt = 0 || nxt\value = 0 || nxt\value\kind != c.LM_P0_NODE_ATOM
                l2_scope_pop()
                return: 1
            si: l2_own_find(mi, nxt\value\as\atom)
            if: si < 0
                l2_scope_pop()
                return: 1
            nxt: l2_next_active(nxt\next)
            if: nxt != 0 && nxt\value != 0 && l2_text_eq(nxt\value\as\atom, "--") && c.fprintf(l2_out, "%s    l2_q%d: l2_q%d - 1\n%s    l2_q%d_dirty: 1\n", deep, si, si, deep, si) < 0
                l2_scope_pop()
                return: 1
            if: nxt != 0 && nxt\value != 0 && l2_text_eq(nxt\value\as\atom, "--") = 0 && c.fprintf(l2_out, "%s    l2_q%d: l2_q%d + 1\n%s    l2_q%d_dirty: 1\n", deep, si, si, deep, si) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 0\n", deep, wfirst) < 0
                l2_scope_pop()
                return: 1
            if: last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                l2_scope_pop()
                return: 1
            if: l2_eval_cond(last\value\as\structure\first_field, l2_count_active(last\value\as\structure), mi, deep, wcond) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wcond) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s    %s: 0\n", deep, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", deep, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: l2_emit_poll(mi, wdeep) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < 5
                last: l2_next_active(last\next)
                k: k + 1
            l2_loop_depth: l2_loop_depth + 1
            if: last = 0 || last\value = 0 || last\value\as = 0 || l2_emit_body(last\value\as\structure, mi, wdeep) != 0
                l2_loop_depth: l2_loop_depth - 1
                l2_scope_pop()
                return: 1
            l2_loop_depth: l2_loop_depth - 1
            if: c.fprintf(l2_out, "%send: while\n", ind) < 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "continue")
            if: c.fprintf(l2_out, "%scontinue\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "break")
            if: c.fprintf(l2_out, "%sbreak\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "return") && mi >= 0 && l2_m_ret[mi] = 8
            if: l2_emit_poll(mi, ind) != 0
                return: 1
            if: l2_emit_checkpoint(mi, ind) != 0
                return: 1
            if: c.fprintf(l2_out, "%sreturn\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "return")
            return: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0
            pd: l2_prefix_deref(stmt\as\frame\head, mi, pdest)
        if: pd = 0
            fr: stmt\as\frame
            if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0 || l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s: %s\n", ind, pdest, l2_tok) < 0
                return: 1
            field: l2_next_active(field\next)
            pd: 1
            continue
        ---
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && l2_own_index_head(stmt\as\frame\head, mi, @ array_own, @ array_index) = 0
            fr: stmt\as\frame
            if: l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0 || l2_emit_array_ptr(array_own, ind, array_ptr) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s[%zuU]: %s\n", ind, array_ptr, array_index, l2_tok) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        ix: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
            ix: l2_index_head(stmt\as\frame\head, mi, @ rj)
        if: ix = 0
            fr: stmt\as\frame
        if: ix = 0 && (fr\body = 0 || fr\trailer != 0)
            return: 1
        if: ix = 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: ix = 0 && l2_index_token(stmt\as\frame\head, mi, index_tok) != 0
            return: 1
        if: ix = 0
            l2_pn: 0U
            while: l2_pn < fr\head\length && fr\head\data[l2_pn] != 91
                l2_pn: l2_pn + 1U
            ---
        if: ix = 0 && mi >= 0 && rj < l2_m_arity[mi] && fr\head\length > l2_fn(mi, rj)\length + 1U && fr\head\data[l2_fn(mi, rj)\length] = 92 && c.fprintf(l2_out, "%sl2_p%d_%d\\%.*s[%s]: %s\n", ind, mi, rj, (cast: (int) (l2_pn - l2_fn(mi, rj)\length - 1U)), fr\head\data + l2_fn(mi, rj)\length + 1U, index_tok, l2_tok) < 0
            return: 1
        if: ix = 0 && mi >= 0 && rj < l2_m_arity[mi] && (fr\head\length <= l2_fn(mi, rj)\length || fr\head\data[l2_fn(mi, rj)\length] != 92) && c.fprintf(l2_out, "%sl2_p%d_%d[%s]: %s\n", ind, mi, rj, index_tok, l2_tok) < 0
            return: 1
        if: ix = 0 && mi >= 0 && rj >= l2_m_arity[mi] && rj < l2_m_arity[mi] + l2_m_sn[mi] && c.fprintf(l2_out, "%sl2_s%d_%d[%s]: %s\n", ind, mi, rj - l2_m_arity[mi], index_tok, l2_tok) < 0
            return: 1
        if: ix = 0 && (mi < 0 || rj >= l2_m_arity[mi] + l2_m_sn[mi]) && c.fprintf(l2_out, "%s%.*s[%s]: %s\n", ind, (cast: (int) l2_pn), fr\head\data, index_tok, l2_tok) < 0
            return: 1
        if: ix = 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "continue") || l2_frame_head(stmt, "break")
            return: 1
        n: l2_emit_loc_stmt(stmt, mi, ind)
        if: n = 2
            return: 1
        if: n = 0
            field: l2_next_active(field\next)
            continue
        if: stmt\as != 0 && stmt\as\frame != 0 && l2_c_stmt_door(stmt\as\frame\head) != 0
            if: l2_emit_ccall(stmt, mi, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0
            oi: l2_own_find(mi, l2_own_decl_name(stmt))
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && mi >= 0
            l2_own_live[oi]: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && mi >= 0 && l2_m_alias[l2_own_off(mi, oi)] >= 0 && l2_own_fid[oi] >= 0 && (l2_own_ty[oi] = 1 || l2_own_ty[oi] = 2 || l2_own_ty[oi] = 3 || l2_own_ty[oi] = 36) && c.fprintf(l2_out, "%sl2_q%d_from: lmx_branch_slot_known(l2_h%d, %uU)\n%sif: l2_q%d_from = 0\n%s    %s\n", ind, oi, l2_own_fid[oi], (cast: (unsigned) l2_own_fchild[oi]), ind, oi, ind, l2_fail_return(mi)) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && mi >= 0 && l2_m_alias[l2_own_off(mi, oi)] >= 0 && l2_own_fid[oi] < 0 && (l2_own_ty[oi] = 1 || l2_own_ty[oi] = 2 || l2_own_ty[oi] = 3 || l2_own_ty[oi] = 36) && c.fprintf(l2_out, "%sl2_q%d_from: lmx_branch_slot_known(%s, %uU)\n%sif: l2_q%d_from = 0\n%s    %s\n", ind, oi, l2_own_ctr(oi), (cast: (unsigned) l2_own_uchild[oi]), ind, oi, ind, l2_fail_return(mi)) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && l2_count_active(stmt\as\frame\body) = 2 && l2_eval_fields(l2_next_active(l2_next_active(stmt\as\frame\body\first_field)\next), 1, mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && l2_count_active(stmt\as\frame\body) = 2 && c.fprintf(l2_out, "%sl2_q%d: %s\n%sl2_q%d_dirty: 1\n", ind, oi, l2_tok, ind, oi) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (stmt = 0 || stmt\as = 0 || stmt\as\frame = 0)
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_find_method(fr\head) < 0 && (l2_predef_has_function(fr\head) != 0)
            if: l2_emit_ccall(stmt, mi, ind) != 0
                return: 1
            ---
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && mi >= 0 && l2_m_ret[mi] = 8 && l2_emit_poll(mi, ind) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && mi >= 0 && l2_m_ret[mi] = 8 && l2_emit_checkpoint(mi, ind) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && mi >= 0 && l2_m_ret[mi] = 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn\n", ind) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && mi >= 0 && l2_m_ret[mi] = 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sreturn: 0\n", ind) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && mi >= 0 && l2_m_ret[mi] = 8
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && (mi < 0 || l2_m_ret[mi] != 8) && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
