        return: 1
return: 0

fn: l2_raw_path (const: @(char pd); size_t: pn; int: mi; @: int out_j; @: int out_fld) int
    size_t: i 0U
    size_t: sl 0U
    int: j
    if: pd = 0 || mi < 0 || out_j = 0 || out_fld = 0
        return: 1
    sl: pn
    while: i < pn
        if: pd[i] = 92 && sl = pn
            sl: i
        i: i + 1U
    if: sl = 0U || sl = pn || sl + 1U >= pn
        return: 1
    j: 0
    while: j < l2_m_arity[mi]
        if: l2_fn(mi, j) != 0 && l2_fn(mi, j)\length = sl && c.memcmp(l2_fn(mi, j)\data, pd, sl) = 0
            \out_j: j
            if: (l2_ft(mi, j) = 28 || l2_ft(mi, j) = 29 || l2_ft(mi, j) = 30) && l2_raw_fixed_field(l2_ft(mi, j), pd + sl + 1U, pn - sl - 1U) != 0
                \out_fld: 5
                return: 0
            if: l2_ft(mi, j) = 28 || l2_ft(mi, j) = 29 || l2_ft(mi, j) = 30
                return: 2
            if: l2_ft(mi, j) >= 100
                \out_fld: 5
                return: 0
            if: pn - sl - 1U = 4U && c.memcmp(pd + sl + 1U, "data", 4U) = 0
                \out_fld: 0
                return: 0
            if: pn - sl - 1U = 6U && c.memcmp(pd + sl + 1U, "length", 6U) = 0
                \out_fld: 1
                return: 0
            if: pn - sl - 1U = 7U && c.memcmp(pd + sl + 1U, "columns", 7U) = 0
                \out_fld: 2
                return: 0
            if: pn - sl - 1U = 5U && c.memcmp(pd + sl + 1U, "count", 5U) = 0
                \out_fld: 3
                return: 0
            if: pn - sl - 1U = 8U && c.memcmp(pd + sl + 1U, "capacity", 8U) = 0
                \out_fld: 4
                return: 0
            return: 2
        j: j + 1
    if: mi < 0
        return: 1
    j: 0
    while: j < l2_m_sn[mi]
        if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = sl && c.memcmp(l2_sn[l2_slot_off(mi, j)]\data, pd, sl) = 0
            # Raw formal and local-slot targets share this result channel.
            # Place slots after the method's actual formal count so every
            # arity remains disjoint without a reserved numeric band.
            \out_j: l2_m_arity[mi] + j
            if: (l2_st[l2_slot_off(mi, j)] = 28 || l2_st[l2_slot_off(mi, j)] = 29 || l2_st[l2_slot_off(mi, j)] = 30) && l2_raw_fixed_field(l2_st[l2_slot_off(mi, j)], pd + sl + 1U, pn - sl - 1U) != 0
                \out_fld: 5
                return: 0
            if: l2_st[l2_slot_off(mi, j)] = 28 || l2_st[l2_slot_off(mi, j)] = 29 || l2_st[l2_slot_off(mi, j)] = 30
                return: 2
            if: l2_st[l2_slot_off(mi, j)] >= 100
                \out_fld: 5
                return: 0
            if: pn - sl - 1U = 4U && c.memcmp(pd + sl + 1U, "data", 4U) = 0
                \out_fld: 0
                return: 0
            if: pn - sl - 1U = 6U && c.memcmp(pd + sl + 1U, "length", 6U) = 0
                \out_fld: 1
                return: 0
            if: pn - sl - 1U = 7U && c.memcmp(pd + sl + 1U, "columns", 7U) = 0
                \out_fld: 2
                return: 0
            if: pn - sl - 1U = 5U && c.memcmp(pd + sl + 1U, "count", 5U) = 0
                \out_fld: 3
                return: 0
            if: pn - sl - 1U = 8U && c.memcmp(pd + sl + 1U, "capacity", 8U) = 0
                \out_fld: 4
                return: 0
            return: 2
        j: j + 1
    j: 0
    while: j < l2_ml_n
        if: l2_ml_nm[j] != 0 && l2_ml_nm[j]\length = sl && c.memcmp(l2_ml_nm[j]\data, pd, sl) = 0 && (l2_ml_ty[j] = 28 || l2_ml_ty[j] = 29 || l2_ml_ty[j] = 30) && l2_raw_fixed_field(l2_ml_ty[j], pd + sl + 1U, pn - sl - 1U) != 0
            \out_j: l2_m_arity[mi] + l2_m_sn[mi] + j
            \out_fld: 5
            return: 0
        if: l2_ml_nm[j] != 0 && l2_ml_nm[j]\length = sl && c.memcmp(l2_ml_nm[j]\data, pd, sl) = 0 && (l2_ml_ty[j] = 28 || l2_ml_ty[j] = 29 || l2_ml_ty[j] = 30)
            return: 2
        if: l2_ml_ty[j] >= 100 && l2_ml_nm[j] != 0 && l2_ml_nm[j]\length = sl && c.memcmp(l2_ml_nm[j]\data, pd, sl) = 0
            \out_j: l2_m_arity[mi] + l2_m_sn[mi] + j
            \out_fld: 5
            return: 0
        j: j + 1
return: 1


fn: l2_raw_head (const: @(LmP0Text t); int: mi; @: int out_j; @: int out_fld) int
    if: t = 0
        return: 1
return: l2_raw_path(t\data, t\length, mi, out_j, out_fld)
fn: l2_pointer_depth (int: ty) int
    int: fi
    if: ty >= 1000 && ty < 2000
        ty: ty - 1000
    if: ty = 3 || ty = 9 || ty = 11 || ty = 12 || ty = 13 || ty = 16 || ty = 21 || ty = 23 || ty = 25 || ty = 26 || ty = 27 || ty = 29 || ty = 31 || ty = 38
        return: 1
    if: ty = 17 || ty = 18 || ty = 19 || ty = 20 || ty = 24 || ty = 39
        return: 2
    if: ty >= 100
        fi: ty - 100
        if: fi >= 0 && fi < l2_foreign_n
            return: l2_foreign_depth[fi]
        ---
    ---
return: 0

# Prefix `\` is raw dereference. Only the leading run is dereference; any
# later `\field` stays postfix field-follow. Rename the selected L2 binding,
# preserve both positional operators, and leave `[]` to the index path.
fn: l2_prefix_deref (const: @(LmP0Text t); int: mi; @: char dest) int
    size_t: lead 0U
    size_t: base_end
    size_t: i
    size_t: at 0U
    int: j
    int: ty 0
    int: found 0
    if: t = 0 || t\data = 0 || dest = 0 || t\length >= 256U
        return: 1
    while: lead < t\length && t\data[lead] = 92
        lead: lead + 1U
    if: lead = 0U
        return: 1
    base_end: lead
    while: base_end < t\length && t\data[base_end] != 92
        base_end: base_end + 1U
    if: base_end = lead
        return: 2
    if: mi >= 0
        j: 0
        while: j < l2_m_arity[mi] && found = 0
            if: l2_fn(mi, j) != 0 && l2_fn(mi, j)\length = base_end - lead && c.memcmp(l2_fn(mi, j)\data, t\data + lead, base_end - lead) = 0
                ty: l2_ft(mi, j)
                i: 0U
                while: i < lead
                    dest[at]: 92
                    at: at + 1U
                    i: i + 1U
                if: c.sprintf(dest + at, "l2_p%d_%d", mi, j) < 0
                    return: 2
                at: c.strlen(dest)
                found: 1
            ---
            j: j + 1
        ---
        j: 0
        while: j < l2_own_n && found = 0
            if: l2_own_mi[j] = mi && l2_own_name[j] != 0 && l2_own_name[j]\length = base_end - lead && c.memcmp(l2_own_name[j]\data, t\data + lead, base_end - lead) = 0 && l2_m_uses[l2_own_off(mi, j)] != 0
                ty: l2_own_ty[j]
                i: 0U
                while: i < lead
                    dest[at]: 92
                    at: at + 1U
                    i: i + 1U
                if: c.sprintf(dest + at, "l2_q%d", j) < 0
                    return: 2
                at: c.strlen(dest)
                found: 1
            ---
            j: j + 1
        ---
        j: 0
        while: j < l2_m_sn[mi] && found = 0
            if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = base_end - lead && c.memcmp(l2_sn[l2_slot_off(mi, j)]\data, t\data + lead, base_end - lead) = 0
                ty: l2_st[l2_slot_off(mi, j)]
                i: 0U
                while: i < lead
                    dest[at]: 92
                    at: at + 1U
                    i: i + 1U
                if: c.sprintf(dest + at, "l2_s%d_%d", mi, j) < 0
                    return: 2
                at: c.strlen(dest)
                found: 1
            ---
            j: j + 1
        ---
        j: 0
        while: j < l2_ml_n && found = 0
            if: l2_ml_nm[j] != 0 && l2_ml_nm[j]\length = base_end - lead && c.memcmp(l2_ml_nm[j]\data, t\data + lead, base_end - lead) = 0
                ty: l2_ml_ty[j]
                i: 0U
                while: i < lead
                    dest[at]: 92
                    at: at + 1U
                    i: i + 1U
                c.memcpy(dest + at, t\data + lead, base_end - lead)
                at: at + base_end - lead
                dest[at]: 0
                found: 1
            ---
            j: j + 1
        ---
    ---
    if: mi < 0
        j: 0
        while: j < l2_loc_n && found = 0
            if: l2_loc_nm[j] != 0 && l2_loc_nm[j]\length = base_end - lead && c.memcmp(l2_loc_nm[j]\data, t\data + lead, base_end - lead) = 0
                ty: l2_loc_ty[j]
                i: 0U
                while: i < lead
                    dest[at]: 92
                    at: at + 1U
                    i: i + 1U
                c.memcpy(dest + at, t\data + lead, base_end - lead)
                at: at + base_end - lead
                dest[at]: 0
                found: 1
