end: l2_index_head

# Spell the index of a native pointer assignment. Literal indexes remain
# literal; a formal is renamed to its generated parameter name; ordinary
# entry/method locals retain their source name. Validation is performed by
# l2_index_head before this helper is called.
fn: l2_index_token (const: @(LmP0Text t); int: mi; @: char dest) int
    size_t: i 0U
    size_t: lb
    size_t: n
    size_t: ilen
    int: j
    int: k
    size_t: at
    size_t: first
    size_t: stop
    size_t: out_n 0U
    int: matched
    if: t = 0 || t\data = 0 || dest = 0
        return: 1
    n: t\length
    lb: n
    while: i < n
        if: t\data[i] = 91
            lb: i
        i: i + 1U
    if: lb = n || lb + 1U >= n - 1U
        return: 1
    ilen: n - lb - 2U
    if: mi >= 0
        k: 0
        while: k < l2_own_n
            if: l2_own_mi[k] = mi && (l2_own_host[k] = 0 || l2_scope_has(l2_own_host[k])) && l2_own_name[k] != 0 && l2_own_name[k]\length = ilen && c.memcmp(l2_own_name[k]\data, t\data + lb + 1U, ilen) = 0
                if: c.sprintf(dest, "l2_q%d", k) < 0
                    return: 1
                return: 0
            k: k + 1
        ---
        j: 0
        while: j < l2_m_arity[mi]
            if: l2_fn(mi, j) != 0 && l2_fn(mi, j)\length = ilen && c.memcmp(l2_fn(mi, j)\data, t\data + lb + 1U, ilen) = 0
                if: c.sprintf(dest, "l2_p%d_%d", mi, j) < 0
                    return: 1
                return: 0
            if: l2_fn(mi, j) != 0 && l2_ft(mi, j) >= 100 && ilen > l2_fn(mi, j)\length + 1U && c.memcmp(l2_fn(mi, j)\data, t\data + lb + 1U, l2_fn(mi, j)\length) = 0 && t\data[lb + 1U + l2_fn(mi, j)\length] = 92
                if: c.sprintf(dest, "l2_p%d_%d\\%.*s", mi, j, (cast: (int) (ilen - l2_fn(mi, j)\length - 1U)), t\data + lb + 2U + l2_fn(mi, j)\length) < 0
                    return: 1
                return: 0
            j: j + 1
        ---
    # Preserve the complete C-like index expression while renaming every L2
    # formal token to its generated L1 parameter.  Operators, whitespace,
    # literals, and method locals are copied byte-for-byte.
    at: lb + 1U
    stop: n - 1U
    while: at < stop
        if: (t\data[at] >= 65 && t\data[at] <= 90) || (t\data[at] >= 97 && t\data[at] <= 122) || t\data[at] = 95
            first: at
            at: at + 1U
            while: at < stop && ((t\data[at] >= 65 && t\data[at] <= 90) || (t\data[at] >= 97 && t\data[at] <= 122) || (t\data[at] >= 48 && t\data[at] <= 57) || t\data[at] = 95)
                at: at + 1U
            ---
            matched: 0
            j: 0
            while: mi >= 0 && j < l2_own_n
                if: l2_own_mi[j] = mi && (l2_own_host[j] = 0 || l2_scope_has(l2_own_host[j])) && l2_own_name[j] != 0 && l2_own_name[j]\length = at - first && c.memcmp(l2_own_name[j]\data, t\data + first, at - first) = 0 && l2_m_uses[l2_own_off(mi, j)] != 0
                    k: c.sprintf(dest + out_n, "l2_q%d", j)
                    if: k < 0 || out_n + (cast: (size_t) k) >= 255U
                        return: 1
                    out_n: out_n + (cast: (size_t) k)
                    matched: 1
                j: j + 1
            ---
            j: 0
            while: mi >= 0 && matched = 0 && j < l2_m_arity[mi]
                if: l2_fn(mi, j) != 0 && l2_fn(mi, j)\length = at - first && c.memcmp(l2_fn(mi, j)\data, t\data + first, at - first) = 0
                    k: c.sprintf(dest + out_n, "l2_p%d_%d", mi, j)
                    if: k < 0 || out_n + (cast: (size_t) k) >= 255U
                        return: 1
                    out_n: out_n + (cast: (size_t) k)
                    matched: 1
                j: j + 1
            ---
            j: 0
            while: mi >= 0 && matched = 0 && j < l2_m_sn[mi]
                if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = at - first && c.memcmp(l2_sn[l2_slot_off(mi, j)]\data, t\data + first, at - first) = 0
                    k: c.sprintf(dest + out_n, "l2_s%d_%d", mi, j)
                    if: k < 0 || out_n + (cast: (size_t) k) >= 255U
                        return: 1
                    out_n: out_n + (cast: (size_t) k)
                    matched: 1
                j: j + 1
            ---
            if: matched = 0
                if: out_n + at - first >= 255U
                    return: 1
                c.memcpy(dest + out_n, t\data + first, at - first)
                out_n: out_n + at - first
            ---
        else:
            if: out_n + 1U >= 255U
                return: 1
            dest[out_n]: t\data[at]
            out_n: out_n + 1U
            at: at + 1U
        ---
    dest[out_n]: 0
return: 0

fn: l2_expr_span (@: LmP0Field field) int
    @: LmP0Field f
    @: LmP0Field index
    @: LmP0Field after
    @: LmP0Field slash
    @: LmP0Field member
    int: span 1
    int: operand 1
    int: n
    if: field = 0 || field\value = 0
        return: 0
    # An address prefix belongs to the expression it addresses: "@ tail" and
    # "@ item\\next" are ONE actual, not two or four. Counting them
    # separately makes a well-formed call look like the wrong arity.
    if: field\value\kind = c.LM_P0_NODE_ATOM && field\value\as != 0 && l2_text_eq(field\value\as\atom, "@")
        n: l2_expr_span(l2_next_active(field\next))
        if: n < 1
            return: 0
        return: n + 1
    # A prefix raw load belongs to the expression it loads, exactly as the
    # address prefix above does: one actual, not two. Counting the prefix
    # separately made a well-formed call look like the wrong arity.
    if: field\value\kind = c.LM_P0_NODE_ATOM && field\value\as != 0 && l2_is_slash(field\value\as\atom)
        n: l2_expr_span(l2_next_active(field\next))
        if: n < 1
            return: 0
        return: n + 1
    if: l2_index_tail(field, @ index, @ after) = 0
        span: 4
        f: after
    else:
        f: l2_next_active(field\next)
        slash: f
        if: slash != 0 && slash\value != 0 && slash\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(slash\value\as\atom)
            member: l2_next_active(slash\next)
            if: member = 0 || member\value = 0 || member\value\kind != c.LM_P0_NODE_ATOM
                return: 0
            span: 3
            f: l2_next_active(member\next)
            if: l2_index_tail(member, @ index, @ after) = 0
                span: 6
                f: after
            ---
        ---
    # Postfix field-follow may continue for any number of segments. Each
    # `\name` remains part of the same operand and therefore of one actual.
    while: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
        member: l2_next_active(f\next)
        if: member = 0 || member\value = 0 || member\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        span: span + 2
        f: l2_next_active(member\next)
    ---
    while: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
        f: l2_next_active(f\next)
        if: f = 0 || f\value = 0
            return: 0
        span: span + 1
        operand: 1
        if: l2_index_tail(f, @ index, @ after) = 0
            operand: 4
            f: after
        else:
            f: l2_next_active(f\next)
            slash: f
            if: slash != 0 && slash\value != 0 && slash\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(slash\value\as\atom)
                member: l2_next_active(slash\next)
                if: member = 0 || member\value = 0 || member\value\kind != c.LM_P0_NODE_ATOM
                    return: 0
                operand: 3
                f: l2_next_active(member\next)
                if: l2_index_tail(member, @ index, @ after) = 0
                    operand: 6
                    f: after
                ---
            ---
        span: span + operand
    ---
    n: span
return: n

fn: l2_actual_count (@: LmP0Field field) int
    @: LmP0Field f
    int: count 0
    int: span
    int: i
    f: l2_next_active(field)
    while: f != 0
        span: l2_expr_span(f)
        if: span < 1
            return: 0 - 1
        count: count + 1
        i: 0
        while: i < span && f != 0
            f: l2_next_active(f\next)
            i: i + 1
        ---
return: count

fn: l2_slash_own (const: @(LmP0Text t)) int
    int: i 0
    size_t: n
    if: t = 0 || t\data = 0 || t\length < 6U
        return: -1
    if: t\data[0] != 110 || t\data[1] != 111 || t\data[2] != 100 || t\data[3] != 101 || t\data[4] != 92
        return: -1
    n: t\length - 5U
    while: i < l2_own_n
        if: l2_own_host[i] = 0 && l2_own_name[i] != 0 && l2_own_name[i]\length = n && c.memcmp(l2_own_name[i]\data, t\data + 5, n) = 0
            return: i
        i: i + 1
return: -1

fn: l2_slash_for (int: mi; const: @(LmP0Text t)) int
    if: t = 0
        return: -1
return: l2_slash_for_prefix(mi, t, t\length)

fn: l2_slash_for_prefix (int: mi; const: @(LmP0Text t); size_t: stop) int
    int: i 0
    int: hit
    size_t: n
    hit: -1
    if: mi < 0 || t = 0 || t\data = 0 || stop < 5U || stop > t\length
        return: -1
    if: t\data[0] != 102 || t\data[1] != 111 || t\data[2] != 114 || t\data[3] != 92
        return: -1
    n: stop - 4U
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_own_host[i] != 0 && l2_frame_head(l2_own_host[i], "for") && l2_own_name[i] != 0 && l2_own_name[i]\length = n && c.memcmp(l2_own_name[i]\data, t\data + 4, n) = 0 && hit >= 0
            return: -1
        if: l2_own_mi[i] = mi && l2_own_host[i] != 0 && l2_frame_head(l2_own_host[i], "for") && l2_own_name[i] != 0 && l2_own_name[i]\length = n && c.memcmp(l2_own_name[i]\data, t\data + 4, n) = 0
            hit: i
        i: i + 1
return: hit


# Array node paths use the same method-local unique lookup as l2_path_own.
fn: l2_slash_node_prefix (int: mi; const: @(LmP0Text t); size_t: stop) int
    int: i 0
    int: hit
    size_t: n
    hit: -1
    if: mi < 0 || t = 0 || t\data = 0 || stop < 6U || stop > t\length
        return: -1
    if: t\data[0] != 110 || t\data[1] != 111 || t\data[2] != 100 || t\data[3] != 101 || t\data[4] != 92
        return: -1
    n: stop - 5U
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_own_host[i] = 0 && l2_own_name[i] != 0 && l2_own_name[i]\length = n && c.memcmp(l2_own_name[i]\data, t\data + 5, n) = 0
            if: hit >= 0
                return: -1
            hit: i
        i: i + 1
return: hit

# Static proof for fixed-extent own INT/CHAR arrays. General indexing requires
# throw: Bounds; an unsupported form gets no runtime sentinel substitute.
fn: l2_array_literal (int: oi; const: @(LmP0Text t); size_t: begin; size_t: stop; @: size_t out_index) int
    size_t: value 0U
    size_t: digit
    size_t: i
    if: oi < 0 || t = 0 || t\data = 0 || out_index = 0 || begin >= stop || stop > t\length
        return: 1
    if: l2_own_is_array(l2_own_ty[oi]) = 0 || l2_own_count[oi] = 0
        return: 1
    i: begin
    while: i < stop
        if: t\data[i] < 48 || t\data[i] > 57
            return: 1
        digit: (cast: (size_t) (t\data[i] - 48))
        if: value > (((cast: (size_t) -1) - digit) / 10U)
            return: 1
        value: value * 10U + digit
        i: i + 1U
    ---
    if: value >= l2_positive_decimal(l2_own_count[oi])
        return: 1
    \out_index: value
return: 0

# 1: another head; 2: unsupported own-array index; 0: proven valid.
fn: l2_own_index_head (const: @(LmP0Text t); int: mi; @: int out_own; @: size_t out_index) int
    int: oi 0
    size_t: lb 0U
    if: mi < 0 || t = 0 || t\data = 0 || out_own = 0 || out_index = 0
        return: 1
    while: lb < t\length && t\data[lb] != 91
        lb: lb + 1U
    if: lb = t\length || lb = 0U
        return: 1
    if: lb >= 5U && t\data[0] = 110 && t\data[1] = 111 && t\data[2] = 100 && t\data[3] = 101 && t\data[4] = 92
        oi: l2_slash_node_prefix(mi, t, lb)
        if: oi < 0 || t\data[t\length - 1U] != 93
            return: 2
        if: l2_array_literal(oi, t, lb + 1U, t\length - 1U, out_index) != 0
            return: 2
        \out_own: oi
        return: 0
    if: lb >= 4U && t\data[0] = 102 && t\data[1] = 111 && t\data[2] = 114 && t\data[3] = 92
        oi: l2_slash_for_prefix(mi, t, lb)
        if: oi < 0 || t\data[t\length - 1U] != 93
            return: 2
        if: l2_array_literal(oi, t, lb + 1U, t\length - 1U, out_index) != 0
            return: 2
        \out_own: oi
        return: 0
    while: oi < l2_own_n
        if: (l2_own_mi[oi] = mi || l2_own_mi[oi] < 0) && (l2_own_host[oi] = 0 || l2_scope_has(l2_own_host[oi])) && l2_own_is_array(l2_own_ty[oi]) != 0 && l2_own_name[oi]\length = lb && c.memcmp(l2_own_name[oi]\data, t\data, lb) = 0
            if: t\data[t\length - 1U] != 93 || l2_array_literal(oi, t, lb + 1U, t\length - 1U, out_index) != 0
                return: 2
            \out_own: oi
            return: 0
        oi: oi + 1
return: 1

fn: l2_own_index_tail (@: LmP0Field f; int: mi; @: int out_own; @: size_t out_index; @@: LmP0Field out_after; @: int out_count) int
    int: oi
    @: LmP0Field index_field
    @: LmP0Field slash
    @: LmP0Field name
    @: LmP0Field bracket
    @: LmP0Field after
    if: mi < 0 || f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || out_own = 0 || out_index = 0 || out_after = 0 || out_count = 0
        return: 1
    \out_count: 4
    oi: l2_own_find(mi, f\value\as\atom)
    if: l2_text_eq(f\value\as\atom, "for") || l2_text_eq(f\value\as\atom, "node")
        slash: l2_next_active(f\next)
        if: slash != 0 && slash\value != 0 && slash\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(slash\value\as\atom)
            name: l2_next_active(slash\next)
            if: name = 0 || name\value = 0 || name\value\kind != c.LM_P0_NODE_ATOM
                return: 2
            oi: l2_path_own(mi, f\value\as\atom, name\value\as\atom)
            bracket: l2_next_active(name\next)
            if: bracket != 0 && bracket\value != 0 && bracket\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(bracket\value\as\atom, "[")
                if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0
                    return: 2
            ---
            if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0
                return: 1
            f: name
            \out_count: 6
    ---
    if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0
        return: 1
    bracket: l2_next_active(f\next)
    if: bracket = 0 || bracket\value = 0 || bracket\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(bracket\value\as\atom, "[") = 0
        return: 1
    if: l2_index_tail(f, @ index_field, out_after) != 0
        return: 2
    after: \out_after
    if: after != 0 && after\value != 0 && after\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(after\value\as\atom, "[")
        return: 2
    if: index_field\value\kind != c.LM_P0_NODE_ATOM
        return: 2
    if: l2_array_literal(oi, index_field\value\as\atom, 0U, index_field\value\as\atom\length, out_index) != 0
        return: 2
    \out_own: oi
return: 0

# length() consumes a known own-array reference without exposing that reference.
# A declared method called length takes precedence at the normal resolver.
fn: l2_array_length_own (const: @(LmP0Node node); int: mi) int
    @: LmP0Field arg
    @: LmP0Field slash
    @: LmP0Field name
    int: count
    int: oi
    if: mi < 0 || l2_frame_head(node, "length") = 0
        return: -1
    if: node\as\frame\trailer != 0 || node\as\frame\body = 0
        return: -1
    if: node\as\frame\body\trailer != 0
        return: -1
    arg: l2_next_active(node\as\frame\body\first_field)
    if: arg = 0 || arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: -1
    count: l2_count_active(node\as\frame\body)
    oi: -1
    if: count = 1
        oi: l2_own_find(mi, arg\value\as\atom)
    if: count = 3 && (l2_text_eq(arg\value\as\atom, "for") || l2_text_eq(arg\value\as\atom, "node"))
        slash: l2_next_active(arg\next)
        name: l2_next_active(slash\next)
        if: slash\value = 0 || slash\value\kind != c.LM_P0_NODE_ATOM || l2_is_slash(slash\value\as\atom) = 0
            return: -1
        if: name = 0 || name\value = 0 || name\value\kind != c.LM_P0_NODE_ATOM
            return: -1
        oi: l2_path_own(mi, arg\value\as\atom, name\value\as\atom)
    if: oi < 0
        return: -1
    if: l2_own_is_array(l2_own_ty[oi]) = 0 || l2_own_count[oi] = 0
        return: -1
return: oi

# This bootstrap admits only positive decimal extents, never the empty ABI.
fn: l2_positive_decimal (const: @(LmP0Text t)) size_t
    size_t: n 0U
    size_t: i 0U
    size_t: digit
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0U
    while: i < t\length
        if: t\data[i] < 48 || t\data[i] > 57
            return: 0U
        digit: (cast: (size_t) (t\data[i] - 48))
        if: n > (((cast: (size_t) -1) - digit) / 10U)
            return: 0U
        n: n * 10U + digit
        i: i + 1U
    ---
    return: n

# Value of a size_t literal as written, INCLUDING the U suffix that l2_num
# accepts. l2_positive_decimal refuses any non-digit and therefore returns 0
# for "3U", which silently stored zero in every qualified branch and every
# merge body field until a content check caught it.
fn: l2_literal_value (const: @(LmP0Text t)) size_t
    size_t: n 0U
    size_t: i 0U
    size_t: stop
    size_t: digit
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0U
    stop: t\length
    if: t\data[stop - 1U] = 85 || t\data[stop - 1U] = 117
        stop: stop - 1U
    if: stop = 0U
        return: 0U
    while: i < stop
        if: t\data[i] < 48 || t\data[i] > 57
            return: 0U
        digit: (cast: (size_t) (t\data[i] - 48))
        if: n > (((cast: (size_t) -1) - digit) / 10U)
            return: 0U
        n: n * 10U + digit
        i: i + 1U
    ---
return: n

fn: l2_array_count_is (const: @(LmP0Text t)) int
    if: l2_num(t) = 0
        return: 0
    # l2_literal_value returns zero for both the valid empty extent and an
    # overflow. l2_num rejects leading zeroes, so only 0/0U/0u may use zero.
    if: l2_literal_value(t) != 0U
        return: 1
    if: t != 0 && t\data != 0 && t\data[0] = 48
        return: 1
return: 0

fn: l2_own_array_count (const: @(LmP0Node stmt)) @: LmP0Text
    @: LmP0Field f
    if: l2_frame_head(stmt, "[]") = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 3 || stmt\as\frame\trailer != 0 || stmt\as\frame\body\trailer != 0
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0
        return: 0
    if: f\value\kind = c.LM_P0_NODE_ATOM
        if: l2_text_eq(f\value\as\atom, "int") = 0 && l2_text_eq(f\value\as\atom, "char") = 0 && l2_text_eq(f\value\as\atom, "size_t") = 0 && l2_text_eq(f\value\as\atom, "ulong") = 0 && l2_include_has_simple_typedef(f\value\as\atom) != 8
            return: 0
        ---
    else:
        if: l2_own_array_pointer_ty(stmt) = 0
            return: 0
        ---
    f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: 0
    f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_array_count_is(f\value\as\atom) != 0
        return: f\value\as\atom
return: l2_define_count(f\value\as\atom)

fn: l2_own_array_pointer_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    @: LmP0Field inner
    const: @: LmP0Node wrapper
    const: @: LmP0Node ptr
    int: depth
    if: l2_frame_head(stmt, "[]") = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0 || l2_count_active(f\value\as\structure) != 1
        return: 0
    inner: l2_next_active(f\value\as\structure\first_field)
    if: inner = 0 || inner\value = 0
        return: 0
    wrapper: inner\value
    ptr: wrapper
    if: wrapper\kind != c.LM_P0_NODE_FRAME || wrapper\as = 0 || wrapper\as\frame = 0
        return: 0
    depth: l2_address_depth(wrapper\as\frame\head)
    if: depth = 0
        return: 0
    if: ptr\as = 0 || ptr\as\frame = 0 || ptr\as\frame\body = 0 || l2_count_active(ptr\as\frame\body) != 1
        return: 0
    f: l2_next_active(ptr\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: depth = 1 && l2_text_eq(f\value\as\atom, "char")
        return: 12
    if: depth = 1 && l2_text_eq(f\value\as\atom, "size_t")
        return: 9
    if: depth = 1 && l2_text_eq(f\value\as\atom, "int")
        return: 11
    if: depth = 1 && l2_text_eq(f\value\as\atom, "void")
        return: 16
    if: depth = 1 && l2_text_eq(f\value\as\atom, "unsigned")
        return: 25
    if: depth = 1 && l2_text_eq(f\value\as\atom, "ulong")
        return: 38
    if: depth = 2 && l2_text_eq(f\value\as\atom, "char")
        return: 17
    if: depth = 2 && l2_text_eq(f\value\as\atom, "size_t")
        return: 20
    if: depth = 2 && l2_text_eq(f\value\as\atom, "int")
        return: 19
    if: depth = 2 && l2_text_eq(f\value\as\atom, "void")
        return: 18
    if: depth = 2 && l2_text_eq(f\value\as\atom, "unsigned")
        return: 24
    if: depth = 2 && l2_text_eq(f\value\as\atom, "ulong")
        return: 39
return: l2_foreign_intern(f\value\as\atom, depth, 0)

fn: l2_own_decl_name (const: @(LmP0Node stmt)) @: LmP0Text
    @: LmP0Field f l2_next_active(stmt\as\frame\body\first_field)
    if: l2_frame_head(stmt, "[]")
        f: l2_next_active(f\next)
    return: f\value\as\atom

# A by-value local of a language numeric type (spec 6.6) is a Message-owned cell;
# a type whose owned domain is not implemented yet is refused by name, never
# emitted as activation C storage (e2 ruling 2026-09-14, model §21).
fn: l2_unimpl_numeric (const: @(LmP0Node stmt)) const: @: char
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: (stmt\as\frame\flags & c.LM_P0_FRAME_COMPACT) != 0U
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 1 && l2_count_active(stmt\as\frame\body) != 2
        return: 0
    if: l2_frame_head(stmt, "float")
        return: "by-value float local not yet implemented"
    if: l2_frame_head(stmt, "double")
        return: "by-value double local not yet implemented"
    if: l2_frame_head(stmt, "long")
        return: "by-value long local not yet implemented"
    if: l2_frame_head(stmt, "llong")
        return: "by-value llong local not yet implemented"
    if: l2_frame_head(stmt, "ullong")
        return: "by-value ullong local not yet implemented"
    if: l2_frame_head(stmt, "uint")
        return: "by-value uint local not yet implemented"
    if: l2_frame_head(stmt, "u8") || l2_frame_head(stmt, "u16") || l2_frame_head(stmt, "u32") || l2_frame_head(stmt, "u64")
        return: "by-value unsigned fixed-width local not yet implemented"
    if: l2_frame_head(stmt, "i8") || l2_frame_head(stmt, "i16") || l2_frame_head(stmt, "i32") || l2_frame_head(stmt, "i64")
        return: "by-value signed fixed-width local not yet implemented"
    if: l2_frame_head(stmt, "wchar_t")
        return: "by-value wchar_t local not yet implemented"
return: 0

fn: l2_own_decl_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    int: ty 0
    int: n
    if: l2_own_array_count(stmt) != 0
        ty: l2_own_array_pointer_ty(stmt)
        if: ty > 0
            return: 2000 + ty
        f: l2_next_active(stmt\as\frame\body\first_field)
        if: l2_text_eq(f\value\as\atom, "int")
            return: 4
        if: l2_text_eq(f\value\as\atom, "char")
            return: 5
        if: l2_text_eq(f\value\as\atom, "size_t")
            return: 7
        if: l2_text_eq(f\value\as\atom, "ulong")
            return: 37
        return: 8
    if: l2_frame_head(stmt, "char")
        ty: 1
    if: l2_frame_head(stmt, "size_t")
        ty: 2
    if: l2_frame_head(stmt, "int")
        ty: 3
    if: l2_frame_head(stmt, "unsigned")
        ty: 6
    if: l2_frame_head(stmt, "ulong")
        ty: 36
    if: ty = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: n != 1 && n != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_ident(f\value\as\atom) = 0
        return: 0
return: ty

# Unit-level pointer variables are graph fields as well. Keep their frontend
# ABI type separate from the small scalar/Array own codes: 1000 + the exact
# pointer code returned by the ordinary local declarator parser. This preserves
# pointee, depth and const qualification without treating every ty>=4 as Array.
fn: l2_unit_decl_ty (const: @(LmP0Node stmt)) int
    @: LmP0Text name 0
    int: ty 0
    int: own_ty l2_own_decl_ty(stmt)
    if: own_ty != 0
        return: own_ty
    if: l2_ptr_local_ty(stmt, @ name, @ ty) = 0
        return: 1000 + ty
    if: l2_const_local_ty(stmt, @ name, @ ty) = 0
        return: 1000 + ty
return: 0

fn: l2_unit_decl_name (const: @(LmP0Node stmt)) @: LmP0Text
    @: LmP0Text name 0
    int: ty 0
    if: l2_own_decl_ty(stmt) != 0
        return: l2_own_decl_name(stmt)
    if: l2_ptr_local_ty(stmt, @ name, @ ty) = 0
        return: name
    if: l2_const_local_ty(stmt, @ name, @ ty) = 0
        return: name
return: 0

fn: l2_own_is_array (int: ty) int
    if: ty = 4 || ty = 5 || ty = 7 || ty = 8 || ty = 37 || ty >= 2000
        return: 1
return: 0

fn: l2_own_is_pointer (int: ty) int
    if: ty >= 1000 && ty < 2000
        return: 1
return: 0

fn: l2_emit_raw_pointer_type (@: FILE out; int: raw; int: extra_depth) int
    int: fi raw - 100
    int: depth
    int: is_const 0
    const: @(char base) 0
    if: out = 0 || extra_depth < 0
        return: 1
    if: raw = 3
        base: "char"
        depth: 1
        is_const: 1
    if: raw = 21
        base: "LmP0Diagnostic"
        depth: 1
        is_const: 1
    if: raw = 29
        base: "LmxMsg"
        depth: 1
        is_const: 1
    if: raw = 9
        base: "size_t"
        depth: 1
    if: raw = 11
        base: "int"
        depth: 1
    if: raw = 12
        base: "char"
        depth: 1
    if: raw = 13
        base: "LmP0Document"
        depth: 1
    if: raw = 16
        base: "void"
        depth: 1
    if: raw = 23
        base: "FILE"
        depth: 1
    if: raw = 25
        base: "unsigned"
        depth: 1
    if: raw = 38
        base: "ulong"
        depth: 1
    if: raw = 17
        base: "char"
        depth: 2
    if: raw = 18
        base: "void"
        depth: 2
    if: raw = 19
        base: "int"
        depth: 2
    if: raw = 20
        base: "size_t"
        depth: 2
    if: raw = 24
        base: "unsigned"
        depth: 2
    if: raw = 39
        base: "ulong"
        depth: 2
    if: raw >= 100
        if: fi < 0 || fi >= l2_foreign_n
            return: 1
        depth: l2_foreign_depth[fi]
        is_const: l2_foreign_const[fi]
    ---
    if: depth < 1
        return: 1
    depth: depth + extra_depth
    if: depth < 1
        return: 1
    if: is_const != 0 && c.fputs("const: ", out) < 0
        return: 1
    if: l2_emit_address_marks(out, depth) != 0
        return: 1
    if: is_const != 0
        if: c.fputs("(", out) < 0
            return: 1
        ---
    else:
        if: c.fputs(": ", out) < 0
            return: 1
    ---
    if: raw >= 100
        if: l2_write_text(out, l2_foreign_name[fi]) != 0
            return: 1
        ---
    else:
        if: c.fputs(base, out) < 0
            return: 1
    ---
    if: is_const != 0 && c.fputs(")", out) < 0
        return: 1
return: 0

fn: l2_emit_own_pointer_type (@: FILE out; int: ty) int
    if: ty < 1000 || ty >= 2000
        return: 1
return: l2_emit_raw_pointer_type(out, ty - 1000, 0)

# A const declarator keeps its name inside const: @(...).  Type-only spelling
# is correct in casts and returns, but appending a name after the closing ')'
# would produce invalid L1.  Emit the complete generated cache declaration.
fn: l2_emit_own_pointer_temp_decl (@: FILE out; int: ty; const: @(char ind); int: temp) int
    int: raw ty - 1000
    int: fi raw - 100
    int: depth
    int: is_const 0
    const: @(char base) 0
    if: out = 0 || ind = 0 || ty < 1000 || ty >= 2000
        return: 1
    if: raw = 3
        base: "char"
        depth: 1
        is_const: 1
    if: raw = 21
        base: "LmP0Diagnostic"
        depth: 1
        is_const: 1
    if: raw = 29
        base: "LmxMsg"
        depth: 1
        is_const: 1
    if: raw = 9
        base: "size_t"
        depth: 1
    if: raw = 11
        base: "int"
        depth: 1
    if: raw = 12
        base: "char"
        depth: 1
    if: raw = 13
        base: "LmP0Document"
        depth: 1
    if: raw = 16
        base: "void"
        depth: 1
    if: raw = 23
        base: "FILE"
        depth: 1
    if: raw = 25
        base: "unsigned"
        depth: 1
    if: raw = 38
        base: "ulong"
        depth: 1
    if: raw = 17
        base: "char"
        depth: 2
    if: raw = 18
        base: "void"
        depth: 2
    if: raw = 19
        base: "int"
        depth: 2
    if: raw = 20
        base: "size_t"
        depth: 2
    if: raw = 24
        base: "unsigned"
        depth: 2
    if: raw = 39
        base: "ulong"
        depth: 2
    if: raw >= 100
        if: fi < 0 || fi >= l2_foreign_n
            return: 1
        depth: l2_foreign_depth[fi]
        is_const: l2_foreign_const[fi]
    ---
    if: depth < 1 || c.fputs(ind, out) < 0
        return: 1
    if: is_const != 0 && c.fputs("const: ", out) < 0
        return: 1
    if: l2_emit_address_marks(out, depth) != 0
        return: 1
    if: is_const != 0
        if: c.fputs("(", out) < 0
            return: 1
        ---
    else:
        if: c.fputs(": ", out) < 0
            return: 1
        ---
    ---
    if: raw >= 100
        if: l2_write_text(out, l2_foreign_name[fi]) != 0
            return: 1
        ---
    else:
        if: c.fputs(base, out) < 0
            return: 1
        ---
    ---
    if: c.fprintf(out, " l2_q%d", temp) < 0
        return: 1
    if: is_const != 0 && c.fputs(")", out) < 0
        return: 1
return: c.fputs("\n", out) < 0

# Type of Array<@^n T>.data is @^(n+1) T. The extra level is the address of
# the contiguous element backing, not a replacement void** representation.
fn: l2_emit_own_pointer_array_data_type (@: FILE out; int: ty) int
    if: ty < 2000
        return: 1
return: l2_emit_raw_pointer_type(out, ty - 2000, 1)

fn: l2_own_store_ty (int: dty) int
    if: dty = 3
        return: 0
    if: dty = 6
        return: 3
return: dty

# Unit declarations are ordinary fields of the program Structure.  The
# existing shared-own layout already reserves their child slots; this reader
# makes that dormant path reachable from source syntax.
fn: l2_take_unit_own (const: @(LmP0Node stmt); const: @(char path)) int
    int: dty l2_unit_decl_ty(stmt)
    int: oi
    @: LmP0Text name
    @: LmP0Field init
    int: cv
    if: dty = 0
        return: l2_error(path, stmt, "unsupported unit field")
    name: l2_unit_decl_name(stmt)
    if: l2_own_shared(name) >= 0
        return: l2_error(path, stmt, "duplicate unit field")
    if: l2_find_method(name) >= 0
        return: l2_error(path, stmt, "unit field collides with a method")
    if: l2_ns_find(name) >= 0 || l2_ebr_find(name) >= 0
        return: l2_error(path, stmt, "unit field collides with a named Structure")
    if: l2_own_is_pointer(dty) != 0
        # Hosted pointer fields start null. A non-null foreign/resource value
        # needs an explicit operation that can state its lifetime/copy policy.
        if: l2_frame_head(stmt, "const") = 0 && l2_count_active(stmt\as\frame\body) = 3
            init: l2_next_active(stmt\as\frame\body\first_field)
            init: l2_next_active(init\next)
            init: l2_next_active(init\next)
            if: init = 0 || init\value = 0 || init\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(init\value\as\atom, "0") = 0
                return: l2_error(path, stmt, "pointer unit field initializer must be null")
            ---
        ---
        if: l2_frame_head(stmt, "const") != 0
            init: l2_next_active(stmt\as\frame\body\first_field)
            if: init != 0 && init\value != 0 && init\value\as != 0 && init\value\as\frame != 0 && init\value\as\frame\body != 0 && l2_count_active(init\value\as\frame\body) = 3
                init: l2_next_active(init\value\as\frame\body\first_field)
                init: l2_next_active(init\next)
                init: l2_next_active(init\next)
                if: init = 0 || init\value = 0 || init\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(init\value\as\atom, "0") = 0
                    return: l2_error(path, stmt, "pointer unit field initializer must be null")
                ---
            ---
        ---
    else:
        if: dty != 4 && dty != 5 && dty != 7 && l2_count_active(stmt\as\frame\body) = 2
            init: l2_next_active(stmt\as\frame\body\first_field)
            init: l2_next_active(init\next)
            if: init = 0 || init\value = 0 || init\value\kind != c.LM_P0_NODE_ATOM
                return: l2_error(path, stmt, "unit field initializer must be a literal")
            if: dty = 1
                cv: l2_char_literal(init\value\as\atom)
                if: cv < 0
                    return: l2_error(path, stmt, "char field initializer must be a quoted byte")
                ---
            else:
                if: dty = 3 && l2_int_fits(init\value\as\atom) = 0
                    return: l2_error(path, stmt, "int field initializer is out of range")
                if: dty = 2 && l2_array_count_is(init\value\as\atom) = 0
                    return: l2_error(path, stmt, "numeric field initializer must be a literal")
                if: dty = 6 && (l2_array_count_is(init\value\as\atom) = 0 || l2_literal_value(init\value\as\atom) > (cast: (size_t) (cast: (unsigned) -1)))
                    return: l2_error(path, stmt, "unsigned field initializer is out of range")
                if: dty = 36 && l2_array_count_is(init\value\as\atom) = 0
                    return: l2_error(path, stmt, "ulong field initializer must be a literal")
                ---
            ---
        ---
    ---
    oi: l2_own_add(0, name, l2_own_store_ty(dty), path, stmt, 1)
    if: oi < 0
        return: 1
    if: l2_own_is_array(dty) != 0
        if: l2_own_count[oi] != 0
            return: l2_error(path, stmt, "duplicate own array declaration")
        l2_own_count[oi]: l2_own_array_count(stmt)
    ---
return: 0

fn: l2_unit_own_init (int: oi) size_t
    @: LmP0Node stmt
    @: LmP0Field f
    int: cv
    if: oi < 0 || oi >= l2_own_n || l2_own_decl = 0
        return: 0U
    stmt: l2_own_decl[oi]
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) != 2
        return: 0U
    f: l2_next_active(stmt\as\frame\body\first_field)
    f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0U
    if: l2_own_ty[oi] = 1
        cv: l2_char_literal(f\value\as\atom)
        if: cv >= 0
            return: (cast: (size_t) cv)
        return: 0U
    ---
return: l2_literal_value(f\value\as\atom)

fn: l2_scope_free () int
    if: l2_scope_at != 0
        l2_xfree((cast: (@: void) l2_scope_at))
    l2_scope_at: 0
    l2_scope_n: 0
    l2_scope_cap: 0
return: 0

# Emitted indentation strings are translation-owned scratch values. Keep every
# returned pointer stable until the unit is finished; the table and strings grow
# from the actual nesting encountered rather than imposing a language depth.
fn: l2_indent_free () int
    int: i 0
    while: i < l2_indent_n
        if: l2_indent_at[i] != 0
            l2_xfree((cast: (@: void) l2_indent_at[i]))
        i: i + 1
    if: l2_indent_at != 0
        l2_xfree((cast: (@: void) l2_indent_at))
    l2_indent_at: 0
    l2_indent_n: 0
    l2_indent_cap: 0
return: 0

fn: l2_indent_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    @@: char nn 0
    int: i 0
    if: need < 0
        l2_alloc_err: 2
        return: 1
    if: need <= l2_indent_cap
        return: 0
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_indent_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) c.INT_MAX) / 2U)
            cap: need_u
        else:
            cap: cap * 2U
        ---
    if: cap > (cast: (size_t) c.INT_MAX)
        l2_alloc_err: 2
        return: 1
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    l2_alloc_kind: 8
    nn: (cast: (@@: char) l2_xmalloc(nb))
    if: nn = 0
        return: 1
    c.memset((cast: (@: void) nn), 0, nb)
    while: i < l2_indent_n
        nn[i]: l2_indent_at[i]
        i: i + 1
    if: l2_indent_at != 0
        l2_xfree((cast: (@: void) l2_indent_at))
    l2_indent_at: nn
    l2_indent_cap: (cast: (int) cap)
return: 0

fn: l2_pub_free () int
    if: l2_pub_tmp != 0
        l2_xfree((cast: (@: void) l2_pub_tmp))
    if: l2_pub_bak != 0
        l2_xfree((cast: (@: void) l2_pub_bak))
    l2_pub_tmp: 0
    l2_pub_bak: 0
    l2_pub_bak_cap: 0U
return: 0

# Publication filenames grow from the actual destination path. The decimal
# suffix bound is derived from size_t width (three decimal digits per byte is
# safely above log10(256)); it is not a count of allowed backup candidates.
fn: l2_pub_prepare (const: @(char out_path)) int
    size_t: pn
    size_t: tmp_n
    size_t: bak_extra
    size_t: bak_n
    @: char nt 0
    @: char nb 0
    if: out_path = 0
        return: 1
    pn: c.strlen(out_path)
    if: pn > ((cast: (size_t) -1) - 5U)
        l2_alloc_err: 2
        return: 1
    tmp_n: pn + 5U
    if: c.sizeof(c.size_t) > (((cast: (size_t) -1) - 6U) / 3U)
        l2_alloc_err: 2
        return: 1
    bak_extra: 6U + c.sizeof(c.size_t) * 3U
    if: pn > ((cast: (size_t) -1) - bak_extra)
        l2_alloc_err: 2
        return: 1
    bak_n: pn + bak_extra
    l2_alloc_kind: 9
    nt: (cast: (@: char) l2_xmalloc(tmp_n))
    nb: (cast: (@: char) l2_xmalloc(bak_n))
    if: nt = 0 || nb = 0
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        if: nb != 0
            l2_xfree((cast: (@: void) nb))
        return: 1
    c.memcpy(nt, out_path, pn)
    nt[pn]: 46
    nt[pn + 1U]: 116
    nt[pn + 2U]: 109
    nt[pn + 3U]: 112
    nt[pn + 4U]: 0
    c.memcpy(nb, out_path, pn)
    nb[pn]: 46
    nb[pn + 1U]: 98
    nb[pn + 2U]: 97
    nb[pn + 3U]: 107
    nb[pn + 4U]: 0
    l2_pub_tmp: nt
    l2_pub_bak: nb
    l2_pub_bak_cap: bak_n
return: 0

fn: l2_scope_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    @@: LmP0Node nn 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_scope_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_scope_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    if: nn = 0
        return: 1
    c.memset((cast: (@: void) nn), 0, nb)
    i: 0
    while: i < l2_scope_n
        nn[i]: l2_scope_at[i]
        i: i + 1
    if: l2_scope_at != 0
        l2_xfree((cast: (@: void) l2_scope_at))
    l2_scope_at: nn
    l2_scope_cap: (cast: (int) cap)
return: 0

fn: l2_scope_push (const: @(LmP0Node node)) int
    if: node = 0
        return: 1
    if: l2_scope_reserve(l2_scope_n + 1) != 0
        return: 1
    l2_scope_at[l2_scope_n]: (cast: (@: LmP0Node) node)
    l2_scope_n: l2_scope_n + 1
return: 0

fn: l2_scope_pop () int
    if: l2_scope_n <= 0
        return: 1
    l2_scope_n: l2_scope_n - 1
    l2_scope_at[l2_scope_n]: 0
return: 0

fn: l2_scope_has (const: @(LmP0Node node)) int
    int: i 0
    if: node = 0
        return: 0
    while: i < l2_scope_n
        if: l2_scope_at[i] = node
            return: 1
        i: i + 1
return: 0

fn: l2_scope_host () @: LmP0Node
    if: l2_scope_n <= 0
        return: 0
return: l2_scope_at[l2_scope_n - 1]

fn: l2_for_free () int
    if: l2_for_node != 0
        l2_xfree((cast: (@: void) l2_for_node))
    if: l2_for_uchild != 0
        l2_xfree((cast: (@: void) l2_for_uchild))
    if: l2_for_nkid != 0
        l2_xfree((cast: (@: void) l2_for_nkid))
    if: l2_for_mi != 0
        l2_xfree((cast: (@: void) l2_for_mi))
    if: l2_for_parent != 0
        l2_xfree((cast: (@: void) l2_for_parent))
    l2_for_node: 0
    l2_for_uchild: 0
    l2_for_nkid: 0
    l2_for_mi: 0
    l2_for_parent: 0
    l2_for_n: 0
    l2_for_cap: 0
return: 0

fn: l2_for_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    size_t: ni
    @@: LmP0Node nn 0
    @: int nu 0
    @: int nk 0
    @: int nm 0
    @: int np 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_for_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_for_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nu: (cast: (@: int) l2_xmalloc(ni))
    nk: (cast: (@: int) l2_xmalloc(ni))
    nm: (cast: (@: int) l2_xmalloc(ni))
    np: (cast: (@: int) l2_xmalloc(ni))
    if: nn = 0 || nu = 0 || nk = 0 || nm = 0 || np = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nu != 0
            l2_xfree((cast: (@: void) nu))
        if: nk != 0
            l2_xfree((cast: (@: void) nk))
        if: nm != 0
            l2_xfree((cast: (@: void) nm))
        if: np != 0
            l2_xfree((cast: (@: void) np))
        return: 1
    c.memset((cast: (@: void) nn), 0, nb)
    i: 0
    while: i < (cast: (int) cap)
        nu[i]: -1
        nk[i]: 0
        nm[i]: -1
        np[i]: -1
        i: i + 1
    i: 0
    while: i < l2_for_n
        nn[i]: l2_for_node[i]
        nu[i]: l2_for_uchild[i]
        nk[i]: l2_for_nkid[i]
        nm[i]: l2_for_mi[i]
        np[i]: l2_for_parent[i]
        i: i + 1
    if: l2_for_node != 0
        l2_xfree((cast: (@: void) l2_for_node))
        l2_xfree((cast: (@: void) l2_for_uchild))
        l2_xfree((cast: (@: void) l2_for_nkid))
        l2_xfree((cast: (@: void) l2_for_mi))
        l2_xfree((cast: (@: void) l2_for_parent))
    l2_for_node: nn
    l2_for_uchild: nu
    l2_for_nkid: nk
    l2_for_mi: nm
    l2_for_parent: np
    l2_for_cap: (cast: (int) cap)
return: 0

fn: l2_for_find (const: @(LmP0Node node)) int
    int: i 0
    if: node = 0
        return: -1
    while: i < l2_for_n
        if: l2_for_node[i] = node
            return: i
        i: i + 1
return: -1

fn: l2_for_add (const: @(LmP0Node node); int: mi; int: parent) int
    int: i
    if: node = 0
        return: -1
    i: l2_for_find(node)
    if: i >= 0 && l2_for_mi[i] = mi && l2_for_parent[i] = parent
        return: i
    if: i >= 0
        return: -1
    if: l2_for_reserve(l2_for_n + 1) != 0
        return: -1
    l2_for_node[l2_for_n]: (cast: (@: LmP0Node) node)
    l2_for_uchild[l2_for_n]: -1
    l2_for_nkid[l2_for_n]: 0
    l2_for_mi[l2_for_n]: mi
    l2_for_parent[l2_for_n]: parent
    l2_for_n: l2_for_n + 1
return: l2_for_n - 1

# Discover executable control bodies independently from declaration analysis.
# This also covers the source main body, whose ordinary C locals are not own
# graph fields. The P0 node is only the translator's identity for the body;
# the emitted value is always an ordinary Lmx Structure.
fn: l2_collect_body_hosts (const: @(LmP0Structure body); int: mi) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    int: n
    int: k
    int: fid
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: l2_frame_head(stmt, "if")
            n: l2_count_active(stmt\as\frame\body)
            last: l2_next_active(stmt\as\frame\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: 1
            fid: l2_for_add(last\value, mi, l2_for_find(l2_scope_host()))
            if: fid < 0 || l2_scope_push(last\value) != 0
                return: 1
            if: l2_collect_body_hosts(last\value\as\structure, mi) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                if: nxt\value\as = 0 || nxt\value\as\frame = 0 || nxt\value\as\frame\body = 0
                    return: 1
                fid: l2_for_add(nxt\value, mi, l2_for_find(l2_scope_host()))
                if: fid < 0 || l2_scope_push(nxt\value) != 0
                    return: 1
                if: l2_collect_body_hosts(nxt\value\as\frame\body, mi) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            continue
        if: l2_frame_head(stmt, "while")
            n: l2_count_active(stmt\as\frame\body)
            last: l2_next_active(stmt\as\frame\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: 1
            fid: l2_for_add(last\value, mi, l2_for_find(l2_scope_host()))
            if: fid < 0 || l2_scope_push(last\value) != 0
                return: 1
            if: l2_collect_body_hosts(last\value\as\structure, mi) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for") && l2_for_cstyle(stmt)
            last: l2_next_active(stmt\as\frame\body\first_field)
            k: 1
            while: k < 5
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: 1
            fid: l2_for_add(stmt, mi, l2_for_find(l2_scope_host()))
            if: fid < 0 || l2_scope_push(stmt) != 0
                return: 1
            if: l2_collect_body_hosts(last\value\as\structure, mi) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# Child index of own field oi inside its own method's Structure M. Slot 0 of M
# is the shared METHOD descriptor, so method-owned fields start at 1. Counts the
# earlier unhosted own fields of the same method; no extra per-method table.
fn: l2_own_mslot (int: oi) int
    int: k 0
    int: n 1
    while: k < oi
        if: l2_own_host[k] = 0 && l2_own_mi[k] = l2_own_mi[oi]
            n: n + 1
        k: k + 1
    ---
return: n

# Which Structure holds own field oi in the code being emitted right now. A
# method's own field is a child of that method's own Structure, reached through
# the reserved argument; a shared own field stays a child of the program unit.
fn: l2_own_ctr (int: oi) const: @: char
    if: oi < 0 || oi >= l2_own_n || l2_own_mi[oi] < 0
        return: l2_unit_ref
    if: l2_own_mi[oi] = l2_cur_mi
        return: "node"
    if: c.sprintf(l2_ctr_buf, "lmx_branch_struct_known(%s, %uU)", l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_own_mi[oi]))) < 0
        return: l2_unit_ref
return: l2_ctr_buf

# Which method owns an executable control body, or -1 for one in the entry.
fn: l2_for_owner (int: k) int
    if: k >= 0 && k < l2_for_n
        return: l2_for_mi[k]
return: 0 - 1

# Unhosted own fields of a method: the children of M that follow slot 0.
fn: l2_m_own_count (int: mi) int
    int: i 0
    int: n 0
    while: i < l2_own_n
        if: l2_own_host[i] = 0 && l2_own_mi[i] = mi
            n: n + 1
        i: i + 1
    ---
return: n

# Executable control bodies owned by a method, and the rank of one among them.
fn: l2_m_for_count (int: mi) int
    int: k 0
    int: n 0
    while: k < l2_for_n
        if: l2_for_owner(k) = mi && l2_for_parent[k] < 0
            n: n + 1
        k: k + 1
    ---
return: n

fn: l2_for_rank (int: k) int
    int: i 0
    int: n 0
    while: i < k
        if: l2_for_owner(i) = l2_for_owner(k) && l2_for_parent[i] < 0
            n: n + 1
        i: i + 1
    ---
return: n

# Number of children M needs for method mi: slot 0 plus its unhosted own fields.
fn: l2_m_kids (int: mi) int
return: 1 + l2_m_own_count(mi) + l2_m_for_count(mi)

fn: l2_layout_owns () int
    int: oi 0
    int: fid
    int: uch 0
    while: oi < l2_for_n
        l2_for_nkid[oi]: 0
        oi: oi + 1
    oi: 0
    while: oi < l2_own_n
        if: l2_own_host[oi] = 0 && l2_own_mi[oi] < 0
            l2_own_fid[oi]: -1
            l2_own_fchild[oi]: -1
            l2_own_uchild[oi]: uch
            uch: uch + 1
        if: l2_own_host[oi] = 0 && l2_own_mi[oi] >= 0
            l2_own_fid[oi]: -1
            l2_own_fchild[oi]: -1
            l2_own_uchild[oi]: l2_own_mslot(oi)
        if: l2_own_host[oi] != 0
            fid: l2_for_find(l2_own_host[oi])
            if: fid < 0
                return: 1
            l2_own_fid[oi]: fid
            l2_own_fchild[oi]: l2_for_nkid[fid]
            l2_for_nkid[fid]: l2_for_nkid[fid] + 1
            l2_own_uchild[oi]: -1
        oi: oi + 1
    # A top-level control body becomes a child of its method Structure (or of
    # the entry unit). A nested body becomes a child of its containing body,
    # after that body's direct own fields. Discovery is preorder, so a parent
    # is always laid out before its descendants.
    oi: 0
    while: oi < l2_for_n
        if: l2_for_parent[oi] >= 0
            l2_for_uchild[oi]: l2_for_nkid[l2_for_parent[oi]]
            l2_for_nkid[l2_for_parent[oi]]: l2_for_nkid[l2_for_parent[oi]] + 1
        if: l2_for_parent[oi] < 0 && l2_for_owner(oi) < 0
            l2_for_uchild[oi]: uch
            uch: uch + 1
        if: l2_for_parent[oi] < 0 && l2_for_owner(oi) >= 0
            l2_for_uchild[oi]: 1 + l2_m_own_count(l2_for_owner(oi)) + l2_for_rank(oi)
        ---
        oi: oi + 1
    ---
    l2_unit_base: uch
return: 0

fn: l2_for_cstyle (const: @(LmP0Node stmt)) int
    @: LmP0Field f0
    @: LmP0Field f1
    @: LmP0Field f2
    @: LmP0Field f3
    @: LmP0Field f4
    if: l2_frame_head(stmt, "for") = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 5
        return: 0
    f0: l2_next_active(stmt\as\frame\body\first_field)
    if: f0 = 0
        return: 0
    f1: l2_next_active(f0\next)
    if: f1 = 0
        return: 0
    f2: l2_next_active(f1\next)
    if: f2 = 0
        return: 0
    f3: l2_next_active(f2\next)
    if: f3 = 0
        return: 0
    f4: l2_next_active(f3\next)
    if: f4 = 0
        return: 0
    if: l2_own_decl_ty(f0\value) != 3
        return: 0
    if: f1\value = 0 || f1\value\kind != c.LM_P0_NODE_STRUCTURE || f1\value\as = 0
        return: 0
    if: f2\value = 0 || f2\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f2\value\as\atom) = 0
        return: 0
    if: f3\value = 0 || f3\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_text_eq(f3\value\as\atom, "++") = 0 && l2_text_eq(f3\value\as\atom, "--") = 0
        return: 0
    if: f4\value = 0 || f4\value\kind != c.LM_P0_NODE_STRUCTURE || f4\value\as = 0
        return: 0
return: 1

fn: l2_path_own (int: mi; const: @(LmP0Text left); const: @(LmP0Text right)) int
    int: i 0
    int: hit
    int: for_path
    int: node_path
    hit: -1
    for_path: 0
    node_path: 0
    if: mi < 0 || left = 0 || right = 0
        return: -1
    if: l2_text_eq(left, "for") != 0
        for_path: 1
    if: l2_text_eq(left, "node") != 0
        node_path: 1
    if: for_path = 0 && node_path = 0
        return: -1
    while: i < l2_own_n
        if: for_path != 0 && l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], right) && l2_own_host[i] != 0 && l2_frame_head(l2_own_host[i], "for") && hit >= 0
            return: -1
        if: for_path != 0 && l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], right) && l2_own_host[i] != 0 && l2_frame_head(l2_own_host[i], "for")
            hit: i
        if: node_path != 0 && l2_own_mi[i] = mi && l2_own_host[i] = 0 && l2_text_same(l2_own_name[i], right) && hit >= 0
            return: -1
        if: node_path != 0 && l2_own_mi[i] = mi && l2_own_host[i] = 0 && l2_text_same(l2_own_name[i], right)
            hit: i
        i: i + 1
return: hit

fn: l2_slot_decl_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    @: LmP0Field g
    if: l2_frame_head(stmt, "@") = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_ident(g\value\as\atom) = 0
        return: 0
    if: l2_text_eq(f\value\as\atom, "char")
        return: 3
    if: l2_text_eq(f\value\as\atom, "LmP0Text")
        return: 5
    if: l2_text_eq(f\value\as\atom, "size_t")
        return: 9
    if: l2_text_eq(f\value\as\atom, "LmP0IndentStack")
        l2_need_p0: 1
        return: 14
return: 0

fn: l2_slot_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_sn[mi]
        if: l2_text_same(l2_sn[l2_slot_off(mi, i)], t)
            return: i
        i: i + 1
return: -1

fn: l2_is_char_decl (const: @(LmP0Node stmt)) int
    if: l2_own_decl_ty(stmt) != 0
        return: 1
    if: l2_slot_decl_ty(stmt) != 0
        return: 1
return: 0

fn: l2_is_plus (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "+") || l2_text_eq(t, "/") || l2_text_eq(t, "-") || l2_text_eq(t, "*") || l2_text_eq(t, "%")
        return: 1
    if: l2_text_eq(t, "&") || l2_text_eq(t, "|") || l2_text_eq(t, "<<") || l2_text_eq(t, ">>")
        return: 1
return: 0

fn: l2_is_cmp (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "<") || l2_text_eq(t, ">") || l2_text_eq(t, "=") || l2_text_eq(t, "!=") || l2_text_eq(t, "<=") || l2_text_eq(t, ">=")
        return: 1
return: 0

fn: l2_is_andor (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "&&") || l2_text_eq(t, "||")
        return: 1
return: 0

fn: l2_is_brack (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "[") || l2_text_eq(t, "]")
        return: 1
return: 0

fn: l2_is_slash (const: @(LmP0Text t)) int
    if: t = 0 || t\length != 1U
        return: 0
    if: t\data[0] != 92
        return: 0
return: 1

# c.name is the explicit foreign door (spec 6.6.6): admitted as written, and the
# C compiler checks the declaration and the ABI. A bare name is an L2 call and
# resolves only against unit methods and parsed prototype: declarations. The
# includes a foreign name implies are emission needs, not admission.
fn: l2_is_known (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0
        return: 0
    # Emission needs, fail-open: a name that implies a support include or
    # adapter sets its flag whether or not it is admitted. An unknown name gets
    # no include and no diagnostic.
    if: l2_text_eq(t, "c.malloc") || l2_text_eq(t, "c.calloc") || l2_text_eq(t, "c.realloc") || l2_text_eq(t, "c.free") || l2_text_eq(t, "c.getenv") || l2_text_eq(t, "c.system")
        l2_need_stdlib: 1
    ---
    if: l2_text_eq(t, "c.strcmp") || l2_text_eq(t, "c.strlen") || l2_text_eq(t, "c.memcpy")
        l2_need_string: 1
    ---
    if: l2_text_eq(t, "c.lm_p0_set_diagnostic")
        l2_need_p0: 1
        l2_need_diag: 1
    ---
    # c.puts and c.array are statement forms with their own handling; they are
    # not generic calls and stay out of the call path.
    if: l2_text_eq(t, "c.puts") || l2_text_eq(t, "c.array")
        return: 0
    if: t\length > 2U && t\data[0] = 99 && t\data[1] = 46
        return: 1
    # The translator's own adapter families are LMX functions implemented in L1
    # (l1src/parser.lm1, l1src/own.lm1, l2src/l2_text_hash.lm1). Their
    # declarations are the adapter predefs the translator itself emits when it
    # sees them, so they resolve here as declared LMX names -- never as c.
    if: l2_text_eq(t, "lm_p0_parse_file") || l2_text_eq(t, "lm_p0_document_destroy") || l2_text_eq(t, "lm_p0_dump_alloc") || l2_text_eq(t, "lm_p0_free") || l2_text_eq(t, "lm_p0_document_diagnostic")
        l2_need_p0: 1
        return: 1
    if: l2_text_eq(t, "lm_own_new_zero") || l2_text_eq(t, "lm_own_copy_bytes") || l2_text_eq(t, "lm_own_delete") || l2_text_eq(t, "lm_own_resize") || l2_text_eq(t, "l2_immut_query_fill") || l2_text_eq(t, "l2_hash_compare_q")
        return: 1
    if: l2_predef_has_function(t) != 0
        return: 1
return: 0

# A c.name the generic C call lowers inside an expression. The forms excluded
# here have their own lowering: a type operand, an owned-text helper with a
# fixed emitted name, or a byte/Message operation with materialised operands.
fn: l2_c_door (const: @(LmP0Text t)) int
    if: l2_c_stmt_door(t) = 0
        return: 0
    if: l2_text_eq(t, "c.memset") || l2_text_eq(t, "c.memcpy") || l2_text_eq(t, "c.strlen") || l2_text_eq(t, "c.memcmp") || l2_text_eq(t, "c.lmx_msg_blocks_can_move") || l2_text_eq(t, "c.lmx_msg_blocks_move_all") || l2_text_eq(t, "c.lmx_owned_ranges_can_move") || l2_text_eq(t, "c.lmx_owned_ranges_move_all")
        return: 0
return: 1

# A c.name statement the generic C call lowers. c.sizeof, c.puts and c.array
# are forms with their own lowering.
fn: l2_c_stmt_door (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length <= 2U || t\data[0] != 99 || t\data[1] != 46
        return: 0
    if: l2_text_eq(t, "c.sizeof") || l2_text_eq(t, "c.puts") || l2_text_eq(t, "c.array")
        return: 0
return: 1

# Constants supplied by a predef C seam retain conventional uppercase
# spelling. They are compile-time names, not lexical graph dependencies; the
# downstream C compiler verifies that the included predef declares them.
fn: l2_upper_name (const: @(LmP0Text t)) int
    int: letter 0
    size_t: i 0U
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0
    while: i < t\length
        if: t\data[i] >= 65 && t\data[i] <= 90
            letter: 1
        if: (t\data[i] < 65 || t\data[i] > 90) && (t\data[i] < 48 || t\data[i] > 57) && t\data[i] != 95
            return: 0
        i: i + 1U
return: letter

fn: l2_is_binop (const: @(LmP0Text t)) int
    if: l2_is_plus(t) || l2_is_cmp(t) || l2_is_andor(t)
        return: 1
return: 0

fn: l2_node_has_call (const: @(LmP0Node node)) int
    @: LmP0Field f
    if: node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && (l2_find_method(node\as\frame\head) >= 0 || l2_is_known(node\as\frame\head))
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0
        return: l2_fields_has_call(node\as\frame\body\first_field, l2_count_active(node\as\frame\body))
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        return: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
return: 0

fn: l2_fields_has_call (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i
    f: l2_next_active(field)
    i: 0
    while: i < n && f != 0
        if: l2_node_has_call(f\value)
            return: 1
        f: l2_next_active(f\next)
        i: i + 1
return: 0

fn: l2_is_or_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "||")

fn: l2_is_and_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "&&")

fn: l2_advance (@: LmP0Field f; int: k) @: LmP0Field
    int: i 0
    while: i < k && f != 0
        f: l2_next_active(f\next)
        i: i + 1
return: f

fn: l2_span_or (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_or_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_span_and (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_and_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_bump_ind (const: @(char ind); @@: char dest) int
    size_t: ln
    size_t: need
    @: char made 0
    if: dest = 0 || ind = 0
        return: 1
    \dest: 0
    ln: c.strlen(ind)
    if: ln > ((cast: (size_t) -1) - 5U)
        l2_alloc_err: 2
        return: 1
    if: l2_indent_n = c.INT_MAX || l2_indent_reserve(l2_indent_n + 1) != 0
        return: 1
    need: ln + 5U
    l2_alloc_kind: 8
    made: (cast: (@: char) l2_xmalloc(need))
    if: made = 0
        return: 1
    c.memcpy(made, ind, ln)
    made[ln]: 32
    made[ln + 1U]: 32
    made[ln + 2U]: 32
    made[ln + 3U]: 32
    made[ln + 4U]: 0
    l2_indent_at[l2_indent_n]: made
    l2_indent_n: l2_indent_n + 1
    \dest: made
return: 0

fn: l2_new_temp (const: @(char ind); @: char dest) int
    int: t
    if: dest = 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_bool_set (const: @(char ind); const: @(char dest); const: @(char rhs)) int
    if: dest = 0 || rhs = 0 || ind = 0
        return: 1
    if: c.fprintf(l2_out, "%s%s: (%s) != 0\n", ind, dest, rhs) < 0
        return: 1
return: 0

fn: l2_eval_cond (@: LmP0Field field; int: n; int: mi; const: @(char ind); const: @(char dest)) int
    c.array: [256]: char scratch
    if: dest = 0
        return: 1
    scratch[0]: 0
    if: l2_eval_fields(field, n, mi, ind, scratch) != 0
        return: 1
return: l2_bool_set(ind, dest, scratch)

fn: l2_intern_prove (const: @(char path); const: @(LmP0Node node)) int
    unsigned: id
    int: two
    if: l2_mul3_ok(2U, 3U, 4U) = 0
        return: l2_error(path, node, "intern broken")
    if: l2_mul3_ok((cast: (size_t) -1), 2U, 1U) != 0
        return: l2_error(path, node, "intern broken")
    if: l2_m_n = 0
        return: 0
    id: l2_m_sig[0]
    l2_intern_again: l2_intern_mi(0)
    if: l2_intern_again = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: l2_intern_again = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: id = 0U || l2_intern_again != id
        return: l2_error(path, node, "intern broken")
    l2_intern_swap: 0U
    two: 0
    if: l2_m_arity[0] = 2 && l2_m_f0[0] != 0 && l2_m_f1[0] != 0
        two: 1
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0
        l2_intern_swap: l2_intern_pair(l2_m_f1[0]\data, l2_m_f1[0]\length, l2_m_f0[0]\data, l2_m_f0[0]\length)
    if: two != 0 && l2_intern_swap = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: two != 0 && l2_intern_swap = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0 && (l2_intern_swap = 0U || l2_intern_swap = id)
        return: l2_error(path, node, "intern failed to distinguish swapped formals")
    l2_intern_probe: l2_intern_pair("a", 1U, "b", 1U)
    if: l2_intern_probe = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: l2_intern_probe = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: l2_intern_probe = 0U
        return: l2_error(path, node, "intern broken")
    if: two != 0 && l2_text_eq(l2_m_f0[0], "a") && l2_text_eq(l2_m_f1[0], "b") && l2_ft(0, 0) = 0 && l2_intern_probe != id
        return: l2_error(path, node, "intern failed memcmp of equal names")
    if: two != 0 && (l2_text_eq(l2_m_f0[0], "a") = 0 || l2_text_eq(l2_m_f1[0], "b") = 0 || l2_ft(0, 0) != 0) && l2_intern_probe = id
        return: l2_error(path, node, "intern false-equal distinct contracts")
    l2_sigv: id
return: 0

fn: l2_ebr_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    size_t: nz
    @@: LmP0Text nn 0
    @@: LmP0Text nl 0
    @: size_t nv 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_ebr_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_ebr_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok(cap, psz) = 0 || l2_mul_ok(cap, c.sizeof(c.size_t)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    nz: cap * c.sizeof(c.size_t)
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nl: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nv: (cast: (@: size_t) l2_xmalloc(nz))
    if: nn = 0 || nl = 0 || nv = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nl != 0
            l2_xfree((cast: (@: void) nl))
        if: nv != 0
            l2_xfree((cast: (@: void) nv))
        return: 1
    c.memset((cast: (@: void) nn), 0, nb)
    c.memset((cast: (@: void) nl), 0, nb)
    c.memset((cast: (@: void) nv), 0, nz)
    i: 0
    while: i < l2_ebr_n
        nn[i]: l2_ebr_name[i]
        nl[i]: l2_ebr_leaf[i]
        nv[i]: l2_ebr_val[i]
        i: i + 1
    if: l2_ebr_name != 0
        l2_xfree((cast: (@: void) l2_ebr_name))
        l2_xfree((cast: (@: void) l2_ebr_leaf))
        l2_xfree((cast: (@: void) l2_ebr_val))
    l2_ebr_name: nn
    l2_ebr_leaf: nl
    l2_ebr_val: nv
    l2_ebr_cap: (cast: (int) cap)
return: 0

# Index of the qualified branch named by an atom, or -1. Qualified branches
# are the only NAMED Structures this subset has, so they are the only things
# a merge operand can currently spell.
fn: l2_ebr_find (const: @(LmP0Text t)) int
    int: i 0
    while: i < l2_ebr_n
        if: l2_text_same(l2_ebr_name[i], t)
            return: i
        i: i + 1
    ---
return: 0 - 1

# independent: const: immutable: (): E   with one size_t child, SPEC 9.1.1/9.1.3.
#
# The three receivers are right-nested ordinary receivers and all are required:
# independent alone builds a zero-rooted Structure with no retention, and const:
# immutable alone freezes a value without making it eternal, so neither grants
# the eternal sharing contract (SPEC 7237). independent qualifies STRUCTURE
# CONSTRUCTION, never a bare primitive, which is why the leaf must be "()".
#
# E gets two references, per SPEC 9.1.4: an ordinary declaration-site child of
# the unit graph, and an entry in the root retention array. Neither reparents
# it; E\node stays 0.
fn: l2_ns_find (const: @(LmP0Text t)) int
    int: i 0
    while: i < l2_ns_n
        if: l2_text_same(l2_ns_name[i], t)
            return: i
        i: i + 1
    ---
return: 0 - 1

# An otherwise unrecognized unit-level frame with a matching end is an ordinary
# named Structure. Reserved heads are matched before this is ever reached, so a
# malformed reserved construct stays an error rather than becoming a
# declaration. Fields are size_t literals in this slice.
# Grow every per-Structure table by one and return the new index, or -1.
fn: l2_ns_push (const: @(LmP0Text name); int: parent) int
    @@: LmP0Text gn
    @: int gi
    size_t: want (cast: (size_t) (l2_ns_n + 1))
    gn: (cast: (@@: LmP0Text) c.realloc((cast: (@: void) l2_ns_name), want * c.sizeof(@: void)))
    if: gn = 0
        return: 0 - 1
    l2_ns_name: gn
    gi: (cast: (@: int) c.realloc((cast: (@: void) l2_ns_first), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_first: gi
    gi: (cast: (@: int) c.realloc((cast: (@: void) l2_ns_count), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_count: gi
    gi: (cast: (@: int) c.realloc((cast: (@: void) l2_ns_parent), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_parent: gi
    gi: (cast: (@: int) c.realloc((cast: (@: void) l2_ns_eternal), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_eternal: gi
    l2_ns_name[l2_ns_n]: (cast: (@: LmP0Text) name)
    l2_ns_first[l2_ns_n]: 0
    l2_ns_count[l2_ns_n]: 0
    l2_ns_parent[l2_ns_n]: parent
    l2_ns_eternal[l2_ns_n]: 0 - 1
    l2_ns_n: l2_ns_n + 1
return: l2_ns_n - 1

# Grow every per-field table by one and return the new index, or -1.
fn: l2_nsf_push (int: kind; size_t: value; int: ref; int: owner) int
    @@: LmP0Text gt
    @: size_t gv
    @: int gi
    size_t: want (cast: (size_t) (l2_nsf_n + 1))
    gv: (cast: (@: size_t) c.realloc((cast: (@: void) l2_nsf_val), want * c.sizeof(c.size_t)))
    if: gv = 0
        return: 0 - 1
    l2_nsf_val: gv
    gi: (cast: (@: int) c.realloc((cast: (@: void) l2_nsf_kind), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_nsf_kind: gi
    gi: (cast: (@: int) c.realloc((cast: (@: void) l2_nsf_ref), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_nsf_ref: gi
    gt: (cast: (@@: LmP0Text) c.realloc((cast: (@: void) l2_nsf_name), want * c.sizeof(@: void)))
    if: gt = 0
        return: 0 - 1
    l2_nsf_name: gt
    gt: (cast: (@@: LmP0Text) c.realloc((cast: (@: void) l2_nsf_fname), want * c.sizeof(@: void)))
    if: gt = 0
        return: 0 - 1
    l2_nsf_fname: gt
    l2_nsf_val[l2_nsf_n]: value
    l2_nsf_kind[l2_nsf_n]: kind
    gi: (cast: (@: int) c.realloc((cast: (@: void) l2_nsf_owner), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_nsf_owner: gi
    l2_nsf_ref[l2_nsf_n]: ref
    l2_nsf_name[l2_nsf_n]: 0
    l2_nsf_fname[l2_nsf_n]: 0
    l2_nsf_owner[l2_nsf_n]: owner
    l2_nsf_n: l2_nsf_n + 1
return: l2_nsf_n - 1

# The value of a char literal written as an apostrophe-quoted single byte.
fn: l2_char_literal (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length != 3U
        return: 0 - 1
    if: t\data[0] != 39 || t\data[2] != 39
        return: 0 - 1
return: (cast: (int) (cast: (unsigned char) t\data[1]))

# One Structure body: registers the entry FIRST so its index precedes every
# nested entry, then reads the fields in source order. Fields are size_t and
# char literals, inline nested Structures built in place with this entry as
# their node, and references to an EARLIER named Structure shared by pointer.
fn: l2_take_ns_body (const: @(LmP0Text name); int: parent; const: @(LmP0Structure body); const: @(LmP0Node at); const: @(char path)) int
    @: LmP0Field f
    int: aty 0
    size_t: acount 0U
    @: LmP0Text fname 0
    @: LmP0Field g
    @: LmP0Node fld
    int: me
    int: sub_ix
    int: ref_ix
    int: count 0
    int: cval
    if: body = 0
        return: l2_error(path, at, "a named Structure needs at least one field")
    me: l2_ns_push(name, parent)
    if: me < 0
        return: l2_error(path, at, "out of memory")
    l2_ns_first[me]: l2_nsf_n
    f: l2_next_active(body\first_field)
    if: f = 0
        return: l2_error(path, at, "a named Structure needs at least one field")
    while: f != 0
        fld: f\value
        if: fld = 0 || fld\kind != c.LM_P0_NODE_FRAME || fld\as = 0 || fld\as\frame = 0 || fld\as\frame\body = 0
            return: l2_error(path, at, "unsupported named Structure field")
        g: l2_next_active(fld\as\frame\body\first_field)
        if: l2_frame_head(fld, "[]")
            # []: <int|char> <name> <count>, the same spelling an own array
            # uses. The record and its backing are two owned ranges; both
            # belong to the Structure that declares them.
            if: l2_count_active(fld\as\frame\body) != 3
                return: l2_error(path, at, "an array field needs a type, a name and a count")
            aty: 0 - 1
            if: l2_text_eq(g\value\as\atom, "int")
                aty: 0
            if: l2_text_eq(g\value\as\atom, "char")
                aty: 1
            if: aty < 0
                return: l2_error(path, at, "an array field element is int or char")
            g: l2_next_active(g\next)
            if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                return: l2_error(path, at, "an array field needs a name")
            fname: (cast: (@: LmP0Text) g\value\as\atom)
            g: l2_next_active(g\next)
            if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_array_count_is(g\value\as\atom) = 0
                return: l2_error(path, at, "an array field needs a count")
            acount: l2_literal_value(g\value\as\atom)
            if: l2_nsf_push(5, acount, aty, me) < 0
                return: l2_error(path, at, "out of memory")
            l2_nsf_fname[l2_nsf_n - 1]: fname
            l2_ns_has_array: 1
        else:
            if: l2_frame_head(fld, "size_t")
                if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                    return: l2_error(path, at, "a named Structure field needs a name")
                fname: (cast: (@: LmP0Text) g\value\as\atom)
                g: l2_next_active(g\next)
                if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_num(g\value\as\atom) = 0
                    return: l2_error(path, at, "a named Structure field needs a literal")
                if: l2_nsf_push(0, l2_literal_value(g\value\as\atom), 0 - 1, me) < 0
                    return: l2_error(path, at, "out of memory")
                l2_nsf_fname[l2_nsf_n - 1]: fname
                ---
            else:
                if: l2_frame_head(fld, "char")
                    if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                        return: l2_error(path, at, "a named Structure field needs a name")
                    fname: (cast: (@: LmP0Text) g\value\as\atom)
                    g: l2_next_active(g\next)
                    cval: 0 - 1
                    if: g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM
                        cval: l2_char_literal(g\value\as\atom)
                    if: cval < 0
                        return: l2_error(path, at, "a char field needs a quoted single character")
                    if: l2_nsf_push(1, (cast: (size_t) cval), 0 - 1, me) < 0
                        return: l2_error(path, at, "out of memory")
                    l2_nsf_fname[l2_nsf_n - 1]: fname
                    l2_ns_has_char: 1
                else:
                    if: l2_frame_head(fld, "fn")
                        # A CALLABLE field: the field NAME is the method name and its
                        # value is that method own Structure, whose slot 0 holds the
                        # shared METHOD descriptor. Resolved with the reference fields
                        # after the whole unit is read, since M may come later.
                        if: l2_count_active(fld\as\frame\body) != 1 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                            return: l2_error(path, at, "a callable field needs a method name")
                        if: l2_nsf_push(4, 0U, 0 - 1, me) < 0
                            return: l2_error(path, at, "out of memory")
                        l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                        l2_nsf_name[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                    else:
                        if: l2_frame_head(fld, "()")
                            # An inline nested Structure: (): name followed by its body block.
                            if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                                return: l2_error(path, at, "a nested Structure needs a name and a body")
                            if: l2_fn_close(fld\as\frame, g\value\as\atom, 0) != 0
                                return: l2_error(path, at, "end target does not match close target")
                            if: l2_nsf_push(2, 0U, 0, me) < 0
                                return: l2_error(path, at, "out of memory")
                            l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                            sub_ix: l2_nsf_n - 1
                            # The field slot is reserved before recursing, so field order is
                            # source order; the nested entry index is patched in after.
                            ref_ix: l2_ns_n
                            if: l2_take_ns_body((cast: (@: LmP0Text) g\value\as\atom), me, l2_next_active(g\next)\value\as\structure, fld, path) != 0
                                return: 1
                            l2_nsf_ref[sub_ix]: ref_ix
                        else:
                            # Name: field, a reference to another named Structure. The
                            # TARGET is not resolved here: it may not have been read yet,
                            # it may be this very declaration, or one enclosing it.
                            if: l2_count_active(fld\as\frame\body) != 1 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                                return: l2_error(path, at, "a Structure reference field needs a name")
                            if: l2_nsf_push(3, 0U, 0 - 1, me) < 0
                                return: l2_error(path, at, "out of memory")
                            l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                            l2_nsf_name[l2_nsf_n - 1]: (cast: (@: LmP0Text) fld\as\frame\head)
                            ---
                        ---
                    ---
            ---
        count: count + 1
        f: l2_next_active(f\next)
    ---
    l2_ns_count[me]: count
return: 0

# An otherwise unrecognized unit-level frame with a matching end is an ordinary
# named Structure. Reserved heads are matched before this is ever reached, so a
# malformed reserved construct stays an error rather than becoming a
# declaration.
# The METHOD index a callable field at one slot names, or -1. Kept separate
# from l2_ns_field_ref, which reports a declaration index: the two index
# different tables and must never be confused.
# The declaration entry that is the ROOT of one qualified branch, or -1.
fn: l2_ebr_root (int: k) int
    int: i 0
    while: i < l2_ns_n
        if: l2_ns_eternal[i] = k && l2_ns_parent[i] < 0
            return: i
        i: i + 1
    ---
return: 0 - 1

# The ELEMENT TYPE of an array field at one slot: 0 int, 1 char, -1 not an
# array. Separate accessor on purpose -- the ref column means a declaration
# index for a reference and a method index for a callable, and reading one as
# another is how child 4294967295 got emitted once.
# The declared element COUNT of an array field at one slot, or 0.
fn: l2_ns_field_len (int: ni; int: j) size_t
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && slotix = j && l2_nsf_kind[k] = 5
            return: l2_nsf_val[k]
        if: l2_nsf_owner[k] = ni && slotix = j
            return: 0U
        if: l2_nsf_owner[k] = ni
            slotix: slotix + 1
        k: k + 1
    ---
return: 0U

fn: l2_ns_field_elem (int: ni; int: j) int
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && slotix = j && l2_nsf_kind[k] = 5
            return: l2_nsf_ref[k]
        if: l2_nsf_owner[k] = ni && slotix = j
            return: 0 - 1
        if: l2_nsf_owner[k] = ni
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

fn: l2_ns_field_mi (int: ni; int: j) int
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && slotix = j && l2_nsf_kind[k] = 4
            return: l2_nsf_ref[k]
        if: l2_nsf_owner[k] = ni && slotix = j
            return: 0 - 1
        if: l2_nsf_owner[k] = ni
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

# Field KIND at one slot of a declaration, or -1.
fn: l2_ns_field_kind (int: ni; int: j) int
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && slotix = j
            return: l2_nsf_kind[k]
        if: l2_nsf_owner[k] = ni
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

# Slot index -> reference target for one declaration, or -1 when that slot is
# not a reference. Fields are selected by owner because the table is flat.
# Append one result-slot row. Kind -1 marks a slot with no source name.
fn: l2_mrs_push (int: res; const: @(LmP0Text name); int: kind; int: ent) int
    @@: LmP0Text gt
    @: int gi
    size_t: want (cast: (size_t) (l2_mrs_n + 1))
    gi: (cast: (@: int) c.realloc((cast: (@: void) l2_mrs_res), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_res: gi
    gi: (cast: (@: int) c.realloc((cast: (@: void) l2_mrs_kind), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_kind: gi
    gi: (cast: (@: int) c.realloc((cast: (@: void) l2_mrs_ent), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_ent: gi
    gt: (cast: (@@: LmP0Text) c.realloc((cast: (@: void) l2_mrs_name), want * c.sizeof(@: void)))
    if: gt = 0
        return: 0 - 1
    l2_mrs_name: gt
    l2_mrs_res[l2_mrs_n]: res
    l2_mrs_name[l2_mrs_n]: (cast: (@: LmP0Text) name)
    l2_mrs_kind[l2_mrs_n]: kind
    l2_mrs_ent[l2_mrs_n]: ent
    l2_mrs_n: l2_mrs_n + 1
return: 0

# Every field of one declaration becomes a result slot row, in declared order.
fn: l2_mrs_take_entry (int: res; int: ni) int
    int: k 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && l2_mrs_push(res, l2_nsf_fname[k], l2_nsf_kind[k], l2_nsf_ref[k]) != 0
            return: 1
        k: k + 1
    ---
return: 0

# The rows an already bound result contributes when it is itself an operand.
fn: l2_mrs_take_result (int: res; int: src) int
    int: k 0
    int: n
    n: l2_mrs_n
    while: k < n
        if: l2_mrs_res[k] = src && l2_mrs_push(res, l2_mrs_name[k], l2_mrs_kind[k], l2_mrs_ent[k]) != 0
            return: 1
        k: k + 1
    ---
return: 0

# Join a value-position path, which arrives as atoms around separator atoms,
# into one byte span. Returns the length, or 0 when the field list is not a
# path. The buffer is caller supplied; a path longer than it is not a path.
fn: l2_join_path (@: LmP0Field field; int: cnt; @: char buf; size_t: cap) size_t
    @: LmP0Field f
    const: @: LmP0Text t
    size_t: n 0U
    int: want_name 1
    if: field = 0 || buf = 0 || cnt < 3
        return: 0U
    f: l2_next_active(field)
    while: f != 0
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: 0U
        t: f\value\as\atom
        if: t = 0 || t\data = 0 || t\length = 0U
            return: 0U
        if: want_name != 0 && t\length = 1U && t\data[0] = 92
            return: 0U
        if: want_name = 0 && (t\length != 1U || t\data[0] != 92)
            return: 0U
        if: n + t\length > cap
            return: 0U
        c.memcpy(buf + n, t\data, t\length)
        n: n + t\length
        want_name: 1 - want_name
        f: l2_next_active(f\next)
    ---
    if: want_name != 0
        return: 0U
return: n

# The value a field-path statement stores: a literal, or a char literal. Only
# what the declared field kinds already admit.
fn: l2_path_rhs (const: @(LmP0Structure body); int: kind; @: size_t out_v) int
    @: LmP0Field f
    const: @: LmP0Text t
    int: cv
    if: body = 0 || l2_count_active(body) != 1
        return: 1
    f: l2_next_active(body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    t: f\value\as\atom
    if: kind = 0 && l2_num(t) = 0
        return: 1
    if: kind = 0
        \out_v: l2_literal_value(t)
        return: 0
    cv: l2_char_literal(t)
    if: cv < 0
        return: 1
    \out_v: (cast: (size_t) cv)
return: 0

# The body of "if: <slot> = 0" for a field path: a slot the translator resolved
# must exist, so this is a lost-graph stop, not a language outcome. It leaves a
# method exactly the way l2_emit_path_load leaves one -- checkpoint first, then
# the method's own return shape -- and the entry with a distinguished code.
# Which method does this statement or call head name? A plain name, or a field
# path whose leaf is a callable. -1 when the head names no method.
# The unit-child index of the first used own field of a method, or -1. Its cell
# is what distinguishes two occurrences of the same callable: the descriptor is
# shared, the own storage is not.
fn: l2_first_own_child (int: mi) int
    int: oi 0
    while: oi < l2_own_n
        if: l2_own_mi[oi] = mi && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_own_host[oi] = 0 && l2_own_uchild[oi] >= 0
            return: l2_own_uchild[oi]
        oi: oi + 1
    ---
return: 0 - 1

# Is this statement a CALL rather than an update? The parse tree of
#     A\x: 5U      and     A\x(5U)
# is identical, so the spelling alone cannot decide. Two things can:
#   - the path ends at a CALLABLE field, which an update could never target;
#   - the argument list is EMPTY, which an update could never be.
# Everything else with a path head is an update, and a wrong one is reported
# against the field it names.
fn: l2_head_is_call (const: @(LmP0Text t); const: @(LmP0Structure body); unsigned: flags) int
    int: k 0
    if: t = 0
        return: 0
    # Parentheses are preserved in the P0 frame flags.  They decide the
    # otherwise ambiguous machine-field case exactly: p\fn(...) is a call,
    # while p\field: value is an update.  Colon calls remain decidable from a
    # known L2 METHOD descriptor below.
    if: (flags & c.LM_P0_FRAME_COMPACT) != 0U
        return: 1
    if: l2_find_method(t) >= 0
        return: 1
    if: t\data = 0 || t\length >= 256U
        return: 0
    if: l2_seg_count(t\data, t\length) < 2
        return: 0
    if: l2_path_kind(t\data, t\length, @ k) = 4
        return: 1
    if: body = 0 || l2_count_active(body) = 0
        return: 1
return: 0

fn: l2_head_method (const: @(LmP0Text t)) int
    int: k 0
    int: r
    if: t = 0
        return: 0 - 1
    r: l2_find_method(t)
    if: r >= 0
        return: r
    if: t\data = 0 || t\length >= 256U
        return: 0 - 1
    if: l2_seg_count(t\data, t\length) < 2
        return: 0 - 1
    if: l2_path_kind(t\data, t\length, @ k) != 4
        return: 0 - 1
return: k

fn: l2_emit_path_bail (int: mi; const: @(char ind)) int
    @: char deep 0
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    if: mi < 0 && c.fprintf(l2_out, "%sreturn: 76\n", deep) < 0
        return: 1
    if: mi < 0
        return: 0
    if: l2_emit_checkpoint(mi, deep) != 0
        return: 1
    if: l2_m_ret[mi] = 8 && c.fprintf(l2_out, "%sreturn\n", deep) < 0
        return: 1
    if: l2_ret_uns(mi) != 0 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn: 0U\n", deep) < 0
        return: 1
    if: l2_ret_uns(mi) != 0 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: 0U\n%sreturn: 0\n", deep, deep) < 0
        return: 1
    if: l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn: 0\n", deep) < 0
        return: 1
    if: l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: 0\n%sreturn: 0\n", deep, deep) < 0
        return: 1
return: 0

# ---------------------------------------------------------------------------
# SOURCE FIELD PATHS (SPEC 8252, 8366). A path is a name, then field-follow
# separators and field names: the root is an ordinary named Structure or a
# bound merge result, both of which live in reserved unit children. Every step
# resolves at TRANSLATION to a child index. The graph carries no name table at
# run time and none is introduced here.
#
# A path arrives in two spellings. In update position the parser hands over the
# whole path as ONE frame head text; in value position it arrives as a sequence
# of atoms separated by the separator atom. These functions therefore take a
# plain byte span, which both spellings can produce, rather than an LmP0Text.
# ---------------------------------------------------------------------------

# Segment i of a separator-joined span, as an offset and a length.
# Is this statement head a field path this emitter lowers? Used by the
# unsupported-body guard, which runs before the statement is dispatched.
fn: l2_is_path_head (const: @(LmP0Text t)) int
    int: ni 0
    int: res 0
    if: t = 0 || t\data = 0 || t\length >= 256U
        return: 0
    if: l2_seg_count(t\data, t\length) < 2
        return: 0
    if: l2_path_root(t\data, t\length, @ ni, @ res) != 0
        return: 0
return: 1

fn: l2_seg_at (const: @(char pd); size_t: pn; int: i; @: size_t off; @: size_t len) int
    size_t: j 0U
    size_t: start 0U
    int: seen 0
    if: pd = 0
        return: 1
    while: j < pn
        if: pd[j] = 92 && seen = i
            \off: start
            \len: j - start
            return: 0
        if: pd[j] = 92
            seen: seen + 1
            start: j + 1U
        j: j + 1U
    ---
    if: seen != i
        return: 1
    \off: start
    \len: pn - start
return: 0

fn: l2_seg_count (const: @(char pd); size_t: pn) int
    size_t: j 0U
    int: n 1
    if: pd = 0
        return: 0
    while: j < pn
        if: pd[j] = 92
            n: n + 1
        j: j + 1U
    ---
return: n

# Does this name equal the given span of the path?
fn: l2_name_is_seg (const: @(LmP0Text name); const: @(char pd); size_t: off; size_t: len) int
    if: name = 0 || name\data = 0 || pd = 0 || len = 0U
        return: 0
    if: name\length != len
        return: 0
return: c.memcmp(name\data, pd + off, len) = 0

# A field of one declaration, by name: returns its SLOT index and reports the
# field kind and the entry a nested or reference field names. -1 when unknown,
# -2 when more than one field of that declaration carries the name.
fn: l2_ns_slot_named (int: ni; const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    int: k 0
    int: slotix 0
    int: hit 0 - 1
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && l2_name_is_seg(l2_nsf_fname[k], pd, off, len) != 0 && hit >= 0
            return: 0 - 2
        if: l2_nsf_owner[k] = ni && l2_name_is_seg(l2_nsf_fname[k], pd, off, len) != 0
            hit: slotix
            \out_kind: l2_nsf_kind[k]
            \out_ent: l2_nsf_ref[k]
        if: l2_nsf_owner[k] = ni
            slotix: slotix + 1
        k: k + 1
    ---
return: hit

# The same for a bound merge result, whose slots carry the names of the fields
# that CONTRIBUTED them.
fn: l2_mrs_slot_named (int: res; const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    int: k 0
    int: slotix 0
    int: hit 0 - 1
    while: k < l2_mrs_n
        if: l2_mrs_res[k] = res && l2_name_is_seg(l2_mrs_name[k], pd, off, len) != 0 && hit >= 0
            return: 0 - 2
        if: l2_mrs_res[k] = res && l2_name_is_seg(l2_mrs_name[k], pd, off, len) != 0
            hit: slotix
            \out_kind: l2_mrs_kind[k]
            \out_ent: l2_mrs_ent[k]
        if: l2_mrs_res[k] = res
            slotix: slotix + 1
        k: k + 1
    ---
return: hit

# Is this span a field path whose root names a declaration or a bound result?
fn: l2_path_root (const: @(char pd); size_t: pn; @: int out_ni; @: int out_res) int
    size_t: off 0U
    size_t: len 0U
    int: i 0
    \out_ni: 0 - 1
    \out_res: 0 - 1
    if: l2_seg_count(pd, pn) < 2
        return: 1
    if: l2_seg_at(pd, pn, 0, @ off, @ len) != 0 || len = 0U
        return: 1
    while: i < l2_ns_n
        if: l2_ns_parent[i] < 0 && l2_name_is_seg(l2_ns_name[i], pd, off, len) != 0
            \out_ni: i
        i: i + 1
    ---
    i: 0
    while: i < l2_mres_n
        if: l2_name_is_seg(l2_mres_name[i], pd, off, len) != 0
            \out_res: i
        i: i + 1
    ---
    if: \out_ni < 0 && \out_res < 0
        return: 1
return: 0

# Walk a path without emitting: reports the leaf kind (0 size_t, 1 char,
# 2 nested, 3 reference, 4 callable) and, for a callable leaf, the method index
# in out_mi. Returns -1 when the path does not resolve.
# Does this path pass through, or end inside, a qualified branch? Used to
# refuse an update: const: immutable is enforced where the update is written,
# not left to the runtime.
fn: l2_path_in_eternal (const: @(char pd); size_t: pn) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    if: l2_path_root(pd, pn, @ ni, @ res) != 0
        return: 0
    if: ni >= 0 && l2_ns_eternal[ni] >= 0
        return: 1
    segs: l2_seg_count(pd, pn)
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: 0
        slot: 0 - 1
        if: i = 1 && res >= 0
            slot: l2_mrs_slot_named(res, pd, off, len, @ kind, @ ent)
        if: (i > 1 || res < 0) && ni >= 0
            slot: l2_ns_slot_named(ni, pd, off, len, @ kind, @ ent)
        if: slot < 0
            return: 0
        if: (kind = 2 || kind = 3) && ent >= 0 && l2_ns_eternal[ent] >= 0
            return: 1
        if: kind = 2 || kind = 3
            ni: ent
            res: 0 - 1
        ---
        i: i + 1
    ---
return: 0

fn: l2_path_kind (const: @(char pd); size_t: pn; @: int out_mi) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    \out_mi: 0 - 1
    if: l2_path_root(pd, pn, @ ni, @ res) != 0
        return: 0 - 1
    segs: l2_seg_count(pd, pn)
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: 0 - 1
        slot: 0 - 1
        if: i = 1 && res >= 0
            slot: l2_mrs_slot_named(res, pd, off, len, @ kind, @ ent)
        if: (i > 1 || res < 0) && ni < 0
            return: 0 - 1
        if: (i > 1 || res < 0) && ni >= 0
            slot: l2_ns_slot_named(ni, pd, off, len, @ kind, @ ent)
        if: slot < 0
            return: 0 - 1
        if: i + 1 < segs && kind != 2 && kind != 3
            return: 0 - 1
        if: i + 1 < segs
            ni: ent
            res: 0 - 1
        ---
        i: i + 1
    ---
    if: kind = 4
        \out_mi: ent
return: kind

# Emit the walk that leaves l2_pxp addressing the LEAF SLOT of the path, and
# report the leaf kind: 0 size_t, 1 char.
fn: l2_emit_path (const: @(char pd); size_t: pn; int: mi; const: @(char ind); const: @(LmP0Node at); @: int out_kind) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    if: l2_path_root(pd, pn, @ ni, @ res) != 0
        return: l2_error(l2_src, at, "unknown field path root")
    segs: l2_seg_count(pd, pn)
    if: ni >= 0 && l2_ns_eternal[ni] < 0 && c.fprintf(l2_out, "%sl2_pst: lmx_branch_struct_known(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni))), ind) < 0
        return: 1
    if: ni >= 0 && l2_ns_eternal[ni] >= 0 && c.fprintf(l2_out, "%sl2_pst: lmx_branch_struct_known(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_m_n + 2 + l2_ns_eternal[ni])), ind) < 0
        return: 1
    if: ni >= 0 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: ni < 0 && c.fprintf(l2_out, "%sl2_pst: lmx_branch_struct_known(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_mres_base + res)), ind) < 0
        return: 1
    if: ni < 0 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: l2_error(l2_src, at, "malformed field path")
        slot: 0 - 1
        if: i = 1 && res >= 0
            slot: l2_mrs_slot_named(res, pd, off, len, @ kind, @ ent)
        if: (i > 1 || res < 0) && ni < 0
            return: l2_error(l2_src, at, "field path goes through a slot with no Structure")
        if: (i > 1 || res < 0) && ni >= 0
            slot: l2_ns_slot_named(ni, pd, off, len, @ kind, @ ent)
        if: slot = 0 - 2
            return: l2_error(l2_src, at, "ambiguous field path segment")
        if: slot < 0
            return: l2_error(l2_src, at, "unknown field path segment")
        if: i + 1 < segs && kind != 2 && kind != 3
            return: l2_error(l2_src, at, "field path goes through a slot with no Structure")
        if: i + 1 < segs && c.fprintf(l2_out, "%sl2_pst: lmx_branch_struct_known(l2_pst, %uU)\n%sif: l2_pst = 0\n", ind, (cast: (unsigned) slot), ind) < 0
            return: 1
        if: i + 1 < segs && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 < segs
            ni: ent
            res: 0 - 1
        ---
        if: i + 1 = segs && kind != 0 && kind != 1 && kind != 4
            return: l2_error(l2_src, at, "a field path must end at a primitive field")
        if: i + 1 = segs && kind = 4 && c.fprintf(l2_out, "%sl2_pst: lmx_branch_struct_known(l2_pst, %uU)\n%sif: l2_pst = 0\n", ind, (cast: (unsigned) slot), ind) < 0
            return: 1
        if: i + 1 = segs && kind = 4 && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 = segs && kind != 4 && c.fprintf(l2_out, "%sl2_pxp: lmx_branch_slot_known(l2_pst, %uU)\n%sif: l2_pxp = 0\n", ind, (cast: (unsigned) slot), ind) < 0
            return: 1
        if: i + 1 = segs && kind != 4 && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 = segs
            \out_kind: kind
        ---
        i: i + 1
    ---
return: 0

fn: l2_ns_field_ref (int: ni; int: j) int
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni
            if: slotix = j
                if: l2_nsf_kind[k] = 3
                    return: l2_nsf_ref[k]
                return: 0 - 1
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

# The slot of the first reference field of ni that names t, or -1.
fn: l2_ns_slot_of_ref (int: ni; int: t) int
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni
            if: l2_nsf_kind[k] = 3 && l2_nsf_ref[k] = t
                return: slotix
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

# How many declarations, at any level, carry this name.
fn: l2_ns_count_named (const: @(LmP0Text t)) int
    int: i 0
    int: r 0
    while: i < l2_ns_n
        if: l2_text_same(l2_ns_name[i], t)
            r: r + 1
        i: i + 1
    ---
return: r

# Second phase of construction: every reference field is resolved once the whole
# unit has been read. A target may appear later in the source, may be the
# referring declaration itself, may enclose it, or may be a nested declaration:
# the graph admits aliases and cycles, and the copier carries them through one
# operation-local map. Only an unknown name, or one carried by more than one
# declaration, is an error.
fn: l2_ns_resolve_refs (const: @(char path); const: @(LmP0Node at)) int
    int: k 0
    int: n
    while: k < l2_nsf_n
        if: l2_nsf_kind[k] = 3
            n: l2_ns_count_named(l2_nsf_name[k])
            if: n = 0
                return: l2_error(path, at, "unknown nested Structure reference")
            if: n > 1
                return: l2_error(path, at, "ambiguous nested Structure reference")
            l2_nsf_ref[k]: l2_ns_find(l2_nsf_name[k])
            # Qualification admits an ADDRESS RANGE, not a promise. A reference
            # out of a qualified branch into ordinary mutable storage would make
            # a reclaimable target reachable as a terminal, so it is refused
            # here rather than admitted and regretted.
            if: l2_ns_eternal[l2_nsf_owner[k]] >= 0 && l2_ns_eternal[l2_nsf_ref[k]] < 0
                return: l2_error(path, at, "an eternal branch cannot reference mutable storage")
            ---
        if: l2_nsf_kind[k] = 4
            n: l2_find_method(l2_nsf_name[k])
            if: n < 0
                return: l2_error(path, at, "unknown callable field")
            if: l2_ns_eternal[l2_nsf_owner[k]] >= 0
                return: l2_error(path, at, "an eternal branch cannot hold a callable field")
            l2_nsf_ref[k]: n
        k: k + 1
    ---
return: 0

fn: l2_take_named (const: @(LmP0Node item); const: @(char path)) int
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    if: l2_ident(item\as\frame\head) = 0
        return: l2_error(path, item, "unsupported body")
    if: l2_fn_close(item\as\frame, item\as\frame\head, 0) != 0
        return: l2_error(path, item, "end target does not match close target")
    if: l2_ns_find(item\as\frame\head) >= 0 && l2_ns_eternal[l2_ns_find(item\as\frame\head)] >= 0
        return: l2_error(path, item, "named Structure collides with a qualified branch")
    if: l2_ns_find(item\as\frame\head) >= 0
        return: l2_error(path, item, "duplicate named Structure")
    if: l2_ebr_find(item\as\frame\head) >= 0
        return: l2_error(path, item, "named Structure collides with a qualified branch")
    if: l2_find_method(item\as\frame\head) >= 0
        return: l2_error(path, item, "named Structure collides with a method")
    if: l2_own_shared(item\as\frame\head) >= 0
        return: l2_error(path, item, "named Structure collides with a unit field")
return: l2_take_ns_body(item\as\frame\head, 0 - 1, item\as\frame\body, item, path)

fn: l2_take_eternal (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Node cur
    @: LmP0Node body
    @: LmP0Field f
    int: root
    cur: (cast: (@: LmP0Node) item)
    if: l2_frame_head(cur, "independent") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    if: l2_count_active(cur\as\frame\body) != 1
        return: l2_error(path, item, "independent takes one qualified construction")
    cur: l2_next_active(cur\as\frame\body\first_field)\value
    if: l2_frame_head(cur, "const") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0 || l2_count_active(cur\as\frame\body) != 1
        return: l2_error(path, item, "independent branch requires const")
    cur: l2_next_active(cur\as\frame\body\first_field)\value
    if: l2_frame_head(cur, "immutable") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0 || l2_count_active(cur\as\frame\body) != 1
        return: l2_error(path, item, "independent branch requires immutable")
    cur: l2_next_active(cur\as\frame\body\first_field)\value
    if: l2_frame_head(cur, "()") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0
        return: l2_error(path, item, "independent qualifies Structure construction")
    if: l2_count_active(cur\as\frame\body) != 2
        return: l2_error(path, item, "eternal branch takes a name and a body")
    f: l2_next_active(cur\as\frame\body\first_field)
    if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: l2_error(path, item, "eternal branch needs a name")
    body: l2_next_active(f\next)\value
    # The construction body arrives as a structure block, exactly like a fn
    # body. Its FIELDS are the ordinary named-Structure field model: size_t and
    # char leaves, inline nested Structures, and translation-known references.
    # Qualification decides storage admission and immutability, not shape.
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0 || body\as\structure = 0
        return: l2_error(path, item, "eternal branch takes a body block")
    if: l2_ns_find(f\value\as\atom) >= 0
        return: l2_error(path, item, "duplicate named Structure")
    if: l2_find_method(f\value\as\atom) >= 0
        return: l2_error(path, item, "named Structure collides with a method")
    if: l2_own_shared(f\value\as\atom) >= 0
        return: l2_error(path, item, "named Structure collides with a unit field")
    if: l2_ebr_reserve(l2_ebr_n + 1) != 0
        return: l2_error(path, item, "out of memory")
    root: l2_ns_n
    if: l2_take_ns_body((cast: (@: LmP0Text) f\value\as\atom), 0 - 1, body\as\structure, item, path) != 0
        return: 1
    # Every entry the body created -- the root and each nested Structure --
    # belongs to this branch.
    while: root < l2_ns_n
        l2_ns_eternal[root]: l2_ebr_n
        root: root + 1
    ---
    l2_ebr_name[l2_ebr_n]: (cast: (@: LmP0Text) f\value\as\atom)
    l2_ebr_leaf[l2_ebr_n]: 0
    l2_ebr_val[l2_ebr_n]: 0U
    l2_ebr_n: l2_ebr_n + 1
return: 0

fn: l2_end_text (const: @(LmP0Frame frame); const: @(LmP0Text name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0 || name = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_same(field\value\as\atom, name)

fn: l2_int_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    \out_name: 0
    if: node = 0 || node\as = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int") = 0 && l2_frame_head(node, "char") = 0 && l2_frame_head(node, "size_t") = 0 && l2_frame_head(node, "unsigned") = 0 && l2_frame_head(node, "ulong") = 0 && l2_frame_head(node, "LmP0TrailerRole") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f\value = 0 || f\value\as = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    \out_name: f\value\as\atom
return: 0

fn: l2_typed_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name; @: int out_ty) int
    @: LmP0Field f
    @: LmP0Field g
    const: @: LmP0Node inner
    int: depth
    if: out_ty = 0 || out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int")
        \out_ty: 0
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "char")
        \out_ty: 1
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "size_t")
        \out_ty: 2
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "unsigned")
        \out_ty: 34
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "ulong")
        \out_ty: 36
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "LmP0TrailerRole")
        \out_ty: 10
        l2_need_p0: 1
        return: l2_int_formal(node, path, out_name)
    depth: 0
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0
        depth: l2_address_depth(node\as\frame\head)
    if: depth > 2
        if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 2
            return: l2_error(path, node, "incompatible entry signature")
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        \out_ty: l2_foreign_intern(f\value\as\atom, depth, 0)
        if: \out_ty < 100
            if: \out_ty = -2
                return: l2_error(path, node, "unknown foreign type")
            return: l2_error(path, node, "out of memory")
        \out_name: g\value\as\atom
        return: 0
    if: l2_frame_head(node, "@@")
        if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 2
            return: l2_error(path, node, "incompatible entry signature")
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, node, "incompatible entry signature")
        if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        if: l2_text_eq(f\value\as\atom, "char")
            \out_ty: 17
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "void")
            \out_ty: 18
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "int")
            \out_ty: 19
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "unsigned")
            \out_ty: 24
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "ulong")
            \out_ty: 39
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmxMsgBlock")
            \out_ty: 26
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmxOwnedRange")
            \out_ty: 27
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmxMsgCopy")
            \out_ty: 31
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "size_t")
            \out_ty: 20
            \out_name: g\value\as\atom
            return: 0
        \out_ty: l2_foreign_intern(f\value\as\atom, 2, 0)
        if: \out_ty < 100
            if: \out_ty = -2
                return: l2_error(path, node, "unknown foreign type")
            return: l2_error(path, node, "out of memory")
        \out_name: g\value\as\atom
        return: 0
    if: l2_frame_head(node, "@")
        if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 2
            return: l2_error(path, node, "incompatible entry signature")
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, node, "incompatible entry signature")
        if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        if: l2_text_eq(f\value\as\atom, "size_t")
            \out_ty: 9
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "int")
            \out_ty: 11
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "unsigned")
            \out_ty: 25
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "ulong")
            \out_ty: 38
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "char")
            \out_ty: 12
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmP0Document")
            l2_need_p0: 1
            \out_ty: 13
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmP0IndentStack")
            l2_need_p0: 1
            \out_ty: 14
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "void")
            \out_ty: 16
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmP0Text") = 0 && l2_text_eq(f\value\as\atom, "L2ImmutQuery") = 0
            \out_ty: l2_foreign_intern(f\value\as\atom, 1, 0)
            if: \out_ty < 100
                if: \out_ty = -2
                    return: l2_error(path, node, "unknown foreign type")
                return: l2_error(path, node, "out of memory")
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmP0Text")
            l2_need_p0: 1
            \out_ty: 5
        if: l2_text_eq(f\value\as\atom, "L2ImmutQuery")
            l2_need_query: 1
            \out_ty: 7
        \out_name: g\value\as\atom
        return: 0
    if: l2_frame_head(node, "const") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    inner: l2_next_active(node\as\frame\body\first_field)\value
    if: inner = 0 || inner\kind != c.LM_P0_NODE_FRAME || inner\as = 0 || inner\as\frame = 0
        return: l2_error(path, node, "incompatible entry signature")
    depth: l2_address_depth(inner\as\frame\head)
    if: depth = 0 || inner\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_count_active(inner\as\frame\body) != 2 && l2_count_active(inner\as\frame\body) != 3
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(inner\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: depth != 1
        if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        \out_ty: l2_foreign_intern(f\value\as\atom, depth, 1)
        if: \out_ty < 100
            if: \out_ty = -2
                return: l2_error(path, node, "unknown foreign type")
            return: l2_error(path, node, "out of memory")
        \out_name: g\value\as\atom
        return: 0
    if: l2_text_eq(f\value\as\atom, "char") = 0 && l2_text_eq(f\value\as\atom, "LmP0Text") = 0 && l2_text_eq(f\value\as\atom, "L2ImmutQuery") = 0 && l2_text_eq(f\value\as\atom, "LmP0IndentStack") = 0 && l2_text_eq(f\value\as\atom, "LmxMsgRuntime") = 0 && l2_text_eq(f\value\as\atom, "LmxMsg") = 0 && l2_text_eq(f\value\as\atom, "LmxMsgCopy") = 0
        \out_ty: l2_foreign_intern(f\value\as\atom, 1, 1)
        if: \out_ty < 100
            if: \out_ty = -2
                return: l2_error(path, node, "unknown foreign type")
            return: l2_error(path, node, "out of memory")
        \out_name: g\value\as\atom
        return: 0
    if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_text_eq(f\value\as\atom, "char")
        \out_ty: 3
    if: l2_text_eq(f\value\as\atom, "LmxMsgRuntime")
        \out_ty: 28
    if: l2_text_eq(f\value\as\atom, "LmxMsg")
        \out_ty: 29
    if: l2_text_eq(f\value\as\atom, "LmxMsgCopy")
        \out_ty: 30
    if: l2_text_eq(f\value\as\atom, "LmP0Text")
        \out_ty: 4
        l2_need_p0: 1
    if: l2_text_eq(f\value\as\atom, "L2ImmutQuery")
        \out_ty: 6
        l2_need_query: 1
    if: l2_text_eq(f\value\as\atom, "LmP0IndentStack")
        \out_ty: 15
        l2_need_p0: 1
    \out_name: g\value\as\atom
return: 0

fn: l2_collect_method (const: @(LmP0Node fn_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node params
    const: @: LmP0Node body
    @: LmP0Field p
    @: LmP0Text fa 0
    @: LmP0Text nm 0
    unsigned: id
    int: ar
    int: j
    int: ty
    int: k
    int: is_sub 0
    int: sn 0
    int: return_depth 0
    const: @: LmP0Node rty
    const: @: LmP0Node rbase
    if: fn_node = 0 || fn_node\as = 0 || fn_node\as\frame = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: l2_m_n >= c.INT_MAX
        l2_alloc_err: 2
        return: l2_error(path, fn_node, "size overflow")
    if: l2_meth_reserve(l2_m_n + 1) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, fn_node, "size overflow")
        return: l2_error(path, fn_node, "out of memory")
    fr: fn_node\as\frame
    if: l2_frame_head(fn_node, "sub")
        is_sub: 1
    k: 0
    if: fr\body != 0
        k: l2_count_active(fr\body)
    if: is_sub = 0 && k != 4 && (k != 3 || l2_ret_tr(fr) = 0)
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub != 0 && k != 3 && (k != 2 || l2_ret_tr(fr) = 0)
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_ident(field\value\as\atom) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    nm: field\value\as\atom
    if: fr\trailer != 0 && l2_text_eq(fr\trailer\spelling, "end") = 0 && l2_text_eq(fr\trailer\spelling, "return") = 0
        return: l2_error(path, fn_node, "unsupported trailer")
    if: is_sub = 0 && l2_fn_close(fr, nm, "fn") != 0
        return: l2_error(path, fn_node, "end target does not match close target")
    if: is_sub != 0 && l2_fn_close(fr, nm, "sub") != 0
        return: l2_error(path, fn_node, "end target does not match close target")
    if: l2_find_method(nm) >= 0
        return: l2_error(path, fn_node, "duplicate definition")
    if: l2_own_shared(nm) >= 0
        return: l2_error(path, fn_node, "method collides with a unit field")
    if: nm\length >= 63U
        return: l2_error(path, fn_node, "name too long")
    field: l2_next_active(field\next)
    params: field\value
    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE || params\as = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: params\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    ar: l2_count_active(params\as\structure)
    if: ar < 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_formals_alloc(l2_m_n, ar) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, fn_node, "size overflow")
        return: l2_error(path, fn_node, "out of memory")
    p: l2_next_active(params\as\structure\first_field)
    j: 0
    while: j < ar
        ty: 0
        fa: 0
        if: p = 0 || l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            l2_free_method(l2_m_n)
            return: 1
        if: fa = 0 || fa\length >= 63U
            l2_free_method(l2_m_n)
            return: l2_error(path, fn_node, "name too long")
        k: 0
        while: k < j
            if: l2_text_same(fa, l2_fn(l2_m_n, k))
                l2_free_method(l2_m_n)
                return: l2_error(path, p\value, "duplicate formal")
            k: k + 1
        if: l2_fn_set(l2_m_n, j, fa) != 0 || l2_ft_set(l2_m_n, j, ty) != 0
            l2_free_method(l2_m_n)
            return: l2_error(path, fn_node, "out of memory")
        p: l2_next_active(p\next)
        j: j + 1
    l2_m_arity[l2_m_n]: ar
    l2_m_dyn[l2_m_n]: 0
    l2_m_f0[l2_m_n]: 0
    l2_m_f1[l2_m_n]: 0
    if: ar >= 1
        l2_m_f0[l2_m_n]: l2_fn(l2_m_n, 0)
    if: ar >= 2
        l2_m_f1[l2_m_n]: l2_fn(l2_m_n, 1)
    field: l2_next_active(field\next)
    if: is_sub != 0
        l2_m_ret[l2_m_n]: 8
    if: is_sub = 0 && field\value = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "int")
        l2_m_ret[l2_m_n]: 0
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "size_t")
        l2_m_ret[l2_m_n]: 2
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "unsigned")
        l2_m_ret[l2_m_n]: 33
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "ulong")
        l2_m_ret[l2_m_n]: 36
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "void")
        l2_m_ret[l2_m_n]: 8
    # The Message address of the Message runtime adapter, unsigned.
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "LmxMsgAddr")
        l2_m_ret[l2_m_n]: 30
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "LmP0TrailerRole")
        l2_m_ret[l2_m_n]: 10
        l2_need_p0: 1
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_FRAME && field\value\as != 0 && field\value\as\frame != 0
        return_depth: l2_address_depth(field\value\as\frame\head)
    # A const-qualified pointer return is the same pointer value at runtime,
    # but its L1 declaration and every receiving temporary must retain the
    # pointee qualifier.  It is a nested `const: (@: T)` type, unlike a
    # const-qualified formal whose innermost frame also carries the name.
    if: is_sub = 0 && l2_frame_head(field\value, "const")
        if: field\value\as\frame\body = 0 || l2_count_active(field\value\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rty: l2_next_active(field\value\as\frame\body\first_field)\value
        if: rty = 0 || rty\kind != c.LM_P0_NODE_FRAME || rty\as = 0 || rty\as\frame = 0
            return: l2_error(path, fn_node, "incompatible entry signature")
        return_depth: l2_address_depth(rty\as\frame\head)
        if: return_depth != 1 || rty\as\frame\body = 0 || l2_count_active(rty\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rbase: l2_next_active(rty\as\frame\body\first_field)\value
        if: rbase = 0 || rbase\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, fn_node, "incompatible entry signature")
        if: l2_text_eq(rbase\as\atom, "char")
            l2_m_ret[l2_m_n]: 35
        else:
            return: l2_error(path, fn_node, "unknown foreign type")
        return_depth: 0 - 1
        ---
    if: is_sub = 0 && return_depth > 2
        if: field\value\as\frame\body = 0 || l2_count_active(field\value\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rty: l2_next_active(field\value\as\frame\body\first_field)\value
        if: rty = 0 || rty\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, fn_node, "incompatible entry signature")
        l2_m_ret[l2_m_n]: l2_foreign_intern(rty\as\atom, return_depth, 0)
        if: l2_m_ret[l2_m_n] < 100
            if: l2_m_ret[l2_m_n] = -2
                return: l2_error(path, fn_node, "unknown foreign type")
            return: l2_error(path, fn_node, "out of memory")
        ---
    if: is_sub = 0 && l2_frame_head(field\value, "@")
        if: field\value\as\frame\body = 0 || l2_count_active(field\value\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rty: l2_next_active(field\value\as\frame\body\first_field)\value
        if: rty = 0 || rty\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, fn_node, "incompatible entry signature")
        if: l2_text_eq(rty\as\atom, "char")
            l2_m_ret[l2_m_n]: 3
        if: l2_text_eq(rty\as\atom, "void")
            l2_m_ret[l2_m_n]: 16
        if: l2_text_eq(rty\as\atom, "LmP0Text")
            l2_m_ret[l2_m_n]: 5
            l2_need_p0: 1
        if: l2_text_eq(rty\as\atom, "LmP0IndentStack")
            l2_m_ret[l2_m_n]: 13
            l2_need_p0: 1
        if: l2_text_eq(rty\as\atom, "char") = 0 && l2_text_eq(rty\as\atom, "void") = 0 && l2_text_eq(rty\as\atom, "LmP0Text") = 0 && l2_text_eq(rty\as\atom, "LmP0IndentStack") = 0
            l2_m_ret[l2_m_n]: l2_foreign_intern(rty\as\atom, 1, 0)
            if: l2_m_ret[l2_m_n] < 100
                if: l2_m_ret[l2_m_n] = -2
                    return: l2_error(path, fn_node, "unknown foreign type")
                return: l2_error(path, fn_node, "out of memory")
        ---
    if: is_sub = 0 && l2_frame_head(field\value, "@@")
        if: field\value\as\frame\body = 0 || l2_count_active(field\value\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rty: l2_next_active(field\value\as\frame\body\first_field)\value
        if: rty = 0 || rty\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, fn_node, "incompatible entry signature")
        if: l2_text_eq(rty\as\atom, "char")
            l2_m_ret[l2_m_n]: 32
        else:
            l2_m_ret[l2_m_n]: l2_foreign_intern(rty\as\atom, 2, 0)
            if: l2_m_ret[l2_m_n] < 100
                if: l2_m_ret[l2_m_n] = -2
                    return: l2_error(path, fn_node, "unknown foreign type")
                return: l2_error(path, fn_node, "out of memory")
        ---
    ---
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(field\value\as\atom, "int") = 0 && l2_text_eq(field\value\as\atom, "size_t") = 0 && l2_text_eq(field\value\as\atom, "unsigned") = 0 && l2_text_eq(field\value\as\atom, "ulong") = 0 && l2_text_eq(field\value\as\atom, "void") = 0 && l2_text_eq(field\value\as\atom, "LmP0TrailerRole") = 0 && l2_text_eq(field\value\as\atom, "LmxMsgAddr") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0 && field\value\kind != c.LM_P0_NODE_ATOM && return_depth = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0
        field: l2_next_active(field\next)
    body: 0
    if: field != 0
        body: field\value
    if: body = 0 && l2_ret_tr(fr) = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: body != 0 && (body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0)
        return: l2_error(path, fn_node, "unsupported body")
    if: body != 0 && body\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    l2_m_name[l2_m_n]: nm
    l2_m_node[l2_m_n]: (cast: (@: LmP0Node) fn_node)
    l2_m_body[l2_m_n]: (cast: (@: LmP0Node) body)
    l2_m_sig[l2_m_n]: 0U
    l2_m_own[l2_m_n]: 0
    l2_m_sn[l2_m_n]: 0
    if: body != 0 && l2_collect_decls(body\as\structure, l2_m_n, path, 0, @ sn) != 0
        return: 1
    l2_m_sn[l2_m_n]: sn
    l2_m_n: l2_m_n + 1
return: 0

fn: l2_check_primary (const: @(LmP0Node node); int: mi; const: @(char path)) int
    const: @: LmP0Frame call
    int: pni 0
    int: pres 0
    int: pmi 0
    @: LmP0Field a0
    @: LmP0Field a1
    int: idx
    int: actual_span
    int: actual_i
    int: array_status
    int: raw
    int: raw_j
    int: raw_fld
    size_t: array_index
    c.array: [256]: char cast_ty
    if: node = 0
        return: l2_error(path, node, "unsupported body")
    if: node\kind = c.LM_P0_NODE_ATOM
        raw: l2_prefix_deref(node\as\atom, mi, cast_ty)
        if: raw = 0
            return: 0
        if: raw = 2
            return: l2_error(path, node, "invalid raw dereference")
        array_status: l2_own_index_head(node\as\atom, mi, @ idx, @ array_index)
        if: array_status = 0
            return: 0
        if: array_status = 2
            return: l2_error(path, node, "own array index requires an in-bounds primitive literal")
        raw: l2_raw_head(node\as\atom, mi, @ raw_j, @ raw_fld)
        if: raw = 0
            return: 0
        if: raw = 2
            return: l2_error(path, node, "unknown foreign field")
        if: l2_num(node\as\atom)
            return: 0
        if: l2_int_fits(node\as\atom)
            return: 0
        if: l2_signed_num(node\as\atom)
            return: 0
        if: l2_quoted(node\as\atom)
            return: 0
        if: l2_upper_name(node\as\atom)
            return: 0
        if: node\as\atom\length >= 3U && node\as\atom\data[0] = 39 && node\as\atom\data[node\as\atom\length - 1U] = 39
            return: 0
        if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
            return: 0
        if: l2_ident(node\as\atom) = 0
            return: l2_error(path, node, "unsupported body")
        if: mi >= 0 && l2_param_find(mi, node\as\atom) >= 0
            return: 0
        # As a value, a source method name denotes its generated public C ABI
        # wrapper. Calls still resolve to the callable Structure separately.
        if: l2_find_method(node\as\atom) >= 0
            l2_m_value_used[l2_find_method(node\as\atom)]: 1
            return: 0
        if: l2_entry_find(node\as\atom) >= 0
            return: 0
        if: l2_loc_find(node\as\atom) >= 0
            return: 0
        # and a local this method body declares, which lives in its own
        # activation rather than the entry frame.
        if: mi >= 0 && l2_ml_find(node\as\atom) >= 0
            return: 0
        if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
            return: 0
        if: mi >= 0
            idx: l2_own_find(mi, node\as\atom)
            # In expression position a primitive array is its backing pointer,
            # matching ordinary C array decay. Indexed graph access remains a
            # separate checked operation above.
            if: idx >= 0 && l2_own_is_array(l2_own_ty[idx]) != 0
                return: 0
            if: idx >= 0 && l2_own_is_array(l2_own_ty[idx]) != 0
                return: l2_error(path, node, "own array use not yet supported")
            if: idx >= 0 && l2_m_uses[l2_own_off(mi, idx)] != 0
                return: 0
            ---
        if: mi < 0
            idx: l2_own_find(mi, node\as\atom)
            if: idx >= 0 && l2_own_mi[idx] < 0 && l2_own_is_array(l2_own_ty[idx]) = 0
                return: 0
            ---
        if: mi >= 0 && l2_slot_find(mi, node\as\atom) >= 0
            return: 0
        return: l2_error(path, node, "unresolved name")
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "@")
        return: l2_check_addr(node, mi, path)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        return: l2_check_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, path, node)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: l2_error(path, node, "unsupported body")
    if: l2_frame_head(node, "while") || l2_frame_head(node, "for") || l2_frame_head(node, "continue") || l2_frame_head(node, "break")
        return: l2_error(path, node, "unsupported loop")
    if: l2_frame_head(node, "if") || l2_frame_head(node, "else") || l2_frame_head(node, "return") || l2_frame_head(node, "fn")
        return: l2_error(path, node, "unsupported body")
    call: node\as\frame
    if: call\head = 0
        return: l2_error(path, node, "unknown method")
    if: l2_text_eq(call\head, "cast")
        if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) < 2
            return: l2_error(path, node, "unsupported cast")
        a0: l2_next_active(call\body\first_field)
        a1: l2_next_active(a0\next)
        if: l2_cast_type(a0\value, cast_ty) != 0
            return: l2_error(path, node, "unsupported cast type")
        if: l2_count_active(call\body) > 2
            return: l2_check_fields(a1, l2_count_active(call\body) - 1, mi, path, node)
        return: l2_check_primary(a1\value, mi, path)
    ---
    idx: l2_head_method(call\head)
    if: idx < 0 && l2_text_eq(call\head, "length")
        if: l2_array_length_own(node, mi) < 0
            return: l2_error(path, node, "length requires one known primitive own array")
        return: 0
    if: idx < 0 && l2_text_eq(call\head, "c.sizeof")
        if: call\body = 0 || l2_next_active(call\body\first_field) = 0
            return: l2_error(path, node, "incompatible entry signature")
        a0: l2_next_active(call\body\first_field)
        # Several fields (name, \, field, [index]) are an L2 expression: its
        # names are variables with generated C spellings, never foreign C.
        if: l2_count_active(call\body) > 1
            return: l2_check_fields(call\body\first_field, l2_count_active(call\body), mi, path, node)
        if: a0\value != 0 && a0\value\kind = c.LM_P0_NODE_FRAME && a0\value\as != 0 && a0\value\as\frame != 0 && l2_address_depth(a0\value\as\frame\head) != 0 && a0\value\as\frame\body != 0 && l2_count_active(a0\value\as\frame\body) = 1
            return: 0
        if: a0\value = 0 || a0\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, node, "unknown foreign type")
        if: mi >= 0 && l2_ml_find(a0\value\as\atom) >= 0 && l2_ml_ty[l2_ml_find(a0\value\as\atom)] = 22
            return: 0
        if: mi < 0 && l2_loc_find(a0\value\as\atom) >= 0 && l2_loc_ty[l2_loc_find(a0\value\as\atom)] = 22
            return: 0
        if: l2_text_eq(a0\value\as\atom, "LmP0Text") = 0 && l2_text_eq(a0\value\as\atom, "c.LmP0Text") = 0 && l2_text_eq(a0\value\as\atom, "LmP0IndentStack") = 0 && l2_text_eq(a0\value\as\atom, "c.LmP0IndentStack") = 0 && l2_text_eq(a0\value\as\atom, "size_t") = 0 && l2_text_eq(a0\value\as\atom, "c.size_t") = 0 && l2_text_eq(a0\value\as\atom, "char") = 0 && l2_text_eq(a0\value\as\atom, "c.char") = 0 && l2_text_eq(a0\value\as\atom, "int") = 0 && l2_text_eq(a0\value\as\atom, "c.int") = 0 && l2_text_eq(a0\value\as\atom, "unsigned") = 0 && l2_text_eq(a0\value\as\atom, "c.unsigned") = 0 && l2_text_eq(a0\value\as\atom, "void") = 0 && l2_text_eq(a0\value\as\atom, "c.void") = 0 && l2_predef_has_type(a0\value\as\atom) = 0
            return: l2_error(path, node, "unknown foreign type")
        return: 0
    if: idx < 0 && l2_is_known(call\head)
        if: l2_text_eq(call\head, "lm_own_new_zero") || l2_text_eq(call\head, "lm_own_copy_bytes") || l2_text_eq(call\head, "lm_own_delete") || l2_text_eq(call\head, "lm_own_resize")
            l2_need_own: 1
        if: l2_text_eq(call\head, "c.lm_p0_set_diagnostic")
            l2_need_p0: 1
            l2_need_diag: 1
        if: call\body = 0
            return: l2_error(path, node, "incompatible entry signature")
        return: l2_check_fields(call\body\first_field, l2_count_active(call\body), mi, path, node)
    if: idx < 0 && (l2_predef_has_function(call\head) != 0 || (mi >= 0 && l2_ml_find(call\head) >= 0 && l2_ml_ty[l2_ml_find(call\head)] = 40 && (call\flags & c.LM_P0_FRAME_COMPACT) != 0U))
        if: call\trailer != 0 || call\body = 0 || call\body\trailer != 0
            return: l2_error(path, node, "unsupported trailer")
        return: l2_check_fields(call\body\first_field, l2_count_active(call\body), mi, path, node)
    raw: l2_raw_head(call\head, mi, @ raw_j, @ raw_fld)
    if: idx < 0 && raw = 0 && raw_fld = 5 && (call\flags & c.LM_P0_FRAME_COMPACT) != 0U
        if: call\body = 0
            return: l2_error(path, node, "incompatible entry signature")
        return: l2_check_fields(call\body\first_field, l2_count_active(call\body), mi, path, node)
    if: idx < 0 && call\head != 0 && call\head\data != 0 && call\head\length < 256U && l2_seg_count(call\head\data, call\head\length) > 1
        # The head is spelled as a path. Say which part of it failed rather
        # than calling the whole statement unsupported.
        if: l2_path_root(call\head\data, call\head\length, @ pni, @ pres) != 0
            return: l2_error(path, node, "unknown field path root")
        if: l2_path_kind(call\head\data, call\head\length, @ pmi) < 0
            return: l2_error(path, node, "unknown field path segment")
        return: l2_error(path, node, "a call path must end at a callable field")
    if: idx < 0
        return: l2_error(path, node, "unknown method")
    if: call\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: call\body = 0 || call\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: l2_actual_count(call\body\first_field) != l2_m_arity[idx]
        return: l2_error(path, node, "incompatible entry signature")
    if: mi >= 0
        l2_m_edge[l2_edge_off(mi, idx)]: 1
    a0: l2_next_active(call\body\first_field)
    while: a0 != 0
        actual_span: l2_expr_span(a0)
        if: actual_span < 1 || l2_check_fields(a0, actual_span, mi, path, node) != 0
            return: 1
        actual_i: 0
        while: actual_i < actual_span && a0 != 0
            a0: l2_next_active(a0\next)
            actual_i: actual_i + 1
        ---
return: 0

fn: l2_check_expr (const: @(LmP0Node node); int: mi; const: @(char path)) int
return: l2_check_primary(node, mi, path)

fn: l2_check_fields (@: LmP0Field field; int: n; int: mi; const: @(char path); const: @(LmP0Node at)) int
    @: LmP0Field f
    size_t: cpn 0U
    int: cpni 0
    int: cpres 0
    c.array: [256]: char cpbuf
    int: cpraw
    int: cpraw_j 0
    int: cpraw_fld 0
    @: LmP0Field p1
    @: LmP0Field p2
    int: i
    int: skip
    int: after 0
    int: have_value 0
    int: po
    int: array_status
    size_t: array_index
    int: array_count
    if: n <= 0
        return: l2_error(path, at, "unsupported body")
    cpn: l2_join_path(field, n, cpbuf, 255U)
    if: cpn != 0U
        cpraw: l2_raw_path(cpbuf, cpn, mi, @ cpraw_j, @ cpraw_fld)
        if: cpraw = 0
            return: 0
        if: cpraw = 2
            return: l2_error(path, at, "unknown foreign field")
        ---
    ---
    if: cpn != 0U && l2_path_root(cpbuf, cpn, @ cpni, @ cpres) = 0
        return: 0
    f: l2_next_active(field)
    i: 0
    while: i < n
        if: f = 0 || f\value = 0
            return: l2_error(path, at, "unsupported body")
        array_status: l2_own_index_tail(f, mi, @ po, @ array_index, @ p2, @ array_count)
        if: array_status = 2
            return: l2_error(path, f\value, "own array index requires an in-bounds primitive literal")
        if: array_status = 0
            have_value: 1
            i: i + array_count
            f: p2
            continue
        skip: 0
        p1: 0
        p2: 0
        po: -1
        if: f\value\kind = c.LM_P0_NODE_ATOM
            p1: l2_next_active(f\next)
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM
            po: l2_path_own(mi, f\value\as\atom, p2\value\as\atom)
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && po < 0 && (l2_text_eq(f\value\as\atom, "for") || l2_text_eq(f\value\as\atom, "node"))
            return: l2_error(path, p2\value, "unresolved name")
        if: po >= 0
            if: l2_own_is_array(l2_own_ty[po]) != 0
                return: l2_error(path, f\value, "own array use not yet supported")
            have_value: 1
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && f\value\as\atom\length + p2\value\as\atom\length + 1U <= 255U
            c.memcpy(cpbuf, f\value\as\atom\data, f\value\as\atom\length)
            cpbuf[f\value\as\atom\length]: 92
            c.memcpy(cpbuf + f\value\as\atom\length + 1U, p2\value\as\atom\data, p2\value\as\atom\length)
            cpn: f\value\as\atom\length + p2\value\as\atom\length + 1U
            cpraw: l2_raw_path(cpbuf, cpn, mi, @ cpraw_j, @ cpraw_fld)
            if: cpraw = 2
                return: l2_error(path, f\value, "unknown foreign field")
            if: cpraw = 0
                have_value: 1
                i: i + 3
                f: l2_next_active(p2\next)
                continue
            ---
        ---
        if: l2_addr_tail(f, mi, @ p1, @ p2) = 0
            i: i + 2
            f: p2
            continue
        if: f\value\kind = c.LM_P0_NODE_ATOM && (l2_is_binop(f\value\as\atom) || l2_is_brack(f\value\as\atom) || l2_is_slash(f\value\as\atom) || l2_num(f\value\as\atom))
            skip: 1
        # An address prefix in flat-field position. What it addresses is checked
        # by the fields that follow it, like any other name or field read.
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "@")
            skip: 1
            have_value: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
            have_value: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            if: have_value != 0
                after: 1
            else:
                after: 0
            ---
        if: after != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom) = 0 && l2_ident(f\value\as\atom)
            skip: 1
            after: 0
            have_value: 1
        if: skip = 0 && l2_check_primary(f\value, mi, path) != 0
            return: 1
        if: skip = 0
            have_value: 1
        i: i + 1
        f: l2_next_active(f\next)
return: 0

fn: l2_check_body (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth) int
    int: array_target
    int: array_status
    size_t: array_index
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    int: rj 0
    int: rf 0
    int: raw 1
    int: ix 1
    int: pd 1
    c.array: [256]: char pdest
    int: lty 0
    @: LmP0Text lnm 0
    @: LmP0Text lsz 0
    if: body = 0
        return: l2_error(path, 0, "unsupported body")
    field: l2_next_active(body\first_field)
    if: field = 0
        return: l2_error(path, 0, "unsupported body")
    while: field != 0
        stmt: field\value
        # 19.17 merge is an ordinary statement frame here. Its operands are
        # checked at emission, where the qualified branch table is complete.
        if: l2_merge_frame(stmt) != 0 && mi < 0
            field: l2_next_active(field\next)
            continue
        if: l2_merge_frame(stmt) != 0 && mi >= 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "[]") && (l2_own_array_count(stmt) = 0 || mi < 0 || depth != l2_scope_n)
            return: l2_error(path, stmt, "unsupported own array declaration")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "break") && l2_loop_depth = 0
            return: l2_error(path, stmt, "unsupported loop")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "break")
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "continue") && l2_loop_depth = 0
            return: l2_error(path, stmt, "unsupported loop")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "continue")
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "return") && (mi < 0 || l2_m_ret[mi] != 8)
            return: l2_error(path, stmt, "unsupported body")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "return")
            field: l2_next_active(field\next)
            continue
        if: mi >= 0 && stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0
            array_status: l2_own_index_head(stmt\as\frame\head, mi, @ array_target, @ array_index)
            if: array_status = 2
                return: l2_error(path, stmt, "own array index requires an in-bounds primitive literal")
            if: array_status = 0
                fr: stmt\as\frame
                if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0
                    return: l2_error(path, stmt, "unsupported trailer")
                if: l2_check_fields(fr\body\first_field, l2_count_active(fr\body), mi, path, stmt) != 0
                    return: 1
                field: l2_next_active(field\next)
                continue
            array_target: l2_own_find(mi, stmt\as\frame\head)
            if: array_target < 0
                array_target: l2_slash_own(stmt\as\frame\head)
            if: array_target >= 0 && l2_own_is_array(l2_own_ty[array_target]) != 0
                return: l2_error(path, stmt, "own array use not yet supported")
        ---
        if: l2_frame_head(stmt, "break") || l2_frame_head(stmt, "continue")
            return: l2_error(path, stmt, "unsupported loop")
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            if: fr\body = 0
                return: l2_error(path, stmt, "unsupported body")
            if: fr\trailer != 0 && l2_end_named(fr, "if") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            n: l2_count_active(fr\body)
            if: n < 2
                return: l2_error(path, stmt, "unsupported body")
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_check_fields(fr\body\first_field, n - 1, mi, path, stmt) != 0
                return: 1
            if: l2_scope_push(last\value) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as\frame\body = 0
                return: l2_error(path, nxt\value, "unsupported body")
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as\frame\trailer != 0 && l2_end_named(nxt\value\as\frame, "else") = 0
                return: l2_error(path, nxt\value, "unsupported trailer")
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                if: l2_scope_push(nxt\value) != 0
                    return: l2_alloc_or(path, nxt\value, "out of memory")
                if: l2_check_body(nxt\value\as\frame\body, mi, path, depth + 1) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            if: fr\body = 0
                return: l2_error(path, stmt, "unsupported body")
            if: fr\trailer != 0 && l2_end_named(fr, "while") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            n: l2_count_active(fr\body)
            if: n < 2
                return: l2_error(path, stmt, "unsupported body")
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_check_fields(fr\body\first_field, n - 1, mi, path, stmt) != 0
                return: 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_scope_push(last\value) != 0
                l2_loop_depth: l2_loop_depth - 1
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                l2_scope_pop()
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            l2_scope_pop()
            l2_loop_depth: l2_loop_depth - 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for")
            fr: stmt\as\frame
            if: l2_for_cstyle(stmt) = 0
                return: l2_error(path, stmt, "unsupported loop")
            if: fr\trailer != 0 && l2_end_named(fr, "for") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            last: l2_next_active(fr\body\first_field)
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_own_decl_ty(last\value) != 0 && l2_count_active(last\value\as\frame\body) = 2 && l2_check_expr(l2_next_active(l2_next_active(last\value\as\frame\body\first_field)\next)\value, mi, path) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
