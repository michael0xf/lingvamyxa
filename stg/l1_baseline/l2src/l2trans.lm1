    j: 0
    while: j < l2_m_arity[mi]
        if: l2_fn(mi, j) != 0 && (l2_fn(mi, j)\length = lb || (l2_ft(mi, j) >= 100 && lb > l2_fn(mi, j)\length + 1U && t\data[l2_fn(mi, j)\length] = 92)) && c.memcmp(l2_fn(mi, j)\data, t\data, l2_fn(mi, j)\length) = 0
            if: l2_ft(mi, j) = 9 && (n - lb - 2U != 1U || t\data[lb + 1U] != 48)
                return: 2
            if: l2_ft(mi, j) != 9 && l2_ft(mi, j) != 11 && l2_ft(mi, j) != 12 && l2_ft(mi, j) != 17 && l2_ft(mi, j) != 18 && l2_ft(mi, j) != 19 && l2_ft(mi, j) != 20 && l2_ft(mi, j) != 24 && l2_ft(mi, j) != 25 && l2_ft(mi, j) != 38 && l2_ft(mi, j) != 39 && l2_ft(mi, j) != 26 && l2_ft(mi, j) != 27 && l2_ft(mi, j) != 31 && l2_ft(mi, j) < 100
                return: 3
            \out_j: j
            return: 0
        j: j + 1
    j: 0
    while: j < l2_m_sn[mi]
        if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = lb && c.memcmp(l2_sn[l2_slot_off(mi, j)]\data, t\data, lb) = 0
            if: l2_st[l2_slot_off(mi, j)] != 3 && l2_st[l2_slot_off(mi, j)] != 9 && l2_st[l2_slot_off(mi, j)] != 11 && l2_st[l2_slot_off(mi, j)] != 12 && l2_st[l2_slot_off(mi, j)] != 17 && l2_st[l2_slot_off(mi, j)] != 18 && l2_st[l2_slot_off(mi, j)] != 19 && l2_st[l2_slot_off(mi, j)] != 20 && l2_st[l2_slot_off(mi, j)] != 22 && l2_st[l2_slot_off(mi, j)] != 24 && l2_st[l2_slot_off(mi, j)] != 25 && l2_st[l2_slot_off(mi, j)] != 26 && l2_st[l2_slot_off(mi, j)] != 27 && l2_st[l2_slot_off(mi, j)] != 31 && l2_st[l2_slot_off(mi, j)] < 100
                return: 3
            \out_j: l2_m_arity[mi] + j
            return: 0
        j: j + 1
    ---
    j: 0
    while: j < l2_ml_n
        if: l2_ml_nm[j] != 0 && (l2_ml_nm[j]\length = lb || (l2_ml_ty[j] >= 100 && lb > l2_ml_nm[j]\length + 1U && t\data[l2_ml_nm[j]\length] = 92)) && c.memcmp(l2_ml_nm[j]\data, t\data, l2_ml_nm[j]\length) = 0
            if: l2_ml_ty[j] != 9 && l2_ml_ty[j] != 11 && l2_ml_ty[j] != 12 && l2_ml_ty[j] != 17 && l2_ml_ty[j] != 18 && l2_ml_ty[j] != 19 && l2_ml_ty[j] != 20 && l2_ml_ty[j] != 22 && l2_ml_ty[j] != 24 && l2_ml_ty[j] != 25 && l2_ml_ty[j] != 26 && l2_ml_ty[j] != 27 && l2_ml_ty[j] != 31 && l2_ml_ty[j] < 100
                return: 3
            \out_j: l2_m_arity[mi] + l2_m_sn[mi] + j
            return: 0
