        return: 1
    if: l2_check_ret_tr(-1, path, l2_ret_tr(fr), main_node) != 0
        return: 1
    if: l2_dyn_close(path) != 0
        return: 1
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    i: 0
    while: i < l2_m_n
