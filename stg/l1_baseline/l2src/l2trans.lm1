return: -1

fn: l2_own_any (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_text_same(l2_own_name[i], t)
            return: i
