predef: "l1src/parser.lm1"
include: "<stdio.h>" "<string.h>" "<limits.h>"

# L2 -> L1 frontend: §1.7 main adapter, plus one two-int add leaf under §21.8.

@: LmP0Text l2_nm 0
@: LmP0Text l2_fa 0
@: LmP0Text l2_fb 0
@: LmP0Text l2_xa 0
@: LmP0Text l2_xb 0
@: LmP0Text l2_xr 0
int: l2_leaf_mode 0
unsigned: l2_sigv 0U
unsigned: l2_intern_n 0U
unsigned: l2_intern_again 0U
unsigned: l2_intern_swap 0U
unsigned: l2_intern_probe 0U
const: @: char l2_s1a 0
size_t: l2_s1na 0U
const: @: char l2_s1b 0
size_t: l2_s1nb 0U
const: @: char l2_s2a 0
size_t: l2_s2na 0U
const: @: char l2_s2b 0
size_t: l2_s2nb 0U
const: @: char l2_s3a 0
size_t: l2_s3na 0U
const: @: char l2_s3b 0
size_t: l2_s3nb 0U

prototype:
    fn: l2_parse_leaf (const: @(LmP0Node add_node); const: @(LmP0Node main_node); const: @(char path)) int
    fn: l2_emit_leaf (const: @(char out_path)) int
end: prototype

fn: l2_text_eq (const: @(LmP0Text text); const: @(char s)) int
    size_t: n
    if: text = 0 || s = 0
        return: 0
    n: c.strlen(s)
    if: text\data = 0
        return: n = 0U
return: text\length = n && c.memcmp(text\data, s, n) = 0

fn: l2_ignored (const: @(LmP0Node node)) int
    if: node = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_DISABLED
        return: 1
    if: (node\flags & c.LM_P0_NODE_INACTIVE) != 0U
        return: 1
return: 0

fn: l2_error (const: @(char path); const: @(LmP0Node node); const: @(char msg)) int
    size_t: line 1U
    size_t: column 1U
    if: node != 0 && node\span != 0
        line: node\span\line
        column: node\span\column
    if: path = 0
        path: ""
    c.fprintf(c.stderr, "l2trans error: %s:%zu:%zu: %s\n", path, line, column, msg)
return: 1

fn: l2_path_is_lm2 (const: @(char path)) int
    size_t: n
    if: path = 0
        return: 0
    n: c.strlen(path)
    if: n < 4U
        return: 0
    if: path[n - 4U] != 46
        return: 0
    if: path[n - 3U] != 108 && path[n - 3U] != 76
        return: 0
    if: path[n - 2U] != 109 && path[n - 2U] != 77
        return: 0
    if: path[n - 1U] != 50
        return: 0
return: 1

fn: l2_next_active (@: LmP0Field field) @: LmP0Field
    while: field != 0 && l2_ignored(field\value)
        field: field\next
return: field

fn: l2_count_active (const: @(LmP0Structure body)) int
    @: LmP0Field field
    int: n 0
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        n: n + 1
        field: l2_next_active(field\next)
return: n

fn: l2_digits (const: @(LmP0Text text)) int
    size_t: i
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    if: text\length > 1U && text\data[0] = 48
        return: 0
    i: 0U
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

fn: l2_int_fits (const: @(LmP0Text text)) int
    size_t: i
    int: acc 0
    int: d 0
    int: q
    int: r
    if: l2_digits(text) = 0
        return: 0
    q: c.INT_MAX / 10
    r: c.INT_MAX % 10
    i: 0U
    while: i < text\length
        d: text\data[i] - 48
        if: acc > q
            return: 0
        if: acc = q && d > r
            return: 0
        acc: acc * 10 + d
        i: i + 1U
return: 1

fn: l2_end_named (const: @(LmP0Frame frame); const: @(char name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(field\value\as\atom, name)

fn: l2_frame_head (const: @(LmP0Node node); const: @(char name)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 0
return: l2_text_eq(node\as\frame\head, name)

fn: l2_empty_struct (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_STRUCTURE || node\as = 0
        return: 0
return: l2_count_active(node\as\structure) = 0

fn: l2_quoted (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length < 2U
        return: 0
    if: t\data[0] != 34 || t\data[t\length - 1U] != 34
        return: 0
    if: t\length >= 6U && t\data[1] = 34 && t\data[2] = 34
        return: 0
return: 1

fn: l2_write_text (@: FILE out; const: @(LmP0Text t)) int
    if: out = 0 || t = 0 || t\data = 0
        return: 1
    if: t\length = 0U
        return: 0
    if: c.fwrite(t\data, 1U, t\length, out) != t\length
        return: 1
return: 0

fn: l2_check_puts (const: @(LmP0Node stmt); const: @(char path)) int
    const: @: LmP0Frame fr
    @: LmP0Field arg
    int: n
    if: l2_frame_head(stmt, "c.puts") = 0
        return: l2_error(path, stmt, "unsupported body")
    fr: stmt\as\frame
    if: fr\trailer != 0
        return: l2_error(path, stmt, "unsupported body")
    if: fr\body = 0
        return: l2_error(path, stmt, "unsupported argument")
    if: fr\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    n: l2_count_active(fr\body)
    if: n = 0
        return: l2_error(path, stmt, "unsupported argument")
    if: n != 1
        return: l2_error(path, stmt, "extra argument")
    arg: l2_next_active(fr\body\first_field)
    if: arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, stmt, "unsupported argument")
    if: l2_quoted(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "unsupported argument")
return: 0

fn: l2_take_return_stmt (const: @(LmP0Node stmt); const: @(char path); @@: LmP0Text out_lit) int
    const: @: LmP0Frame ret
    @: LmP0Field arg
    if: out_lit = 0
        return: l2_error(path, stmt, "internal: missing return slot")
    out_lit[0]: 0
    if: l2_frame_head(stmt, "return") = 0
        return: l2_error(path, stmt, "unsupported body")
    ret: stmt\as\frame
    if: ret\trailer != 0
        return: l2_error(path, stmt, "unsupported body")
    if: ret\body = 0 || l2_count_active(ret\body) != 1
        return: l2_error(path, stmt, "unsupported body")
    if: ret\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    arg: l2_next_active(ret\body\first_field)
    if: arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, stmt, "unsupported body")
    if: l2_digits(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "unsupported body")
    if: l2_int_fits(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "return literal not representable as int")
    out_lit[0]: arg\value\as\atom
return: 0

fn: l2_take_body (const: @(LmP0Node body_node); const: @(char path); @@: LmP0Text out_lit) int
    @: LmP0Field field
    @: LmP0Field nxt
    const: @: LmP0Node stmt
    if: out_lit = 0
        return: l2_error(path, body_node, "internal: missing return slot")
    out_lit[0]: 0
    if: body_node = 0 || body_node\kind != c.LM_P0_NODE_STRUCTURE || body_node\as = 0
        return: l2_error(path, body_node, "unsupported body")
    field: l2_next_active(body_node\as\structure\first_field)
    if: field = 0
        return: l2_error(path, body_node, "unsupported body")
    while: field != 0
        stmt: field\value
        nxt: l2_next_active(field\next)
        if: nxt = 0
            return: l2_take_return_stmt(stmt, path, out_lit)
        if: l2_frame_head(stmt, "return")
            return: l2_error(path, stmt, "unsupported body")
        if: l2_check_puts(stmt, path) != 0
            return: 1
        field: nxt
return: l2_error(path, body_node, "unsupported body")

fn: l2_take_main_lit (const: @(LmP0Node fn_node); const: @(char path); @@: LmP0Text out_lit; @@: LmP0Structure out_body) int
    @: LmP0Field field
    const: @: LmP0Frame fn_frame
    const: @: LmP0Node name
    const: @: LmP0Node params
    const: @: LmP0Node resty
    const: @: LmP0Node body
    if: out_body = 0
        return: l2_error(path, fn_node, "internal: missing body slot")
    out_body[0]: 0
    if: l2_frame_head(fn_node, "fn") = 0
        return: l2_error(path, fn_node, "unsupported body")
    fn_frame: fn_node\as\frame
    if: l2_end_named(fn_frame, "main") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fn_frame\body = 0 || l2_count_active(fn_frame\body) != 4
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(fn_frame\body\first_field)
    name: field\value
    if: name = 0 || name\kind != c.LM_P0_NODE_ATOM || l2_text_eq(name\as\atom, "main") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    params: field\value
    if: l2_empty_struct(params) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    resty: field\value
    if: resty = 0 || resty\kind != c.LM_P0_NODE_ATOM || l2_text_eq(resty\as\atom, "int") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: field\value
    if: l2_take_body(body, path, out_lit) != 0
        return: 1
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, fn_node, "unsupported body")
    out_body[0]: body\as\structure
return: 0

fn: l2_unit_from_root (const: @(LmP0Node root); const: @(char path); @@: LmP0Structure out_unit) int
    @: LmP0Field field
    const: @: LmP0Node item
    if: out_unit = 0
        return: l2_error(path, root, "internal: missing unit slot")
    out_unit[0]: 0
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE || root\as = 0 || root\as\structure = 0
        return: l2_error(path, root, "unsupported body")
    field: l2_next_active(root\as\structure\first_field)
    if: field = 0
        return: l2_error(path, root, "missing main")
    item: field\value
    if: l2_next_active(field\next) = 0 && l2_frame_head(item, "L2")
        if: l2_end_named(item\as\frame, "L2") = 0
            return: l2_error(path, item, "unsupported body")
        if: item\as\frame\body = 0
            return: l2_error(path, item, "missing main")
        out_unit[0]: item\as\frame\body
        return: 0
    if: l2_frame_head(item, "L1") || l2_frame_head(item, "L3")
        return: l2_error(path, item, "unsupported body")
    out_unit[0]: root\as\structure
return: 0

fn: l2_translate_unit (const: @(LmP0Structure unit); const: @(char path); @@: LmP0Text out_lit; @@: LmP0Structure out_body) int
    @: LmP0Field field
    @: LmP0Field nf
    @: LmP0Node item
    int: mains 0
    int: extras 0
    int: is_main 0
    @: LmP0Node main_node 0
    @: LmP0Node add_node 0
    if: out_lit = 0 || out_body = 0
        return: l2_error(path, 0, "internal: missing return slot")
    out_lit[0]: 0
    out_body[0]: 0
    l2_leaf_mode: 0
    if: unit = 0
        return: l2_error(path, 0, "missing main")
    if: unit\trailer != 0
        return: l2_error(path, 0, "unsupported trailer")
    field: l2_next_active(unit\first_field)
    while: field != 0
        item: field\value
        nf: 0
        is_main: 0
        if: l2_frame_head(item, "fn") != 0 && item\as\frame != 0 && item\as\frame\body != 0
            nf: l2_next_active(item\as\frame\body\first_field)
        if: nf != 0 && nf\value != 0 && nf\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(nf\value\as\atom, "main")
            is_main: 1
            mains: mains + 1
            main_node: item
        if: is_main = 0 && l2_frame_head(item, "fn") != 0 && add_node = 0
            add_node: item
        if: is_main = 0 && item != add_node
            extras: extras + 1
        field: l2_next_active(field\next)
    if: mains > 1
        return: l2_error(path, main_node, "several main")
    if: mains = 0
        return: l2_error(path, 0, "missing main")
    if: extras != 0
        return: l2_error(path, main_node, "unsupported body")
    if: add_node != 0
        return: l2_parse_leaf(add_node, main_node, path)
return: l2_take_main_lit(main_node, path, out_lit, out_body)

fn: l2_emit_puts_line (@: FILE out; const: @(LmP0Node stmt)) int
    @: LmP0Field arg
    arg: l2_next_active(stmt\as\frame\body\first_field)
    if: c.fputs("        c.puts: ", out) < 0
        return: 1
    if: l2_write_text(out, arg\value\as\atom) != 0
        return: 1
    if: c.fputs("\n", out) < 0
        return: 1
return: 0

fn: l2_emit_l1 (const: @(char out_path); const: @(LmP0Structure body); const: @(LmP0Text lit)) int
    @: FILE out
    @: LmP0Field field
    @: LmP0Field nxt
    int: puts_n 0
    if: out_path = 0 || body = 0 || lit = 0 || lit\data = 0 || lit\length = 0U
        return: 1
    field: l2_next_active(body\first_field)
    while: field != 0
        nxt: l2_next_active(field\next)
        if: nxt != 0
            puts_n: puts_n + 1
        field: nxt
    out: c.fopen(out_path, "wb")
    if: out = 0
        c.fprintf(c.stderr, "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: puts_n != 0 && c.fputs("include: \"<stdio.h>\"\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fputs("external:\n    fn: main () int\n", out) < 0
        c.fclose(out)
        return: 1
    field: l2_next_active(body\first_field)
    while: field != 0
        nxt: l2_next_active(field\next)
        if: nxt != 0 && l2_emit_puts_line(out, field\value) != 0
            c.fclose(out)
            return: 1
        field: nxt
    if: c.fputs("        return: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, lit) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("\n    end: main\nend: external\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fclose(out) != 0
        return: 1
return: 0

fn: l2_translate (const: @(char in_path); const: @(char out_path)) int
    @: LmP0Document document 0
    const: @: LmP0Diagnostic diagnostic
    const: @: LmP0Node root
    @: LmP0Structure unit 0
    @: LmP0Structure body 0
    @: LmP0Text lit 0
    int: status
    if: l2_path_is_lm2(in_path) = 0
        c.fprintf(c.stderr, "l2trans error: %s:1:1: expected a .lm2 source\n", in_path)
        return: 1
    status: lm_p0_parse_file(in_path, @ document)
    if: status != 0
        diagnostic: lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf(c.stderr, "l2trans parse error %d at %zu:%zu: %s\n", diagnostic\code, diagnostic\line, diagnostic\column, diagnostic\message)
        else:
            c.fprintf(c.stderr, "l2trans parse error: %s\n", in_path)
        lm_p0_document_destroy(document)
        return: 1
    root: lm_p0_document_root(document)
    if: l2_unit_from_root(root, in_path, @ unit) != 0
        lm_p0_document_destroy(document)
        return: 1
    if: l2_translate_unit(unit, in_path, @ lit, @ body) != 0
        lm_p0_document_destroy(document)
        return: 1
    if: l2_leaf_mode != 0
        status: l2_emit_leaf(out_path)
    else:
        status: l2_emit_l1(out_path, body, lit)
    lm_p0_document_destroy(document)
    if: status != 0
        return: 1
return: 0

# Parse/emit one two-int add leaf + typed call from §1.7 main.

fn: l2_ident (const: @(LmP0Text t)) int
    size_t: i
    unsigned: ch
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0
    ch: (cast: (unsigned) t\data[0])
    if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U)
        return: 0
    i: 1U
    while: i < t\length
        ch: (cast: (unsigned) t\data[i])
        if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U) && (ch < 48U || ch > 57U)
            return: 0
        i: i + 1U
    if: l2_text_eq(t, "main") || l2_text_eq(t, "fn") || l2_text_eq(t, "int") || l2_text_eq(t, "return")
        return: 0
return: 1

fn: l2_text_same (const: @(LmP0Text a); const: @(LmP0Text b)) int
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    if: a\length != b\length
        return: 0
return: c.memcmp(a\data, b\data, a\length) = 0

# Translator intern of the full canonical contract: L2_SIG_V0 schema
# plus exact ordered formal-name bytes. Method name is not interned.
# IDs are linked-unit intern slots, not inter-module canonicalization.
fn: l2_intern_pair (const: @(char a); size_t: na; const: @(char b); size_t: nb) unsigned
    if: a = 0 || b = 0 || na = 0U || nb = 0U
        return: 0U
    if: l2_intern_n >= 1U && na = l2_s1na && nb = l2_s1nb && c.memcmp(a, l2_s1a, na) = 0 && c.memcmp(b, l2_s1b, nb) = 0
        return: 1U
    if: l2_intern_n >= 2U && na = l2_s2na && nb = l2_s2nb && c.memcmp(a, l2_s2a, na) = 0 && c.memcmp(b, l2_s2b, nb) = 0
        return: 2U
    if: l2_intern_n >= 3U && na = l2_s3na && nb = l2_s3nb && c.memcmp(a, l2_s3a, na) = 0 && c.memcmp(b, l2_s3b, nb) = 0
        return: 3U
    if: l2_intern_n >= 3U
        return: 0U
    l2_intern_n: l2_intern_n + 1U
    if: l2_intern_n = 1U
        l2_s1a: a
        l2_s1na: na
        l2_s1b: b
        l2_s1nb: nb
        return: 1U
    if: l2_intern_n = 2U
        l2_s2a: a
        l2_s2na: na
        l2_s2b: b
        l2_s2nb: nb
        return: 2U
    l2_s3a: a
    l2_s3na: na
    l2_s3b: b
    l2_s3nb: nb
return: 3U

fn: l2_intern_prove (const: @(char path); const: @(LmP0Node node)) int
    unsigned: id
    if: l2_fa = 0 || l2_fb = 0 || l2_fa\data = 0 || l2_fb\data = 0
        return: l2_error(path, node, "intern missing formals")
    l2_intern_n: 0U
    l2_s1a: 0
    l2_s1na: 0U
    l2_s1b: 0
    l2_s1nb: 0U
    l2_s2a: 0
    l2_s2na: 0U
    l2_s2b: 0
    l2_s2nb: 0U
    l2_s3a: 0
    l2_s3na: 0U
    l2_s3b: 0
    l2_s3nb: 0U
    l2_intern_again: 0U
    l2_intern_swap: 0U
    l2_intern_probe: 0U
    id: l2_intern_pair(l2_fa\data, l2_fa\length, l2_fb\data, l2_fb\length)
    l2_intern_again: l2_intern_pair(l2_fa\data, l2_fa\length, l2_fb\data, l2_fb\length)
    if: id = 0U || l2_intern_again != id
        return: l2_error(path, node, "intern broken")
    if: l2_text_same(l2_fa, l2_fb) = 0
        l2_intern_swap: l2_intern_pair(l2_fb\data, l2_fb\length, l2_fa\data, l2_fa\length)
    if: l2_text_same(l2_fa, l2_fb) = 0 && (l2_intern_swap = 0U || l2_intern_swap = id)
        return: l2_error(path, node, "intern failed to distinguish swapped formals")
    l2_intern_probe: l2_intern_pair("a", 1U, "b", 1U)
    if: l2_text_eq(l2_fa, "a") && l2_text_eq(l2_fb, "b") && l2_intern_probe != id
        return: l2_error(path, node, "intern failed memcmp of equal names")
    if: (l2_text_eq(l2_fa, "a") = 0 || l2_text_eq(l2_fb, "b") = 0) && l2_intern_probe = id
        return: l2_error(path, node, "intern false-equal distinct contracts")
    l2_sigv: id
return: 0

fn: l2_end_text (const: @(LmP0Frame frame); const: @(LmP0Text name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0 || name = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_same(field\value\as\atom, name)

fn: l2_int_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_name[0]: 0
    if: node = 0 || node\as = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f\value = 0 || f\value\as = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    out_name[0]: f\value\as\atom
return: 0

fn: l2_parse_add_fn (const: @(LmP0Node fn_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node params
    const: @: LmP0Node body
    @: LmP0Field p0
    @: LmP0Field p1
    const: @: LmP0Node ret
    @: LmP0Field r0
    @: LmP0Field r1
    @: LmP0Field r2
    if: fn_node = 0 || fn_node\as = 0 || fn_node\as\frame = 0
        return: l2_error(path, fn_node, "unsupported body")
    fr: fn_node\as\frame
    if: fr\body = 0 || l2_count_active(fr\body) != 4
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_ident(field\value\as\atom) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    l2_nm: field\value\as\atom
    if: l2_end_text(fr, l2_nm) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    params: field\value
    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE || params\as = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: params\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    if: l2_count_active(params\as\structure) != 2
        return: l2_error(path, fn_node, "incompatible entry signature")
    p0: l2_next_active(params\as\structure\first_field)
    p1: l2_next_active(p0\next)
    if: l2_int_formal(p0\value, path, @ l2_fa) != 0
        return: 1
    if: l2_int_formal(p1\value, path, @ l2_fb) != 0
        return: 1
    field: l2_next_active(field\next)
    if: field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(field\value\as\atom, "int") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: field\value
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: body\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    if: l2_count_active(body\as\structure) != 1
        return: l2_error(path, fn_node, "unsupported body")
    ret: l2_next_active(body\as\structure\first_field)\value
    if: l2_frame_head(ret, "return") = 0
        return: l2_error(path, ret, "unsupported body")
    if: ret\as\frame\trailer != 0
        return: l2_error(path, ret, "unsupported trailer")
    if: ret\as\frame\body = 0 || ret\as\frame\body\trailer != 0
        return: l2_error(path, ret, "unsupported trailer")
    if: l2_count_active(ret\as\frame\body) != 3
        return: l2_error(path, ret, "unsupported body")
    r0: l2_next_active(ret\as\frame\body\first_field)
    r1: l2_next_active(r0\next)
    r2: l2_next_active(r1\next)
    if: r0\value = 0 || r1\value = 0 || r2\value = 0
        return: l2_error(path, ret, "unsupported body")
    if: r0\value\kind != c.LM_P0_NODE_ATOM || r1\value\kind != c.LM_P0_NODE_ATOM || r2\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, ret, "unsupported body")
    if: l2_text_eq(r1\value\as\atom, "+") = 0
        return: l2_error(path, ret, "unsupported body")
    if: l2_text_same(r0\value\as\atom, l2_fa) = 0
        return: l2_error(path, r0\value, "unresolved name")
    if: l2_text_same(r2\value\as\atom, l2_fb) = 0
        return: l2_error(path, r2\value, "unresolved name")
return: 0

fn: l2_parse_main_call (const: @(LmP0Node main_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node body
    const: @: LmP0Node ret
    @: LmP0Field r0
    @: LmP0Field r1
    @: LmP0Field r2
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    int: n
    if: main_node = 0 || main_node\as = 0 || main_node\as\frame = 0
        return: l2_error(path, main_node, "unsupported body")
    fr: main_node\as\frame
    if: l2_end_named(fr, "main") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    if: fr\body = 0 || l2_count_active(fr\body) != 4
        return: l2_error(path, main_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, main_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(field\value\as\atom, "main") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    if: l2_empty_struct(field\value) = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(field\value\as\atom, "int") = 0
        return: l2_error(path, main_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: field\value
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0
        return: l2_error(path, main_node, "unsupported body")
    if: body\as\structure\trailer != 0
        return: l2_error(path, main_node, "unsupported trailer")
    if: l2_count_active(body\as\structure) != 1
        return: l2_error(path, main_node, "unsupported body")
    ret: l2_next_active(body\as\structure\first_field)\value
    if: l2_frame_head(ret, "return") = 0
        return: l2_error(path, ret, "unsupported body")
    if: ret\as\frame\trailer != 0
        return: l2_error(path, ret, "unsupported trailer")
    if: ret\as\frame\body = 0 || ret\as\frame\body\trailer != 0
        return: l2_error(path, ret, "unsupported trailer")
    n: l2_count_active(ret\as\frame\body)
    r0: l2_next_active(ret\as\frame\body\first_field)
    if: r0 = 0 || r0\value = 0 || r0\value\kind != c.LM_P0_NODE_FRAME
        return: l2_error(path, ret, "unsupported body")
    call: r0\value\as\frame
    if: l2_text_same(call\head, l2_nm) = 0
        return: l2_error(path, r0\value, "unknown method")
    if: call\trailer != 0
        return: l2_error(path, r0\value, "unsupported trailer")
    if: call\body = 0
        return: l2_error(path, r0\value, "incompatible entry signature")
    if: call\body\trailer != 0
        return: l2_error(path, r0\value, "unsupported trailer")
    if: l2_count_active(call\body) != 2
        return: l2_error(path, r0\value, "incompatible entry signature")
    a0: l2_next_active(call\body\first_field)
    a1: l2_next_active(a0\next)
    if: a0\value = 0 || a1\value = 0 || a0\value\kind != c.LM_P0_NODE_ATOM || a1\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, r0\value, "incompatible entry signature")
    if: l2_digits(a0\value\as\atom) = 0 || l2_int_fits(a0\value\as\atom) = 0
        return: l2_error(path, a0\value, "incompatible entry signature")
    if: l2_digits(a1\value\as\atom) = 0 || l2_int_fits(a1\value\as\atom) = 0
        return: l2_error(path, a1\value, "incompatible entry signature")
    l2_xa: a0\value\as\atom
    l2_xb: a1\value\as\atom
    if: n = 1
        l2_xr: 0
        l2_leaf_mode: 2
        return: 0
    if: n != 3
        return: l2_error(path, ret, "unsupported body")
    r1: l2_next_active(r0\next)
    r2: l2_next_active(r1\next)
    if: r1\value = 0 || r2\value = 0 || r1\value\kind != c.LM_P0_NODE_ATOM || r2\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, ret, "unsupported body")
    if: l2_text_eq(r1\value\as\atom, "!=") = 0
        return: l2_error(path, ret, "unsupported body")
    if: l2_digits(r2\value\as\atom) = 0 || l2_int_fits(r2\value\as\atom) = 0
        return: l2_error(path, r2\value, "unsupported body")
    l2_xr: r2\value\as\atom
    l2_leaf_mode: 1
return: 0

fn: l2_parse_leaf (const: @(LmP0Node add_node); const: @(LmP0Node main_node); const: @(char path)) int
    l2_nm: 0
    l2_fa: 0
    l2_fb: 0
    l2_xa: 0
    l2_xb: 0
    l2_xr: 0
    l2_leaf_mode: 0
    l2_sigv: 0U
    if: l2_parse_add_fn(add_node, path) != 0
        return: 1
    if: l2_parse_main_call(main_node, path) != 0
        return: 1
    if: l2_intern_prove(path, add_node) != 0
        return: 1
return: 0

fn: l2_emit_leaf (const: @(char out_path)) int
    @: FILE out
    if: out_path = 0 || l2_nm = 0 || l2_fa = 0 || l2_fb = 0 || l2_xa = 0 || l2_xb = 0
        return: 1
    out: c.fopen(out_path, "wb")
    if: out = 0
        c.fprintf(c.stderr, "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: c.fputs("predef: \"l2src/lmx_branch.lm1\"\ninclude: \"l2src/lmx.h\" \"<stdio.h>\" \"<stdlib.h>\" \"<string.h>\"\n\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fputs("# interned contract: rec.sig is translator intern id of the full canonical contract.\n# L2_SIG_V0: node + 2 required int formals by value + int result + throws-none + no dyn/varargs.\n# Mapping: id 1 := L2_SIG_V0 + exact ordered formals l2_sig_f0, l2_sig_f1. Method name is not in the contract.\n# Linked-program intern only, not inter-module canonicalization.\n# Runtime: no memcmp; closed-singleton lowering. Formal names are the intern entry for rec.sig.\nconst: @(char l2_sig_f0) \"", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_fa) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("\"\nconst: @(char l2_sig_f1) \"", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_fb) != 0
        c.fclose(out)
        return: 1
    if: c.fprintf(out, "\"\nunsigned: l2_intern_id %uU\nunsigned: l2_intern_again %uU\nunsigned: l2_intern_swap %uU\nunsigned: l2_intern_probe %uU\n\nfn: ", l2_sigv, l2_intern_again, l2_intern_swap, l2_intern_probe) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_nm) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(" (@: Lmx node; int: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_fa) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("; int: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_fb) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(") int\n    if: node = 0\n        return: 0\n    return: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_fa) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(" + ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_fb) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("\nend: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_nm) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("\n\nexternal:\n    fn: main () int\n        @: Lmx unit 0\n        @: Lmx leaf 0\n        @: LmxMethod rec 0\n        int: got\n        if: lmx_ranges_init(8U) != 0\n            return: 1\n        rec: (cast: (@: LmxMethod) c.malloc(c.sizeof(c.LmxMethod)))\n        if: rec = 0\n            return: 1\n        rec\\addr: (cast: (LmxEntry) ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_nm) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(")\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fprintf(out, "        rec\\sig: %uU\n", l2_sigv) < 0
        c.fclose(out)
        return: 1
    if: c.fputs("        if: lmx_range_register((cast: (@: void) rec), (cast: (@: void) (rec + 1)), c.sizeof(c.LmxMethod), c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD) != 0\n            return: 1\n        unit: (cast: (@: Lmx) c.malloc(c.sizeof(c.Lmx)))\n        if: unit = 0\n            return: 1\n        lmx_cell_init(unit, 0, 0)\n        if: lmx_branch_open(unit, 1U) != 0\n            return: 1\n        leaf: lmx_branch_child(unit, 0U)\n        if: leaf = 0\n            return: 1\n        leaf\\data: (cast: (@: void) rec)\n        if: lmx_classify(leaf\\data) != c.LMX_KIND_METHOD\n            return: 1\n        if: rec\\sig != l2_intern_id\n            return: 1\n        if: l2_intern_again != l2_intern_id\n            return: 1\n        if: l2_sig_f0[0] = 0 || l2_sig_f1[0] = 0\n            return: 1\n        if: leaf\\node != unit\n            return: 1\n        # Closed-singleton devirtualization: one leaf, no calls or graph mutations between construction and invoke; translator bound the occurrence. rec.addr is METHOD-domain storage, not the call. Not general dynamic dispatch from the record. Runtime does not memcmp formals; rec.sig is the interned id of this unit's intern entry.\n        got: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_nm) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("(leaf\\node, ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_xa) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(", ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, l2_xb) != 0
        c.fclose(out)
        return: 1
    if: c.fputs(")\n", out) < 0
        c.fclose(out)
        return: 1
    if: l2_leaf_mode = 2 && c.fputs("        return: got\n", out) < 0
        c.fclose(out)
        return: 1
    if: l2_leaf_mode != 2 && c.fputs("        return: got != ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_leaf_mode != 2 && l2_write_text(out, l2_xr) != 0
        c.fclose(out)
        return: 1
    if: l2_leaf_mode != 2 && c.fputs("\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fputs("    end: main\nend: external\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fclose(out) != 0
        return: 1
return: 0

external:
    fn: main (int: argc; @@: char argv) int
        c.setvbuf(c.stdout, 0, c._IONBF, 0)
        c.setvbuf(c.stderr, 0, c._IONBF, 0)
        if: argc != 3
            c.fputs("usage: l2trans.exe <source.lm2> <output.lm1>\n", c.stderr)
            return: 1
    return: l2_translate(argv[1], argv[2])
end: external
