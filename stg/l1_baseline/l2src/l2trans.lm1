return: 0

fn: l2_loc_add (const: @(LmP0Text t); int: ty; const: @(char path); const: @(LmP0Node at)) int
    int: cap
    size_t: nb
    size_t: ni
    size_t: psz
    @@: LmP0Text nn 0
    @: int nt 0
    if: t = 0 || l2_ident(t) = 0
        return: l2_error(path, at, "unsupported body")
    if: l2_loc_find(t) >= 0 || l2_entry_find(t) >= 0
        return: l2_error(path, at, "duplicate formal")
    cap: l2_loc_cap
    if: l2_loc_n >= cap
        if: cap < 1
            cap: 4
        ---
        if: cap > (c.INT_MAX / 2)
            return: l2_error(path, at, "size overflow")
        cap: cap * 2
        psz: c.sizeof(l2_ptr_probe)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0 || l2_mul_ok((cast: (size_t) cap), c.sizeof(c.int)) = 0
            return: l2_error(path, at, "size overflow")
        nb: (cast: (size_t) cap) * psz
        ni: (cast: (size_t) cap) * c.sizeof(c.int)
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        nt: (cast: (@: int) l2_xmalloc(ni))
        if: nn = 0 || nt = 0
            if: nn != 0
                l2_xfree((cast: (@: void) nn))
            ---
            if: nt != 0
                l2_xfree((cast: (@: void) nt))
            ---
            return: l2_error(path, at, "out of memory")
        c.memset((cast: (@: void) nn), 0, nb)
        c.memset((cast: (@: void) nt), 0, ni)
        if: l2_loc_nm != 0 && l2_loc_n > 0
            c.memcpy((cast: (@: void) nn), (cast: (@: void) l2_loc_nm), (cast: (size_t) l2_loc_n) * psz)
        ---
        if: l2_loc_ty != 0 && l2_loc_n > 0
            c.memcpy((cast: (@: void) nt), (cast: (@: void) l2_loc_ty), (cast: (size_t) l2_loc_n) * c.sizeof(c.int))
        ---
        if: l2_loc_nm != 0
            l2_xfree((cast: (@: void) l2_loc_nm))
        ---
        if: l2_loc_ty != 0
            l2_xfree((cast: (@: void) l2_loc_ty))
        ---
        l2_loc_nm: nn
        l2_loc_ty: nt
        l2_loc_cap: cap
    ---
    l2_loc_nm[l2_loc_n]: (cast: (@: LmP0Text) t)
    l2_loc_ty[l2_loc_n]: ty
    l2_loc_n: l2_loc_n + 1
return: 0

fn: l2_take_predef (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field f
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported argument")
    if: l2_count_active(item\as\frame\body) != 1
        return: l2_error(path, item, "unsupported argument")
    f: l2_next_active(item\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_quoted(f\value\as\atom) = 0
        return: l2_error(path, item, "unsupported argument")
return: l2_pd_push(f\value\as\atom, path, item)

fn: l2_take_define (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field f
    int: n 0
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0 || item\as\frame\trailer != 0 || item\as\frame\body\trailer != 0
        return: l2_error(path, item, "unsupported argument")
    f: l2_next_active(item\as\frame\body\first_field)
    while: f != 0
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, item, "define accepts flat L1 tokens")
        n: n + 1
        f: l2_next_active(f\next)
    ---
    if: n < 2
        return: l2_error(path, item, "unsupported argument")
return: l2_def_push(item, path)

fn: l2_write_defines (@: FILE out) int
    int: i 0
    @: LmP0Field f
    if: out = 0
        return: 1
    while: i < l2_def_n
        if: c.fputs("define:", out) < 0
            return: 1
        f: l2_next_active(l2_def[i]\as\frame\body\first_field)
        while: f != 0
            if: c.fputs(" ", out) < 0 || l2_write_text(out, f\value\as\atom) != 0
                return: 1
            f: l2_next_active(f\next)
        ---
        if: c.fputs("\n", out) < 0
            return: 1
        i: i + 1
    ---
    if: l2_def_n != 0 && c.fputs("\n", out) < 0
        return: 1
return: 0

fn: l2_take_include (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field f
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported argument")
    f: l2_next_active(item\as\frame\body\first_field)
    if: f = 0
        return: l2_error(path, item, "unsupported argument")
    while: f != 0
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_quoted(f\value\as\atom) = 0
            return: l2_error(path, item, "unsupported argument")
        if: l2_inc_push(f\value\as\atom, path, item) != 0
            return: 1
        f: l2_next_active(f\next)
return: 0

fn: l2_foreign_free () int
    if: l2_foreign_name != 0
        l2_xfree((cast: (@: void) l2_foreign_name))
    if: l2_foreign_depth != 0
        l2_xfree((cast: (@: void) l2_foreign_depth))
    if: l2_foreign_const != 0
        l2_xfree((cast: (@: void) l2_foreign_const))
    l2_foreign_name: 0
    l2_foreign_depth: 0
    l2_foreign_const: 0
    l2_foreign_n: 0
    l2_foreign_cap: 0
return: 0

# Does a predef'd header declare this name with fnptr:? The answer is the C
# ABI's, not ours: a function-pointer local can only be typed by a disposer the
# header already names.
fn: l2_predef_has_fnptr (const: @(LmP0Text name)) int
    int: r
    l2_want_fnptr: 1
    r: l2_predef_has_type(name)
    l2_want_fnptr: 0
    if: r = 0
        return: 0
    # struct: and fnptr: share the walk, so a name that is a STRUCT is not a
    # function pointer and must not be mistaken for one.
    if: l2_predef_has_type(name) != 0
        return: 0
return: 1

fn: l2_predef_file_has_type (const: @(LmP0Text name); const: @(LmP0Text quoted)) int
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field first
    @: LmP0Node item
    @: LmP0Field inc
    @: LmP0Text q
    @: LmP0Text mapped 0
    @: char mapped_data 0
    int: found 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    c.memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: (l2_frame_head(item, "struct") || (l2_want_fnptr != 0 && l2_frame_head(item, "fnptr"))) && item\as\frame\body != 0
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && (l2_text_same(first\value\as\atom, name) || (name\length > 2U && name\data[0] = 99 && name\data[1] = 46 && first\value\as\atom\length = name\length - 2U && c.memcmp(first\value\as\atom\data, name\data + 2U, name\length - 2U) = 0))
                        found: 1
                    ---
                ---
                # A predef header may reuse another header's ABI declaration.
                # Follow that declared closure instead of forcing every L2 unit
                # to repeat aggregate layouts. Header cycles are invalid input,
                # just as they are for the downstream L1 predef walk.
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_has_type(name, first\value\as\atom)
                    ---
                ---
                # Generated L1 headers use foo.lm1.h while their source header
                # unit is foo.h.lm1. Follow that source edge too; pointer ABI
                # lookup needs no C layout parser and the downstream L1/C
                # compiler remains the final spelling check.
                if: found = 0 && l2_frame_head(item, "include") && item\as\frame\body != 0
                    inc: l2_next_active(item\as\frame\body\first_field)
                    while: inc != 0 && found = 0
                        if: inc\value != 0 && inc\value\kind = c.LM_P0_NODE_ATOM
                            q: inc\value\as\atom
                            # A plain C header reached through this predef header -- not a generated
                            # foo.lm1.h, not a <system> header -- is where the manager declares its
                            # aggregate handles (typedef struct X X;). The unit-level include list only
                            # holds the unit's OWN includes, so without this a type one level down was
                            # never scanned and came back "unknown foreign type".
                            if: found = 0 && q != 0 && q\data != 0 && q\length > 3U && q\data[0] = 34 && q\data[1] != 60 && (q\length <= 8U || c.memcmp(q\data + q\length - 7U, ".lm1.h\"", 7U) != 0)
                                found: l2_c_header_chain_has_typedef(name, q)
                            if: q != 0 && q\data != 0 && q\length > 8U && q\data[0] = 34 && c.memcmp(q\data + q\length - 7U, ".lm1.h\"", 7U) = 0
                                mapped_data: (cast: (@: char) l2_xmalloc(q\length + 1U))
                                mapped: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
                                if: mapped_data != 0 && mapped != 0
                                    c.memcpy(mapped_data, q\data, q\length)
                                    c.memcpy(mapped_data + q\length - 7U, ".h.lm1\"", 7U)
                                    mapped_data[q\length]: 0
                                    mapped\data: mapped_data
                                    mapped\length: q\length
                                    found: l2_predef_file_has_type(name, mapped)
                                    l2_xfree((cast: (@: void) mapped_data))
                                    l2_xfree((cast: (@: void) mapped))
                                    mapped_data: 0
                                    mapped: 0
                                ---
                                if: mapped_data != 0
                                    l2_xfree((cast: (@: void) mapped_data))
                                if: mapped != 0
                                    l2_xfree((cast: (@: void) mapped))
                                ---
                            ---
                        ---
                        inc: l2_next_active(inc\next)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

fn: l2_predef_has_type (const: @(LmP0Text name)) int
    int: i 0
    if: name = 0
        return: 0
    while: i < l2_pd_n
        if: l2_predef_file_has_type(name, l2_pd[i]) != 0
            return: 1
        i: i + 1
    ---
return: l2_include_has_simple_typedef(name)

# A quoted C include may contribute an ABI typedef such as
# `typedef unsigned char MixaU8;` or `typedef struct X { ... } X;`. L2 only
# needs its spelling for pointer, array and cast emission; field layout and the
# final ABI stay under the downstream C compiler. Function and array typedefs
# remain excluded because their declarators are not plain type names.
fn: l2_list_has_simple_typedef (const: @(LmP0Text name); @@: LmP0Text list; int: count) int
    int: ii 0
    size_t: want_at 0U
    size_t: want_n
    size_t: pn
    @: char path 0
    @: FILE file 0
    long: file_size
    size_t: n
    @: char data 0
    size_t: got
    size_t: p
    size_t: q
    size_t: last_at
    size_t: last_n
    int: bad
    int: saw_unsigned
    int: saw_char
    int: braces
    if: name = 0 || name\data = 0
        return: 0
    want_n: name\length
    if: want_n > 2U && name\data[0] = 99 && name\data[1] = 46
        want_at: 2U
        want_n: want_n - 2U
    ---
    while: ii < count
        if: list[ii] != 0 && list[ii]\data != 0 && list[ii]\length >= 2U && list[ii]\data[0] = 34 && list[ii]\data[list[ii]\length - 1U] = 34
            pn: list[ii]\length - 2U
            path: (cast: (@: char) l2_xmalloc(pn + 1U))
            if: path = 0
                return: 0
            c.memcpy(path, list[ii]\data + 1U, pn)
            path[pn]: 0
            file: c.fopen(path, "rb")
            if: file != 0 && c.fseek(file, 0L, c.SEEK_END) = 0
                file_size: c.ftell(file)
                if: file_size >= 0L && c.fseek(file, 0L, c.SEEK_SET) = 0
                    n: (cast: (size_t) file_size)
                    data: (cast: (@: char) l2_xmalloc(n + 1U))
                    if: data != 0
                        got: c.fread(data, 1U, n, file)
                        data[got]: 0
                        p: 0U
                        while: p + 7U <= got
                            if: c.memcmp(data + p, "typedef", 7U) = 0 && (p = 0U || ((data[p - 1U] < 48 || data[p - 1U] > 57) && (data[p - 1U] < 65 || data[p - 1U] > 90) && (data[p - 1U] < 97 || data[p - 1U] > 122) && data[p - 1U] != 95)) && (p + 7U = got || ((data[p + 7U] < 48 || data[p + 7U] > 57) && (data[p + 7U] < 65 || data[p + 7U] > 90) && (data[p + 7U] < 97 || data[p + 7U] > 122) && data[p + 7U] != 95))
                                q: p + 7U
                                last_at: 0U
                                last_n: 0U
                                bad: 0
                                saw_unsigned: 0
                                saw_char: 0
                                braces: 0
                                while: q < got && (data[q] != 59 || braces != 0)
                                    if: data[q] = 123
                                        braces: braces + 1
                                    if: data[q] = 125
                                        if: braces = 0
                                            bad: 1
                                        else:
                                            braces: braces - 1
                                        ---
                                    if: braces = 0 && (data[q] = 40 || data[q] = 41 || data[q] = 91 || data[q] = 93)
                                        bad: 1
                                    if: (data[q] >= 65 && data[q] <= 90) || (data[q] >= 97 && data[q] <= 122) || data[q] = 95
                                        last_at: q
                                        q: q + 1U
                                        while: q < got && ((data[q] >= 48 && data[q] <= 57) || (data[q] >= 65 && data[q] <= 90) || (data[q] >= 97 && data[q] <= 122) || data[q] = 95)
                                            q: q + 1U
                                        ---
                                        last_n: q - last_at
                                        if: last_n = 8U && c.memcmp(data + last_at, "unsigned", 8U) = 0
                                            saw_unsigned: 1
                                        ---
                                        if: last_n = 4U && c.memcmp(data + last_at, "char", 4U) = 0
                                            saw_char: 1
                                        ---
                                    else:
                                        q: q + 1U
                                    ---
                                ---
                                if: q < got && data[q] = 59 && braces = 0 && bad = 0 && last_n = want_n && c.memcmp(data + last_at, name\data + want_at, want_n) = 0
                                    l2_xfree((cast: (@: void) data))
                                    c.fclose(file)
                                    l2_xfree((cast: (@: void) path))
                                    if: saw_unsigned != 0 && saw_char != 0
                                        return: 8
                                    return: 1
                                ---
                                p: q
                            ---
                            p: p + 1U
                        ---
                        l2_xfree((cast: (@: void) data))
                    ---
                ---
            ---
            if: file != 0
                c.fclose(file)
            l2_xfree((cast: (@: void) path))
            path: 0
            file: 0
        ---
        ii: ii + 1
    ---
return: 0

fn: l2_include_has_simple_typedef (const: @(LmP0Text name)) int
return: l2_list_has_simple_typedef(name, l2_inc, l2_inc_n)

# Has this C header path already been walked during the current query?
fn: l2_hdr_seen_has (const: @(char path)) int
    int: i 0
    if: path = 0
        return: 1
    while: i < l2_hdr_seen_n
        if: l2_hdr_seen[i] != 0 && c.strcmp(l2_hdr_seen[i], path) = 0
            return: 1
        i: i + 1
    ---
return: 0

# Record a walked path. Grows by doubling. An allocation failure reports the
# path as already seen, which ends the walk instead of looping.
fn: l2_hdr_seen_add (const: @(char path)) int
    int: cap
    size_t: psz
    size_t: nb
    size_t: n
    @@: char nn 0
    @: char saved 0
    if: path = 0
        return: 1
    cap: l2_hdr_seen_cap
    if: l2_hdr_seen_n >= cap
        if: cap < 1
            cap: 4
        ---
        if: cap > (c.INT_MAX / 2)
            return: 1
        cap: cap * 2
        psz: c.sizeof(l2_ptr_probe)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0
            return: 1
        nb: (cast: (size_t) cap) * psz
        nn: (cast: (@@: char) l2_xmalloc(nb))
        if: nn = 0
            return: 1
        c.memset((cast: (@: void) nn), 0, nb)
        if: l2_hdr_seen != 0 && l2_hdr_seen_n > 0
            c.memcpy((cast: (@: void) nn), (cast: (@: void) l2_hdr_seen), (cast: (size_t) l2_hdr_seen_n) * psz)
        ---
        if: l2_hdr_seen != 0
            l2_xfree((cast: (@: void) l2_hdr_seen))
        ---
        l2_hdr_seen: nn
        l2_hdr_seen_cap: cap
    ---
    n: c.strlen(path)
    saved: (cast: (@: char) l2_xmalloc(n + 1U))
    if: saved = 0
        return: 1
    c.memcpy(saved, path, n + 1U)
    l2_hdr_seen[l2_hdr_seen_n]: saved
    l2_hdr_seen_n: l2_hdr_seen_n + 1
return: 0

# Look for a simple typedef in one C header and, failing that, in the quoted
# headers it #includes, transitively. Each path is walked once per query, so
# two headers that include each other under guards terminate.
fn: l2_c_header_walk (const: @(LmP0Text name); const: @(char path); int: want_fn) int
    size_t: pn
    @: char quoted 0
    @: LmP0Text qt 0
    int: r 0
    @: FILE file 0
    long: file_size
    size_t: n
    @: char data 0
    size_t: got
    size_t: p
    size_t: s
    size_t: e
    @: char child 0
    if: name = 0 || path = 0
        return: 0
    if: l2_hdr_seen_has(path) != 0
        return: 0
    if: l2_hdr_seen_add(path) != 0
        return: 0
    pn: c.strlen(path)
    quoted: (cast: (@: char) l2_xmalloc(pn + 3U))
    qt: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: quoted != 0 && qt != 0
        quoted[0]: 34
        c.memcpy(quoted + 1U, path, pn)
        quoted[pn + 1U]: 34
        quoted[pn + 2U]: 0
        qt\data: quoted
        qt\length: pn + 2U
        r: l2_list_has_simple_typedef(name, @ qt, 1)
    ---
    if: quoted != 0
        l2_xfree((cast: (@: void) quoted))
    if: qt != 0
        l2_xfree((cast: (@: void) qt))
    if: r != 0
        return: r
    file: c.fopen(path, "rb")
    if: file = 0
        return: 0
    if: c.fseek(file, 0L, c.SEEK_END) != 0
        c.fclose(file)
        return: 0
    file_size: c.ftell(file)
    if: file_size < 0L || c.fseek(file, 0L, c.SEEK_SET) != 0
        c.fclose(file)
        return: 0
    n: (cast: (size_t) file_size)
    data: (cast: (@: char) l2_xmalloc(n + 1U))
    if: data = 0
        c.fclose(file)
        return: 0
    got: c.fread(data, 1U, n, file)
    data[got]: 0
    c.fclose(file)
    p: 0U
    while: p < got && r = 0
        s: p
        while: s < got && (data[s] = 32 || data[s] = 9)
            s: s + 1U
        if: s < got && data[s] = 35
            s: s + 1U
            while: s < got && (data[s] = 32 || data[s] = 9)
                s: s + 1U
            if: s + 7U <= got && c.memcmp(data + s, "include", 7U) = 0
                s: s + 7U
                while: s < got && (data[s] = 32 || data[s] = 9)
                    s: s + 1U
                if: s < got && data[s] = 34
                    s: s + 1U
                    e: s
                    while: e < got && data[e] != 34 && data[e] != 10
                        e: e + 1U
                    if: e < got && data[e] = 34 && e > s
                        child: (cast: (@: char) l2_xmalloc(e - s + 1U))
                        if: child != 0
                            c.memcpy(child, data + s, e - s)
                            child[e - s]: 0
                            r: l2_c_header_walk(name, child, want_fn)
                            l2_xfree((cast: (@: void) child))
                            child: 0
                        ---
                    ---
                ---
            ---
        ---
        while: p < got && data[p] != 10
            p: p + 1U
        if: p < got
            p: p + 1U
    ---
    l2_xfree((cast: (@: void) data))
return: r

# Walk a quoted C header and every quoted header it #includes, once each, for a
# simple typedef named `name`. The seen-set exists only for this one query and
# is released before returning, so no allocation outlives the lookup.
fn: l2_c_header_chain_has (const: @(LmP0Text name); const: @(LmP0Text quoted); int: want_fn) int
    size_t: n
    @: char path 0
    int: r 0
    int: i 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 3U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    c.memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    l2_hdr_seen_n: 0
    r: l2_c_header_walk(name, path, want_fn)
    l2_xfree((cast: (@: void) path))
    while: i < l2_hdr_seen_n
        if: l2_hdr_seen[i] != 0
            l2_xfree((cast: (@: void) l2_hdr_seen[i]))
        ---
        i: i + 1
    ---
    if: l2_hdr_seen != 0
        l2_xfree((cast: (@: void) l2_hdr_seen))
    ---
    l2_hdr_seen: 0
    l2_hdr_seen_n: 0
    l2_hdr_seen_cap: 0
return: r

fn: l2_c_header_chain_has_typedef (const: @(LmP0Text name); const: @(LmP0Text quoted)) int
return: l2_c_header_chain_has(name, quoted, 0)

fn: l2_cnt_keep (const: @(LmP0Text src)) @: LmP0Text
    int: i 0
    int: cap
    size_t: psz
    size_t: nb
    size_t: len
    @@: LmP0Text nn 0
    @: LmP0Text kept 0
    @: char bytes 0
    if: src = 0 || src\data = 0 || src\length = 0U
        return: 0
    while: i < l2_cnt_n
        if: l2_text_same(l2_cnt[i], src)
            return: l2_cnt[i]
        i: i + 1
    ---
    cap: l2_cnt_cap
    if: l2_cnt_n >= cap
        if: cap < 1
            cap: 4
        ---
        if: cap > (c.INT_MAX / 2)
            return: 0
        cap: cap * 2
        psz: c.sizeof(l2_ptr_probe)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0
            return: 0
        nb: (cast: (size_t) cap) * psz
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        if: nn = 0
            return: 0
        c.memset((cast: (@: void) nn), 0, nb)
        if: l2_cnt != 0 && l2_cnt_n > 0
            c.memcpy((cast: (@: void) nn), (cast: (@: void) l2_cnt), (cast: (size_t) l2_cnt_n) * psz)
        ---
        if: l2_cnt != 0
            l2_xfree((cast: (@: void) l2_cnt))
        ---
        l2_cnt: nn
        l2_cnt_cap: cap
    ---
    len: src\length
    bytes: (cast: (@: char) l2_xmalloc(len + 1U))
    kept: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: bytes = 0 || kept = 0
        if: bytes != 0
            l2_xfree((cast: (@: void) bytes))
        ---
        if: kept != 0
            l2_xfree((cast: (@: void) kept))
        ---
        return: 0
    ---
    c.memcpy(bytes, src\data, len)
    bytes[len]: 0
    kept\data: bytes
    kept\length: len
    l2_cnt[l2_cnt_n]: kept
    l2_cnt_n: l2_cnt_n + 1
return: kept

fn: l2_cnt_free () int
    int: i 0
    while: i < l2_cnt_n
        if: l2_cnt[i] != 0
            if: l2_cnt[i]\data != 0
                l2_xfree((cast: (@: void) l2_cnt[i]\data))
            ---
            l2_xfree((cast: (@: void) l2_cnt[i]))
        ---
        i: i + 1
    ---
    if: l2_cnt != 0
        l2_xfree((cast: (@: void) l2_cnt))
    ---
    l2_cnt: 0
    l2_cnt_n: 0
    l2_cnt_cap: 0
return: 0

# A top-level `define: NAME <literal>` in a predef'd .h.lm1, or in a .h.lm1 that
# one predefs (the same single-file predef closure l2_predef_file_has_type
# follows). The literal is kept, because this document is destroyed here.
fn: l2_predef_file_define (const: @(LmP0Text name); const: @(LmP0Text quoted)) @: LmP0Text
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field first
    @: LmP0Field second
    @: LmP0Node item
    @: LmP0Text found 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    c.memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: l2_frame_head(item, "define") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 2
                    first: l2_next_active(item\as\frame\body\first_field)
                    second: 0
                    if: first != 0
                        second: l2_next_active(first\next)
                    ---
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(first\value\as\atom, name) && second != 0 && second\value != 0 && second\value\kind = c.LM_P0_NODE_ATOM && l2_array_count_is(second\value\as\atom) != 0
                        found: l2_cnt_keep(second\value\as\atom)
                    ---
                ---
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_define(name, first\value\as\atom)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

# An own-array count written as a name resolves to the literal its define: gives:
# the unit's own defines first -- those nodes live as long as the unit document
# the [] statement itself belongs to -- then the unit's predef chain. Only a
# literal value resolves; a define of another name stays refused.
fn: l2_define_count (const: @(LmP0Text name)) @: LmP0Text
    int: i 0
    @: LmP0Field first
    @: LmP0Field second
    @: LmP0Text r 0
    if: name = 0 || l2_ident(name) = 0
        return: 0
    while: i < l2_def_n
        if: l2_def[i] != 0 && l2_def[i]\as != 0 && l2_def[i]\as\frame != 0 && l2_def[i]\as\frame\body != 0 && l2_count_active(l2_def[i]\as\frame\body) = 2
            first: l2_next_active(l2_def[i]\as\frame\body\first_field)
            second: 0
            if: first != 0
                second: l2_next_active(first\next)
            ---
            if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(first\value\as\atom, name) && second != 0 && second\value != 0 && second\value\kind = c.LM_P0_NODE_ATOM && l2_array_count_is(second\value\as\atom) != 0
                return: second\value\as\atom
            ---
        ---
        i: i + 1
    ---
    i: 0
    while: i < l2_pd_n && r = 0
        r: l2_predef_file_define(name, l2_pd[i])
        i: i + 1
    ---
return: r
fn: l2_predef_file_has_function (const: @(LmP0Text name); const: @(LmP0Text quoted)) int
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field pf
    @: LmP0Field nf
    @: LmP0Field first
    @: LmP0Node item
    @: LmP0Node decl
    int: found 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    c.memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: l2_frame_head(item, "prototype") && item\as\frame\body != 0
                    pf: l2_next_active(item\as\frame\body\first_field)
                    while: pf != 0 && found = 0
                        decl: pf\value
                        if: (l2_frame_head(decl, "fn") || l2_frame_head(decl, "sub")) && decl\as\frame\body != 0
                            nf: l2_next_active(decl\as\frame\body\first_field)
                            if: nf != 0 && nf\value != 0 && nf\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(nf\value\as\atom, name)
                                found: 1
                            ---
                        ---
                        pf: l2_next_active(pf\next)
                    ---
                ---
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_has_function(name, first\value\as\atom)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

# Functions declared by a predef header are external ABI leaves. They are not
# callable Structures owned by this unit, so calls go through the ordinary C
# seam while the generated predef header supplies the checked prototype.
fn: l2_predef_has_function (const: @(LmP0Text name)) int
    int: i 0
    if: name = 0
        return: 0
    while: i < l2_pd_n
        if: l2_predef_file_has_function(name, l2_pd[i]) != 0
            return: 1
        i: i + 1
    ---
return: 0

fn: l2_address_depth (const: @(LmP0Text head)) int
    size_t: i 0U
    if: head = 0 || head\data = 0 || head\length = 0U || head\length > (cast: (size_t) c.INT_MAX)
        return: 0
    while: i < head\length
        if: head\data[i] != 64
            return: 0
        i: i + 1U
return: (cast: (int) head\length)

fn: l2_emit_address_marks (@: FILE out; int: depth) int
    int: i 0
    if: out = 0 || depth < 1
        return: 1
    while: i < depth
        if: c.fputc(64, out) = c.EOF
            return: 1
        i: i + 1
return: 0

fn: l2_foreign_intern (const: @(LmP0Text name); int: depth; int: is_const) int
    int: i 0
    int: cap
    size_t: nb
    @@: LmP0Text nn 0
    @: int nd 0
    @: int nc 0
    if: name = 0 || l2_ident(name) = 0 || depth < 1
        return: 0 - 1
    # wchar_t is supplied by the platform headers and is a real C scalar
    # typedef, so it has no L1 struct/typedef declaration in a predef unit.
    if: l2_predef_has_type(name) = 0 && l2_include_has_simple_typedef(name) = 0 && l2_text_eq(name, "wchar_t") = 0 && l2_text_eq(name, "void") = 0 && l2_text_eq(name, "char") = 0 && l2_text_eq(name, "int") = 0 && l2_text_eq(name, "size_t") = 0 && l2_text_eq(name, "unsigned") = 0 && l2_text_eq(name, "FILE") = 0
        return: 0 - 2
    while: i < l2_foreign_n
        if: l2_foreign_depth[i] = depth && l2_foreign_const[i] = is_const && l2_text_same(l2_foreign_name[i], name)
            return: 100 + i
        i: i + 1
    if: l2_foreign_n = c.INT_MAX - 100
        l2_alloc_err: 2
        return: 0 - 1
    if: l2_foreign_n >= l2_foreign_cap
        cap: l2_foreign_cap
        if: cap < 1
            cap: 4
        while: cap <= l2_foreign_n
            if: cap > c.INT_MAX / 2
                cap: l2_foreign_n + 1
            else:
                cap: cap * 2
            ---
        ---
        if: l2_mul_ok((cast: (size_t) cap), c.sizeof(l2_ptr_probe)) = 0 || l2_mul_ok((cast: (size_t) cap), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            return: 0 - 1
        nb: (cast: (size_t) cap) * c.sizeof(l2_ptr_probe)
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        nd: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nc: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: nn = 0 || nd = 0 || nc = 0
            if: nn != 0
                l2_xfree((cast: (@: void) nn))
            if: nd != 0
                l2_xfree((cast: (@: void) nd))
            if: nc != 0
                l2_xfree((cast: (@: void) nc))
            return: 0 - 1
        if: l2_foreign_n > 0
            c.memcpy((cast: (@: void) nn), (cast: (@: void) l2_foreign_name), (cast: (size_t) l2_foreign_n) * c.sizeof(l2_ptr_probe))
            c.memcpy((cast: (@: void) nd), (cast: (@: void) l2_foreign_depth), (cast: (size_t) l2_foreign_n) * c.sizeof(c.int))
            c.memcpy((cast: (@: void) nc), (cast: (@: void) l2_foreign_const), (cast: (size_t) l2_foreign_n) * c.sizeof(c.int))
        ---
        if: l2_foreign_name != 0
            l2_xfree((cast: (@: void) l2_foreign_name))
        if: l2_foreign_depth != 0
            l2_xfree((cast: (@: void) l2_foreign_depth))
        if: l2_foreign_const != 0
            l2_xfree((cast: (@: void) l2_foreign_const))
        l2_foreign_name: nn
        l2_foreign_depth: nd
        l2_foreign_const: nc
        l2_foreign_cap: cap
    ---
    l2_foreign_name[l2_foreign_n]: (cast: (@: LmP0Text) name)
    l2_foreign_depth[l2_foreign_n]: depth
    l2_foreign_const[l2_foreign_n]: is_const
    i: l2_foreign_n
    l2_foreign_n: l2_foreign_n + 1
return: 100 + i

fn: l2_emit_foreign_named (@: FILE out; int: ty; const: @(char prefix); const: @(LmP0Text name)) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n
        return: 1
    if: prefix != 0 && c.fputs(prefix, out) < 0
        return: 1
    if: l2_foreign_const[i] != 0 && c.fputs("const: ", out) < 0
        return: 1
    if: l2_emit_address_marks(out, l2_foreign_depth[i]) != 0
        return: 1
    if: l2_foreign_const[i] != 0
        if: c.fputs("(", out) < 0
            return: 1
        ---
    else:
        if: c.fputs(": ", out) < 0
            return: 1
    ---
    if: l2_write_text(out, l2_foreign_name[i]) != 0
        return: 1
    if: c.fputs(" ", out) < 0 || l2_write_text(out, name) != 0
        return: 1
    if: l2_foreign_const[i] != 0 && c.fputs(")", out) < 0
        return: 1
return: 0

fn: l2_emit_foreign_temp (@: FILE out; int: ty; const: @(char ind); int: temp) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n || l2_foreign_const[i] != 0
        return: 1
    if: c.fputs(ind, out) < 0
        return: 1
    if: l2_emit_address_marks(out, l2_foreign_depth[i]) != 0 || c.fputs(": ", out) < 0
        return: 1
    if: l2_write_text(out, l2_foreign_name[i]) != 0
        return: 1
    if: c.fprintf(out, " l2_t%d\n", temp) < 0
        return: 1
return: 0

fn: l2_emit_foreign_return (@: FILE out; int: ty) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n || l2_foreign_const[i] != 0
        return: 1
    if: c.fputs(") ", out) < 0 || l2_emit_address_marks(out, l2_foreign_depth[i]) != 0 || c.fputs(": ", out) < 0
        return: 1
return: l2_write_text(out, l2_foreign_name[i])

fn: l2_emit_foreign_formal (@: FILE out; int: ty; int: mi; int: fi) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n
        return: 1
    if: c.fputs("; ", out) < 0
        return: 1
    if: l2_foreign_const[i] != 0 && c.fputs("const: ", out) < 0
        return: 1
    if: l2_emit_address_marks(out, l2_foreign_depth[i]) != 0
        return: 1
    if: l2_foreign_const[i] != 0
        if: c.fputs("(", out) < 0
            return: 1
        ---
    else:
        if: c.fputs(": ", out) < 0
            return: 1
    ---
    if: l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, " l2_p%d_%d", mi, fi) < 0
        return: 1
    if: l2_foreign_const[i] != 0 && c.fputs(")", out) < 0
        return: 1
return: 0

# A function-pointer local: TYPE: name, where TYPE is a fnptr: the predef'd
# header declares. It is an activation local, never an own field -- a function
# pointer is not a graph cell and has no business in one.
fn: l2_fnptr_local (const: @(LmP0Node stmt); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: 1
    \out_name: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 1
    # A bare declaration, or a declaration with an initialiser. The
    # initialiser form is the only one this language can express, because a
    # later "d: value" statement is the same tree as the call "d(value)".
    if: l2_count_active(stmt\as\frame\body) < 1
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: 1
    if: l2_predef_has_fnptr(stmt\as\frame\head) = 0
        return: 1
    \out_name: f\value\as\atom
return: 0

# A by-value local of a C struct the predef'd header declares: TYPE: name. It is
# ordinary C storage in the activation (spec 20.2.2), never an own field, and its
# address is taken with @ name. Only the bare declaration: a struct has no
# scalar initialiser here, and a compact frame is a call, not a declaration.
fn: l2_struct_local (const: @(LmP0Node stmt); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: 1
    \out_name: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 1
    if: (stmt\as\frame\flags & c.LM_P0_FRAME_COMPACT) != 0U || l2_count_active(stmt\as\frame\body) != 1
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: 1
    if: l2_predef_has_type(stmt\as\frame\head) = 0 || l2_predef_has_fnptr(stmt\as\frame\head) != 0
        return: 1
    \out_name: f\value\as\atom
return: 0

fn: l2_ptr_local_ty (const: @(LmP0Node stmt); @@: LmP0Text out_name; @: int out_ty) int
    @: LmP0Field f
    @: LmP0Field g
    int: n
    int: depth
    if: out_name = 0 || out_ty = 0
        return: 1
    \out_name: 0
    \out_ty: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 1
    depth: l2_address_depth(stmt\as\frame\head)
    if: depth = 0
        return: 1
    if: stmt\as\frame\body = 0
        return: 1
    n: l2_count_active(stmt\as\frame\body)
    if: n != 2 && n != 3
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
        return: 1
    \out_name: g\value\as\atom
    if: depth = 2
        if: l2_text_eq(f\value\as\atom, "char")
            \out_ty: 17
            return: 0
        if: l2_text_eq(f\value\as\atom, "void")
            \out_ty: 18
            return: 0
        if: l2_text_eq(f\value\as\atom, "int")
            \out_ty: 19
            return: 0
        if: l2_text_eq(f\value\as\atom, "size_t")
            \out_ty: 20
            return: 0
        if: l2_text_eq(f\value\as\atom, "unsigned")
            \out_ty: 24
            return: 0
        if: l2_text_eq(f\value\as\atom, "ulong")
            \out_ty: 39
            return: 0
        \out_ty: l2_foreign_intern(f\value\as\atom, 2, 0)
        if: \out_ty >= 100
            return: 0
        return: 1
    ---
    if: depth = 1 && l2_text_eq(f\value\as\atom, "char")
        \out_ty: 12
        return: 0
    if: depth = 1 && l2_text_eq(f\value\as\atom, "size_t")
        \out_ty: 9
        return: 0
    if: depth = 1 && l2_text_eq(f\value\as\atom, "int")
        \out_ty: 11
        return: 0
    if: depth = 1 && l2_text_eq(f\value\as\atom, "LmP0Document")
        l2_need_p0: 1
        \out_ty: 13
        return: 0
    if: depth = 1 && l2_text_eq(f\value\as\atom, "void")
        \out_ty: 16
        return: 0
    if: depth = 1 && l2_text_eq(f\value\as\atom, "FILE")
        \out_ty: 23
        return: 0
    if: depth = 1 && l2_text_eq(f\value\as\atom, "unsigned")
        \out_ty: 25
        return: 0
    if: depth = 1 && l2_text_eq(f\value\as\atom, "ulong")
        \out_ty: 38
        return: 0
    \out_ty: l2_foreign_intern(f\value\as\atom, depth, 0)
    if: \out_ty >= 100
        return: 0
return: 1

fn: l2_diag_field (const: @(LmP0Text t)) int
    if: t = 0
        return: 0
    if: l2_text_eq(t, "code") || l2_text_eq(t, "line") || l2_text_eq(t, "column") || l2_text_eq(t, "message")
        return: 1
return: 0

fn: l2_const_local_ty (const: @(LmP0Node stmt); @@: LmP0Text out_name; @: int out_ty) int
    @: LmP0Field f
    const: @: LmP0Node inner
    @: LmP0Field g
    @: LmP0Field h
    int: depth
    int: n
    if: out_name = 0 || out_ty = 0
        return: 1
    \out_name: 0
    \out_ty: 0
    if: l2_frame_head(stmt, "const") = 0
        return: 1
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 1
    if: l2_count_active(stmt\as\frame\body) != 1
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0
        return: 1
    inner: f\value
    if: inner\kind != c.LM_P0_NODE_FRAME || inner\as = 0 || inner\as\frame = 0
        return: 1
    depth: l2_address_depth(inner\as\frame\head)
    if: depth = 0
        return: 1
    if: inner\as\frame\body = 0
        return: 1
    n: l2_count_active(inner\as\frame\body)
    # A unit pointer field may spell its required null initializer inside the
    # const declarator: const: @(T name 0).  Local declarations still use the
    # two-field form; the caller validates the optional initializer.
    if: n != 2 && n != 3
        return: 1
    g: l2_next_active(inner\as\frame\body\first_field)
    h: l2_next_active(g\next)
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    if: h = 0 || h\value = 0 || h\value\kind != c.LM_P0_NODE_ATOM || l2_ident(h\value\as\atom) = 0
        return: 1
    \out_name: h\value\as\atom
    if: depth = 1 && l2_text_eq(g\value\as\atom, "char")
        \out_ty: 3
        return: 0
    if: depth = 1 && l2_text_eq(g\value\as\atom, "LmxMsg")
        \out_ty: 29
        return: 0
    if: depth = 1 && l2_text_eq(g\value\as\atom, "LmP0Diagnostic")
        l2_need_p0: 1
        \out_ty: 21
        return: 0
    \out_ty: l2_foreign_intern(g\value\as\atom, depth, 1)
    if: \out_ty >= 100
        return: 0
return: 1


# Return types whose zero is unsigned: size_t, unsigned, ulong and LmxMsgAddr. They part company
# only where the type is printed, never where a zero is produced.
fn: l2_ret_uns (int: mi) int
    if: mi < 0 || l2_m_ret = 0
        return: 0
    if: l2_m_ret[mi] = 2 || l2_m_ret[mi] = 30 || l2_m_ret[mi] = 33 || l2_m_ret[mi] = 36
        return: 1
return: 0

fn: l2_fail_return (int: mi) const: @: char
    if: mi >= 0 && l2_m_ret[mi] = 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0)
        return: "return"
return: "return: 0"

fn: l2_write_dirs (@: FILE out) int
    int: j 0
    if: out = 0
        return: 1
    while: j < l2_pd_n
        if: c.fputs("predef: ", out) < 0
            return: 1
        if: l2_write_text(out, l2_pd[j]) != 0
            return: 1
        if: c.fputs("\n", out) < 0
            return: 1
        j: j + 1
    j: 0
    while: j < l2_inc_n
        if: j = 0 && c.fputs("include:", out) < 0
            return: 1
        if: c.fputs(" ", out) < 0
            return: 1
        if: l2_write_text(out, l2_inc[j]) != 0
            return: 1
        j: j + 1
    if: l2_inc_n != 0 && c.fputs("\n", out) < 0
        return: 1
return: 0

fn: l2_array_local (const: @(LmP0Node stmt); @@: LmP0Text out_name; @@: LmP0Text out_n) int
    @: LmP0Field f
    const: @: LmP0Node inner
    @: LmP0Field t
    @: LmP0Field nm
    @: LmP0Field sz
    if: out_name = 0 || out_n = 0
        return: 1
    \out_name: 0
    \out_n: 0
    if: l2_frame_head(stmt, "c.array") = 0
        return: 1
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 1
    if: l2_count_active(stmt\as\frame\body) != 1
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0
        return: 1
    inner: f\value
    if: l2_frame_head(inner, "[]") = 0
        return: 1
    if: inner\as = 0 || inner\as\frame = 0 || inner\as\frame\body = 0
        return: 1
    if: l2_count_active(inner\as\frame\body) != 3
        return: 1
    t: l2_next_active(inner\as\frame\body\first_field)
    nm: l2_next_active(t\next)
    sz: l2_next_active(nm\next)
    if: t = 0 || t\value = 0 || t\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(t\value\as\atom, "char") = 0
        return: 1
    if: nm = 0 || nm\value = 0 || nm\value\kind != c.LM_P0_NODE_ATOM || l2_ident(nm\value\as\atom) = 0
        return: 1
    if: sz = 0 || sz\value = 0 || sz\value\kind != c.LM_P0_NODE_ATOM || l2_num(sz\value\as\atom) = 0
        return: 1
    \out_name: nm\value\as\atom
    \out_n: sz\value\as\atom
return: 0

fn: l2_check_os_fn (const: @(LmP0Node fn); const: @(char path)) int
    @: LmP0Field f
    @: LmP0Field p
    @: LmP0Field ty
    @: LmP0Field inner
    @: LmP0Structure tr
    @: LmP0Field r
    if: fn = 0 || l2_frame_head(fn, "fn") = 0 || fn\as = 0 || fn\as\frame = 0 || fn\as\frame\body = 0
        return: l2_error(path, fn, "unsupported body")
    if: l2_count_active(fn\as\frame\body) != 3
        return: l2_error(path, fn, "unsupported body")
    f: l2_next_active(fn\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: l2_error(path, fn, "incompatible entry signature")
    p: l2_next_active(f\next)
    if: p = 0 || l2_empty_struct(p\value) = 0
        return: l2_error(path, fn, "incompatible entry signature")
    ty: l2_next_active(p\next)
    if: ty = 0 || ty\value = 0 || l2_frame_head(ty\value, "@") = 0 || ty\value\as = 0 || ty\value\as\frame = 0 || ty\value\as\frame\body = 0
        return: l2_error(path, fn, "incompatible entry signature")
    if: l2_count_active(ty\value\as\frame\body) != 1
        return: l2_error(path, fn, "incompatible entry signature")
    inner: l2_next_active(ty\value\as\frame\body\first_field)
    if: inner = 0 || inner\value = 0 || inner\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(inner\value\as\atom, "char") = 0
        return: l2_error(path, fn, "incompatible entry signature")
    tr: l2_ret_tr(fn\as\frame)
    if: tr = 0
        return: l2_error(path, fn, "unsupported body")
    if: l2_count_active(tr) != 1
        return: l2_error(path, fn, "unsupported argument")
    r: l2_next_active(tr\first_field)
    if: r = 0 || r\value = 0 || r\value\kind != c.LM_P0_NODE_ATOM || l2_quoted(r\value\as\atom) = 0
        return: l2_error(path, fn, "unsupported argument")
return: 0

fn: l2_os_fn_name (const: @(LmP0Node fn)) @: LmP0Text
    @: LmP0Field f
    if: fn = 0 || fn\as = 0 || fn\as\frame = 0 || fn\as\frame\body = 0
        return: 0
    f: l2_next_active(fn\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: f\value\as\atom

fn: l2_os_branches_match (const: @(LmP0Structure first); const: @(LmP0Structure other); const: @(char path)) int
    @: LmP0Field a
    @: LmP0Field b
    @: LmP0Text an
    @: LmP0Text bn
    if: first = 0 || other = 0
        return: l2_error(path, 0, "unsupported body")
    a: l2_next_active(first\first_field)
    b: l2_next_active(other\first_field)
    while: a != 0 && b != 0
        an: l2_os_fn_name(a\value)
        bn: l2_os_fn_name(b\value)
        if: an = 0 || bn = 0 || l2_text_same(an, bn) = 0
            return: l2_error(path, b\value, "incompatible os branches")
        a: l2_next_active(a\next)
        b: l2_next_active(b\next)
    if: a != 0 || b != 0
        return: l2_error(path, 0, "incompatible os branches")
return: 0

fn: l2_check_os (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field b
    @: LmP0Field f
    const: @: LmP0Structure first 0
    if: item = 0 || l2_frame_head(item, "os") = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    b: l2_next_active(item\as\frame\body\first_field)
    if: b = 0
        return: l2_error(path, item, "unsupported body")
    while: b != 0
        if: l2_frame_head(b\value, "win") = 0 && l2_frame_head(b\value, "default") = 0
            return: l2_error(path, b\value, "unsupported body")
        if: b\value\as = 0 || b\value\as\frame = 0 || b\value\as\frame\body = 0
            return: l2_error(path, b\value, "unsupported body")
        f: l2_next_active(b\value\as\frame\body\first_field)
        if: f = 0
            return: l2_error(path, b\value, "unsupported body")
        while: f != 0
            if: l2_check_os_fn(f\value, path) != 0
                return: 1
            f: l2_next_active(f\next)
        if: first = 0
            first: b\value\as\frame\body
        else:
            if: l2_os_branches_match(first, b\value\as\frame\body, path) != 0
                return: 1
            ---
        b: l2_next_active(b\next)
return: 0

fn: l2_collect_os_methods (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field branch
    @: LmP0Field method
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    branch: l2_next_active(item\as\frame\body\first_field)
    if: branch = 0 || branch\value = 0 || branch\value\as = 0 || branch\value\as\frame = 0 || branch\value\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    method: l2_next_active(branch\value\as\frame\body\first_field)
    while: method != 0
        if: l2_collect_method(method\value, path) != 0
            return: 1
        method: l2_next_active(method\next)
return: 0

fn: l2_method_is_os (int: mi) int
    @: LmP0Field branch
    @: LmP0Field method
    if: mi < 0 || mi >= l2_m_n || l2_os_node = 0 || l2_os_node\as = 0 || l2_os_node\as\frame = 0 || l2_os_node\as\frame\body = 0
        return: 0
    branch: l2_next_active(l2_os_node\as\frame\body\first_field)
    if: branch = 0 || branch\value = 0 || branch\value\as = 0 || branch\value\as\frame = 0 || branch\value\as\frame\body = 0
        return: 0
    method: l2_next_active(branch\value\as\frame\body\first_field)
    while: method != 0
        if: method\value = l2_m_node[mi]
            return: 1
        method: l2_next_active(method\next)
return: 0

fn: l2_emit_os_fn (@: FILE out; const: @(LmP0Node fn); const: @(char ind)) int
    @: LmP0Field f
    @: LmP0Structure tr
    @: LmP0Field r
    @: LmP0Text name
    int: mi
    if: out = 0 || fn = 0 || fn\as = 0 || fn\as\frame = 0 || fn\as\frame\body = 0
        return: 1
    f: l2_next_active(fn\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    name: f\value\as\atom
    mi: l2_find_method(name)
    if: mi < 0 || l2_method_is_os(mi) = 0
        return: 1
    if: c.fputs(ind, out) < 0
        return: 1
    if: c.fputs("fn: ", out) < 0
        return: 1
    if: l2_write_sym(out, mi) != 0
        return: 1
    if: l2_emit_sig(mi) != 0 || c.fputs("\n", out) < 0
        return: 1
    if: c.fprintf(out, "%s    if: node = 0\n%s        return: 0\n", ind, ind) < 0
        return: 1
    if: l2_emit_poll(mi, "            ") != 0
        return: 1
    tr: l2_ret_tr(fn\as\frame)
    if: tr = 0
        return: 1
    r: l2_next_active(tr\first_field)
    if: r = 0 || r\value = 0 || r\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    if: c.fprintf(out, "%s    ", ind) < 0
        return: 1
    if: c.fputs("return: ", out) < 0
        return: 1
    if: l2_write_text(out, r\value\as\atom) != 0
        return: 1
    if: c.fputs("\n", out) < 0
        return: 1
    if: c.fputs(ind, out) < 0 || c.fputs("end: ", out) < 0 || l2_write_sym(out, mi) != 0 || c.fputs("\n", out) < 0
        return: 1
return: 0

fn: l2_emit_os (@: FILE out) int
    @: LmP0Field b
    @: LmP0Field f
    if: out = 0 || l2_os_node = 0 || l2_os_node\as = 0 || l2_os_node\as\frame = 0 || l2_os_node\as\frame\body = 0
        return: 0
    if: c.fputs("os:\n", out) < 0
        return: 1
    b: l2_next_active(l2_os_node\as\frame\body\first_field)
    while: b != 0
        if: l2_frame_head(b\value, "win") = 0 && l2_frame_head(b\value, "default") = 0
            return: 1
        if: c.fputs("    ", out) < 0
            return: 1
        if: l2_write_text(out, b\value\as\frame\head) != 0
            return: 1
        if: c.fputs(":\n", out) < 0
            return: 1
        if: b\value\as = 0 || b\value\as\frame = 0 || b\value\as\frame\body = 0
            return: 1
        f: l2_next_active(b\value\as\frame\body\first_field)
        while: f != 0
            if: l2_emit_os_fn(out, f\value, "        ") != 0
                return: 1
            f: l2_next_active(f\next)
        b: l2_next_active(b\next)
    if: c.fputs("end: os\n", out) < 0
        return: 1
return: 0

fn: l2_entry_reserve (int: need) int
    size_t: nb
    size_t: ni
    size_t: psz
    @@: LmP0Text nn 0
    @: int nt 0
    if: need < 0
        return: 1
    if: need <= l2_entry_cap
        return: 0
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok((cast: (size_t) need), psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok((cast: (size_t) need), c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: (cast: (size_t) need) * psz
    ni: (cast: (size_t) need) * c.sizeof(c.int)
    l2_alloc_kind: 1
    nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nt: (cast: (@: int) l2_xmalloc(ni))
    if: nn = 0 || nt = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        ---
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        ---
        l2_entry_free()
        return: 1
    c.memset((cast: (@: void) nn), 0, nb)
    c.memset((cast: (@: void) nt), 0, ni)
    if: l2_entry_nm != 0 && l2_entry_n > 0
        c.memcpy((cast: (@: void) nn), (cast: (@: void) l2_entry_nm), (cast: (size_t) l2_entry_n) * psz)
    ---
    if: l2_entry_ty != 0 && l2_entry_n > 0
        c.memcpy((cast: (@: void) nt), (cast: (@: void) l2_entry_ty), (cast: (size_t) l2_entry_n) * c.sizeof(c.int))
    ---
    if: l2_entry_nm != 0
        l2_xfree((cast: (@: void) l2_entry_nm))
    ---
    if: l2_entry_ty != 0
        l2_xfree((cast: (@: void) l2_entry_ty))
    ---
    l2_entry_nm: nn
    l2_entry_ty: nt
    l2_entry_cap: need
return: 0

fn: l2_entry_find (const: @(LmP0Text t)) int
    int: i 0
    if: t = 0 || l2_entry_nm = 0
        return: -1
    while: i < l2_entry_n
        if: l2_text_same(l2_entry_nm[i], t)
            return: i
        ---
        i: i + 1
return: -1

fn: l2_parse_entry_formals (const: @(LmP0Node params); const: @(char path)) int
    @: LmP0Field p
    @: LmP0Text fa 0
    int: ar
    int: j
    int: k
    int: ty
    l2_entry_free()
    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE || params\as = 0
        return: l2_error(path, params, "incompatible entry signature")
    if: params\as\structure\trailer != 0
        return: l2_error(path, params, "unsupported trailer")
    ar: l2_count_active(params\as\structure)
    if: ar < 1
        return: l2_error(path, params, "incompatible entry signature")
    if: l2_entry_reserve(ar) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, params, "size overflow")
        return: l2_error(path, params, "out of memory")
    p: l2_next_active(params\as\structure\first_field)
    j: 0
    while: j < ar
        ty: 0
        fa: 0
        if: p = 0 || l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            l2_entry_free()
            return: 1
        if: fa = 0 || fa\length >= 63U
            l2_entry_free()
            return: l2_error(path, params, "name too long")
        k: 0
        while: k < j
            if: l2_text_same(fa, l2_entry_nm[k])
                l2_entry_free()
                return: l2_error(path, p\value, "duplicate formal")
            ---
            k: k + 1
        l2_entry_nm[j]: fa
        l2_entry_ty[j]: ty
        p: l2_next_active(p\next)
        j: j + 1
    l2_entry_n: ar
    if: ar != 2 || l2_entry_ty[0] != 0 || l2_entry_ty[1] != 17
        l2_entry_free()
        return: l2_error(path, params, "incompatible entry signature")
    ---
return: 0

fn: l2_write_entry_sig (@: FILE out) int
    int: j 0
    int: ty
    if: out = 0
        return: 1
    if: c.fputs("external:\n    fn: main (", out) < 0
        return: 1
    while: j < l2_entry_n
        if: j != 0 && c.fputs("; ", out) < 0
            return: 1
        ty: l2_entry_ty[j]
        if: ty = 0 && c.fputs("int: ", out) < 0
            return: 1
        if: ty = 1 && c.fputs("char: ", out) < 0
            return: 1
        if: ty = 2 && c.fputs("size_t: ", out) < 0
            return: 1
        if: ty = 3 && c.fputs("const: @(char ", out) < 0
            return: 1
        if: ty = 12 && c.fputs("@: char ", out) < 0
            return: 1
        if: ty = 16 && c.fputs("@: void ", out) < 0
            return: 1
        if: ty = 17 && c.fputs("@@: char ", out) < 0
            return: 1
        if: ty = 18 && c.fputs("@@: void ", out) < 0
            return: 1
        if: ty = 19 && c.fputs("@@: int ", out) < 0
            return: 1
        if: ty = 24 && c.fputs("@@: unsigned ", out) < 0
            return: 1
        if: ty = 39 && c.fputs("@@: ulong ", out) < 0
            return: 1
        if: ty = 26 && c.fputs("@@: LmxMsgBlock ", out) < 0
            return: 1
        if: ty = 28 && c.fputs("const: @(LmxMsgRuntime) ", out) < 0
            return: 1
        if: ty = 29 && c.fputs("const: @(LmxMsg) ", out) < 0
            return: 1
        if: ty = 30 && c.fputs("const: @(LmxMsgCopy) ", out) < 0
            return: 1
        if: ty = 31 && c.fputs("@@: LmxMsgCopy ", out) < 0
            return: 1
        if: ty = 27 && c.fputs("@@: LmxOwnedRange ", out) < 0
            return: 1
        if: ty = 25 && c.fputs("@: unsigned ", out) < 0
            return: 1
        if: ty = 38 && c.fputs("@: ulong ", out) < 0
            return: 1
        if: ty = 20 && c.fputs("@@: size_t ", out) < 0
            return: 1
        if: ty != 30 && ty != 31 && ty != 28 && ty != 29 && ty != 26 && ty != 27 && ty != 24 && ty != 25 && ty != 38 && ty != 39 && ty != 0 && ty != 1 && ty != 2 && ty != 3 && ty != 12 && ty != 16 && ty != 17 && ty != 18 && ty != 19 && ty != 20
            return: 1
        if: l2_write_text(out, l2_entry_nm[j]) != 0
            return: 1
        if: ty = 3 && c.fputs(")", out) < 0
            return: 1
        j: j + 1
    if: c.fputs(") int\n", out) < 0
        return: 1
return: 0

fn: l2_formal_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_arity[mi]
        if: l2_text_same(l2_fn(mi, i), t)
            return: i
        i: i + 1
return: -1

fn: l2_dyn_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_dyn[mi]
        if: l2_text_same(l2_dn(mi, i), t)
            return: i
        i: i + 1
return: -1

fn: l2_param_find (int: mi; const: @(LmP0Text t)) int
    int: fi
    int: di
    fi: l2_formal_find(mi, t)
    if: fi >= 0
        return: fi
    di: l2_dyn_find(mi, t)
    if: di >= 0
        return: l2_m_arity[mi] + di
return: -1

fn: l2_param_is (int: mi; const: @(LmP0Text t)) int
    if: mi < 0 || t = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 1
    if: l2_dyn_find(mi, t) >= 0
        return: 1
return: 0

fn: l2_param_ty (int: mi; const: @(LmP0Text t)) int
    int: fi
    int: di
    if: mi < 0 || t = 0
        return: 0
    fi: l2_formal_find(mi, t)
    if: fi >= 0
        return: l2_ft(mi, fi)
    di: l2_dyn_find(mi, t)
    if: di >= 0
        return: l2_dt(mi, di)
return: 0

fn: l2_is_asgn (const: @(LmP0Node stmt)) int
    const: @: LmP0Text h
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    h: stmt\as\frame\head
    if: h = 0 || l2_ident(h) = 0
        return: 0
    if: l2_frame_head(stmt, "if") || l2_frame_head(stmt, "else") || l2_frame_head(stmt, "while") || l2_frame_head(stmt, "for") || l2_frame_head(stmt, "return") || l2_frame_head(stmt, "fn") || l2_frame_head(stmt, "sub") || l2_frame_head(stmt, "end") || l2_frame_head(stmt, "char") || l2_frame_head(stmt, "int") || l2_frame_head(stmt, "size_t") || l2_frame_head(stmt, "unsigned") || l2_frame_head(stmt, "ulong") || l2_frame_head(stmt, "@")
        return: 0
    if: l2_find_method(h) >= 0 || l2_is_known(h)
        return: 0
    if: h\length >= 2U && h\data[0] = 99 && h\data[1] = 46
        return: 0
    if: stmt\as\frame\body = 0
        return: 0
return: 1

fn: l2_collect_asgn_body (const: @(LmP0Structure body); int: mi; const: @(char path)) int
    int: pis 0
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Text fa
    int: n
    int: k
    int: j
    int: ty
    int: used
    if: body = 0 || mi < 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        # Merge operands are graph names resolved by the merge pre-pass, not
        # free scalar identifiers for dynamic-input inference.
        if: l2_merge_frame(stmt) != 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: l2_alloc_or(path, stmt, "out of memory")
                if: l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as != 0 && nxt\value\as\frame != 0
                if: l2_scope_push(nxt\value) != 0
                    return: l2_alloc_or(path, nxt\value, "out of memory")
                if: l2_collect_asgn_body(nxt\value\as\frame\body, mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: n >= 2 && last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: l2_alloc_or(path, stmt, "out of memory")
                if: l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            last: l2_next_active(stmt\as\frame\body\first_field)
            k: 1
            while: k < 5
                last: l2_next_active(last\next)
                k: k + 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt)
            fa: stmt\as\frame\head
            ty: l2_param_ty(mi, fa)
            pis: l2_param_is(mi, fa)
            j: -1
            used: 0
            if: pis != 0 && (ty = 0 || ty = 1 || ty = 2 || ty = 36)
                j: l2_own_add(mi, fa, ty, path, stmt, 0)
            if: pis != 0 && (ty = 0 || ty = 1 || ty = 2 || ty = 36) && j < 0
                return: 1
            if: pis != 0 && (ty = 0 || ty = 1 || ty = 2 || ty = 36) && l2_own_off(mi, j) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            if: pis != 0 && (ty = 0 || ty = 1 || ty = 2 || ty = 36)
                used: l2_m_uses[l2_own_off(mi, j)]
            if: pis != 0 && (ty = 0 || ty = 1 || ty = 2 || ty = 36)
                l2_m_uses[l2_own_off(mi, j)]: 1
            if: pis != 0 && (ty = 0 || ty = 1 || ty = 2 || ty = 36) && used = 0
                l2_m_own[mi]: l2_m_own[mi] + 1
            if: pis != 0 && (ty = 0 || ty = 1 || ty = 2 || ty = 36) && l2_bind_own(mi, j, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_collect_asgn_binds (const: @(char path)) int
    int: i 0
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_collect_asgn_body(l2_m_body[i]\as\structure, i, path) != 0
            return: 1
        i: i + 1
return: 0

fn: l2_bind_own (int: mi; int: oi; const: @(char path); const: @(LmP0Node at)) int
    int: fi 0
    if: mi < 0 || oi < 0
        return: 0
    while: fi < l2_m_arity[mi]
        if: l2_text_same(l2_fn(mi, fi), l2_own_name[oi])
            if: l2_ft(mi, fi) != l2_own_ty[oi]
                return: l2_error(path, at, "incompatible entry signature")
            l2_m_alias[l2_own_off(mi, oi)]: fi
        fi: fi + 1
    fi: 0
    while: fi < l2_m_dyn[mi]
        if: l2_text_same(l2_dn(mi, fi), l2_own_name[oi])
            if: l2_dt(mi, fi) != 0 && l2_dt(mi, fi) != l2_own_ty[oi]
                return: l2_error(path, at, "incompatible entry signature")
            if: l2_dt_set(mi, fi, l2_own_ty[oi]) != 0
                return: 1
            l2_m_alias[l2_own_off(mi, oi)]: l2_m_arity[mi] + fi
        fi: fi + 1
return: 0

fn: l2_collect_decls (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth; @: int sn) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    @: LmP0Text fa
    int: j
    int: n
    int: ty
    int: slot_no
    if: body = 0 || sn = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: l2_frame_head(stmt, "if")
            if: stmt\as\frame\body = 0
                return: l2_error(path, stmt, "unsupported body")
            n: l2_count_active(stmt\as\frame\body)
            last: l2_next_active(stmt\as\frame\body\first_field)
            j: 1
            while: j < n
                last: l2_next_active(last\next)
                j: j + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_for_add(last\value, mi, l2_for_find(l2_scope_host())) < 0 || l2_scope_push(last\value) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_collect_decls(last\value\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                if: nxt\value\as\frame\body = 0
                    return: l2_error(path, nxt\value, "unsupported body")
                if: l2_for_add(nxt\value, mi, l2_for_find(l2_scope_host())) < 0 || l2_scope_push(nxt\value) != 0
                    return: l2_alloc_or(path, nxt\value, "out of memory")
                if: l2_collect_decls(nxt\value\as\frame\body, mi, path, depth + 1, sn) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            continue
        if: l2_frame_head(stmt, "while")
            if: stmt\as\frame\body = 0
                return: l2_error(path, stmt, "unsupported body")
            n: l2_count_active(stmt\as\frame\body)
            last: l2_next_active(stmt\as\frame\body\first_field)
            j: 1
            while: j < n
                last: l2_next_active(last\next)
                j: j + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_for_add(last\value, mi, l2_for_find(l2_scope_host())) < 0 || l2_scope_push(last\value) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_collect_decls(last\value\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_for_add(stmt, mi, l2_for_find(l2_scope_host())) < 0
                return: l2_error(path, stmt, "out of memory")
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            nxt: l2_next_active(stmt\as\frame\body\first_field)
            if: nxt != 0 && l2_own_decl_ty(nxt\value) != 0
                ty: l2_own_decl_ty(nxt\value)
                if: l2_own_is_array(ty) != 0
                    l2_scope_pop()
                    return: l2_error(path, nxt\value, "unsupported own array declaration")
                fa: l2_next_active(nxt\value\as\frame\body\first_field)\value\as\atom
                j: l2_own_add(mi, fa, l2_own_store_ty(ty), path, nxt\value, 0)
                if: j < 0
                    l2_scope_pop()
                    return: 1
                if: l2_own_off(mi, j) = (cast: (size_t) -1)
                    l2_scope_pop()
                    return: l2_error(path, nxt\value, "size overflow")
                l2_m_uses[l2_own_off(mi, j)]: 1
                l2_m_own[mi]: l2_m_own[mi] + 1
                if: l2_bind_own(mi, j, path, nxt\value) != 0
                    l2_scope_pop()
                    return: 1
                ---
            nxt: l2_next_active(nxt\next)
            nxt: l2_next_active(nxt\next)
            nxt: l2_next_active(nxt\next)
            nxt: l2_next_active(nxt\next)
            if: nxt != 0 && nxt\value != 0 && nxt\value\kind = c.LM_P0_NODE_STRUCTURE && nxt\value\as != 0 && l2_collect_decls(nxt\value\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "[]") && (l2_own_array_count(stmt) = 0 || mi < 0 || depth != l2_scope_n)
            return: l2_error(path, stmt, "unsupported own array declaration")
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && mi < 0
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_unimpl_numeric(stmt) != 0
            return: l2_error(path, stmt, l2_unimpl_numeric(stmt))
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && depth > 0 && l2_scope_n = 0
            return: l2_error(path, stmt, "unsupported own declaration")
        if: l2_frame_head(stmt, "if") = 0 && l2_slot_decl_ty(stmt) != 0 && depth > 0
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && (depth = 0 || l2_scope_n != 0)
            ty: l2_own_decl_ty(stmt)
            fa: l2_own_decl_name(stmt)
            j: l2_own_add(mi, fa, l2_own_store_ty(ty), path, stmt, 0)
            if: j < 0
                return: 1
            if: l2_own_is_array(ty) != 0
                if: l2_own_count[j] != 0
                    return: l2_error(path, stmt, "duplicate own array declaration")
                l2_own_count[j]: l2_own_array_count(stmt)
            ---
            if: l2_own_off(mi, j) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            l2_m_uses[l2_own_off(mi, j)]: 1
            l2_m_own[mi]: l2_m_own[mi] + 1
            if: l2_bind_own(mi, j, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) = 0 && l2_slot_decl_ty(stmt) != 0 && depth = 0
            ty: l2_slot_decl_ty(stmt)
            fa: l2_next_active(l2_next_active(stmt\as\frame\body\first_field)\next)\value\as\atom
            slot_no: \sn
            l2_m_sn[mi]: slot_no
            if: slot_no = c.INT_MAX || l2_slot_reserve(slot_no + 1) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            l2_sn[l2_slot_off(mi, slot_no)]: fa
            l2_st[l2_slot_off(mi, slot_no)]: ty
            if: ty = 5
                l2_need_p0: 1
            slot_no: slot_no + 1
            \sn: slot_no
            l2_m_sn[mi]: slot_no
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) = 0 && l2_slot_decl_ty(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_name_before (const: @(LmP0Text a); const: @(LmP0Text b)) int
    size_t: n
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    n: a\length
    if: b\length < n
        n: b\length
    if: c.memcmp(a\data, b\data, n) < 0
        return: 1
    if: c.memcmp(a\data, b\data, n) > 0
        return: 0
    if: a\length < b\length
        return: 1
return: 0

fn: l2_dyn_add (int: mi; const: @(LmP0Text t); int: ty) int
    int: k
    int: i
    if: mi < 0 || t = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 0
    k: l2_dyn_find(mi, t)
    if: k >= 0
        if: ty != 0 && l2_dt(mi, k) != 0 && l2_dt(mi, k) != ty
            return: 1
        if: ty != 0 && l2_dt_set(mi, k, ty) != 0
            return: 1
        return: 0
    if: l2_m_dyn[mi] >= c.INT_MAX
        l2_alloc_err: 2
        return: 1
    if: l2_hidden_reserve(mi, l2_m_dyn[mi] + 1) != 0
        return: 1
    i: l2_m_dyn[mi]
    while: i > 0 && l2_name_before(t, l2_dn(mi, i - 1))
        if: l2_dn_set(mi, i, l2_dn(mi, i - 1)) != 0
            return: 1
        if: l2_dt_set(mi, i, l2_dt(mi, i - 1)) != 0
            return: 1
        i: i - 1
    if: l2_dn_set(mi, i, (cast: (@: LmP0Text) t)) != 0
        return: 1
    if: l2_dt_set(mi, i, ty) != 0
        return: 1
    l2_m_dyn[mi]: l2_m_dyn[mi] + 1
return: 0

fn: l2_scan_ident (int: mi; const: @(LmP0Text t); @: int seen) int
    int: oi
    int: ty
    if: mi < 0 || t = 0 || l2_ident(t) = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 0
    if: l2_slot_find(mi, t) >= 0
        return: 0
    if: l2_find_method(t) >= 0
        return: 0
    if: l2_ml_find(t) >= 0
        return: 0
    # A unit-level declaration or a bound merge result is a name IN SCOPE,
    # reached through the program unit. It is not a free name, so it must
    # not become an untyped dynamic input.
    if: l2_ns_find(t) >= 0 && l2_ns_parent[l2_ns_find(t)] < 0
        return: 0
    if: l2_mres_find(t) >= 0
        return: 0
    if: l2_is_known(t)
        return: 0
    if: l2_text_eq(t, "return") || l2_text_eq(t, "if") || l2_text_eq(t, "else") || l2_text_eq(t, "while") || l2_text_eq(t, "for") || l2_text_eq(t, "continue") || l2_text_eq(t, "break") || l2_text_eq(t, "fn") || l2_text_eq(t, "sub") || l2_text_eq(t, "end") || l2_text_eq(t, "node") || l2_text_eq(t, "int") || l2_text_eq(t, "char") || l2_text_eq(t, "size_t") || l2_text_eq(t, "unsigned") || l2_text_eq(t, "ulong") || l2_text_eq(t, "data") || l2_text_eq(t, "length") || l2_text_eq(t, "columns") || l2_text_eq(t, "count") || l2_text_eq(t, "capacity") || l2_text_eq(t, "slots") || l2_text_eq(t, "alloc_next") || l2_text_eq(t, "addr") || l2_text_eq(t, "next")
        return: 0
    if: t\length >= 2U && t\data[0] = 99 && t\data[1] = 46
        return: 0
    if: l2_upper_name(t)
        return: 0
    oi: l2_own_find(mi, t)
    if: oi >= 0 && l2_own_mi[oi] < 0
        if: l2_own_off(mi, oi) = (cast: (size_t) -1)
            return: 1
        if: l2_m_uses[l2_own_off(mi, oi)] = 0
            l2_m_own[mi]: l2_m_own[mi] + 1
        l2_m_uses[l2_own_off(mi, oi)]: 1
        return: 0
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && (l2_own_ty[oi] = 1 || l2_own_ty[oi] = 2 || l2_own_ty[oi] = 3 || l2_own_ty[oi] = 36) && (seen = 0 || seen[oi] = 0)
        l2_m_pre[l2_own_off(mi, oi)]: 1
        ty: l2_own_ty[oi]
        return: l2_dyn_add(mi, t, ty)
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        return: 0
    if: l2_own_any(mi, t) >= 0
        return: 0
    if: l2_dyn_add(mi, t, 0) != 0
        return: 1
return: 0

fn: l2_scan_node (const: @(LmP0Node node); int: mi; @: int seen) int
    @: LmP0Field f
    int: n
    int: oi
    if: node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: l2_scan_ident(mi, node\as\atom, seen)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        f: node\as\structure\first_field
        n: l2_count_active(node\as\structure)
        return: l2_scan_fields(f, n, mi, seen)
    # In @: name the head is syntax and the single atom is a value. Resolve an
    # own field here before the generic structural-word filter, so a legitimate
    # field called count/data/next remains addressable.
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "@") && node\as\frame\body != 0 && l2_count_active(node\as\frame\body) = 1
        f: l2_next_active(node\as\frame\body\first_field)
        if: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM
            oi: l2_own_find(mi, f\value\as\atom)
            if: oi >= 0 && l2_own_mi[oi] < 0
                if: l2_m_uses[l2_own_off(mi, oi)] = 0
                    l2_m_own[mi]: l2_m_own[mi] + 1
                l2_m_uses[l2_own_off(mi, oi)]: 1
                return: 0
            ---
        ---
    # c.sizeof names a C type; nothing inside it is a lexical reference.
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "c.sizeof")
        return: 0
    # A cast contributes only its operand to lexical free-name analysis. The
    # head and its first field name a language operation and a C type.
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "cast") && node\as\frame\body != 0 && l2_count_active(node\as\frame\body) >= 2
        f: l2_next_active(node\as\frame\body\first_field)
        f: l2_next_active(f\next)
        # A field/index expression may occupy several flat fields; the target
        # type is still not a lexical reference.
        if: l2_count_active(node\as\frame\body) > 2
            return: l2_scan_fields(f, l2_count_active(node\as\frame\body) - 1, mi, seen)
        return: l2_scan_node(f\value, mi, seen)
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0
        if: l2_scan_ident(mi, node\as\frame\head, seen) != 0
            return: 1
        f: node\as\frame\body\first_field
        n: l2_count_active(node\as\frame\body)
        return: l2_scan_fields(f, n, mi, seen)
return: 0

fn: l2_scan_fields (@: LmP0Field field; int: n; int: mi; @: int seen) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: i
    int: after 0
    f: l2_next_active(field)
    i: 0
    while: i < n && f != 0
        nxt: l2_next_active(f\next)
        if: after != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM
            after: 0
            f: nxt
            i: i + 1
            continue
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            after: 1
        if: l2_scan_node(f\value, mi, seen) != 0
            return: 1
        f: nxt
        i: i + 1
return: 0

fn: l2_scan_body (const: @(LmP0Structure body); int: mi; @: int seen) int
    @: LmP0Text slnm 0
    int: slty 0
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Text fa
    int: n
    int: k
    int: oi
    int: ty
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        # Merge operands are graph names resolved by the merge pre-pass, not
        # free scalar identifiers for dynamic-input inference.
        if: l2_merge_frame(stmt) != 0
            field: l2_next_active(field\next)
            continue
        # A pointer-local declaration is a TYPE and a name, neither of them a
        # reference. Without this the type atom itself is inferred as an
        # untyped dynamic input and the whole method is refused as an
        # "unresolved name" that names nothing the source wrote.
        if: l2_ptr_local_ty(stmt, @ slnm, @ slty) = 0
            if: l2_count_active(stmt\as\frame\body) = 3
                last: l2_next_active(stmt\as\frame\body\first_field)
                last: l2_next_active(last\next)
                last: l2_next_active(last\next)
                if: last = 0 || l2_scan_node(last\value, mi, seen) != 0
                    return: 1
                ---
            ---
            field: l2_next_active(field\next)
            continue
        # The same for a const local: const: @(LmxMsg m) declares a cursor,
        # it does not reference LmxMsg.
        if: l2_const_local_ty(stmt, @ slnm, @ slty) = 0
            field: l2_next_active(field\next)
            continue
        # And for a function-pointer local: TYPE: d names a disposer type the
        # header declares. Fourth form of the same rule.
        if: l2_fnptr_local(stmt, @ slnm) = 0
            field: l2_next_active(field\next)
            continue
        if: l2_struct_local(stmt, @ slnm) = 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_scan_fields(fr\body\first_field, n - 1, mi, seen) != 0
                return: 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: 1
                if: l2_scan_body(last\value\as\structure, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as != 0 && nxt\value\as\frame != 0
                if: l2_scope_push(nxt\value) != 0
                    return: 1
                if: l2_scan_body(nxt\value\as\frame\body, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: n >= 2 && l2_scan_fields(fr\body\first_field, n - 1, mi, seen) != 0
                return: 1
            if: n >= 2 && last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: 1
                if: l2_scan_body(last\value\as\structure, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_scope_push(stmt) != 0
                return: 1
            last: l2_next_active(stmt\as\frame\body\first_field)
            if: last != 0 && last\value != 0 && last\value\as != 0 && last\value\as\frame != 0 && last\value\as\frame\body != 0 && l2_scan_fields(last\value\as\frame\body\first_field, l2_count_active(last\value\as\frame\body), mi, seen) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_scan_fields(last\value\as\structure\first_field, l2_count_active(last\value\as\structure), mi, seen) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: last != 0 && l2_scan_node(last\value, mi, seen) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            last: l2_next_active(last\next)
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_scan_body(last\value\as\structure, mi, seen) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt)
            if: stmt\as\frame\body != 0 && l2_scan_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, seen) != 0
                return: 1
            oi: l2_own_find(mi, stmt\as\frame\head)
            if: oi >= 0 && l2_own_mi[oi] < 0
                if: l2_own_off(mi, oi) = (cast: (size_t) -1)
                    return: 1
                if: l2_m_uses[l2_own_off(mi, oi)] = 0
                    l2_m_own[mi]: l2_m_own[mi] + 1
                l2_m_uses[l2_own_off(mi, oi)]: 1
            ---
            if: oi >= 0 && seen != 0
                seen[oi]: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt) = 0 && l2_own_decl_ty(stmt) != 0
            fa: l2_own_decl_name(stmt)
            oi: l2_own_find(mi, fa)
            if: oi >= 0 && seen != 0
                seen[oi]: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt) = 0 && l2_own_decl_ty(stmt) = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt) = 0 && l2_is_char_decl(stmt) = 0
            if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && l2_scan_ident(mi, stmt\as\frame\head, seen) != 0
                return: 1
            if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0 && l2_scan_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, seen) != 0
                return: 1
            field: l2_next_active(field\next)
return: 0

fn: l2_dyn_local (const: @(char path)) int
    int: i 0
    int: k
    int: oi
    int: dummy 0
    int: heap 0
    @: int seen
    size_t: nb
    seen: @ dummy
    if: l2_own_n > 0
        if: l2_mul_ok((cast: (size_t) l2_own_n), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            return: l2_alloc_or(path, 0, "unsupported body")
        nb: (cast: (size_t) l2_own_n) * c.sizeof(c.int)
        l2_alloc_kind: 5
        seen: (cast: (@: int) l2_xmalloc(nb))
        if: seen = 0
            return: l2_alloc_or(path, 0, "unsupported body")
        heap: 1
        ---
    while: i < l2_m_n
        if: heap != 0
            c.memset((cast: (@: void) seen), 0, (cast: (size_t) l2_own_n) * c.sizeof(c.int))
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, path) != 0
            if: heap != 0
                l2_xfree((cast: (@: void) seen))
            return: 1
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_scan_body(l2_m_body[i]\as\structure, i, seen) != 0
            if: heap != 0
                l2_xfree((cast: (@: void) seen))
            return: l2_alloc_or(path, l2_m_node[i], "unsupported body")
        if: l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_ret_tr(l2_m_node[i]\as\frame) != 0 && l2_scan_fields(l2_ret_tr(l2_m_node[i]\as\frame)\first_field, l2_count_active(l2_ret_tr(l2_m_node[i]\as\frame)), i, seen) != 0
            if: heap != 0
                l2_xfree((cast: (@: void) seen))
            return: l2_alloc_or(path, l2_m_node[i], "unsupported body")
        oi: 0
        while: oi < l2_own_n
            if: l2_m_uses[l2_own_off(i, oi)] != 0 && l2_m_pre[l2_own_off(i, oi)] != 0 && l2_dyn_add(i, l2_own_name[oi], l2_own_ty[oi]) != 0
                if: heap != 0
                    l2_xfree((cast: (@: void) seen))
                return: l2_alloc_or(path, l2_m_node[i], "unsupported body")
            if: l2_m_uses[l2_own_off(i, oi)] != 0 && l2_bind_own(i, oi, path, l2_m_node[i]) != 0
                if: heap != 0
                    l2_xfree((cast: (@: void) seen))
                return: 1
            oi: oi + 1
        i: i + 1
    if: heap != 0
        l2_xfree((cast: (@: void) seen))
return: 0

fn: l2_dyn_step (const: @(char path); @: int changed) int
    int: m 0
    int: cidx
    int: k
    int: src
    int: ty
    int: before
    @: LmP0Text nm
    while: m < l2_m_n
        cidx: 0
        while: cidx < l2_m_n
            k: 0
            while: l2_m_edge[l2_edge_off(m, cidx)] != 0 && k < l2_m_dyn[cidx]
                nm: l2_dn(cidx, k)
                ty: l2_dt(cidx, k)
                src: l2_param_find(m, nm)
                if: src < 0
                    src: l2_own_find(m, nm)
                if: src >= 0 && l2_param_find(m, nm) < 0 && l2_m_uses[l2_own_off(m, src)] != 0 && ty != 0 && l2_own_ty[src] != ty
                    return: l2_error(path, l2_m_node[m], "incompatible entry signature")
                if: src >= 0 && l2_param_find(m, nm) < 0 && l2_m_uses[l2_own_off(m, src)] != 0 && ty = 0 && l2_dt_set(cidx, k, l2_own_ty[src]) != 0
                    return: 1
                if: src >= 0 && l2_param_find(m, nm) < 0 && l2_m_uses[l2_own_off(m, src)] != 0 && ty = 0
                    \changed: 1
                before: l2_m_dyn[m]
                if: l2_param_find(m, nm) < 0 && (src < 0 || l2_m_uses[l2_own_off(m, src)] = 0) && l2_dyn_add(m, nm, ty) != 0
                    return: l2_alloc_or(path, l2_m_node[m], "unsupported body")
                if: l2_m_dyn[m] != before
                    \changed: 1
                src: l2_param_find(m, nm)
                if: src >= 0 && src < l2_m_arity[m] && ty != 0 && l2_ft(m, src) != ty
                    return: l2_error(path, l2_m_node[m], "incompatible entry signature")
                if: src >= 0 && src < l2_m_arity[m] && ty = 0 && (l2_ft(m, src) = 1 || l2_ft(m, src) = 2) && l2_dt_set(cidx, k, l2_ft(m, src)) != 0
                    return: 1
                if: src >= 0 && src < l2_m_arity[m] && ty = 0 && (l2_ft(m, src) = 1 || l2_ft(m, src) = 2)
                    \changed: 1
                if: src >= l2_m_arity[m] && ty != 0 && l2_dt(m, src - l2_m_arity[m]) != 0 && l2_dt(m, src - l2_m_arity[m]) != ty
                    return: l2_error(path, l2_m_node[m], "incompatible entry signature")
                if: src >= l2_m_arity[m] && ty != 0 && l2_dt(m, src - l2_m_arity[m]) = 0 && l2_dt_set(m, src - l2_m_arity[m], ty) != 0
                    return: 1
                if: src >= l2_m_arity[m] && ty != 0 && l2_dt(m, src - l2_m_arity[m]) = 0
                    \changed: 1
                if: src >= l2_m_arity[m] && ty = 0 && l2_dt(m, src - l2_m_arity[m]) != 0 && l2_dt_set(cidx, k, l2_dt(m, src - l2_m_arity[m])) != 0
                    return: 1
                if: src >= l2_m_arity[m] && ty = 0 && l2_dt(m, src - l2_m_arity[m]) != 0
                    \changed: 1
                k: k + 1
            cidx: cidx + 1
        m: m + 1
return: 0

fn: l2_dyn_typed (const: @(char path)) int
    int: m 0
    int: k
    while: m < l2_m_n
        k: 0
        while: k < l2_m_dyn[m]
            if: l2_dt(m, k) != 1 && l2_dt(m, k) != 2
                if: l2_dn(m, k) != 0
                    c.fprintf(c.stderr, "l2trans detail: unresolved dynamic=%.*s\n", (cast: (int) l2_dn(m, k)\length), l2_dn(m, k)\data)
                return: l2_error(path, l2_m_node[m], "unresolved name")
            k: k + 1
        m: m + 1
return: 0

fn: l2_dyn_close (const: @(char path)) int
    int: changed 1
    # Each successful step can only add one of the finite method/name/type
    # facts collected from this unit. Iterate to the actual fixed point; an
    # arbitrary pass count rejects valid long call chains.
    while: changed != 0
        changed: 0
        if: l2_dyn_step(path, @ changed) != 0
            return: 1
return: l2_dyn_typed(path)

fn: l2_dyn_analyze (const: @(char path)) int
    if: l2_dyn_local(path) != 0
        return: 1
return: 0

fn: l2_raw_fixed_field (int: ty; const: @(char name); size_t: n) int
    if: name = 0
