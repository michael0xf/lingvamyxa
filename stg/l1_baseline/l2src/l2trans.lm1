        return: 1
    if: ty = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: lmx_size_value(l2_xp\\data)\n", ind, t, ind, t) < 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", t) < 0
