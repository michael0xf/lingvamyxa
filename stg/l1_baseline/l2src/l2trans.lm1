        if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = sl && c.memcmp(l2_sn[l2_slot_off(mi, j)]\data, t\data, sl) = 0
            out_j[0]: j + 8
            if: t\length - sl - 1U = 4U && c.memcmp(t\data + sl + 1U, "data", 4U) = 0
                out_fld[0]: 0
                return: 0
            if: t\length - sl - 1U = 6U && c.memcmp(t\data + sl + 1U, "length", 6U) = 0
                out_fld[0]: 1
                return: 0
            if: t\length - sl - 1U = 7U && c.memcmp(t\data + sl + 1U, "columns", 7U) = 0
                out_fld[0]: 2
                return: 0
            if: t\length - sl - 1U = 5U && c.memcmp(t\data + sl + 1U, "count", 5U) = 0
                out_fld[0]: 3
                return: 0
            if: t\length - sl - 1U = 8U && c.memcmp(t\data + sl + 1U, "capacity", 8U) = 0
                out_fld[0]: 4
                return: 0
            return: 2
        j: j + 1
return: 1

fn: l2_index_head (const: @(LmP0Text t); int: mi; @: int out_j) int
    size_t: i
    size_t: lb
    size_t: n
    int: j
    if: t = 0 || t\data = 0 || out_j = 0
        return: 1
    n: t\length
    if: n < 4U
        return: 1
    if: t\data[n - 1U] != 93
        return: 1
    i: 0U
    lb: n
    while: i < n
        if: t\data[i] = 91
            lb: i
        i: i + 1U
    if: lb = n || lb = 0U
        return: 1
    if: lb + 1U >= n - 1U
        return: 2
    i: lb + 1U
    while: i < n - 1U
        if: t\data[i] < 48 || t\data[i] > 57
            return: 2
        i: i + 1U
    if: n - lb - 2U != 1U || t\data[lb + 1U] != 48
        return: 2
    if: mi < 0
        return: 3
    j: 0
    while: j < l2_m_arity[mi]
        if: l2_fn(mi, j) != 0 && l2_fn(mi, j)\length = lb && c.memcmp(l2_fn(mi, j)\data, t\data, lb) = 0
            if: l2_ft(mi, j) != 9 && l2_ft(mi, j) != 11 && l2_ft(mi, j) != 12
                return: 3
            out_j[0]: j
            return: 0
        j: j + 1
    return: 3
end: l2_index_head

fn: l2_slash_own (const: @(LmP0Text t)) int
    int: i 0
    size_t: n
    if: t = 0 || t\data = 0 || t\length < 6U
        return: -1
    if: t\data[0] != 110 || t\data[1] != 111 || t\data[2] != 100 || t\data[3] != 101 || t\data[4] != 92
        return: -1
    n: t\length - 5U
    while: i < l2_own_n
        if: l2_own_host[i] = 0 && l2_own_name[i] != 0 && l2_own_name[i]\length = n && c.memcmp(l2_own_name[i]\data, t\data + 5, n) = 0
            return: i
        i: i + 1
return: -1

fn: l2_slash_for (int: mi; const: @(LmP0Text t)) int
    int: i 0
    int: hit
    size_t: n
    hit: -1
    if: mi < 0 || t = 0 || t\data = 0 || t\length < 5U
        return: -1
    if: t\data[0] != 102 || t\data[1] != 111 || t\data[2] != 114 || t\data[3] != 92
        return: -1
    n: t\length - 4U
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_own_host[i] != 0 && l2_frame_head(l2_own_host[i], "for") && l2_own_name[i] != 0 && l2_own_name[i]\length = n && c.memcmp(l2_own_name[i]\data, t\data + 4, n) = 0 && hit >= 0
            return: -1
        if: l2_own_mi[i] = mi && l2_own_host[i] != 0 && l2_frame_head(l2_own_host[i], "for") && l2_own_name[i] != 0 && l2_own_name[i]\length = n && c.memcmp(l2_own_name[i]\data, t\data + 4, n) = 0
            hit: i
        i: i + 1
return: hit

fn: l2_own_decl_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    int: ty 0
    int: n
    if: l2_frame_head(stmt, "char")
        ty: 1
    if: l2_frame_head(stmt, "size_t")
        ty: 2
    if: l2_frame_head(stmt, "int")
        ty: 3
    if: ty = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: (ty = 1 || ty = 2) && n != 1
        return: 0
    if: ty = 3 && n != 1 && n != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_ident(f\value\as\atom) = 0
        return: 0
return: ty

fn: l2_own_store_ty (int: dty) int
