    # Merge sites are scanned before output so locals and result slots have
    # their final sizes. Throw/Message dependency closure was computed during
    # analysis, before METHOD.sig interning.
    l2_merge_max: 0
    i: 0
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            if: l2_merge_scan(l2_m_body[i]\as\structure) != 0
                return: 1
            ---
        ---
        i: i + 1
    ---
    i: 0
    # The widest merge across methods and entry must be known before the
    # preamble and any callable-local operand array are written.
    if: l2_main_body != 0 && l2_merge_scan(l2_main_body) != 0
        return: 1
    if: l2_main_body != 0 && l2_collect_body_hosts(l2_main_body, -1) != 0
        return: 1
    if: l2_layout_owns() != 0
        return: 1
    # The reserved unit-child bases must be known BEFORE any method body is
    # written: a field path inside a method addresses these same children
    # through the unit reference, and the entry is emitted last. They used to be
    # computed with the entry's child count, which left every in-method path
