fn: l2_parse_unit (const: @(LmP0Node main_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node body
    int: i 0
    if: main_node = 0 || main_node\as = 0 || main_node\as\frame = 0
        return: l2_error(path, main_node, "unsupported body")
