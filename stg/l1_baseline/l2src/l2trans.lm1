    i: lb + 1U
    while: i < n - 1U && t\data[i] >= 48 && t\data[i] <= 57
        i: i + 1U
    if: i = n - 1U
        if: n - lb - 2U > 1U && t\data[lb + 1U] = 48
            return: 2
