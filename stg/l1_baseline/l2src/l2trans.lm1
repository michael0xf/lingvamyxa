    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_xp: lmx_branch_slot_known(%s, %uU)\n%sif: l2_xp = 0\n", ind, l2_own_ctr(child), (cast: (unsigned) l2_own_uchild[child]), ind) < 0
        return: 1
    if: l2_emit_checkpoint(mi, deep) != 0
        return: 1
    if: mi >= 0 && l2_m_ret[mi] = 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn\n", deep) < 0
        return: 1
    if: mi >= 0 && l2_m_ret[mi] = 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sreturn: 0\n", deep) < 0
        return: 1
    if: mi >= 0 && l2_ret_uns(mi) != 0 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn: 0U\n", deep) < 0
        return: 1
    if: mi >= 0 && l2_ret_uns(mi) != 0 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: 0U\n%sreturn: 0\n", deep, deep) < 0
        return: 1
    if: (mi < 0 || (l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0))) && c.fprintf(l2_out, "%sreturn: 0\n", deep) < 0
        return: 1
    if: mi >= 0 && l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: 0\n%sreturn: 0\n", deep, deep) < 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: ty = 1 && c.fprintf(l2_out, "%schar: l2_t%d\n%sl2_t%d: (cast: (char) lmx_char_value_known(l2_xp[0]))\n", ind, t, ind, t) < 0
        return: 1
    if: ty = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: lmx_size_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", t) < 0
        return: 1
return: 0

fn: l2_tok_formal (int: mi; int: fi; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_p%d_%d", mi, fi) < 0
        return: 1
return: 0

fn: l2_tok_slot (int: mi; int: si; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_s%d_%d", mi, si) < 0
        return: 1
return: 0

fn: l2_check_addr (const: @(LmP0Node node); int: mi; const: @(char path)) int
    @: LmP0Field f
    @: LmP0Field g
    @: LmP0Field h
    const: @: LmP0Text t
    int: idx
    int: oi
    if: node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    # @ name \field: the address OF a field. An intrusive list walks with a
    # cursor that points at the next link itself, not at the node holding it.
    if: l2_count_active(node\as\frame\body) = 3
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        h: l2_next_active(g\next)
        if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_is_slash(g\value\as\atom) = 0 || h = 0 || h\value = 0 || h\value\kind != c.LM_P0_NODE_ATOM || l2_ident(h\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        return: l2_check_primary(f\value, mi, path)
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    t: f\value\as\atom
    idx: -1
    if: l2_loc_find(t) >= 0 || l2_entry_find(t) >= 0
        return: 0
    ---
    if: mi >= 0 && l2_ml_find(t) >= 0 && l2_ml_ty[l2_ml_find(t)] = 41
        return: 0
    if: mi >= 0
        idx: l2_param_find(mi, t)
    if: idx >= 0
        return: 0
    oi: -1
    if: mi >= 0
        oi: l2_own_find(mi, t)
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_own_is_array(l2_own_ty[oi]) = 0
        return: 0
return: l2_error(path, node, "unresolved name")

fn: l2_prep_addr (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    const: @: LmP0Text t
    int: idx
    int: oi
    int: fi
    int: temp
    c.array: [256]: char nm
    if: node = 0 || dest = 0 || ind = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: 1
    # The address of a field: render the field read the way every other field
    # read is rendered, and take its address.
    if: l2_count_active(node\as\frame\body) = 3
        nm[0]: 0
        if: l2_emit_fields(l2_next_active(node\as\frame\body\first_field), 3, mi, "", nm) != 0
            return: 1
        if: c.sprintf(dest, "@ %s", nm) < 0
            return: 1
        return: 0
    if: l2_count_active(node\as\frame\body) != 1
        return: 1
    f: l2_next_active(node\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    t: f\value\as\atom
    idx: -1
    if: l2_loc_find(t) >= 0 || l2_entry_find(t) >= 0
        if: l2_tok_text(t, nm, 256U) != 0
            return: 1
        if: c.sprintf(dest, "@ %s", nm) < 0
            return: 1
        return: 0
    ---
    if: mi >= 0 && l2_ml_find(t) >= 0 && l2_ml_ty[l2_ml_find(t)] = 41
        if: l2_tok_text(t, nm, 256U) != 0
            return: 1
        if: c.sprintf(dest, "@ %s", nm) < 0
            return: 1
        return: 0
    if: mi >= 0
        idx: l2_param_find(mi, t)
    if: idx >= 0
        if: c.sprintf(dest, "@ l2_p%d_%d", mi, idx) < 0
            return: 1
        return: 0
    oi: -1
    if: mi >= 0
        oi: l2_own_find(mi, t)
    if: oi < 0 || l2_m_uses[l2_own_off(mi, oi)] = 0
        return: 1
    if: l2_own_is_array(l2_own_ty[oi]) != 0
        return: 1
    # For an argument-as-own bind the argument branch above has already
    # returned its ordinary C address. A graph-backed own has a different
    # address: the typed payload cell selected by its child slot. Taking that
    # address neither writes nor dirties the activation cache.
    fi: l2_m_alias[l2_own_off(mi, oi)]
    if: fi >= 0 && c.sprintf(dest, "@ l2_p%d_%d", mi, fi) < 0
        return: 1
    if: fi >= 0
        return: 0
    if: l2_own_ty[oi] = 0 && c.sprintf(dest, "(cast: (@: int) l2_q%d_from[0])", oi) < 0
        return: 1
    if: l2_own_ty[oi] = 1 && c.sprintf(dest, "(cast: (@: char) l2_q%d_from[0])", oi) < 0
        return: 1
    if: l2_own_ty[oi] = 2 && c.sprintf(dest, "(cast: (@: size_t) l2_q%d_from[0])", oi) < 0
        return: 1
    if: l2_own_ty[oi] = 3 && c.sprintf(dest, "(cast: (@: unsigned) l2_q%d_from[0])", oi) < 0
        return: 1
    if: l2_own_ty[oi] = 36 && c.sprintf(dest, "(cast: (@: ulong) l2_q%d_from[0])", oi) < 0
        return: 1
    if: l2_own_is_pointer(l2_own_ty[oi]) != 0
        temp: l2_tn
        l2_tn: l2_tn + 1
        if: c.fputs(ind, l2_out) < 0 || l2_emit_raw_pointer_type(l2_out, l2_own_ty[oi] - 1000, 1) != 0 || c.fprintf(l2_out, " l2_t%d\n%sl2_t%d: (cast: (", temp, ind, temp) < 0 || l2_emit_raw_pointer_type(l2_out, l2_own_ty[oi] - 1000, 1) != 0 || c.fprintf(l2_out, ") l2_q%d_from[0])\n", oi) < 0
            return: 1
        if: c.sprintf(dest, "l2_t%d", temp) < 0
            return: 1
        return: 0
    ---
    if: l2_own_ty[oi] != 0 && l2_own_ty[oi] != 1 && l2_own_ty[oi] != 2 && l2_own_ty[oi] != 3 && l2_own_ty[oi] != 36
        return: 1
return: 0

fn: l2_cast_type (const: @(LmP0Node node); @: char dest) int
    @: LmP0Field f
    @: LmP0Field g
    const: @: LmP0Node item
    @: LmP0Field inner
    const: @: LmP0Node nested
    int: depth
    int: i
    size_t: out_end
    if: node = 0 || dest = 0 || node\kind != c.LM_P0_NODE_STRUCTURE || node\as = 0 || node\as\structure = 0
        return: 1
    f: l2_next_active(node\as\structure\first_field)
    if: l2_count_active(node\as\structure) = 2
        g: l2_next_active(f\next)
        if: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "unsigned") && l2_text_eq(g\value\as\atom, "char")
            if: c.sprintf(dest, "unsigned char") < 0
                return: 1
            return: 0
        ---
        return: 1
    if: l2_count_active(node\as\structure) != 1
        return: 1
    item: f\value
    if: item != 0 && item\kind = c.LM_P0_NODE_ATOM && (l2_ident(item\as\atom) || l2_text_eq(item\as\atom, "int") || l2_text_eq(item\as\atom, "char") || l2_text_eq(item\as\atom, "size_t") || l2_text_eq(item\as\atom, "unsigned") || l2_text_eq(item\as\atom, "void"))
        return: l2_tok_text(item\as\atom, dest, 256U)
    if: item = 0 || item\kind != c.LM_P0_NODE_FRAME || item\as = 0 || item\as\frame = 0
        return: 1
    if: l2_frame_head(item, "const")
        if: item\as\frame\body = 0 || l2_count_active(item\as\frame\body) != 1
            return: 1
        inner: l2_next_active(item\as\frame\body\first_field)
        if: inner = 0 || inner\value = 0 || inner\value\kind != c.LM_P0_NODE_FRAME || inner\value\as = 0 || inner\value\as\frame = 0
            return: 1
        nested: inner\value
        depth: l2_address_depth(nested\as\frame\head)
        if: depth = 0 || nested\as\frame\body = 0 || l2_count_active(nested\as\frame\body) != 1
            return: 1
        inner: l2_next_active(nested\as\frame\body\first_field)
        if: inner = 0 || inner\value = 0 || inner\value\kind != c.LM_P0_NODE_ATOM || (l2_ident(inner\value\as\atom) = 0 && l2_text_eq(inner\value\as\atom, "int") = 0)
            return: 1
        if: (cast: (size_t) depth) + inner\value\as\atom\length + 10U >= 256U
            return: 1
        c.memcpy(dest, "const: ", 7U)
        i: 0
        while: i < depth
            dest[7 + i]: 64
            i: i + 1
        dest[7 + depth]: 40
        c.memcpy(dest + 8 + depth, inner\value\as\atom\data, inner\value\as\atom\length)
        out_end: (cast: (size_t) depth) + 8U + inner\value\as\atom\length
        dest[out_end]: 41
        dest[out_end + 1U]: 0
        return: 0
    ---
    depth: l2_address_depth(item\as\frame\head)
    if: depth = 0 || item\as\frame\body = 0 || l2_count_active(item\as\frame\body) != 1
        return: 1
    inner: l2_next_active(item\as\frame\body\first_field)
    if: inner = 0 || inner\value = 0 || inner\value\kind != c.LM_P0_NODE_ATOM || (l2_ident(inner\value\as\atom) = 0 && l2_text_eq(inner\value\as\atom, "int") = 0)
        return: 1
    if: (cast: (size_t) depth) + inner\value\as\atom\length + 3U >= 256U
        return: 1
    i: 0
    while: i < depth
        dest[i]: 64
        i: i + 1
    dest[depth]: 58
    dest[depth + 1]: 32
    c.memcpy(dest + depth + 2, inner\value\as\atom\data, inner\value\as\atom\length)
    out_end: (cast: (size_t) depth) + 2U + inner\value\as\atom\length
    dest[out_end]: 0
return: 0

# True when a names exactly the n bytes at d.
fn: l2_text_is_bytes (const: @(LmP0Text a); const: @(char d); size_t: n) int
    if: a = 0 || a\data = 0 || d = 0 || a\length != n
        return: 0
return: c.memcmp(a\data, d, n) = 0

# c.sizeof(...) reaches the translator as one C surface atom, which was copied
# as written. When its operand is a single name that is a formal or an own
# scalar field, the name is an L2 variable whose C spelling is generated, so
# the operand is lowered to a C object of the same type: the formal itself, or
# a zero temporary of the own field's declared type. sizeof does not evaluate
# its operand, so there is no graph load. Own fields are resolved in the order
# l2_own_find uses. Any other operand is foreign C and stays as written.
# Returns 2 when the atom is not such a form.
fn: l2_prep_sizeof_name (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    const: @(char d) 0
    size_t: b 9U
    size_t: e 0U
    size_t: n 0U
    size_t: i 0U
    int: k 0
    int: oi -1
    int: t 0
    if: node = 0 || dest = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0 || node\as\atom\data = 0
        return: 2
    d: node\as\atom\data
    e: node\as\atom\length
    if: e < 11U || c.memcmp(d, "c.sizeof(", 9U) != 0 || d[e - 1U] != 41
        return: 2
    e: e - 1U
    while: b < e && d[b] = 32
        b: b + 1U
    while: e > b && d[e - 1U] = 32
        e: e - 1U
    n: e - b
    if: n = 0U || n > 200U
        return: 2
    if: d[b] != 95 && (d[b] < 65 || d[b] > 90) && (d[b] < 97 || d[b] > 122)
        return: 2
    i: b
    while: i < e
        if: d[i] != 95 && (d[i] < 65 || d[i] > 90) && (d[i] < 97 || d[i] > 122) && (d[i] < 48 || d[i] > 57)
            return: 2
        i: i + 1U
    if: mi >= 0
        k: 0
        while: k < l2_m_arity[mi]
            if: l2_text_is_bytes(l2_fn(mi, k), d + b, n)
                if: c.sprintf(dest, "c.sizeof(l2_p%d_%d)", mi, k) < 0
                    return: 1
                return: 0
            k: k + 1
        ---
        k: 0
        while: k < l2_own_n && oi < 0
            if: l2_own_mi[k] = mi && l2_text_is_bytes(l2_own_name[k], d + b, n) && (l2_own_host[k] = 0 || l2_scope_has(l2_own_host[k]))
                oi: k
            k: k + 1
        ---
    ---
    k: 0
    while: k < l2_own_n && oi < 0
        if: l2_own_mi[k] < 0 && l2_own_host[k] = 0 && l2_text_is_bytes(l2_own_name[k], d + b, n)
            oi: k
        k: k + 1
    if: oi < 0
        return: 2
    if: l2_own_ty[oi] != 0 && l2_own_ty[oi] != 1 && l2_own_ty[oi] != 2 && l2_own_ty[oi] != 3 && l2_own_ty[oi] != 36
        return: l2_error(l2_src, node, "c.sizeof of this own field type not yet implemented")
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_own_ty[oi] = 0 && c.fprintf(l2_out, "%sint: l2_t%d 0\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 1 && c.fprintf(l2_out, "%schar: l2_t%d 0\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d 0U\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 3 && c.fprintf(l2_out, "%sunsigned: l2_t%d 0U\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 36 && c.fprintf(l2_out, "%sulong: l2_t%d 0U\n", ind, t) < 0
        return: 1
    if: c.sprintf(dest, "c.sizeof(l2_t%d)", t) < 0
        return: 1
return: 0

fn: l2_prep (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    int: t
    int: idx
    int: n
    int: k
    int: actual_span
    int: actual_i
    int: raw_j
    int: raw_fld
    c.array: [256]: char s0
    c.array: [256]: char s1
    c.array: [256]: char s2
    c.array: [256]: char s3
    c.array: [256]: char s4
    @: char acts 0
    @: char hides 0
    int: nact 0
    int: nhid 0
    int: ai
    size_t: array_index
    if: node = 0 || dest = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_ATOM
        k: l2_prep_sizeof_name(node, mi, ind, dest)
        if: k != 2
            return: k
        k: l2_prefix_deref(node\as\atom, mi, dest)
        if: k = 0
            return: 0
        if: k = 2
            return: 1
        if: l2_own_index_head(node\as\atom, mi, @ idx, @ array_index) = 0
            return: l2_emit_array_load(idx, array_index, ind, dest)
        if: mi >= 0
            idx: l2_param_find(mi, node\as\atom)
            if: idx >= 0
                return: l2_tok_formal(mi, idx, dest)
            ---
        if: mi >= 0
            idx: l2_own_find(mi, node\as\atom)
            if: idx >= 0 && l2_own_is_array(l2_own_ty[idx]) != 0
                return: l2_emit_array_ptr(idx, ind, dest)
            if: idx >= 0 && l2_m_uses[l2_own_off(mi, idx)] != 0
                if: c.sprintf(dest, "l2_q%d", idx) < 0
                    return: 1
                return: 0
            ---
        if: mi >= 0
            idx: l2_slot_find(mi, node\as\atom)
            if: idx >= 0
                return: l2_tok_slot(mi, idx, dest)
            ---
        if: mi < 0
            idx: l2_own_find(mi, node\as\atom)
            if: idx >= 0 && l2_own_mi[idx] < 0 && l2_own_is_array(l2_own_ty[idx]) = 0
                t: l2_tn
                l2_tn: l2_tn + 1
                if: c.fprintf(l2_out, "%sl2_xp: lmx_branch_slot_known(unit, %uU)\n%sif: l2_xp = 0\n%s    return: 0\n", ind, (cast: (unsigned) l2_own_uchild[idx]), ind, ind) < 0
                    return: 1
                if: l2_own_ty[idx] = 0 && c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: lmx_int_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
                    return: 1
                if: l2_own_ty[idx] = 1 && c.fprintf(l2_out, "%schar: l2_t%d\n%sl2_t%d: (cast: (char) lmx_char_value_known(l2_xp[0]))\n", ind, t, ind, t) < 0
                    return: 1
                if: l2_own_ty[idx] = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: lmx_size_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
                    return: 1
                if: l2_own_ty[idx] = 3 && c.fprintf(l2_out, "%sunsigned: l2_t%d\n%sl2_t%d: lmx_unsigned_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
                    return: 1
                if: l2_own_ty[idx] = 36 && c.fprintf(l2_out, "%sulong: l2_t%d\n%sl2_t%d: lmx_ulong_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
                    return: 1
                if: l2_own_is_pointer(l2_own_ty[idx]) != 0
                    if: c.fputs(ind, l2_out) < 0 || l2_emit_own_pointer_type(l2_out, l2_own_ty[idx]) != 0 || c.fprintf(l2_out, " l2_t%d\n%sl2_t%d: (cast: (", t, ind, t) < 0 || l2_emit_own_pointer_type(l2_out, l2_own_ty[idx]) != 0 || c.fputs(") lmx_pointer_value_known(l2_xp[0]))\n", l2_out) < 0
                        return: 1
                ---
                return: l2_tok_temp(t, dest)
            ---
        return: l2_tok_text(node\as\atom, dest, 256U)
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "@")
        return: l2_prep_addr(node, mi, ind, dest)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        if: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
            return: l2_eval_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, ind, dest)
        s2[0]: 0
        s3[0]: 0
        if: l2_emit_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, ind, s2) != 0
            return: 1
        if: l2_cat(s3, "(") != 0
            return: l2_error(l2_src, node, "expression too long")
        if: l2_cat(s3, s2) != 0
            return: l2_error(l2_src, node, "expression too long")
        if: l2_cat(s3, ")") != 0
            return: l2_error(l2_src, node, "expression too long")
        c.memcpy(dest, s3, 256U)
        return: 0
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 1
    call: node\as\frame
    if: l2_text_eq(call\head, "cast")
