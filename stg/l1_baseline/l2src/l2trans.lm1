predef: "l1src/parser.lm1"
include: "<stdio.h>" "<string.h>" "<limits.h>" "<stdlib.h>"

# L2 -> L1 frontend: §1.7 main adapter, plus two-int no-throw methods under §21.8.

int: l2_leaf_mode 0
int: l2_library_mode 0
# Which predef declaration kind l2_predef_has_type is currently looking for:
# 0 = struct: only, 1 = fnptr: too. Set around one call and cleared after.
int: l2_want_fnptr 0
