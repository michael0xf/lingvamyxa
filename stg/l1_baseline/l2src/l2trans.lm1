            if: a1 != 0 && a1\value != 0 && a1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(a1\value\as\atom)
                n: 3
            if: t = 0 && l2_emit_fields(a0, n, mi, ind, s0) != 0
                return: 1
            if: t = 1 && l2_emit_fields(a0, n, mi, ind, s1) != 0
                return: 1
            k: 0
            while: k < n
                a0: l2_next_active(a0\next)
                k: k + 1
            t: t + 1
        if: l2_emit_checkpoint(mi, ind) != 0
            return: 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: l2_hash_compare_q(%s, %s)\n", ind, t, ind, t, s0, s1) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    if: idx < 0
        return: 1
    a0: l2_next_active(call\body\first_field)
    t: 0
    nact: l2_m_arity[idx]
    nhid: l2_m_dyn[idx]
    acts: 0
    hides: 0
    l2_alloc_kind: 4
    if: nact > 0
        if: l2_mul_ok((cast: (size_t) nact), 256U) = 0
            l2_alloc_err: 2
            return: l2_error(l2_src, node, "size overflow")
        acts: (cast: (@: char) l2_xmalloc((cast: (size_t) nact) * 256U))
        if: acts = 0
            return: l2_error(l2_src, node, "out of memory")
        c.memset((cast: (@: void) acts), 0, (cast: (size_t) nact) * 256U)
        ---
    while: a0 != 0
        if: t >= nact
            return: l2_prep_drop(acts, hides)
        if: l2_prep(a0\value, mi, ind, l2_act_at(acts, t)) != 0
            return: l2_prep_drop(acts, hides)
        t: t + 1
        a0: l2_next_active(a0\next)
    if: t != nact
        return: l2_prep_drop(acts, hides)
    if: nhid > 0
        if: l2_mul_ok((cast: (size_t) nhid), 256U) = 0
            l2_alloc_err: 2
            l2_prep_drop(acts, hides)
            return: l2_error(l2_src, node, "size overflow")
        hides: (cast: (@: char) l2_xmalloc((cast: (size_t) nhid) * 256U))
        if: hides = 0
            l2_prep_drop(acts, hides)
            return: l2_error(l2_src, node, "out of memory")
        c.memset((cast: (@: void) hides), 0, (cast: (size_t) nhid) * 256U)
        ai: 0
        while: ai < nhid
            if: l2_hidden_from(mi, idx, ai, ind, l2_act_at(hides, ai)) != 0
                return: l2_prep_drop(acts, hides)
            ai: ai + 1
        ---
    if: l2_emit_checkpoint(mi, ind) != 0
        return: l2_prep_drop(acts, hides)
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_m_ret[idx] = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 3 && c.fprintf(l2_out, "%s@: char l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 5 && c.fprintf(l2_out, "%s@: LmP0Text l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 10 && c.fprintf(l2_out, "%sLmP0TrailerRole: l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 13 && c.fprintf(l2_out, "%s@: LmP0IndentStack l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] != 2 && l2_m_ret[idx] != 3 && l2_m_ret[idx] != 5 && l2_m_ret[idx] != 8 && l2_m_ret[idx] != 10 && l2_m_ret[idx] != 13 && c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] = 8 && c.fprintf(l2_out, "%s", ind) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_ret[idx] != 8 && c.fprintf(l2_out, "%sl2_t%d: ", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_write_sym(l2_out, idx) != 0
        return: l2_prep_drop(acts, hides)
    if: c.fprintf(l2_out, "(%s", l2_call_node) < 0
        return: l2_prep_drop(acts, hides)
    ai: 0
    while: ai < nact
        if: c.fprintf(l2_out, ", %s", l2_act_at(acts, ai)) < 0
            return: l2_prep_drop(acts, hides)
        ai: ai + 1
    ai: 0
    while: ai < nhid
        if: c.fprintf(l2_out, ", %s", l2_act_at(hides, ai)) < 0
            return: l2_prep_drop(acts, hides)
        ai: ai + 1
    l2_prep_drop(acts, hides)
    if: c.fputs(")\n", l2_out) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_emit_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Node at 0
    int: i
    int: ao
    int: after 0
    int: fld
    int: po
    c.array: [256]: char buf
    c.array: [256]: char piece
    if: dest = 0
        return: 1
    buf[0]: 0
    if: n = 1
        return: l2_prep(l2_next_active(field)\value, mi, ind, dest)
    f: l2_next_active(field)
    i: 0
    ao: 0
    while: i < n && f != 0 && f\value != 0
        at: f\value
        fld: 0
        piece[0]: 0
        p1: 0
        p2: 0
        po: -1
        if: f\value\kind = c.LM_P0_NODE_ATOM
            p1: l2_next_active(f\next)
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM
            po: l2_path_own(mi, f\value\as\atom, p2\value\as\atom)
        if: po >= 0
            if: l2_emit_path_load(mi, po, ind, piece) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        if: after != 0 && f\value\kind = c.LM_P0_NODE_ATOM && (l2_text_eq(f\value\as\atom, "data") || l2_text_eq(f\value\as\atom, "length") || l2_text_eq(f\value\as\atom, "columns") || l2_text_eq(f\value\as\atom, "count") || l2_text_eq(f\value\as\atom, "capacity"))
            fld: 1
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            if: l2_cat(buf, "\\") != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 1
            fld: 2
        if: fld = 1
            if: l2_tok_text(f\value\as\atom, piece, 256U) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_brack(f\value\as\atom)
            if: l2_tok_text(f\value\as\atom, piece, 256U) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            fld: 2
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
            if: l2_cat(buf, " ") != 0
                return: l2_error(l2_src, at, "expression too long")
            if: l2_tok_text(f\value\as\atom, piece, 256U) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            if: l2_cat(buf, " ") != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: l2_is_andor(f\value\as\atom)
            fld: 2
        if: fld = 0 && ao != 0 && f\value\kind = c.LM_P0_NODE_FRAME && l2_find_method(f\value\as\frame\head) >= 0
            return: 1
        if: fld = 0 && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_find_method(f\value\as\frame\head) < 0) && l2_prep(f\value, mi, ind, piece) != 0
            return: 1
        if: fld = 0 && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_find_method(f\value\as\frame\head) < 0) && l2_cat(buf, piece) != 0
            return: l2_error(l2_src, at, "expression too long")
        if: fld = 0
            ao: 0
            after: 0
        f: l2_next_active(f\next)
        i: i + 1
    c.memcpy(dest, buf, 256U)
return: 0

fn: l2_eval_and (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    c.array: [64]: char deep
    c.array: [256]: char rhs
    if: dest = 0 || n <= 0
        return: 1
    if: l2_bump_ind(ind, deep) != 0
        return: 1
    span: l2_span_and(field, n)
    if: span = n
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_emit_fields(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest, rhs) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_and(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s\n", ind, dest) < 0
            return: 1
        if: l2_emit_fields(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest, rhs) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

fn: l2_eval_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    c.array: [64]: char deep
    c.array: [256]: char rhs
    if: dest = 0 || n <= 0
        return: 1
    if: l2_fields_has_call(field, n) = 0
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_bump_ind(ind, deep) != 0
        return: 1
    span: l2_span_or(field, n)
    if: span = n
        return: l2_eval_and(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_eval_and(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest, rhs) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_or(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s = 0\n", ind, dest) < 0
            return: 1
        if: l2_eval_and(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest, rhs) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

fn: l2_emit_sig (int: mi) int
    int: j 0
    if: c.fputs(" (@: Lmx node", l2_out) < 0
        return: 1
    while: j < l2_m_arity[mi]
        if: l2_ft(mi, j) = 0 && c.fprintf(l2_out, "; int: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 1 && c.fprintf(l2_out, "; char: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 2 && c.fprintf(l2_out, "; size_t: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 3 && c.fprintf(l2_out, "; const: @(char l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 4 && c.fprintf(l2_out, "; const: @(LmP0Text l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 5 && c.fprintf(l2_out, "; @: LmP0Text l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 6 && c.fprintf(l2_out, "; const: @(L2ImmutQuery l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 7 && c.fprintf(l2_out, "; @: L2ImmutQuery l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 9 && c.fprintf(l2_out, "; @: size_t l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 10 && c.fprintf(l2_out, "; LmP0TrailerRole: l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 11 && c.fprintf(l2_out, "; @: int l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 12 && c.fprintf(l2_out, "; @: char l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 13 && c.fprintf(l2_out, "; @: LmP0Document l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 14 && c.fprintf(l2_out, "; @: LmP0IndentStack l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 15 && c.fprintf(l2_out, "; const: @(LmP0IndentStack l2_p%d_%d)", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 16 && c.fprintf(l2_out, "; @: void l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 17 && c.fprintf(l2_out, "; @@: char l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 18 && c.fprintf(l2_out, "; @@: void l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 19 && c.fprintf(l2_out, "; @@: int l2_p%d_%d", mi, j) < 0
            return: 1
        if: l2_ft(mi, j) = 20 && c.fprintf(l2_out, "; @@: size_t l2_p%d_%d", mi, j) < 0
            return: 1
        j: j + 1
    j: 0
    while: j < l2_m_dyn[mi]
        if: l2_dt(mi, j) = 1 && c.fprintf(l2_out, "; char: l2_p%d_%d", mi, l2_m_arity[mi] + j) < 0
            return: 1
        if: l2_dt(mi, j) = 2 && c.fprintf(l2_out, "; size_t: l2_p%d_%d", mi, l2_m_arity[mi] + j) < 0
            return: 1
        j: j + 1
    if: l2_m_ret[mi] = 2 && c.fputs(") size_t", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 3 && c.fputs(") @: char", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 5 && c.fputs(") @: LmP0Text", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 8 && c.fputs(")", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 10 && c.fputs(") LmP0TrailerRole", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 13 && c.fputs(") @: LmP0IndentStack", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] != 2 && l2_m_ret[mi] != 3 && l2_m_ret[mi] != 5 && l2_m_ret[mi] != 8 && l2_m_ret[mi] != 10 && l2_m_ret[mi] != 13 && c.fputs(") int", l2_out) < 0
        return: 1
return: 0

fn: l2_emit_expr (const: @(LmP0Node node); int: mi; const: @(char ind)) int
return: l2_prep(node, mi, ind, l2_tok)

fn: l2_has_own_ty (int: ty) int
    int: i 0
    while: i < l2_own_n
        if: l2_own_ty[i] = ty
            return: 1
        i: i + 1
return: 0

fn: l2_emit_checkpoint (int: mi; const: @(char ind)) int
    int: i 0
    int: fi
    if: mi < 0 || ind = 0
        return: 0
    while: i < l2_own_n
        fi: l2_m_alias[l2_own_off(mi, i)]
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && c.fprintf(l2_out, "%sif: l2_q%d_dirty != 0\n", ind, i) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 1 && fi < 0 && c.fprintf(l2_out, "%s    l2_q%d_from\\data: lmx_char_cell((cast: (int) l2_q%d))\n", ind, i, i) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 1 && fi >= 0 && c.fprintf(l2_out, "%s    l2_q%d_from\\data: lmx_char_cell((cast: (int) l2_p%d_%d))\n", ind, i, mi, fi) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 2 && fi < 0 && c.fprintf(l2_out, "%s    if: lmx_size_store(l2_q%d_from\\data, l2_q%d) != 0\n%s        return: 0\n", ind, i, i, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 2 && fi >= 0 && c.fprintf(l2_out, "%s    if: lmx_size_store(l2_q%d_from\\data, l2_p%d_%d) != 0\n%s        return: 0\n", ind, i, mi, fi, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 0 && fi < 0 && c.fprintf(l2_out, "%s    if: lmx_int_store(l2_q%d_from\\data, l2_q%d) != 0\n%s        return: 0\n", ind, i, i, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && l2_own_ty[i] = 0 && fi >= 0 && c.fprintf(l2_out, "%s    if: lmx_int_store(l2_q%d_from\\data, l2_p%d_%d) != 0\n%s        return: 0\n", ind, i, mi, fi, ind) < 0
            return: 1
        if: l2_m_uses[l2_own_off(mi, i)] != 0 && c.fprintf(l2_out, "%s    l2_q%d_dirty: 0\n", ind, i) < 0
            return: 1
        i: i + 1
return: 0

fn: l2_emit_path_load (int: mi; int: oi; const: @(char ind); @: char dest) int
    int: t
    int: fid
    c.array: [64]: char deep
    if: dest = 0 || oi < 0 || ind = 0
        return: 1
    if: l2_bump_ind(ind, deep) != 0
        return: 1
    fid: l2_own_fid[oi]
    if: fid >= 0 && c.fprintf(l2_out, "%sl2_xp: lmx_branch_child(l2_h%d, %uU)\n", ind, fid, (cast: (unsigned) l2_own_fchild[oi])) < 0
        return: 1
    if: fid < 0 && l2_own_uchild[oi] < 0
        return: 1
    if: fid < 0 && c.fprintf(l2_out, "%sl2_xp: lmx_branch_child(node, %uU)\n", ind, (cast: (unsigned) l2_own_uchild[oi])) < 0
        return: 1
    if: c.fprintf(l2_out, "%sif: l2_xp = 0\n", ind) < 0
        return: 1
    if: l2_emit_checkpoint(mi, deep) != 0
        return: 1
    if: mi >= 0 && l2_m_ret[mi] = 8 && c.fprintf(l2_out, "%sreturn\n", deep) < 0
        return: 1
    if: mi >= 0 && l2_m_ret[mi] = 2 && c.fprintf(l2_out, "%sreturn: 0U\n", deep) < 0
        return: 1
    if: (mi < 0 || (l2_m_ret[mi] != 2 && l2_m_ret[mi] != 8)) && c.fprintf(l2_out, "%sreturn: 0\n", deep) < 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_own_ty[oi] = 0 && c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: lmx_int_value(l2_xp\\data)\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 1 && c.fprintf(l2_out, "%schar: l2_t%d\n%sl2_t%d: (cast: (char) lmx_char_value(l2_xp\\data))\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: lmx_size_value(l2_xp\\data)\n", ind, t, ind, t) < 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", t) < 0
        return: 1
return: 0

fn: l2_index_tail (@: LmP0Field f; @@: LmP0Field out_idx; @@: LmP0Field out_after) int
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Field p3
    if: out_idx = 0 || out_after = 0
        return: 1
    out_idx[0]: 0
    out_after[0]: 0
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 1
    if: l2_ident(f\value\as\atom) = 0
        return: 1
    p1: l2_next_active(f\next)
    if: p1 = 0 || p1\value = 0 || p1\value\kind != c.LM_P0_NODE_ATOM || p1\value\as = 0
        return: 1
    if: l2_text_eq(p1\value\as\atom, "[") = 0
        return: 1
    p2: l2_next_active(p1\next)
    if: p2 = 0 || p2\value = 0
        return: 1
    p3: l2_next_active(p2\next)
    if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || p3\value\as = 0
        return: 1
    if: l2_text_eq(p3\value\as\atom, "]") = 0
        return: 1
    out_idx[0]: p2
    out_after[0]: l2_next_active(p3\next)
return: 0

fn: l2_ccall_box_int (const: @(LmP0Node node); int: mi) int
    int: ei
    int: fi
    int: oi
    int: si
    int: ty
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0
        return: 0
    if: l2_quoted(node\as\atom) != 0
        return: 0
    if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
        return: 0
    ei: l2_entry_find(node\as\atom)
    if: ei >= 0 && l2_entry_ty != 0
        ty: l2_entry_ty[ei]
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    if: mi >= 0
        fi: l2_param_find(mi, node\as\atom)
        if: fi >= 0
            ty: l2_param_ty(mi, node\as\atom)
            if: ty = 0 || ty = 1
                return: 1
            return: 0
        oi: l2_own_find(mi, node\as\atom)
        if: oi >= 0
            ty: l2_own_ty[oi]
            if: ty = 0 || ty = 1
                return: 1
            return: 0
        si: l2_slot_find(mi, node\as\atom)
        if: si >= 0
            ty: l2_st[l2_slot_off(mi, si)]
            if: ty = 0 || ty = 1
                return: 1
            return: 0
        ---
    ---
return: 1

fn: l2_emit_ccall (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    @: LmP0Field f
    @: LmP0Field p1
    @: LmP0Field p2
    int: n
    int: i
    int: po
    int: first 1
    c.array: [256]: char buf
    c.array: [256]: char piece
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 1
    buf[0]: 0
    if: l2_tok_text(stmt\as\frame\head, buf, 256U) != 0
        return: 1
    if: l2_cat(buf, "(") != 0
        return: 1
    n: l2_count_active(stmt\as\frame\body)
    f: l2_next_active(stmt\as\frame\body\first_field)
    i: 0
    while: i < n && f != 0 && f\value != 0
        piece[0]: 0
        p1: 0
        p2: 0
        po: -1
        if: f\value\kind = c.LM_P0_NODE_ATOM
            p1: l2_next_active(f\next)
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM
            po: l2_path_own(mi, f\value\as\atom, p2\value\as\atom)
        if: po >= 0
            if: l2_emit_path_load(mi, po, ind, piece) != 0
                return: 1
            i: i + 2
            f: p2
        if: po < 0 && l2_index_tail(f, @ p1, @ p2) = 0
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_prep(f\value, mi, ind, piece) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            if: l2_cat(buf, "[") != 0
                return: 1
            piece[0]: 0
            if: l2_prep(p1\value, mi, ind, piece) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            if: l2_cat(buf, "]") != 0
                return: 1
            first: 0
            i: i + 4
            f: p2
            continue
        ---
        if: po < 0 && l2_prep(f\value, mi, ind, piece) != 0
            return: 1
        if: po < 0 && l2_ccall_box_int(f\value, mi) != 0 && l2_new_temp(ind, l2_tok) != 0
            return: 1
        if: po < 0 && l2_ccall_box_int(f\value, mi) != 0 && c.fprintf(l2_out, "%s%s: %s\n", ind, l2_tok, piece) < 0
            return: 1
        if: po < 0 && l2_ccall_box_int(f\value, mi) != 0
            c.memcpy(piece, l2_tok, 256U)
        if: first = 0 && l2_cat(buf, ", ") != 0
            return: 1
        if: l2_cat(buf, piece) != 0
            return: 1
        first: 0
        i: i + 1
        f: l2_next_active(f\next)
    if: l2_cat(buf, ")") != 0
        return: 1
    if: l2_emit_checkpoint(mi, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%s%s\n", ind, buf) < 0
        return: 1
return: 0

fn: l2_emit_body (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    int: oi
    int: si
    int: fi
    int: sl
    int: rj 0
    int: rf 0
    int: raw 1
    int: ix 1
    int: need_cut 0
    size_t: ln
    c.array: [64]: char deep
    c.array: [64]: char wdeep
    c.array: [64]: char wcond
    c.array: [64]: char wkeep
    c.array: [64]: char wfirst
    if: body = 0
        return: 0
    ln: c.strlen(ind)
    if: ln + 5U >= 64U
        return: 1
    c.memcpy(deep, ind, ln)
    deep[ln]: 32
    deep[ln + 1U]: 32
    deep[ln + 2U]: 32
    deep[ln + 3U]: 32
    deep[ln + 4U]: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: l2_frame_head(stmt, "return") && need_cut != 0 && c.fprintf(l2_out, "%s---\n", ind) < 0
            return: 1
        if: l2_frame_head(stmt, "return") = 0 && l2_frame_head(stmt, "if") = 0
            need_cut: 0
        oi: -1
        si: -1
        fi: -1
        sl: -1
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_eval_fields(fr\body\first_field, n - 1, mi, ind, l2_tok) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", ind, l2_tok) < 0
                return: 1
            if: l2_emit_body(last\value\as\structure, mi, deep) != 0
                return: 1
            if: fr\trailer != 0 && l2_text_eq(fr\trailer\spelling, "---") && c.fprintf(l2_out, "%s---\n", deep) < 0
                return: 1
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && c.fprintf(l2_out, "%selse:\n", ind) < 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && l2_emit_body(nxt\value\as\frame\body, mi, deep) != 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            need_cut: 1
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            wkeep[0]: 0
            wcond[0]: 0
            wdeep[0]: 0
            if: l2_bump_ind(deep, wdeep) != 0
                return: 1
            if: l2_new_temp(ind, wkeep) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wkeep) < 0
                return: 1
            if: l2_new_temp(ind, wcond) != 0
                return: 1
            if: c.fprintf(l2_out, "%swhile: %s\n", ind, wkeep) < 0
                return: 1
            if: l2_eval_cond(fr\body\first_field, n - 1, mi, deep, wcond) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wcond) < 0
                return: 1
            if: c.fprintf(l2_out, "%s    %s: 0\n", deep, wkeep) < 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", deep, wkeep) < 0
                return: 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_emit_body(last\value\as\structure, mi, wdeep) != 0
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            l2_loop_depth: l2_loop_depth - 1
            if: c.fprintf(l2_out, "%send: while\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for")
            fr: stmt\as\frame
            if: l2_for_cstyle(stmt) = 0
                return: 1
            last: l2_next_active(fr\body\first_field)
            if: l2_scope_push(stmt) != 0
                return: 1
            wkeep[0]: 0
            wcond[0]: 0
            wdeep[0]: 0
            wfirst[0]: 0
            if: l2_bump_ind(deep, wdeep) != 0
                l2_scope_pop()
                return: 1
            oi: l2_own_find(mi, l2_next_active(last\value\as\frame\body\first_field)\value\as\atom)
            if: oi < 0
                l2_scope_pop()
                return: 1
            if: l2_eval_fields(l2_next_active(l2_next_active(last\value\as\frame\body\first_field)\next), 1, mi, ind, l2_tok) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sl2_q%d: %s\n%sl2_q%d_dirty: 1\n", ind, oi, l2_tok, ind, oi) < 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: l2_new_temp(ind, wkeep) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: l2_new_temp(ind, wfirst) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wfirst) < 0
                l2_scope_pop()
                return: 1
            if: l2_new_temp(ind, wcond) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%swhile: %s\n", ind, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wfirst) < 0
                l2_scope_pop()
                return: 1
            nxt: l2_next_active(last\next)
            if: nxt = 0 || nxt\value = 0 || nxt\value\kind != c.LM_P0_NODE_ATOM
                l2_scope_pop()
                return: 1
            si: l2_own_find(mi, nxt\value\as\atom)
            if: si < 0
                l2_scope_pop()
                return: 1
            nxt: l2_next_active(nxt\next)
            if: nxt != 0 && nxt\value != 0 && l2_text_eq(nxt\value\as\atom, "--") && c.fprintf(l2_out, "%s    l2_q%d: l2_q%d - 1\n%s    l2_q%d_dirty: 1\n", deep, si, si, deep, si) < 0
                l2_scope_pop()
                return: 1
            if: nxt != 0 && nxt\value != 0 && l2_text_eq(nxt\value\as\atom, "--") = 0 && c.fprintf(l2_out, "%s    l2_q%d: l2_q%d + 1\n%s    l2_q%d_dirty: 1\n", deep, si, si, deep, si) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 0\n", deep, wfirst) < 0
                l2_scope_pop()
                return: 1
            if: last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                l2_scope_pop()
                return: 1
            if: l2_eval_cond(last\value\as\structure\first_field, l2_count_active(last\value\as\structure), mi, deep, wcond) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wcond) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s    %s: 0\n", deep, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", deep, wkeep) < 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < 5
                last: l2_next_active(last\next)
                k: k + 1
            l2_loop_depth: l2_loop_depth + 1
            if: last = 0 || last\value = 0 || last\value\as = 0 || l2_emit_body(last\value\as\structure, mi, wdeep) != 0
                l2_loop_depth: l2_loop_depth - 1
                l2_scope_pop()
                return: 1
            l2_loop_depth: l2_loop_depth - 1
            if: c.fprintf(l2_out, "%send: while\n", ind) < 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "continue")
            if: c.fprintf(l2_out, "%scontinue\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "return") && mi >= 0 && l2_m_ret[mi] = 8
            if: l2_emit_checkpoint(mi, ind) != 0
                return: 1
            if: c.fprintf(l2_out, "%sreturn\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "return")
            return: 1
        ix: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
            ix: l2_index_head(stmt\as\frame\head, mi, @ rj)
        if: ix = 0
            fr: stmt\as\frame
        if: ix = 0 && (fr\body = 0 || fr\trailer != 0)
            return: 1
        if: ix = 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: ix = 0 && c.fprintf(l2_out, "%sl2_p%d_%d[0]: %s\n", ind, mi, rj, l2_tok) < 0
            return: 1
        if: ix = 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "continue") || l2_frame_head(stmt, "break")
            return: 1
        if: l2_frame_head(stmt, "c.printf") || l2_frame_head(stmt, "c.fputs") || l2_frame_head(stmt, "c.fprintf") || l2_frame_head(stmt, "c.fflush") || l2_frame_head(stmt, "c.setvbuf")
            if: l2_emit_ccall(stmt, mi, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0
            oi: l2_own_find(mi, l2_next_active(stmt\as\frame\body\first_field)\value\as\atom)
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && mi >= 0
            l2_own_live[oi]: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && mi >= 0 && l2_m_alias[l2_own_off(mi, oi)] >= 0 && (l2_own_ty[oi] = 1 || l2_own_ty[oi] = 2) && c.fprintf(l2_out, "%sl2_q%d_from: lmx_branch_child(node, %uU)\n%sif: l2_q%d_from = 0\n%s    return: 0\n", ind, oi, (cast: (unsigned) oi), ind, oi, ind) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && l2_count_active(stmt\as\frame\body) = 2 && l2_eval_fields(l2_next_active(l2_next_active(stmt\as\frame\body\first_field)\next), 1, mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && l2_count_active(stmt\as\frame\body) = 2 && c.fprintf(l2_out, "%sl2_q%d: %s\n%sl2_q%d_dirty: 1\n", ind, oi, l2_tok, ind, oi) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (stmt = 0 || stmt\as = 0 || stmt\as\frame = 0)
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && mi >= 0 && l2_m_ret[mi] = 8 && l2_emit_checkpoint(mi, ind) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && mi >= 0 && l2_m_ret[mi] = 8 && c.fprintf(l2_out, "%sreturn\n", ind) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && mi >= 0 && l2_m_ret[mi] = 8
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && (mi < 0 || l2_m_ret[mi] != 8) && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && (mi < 0 || l2_m_ret[mi] != 8) && l2_emit_checkpoint(mi, ind) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && (mi < 0 || l2_m_ret[mi] != 8) && c.fprintf(l2_out, "%sreturn: %s\n", ind, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && (mi < 0 || l2_m_ret[mi] != 8)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0
            oi: l2_own_find(mi, fr\head)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && mi >= 0 && oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] = 0
            oi: -1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0
            si: l2_slot_find(mi, fr\head)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0
            fi: l2_param_find(mi, fr\head)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && mi >= 0
            fi: l2_m_alias[l2_own_off(mi, oi)]
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && fi >= 0 && c.fprintf(l2_out, "%sif: l2_q%d_from = 0\n%s    l2_q%d_from: lmx_branch_child(node, %uU)\n%sif: l2_q%d_from = 0\n%s    return: 0\n", ind, oi, ind, oi, (cast: (unsigned) oi), ind, oi, ind) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && fi >= 0
            l2_own_live[oi]: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && fi < 0 && c.fprintf(l2_out, "%sl2_q%d: %s\n", ind, oi, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi >= 0 && fi >= 0 && c.fprintf(l2_out, "%sl2_p%d_%d: %s\n", ind, mi, fi, l2_tok) < 0
            return: 1
