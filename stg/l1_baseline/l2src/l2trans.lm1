            return: l2_error(path, item, "size overflow")
        cap: cap * 2
        psz: c.sizeof(l2_ptr_probe)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0
            return: l2_error(path, item, "size overflow")
        nb: (cast: (size_t) cap) * psz
        nn: (cast: (@@: LmP0Node) l2_xmalloc(nb))
        if: nn = 0
            return: l2_error(path, item, "out of memory")
        c.memset((cast: (@: void) nn), 0, nb)
        if: l2_def != 0 && l2_def_n > 0
            c.memcpy((cast: (@: void) nn), (cast: (@: void) l2_def), (cast: (size_t) l2_def_n) * psz)
        ---
        if: l2_def != 0
            l2_xfree((cast: (@: void) l2_def))
        ---
        l2_def: nn
        l2_def_cap: cap
    ---
    l2_def[l2_def_n]: (cast: (@: LmP0Node) item)
    l2_def_n: l2_def_n + 1
return: 0

fn: l2_inc_push (const: @(LmP0Text t); const: @(char path); const: @(LmP0Node at)) int
    int: cap
    size_t: nb
    size_t: psz
    @@: LmP0Text nn 0
    if: t = 0
        return: l2_error(path, at, "unsupported argument")
    cap: l2_inc_cap
    if: l2_inc_n >= cap
        if: cap < 1
            cap: 4
        ---
        if: cap > (c.INT_MAX / 2)
            return: l2_error(path, at, "size overflow")
        cap: cap * 2
        psz: c.sizeof(l2_ptr_probe)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0
            return: l2_error(path, at, "size overflow")
        nb: (cast: (size_t) cap) * psz
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        if: nn = 0
            return: l2_error(path, at, "out of memory")
        c.memset((cast: (@: void) nn), 0, nb)
        if: l2_inc != 0 && l2_inc_n > 0
            c.memcpy((cast: (@: void) nn), (cast: (@: void) l2_inc), (cast: (size_t) l2_inc_n) * psz)
        ---
