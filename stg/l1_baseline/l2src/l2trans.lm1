            c.fclose(l2_out)
            return: 1
        if: l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && l2_own_mi[k] < 0 && l2_own_ty[k] = 1 && l2_unit_own_init(k) != 0U && c.fprintf(l2_out, "        slot[0]: lmx_char_rebind_known(slot[0], %u)\n        if: slot[0] = 0\n            return: 1\n", (cast: (unsigned) l2_unit_own_init(k))) < 0
