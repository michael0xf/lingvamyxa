    if: l2_sn != 0
        l2_xfree((cast: (@: void) l2_sn))
    if: l2_st != 0
        l2_xfree((cast: (@: void) l2_st))
    l2_m_name: 0
    l2_m_f0: 0
    l2_m_f1: 0
    l2_m_node: 0
    l2_m_body: 0
    l2_m_sig: 0
    l2_m_mark: 0
    l2_m_arity: 0
    l2_m_dyn: 0
    l2_m_ret: 0
    l2_m_value_used: 0
    l2_m_own: 0
    l2_m_sn: 0
    l2_m_hcap: 0
    l2_m_fcap: 0
    l2_m_dn: 0
    l2_m_dt: 0
    l2_m_fn: 0
    l2_m_ft: 0
    l2_m_edge: 0
    l2_sn: 0
    l2_st: 0
    l2_slot_cap: 0
    l2_m_n: 0
    l2_m_cap: 0
return: 0

fn: l2_meth_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    size_t: ni
    size_t: nu
    size_t: nedge_n
    size_t: nslot
    size_t: oldcap
    size_t: slotcap
    size_t: off
    size_t: noff
    size_t: oc
    int: i
    int: j
    @@: LmP0Text nname 0
    @@: LmP0Text nf0 0
    @@: LmP0Text nf1 0
    @@: LmP0Node nnode 0
    @@: LmP0Node nbody 0
    @: unsigned nsig 0
    @: int nmark 0
    @: int narity 0
    @: int ndyn 0
    @: int nret 0
    @: int nown 0
    @: int nsn 0
    @: int nhcap 0
    @: int nfcap 0
    @@: void ndn 0
    @@: int ndt 0
    @@: void nfn 0
    @@: int nft 0
    @: int nedge 0
    @@: LmP0Text nslots 0
    @: int nst 0
    @: int nuses 0
    @: int nalias 0
    @: int npre 0
    if: need < 0
        return: 1
    if: need <= l2_m_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_m_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX) && need_u > (cast: (size_t) c.INT_MAX)
        l2_alloc_err: 2
        return: 1
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: need_u
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, c.sizeof(c.unsigned)) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, cap) = 0
        l2_alloc_err: 2
        return: 1
    nedge_n: cap * cap
    if: l2_mul_ok(nedge_n, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    slotcap: (cast: (size_t) l2_slot_cap)
    if: slotcap < 1U
        slotcap: 4U
    if: l2_mul_ok(cap, slotcap) = 0
        l2_alloc_err: 2
        return: 1
    nslot: cap * slotcap
    if: l2_mul_ok(nslot, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(nslot, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    nu: cap * c.sizeof(c.unsigned)
    l2_alloc_kind: 6
    nname: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nf0: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nf1: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nnode: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nbody: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nsig: (cast: (@: unsigned) l2_xmalloc(nu))
    nmark: (cast: (@: int) l2_xmalloc(ni))
    narity: (cast: (@: int) l2_xmalloc(ni))
    ndyn: (cast: (@: int) l2_xmalloc(ni))
    nret: (cast: (@: int) l2_xmalloc(ni))
    nown: (cast: (@: int) l2_xmalloc(ni))
    nsn: (cast: (@: int) l2_xmalloc(ni))
    nhcap: (cast: (@: int) l2_xmalloc(ni))
    nfcap: (cast: (@: int) l2_xmalloc(ni))
    ndn: (cast: (@@: void) l2_xmalloc(nb))
    ndt: (cast: (@@: int) l2_xmalloc(nb))
    nfn: (cast: (@@: void) l2_xmalloc(nb))
    nft: (cast: (@@: int) l2_xmalloc(nb))
    nedge: (cast: (@: int) l2_xmalloc(nedge_n * c.sizeof(c.int)))
    nslots: (cast: (@@: LmP0Text) l2_xmalloc(nslot * psz))
    nst: (cast: (@: int) l2_xmalloc(nslot * c.sizeof(c.int)))
    if: nname = 0 || nf0 = 0 || nf1 = 0 || nnode = 0 || nbody = 0 || nsig = 0 || nmark = 0 || narity = 0 || ndyn = 0 || nret = 0 || nown = 0 || nsn = 0 || nhcap = 0 || nfcap = 0 || ndn = 0 || ndt = 0 || nfn = 0 || nft = 0 || nedge = 0 || nslots = 0 || nst = 0
        if: nname != 0
            l2_xfree((cast: (@: void) nname))
        if: nf0 != 0
            l2_xfree((cast: (@: void) nf0))
        if: nf1 != 0
            l2_xfree((cast: (@: void) nf1))
        if: nnode != 0
            l2_xfree((cast: (@: void) nnode))
        if: nbody != 0
            l2_xfree((cast: (@: void) nbody))
        if: nsig != 0
            l2_xfree((cast: (@: void) nsig))
        if: nmark != 0
            l2_xfree((cast: (@: void) nmark))
        if: narity != 0
            l2_xfree((cast: (@: void) narity))
        if: ndyn != 0
            l2_xfree((cast: (@: void) ndyn))
        if: nret != 0
            l2_xfree((cast: (@: void) nret))
        if: nown != 0
            l2_xfree((cast: (@: void) nown))
        if: nsn != 0
            l2_xfree((cast: (@: void) nsn))
        if: nhcap != 0
            l2_xfree((cast: (@: void) nhcap))
        if: nfcap != 0
            l2_xfree((cast: (@: void) nfcap))
        if: ndn != 0
            l2_xfree((cast: (@: void) ndn))
        if: ndt != 0
            l2_xfree((cast: (@: void) ndt))
        if: nfn != 0
            l2_xfree((cast: (@: void) nfn))
        if: nft != 0
            l2_xfree((cast: (@: void) nft))
        if: nedge != 0
            l2_xfree((cast: (@: void) nedge))
        if: nslots != 0
            l2_xfree((cast: (@: void) nslots))
        if: nst != 0
            l2_xfree((cast: (@: void) nst))
        return: 1
    c.memset((cast: (@: void) nname), 0, nb)
    c.memset((cast: (@: void) nf0), 0, nb)
    c.memset((cast: (@: void) nf1), 0, nb)
    c.memset((cast: (@: void) nnode), 0, nb)
    c.memset((cast: (@: void) nbody), 0, nb)
    c.memset((cast: (@: void) nsig), 0, nu)
    c.memset((cast: (@: void) nmark), 0, ni)
    c.memset((cast: (@: void) narity), 0, ni)
    c.memset((cast: (@: void) ndyn), 0, ni)
    c.memset((cast: (@: void) nret), 0, ni)
    c.memset((cast: (@: void) nown), 0, ni)
    c.memset((cast: (@: void) nsn), 0, ni)
    c.memset((cast: (@: void) nhcap), 0, ni)
    c.memset((cast: (@: void) nfcap), 0, ni)
    c.memset((cast: (@: void) ndn), 0, nb)
    c.memset((cast: (@: void) ndt), 0, nb)
    c.memset((cast: (@: void) nfn), 0, nb)
    c.memset((cast: (@: void) nft), 0, nb)
    c.memset((cast: (@: void) nedge), 0, nedge_n * c.sizeof(c.int))
    c.memset((cast: (@: void) nslots), 0, nslot * psz)
    c.memset((cast: (@: void) nst), 0, nslot * c.sizeof(c.int))
    oldcap: (cast: (size_t) l2_m_cap)
    i: 0
    while: i < l2_m_n
        nname[i]: l2_m_name[i]
        nf0[i]: l2_m_f0[i]
        nf1[i]: l2_m_f1[i]
        nnode[i]: l2_m_node[i]
        nbody[i]: l2_m_body[i]
        nsig[i]: l2_m_sig[i]
        nmark[i]: l2_m_mark[i]
        narity[i]: l2_m_arity[i]
        ndyn[i]: l2_m_dyn[i]
        nret[i]: l2_m_ret[i]
        nown[i]: l2_m_own[i]
        nsn[i]: l2_m_sn[i]
        nhcap[i]: l2_m_hcap[i]
        nfcap[i]: l2_m_fcap[i]
        ndn[i]: l2_m_dn[i]
        ndt[i]: l2_m_dt[i]
        nfn[i]: l2_m_fn[i]
        nft[i]: l2_m_ft[i]
        i: i + 1
    i: 0
    while: i < l2_m_n
        j: 0
        while: j < l2_m_n
            off: (cast: (size_t) i) * oldcap
            off: off + (cast: (size_t) j)
            noff: (cast: (size_t) i) * cap
            noff: noff + (cast: (size_t) j)
            nedge[noff]: l2_m_edge[off]
            j: j + 1
        i: i + 1
    i: 0
    while: i < l2_m_n
        j: 0
        while: j < l2_m_sn[i]
            off: (cast: (size_t) i) * (cast: (size_t) l2_slot_cap)
            off: off + (cast: (size_t) j)
            noff: (cast: (size_t) i) * slotcap
            noff: noff + (cast: (size_t) j)
            nslots[noff]: l2_sn[off]
            nst[noff]: l2_st[off]
            j: j + 1
        i: i + 1
    oc: (cast: (size_t) l2_own_cap)
    if: oc != 0U && l2_m_uses != 0
        if: l2_mul3_ok(cap, oc, c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            l2_xfree((cast: (@: void) nname))
            l2_xfree((cast: (@: void) nf0))
            l2_xfree((cast: (@: void) nf1))
            l2_xfree((cast: (@: void) nnode))
            l2_xfree((cast: (@: void) nbody))
            l2_xfree((cast: (@: void) nsig))
            l2_xfree((cast: (@: void) nmark))
            l2_xfree((cast: (@: void) narity))
            l2_xfree((cast: (@: void) ndyn))
            l2_xfree((cast: (@: void) nret))
            l2_xfree((cast: (@: void) nown))
            l2_xfree((cast: (@: void) nsn))
            l2_xfree((cast: (@: void) nhcap))
            l2_xfree((cast: (@: void) nfcap))
            l2_xfree((cast: (@: void) ndn))
            l2_xfree((cast: (@: void) ndt))
            l2_xfree((cast: (@: void) nfn))
            l2_xfree((cast: (@: void) nft))
            l2_xfree((cast: (@: void) nedge))
            l2_xfree((cast: (@: void) nslots))
            l2_xfree((cast: (@: void) nst))
            return: 1
        nuses: (cast: (@: int) l2_xmalloc(cap * oc * c.sizeof(c.int)))
        nalias: (cast: (@: int) l2_xmalloc(cap * oc * c.sizeof(c.int)))
        npre: (cast: (@: int) l2_xmalloc(cap * oc * c.sizeof(c.int)))
        if: nuses = 0 || nalias = 0 || npre = 0
            if: nuses != 0
                l2_xfree((cast: (@: void) nuses))
            if: nalias != 0
                l2_xfree((cast: (@: void) nalias))
            if: npre != 0
                l2_xfree((cast: (@: void) npre))
            l2_xfree((cast: (@: void) nname))
            l2_xfree((cast: (@: void) nf0))
            l2_xfree((cast: (@: void) nf1))
            l2_xfree((cast: (@: void) nnode))
            l2_xfree((cast: (@: void) nbody))
            l2_xfree((cast: (@: void) nsig))
            l2_xfree((cast: (@: void) nmark))
            l2_xfree((cast: (@: void) narity))
            l2_xfree((cast: (@: void) ndyn))
            l2_xfree((cast: (@: void) nret))
            l2_xfree((cast: (@: void) nown))
            l2_xfree((cast: (@: void) nsn))
            l2_xfree((cast: (@: void) nhcap))
            l2_xfree((cast: (@: void) nfcap))
            l2_xfree((cast: (@: void) ndn))
            l2_xfree((cast: (@: void) ndt))
            l2_xfree((cast: (@: void) nfn))
            l2_xfree((cast: (@: void) nft))
            l2_xfree((cast: (@: void) nedge))
            l2_xfree((cast: (@: void) nslots))
            l2_xfree((cast: (@: void) nst))
            return: 1
        c.memset((cast: (@: void) nuses), 0, cap * oc * c.sizeof(c.int))
        c.memset((cast: (@: void) npre), 0, cap * oc * c.sizeof(c.int))
        i: 0
        while: i < (cast: (int) cap)
            j: 0
            while: j < l2_own_cap
                noff: (cast: (size_t) i) * oc
                noff: noff + (cast: (size_t) j)
                nalias[noff]: -1
                j: j + 1
            i: i + 1
        i: 0
        while: i < (cast: (int) oldcap)
            j: 0
            while: j < l2_own_n
                off: (cast: (size_t) i) * oc
                off: off + (cast: (size_t) j)
                noff: (cast: (size_t) i) * oc
                noff: noff + (cast: (size_t) j)
                nuses[noff]: l2_m_uses[off]
                nalias[noff]: l2_m_alias[off]
                npre[noff]: l2_m_pre[off]
                j: j + 1
            i: i + 1
        l2_xfree((cast: (@: void) l2_m_uses))
        l2_xfree((cast: (@: void) l2_m_alias))
        l2_xfree((cast: (@: void) l2_m_pre))
        l2_m_uses: nuses
        l2_m_alias: nalias
        l2_m_pre: npre
        ---
    if: l2_m_name != 0
        l2_xfree((cast: (@: void) l2_m_name))
    if: l2_m_f0 != 0
        l2_xfree((cast: (@: void) l2_m_f0))
    if: l2_m_f1 != 0
        l2_xfree((cast: (@: void) l2_m_f1))
    if: l2_m_node != 0
        l2_xfree((cast: (@: void) l2_m_node))
    if: l2_m_body != 0
        l2_xfree((cast: (@: void) l2_m_body))
    if: l2_m_sig != 0
        l2_xfree((cast: (@: void) l2_m_sig))
    if: l2_m_mark != 0
        l2_xfree((cast: (@: void) l2_m_mark))
    if: l2_m_arity != 0
        l2_xfree((cast: (@: void) l2_m_arity))
    if: l2_m_dyn != 0
        l2_xfree((cast: (@: void) l2_m_dyn))
    if: l2_m_ret != 0
        l2_xfree((cast: (@: void) l2_m_ret))
    if: l2_m_own != 0
        l2_xfree((cast: (@: void) l2_m_own))
    if: l2_m_sn != 0
        l2_xfree((cast: (@: void) l2_m_sn))
    if: l2_m_hcap != 0
        l2_xfree((cast: (@: void) l2_m_hcap))
    if: l2_m_fcap != 0
        l2_xfree((cast: (@: void) l2_m_fcap))
    if: l2_m_dn != 0
        l2_xfree((cast: (@: void) l2_m_dn))
    if: l2_m_dt != 0
        l2_xfree((cast: (@: void) l2_m_dt))
    if: l2_m_fn != 0
        l2_xfree((cast: (@: void) l2_m_fn))
    if: l2_m_ft != 0
        l2_xfree((cast: (@: void) l2_m_ft))
    if: l2_m_edge != 0
        l2_xfree((cast: (@: void) l2_m_edge))
    if: l2_sn != 0
        l2_xfree((cast: (@: void) l2_sn))
    if: l2_st != 0
        l2_xfree((cast: (@: void) l2_st))
    l2_m_name: nname
    l2_m_f0: nf0
    l2_m_f1: nf1
    l2_m_node: nnode
    l2_m_body: nbody
    l2_m_sig: nsig
    l2_m_mark: nmark
    l2_m_arity: narity
    l2_m_dyn: ndyn
    l2_m_ret: nret
    l2_m_own: nown
    l2_m_sn: nsn
    l2_m_hcap: nhcap
    l2_m_fcap: nfcap
    l2_m_dn: ndn
    l2_m_dt: ndt
    l2_m_fn: nfn
    l2_m_ft: nft
    l2_m_edge: nedge
    l2_sn: nslots
    l2_st: nst
    l2_slot_cap: (cast: (int) slotcap)
    l2_m_cap: (cast: (int) cap)
return: 0

fn: l2_free_method (int: mi) int
    if: mi < 0 || l2_m_cap <= 0 || mi >= l2_m_cap
        return: 0
    if: l2_m_fn[mi] != 0
        l2_xfree((cast: (@: void) l2_m_fn[mi]))
    if: l2_m_ft[mi] != 0
        l2_xfree((cast: (@: void) l2_m_ft[mi]))
    if: l2_m_dn[mi] != 0
        l2_xfree((cast: (@: void) l2_m_dn[mi]))
    if: l2_m_dt[mi] != 0
        l2_xfree((cast: (@: void) l2_m_dt[mi]))
    l2_m_fn[mi]: 0
    l2_m_ft[mi]: 0
    l2_m_dn[mi]: 0
    l2_m_dt[mi]: 0
    l2_m_fcap[mi]: 0
    l2_m_hcap[mi]: 0
    l2_m_arity[mi]: 0
    l2_m_dyn[mi]: 0
return: 0

fn: l2_formals_alloc (int: mi; int: ar) int
    size_t: nb
    size_t: ni
    size_t: psz
    if: mi < 0 || ar < 0
        return: 1
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok((cast: (size_t) ar), psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok((cast: (size_t) ar), c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: (cast: (size_t) ar) * psz
    ni: (cast: (size_t) ar) * c.sizeof(c.int)
    l2_m_fn[mi]: 0
    l2_m_ft[mi]: 0
    l2_m_fcap[mi]: 0
    if: ar = 0
        return: 0
    l2_alloc_kind: 1
    l2_m_fn[mi]: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    l2_m_ft[mi]: (cast: (@: int) l2_xmalloc(ni))
    if: l2_m_fn[mi] = 0 || l2_m_ft[mi] = 0
        l2_free_method(mi)
        return: 1
    c.memset((cast: (@: void) l2_m_fn[mi]), 0, nb)
    c.memset((cast: (@: void) l2_m_ft[mi]), 0, ni)
    l2_m_fcap[mi]: ar
return: 0

fn: l2_hidden_reserve (int: mi; int: need) int
    size_t: cap
    size_t: need_u
    int: i
    size_t: nb
    size_t: ni
    size_t: psz
    @@: LmP0Text nn 0
    @: int nt 0
    @@: LmP0Text on
    @: int ot
    if: mi < 0 || need < 0
        return: 1
    if: need <= l2_m_hcap[mi]
        return: 0
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_m_hcap[mi])
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX) && need_u > (cast: (size_t) c.INT_MAX)
        l2_alloc_err: 2
        return: 1
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: need_u
        ---
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok((cast: (size_t) cap), psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok((cast: (size_t) cap), c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    l2_alloc_kind: 2
    nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nt: (cast: (@: int) l2_xmalloc(ni))
    if: nn = 0 || nt = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        return: 1
    c.memset((cast: (@: void) nn), 0, nb)
    c.memset((cast: (@: void) nt), 0, ni)
    on: l2_m_dn[mi]
    ot: l2_m_dt[mi]
    i: 0
    while: i < l2_m_dyn[mi]
        nn[i]: on[i]
        nt[i]: ot[i]
        i: i + 1
    if: on != 0
        l2_xfree((cast: (@: void) on))
    if: ot != 0
        l2_xfree((cast: (@: void) ot))
    l2_m_dn[mi]: nn
    l2_m_dt[mi]: nt
    l2_m_hcap[mi]: (cast: (int) cap)
return: 0

fn: l2_fn (int: mi; int: k) @: LmP0Text
    @@: LmP0Text row
    if: mi < 0 || k < 0 || l2_m_fn[mi] = 0
        return: 0
    row: (cast: (@@: LmP0Text) l2_m_fn[mi])
return: row[k]

fn: l2_ft (int: mi; int: k) int
    @: int row
    if: mi < 0 || k < 0 || l2_m_ft[mi] = 0
        return: 0
    row: l2_m_ft[mi]
return: row[k]

fn: l2_dn (int: mi; int: k) @: LmP0Text
    @@: LmP0Text row
    if: mi < 0 || k < 0 || l2_m_dn[mi] = 0
        return: 0
    row: (cast: (@@: LmP0Text) l2_m_dn[mi])
return: row[k]

fn: l2_dt (int: mi; int: k) int
    @: int row
    if: mi < 0 || k < 0 || l2_m_dt[mi] = 0
        return: 0
    row: l2_m_dt[mi]
return: row[k]

fn: l2_fn_set (int: mi; int: k; @: LmP0Text v) int
    @@: LmP0Text row
    if: mi < 0 || k < 0 || l2_m_fn[mi] = 0
        return: 1
    row: (cast: (@@: LmP0Text) l2_m_fn[mi])
    row[k]: v
return: 0

fn: l2_ft_set (int: mi; int: k; int: v) int
    @: int row
    if: mi < 0 || k < 0 || l2_m_ft[mi] = 0
        return: 1
    row: l2_m_ft[mi]
    row[k]: v
return: 0

fn: l2_dn_set (int: mi; int: k; @: LmP0Text v) int
    @@: LmP0Text row
    if: mi < 0 || k < 0 || l2_m_dn[mi] = 0
        return: 1
    row: (cast: (@@: LmP0Text) l2_m_dn[mi])
    row[k]: v
return: 0

fn: l2_dt_set (int: mi; int: k; int: v) int
    @: int row
    if: mi < 0 || k < 0 || l2_m_dt[mi] = 0
        return: 1
    row: l2_m_dt[mi]
    row[k]: v
return: 0

fn: l2_path_is_lm2 (const: @(char path)) int
    size_t: n
    if: path = 0
        return: 0
    n: c.strlen(path)
    if: n < 4U
        return: 0
    if: path[n - 4U] != 46
        return: 0
    if: path[n - 3U] != 108 && path[n - 3U] != 76
        return: 0
    if: path[n - 2U] != 109 && path[n - 2U] != 77
        return: 0
    if: path[n - 1U] != 50
        return: 0
return: 1

fn: l2_next_active (@: LmP0Field field) @: LmP0Field
    while: field != 0 && l2_ignored(field\value)
        field: field\next
return: field

fn: l2_count_active (const: @(LmP0Structure body)) int
    @: LmP0Field field
    int: n 0
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        n: n + 1
        field: l2_next_active(field\next)
return: n

fn: l2_write_sym (@: FILE out; int: i) int
    if: out = 0
        return: 1
    if: l2_library_mode != 0 && c.fprintf(out, "l2_u%08X%08X_m%d", l2_module_hash_a, l2_module_hash_b, i) < 0
        return: 1
    if: l2_library_mode = 0 && c.fprintf(out, "l2_m%d", i) < 0
        return: 1
return: 0

fn: l2_tok_sym (int: i; @: char dest) int
    if: dest = 0
        return: 1
    if: l2_library_mode != 0 && c.sprintf(dest, "l2_u%08X%08X_m%d", l2_module_hash_a, l2_module_hash_b, i) < 0
        return: 1
    if: l2_library_mode = 0 && c.sprintf(dest, "l2_m%d", i) < 0
        return: 1
return: 0

fn: l2_digits (const: @(LmP0Text text)) int
    size_t: i
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    if: text\length > 1U && text\data[0] = 48
        return: 0
    i: 0U
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

fn: l2_num (const: @(LmP0Text text)) int
    size_t: n
    size_t: i
    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0
    n: text\length
    if: text\data[n - 1U] = 85 || text\data[n - 1U] = 117
        n: n - 1U
    if: n = 0U
        return: 0
    if: n > 2U && text\data[0] = 48 && (text\data[1] = 120 || text\data[1] = 88)
        i: 2U
        while: i < n
            if: (text\data[i] < 48 || text\data[i] > 57) && (text\data[i] < 65 || text\data[i] > 70) && (text\data[i] < 97 || text\data[i] > 102)
                return: 0
            i: i + 1U
        ---
        return: 1
    ---
    if: n > 1U && text\data[0] = 48
        return: 0
    i: 0U
    while: i < n
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

fn: l2_signed_num (const: @(LmP0Text text)) int
    size_t: i 1U
    if: text = 0 || text\data = 0 || text\length < 2U || text\data[0] != 45
        return: 0
    if: text\length > 2U && text\data[1] = 48
        return: 0
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        i: i + 1U
return: 1

fn: l2_int_fits (const: @(LmP0Text text)) int
    size_t: i
    int: acc 0
    int: d 0
    int: q
    int: r
    if: l2_digits(text) = 0
        return: 0
    q: c.INT_MAX / 10
    r: c.INT_MAX % 10
    i: 0U
    while: i < text\length
        d: text\data[i] - 48
        if: acc > q
            return: 0
        if: acc = q && d > r
            return: 0
        acc: acc * 10 + d
        i: i + 1U
return: 1

fn: l2_end_named (const: @(LmP0Frame frame); const: @(char name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(field\value\as\atom, name)

fn: l2_fn_close (const: @(LmP0Frame frame); const: @(LmP0Text name); const: @(char head)) int
    @: LmP0Field field
    @: LmP0Text actual
    if: frame = 0
        return: 1
    if: frame\trailer = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "return")
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 1
    if: frame\trailer\body = 0
        return: 1
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 1
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    actual: field\value\as\atom
    if: name != 0 && l2_text_same(actual, name)
        return: 0
    if: head != 0 && l2_text_eq(actual, head)
        return: 0
return: 1

fn: l2_ret_tr (const: @(LmP0Frame frame)) @: LmP0Structure
    if: frame = 0 || frame\trailer = 0 || frame\trailer\spelling = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "return") = 0
        return: 0
return: frame\trailer\body

fn: l2_check_ret_tr (int: mi; const: @(char path); const: @(LmP0Structure body); const: @(LmP0Node at)) int
    int: n
    if: body = 0
        return: 0
    n: l2_count_active(body)
    if: body\trailer != 0
        return: l2_error(path, at, "unsupported trailer")
    if: mi >= 0 && l2_m_ret[mi] = 8 && n != 0
        return: l2_error(path, at, "unsupported body")
    if: (mi < 0 || l2_m_ret[mi] != 8) && n = 0
        return: l2_error(path, at, "unsupported body")
    if: n != 0 && l2_check_fields(body\first_field, n, mi, path, at) != 0
        return: 1
return: 0

fn: l2_emit_ret_tr (int: mi; const: @(char ind); const: @(LmP0Structure body)) int
    int: n
    if: body = 0 || ind = 0
        return: 0
    n: l2_count_active(body)
    if: mi >= 0 && l2_m_ret[mi] = 8
        if: n != 0
            return: 1
        if: l2_emit_checkpoint(mi, ind) != 0
            return: 1
        if: c.fprintf(l2_out, "%sreturn\n", ind) < 0
            return: 1
        return: 0
    if: n = 0
        return: 1
    if: l2_eval_fields(body\first_field, n, mi, ind, l2_tok) != 0
        return: 1
    if: l2_emit_checkpoint(mi, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sreturn: %s\n", ind, l2_tok) < 0
        return: 1
return: 0

fn: l2_frame_head (const: @(LmP0Node node); const: @(char name)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 0
return: l2_text_eq(node\as\frame\head, name)

fn: l2_empty_struct (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_STRUCTURE || node\as = 0
        return: 0
return: l2_count_active(node\as\structure) = 0

fn: l2_triple_fence_n (const: @(LmP0Text t)) size_t
    int: q
    if: t = 0 || t\data = 0 || t\length < 6U
        return: 0U
    q: (cast: (int) t\data[0])
    if: q != 34 && q != 39
        return: 0U
    if: t\data[1] != t\data[0] || t\data[2] != t\data[0]
        return: 0U
    if: t\data[t\length - 1U] != t\data[0] || t\data[t\length - 2U] != t\data[0] || t\data[t\length - 3U] != t\data[0]
        return: 0U
return: 3U

fn: l2_triple_q (const: @(LmP0Text t)) int
    if: l2_triple_fence_n(t) = 0U
        return: 0
return: (cast: (int) t\data[0])

fn: l2_quoted (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length < 2U
        return: 0
    if: l2_triple_q(t) != 0
        return: 1
    if: t\data[0] != 34 || t\data[t\length - 1U] != 34
        return: 0
    if: t\length >= 6U && t\data[1] = 34 && t\data[2] = 34
        return: 0
return: 1

fn: l2_write_l1_string (@: FILE out; const: @(char data); size_t: n) int
    size_t: i 0U
    int: ch
    c.array: []: char oct 5
    if: out = 0
        return: 1
    if: c.fputc(34, out) < 0
        return: 1
    while: i < n
        ch: (cast: (int) data[i])
        if: ch < 0
            ch: ch + 256
        if: ch = 34 && c.fputs("\\\"", out) < 0
            return: 1
        if: ch = 34
            i: i + 1U
            continue
        if: ch = 92 && c.fputs("\\\\", out) < 0
            return: 1
        if: ch = 92
            i: i + 1U
            continue
        if: ch = 10 && c.fputs("\\n", out) < 0
            return: 1
        if: ch = 10
            i: i + 1U
            continue
        if: ch = 13 && c.fputs("\\r", out) < 0
            return: 1
        if: ch = 13
            i: i + 1U
            continue
        if: ch = 63 && c.fputs("\\?", out) < 0
            return: 1
        if: ch = 63
            i: i + 1U
            continue
        if: ch < 32 || ch > 126
            oct[0]: 92
            oct[1]: (cast: (char) (48 + (ch / 64)))
            oct[2]: (cast: (char) (48 + ((ch / 8) % 8)))
            oct[3]: (cast: (char) (48 + (ch % 8)))
            oct[4]: 0
            if: c.fputs(oct, out) < 0
                return: 1
            i: i + 1U
            continue
        if: c.fputc(ch, out) < 0
            return: 1
        i: i + 1U
    if: c.fputc(34, out) < 0
        return: 1
return: 0

fn: l2_decode_triple_body (const: @(LmP0Text t); @@: char outp; @: size_t outn) int
    @: char buf 0
    size_t: nfen
    size_t: n
    size_t: i 0U
    size_t: o 0U
    size_t: run
    size_t: emitn
    size_t: k
    char: qch
    if: outp = 0 || outn = 0
        return: 1
    \outp: 0
    \outn: 0U
    nfen: l2_triple_fence_n(t)
    if: nfen = 0U || t = 0 || t\data = 0
        return: 1
    n: t\length - nfen - nfen
    if: n = 0U
        return: 0
    buf: (cast: (@: char) l2_xmalloc(n + 1U))
    if: buf = 0
        return: 1
    qch: t\data[0]
    while: i < n
        if: t\data[nfen + i] = qch
            run: 0U
            while: i + run < n && t\data[nfen + i + run] = qch
                run: run + 1U
            emitn: run
            if: run >= 4U
                emitn: run - 1U
            k: 0U
            while: k < emitn
                buf[o]: qch
                o: o + 1U
                k: k + 1U
            i: i + run
            continue
        buf[o]: t\data[nfen + i]
        o: o + 1U
        i: i + 1U
    buf[o]: 0
    \outp: buf
    \outn: o
return: 0

fn: l2_fmt_l1_string (@: char dest; size_t: cap; const: @(char data); size_t: n) int
    size_t: i 0U
    size_t: o 0U
    int: ch
    size_t: need
    if: dest = 0 || cap < 3U
        return: 1
    dest[o]: 34
    o: o + 1U
    while: i < n
        if: data = 0
            return: 1
        ch: (cast: (int) data[i])
        if: ch < 0
            ch: ch + 256
        need: 1U
        if: ch = 34 || ch = 92 || ch = 10 || ch = 13 || ch = 63
            need: 2U
        else:
            if: ch < 32 || ch > 126
                need: 4U
            ---
        ---
        if: o + need + 2U > cap
            return: 1
        if: ch = 34
            dest[o]: 92
            dest[o + 1U]: 34
            o: o + 2U
            i: i + 1U
            continue
        if: ch = 92
            dest[o]: 92
            dest[o + 1U]: 92
            o: o + 2U
            i: i + 1U
            continue
        if: ch = 10
            dest[o]: 92
            dest[o + 1U]: 110
            o: o + 2U
            i: i + 1U
            continue
        if: ch = 13
            dest[o]: 92
            dest[o + 1U]: 114
            o: o + 2U
            i: i + 1U
            continue
        if: ch = 63
            dest[o]: 92
            dest[o + 1U]: 63
            o: o + 2U
            i: i + 1U
            continue
        if: ch < 32 || ch > 126
            dest[o]: 92
            dest[o + 1U]: (cast: (char) (48 + (ch / 64)))
            dest[o + 2U]: (cast: (char) (48 + ((ch / 8) % 8)))
            dest[o + 3U]: (cast: (char) (48 + (ch % 8)))
            o: o + 4U
            i: i + 1U
            continue
        dest[o]: (cast: (char) ch)
        o: o + 1U
        i: i + 1U
    dest[o]: 34
    dest[o + 1U]: 0
return: 0

fn: l2_write_triple_as_l1 (@: FILE out; const: @(LmP0Text t)) int
    @: char buf 0
    size_t: n 0U
    int: rc
    if: l2_decode_triple_body(t, @ buf, @ n) != 0
        return: 1
    if: buf = 0
        return: l2_write_l1_string(out, "", 0U)
    rc: l2_write_l1_string(out, buf, n)
    l2_xfree((cast: (@: void) buf))
return: rc

fn: l2_write_text (@: FILE out; const: @(LmP0Text t)) int
    if: out = 0 || t = 0 || t\data = 0
        return: 1
    if: t\length = 0U
        return: 0
    if: c.fwrite(t\data, 1U, t\length, out) != t\length
        return: 1
return: 0

fn: l2_check_puts (const: @(LmP0Node stmt); const: @(char path)) int
    const: @: LmP0Frame fr
    @: LmP0Field arg
    int: n
    if: l2_frame_head(stmt, "c.puts") = 0
        return: l2_error(path, stmt, "unsupported body")
    fr: stmt\as\frame
    if: fr\trailer != 0
        return: l2_error(path, stmt, "unsupported body")
    if: fr\body = 0
        return: l2_error(path, stmt, "unsupported argument")
    if: fr\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    n: l2_count_active(fr\body)
    if: n = 0
        return: l2_error(path, stmt, "unsupported argument")
    if: n != 1
        return: l2_error(path, stmt, "extra argument")
    arg: l2_next_active(fr\body\first_field)
    if: arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, stmt, "unsupported argument")
    if: l2_quoted(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "unsupported argument")
return: 0

fn: l2_take_return_stmt (const: @(LmP0Node stmt); const: @(char path); @@: LmP0Text out_lit) int
    const: @: LmP0Frame ret
    @: LmP0Field arg
    if: out_lit = 0
        return: l2_error(path, stmt, "internal: missing return slot")
    \out_lit: 0
    if: l2_frame_head(stmt, "return") = 0
        return: l2_error(path, stmt, "unsupported body")
    ret: stmt\as\frame
    if: ret\trailer != 0
        return: l2_error(path, stmt, "unsupported body")
    if: ret\body = 0 || l2_count_active(ret\body) != 1
        return: l2_error(path, stmt, "unsupported body")
    if: ret\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    arg: l2_next_active(ret\body\first_field)
    if: arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, stmt, "unsupported body")
    if: l2_digits(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "unsupported body")
    if: l2_int_fits(arg\value\as\atom) = 0
        return: l2_error(path, stmt, "return literal not representable as int")
    \out_lit: arg\value\as\atom
return: 0

fn: l2_take_return_fields (const: @(LmP0Structure body); const: @(char path); const: @(LmP0Node at); @@: LmP0Text out_lit) int
    @: LmP0Field arg
    if: out_lit = 0
        return: l2_error(path, at, "internal: missing return slot")
    \out_lit: 0
    if: body = 0 || l2_count_active(body) != 1
        return: l2_error(path, at, "unsupported body")
    if: body\trailer != 0
        return: l2_error(path, at, "unsupported trailer")
    arg: l2_next_active(body\first_field)
    if: arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, at, "unsupported body")
    if: l2_digits(arg\value\as\atom) = 0
        return: l2_error(path, at, "unsupported body")
    if: l2_int_fits(arg\value\as\atom) = 0
        return: l2_error(path, at, "return literal not representable as int")
    \out_lit: arg\value\as\atom
return: 0

fn: l2_simple_puts_main (const: @(LmP0Node body_node)) int
    @: LmP0Field field
    @: LmP0Field nxt
    const: @: LmP0Node stmt
    if: body_node = 0 || body_node\kind != c.LM_P0_NODE_STRUCTURE || body_node\as = 0
        return: 0
    field: l2_next_active(body_node\as\structure\first_field)
    if: field = 0
        return: 0
    while: field != 0
        stmt: field\value
        nxt: l2_next_active(field\next)
        if: nxt = 0
            if: l2_frame_head(stmt, "return") = 0
                return: 0
            ---
            return: 1
        if: l2_frame_head(stmt, "c.puts") = 0
            return: 0
        field: nxt
return: 0

fn: l2_take_puts_body (const: @(LmP0Node body_node); const: @(char path)) int
    @: LmP0Field field
    if: body_node = 0
        return: 0
    if: body_node\kind != c.LM_P0_NODE_STRUCTURE || body_node\as = 0
        return: l2_error(path, body_node, "unsupported body")
    if: body_node\as\structure\trailer != 0
        return: l2_error(path, body_node, "unsupported trailer")
    field: l2_next_active(body_node\as\structure\first_field)
    while: field != 0
        if: l2_check_puts(field\value, path) != 0
            return: 1
        field: l2_next_active(field\next)
return: 0

fn: l2_take_body (const: @(LmP0Node body_node); const: @(char path); @@: LmP0Text out_lit) int
    @: LmP0Field field
    @: LmP0Field nxt
    const: @: LmP0Node stmt
    if: out_lit = 0
        return: l2_error(path, body_node, "internal: missing return slot")
    \out_lit: 0
    if: body_node = 0 || body_node\kind != c.LM_P0_NODE_STRUCTURE || body_node\as = 0
        return: l2_error(path, body_node, "unsupported body")
    field: l2_next_active(body_node\as\structure\first_field)
    if: field = 0
        return: l2_error(path, body_node, "unsupported body")
    while: field != 0
        stmt: field\value
        nxt: l2_next_active(field\next)
        if: nxt = 0
            return: l2_take_return_stmt(stmt, path, out_lit)
        if: l2_frame_head(stmt, "return")
            return: l2_error(path, stmt, "unsupported body")
        if: l2_check_puts(stmt, path) != 0
            return: 1
        field: nxt
return: l2_error(path, body_node, "unsupported body")

fn: l2_take_main_lit (const: @(LmP0Node fn_node); const: @(char path); @@: LmP0Text out_lit; @@: LmP0Structure out_body) int
    @: LmP0Field field
    const: @: LmP0Frame fn_frame
    const: @: LmP0Node name
    const: @: LmP0Node params
    const: @: LmP0Node resty
    const: @: LmP0Node body
    if: out_body = 0
        return: l2_error(path, fn_node, "internal: missing body slot")
    \out_body: 0
    if: l2_frame_head(fn_node, "fn") = 0
        return: l2_error(path, fn_node, "unsupported body")
    fn_frame: fn_node\as\frame
    if: fn_frame\trailer != 0 && l2_text_eq(fn_frame\trailer\spelling, "end") = 0 && l2_text_eq(fn_frame\trailer\spelling, "return") = 0
        return: l2_error(path, fn_node, "unsupported trailer")
    if: fn_frame\body = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_count_active(fn_frame\body) != 4 && (l2_count_active(fn_frame\body) != 3 || l2_ret_tr(fn_frame) = 0)
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(fn_frame\body\first_field)
    name: field\value
    if: name = 0 || name\kind != c.LM_P0_NODE_ATOM || l2_text_eq(name\as\atom, "main") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_fn_close(fn_frame, name\as\atom, "fn") != 0
        return: l2_error(path, fn_node, "end target does not match close target")
    field: l2_next_active(field\next)
    params: field\value
    l2_entry_free()
    l2_entry_full: 0
    if: l2_empty_struct(params) = 0 && l2_parse_entry_formals(params, path) != 0
        return: 1
    field: l2_next_active(field\next)
    resty: field\value
    if: resty = 0 || resty\kind != c.LM_P0_NODE_ATOM || l2_text_eq(resty\as\atom, "int") = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    body: 0
    if: field != 0
        body: field\value
    if: l2_ret_tr(fn_frame) != 0 && l2_take_puts_body(body, path) != 0
        return: 1
    if: l2_ret_tr(fn_frame) != 0 && l2_take_return_fields(l2_ret_tr(fn_frame), path, fn_node, out_lit) != 0
        return: 1
    if: l2_ret_tr(fn_frame) = 0 && body != 0 && body\kind = c.LM_P0_NODE_STRUCTURE && body\as != 0 && l2_simple_puts_main(body) = 0
        l2_main_node: fn_node
        l2_main_body: body\as\structure
        if: l2_check_body(body\as\structure, -1, path, 0) != 0
            return: 1
        l2_entry_full: 1
        \out_body: body\as\structure
        return: 0
    if: l2_ret_tr(fn_frame) = 0 && l2_take_body(body, path, out_lit) != 0
        return: 1
    if: body != 0 && (body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0)
        return: l2_error(path, fn_node, "unsupported body")
    if: body != 0
        \out_body: body\as\structure
return: 0

fn: l2_unit_from_root (const: @(LmP0Node root); const: @(char path); @@: LmP0Structure out_unit) int
    @: LmP0Field field
    const: @: LmP0Node item
    if: out_unit = 0
        return: l2_error(path, root, "internal: missing unit slot")
    \out_unit: 0
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE || root\as = 0 || root\as\structure = 0
        return: l2_error(path, root, "unsupported body")
    field: l2_next_active(root\as\structure\first_field)
    if: field = 0
        return: l2_error(path, root, "missing main")
    item: field\value
    if: l2_next_active(field\next) = 0 && l2_frame_head(item, "L2")
        if: l2_end_named(item\as\frame, "L2") = 0
            return: l2_error(path, item, "unsupported body")
        if: item\as\frame\body = 0
            return: l2_error(path, item, "missing main")
        \out_unit: item\as\frame\body
        return: 0
    if: l2_frame_head(item, "L1") || l2_frame_head(item, "L3")
        return: l2_error(path, item, "unsupported body")
    \out_unit: root\as\structure
return: 0

fn: l2_translate_unit (const: @(LmP0Structure unit); const: @(char path); @@: LmP0Text out_lit; @@: LmP0Structure out_body) int
    @: LmP0Field field
    @: LmP0Field nf
    @: LmP0Node item
    int: mains 0
    int: extras 0
    int: is_main 0
    @: LmP0Node main_node 0
    int: i
    if: out_lit = 0 || out_body = 0
        return: l2_error(path, 0, "internal: missing return slot")
    \out_lit: 0
    \out_body: 0
    l2_leaf_mode: 0
    l2_library_mode: 0
    l2_m_n: 0
    l2_own_n: 0
    l2_own_free()
    l2_loop_depth: 0
    l2_scope_n: 0
    l2_scope_free()
    l2_indent_free()
    l2_pub_free()
    l2_for_free()
    l2_unit_base: 0
    l2_need_p0: 0
    l2_need_query: 0
    l2_need_own: 0
    l2_need_diag: 0
    l2_pd_free()
    l2_def_free()
    l2_inc_free()
    l2_loc_free()
    l2_os_node: 0
    l2_need_string: 0
    l2_need_stdlib: 0
    l2_intern_n: 0U
    l2_src: path
    l2_main_node: 0
    l2_entry_free()
    l2_entry_full: 0
    i: 0
    while: i < l2_m_cap
        l2_free_method(i)
        i: i + 1
    l2_meth_free()
    if: unit = 0
        return: l2_error(path, 0, "missing main")
    if: unit\trailer != 0
        return: l2_error(path, 0, "unsupported trailer")
    # Directives establish the C/predef type vocabulary before unit fields are
    # classified. Unit fields are then collected in their own source order
    # before any method body is analysed, so a method can use a field declared
    # later in the file just as it can use an earlier one.
    field: l2_next_active(unit\first_field)
    while: field != 0
        item: field\value
        if: l2_frame_head(item, "predef") != 0 && l2_take_predef(item, path) != 0
            return: 1
        if: l2_frame_head(item, "define") != 0 && l2_take_define(item, path) != 0
            return: 1
        if: l2_frame_head(item, "include") != 0 && l2_take_include(item, path) != 0
            return: 1
        field: l2_next_active(field\next)
    ---
    field: l2_next_active(unit\first_field)
    while: field != 0
        item: field\value
        if: l2_unit_decl_ty(item) != 0 && l2_take_unit_own(item, path) != 0
            return: 1
        field: l2_next_active(field\next)
    ---
    field: l2_next_active(unit\first_field)
    while: field != 0
        item: field\value
        nf: 0
        is_main: 0
        if: l2_frame_head(item, "fn") != 0 && item\as\frame != 0 && item\as\frame\body != 0
            nf: l2_next_active(item\as\frame\body\first_field)
        if: nf != 0 && nf\value != 0 && nf\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(nf\value\as\atom, "main")
            is_main: 1
            mains: mains + 1
            main_node: item
        if: is_main = 0 && (l2_frame_head(item, "fn") != 0 || l2_frame_head(item, "sub") != 0) && l2_collect_method(item, path) != 0
            return: 1
        if: l2_frame_head(item, "independent") != 0 && l2_take_eternal(item, path) != 0
            return: 1
        if: l2_frame_head(item, "os") != 0
            if: l2_os_node != 0
                return: l2_error(path, item, "unsupported body")
            if: l2_check_os(item, path) != 0
                return: 1
            l2_os_node: item
            if: l2_collect_os_methods(item, path) != 0
                return: 1
        ---
        if: is_main = 0 && l2_unit_decl_ty(item) = 0 && l2_frame_head(item, "fn") = 0 && l2_frame_head(item, "sub") = 0 && l2_frame_head(item, "predef") = 0 && l2_frame_head(item, "define") = 0 && l2_frame_head(item, "include") = 0 && l2_frame_head(item, "os") = 0 && l2_frame_head(item, "independent") = 0 && l2_frame_head(item, "const") = 0 && l2_frame_head(item, "immutable") = 0 && l2_frame_head(item, "merge") = 0 && l2_frame_head(item, "end") = 0 && l2_frame_head(item, "return") = 0 && l2_frame_head(item, "if") = 0 && l2_frame_head(item, "while") = 0 && l2_frame_head(item, "for") = 0
            # A reserved head that is malformed stays an error; only an
            # otherwise unrecognized frame becomes a declaration.
            if: l2_take_named(item, path) != 0
                return: 1
        ---
        if: is_main = 0 && l2_unit_decl_ty(item) = 0 && (l2_frame_head(item, "const") != 0 || l2_frame_head(item, "immutable") != 0 || l2_frame_head(item, "merge") != 0 || l2_frame_head(item, "end") != 0 || l2_frame_head(item, "return") != 0 || l2_frame_head(item, "if") != 0 || l2_frame_head(item, "while") != 0 || l2_frame_head(item, "for") != 0)
            extras: extras + 1
        ---
        field: l2_next_active(field\next)
    if: l2_ns_resolve_refs(path, main_node) != 0
        return: 1
    if: l2_m_n != 0
        l2_m_value_used: (cast: (@: int) c.calloc((cast: (size_t) l2_m_n), c.sizeof(c.int)))
        if: l2_m_value_used = 0
            return: l2_error(path, main_node, "out of memory")
        ---
    ---
    if: mains > 1
        return: l2_error(path, main_node, "several main")
    if: extras != 0
        return: l2_error(path, main_node, "unsupported body")
    if: mains = 0
        if: l2_m_n = 0
            return: l2_error(path, 0, "missing main")
        l2_library_mode: 1
        return: l2_parse_library(path)
    if: l2_m_n != 0
        return: l2_parse_unit(main_node, path)
return: l2_take_main_lit(main_node, path, out_lit, out_body)

fn: l2_parse_library (const: @(char path)) int
    int: i 0
    l2_main_node: 0
    l2_main_body: 0
    if: l2_dyn_local(path) != 0
        return: 1
    l2_m_throws: (cast: (@: int) c.calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(c.int)))
    if: l2_m_throws = 0
        return: l2_error(path, 0, "out of memory")
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            l2_m_throws[i]: l2_body_throws(l2_m_body[i]\as\structure)
        i: i + 1
    ---
    i: 0
    while: i < l2_m_n
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, path) != 0
            return: 1
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_check_body(l2_m_body[i]\as\structure, i, path, 0) != 0
            return: 1
        if: l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_check_ret_tr(i, path, l2_ret_tr(l2_m_node[i]\as\frame), l2_m_node[i]) != 0
            return: 1
        i: i + 1
    if: l2_throws_close() != 0
        return: 1
    if: l2_dyn_close(path) != 0
        return: 1
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    i: 0
    while: i < l2_m_n
        if: l2_text_eq(l2_m_name[i], "l2_program_entry") || l2_text_eq(l2_m_name[i], "l2_library_open") || l2_text_eq(l2_m_name[i], "l2_library_runtime") || l2_text_eq(l2_m_name[i], "l2_library_message") || l2_text_eq(l2_m_name[i], "l2_library_unit")
            return: l2_error(path, l2_m_node[i], "reserved library symbol")
        if: l2_m_dyn[i] != 0 || l2_m_throws[i] != 0
            return: l2_error(path, l2_m_node[i], "unsupported library ABI")
        l2_m_sig[i]: l2_intern_mi(i)
        if: l2_m_sig[i] = 0U && l2_alloc_err = 2
            return: l2_error(path, l2_m_node[i], "size overflow")
        if: l2_m_sig[i] = 0U
            return: l2_error(path, l2_m_node[i], "out of memory")
        i: i + 1
    if: l2_intern_prove(path, l2_m_node[0]) != 0
        return: 1
    l2_leaf_mode: 1
return: 0

fn: l2_emit_puts_line (@: FILE out; const: @(LmP0Node stmt)) int
    @: LmP0Field arg
    @: LmP0Text t
    arg: l2_next_active(stmt\as\frame\body\first_field)
    if: c.fputs("        c.puts: ", out) < 0
        return: 1
    t: arg\value\as\atom
    if: l2_triple_q(t) != 0 && l2_write_triple_as_l1(out, t) != 0
        return: 1
    if: l2_triple_q(t) = 0 && l2_write_text(out, t) != 0
        return: 1
    if: c.fputs("\n", out) < 0
        return: 1
return: 0

fn: l2_emit_l1 (const: @(char out_path); const: @(LmP0Structure body); const: @(LmP0Text lit)) int
    @: FILE out
    @: LmP0Field field
    @: LmP0Field nxt
    int: puts_n 0
    if: out_path = 0
        return: 1
    if: l2_entry_full = 0 && (lit = 0 || lit\data = 0 || lit\length = 0U)
        return: 1
    field: 0
    if: body != 0
        field: l2_next_active(body\first_field)
    while: field != 0
        nxt: l2_next_active(field\next)
        if: nxt != 0 || l2_frame_head(field\value, "return") = 0
            puts_n: puts_n + 1
        field: nxt
    out: c.fopen(out_path, "wb")
    if: out = 0
        c.fprintf(c.stderr, "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: l2_write_dirs(out) != 0
        c.fclose(out)
        return: 1
    if: l2_emit_os(out) != 0
        c.fclose(out)
        return: 1
    if: l2_entry_full != 0 && c.fprintf(out, "include: \"%slmx.h\"\n", l2_rt_root) < 0
        c.fclose(out)
        return: 1
    if: l2_inc_n = 0 && (puts_n != 0 || l2_entry_full != 0) && c.fputs("include: \"<stdio.h>\"\n", out) < 0
        c.fclose(out)
        return: 1
    if: l2_need_string != 0 && c.fputs("include: \"<string.h>\"\n", out) < 0
        c.fclose(out)
        return: 1
    if: l2_need_stdlib != 0 && c.fputs("include: \"<stdlib.h>\"\n", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_entry_sig(out) != 0
        c.fclose(out)
        return: 1
    if: l2_entry_full != 0
        l2_out: out
        if: l2_emit_body(body, -1, "        ") != 0
            c.fclose(out)
            return: 1
        if: c.fputs("    end: main\nend: external\n", out) < 0
            c.fclose(out)
            return: 1
        if: c.fclose(out) != 0
            return: 1
        return: 0
    ---
    field: 0
    if: body != 0
        field: l2_next_active(body\first_field)
    while: field != 0
        nxt: l2_next_active(field\next)
        if: (nxt != 0 || l2_frame_head(field\value, "return") = 0) && l2_emit_puts_line(out, field\value) != 0
            c.fclose(out)
            return: 1
        field: nxt
    if: c.fputs("        return: ", out) < 0
        c.fclose(out)
        return: 1
    if: l2_write_text(out, lit) != 0
        c.fclose(out)
        return: 1
    if: c.fputs("\n    end: main\nend: external\n", out) < 0
        c.fclose(out)
        return: 1
    if: c.fclose(out) != 0
        return: 1
return: 0

fn: l2_translate (const: @(char in_path); const: @(char out_path)) int
    @: LmP0Document document 0
    const: @: LmP0Diagnostic diagnostic
    const: @: LmP0Node root
    @: LmP0Structure unit 0
    @: LmP0Structure body 0
    @: LmP0Text lit 0
    int: status
    size_t: path_i 0U
    if: l2_path_is_lm2(in_path) = 0
        c.fprintf(c.stderr, "l2trans error: %s:1:1: expected a .lm2 source\n", in_path)
        return: 1
    l2_module_hash_a: 2166136261U
    l2_module_hash_b: 5381U
    while: in_path[path_i] != 0
        l2_module_hash_a: l2_module_hash_a * 16777619U + (cast: (unsigned) (cast: (uchar) in_path[path_i]))
        l2_module_hash_b: l2_module_hash_b * 65599U + (cast: (unsigned) (cast: (uchar) in_path[path_i])) + 1U
        path_i: path_i + 1U
    ---
    status: lm_p0_parse_file(in_path, @ document)
    if: status != 0
        diagnostic: lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf(c.stderr, "l2trans parse error %d at %zu:%zu: %s\n", diagnostic\code, diagnostic\line, diagnostic\column, diagnostic\message)
        else:
            c.fprintf(c.stderr, "l2trans parse error: %s\n", in_path)
        lm_p0_document_destroy(document)
        return: 1
    root: lm_p0_document_root(document)
    if: l2_unit_from_root(root, in_path, @ unit) != 0
        lm_p0_document_destroy(document)
        return: 1
    if: l2_translate_unit(unit, in_path, @ lit, @ body) != 0
        lm_p0_document_destroy(document)
        return: 1
    if: l2_leaf_mode != 0
        status: l2_emit_unit(out_path)
    else:
        status: l2_emit_l1(out_path, body, lit)
    lm_p0_document_destroy(document)
    if: status != 0
        if: l2_alloc_err != 0
            return: l2_alloc_or(in_path, 0, "translation failed")
        return: 1
return: 0

# Parse/emit one two-int add leaf + typed call from §1.7 main.

fn: l2_ident (const: @(LmP0Text t)) int
    size_t: i
    unsigned: ch
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0
    ch: (cast: (unsigned) t\data[0])
    if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U)
        return: 0
    i: 1U
    while: i < t\length
        ch: (cast: (unsigned) t\data[i])
        if: ch != 95U && (ch < 65U || ch > 90U) && (ch < 97U || ch > 122U) && (ch < 48U || ch > 57U)
            return: 0
        i: i + 1U
    if: l2_text_eq(t, "main") || l2_text_eq(t, "fn") || l2_text_eq(t, "int") || l2_text_eq(t, "return") || l2_text_eq(t, "if") || l2_text_eq(t, "else") || l2_text_eq(t, "while") || l2_text_eq(t, "for") || l2_text_eq(t, "node")
        return: 0
return: 1

fn: l2_text_same (const: @(LmP0Text a); const: @(LmP0Text b)) int
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    if: a\length != b\length
        return: 0
return: c.memcmp(a\data, b\data, a\length) = 0

# Translator intern of the full canonical contract: L2_SIG_V0 schema
# plus exact ordered formal-name bytes (declared cap 8, hidden cap 4). Method name is not interned.
# One table for the linked unit; not reset per method.
fn: l2_intern_reserve (unsigned: need) int
    size_t: cap
    size_t: need_u
    size_t: nbp
    size_t: nbi
    size_t: psz
    unsigned: i
    @: int nar 0
    @: int ndyn 0
    @: int nret 0
    @: int nthrows 0
    @@: char nn 0
    @@: size_t nnl 0
    @@: int nty 0
    @@: char nhn 0
    @@: size_t nhnl 0
    @@: int nhty 0
    if: need <= l2_intern_cap
        return: 0
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_intern_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) (cast: (unsigned) -1))
        cap: need_u
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok(cap, psz) = 0 || l2_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nbp: cap * psz
    nbi: cap * c.sizeof(c.int)
    l2_alloc_kind: 7
    nar: (cast: (@: int) l2_xmalloc(nbi))
    ndyn: (cast: (@: int) l2_xmalloc(nbi))
    nret: (cast: (@: int) l2_xmalloc(nbi))
    nthrows: (cast: (@: int) l2_xmalloc(nbi))
    nn: (cast: (@@: char) l2_xmalloc(nbp))
    nnl: (cast: (@@: size_t) l2_xmalloc(nbp))
    nty: (cast: (@@: int) l2_xmalloc(nbp))
    nhn: (cast: (@@: char) l2_xmalloc(nbp))
    nhnl: (cast: (@@: size_t) l2_xmalloc(nbp))
    nhty: (cast: (@@: int) l2_xmalloc(nbp))
    if: nar = 0 || ndyn = 0 || nret = 0 || nthrows = 0 || nn = 0 || nnl = 0 || nty = 0 || nhn = 0 || nhnl = 0 || nhty = 0
        if: nar != 0
            l2_xfree((cast: (@: void) nar))
        if: ndyn != 0
            l2_xfree((cast: (@: void) ndyn))
        if: nret != 0
            l2_xfree((cast: (@: void) nret))
        if: nthrows != 0
            l2_xfree((cast: (@: void) nthrows))
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nnl != 0
            l2_xfree((cast: (@: void) nnl))
        if: nty != 0
            l2_xfree((cast: (@: void) nty))
        if: nhn != 0
            l2_xfree((cast: (@: void) nhn))
        if: nhnl != 0
            l2_xfree((cast: (@: void) nhnl))
        if: nhty != 0
            l2_xfree((cast: (@: void) nhty))
        return: 1
    c.memset((cast: (@: void) nar), 0, nbi)
    c.memset((cast: (@: void) ndyn), 0, nbi)
    c.memset((cast: (@: void) nret), 0, nbi)
    c.memset((cast: (@: void) nthrows), 0, nbi)
    c.memset((cast: (@: void) nn), 0, nbp)
    c.memset((cast: (@: void) nnl), 0, nbp)
    c.memset((cast: (@: void) nty), 0, nbp)
    c.memset((cast: (@: void) nhn), 0, nbp)
    c.memset((cast: (@: void) nhnl), 0, nbp)
    c.memset((cast: (@: void) nhty), 0, nbp)
    i: 0U
    while: i < l2_intern_n
        nar[i]: l2_it_ar[i]
        ndyn[i]: l2_it_dyn[i]
        nret[i]: l2_it_ret[i]
        nthrows[i]: l2_it_throws[i]
        nn[i]: l2_it_n[i]
        nnl[i]: l2_it_nl[i]
        nty[i]: l2_it_ty[i]
        nhn[i]: l2_it_hn[i]
        nhnl[i]: l2_it_hnl[i]
        nhty[i]: l2_it_hty[i]
        i: i + 1U
    if: l2_it_ar != 0
        l2_xfree((cast: (@: void) l2_it_ar))
    if: l2_it_dyn != 0
        l2_xfree((cast: (@: void) l2_it_dyn))
    if: l2_it_ret != 0
        l2_xfree((cast: (@: void) l2_it_ret))
    if: l2_it_throws != 0
        l2_xfree((cast: (@: void) l2_it_throws))
    if: l2_it_n != 0
        l2_xfree((cast: (@: void) l2_it_n))
    if: l2_it_nl != 0
        l2_xfree((cast: (@: void) l2_it_nl))
    if: l2_it_ty != 0
        l2_xfree((cast: (@: void) l2_it_ty))
    if: l2_it_hn != 0
        l2_xfree((cast: (@: void) l2_it_hn))
    if: l2_it_hnl != 0
        l2_xfree((cast: (@: void) l2_it_hnl))
    if: l2_it_hty != 0
        l2_xfree((cast: (@: void) l2_it_hty))
    l2_it_ar: nar
    l2_it_dyn: ndyn
    l2_it_ret: nret
    l2_it_throws: nthrows
    l2_it_n: nn
    l2_it_nl: nnl
    l2_it_ty: nty
    l2_it_hn: nhn
    l2_it_hnl: nhnl
    l2_it_hty: nhty
    l2_intern_cap: (cast: (unsigned) cap)
return: 0

fn: l2_intern_match (unsigned: s; int: ar; const: @(char n0); size_t: l0; int: t0; const: @(char n1); size_t: l1; int: t1; const: @(char n2); size_t: l2n; int: t2; const: @(char n3); size_t: l3; int: t3) int
    @@: char ns
    @: size_t nl
    @: int nt
    # The proof helper stores the ordinary int-return/no-throw contract.
    if: s >= l2_intern_n || l2_it_ar[s] != ar || l2_it_dyn[s] != 0 || l2_it_ret[s] != 0 || l2_it_throws[s] != 0
        return: 0
    ns: (cast: (@@: char) l2_it_n[s])
    nl: l2_it_nl[s]
    nt: l2_it_ty[s]
    if: ar >= 1 && (ns = 0 || nl = 0 || nt = 0 || t0 != nt[0] || l0 != nl[0] || c.memcmp(n0, ns[0], l0) != 0)
        return: 0
    if: ar >= 2 && (t1 != nt[1] || l1 != nl[1] || c.memcmp(n1, ns[1], l1) != 0)
        return: 0
    if: ar >= 3 && (t2 != nt[2] || l2n != nl[2] || c.memcmp(n2, ns[2], l2n) != 0)
        return: 0
    if: ar >= 4 && (t3 != nt[3] || l3 != nl[3] || c.memcmp(n3, ns[3], l3) != 0)
        return: 0
return: 1

fn: l2_intern_store (int: ar; const: @(char n0); size_t: l0; int: t0; const: @(char n1); size_t: l1; int: t1; const: @(char n2); size_t: l2n; int: t2; const: @(char n3); size_t: l3; int: t3) unsigned
    unsigned: i 0U
    unsigned: s
    size_t: psz
    @@: char ns 0
    @: size_t nl 0
    @: int nt 0
    while: i < l2_intern_n
        if: l2_intern_match(i, ar, n0, l0, t0, n1, l1, t1, n2, l2n, t2, n3, l3, t3)
            return: i + 1U
        i: i + 1U
    if: ar < 1 || ar > 4
        return: 0U
    if: l2_intern_n = (cast: (unsigned) -1)
        l2_alloc_err: 2
        return: 0U
    if: l2_intern_reserve(l2_intern_n + 1U) != 0
        return: 0U
    psz: c.sizeof(l2_ptr_probe)
    if: l2_mul_ok((cast: (size_t) ar), psz) = 0 || l2_mul_ok((cast: (size_t) ar), c.sizeof(c.size_t)) = 0 || l2_mul_ok((cast: (size_t) ar), c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 0U
    l2_alloc_kind: 3
    ns: (cast: (@@: char) l2_xmalloc((cast: (size_t) ar) * psz))
    nl: (cast: (@: size_t) l2_xmalloc((cast: (size_t) ar) * c.sizeof(c.size_t)))
    nt: (cast: (@: int) l2_xmalloc((cast: (size_t) ar) * c.sizeof(c.int)))
    if: ns = 0 || nl = 0 || nt = 0
        if: ns != 0
            l2_xfree((cast: (@: void) ns))
        if: nl != 0
            l2_xfree((cast: (@: void) nl))
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        return: 0U
    if: ar >= 1
        ns[0]: (cast: (@: char) n0)
        nl[0]: l0
        nt[0]: t0
    if: ar >= 2
        ns[1]: (cast: (@: char) n1)
        nl[1]: l1
        nt[1]: t1
    if: ar >= 3
        ns[2]: (cast: (@: char) n2)
        nl[2]: l2n
        nt[2]: t2
    if: ar >= 4
        ns[3]: (cast: (@: char) n3)
        nl[3]: l3
        nt[3]: t3
    s: l2_intern_n
    l2_it_ar[s]: ar
    l2_it_dyn[s]: 0
    l2_it_ret[s]: 0
    l2_it_throws[s]: 0
    l2_it_n[s]: (cast: (@: char) ns)
    l2_it_nl[s]: nl
    l2_it_ty[s]: nt
    l2_it_hn[s]: 0
    l2_it_hnl[s]: 0
    l2_it_hty[s]: 0
    l2_intern_n: l2_intern_n + 1U
return: l2_intern_n

fn: l2_intern_pair (const: @(char a); size_t: na; const: @(char b); size_t: nb) unsigned
return: l2_intern_store(2, a, na, 0, b, nb, 0, 0, 0U, 0, 0, 0U, 0)

fn: l2_intern_eq_mi (unsigned: s; int: mi) int
    int: k
    @: LmP0Text nm
    @@: char ns
    @: size_t nl
    @: int nt
    @@: char hs
    @: size_t hl
    @: int ht
    if: s >= l2_intern_n || mi < 0
        return: 0
    if: l2_it_ar[s] != l2_m_arity[mi] || l2_it_dyn[s] != l2_m_dyn[mi] || l2_it_ret[s] != l2_m_ret[mi] || l2_it_throws[s] != l2_m_throws[mi]
        return: 0
    ns: (cast: (@@: char) l2_it_n[s])
    nl: l2_it_nl[s]
    nt: l2_it_ty[s]
    hs: (cast: (@@: char) l2_it_hn[s])
    hl: l2_it_hnl[s]
    ht: l2_it_hty[s]
    k: 0
    while: k < l2_m_arity[mi]
        nm: l2_fn(mi, k)
        if: nm = 0 || nm\data = 0 || ns = 0 || nl = 0 || nt = 0
            return: 0
        if: l2_ft(mi, k) != nt[k]
            return: 0
        if: nm\length != nl[k] || c.memcmp(nm\data, ns[k], nl[k]) != 0
            return: 0
        k: k + 1
    k: 0
    while: k < l2_m_dyn[mi]
        nm: l2_dn(mi, k)
        if: nm = 0 || nm\data = 0 || hs = 0 || hl = 0 || ht = 0
            return: 0
        if: l2_dt(mi, k) != ht[k]
            return: 0
        if: nm\length != hl[k] || c.memcmp(nm\data, hs[k], hl[k]) != 0
            return: 0
        k: k + 1
return: 1

fn: l2_intern_store_mi (int: mi) unsigned
    unsigned: i 0U
    unsigned: s
    int: k
    int: ar
    int: dyn
    size_t: psz
    @: LmP0Text nm
    @@: char ns 0
    @: size_t nl 0
    @: int nt 0
    @@: char hs 0
    @: size_t hl 0
    @: int ht 0
    while: i < l2_intern_n
        if: l2_intern_eq_mi(i, mi)
            return: i + 1U
        i: i + 1U
    if: l2_intern_n = (cast: (unsigned) -1)
        l2_alloc_err: 2
        return: 0U
    if: l2_intern_reserve(l2_intern_n + 1U) != 0
        return: 0U
    ar: l2_m_arity[mi]
    dyn: l2_m_dyn[mi]
    psz: c.sizeof(l2_ptr_probe)
    s: l2_intern_n
    l2_it_n[s]: 0
    l2_it_nl[s]: 0
    l2_it_ty[s]: 0
    l2_it_hn[s]: 0
    l2_it_hnl[s]: 0
    l2_it_hty[s]: 0
    if: ar > 0
        if: l2_mul_ok((cast: (size_t) ar), psz) = 0 || l2_mul_ok((cast: (size_t) ar), c.sizeof(c.size_t)) = 0 || l2_mul_ok((cast: (size_t) ar), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            return: 0U
        l2_alloc_kind: 3
        ns: (cast: (@@: char) l2_xmalloc((cast: (size_t) ar) * psz))
        nl: (cast: (@: size_t) l2_xmalloc((cast: (size_t) ar) * c.sizeof(c.size_t)))
        nt: (cast: (@: int) l2_xmalloc((cast: (size_t) ar) * c.sizeof(c.int)))
        if: ns = 0 || nl = 0 || nt = 0
            if: ns != 0
                l2_xfree((cast: (@: void) ns))
            if: nl != 0
                l2_xfree((cast: (@: void) nl))
            if: nt != 0
                l2_xfree((cast: (@: void) nt))
            return: 0U
        k: 0
        while: k < ar
            nm: l2_fn(mi, k)
            if: nm = 0 || nm\data = 0
                l2_xfree((cast: (@: void) ns))
                l2_xfree((cast: (@: void) nl))
                l2_xfree((cast: (@: void) nt))
                return: 0U
            ns[k]: (cast: (@: char) nm\data)
            nl[k]: nm\length
            nt[k]: l2_ft(mi, k)
            k: k + 1
        ---
    if: dyn > 0
        if: l2_mul_ok((cast: (size_t) dyn), psz) = 0 || l2_mul_ok((cast: (size_t) dyn), c.sizeof(c.size_t)) = 0 || l2_mul_ok((cast: (size_t) dyn), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            if: ns != 0
                l2_xfree((cast: (@: void) ns))
            if: nl != 0
                l2_xfree((cast: (@: void) nl))
            if: nt != 0
                l2_xfree((cast: (@: void) nt))
            return: 0U
        l2_alloc_kind: 3
        hs: (cast: (@@: char) l2_xmalloc((cast: (size_t) dyn) * psz))
        hl: (cast: (@: size_t) l2_xmalloc((cast: (size_t) dyn) * c.sizeof(c.size_t)))
        ht: (cast: (@: int) l2_xmalloc((cast: (size_t) dyn) * c.sizeof(c.int)))
        if: hs = 0 || hl = 0 || ht = 0
            if: ns != 0
                l2_xfree((cast: (@: void) ns))
            if: nl != 0
                l2_xfree((cast: (@: void) nl))
            if: nt != 0
                l2_xfree((cast: (@: void) nt))
            if: hs != 0
                l2_xfree((cast: (@: void) hs))
            if: hl != 0
                l2_xfree((cast: (@: void) hl))
            if: ht != 0
                l2_xfree((cast: (@: void) ht))
            return: 0U
        k: 0
        while: k < dyn
            nm: l2_dn(mi, k)
            if: nm = 0 || nm\data = 0
                l2_xfree((cast: (@: void) ns))
                l2_xfree((cast: (@: void) nl))
                l2_xfree((cast: (@: void) nt))
                l2_xfree((cast: (@: void) hs))
                l2_xfree((cast: (@: void) hl))
                l2_xfree((cast: (@: void) ht))
                return: 0U
            hs[k]: (cast: (@: char) nm\data)
            hl[k]: nm\length
            ht[k]: l2_dt(mi, k)
            k: k + 1
        ---
    l2_it_ar[s]: ar
    l2_it_dyn[s]: dyn
    l2_it_ret[s]: l2_m_ret[mi]
    l2_it_throws[s]: l2_m_throws[mi]
    l2_it_n[s]: (cast: (@: char) ns)
    l2_it_nl[s]: nl
    l2_it_ty[s]: nt
    l2_it_hn[s]: (cast: (@: char) hs)
    l2_it_hnl[s]: hl
    l2_it_hty[s]: ht
    l2_intern_n: l2_intern_n + 1U
return: l2_intern_n

fn: l2_intern_mi (int: mi) unsigned
    if: mi < 0
        return: 0U
return: l2_intern_store_mi(mi)

fn: l2_find_method (const: @(LmP0Text name)) int
    int: i 0
