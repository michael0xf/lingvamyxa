fn: l2_emit_unit (const: @(char out_path)) int
    int: i 0
    int: k
    int: oi
    int: hu
    unsigned: n
    unsigned: cap
    unsigned: kids
    int: bseq
    size_t: pn
    c.array: [512]: char tmp
    c.array: [512]: char bak
    @: FILE chk
    int: had 0
    if: out_path = 0 || l2_m_n = 0 || (l2_main_body = 0 && (l2_main_node = 0 || l2_main_node\as = 0 || l2_ret_tr(l2_main_node\as\frame) = 0))
        return: 1
    if: l2_layout_owns() != 0
        return: 1
    n: (cast: (unsigned) l2_m_n)
    pn: c.strlen(out_path)
    if: pn + 5U >= 512U
        return: 1
    c.memcpy(tmp, out_path, pn)
    tmp[pn]: 46
    tmp[pn + 1U]: 116
    tmp[pn + 2U]: 109
    tmp[pn + 3U]: 112
    tmp[pn + 4U]: 0
    l2_out: c.fopen(tmp, "wb")
    if: l2_out = 0
        c.fprintf(c.stderr, "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: (l2_need_p0 != 0 || l2_need_query != 0) && c.fputs("predef: \"l2src/l2_text_hash.lm1\"\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_need_p0 = 0 && l2_need_query = 0 && l2_has_own_ty(0) != 0 && c.fputs("predef: \"l2src/lmx_int.lm1\"\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_need_p0 = 0 && l2_need_query = 0 && l2_has_own_ty(0) = 0 && c.fputs("predef: \"l2src/lmx_size.lm1\"\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_need_own != 0 && c.fputs("predef: \"l1src/own.lm1\"\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("include: \"l2src/lmx.h\" \"<stdio.h>\" \"<stdlib.h>\" \"<string.h>\"", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_need_p0 != 0 && c.fputs(" \"l1src/p0.lm1.h\"", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_need_query != 0 && c.fputs(" \"l2src/l2_immut_query.h\"", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("\n\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("# interned contract: rec.sig is translator intern id of the full canonical contract.\n# L2_SIG_V0 schema plus arity and exact ordered source formal names/types (int, char, size_t, const char*, const LmP0Text* const-pointee, LmP0Text* mutable pointee, const L2ImmutQuery* const-pointee, L2ImmutQuery* mutable pointee, size_t* mutable out-param). Throws-none, no dyn/varargs. Method name is not interned.\n# Hidden DynRequired names, when present, are interned after declared formals, sorted by source-name bytes then type; declared arity is unchanged. Empty DynRequired keeps the declared-only intern.\n# Mapping: id 1 := first interned contract of this unit. l2_sig_f0/f1 are method 0's first two source names (empty if arity is below that).\n# Linked-program intern only, not inter-module canonicalization. One intern table for the unit, not reset per method.\n# Runtime: no memcmp; closed-unit devirtualization. Formal names are the intern entry for rec.sig. const pointee forbids stores through the pointee; mutable pointee stores address the referent fields, not a cache.\nconst: @(char l2_sig_f0) \"", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_m_f0[0] != 0 && l2_write_text(l2_out, l2_m_f0[0]) != 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("\"\nconst: @(char l2_sig_f1) \"", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_m_f1[0] != 0 && l2_write_text(l2_out, l2_m_f1[0]) != 0
        c.fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "\"\nunsigned: l2_intern_id %uU\nunsigned: l2_intern_again %uU\nunsigned: l2_intern_swap %uU\nunsigned: l2_intern_probe %uU\n", l2_sigv, l2_intern_again, l2_intern_swap, l2_intern_probe) < 0
        c.fclose(l2_out)
        return: 1
    k: 0
    while: k < l2_own_n
        if: c.fprintf(l2_out, "const: @(char l2_own%d) \"", k) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_text(l2_out, l2_own_name[k]) != 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs("\"\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        k: k + 1
    ---
    if: c.fputs("\nprototype:\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_need_diag != 0 && c.fputs("    sub: lm_p0_set_diagnostic (@: LmP0Document document; int: code; size_t: line; size_t: column; const: @(char message))\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    while: i < l2_m_n
        if: l2_m_ret[i] = 8 && c.fputs("    sub: ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_m_ret[i] != 8 && c.fputs("    fn: ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            c.fclose(l2_out)
            return: 1
        if: l2_emit_sig(i) != 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs("\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        i: i + 1
    if: c.fputs("end: prototype\n\n# Backend method symbols are l2_m{i}; intern and find_method keep source names. c.malloc stays the foreign door.\n# Publication: write tmp; if dest.bak exists pick dest.bak.N; rename dest to that bak; rename tmp to dest; on fail restore bak or report its path. Not atomic. No recursive FS. Foreign bak is not deleted.\n# OwnUsed char/size_t fields are children of callable->node. Char cache is typed char; graph data is all_chars cell. size_t cache is typed size_t; graph data is a unique LMX_TYPE_SIZE_T cell mutated in place (no interned shared size_t, no int narrowing). Dirty-only checkpoint after actuals, immediately before the executed call, and before return. Explicit node\\name writes the graph, not the cache.\n# LmP0Text is the existing C ABI from l1src/p0.lm1.h (data, length), a limited migration adapter, not a general C header parser and not a silent layout for new L2 Structures. LmP0TrailerRole is that same header's typedef int (NONE/DASH_CUTTER/END/RETURN/UNTIL), not intern16. Lmx structural access stays child-index. Known C: c.strlen, c.memcmp, l2_immut_query_fill, l2_hash_compare_q, c.sizeof(c.LmP0Text), lm_own_new_zero, lm_own_copy_bytes, lm_own_delete. Unknown c.* is rejected. Body @: LmP0Text is an 11.2.1 address slot l2_s, not OwnUsed and not lmx_own. Pointer results @: char / @: LmP0Text; sub: is void. return: slot is the pointer value, not @slot. @: size_t is a typed out-param; name[0]: stores through it (literal 0 only). L2 @ actuals are not emitted; a type-9 actual is the pointer value forwarded. Checkpoint even if OwnUsed is empty. Same-name char/size_t argument and own field share the parameter from the own-decl line; dirty-only publish is to this method's node, not the caller. An argument without that bind is never published. Nested if own-decl is unsupported own declaration. L2ImmutQuery is a borrowed immutable-query adapter (not LmP0Text); fill is a temporary L1 helper behind the L2 make method. text_equals is the mutable fallback (strlen+memcmp). equals_query hashes current text bytes against a prepared query hash. &&/|| with calls use guarded if/temps; skipped RHS does not prep nested actuals. Pure &&/|| stay L1 C expressions.\n\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_need_diag != 0 && c.fputs("sub: lm_p0_set_diagnostic (@: LmP0Document document; int: code; size_t: line; size_t: column; const: @(char message))\n    if: document = 0 || document\\diagnostic = 0 || document\\diagnostic\\code != 0\n        return\n    if: message = 0\n        message: \"\"\n    document\\diagnostic\\code: code\n    document\\diagnostic\\line: line\n    document\\diagnostic\\column: column\n    c.snprintf(document\\diagnostic\\message, c.sizeof(document\\diagnostic\\message), \"%s\", message)\nend: lm_p0_set_diagnostic\n\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_m_n
        if: l2_m_ret[i] = 8 && c.fputs("sub: ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_m_ret[i] != 8 && c.fputs("fn: ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            c.fclose(l2_out)
            return: 1
        if: l2_emit_sig(i) != 0
            c.fclose(l2_out)
            return: 1
        if: l2_m_ret[i] = 2 && c.fputs("\n    if: node = 0\n        return: 0U\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_m_ret[i] = 8 && c.fputs("\n    if: node = 0\n        return\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_m_ret[i] != 2 && l2_m_ret[i] != 8 && c.fputs("\n    if: node = 0\n        return: 0\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        k: 0
        while: k < l2_for_n
            hu: 0
            oi: 0
            while: oi < l2_own_n
                if: l2_m_uses[l2_own_off(i, oi)] != 0 && l2_own_fid[oi] = k
                    hu: 1
                oi: oi + 1
            ---
            if: hu != 0 && c.fprintf(l2_out, "    @: Lmx l2_h%d 0\n    l2_h%d: lmx_branch_child(node, %uU)\n    if: l2_h%d = 0\n        return: 0\n", k, k, (cast: (unsigned) l2_for_uchild[k]), k) < 0
                c.fclose(l2_out)
                return: 1
            k: k + 1
        ---
        k: 0
        while: k < l2_own_n
            l2_own_live[k]: 0
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_m_alias[l2_own_off(i, k)] < 0
                l2_own_live[k]: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_m_alias[l2_own_off(i, k)] < 0 && l2_own_ty[k] = 1 && c.fprintf(l2_out, "    char: l2_q%d\n    @: Lmx l2_q%d_from 0\n    int: l2_q%d_dirty 0\n", k, k, k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_m_alias[l2_own_off(i, k)] < 0 && l2_own_ty[k] = 2 && c.fprintf(l2_out, "    size_t: l2_q%d\n    @: Lmx l2_q%d_from 0\n    int: l2_q%d_dirty 0\n", k, k, k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_m_alias[l2_own_off(i, k)] < 0 && l2_own_ty[k] = 0 && c.fprintf(l2_out, "    int: l2_q%d\n    @: Lmx l2_q%d_from 0\n    int: l2_q%d_dirty 0\n", k, k, k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_m_alias[l2_own_off(i, k)] < 0 && l2_own_fid[k] >= 0 && c.fprintf(l2_out, "    l2_q%d_from: lmx_branch_child(l2_h%d, %uU)\n    if: l2_q%d_from = 0\n        return: 0\n", k, l2_own_fid[k], (cast: (unsigned) l2_own_fchild[k]), k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_m_alias[l2_own_off(i, k)] < 0 && l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && c.fprintf(l2_out, "    l2_q%d_from: lmx_branch_child(node, %uU)\n    if: l2_q%d_from = 0\n        return: 0\n", k, (cast: (unsigned) l2_own_uchild[k]), k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_m_alias[l2_own_off(i, k)] < 0 && l2_own_ty[k] = 1 && c.fprintf(l2_out, "    l2_q%d: (cast: (char) lmx_char_value(l2_q%d_from\\data))\n", k, k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_m_alias[l2_own_off(i, k)] < 0 && l2_own_ty[k] = 2 && c.fprintf(l2_out, "    l2_q%d: lmx_size_value(l2_q%d_from\\data)\n", k, k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_m_alias[l2_own_off(i, k)] < 0 && l2_own_ty[k] = 0 && c.fprintf(l2_out, "    l2_q%d: lmx_int_value(l2_q%d_from\\data)\n", k, k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_m_alias[l2_own_off(i, k)] >= 0 && c.fprintf(l2_out, "    @: Lmx l2_q%d_from 0\n    int: l2_q%d_dirty 0\n", k, k) < 0
                c.fclose(l2_out)
                return: 1
            k: k + 1
        ---
        k: 0
        while: k < l2_m_sn[i]
            if: l2_st[l2_slot_off(i, k)] = 3 && c.fprintf(l2_out, "    @: char l2_s%d_%d 0\n", i, k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_st[l2_slot_off(i, k)] = 5 && c.fprintf(l2_out, "    @: LmP0Text l2_s%d_%d 0\n", i, k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_st[l2_slot_off(i, k)] = 9 && c.fprintf(l2_out, "    @: size_t l2_s%d_%d 0\n", i, k) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_st[l2_slot_off(i, k)] = 14 && c.fprintf(l2_out, "    @: LmP0IndentStack l2_s%d_%d 0\n", i, k) < 0
                c.fclose(l2_out)
                return: 1
            k: k + 1
        ---
        if: (l2_own_n != 0 || l2_m_dyn[i] != 0 || l2_for_n != 0) && c.fputs("    @: Lmx l2_xp 0\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        l2_tn: 0
        l2_call_node: "node"
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_emit_body(l2_m_body[i]\as\structure, i, "    ") != 0
            c.fclose(l2_out)
            return: 1
        if: l2_m_body[i] = 0 && l2_emit_body(0, i, "    ") != 0
            c.fclose(l2_out)
            return: 1
        if: l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_emit_ret_tr(i, "    ", l2_ret_tr(l2_m_node[i]\as\frame)) != 0
            c.fclose(l2_out)
            return: 1
        if: l2_m_ret[i] = 8 && l2_emit_checkpoint(i, "    ") != 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs("end: ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            c.fclose(l2_out)
            return: 1
        if: c.fputs("\n\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        i: i + 1
    cap: n + 1U
    if: l2_has_own_ty(1) != 0
        cap: cap + 1U
    if: l2_has_own_ty(2) != 0
        cap: cap + 1U
    if: l2_has_own_ty(0) != 0
        cap: cap + 1U
    if: l2_own_n != 0 || l2_for_n != 0
        cap: cap + 1U
    cap: cap + (cast: (unsigned) l2_for_n)
    kids: n + (cast: (unsigned) l2_unit_base)
    if: c.fprintf(l2_out, "external:\n    fn: main () int\n        @: Lmx unit 0\n        @: Lmx leaf 0\n        @: Lmx kid 0\n        @: LmxMethod rec 0\n        if: lmx_ranges_init(%uU) != 0\n            return: 1\n", cap) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_has_own_ty(1) != 0 && c.fputs("        if: lmx_chars_init() != 0\n            return: 1\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_has_own_ty(2) != 0 && c.fputs("        if: lmx_size_init() != 0\n            return: 1\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_has_own_ty(0) != 0 && c.fputs("        if: lmx_int_init() != 0\n            return: 1\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "        unit: (cast: (@: Lmx) c.malloc(c.sizeof(c.Lmx)))\n        if: unit = 0\n            return: 1\n        lmx_cell_init(unit, 0, 0)\n        if: lmx_branch_open(unit, %uU) != 0\n            return: 1\n", kids) < 0
        c.fclose(l2_out)
        return: 1
    k: 0
    while: k < l2_own_n
        if: l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && c.fprintf(l2_out, "        leaf: lmx_branch_child(unit, %uU)\n        if: leaf = 0\n            return: 1\n", (cast: (unsigned) l2_own_uchild[k])) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && l2_own_ty[k] = 1 && c.fputs("        leaf\\data: lmx_char_cell(0)\n        if: lmx_type_of(leaf\\data) != c.LMX_TYPE_CHAR\n            return: 1\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && l2_own_ty[k] = 2 && c.fputs("        leaf\\data: lmx_size_take()\n        if: lmx_type_of(leaf\\data) != c.LMX_TYPE_SIZE_T\n            return: 1\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && l2_own_ty[k] = 0 && c.fputs("        leaf\\data: lmx_int_take()\n        if: lmx_type_of(leaf\\data) != c.LMX_TYPE_INT\n            return: 1\n", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        k: k + 1
    ---
    k: 0
    while: k < l2_for_n
        if: l2_for_nkid[k] = 0
            k: k + 1
            continue
        if: c.fprintf(l2_out, "        leaf: lmx_branch_child(unit, %uU)\n        if: leaf = 0\n            return: 1\n        if: lmx_branch_open(leaf, %uU) != 0\n            return: 1\n", (cast: (unsigned) l2_for_uchild[k]), (cast: (unsigned) l2_for_nkid[k])) < 0
            c.fclose(l2_out)
            return: 1
        oi: 0
        while: oi < l2_own_n
            if: l2_own_fid[oi] = k && c.fprintf(l2_out, "        kid: lmx_branch_child(leaf, %uU)\n        if: kid = 0\n            return: 1\n", (cast: (unsigned) l2_own_fchild[oi])) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_own_fid[oi] = k && l2_own_ty[oi] = 1 && c.fputs("        kid\\data: lmx_char_cell(0)\n        if: lmx_type_of(kid\\data) != c.LMX_TYPE_CHAR\n            return: 1\n", l2_out) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_own_fid[oi] = k && l2_own_ty[oi] = 2 && c.fputs("        kid\\data: lmx_size_take()\n        if: lmx_type_of(kid\\data) != c.LMX_TYPE_SIZE_T\n            return: 1\n", l2_out) < 0
                c.fclose(l2_out)
                return: 1
            if: l2_own_fid[oi] = k && l2_own_ty[oi] = 0 && c.fputs("        kid\\data: lmx_int_take()\n        if: lmx_type_of(kid\\data) != c.LMX_TYPE_INT\n            return: 1\n", l2_out) < 0
                c.fclose(l2_out)
                return: 1
            oi: oi + 1
        ---
        k: k + 1
    ---
    i: 0
    while: i < l2_m_n
        if: c.fputs("        rec: (cast: (@: LmxMethod) c.malloc(c.sizeof(c.LmxMethod)))\n        if: rec = 0\n            return: 1\n        rec\\addr: (cast: (LmxEntry) ", l2_out) < 0
            c.fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            c.fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, ")\n        rec\\sig: %uU\n        if: lmx_range_register((cast: (@: void) rec), (cast: (@: void) (rec + 1)), c.sizeof(c.LmxMethod), c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD) != 0\n            return: 1\n        leaf: lmx_branch_child(unit, %uU)\n        if: leaf = 0\n            return: 1\n        leaf\\data: (cast: (@: void) rec)\n        if: lmx_classify(leaf\\data) != c.LMX_KIND_METHOD\n            return: 1\n        if: rec\\sig != %uU\n            return: 1\n        if: leaf\\node != unit\n            return: 1\n", l2_m_sig[i], (cast: (unsigned) (l2_unit_base + i)), l2_m_sig[i]) < 0
            c.fclose(l2_out)
            return: 1
        i: i + 1
    if: c.fputs("        if: l2_intern_again != l2_intern_id\n            return: 1\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: l2_m_arity[0] != 0 && c.fputs("        if: l2_sig_f0[0] = 0\n            return: 1\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    if: c.fputs("        # Closed-unit devirtualization: translator-bound child indices, no graph mutations after construction. rec.addr is METHOD-domain storage, not the call. Runtime does not memcmp formals. Evaluation order of actuals is materialized into temps before each call boundary. Hidden through-args, when present, follow declared formals in intern name order.\n", l2_out) < 0
        c.fclose(l2_out)
        return: 1
    l2_tn: 0
    l2_call_node: "unit"
