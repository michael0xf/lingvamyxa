predef: "l2src/parser_scan_port_l2.h.lm1"

# L2 port of l1src/parser.lm1's scanning primitives (position, line,
# indent, layout-prefix), Stage b of the parser-in-L2 port ticket.
# Bodies are ported straight from l1src/parser.lm1 (the oracle,
# unedited); parser_position.lm2, parser_visual_column.lm2,
# parser_line_start.lm2, parser_physical_line.lm2, parser_scan_indent.lm2
# and parser_scan_layout_prefix.lm2 (the pre-existing fragments) carry
# closely related logic under lm_p0_ names for a different purpose --
# this unit is the real port, named p0_* per the ticket (never
# lm_p0_), and never calls lm_p0_* either. Character comparisons use
# decimal codes (9/10/13/46), matching the fragments' own convention,
# not the oracle's '\t'/'\r'/'\n'/'.' literal spelling -- a spelling
# choice only, not a behavior change.

fn: p0_indent_tab_column (size_t: column) size_t
    return: ((column / 8U) + 1U) * 8U
end: p0_indent_tab_column

sub: p0_scan_indent_column (const: @(char source); size_t: start; size_t: end; @: size_t out_offset; @: size_t out_column)
    size_t: p
    size_t: column
    p: start
    column: 0U
    while: p < end && p0_is_horizontal_space(source[p])
        if: source[p] = 9
            column: p0_indent_tab_column(column)
        if: source[p] != 9
            column: column + 1U
        p: p + 1U
    out_offset[0]: p
    out_column[0]: column
end: p0_scan_indent_column

fn: p0_visual_column_between (const: @(char source); size_t: start; size_t: end) size_t
    size_t: p
    size_t: column
    p: start
    column: 0U
    while: p < end
        if: source[p] = 13 && p + 1U < end && source[p + 1U] = 10
            p: p + 1U
        if: source[p] = 13
            column: 0U
            p: p + 1U
            continue
        if: source[p] = 10
            column: 0U
            p: p + 1U
            continue
        if: source[p] = 9
            column: p0_indent_tab_column(column)
            p: p + 1U
            continue
        column: column + 1U
        p: p + 1U
    return: column
end: p0_visual_column_between

fn: p0_count_line_breaks (const: @(char source); size_t: start; size_t: end) size_t
    size_t: count
    size_t: i
    size_t: width
    count: 0U
    i: start
    while: i < end
        width: p0_line_break_width_at(source, end, i)
        if: width != 0U
            count: count + 1U
            i: i + width
            continue
        i: i + 1U
    return: count
end: p0_count_line_breaks

sub: p0_position_in_slice (const: @(char text); size_t: length; size_t: index; size_t: base_line; size_t: base_column; @: size_t out_line; @: size_t out_column)
    size_t: i
    size_t: line
    size_t: column
    size_t: width
    line: base_line
    column: base_column
    if: index > length
        index: length
    i: 0U
    while: i < index
        width: p0_line_break_width_at(text, index, i)
        if: width != 0U
            line: line + 1U
            column: 1U
            i: i + width
            continue
        column: column + 1U
        i: i + 1U
    out_line[0]: line
    out_column[0]: column
end: p0_position_in_slice

sub: p0_advance_layout_line (const: @(char source); size_t: length; size_t: line_start; size_t: line_end; @: size_t offset; @: size_t line)
    size_t: next_offset
    size_t: line_breaks
    size_t: width
    next_offset: line_end
    line_breaks: p0_count_line_breaks(source, line_start, line_end)
    width: p0_line_break_width_at(source, length, next_offset)
    if: width != 0U
        line_breaks: line_breaks + 1U
        next_offset: next_offset + width
    offset[0]: next_offset
    line[0]: line[0] + line_breaks
end: p0_advance_layout_line

fn: p0_index_is_line_start (const: @(char text); size_t: index) int
    if: index = 0U
        return: 1
    return: text[index - 1U] = 10 || text[index - 1U] = 13
end: p0_index_is_line_start

fn: p0_line_rest_is_horizontal_space (const: @(char source); size_t: start; size_t: end) int
    size_t: i
    i: start
    while: i < end
        if: p0_is_horizontal_space(source[i]) = 0
            return: 0
        i: i + 1U
    return: 1
end: p0_line_rest_is_horizontal_space

fn: p0_find_physical_line_end (const: @(char source); size_t: length; size_t: start) size_t
    size_t: i
    i: start
    while: i < length && p0_is_line_break(source[i]) = 0
        i: i + 1U
    return: i
end: p0_find_physical_line_end

sub: p0_scan_layout_prefix (const: @(char source); size_t: length; size_t: start; @: size_t out_offset; @: size_t out_indent_column; @: size_t out_dot_level)
    size_t: p
    size_t: indent_column
    size_t: dot_level
    p0_scan_indent_column(source, start, length, @ p, @ indent_column)
    dot_level: 0U
    while: p < length && source[p] = 46
        dot_level: dot_level + 1U
        p: p + 1U
        while: p < length && p0_is_horizontal_space(source[p]) != 0
            p: p + 1U
        ---
    out_offset[0]: p
    out_indent_column[0]: indent_column
    out_dot_level[0]: dot_level
end: p0_scan_layout_prefix

fn: p0_layout_prefix_is_deeper (size_t: indent_column; size_t: dot_level; size_t: base_indent_column; size_t: base_dot_level) int
    if: dot_level > 0U || base_dot_level > 0U
        return: dot_level > base_dot_level
    return: indent_column > base_indent_column
end: p0_layout_prefix_is_deeper
