predef: "l2src/lmx_message.lm1"
include: "<stdio.h>"

c.array: []: unsigned lmx_poll_buf 8

fn: main () int
    @: LmxMsgRuntime rt
    unsigned: parent 0U
    unsigned: child 0U
    unsigned: child2 0U
    unsigned: parent_b 0U
    unsigned: child_b 0U
    @: LmxMsgEnv env
    @: LmxMsgEnv got
    @: uchar payload
    int: st
    int: fail 0
    payload: (cast: (@: uchar) c.malloc(4U))
    env: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    got: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    if: payload = 0 || env = 0 || got = 0
        return: 1
    payload[0]: 65
    payload[1]: 0
    payload[2]: 255
    payload[3]: 66
    rt: lmx_msg_runtime_new()
    if: rt = 0
        return: 1
    st: lmx_msg_create(rt, 0U, 1U, payload, 4U, @ parent)
    if: st != c.LMX_MSG_OK || parent = 0U
        c.printf("create parent failed\n")
        fail: fail + 1
    st: lmx_msg_create(rt, parent, 7U, payload, 4U, @ child)
    if: st != c.LMX_MSG_OK || child = 0U
        c.printf("create child failed\n")
        fail: fail + 1
    if: lmx_msg_state(rt, child) != c.LMX_MSG_STATE_INACTIVE
        c.printf("child not inactive at create\n")
        fail: fail + 1
    st: lmx_msg_create(rt, parent, 7U, payload, 4U, @ child2)
    if: st != c.LMX_MSG_OK || child2 != child
        c.printf("create retry must reuse child identity\n")
        fail: fail + 1
    if: lmx_msg_child_n(rt, parent) != 1 || lmx_msg_child_at(rt, parent, 0) != child
        c.printf("direct child list\n")
        fail: fail + 1
    st: lmx_msg_create(rt, 0U, 2U, payload, 4U, @ parent_b)
    st: lmx_msg_create(rt, parent_b, 1U, payload, 4U, @ child_b)
    if: lmx_msg_child_n(rt, parent_b) != 1 || lmx_msg_child_at(rt, parent_b, 0) != child_b
        c.printf("second family child list\n")
        fail: fail + 1
    st: lmx_msg_end_turn(rt, parent_b, 1)
    if: lmx_msg_child_n(rt, parent) != 1 || lmx_msg_child_at(rt, parent, 0) = child_b
        c.printf("families must not share child lists\n")
        fail: fail + 1
    unsigned: sib_a 0U
    unsigned: sib_b 0U
    unsigned: sib_c 0U
    st: lmx_msg_create(rt, parent_b, 2U, payload, 4U, @ sib_a)
    st: lmx_msg_create(rt, parent_b, 3U, payload, 4U, @ sib_b)
    st: lmx_msg_create(rt, parent_b, 4U, payload, 4U, @ sib_c)
    if: lmx_msg_child_n(rt, parent_b) != 4
        c.printf("three extra siblings\n")
        fail: fail + 1
    st: lmx_msg_end_turn(rt, parent_b, 0)
    if: lmx_msg_child_n(rt, parent_b) != 1 || lmx_msg_child_at(rt, parent_b, 0) != child_b
        c.printf("uncommitted sibling unlink\n")
        fail: fail + 1
    st: lmx_msg_create(rt, parent_b, 5U, payload, 4U, @ sib_a)
    st: lmx_msg_create(rt, parent_b, 6U, payload, 4U, @ sib_b)
    st: lmx_msg_create(rt, parent_b, 7U, payload, 4U, @ sib_c)
    if: lmx_msg_child_n(rt, parent_b) != 4
        c.printf("committed sibling count\n")
        fail: fail + 1
    st: lmx_msg_end_turn(rt, parent_b, 1)
    st: lmx_msg_stop(rt, parent_b, parent_b)
    st: lmx_msg_end_turn(rt, parent_b, 1)
    st: lmx_msg_pump(rt)
    st: lmx_msg_end_turn(rt, parent_b, 1)
    st: lmx_msg_end_turn(rt, sib_a, 1)
    st: lmx_msg_end_turn(rt, sib_b, 1)
    st: lmx_msg_end_turn(rt, sib_c, 1)
    st: lmx_msg_end_turn(rt, child_b, 1)
    if: lmx_msg_state(rt, sib_a) != c.LMX_MSG_STATE_STOPPED || lmx_msg_state(rt, sib_b) != c.LMX_MSG_STATE_STOPPED || lmx_msg_state(rt, sib_c) != c.LMX_MSG_STATE_STOPPED || lmx_msg_state(rt, child_b) != c.LMX_MSG_STATE_STOPPED
        c.printf("sibling close cascade\n")
        fail: fail + 1
    unsigned: seg 0U
    if: lmx_msg_path_n(rt, parent) != 1
        c.printf("root path depth\n")
        fail: fail + 1
    st: lmx_msg_path_seg(rt, parent, 0, @ seg)
    if: st != c.LMX_MSG_OK || seg != 1U
        c.printf("root path not 1\n")
        fail: fail + 1
    if: lmx_msg_path_n(rt, child) != 2
        c.printf("child path depth\n")
        fail: fail + 1
    st: lmx_msg_path_seg(rt, child, 0, @ seg)
    if: st != c.LMX_MSG_OK || seg != 1U
        c.printf("child path prefix\n")
        fail: fail + 1
    st: lmx_msg_path_seg(rt, child, 1, @ seg)
    if: st != c.LMX_MSG_OK || seg != 1U
        c.printf("child path not 1.1\n")
        fail: fail + 1
    st: lmx_msg_path_seg(rt, child2, 1, @ seg)
    if: child2 != child || seg != 1U
        c.printf("retry consumed a new path segment\n")
        fail: fail + 1
    env\id: 1U
    env\correlation: 11U
    env\reply_to: parent
    env\kind: c.LMX_MSG_KIND_BYTES
    env\number: 0
    env\bytes: payload
    env\n: 4U
    st: lmx_msg_send(rt, parent, child, env)
    if: st != c.LMX_MSG_STAGED
        c.printf("send staging failed\n")
        fail: fail + 1
    if: lmx_msg_inbox_n(rt, child) != 0
        c.printf("staging must not admit\n")
        fail: fail + 1
    payload[0]: 91
    st: lmx_msg_end_turn(rt, parent, 1)
    if: st != c.LMX_MSG_OK
        c.printf("end_turn publish failed\n")
        fail: fail + 1
    st: lmx_msg_pump(rt)
    if: st != c.LMX_MSG_OK
        c.printf("pump failed\n")
        fail: fail + 1
    if: lmx_msg_state(rt, child) != c.LMX_MSG_STATE_RUNNING
        c.printf("child not activated by admission\n")
        fail: fail + 1
    st: lmx_msg_recv(rt, child, got)
    if: st != c.LMX_MSG_OK
        c.printf("recv failed\n")
        fail: fail + 1
    if: got\n != 4U || got\bytes = 0 || got\bytes[0] != 65 || got\bytes[2] != 255
        c.printf("payload copy not independent\n")
        fail: fail + 1
    if: got\correlation != 11U
        c.printf("correlation lost\n")
        fail: fail + 1
    lmx_msg_env_release(got)
    st: lmx_msg_send(rt, parent, child, env)
    st: lmx_msg_end_turn(rt, parent, 0)
    st: lmx_msg_pump(rt)
    if: lmx_msg_inbox_n(rt, child) != 0
        c.printf("failed turn must discard outbox\n")
        fail: fail + 1
    env\id: 1U
    st: lmx_msg_send(rt, parent, child, env)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    if: lmx_msg_inbox_n(rt, child) != 0
        c.printf("duplicate (from,id) must not re-admit\n")
        fail: fail + 1
    env\id: 2U
    env\correlation: 22U
    st: lmx_msg_send(rt, parent, child, env)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    st: lmx_msg_fail(rt, child)
    if: lmx_msg_state(rt, child) != c.LMX_MSG_STATE_DEAD
        c.printf("fail did not mark dead\n")
        fail: fail + 1
    st: lmx_msg_recv(rt, parent, got)
    if: st != c.LMX_MSG_OK || got\kind != c.LMX_MSG_KIND_DEAD
        c.printf("parent not told of child death\n")
        fail: fail + 1
    lmx_msg_env_release(got)
    env\id: 3U
    st: lmx_msg_send(rt, parent, child, env)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    if: lmx_msg_inbox_n(rt, child) != 0
        c.printf("dead child admitted late send\n")
        fail: fail + 1
    unsigned: dropc 0U
    unsigned: drop_addr 0U
    st: lmx_msg_create(rt, parent, 90U, payload, 4U, @ dropc)
    drop_addr: dropc
    env\id: 90U
    env\kind: c.LMX_MSG_KIND_BYTES
    env\bytes: payload
    env\n: 4U
    env\reply_to: parent
    st: lmx_msg_send(rt, parent, dropc, env)
    if: st != c.LMX_MSG_STAGED
        c.printf("drop-race send not staged\n")
        fail: fail + 1
    st: lmx_msg_fail(rt, dropc)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    if: lmx_msg_inbox_n(rt, dropc) != 0
        c.printf("staged copy admitted after dest death\n")
        fail: fail + 1
    st: lmx_msg_recv(rt, parent, got)
    if: st != c.LMX_MSG_OK || got\kind != c.LMX_MSG_KIND_DEAD
        c.printf("drop-race parent DEAD notice\n")
        fail: fail + 1
    lmx_msg_env_release(got)
    st: lmx_msg_recv(rt, parent, got)
    if: st != c.LMX_MSG_EMPTY
        c.printf("dropped stage bounced to reply_to\n")
        fail: fail + 1
    if: lmx_msg_state(rt, drop_addr) != c.LMX_MSG_STATE_DEAD && lmx_msg_state(rt, drop_addr) != c.LMX_MSG_STATE_RELEASED
        c.printf("closed handle lost control state\n")
        fail: fail + 1
    unsigned: later 0U
    st: lmx_msg_create(rt, parent, 41U, payload, 4U, @ later)
    if: later = 0U || later = drop_addr
        c.printf("new create reused closed handle\n")
        fail: fail + 1
    child2: 0U
    st: lmx_msg_create(rt, parent, 8U, payload, 4U, @ child2)
    env\id: 9U
    env\kind: c.LMX_MSG_KIND_NUMBER
    env\number: 7
    env\bytes: 0
    env\n: 0U
    st: lmx_msg_send(rt, parent, child2, env)
    st: lmx_msg_stop(rt, parent, child2)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    if: lmx_msg_state(rt, child2) = c.LMX_MSG_STATE_STOPPED
        c.printf("stop interrupted active mailbox before end_turn\n")
        fail: fail + 1
    st: lmx_msg_recv(rt, child2, got)
    if: st != c.LMX_MSG_OK
        c.printf("closing child lost admitted work\n")
        fail: fail + 1
    lmx_msg_env_release(got)
    st: lmx_msg_recv(rt, child2, got)
    if: st != c.LMX_MSG_EMPTY
        c.printf("stop control must not be cancelled-result work\n")
        fail: fail + 1
    st: lmx_msg_end_turn(rt, child2, 1)
    if: lmx_msg_state(rt, child2) != c.LMX_MSG_STATE_STOPPED
        c.printf("close flag not applied at end_turn\n")
        fail: fail + 1
    unsigned: stale 0U
    unsigned: retried 0U
    unsigned: req 0U
    unsigned: mid 0U
    unsigned: leaf 0U
    st: lmx_msg_create(rt, parent, 20U, payload, 4U, @ stale)
    st: lmx_msg_end_turn(rt, parent, 0)
    if: lmx_msg_state(rt, stale) != -1
        c.printf("aborted reservation still findable\n")
        fail: fail + 1
    st: lmx_msg_create(rt, parent, 20U, payload, 4U, @ retried)
    if: retried = 0U || retried = stale
        c.printf("retry after abort must not reuse freed addr\n")
        fail: fail + 1
    st: lmx_msg_create(rt, parent, 21U, payload, 4U, @ req)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_create(rt, parent, 22U, payload, 4U, @ mid)
    env\id: 42U
    env\correlation: 0U
    env\reply_to: req
    env\kind: c.LMX_MSG_KIND_BYTES
    env\bytes: payload
    env\n: 4U
    st: lmx_msg_send(rt, req, mid, env)
    st: lmx_msg_end_turn(rt, req, 1)
    st: lmx_msg_pump(rt)
    if: lmx_msg_inbox_n(rt, mid) != 0 || lmx_msg_state(rt, mid) = c.LMX_MSG_STATE_RUNNING
        c.printf("third-party send activated uncommitted child\n")
        fail: fail + 1
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    env\id: 42U
    env\correlation: 0U
    env\reply_to: req
    st: lmx_msg_send(rt, req, mid, env)
    st: lmx_msg_end_turn(rt, req, 1)
    st: lmx_msg_pump(rt)
    st: lmx_msg_recv(rt, mid, got)
    if: st != c.LMX_MSG_OK || got\id != 42U
        c.printf("committed recv of requester work failed\n")
        fail: fail + 1
    lmx_msg_env_release(got)
    st: lmx_msg_fail(rt, mid)
    st: lmx_msg_recv(rt, req, got)
    if: st != c.LMX_MSG_OK || got\kind != c.LMX_MSG_KIND_DEAD || got\id != 42U || got\correlation != 42U
        c.printf("executing requester not told correlated DEAD\n")
        fail: fail + 1
    if: (cast: (unsigned) got\number) != mid
        c.printf("DEAD missing worker identity\n")
        fail: fail + 1
    lmx_msg_env_release(got)
    st: lmx_msg_create(rt, parent, 23U, payload, 4U, @ mid)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_create(rt, mid, 24U, payload, 4U, @ leaf)
    st: lmx_msg_end_turn(rt, mid, 1)
    st: lmx_msg_fail(rt, mid)
    if: lmx_msg_state(rt, leaf) = c.LMX_MSG_STATE_STOPPED
        c.printf("fail must not instantly stop descendants\n")
        fail: fail + 1
    st: lmx_msg_poll(rt, leaf, 0U, 0U, lmx_poll_buf, 8)
    st: lmx_msg_end_turn(rt, leaf, 1)
    if: lmx_msg_state(rt, leaf) != c.LMX_MSG_STATE_STOPPED
        c.printf("leaf did not self-close after parent death poll\n")
        fail: fail + 1
    unsigned: mid2 0U
    unsigned: leaf2 0U
    st: lmx_msg_create(rt, parent, 30U, payload, 4U, @ mid2)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_create(rt, mid2, 31U, payload, 4U, @ leaf2)
    st: lmx_msg_end_turn(rt, mid2, 1)
    if: lmx_msg_state(rt, leaf2) = c.LMX_MSG_STATE_STOPPED
        c.printf("end_turn must leave children alive\n")
        fail: fail + 1
    st: lmx_msg_stop(rt, parent, mid2)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    if: lmx_msg_state(rt, mid2) = c.LMX_MSG_STATE_STOPPED
        c.printf("stop reclaimed mid before its end_turn\n")
        fail: fail + 1
    st: lmx_msg_end_turn(rt, mid2, 1)
    if: lmx_msg_state(rt, mid2) != c.LMX_MSG_STATE_STOPPED
        c.printf("mid did not close at end_turn\n")
        fail: fail + 1
    if: lmx_msg_state(rt, leaf2) = c.LMX_MSG_STATE_STOPPED
        c.printf("leaf reclaimed before its end_turn\n")
        fail: fail + 1
    st: lmx_msg_end_turn(rt, leaf2, 1)
    if: lmx_msg_state(rt, leaf2) != c.LMX_MSG_STATE_STOPPED
        c.printf("normal parent close did not reach leaf at its end_turn\n")
        fail: fail + 1
    st: lmx_msg_set_now(rt, 10U)
    st: lmx_msg_create(rt, parent, 25U, payload, 4U, @ mid)
    st: lmx_msg_end_turn(rt, parent, 1)
    env\id: 50U
    env\reply_to: parent
    st: lmx_msg_send(rt, parent, mid, env)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    st: lmx_msg_recv(rt, mid, got)
    lmx_msg_env_release(got)
    unsigned: idle 0U
    st: lmx_msg_create(rt, parent, 26U, payload, 4U, @ idle)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_poll(rt, idle, 1000U, 1U, lmx_poll_buf, 8)
    if: st != 0
        c.printf("live idle parent did not keep child alive\n")
        fail: fail + 1
    st: lmx_msg_drive(rt, 1000U, 1U)
    if: lmx_msg_state(rt, idle) = c.LMX_MSG_STATE_STOPPED
        c.printf("drive timed out child of live idle parent\n")
        fail: fail + 1
    unsigned: ui 0U
    unsigned: worker 0U
    unsigned: w2 0U
    unsigned: log 0U
    unsigned: ctrl 0U
    unsigned: idle2 0U
    st: lmx_msg_create(rt, parent, 40U, payload, 4U, @ ui)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_create(rt, ui, 41U, payload, 4U, @ worker)
    st: lmx_msg_end_turn(rt, ui, 1)
    env\id: 60U
    env\kind: c.LMX_MSG_KIND_CANCELLED
    env\reply_to: worker
    env\bytes: 0
    env\n: 0U
    st: lmx_msg_send(rt, worker, ui, env)
    st: lmx_msg_end_turn(rt, worker, 1)
    st: lmx_msg_pump(rt)
    if: lmx_msg_state(rt, ui) = c.LMX_MSG_STATE_STOPPED
        c.printf("cancelled result shut down UI\n")
        fail: fail + 1
    st: lmx_msg_recv(rt, ui, got)
    if: st != c.LMX_MSG_OK || got\kind != c.LMX_MSG_KIND_CANCELLED
        c.printf("UI did not receive cancelled result\n")
        fail: fail + 1
    lmx_msg_env_release(got)
    st: lmx_msg_end_turn(rt, ui, 1)
    if: lmx_msg_state(rt, ui) = c.LMX_MSG_STATE_STOPPED
        c.printf("UI closed after cancelled-result turn\n")
        fail: fail + 1
    st: lmx_msg_stop(rt, ui, worker)
    st: lmx_msg_end_turn(rt, ui, 1)
    st: lmx_msg_pump(rt)
    if: lmx_msg_state(rt, worker) = c.LMX_MSG_STATE_STOPPED
        c.printf("stop reclaimed worker before end_turn\n")
        fail: fail + 1
    if: lmx_msg_state(rt, ui) = c.LMX_MSG_STATE_STOPPED
        c.printf("stop(worker) closed UI\n")
        fail: fail + 1
    st: lmx_msg_end_turn(rt, worker, 1)
    if: lmx_msg_state(rt, worker) != c.LMX_MSG_STATE_STOPPED
        c.printf("worker did not close at boundary\n")
        fail: fail + 1
    if: lmx_msg_state(rt, ui) = c.LMX_MSG_STATE_STOPPED
        c.printf("worker close stopped UI\n")
        fail: fail + 1
    st: lmx_msg_create(rt, parent, 42U, payload, 4U, @ w2)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_create(rt, parent, 45U, payload, 4U, @ log)
    st: lmx_msg_end_turn(rt, parent, 1)
    env\id: 70U
    env\kind: c.LMX_MSG_KIND_BYTES
    env\reply_to: parent
    env\bytes: payload
    env\n: 4U
    st: lmx_msg_send(rt, parent, w2, env)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    st: lmx_msg_recv(rt, w2, got)
    lmx_msg_env_release(got)
    env\id: 71U
    env\kind: c.LMX_MSG_KIND_PROGRESS
    env\number: 50
    env\reply_to: log
    env\bytes: 0
    env\n: 0U
    st: lmx_msg_send(rt, w2, log, env)
    st: lmx_msg_stop(rt, parent, w2)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    st: lmx_msg_end_turn(rt, w2, 1)
    st: lmx_msg_pump(rt)
    if: lmx_msg_state(rt, w2) != c.LMX_MSG_STATE_STOPPED
        c.printf("progress worker did not close at end_turn\n")
        fail: fail + 1
    st: lmx_msg_recv(rt, log, got)
    if: st != c.LMX_MSG_OK || got\kind != c.LMX_MSG_KIND_PROGRESS || got\number != 50
        c.printf("progress staged before close was not published\n")
        fail: fail + 1
    lmx_msg_env_release(got)
    env\id: 72U
    env\kind: c.LMX_MSG_KIND_BYTES
    env\reply_to: parent
    env\bytes: payload
    env\n: 4U
    st: lmx_msg_send(rt, parent, w2, env)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    if: lmx_msg_inbox_n(rt, w2) != 0
        c.printf("ordinary work after STOPPED\n")
        fail: fail + 1
    st: lmx_msg_create(rt, parent, 43U, payload, 4U, @ ctrl)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_create(rt, ctrl, 44U, payload, 4U, @ idle2)
    st: lmx_msg_end_turn(rt, ctrl, 1)
    st: lmx_msg_stop(rt, parent, ctrl)
    st: lmx_msg_end_turn(rt, parent, 1)
    st: lmx_msg_pump(rt)
    st: lmx_msg_end_turn(rt, ctrl, 1)
    if: lmx_msg_state(rt, idle2) = c.LMX_MSG_STATE_STOPPED
        c.printf("drive child instantly STOPPED\n")
        fail: fail + 1
    st: lmx_msg_drive(rt, 0U, 0U)
    if: lmx_msg_state(rt, idle2) != c.LMX_MSG_STATE_STOPPED
        c.printf("drive did not close idle child\n")
        fail: fail + 1
    st: lmx_msg_fail(rt, parent)
    st: lmx_msg_poll(rt, idle, 0U, 0U, lmx_poll_buf, 8)
    if: st < 1
        c.printf("child poll missed dead parent\n")
        fail: fail + 1
    if: lmx_msg_state(rt, idle) = c.LMX_MSG_STATE_STOPPED
        c.printf("dead parent instantly reclaimed idle child\n")
        fail: fail + 1
    st: lmx_msg_end_turn(rt, idle, 1)
    if: lmx_msg_state(rt, idle) != c.LMX_MSG_STATE_STOPPED
        c.printf("child did not self-close at end_turn after parent death\n")
        fail: fail + 1
    @: LmxMsgRuntime rt2
    unsigned: p0 0U
    unsigned: c1 0U
    unsigned: c2 0U
    unsigned: g1 0U
    unsigned: c10 0U
    unsigned: retr 0U
    unsigned: stale_p 0U
    unsigned: retried_p 0U
    int: k
    rt2: lmx_msg_runtime_new()
    if: rt2 = 0
        fail: fail + 1
    else:
        st: lmx_msg_create(rt2, 0U, 1U, payload, 4U, @ p0)
        st: lmx_msg_create(rt2, p0, 1U, payload, 4U, @ c1)
        st: lmx_msg_create(rt2, p0, 2U, payload, 4U, @ c2)
        st: lmx_msg_create(rt2, c1, 1U, payload, 4U, @ g1)
        if: lmx_msg_path_n(rt2, c1) != 2 || lmx_msg_path_n(rt2, c2) != 2 || lmx_msg_path_n(rt2, g1) != 3
            c.printf("sibling/grandchild depth\n")
            fail: fail + 1
        st: lmx_msg_path_seg(rt2, c1, 1, @ seg)
        if: seg != 1U
            c.printf("first sibling not .1\n")
            fail: fail + 1
        st: lmx_msg_path_seg(rt2, c2, 1, @ seg)
        if: seg != 2U
            c.printf("second sibling not .2\n")
            fail: fail + 1
        st: lmx_msg_path_seg(rt2, g1, 0, @ seg)
        if: seg != 1U
            c.printf("grandchild root seg\n")
            fail: fail + 1
        st: lmx_msg_path_seg(rt2, g1, 1, @ seg)
        if: seg != 1U
            c.printf("grandchild mid seg\n")
            fail: fail + 1
        st: lmx_msg_path_seg(rt2, g1, 2, @ seg)
        if: seg != 1U
            c.printf("grandchild not 1.1.1\n")
            fail: fail + 1
        k: 3
        while: k < 11
            st: lmx_msg_create(rt2, p0, (cast: (unsigned) k), payload, 4U, @ c10)
            k: k + 1
        if: lmx_msg_path_n(rt2, c10) != 2
            c.printf("tenth sibling depth\n")
            fail: fail + 1
        st: lmx_msg_path_seg(rt2, c10, 1, @ seg)
        if: seg != 10U
            c.printf("multi-digit segment not 10\n")
            fail: fail + 1
        st: lmx_msg_create(rt2, p0, 2U, payload, 4U, @ retr)
        if: retr != c2
            c.printf("idempotent create changed sibling\n")
            fail: fail + 1
        st: lmx_msg_path_seg(rt2, retr, 1, @ seg)
        if: seg != 2U
            c.printf("idempotent create changed path\n")
            fail: fail + 1
        if: lmx_msg_path_seg(rt2, g1, 3, @ seg) != c.LMX_MSG_INVALID
            c.printf("path_seg accepted past depth\n")
            fail: fail + 1
        st: lmx_msg_create(rt2, p0, 20U, payload, 4U, @ stale_p)
        st: lmx_msg_end_turn(rt2, p0, 0)
        if: lmx_msg_state(rt2, stale_p) != -1
            c.printf("aborted path child still findable\n")
            fail: fail + 1
        st: lmx_msg_create(rt2, p0, 20U, payload, 4U, @ retried_p)
        if: retried_p = 0U || retried_p = stale_p
            c.printf("retry after abort reused slot\n")
            fail: fail + 1
        st: lmx_msg_path_seg(rt2, retried_p, 1, @ seg)
        if: seg != 12U
            c.printf("retry after abort reused path segment\n")
            fail: fail + 1
        ---
        lmx_msg_runtime_delete(rt2)
    ---
    @: LmxMsgRuntime hrt
    unsigned: host_parent 0U
    unsigned: host_child 0U
    hrt: lmx_msg_runtime_new()
    if: hrt = 0
        c.printf("host runtime\n")
        fail: fail + 1
    st: lmx_msg_create(hrt, 0U, 1U, payload, 4U, @ host_parent)
    st: lmx_msg_create(hrt, host_parent, 90U, payload, 4U, @ host_child)
    st: lmx_msg_end_turn(hrt, host_parent, 1)
    payload[0]: 77
    env\id: 80U
    env\correlation: 8U
    env\reply_to: parent
    env\kind: c.LMX_MSG_KIND_BYTES
    env\bytes: payload
    env\n: 4U
    st: lmx_msg_host_post(hrt, host_child, env)
    if: st != c.LMX_MSG_STAGED
        c.printf("host_post did not accept\n")
        fail: fail + 1
    payload[0]: 1
    if: lmx_msg_inbox_n(hrt, host_child) != 0
        c.printf("host_post admitted without drain\n")
        fail: fail + 1
    st: lmx_msg_host_drain(hrt)
    st: lmx_msg_recv(hrt, host_child, got)
    if: st != c.LMX_MSG_OK || got\id != 80U || got\n != 4U || got\bytes[0] != 77
        c.printf("host drain/recv lost copy\n")
        fail: fail + 1
    lmx_msg_env_release(got)
    st: lmx_msg_stop(hrt, host_parent, host_child)
    st: lmx_msg_end_turn(hrt, host_parent, 1)
    st: lmx_msg_pump(hrt)
    st: lmx_msg_end_turn(hrt, host_child, 1)
    env\id: 81U
    payload[0]: 9
    st: lmx_msg_host_post(hrt, host_child, env)
    if: st != c.LMX_MSG_STAGED
        c.printf("host_post after stop must still accept\n")
        fail: fail + 1
    st: lmx_msg_host_drain(hrt)
    if: lmx_msg_inbox_n(hrt, host_child) != 0
        c.printf("stopped dest admitted host post\n")
        fail: fail + 1
    env\n: 4U
    env\bytes: 0
    st: lmx_msg_host_post(hrt, host_child, env)
    if: st != c.LMX_MSG_INVALID
        c.printf("nonzero n null bytes\n")
        fail: fail + 1
    env\bytes: payload
    c.lmx_msg_host_test_set_nomem(1)
    st: lmx_msg_host_post(hrt, host_child, env)
    c.lmx_msg_host_test_set_nomem(0)
    if: st != c.LMX_MSG_NOMEM
        c.printf("inject nomem\n")
        fail: fail + 1
    c.lmx_msg_host_test_set_nowake(1)
    env\id: 82U
    payload[0]: 55
    st: lmx_msg_host_post(hrt, host_child, env)
    c.lmx_msg_host_test_set_nowake(0)
    if: st != c.LMX_MSG_STAGED
        c.printf("nowake must still stage\n")
        fail: fail + 1
    st: c.lmx_msg_host_wait(hrt, 0U)
    if: st != c.LMX_MSG_EMPTY && st != c.LMX_MSG_OK
        c.printf("bounded wait 0\n")
        fail: fail + 1
    st: c.lmx_msg_host_wait(hrt, 4294967295U)
    if: st != c.LMX_MSG_INVALID
        c.printf("infinite wait refused\n")
        fail: fail + 1
    st: lmx_msg_host_drain(hrt)
    if: lmx_msg_inbox_n(hrt, host_child) != 0
        c.printf("nowake drain admitted to stopped dest\n")
        fail: fail + 1
    st: lmx_msg_runtime_shutdown(hrt)
    st: lmx_msg_host_post(hrt, host_child, env)
    if: st != c.LMX_MSG_STOPPED
        c.printf("host_post after shutdown\n")
        fail: fail + 1
    lmx_msg_runtime_delete(hrt)
    @: LmxMsgRuntime prt
    unsigned: deep 0U
    unsigned: nxt 0U
    int: di 0
    prt: lmx_msg_runtime_new()
    if: prt = 0
        fail: fail + 1
    st: lmx_msg_create(prt, 0U, 1U, payload, 4U, @ deep)
    while: di < 20
        nxt: 0U
        st: lmx_msg_create(prt, deep, (cast: (unsigned) (100 + di)), payload, 4U, @ nxt)
        if: st != c.LMX_MSG_OK || nxt = 0U
            c.printf("deep path create\n")
            fail: fail + 1
            di: 20
        ---
        st: lmx_msg_end_turn(prt, deep, 1)
        deep: nxt
        di: di + 1
    ---
    if: lmx_msg_path_n(prt, deep) != 21
        c.printf("deep path n\n")
        fail: fail + 1
    lmx_msg_runtime_delete(prt)
    @: LmxMsgRuntime lrt
    unsigned: lp 0U
    unsigned: lc 0U
    lrt: lmx_msg_runtime_new()
    if: lrt = 0
        fail: fail + 1
    st: lmx_msg_create(lrt, 0U, 1U, payload, 4U, @ lp)
    st: lmx_msg_create(lrt, lp, 1U, payload, 4U, @ lc)
    st: lmx_msg_end_turn(lrt, lp, 1)
    st: lmx_msg_set_now(lrt, 10U)
    st: lmx_msg_live_query(lrt, lc)
    if: st != c.LMX_MSG_STAGED
        c.printf("live query stage\n")
        fail: fail + 1
    st: lmx_msg_end_turn(lrt, lc, 1)
    st: lmx_msg_pump(lrt)
    st: lmx_msg_recv(lrt, lp, got)
    if: st != c.LMX_MSG_OK || got\kind != c.LMX_MSG_KIND_PROGRESS || got\number != c.LMX_MSG_PROF_LIVE_Q
        c.printf("parent missed child live query\n")
        fail: fail + 1
    st: lmx_msg_live_handle(lrt, lp, got)
    lmx_msg_env_release(got)
    st: lmx_msg_end_turn(lrt, lp, 1)
    st: lmx_msg_pump(lrt)
    st: lmx_msg_recv(lrt, lc, got)
    if: st != c.LMX_MSG_OK || got\number != c.LMX_MSG_PROF_LIVE_R
        c.printf("child missed live reply\n")
        fail: fail + 1
    st: lmx_msg_live_handle(lrt, lc, got)
    lmx_msg_env_release(got)
    st: lmx_msg_set_now(lrt, 50U)
    if: lmx_msg_live_check(lrt, lc, 50U, 5U) != 0
        c.printf("answered child still timed out\n")
        fail: fail + 1
    st: lmx_msg_end_turn(lrt, lc, 1)
    if: lmx_msg_state(lrt, lc) = c.LMX_MSG_STATE_STOPPED
        c.printf("live reply still closed child\n")
        fail: fail + 1
    @: LmxMsgRuntime lrt2
    unsigned: lp2 0U
    unsigned: lc2 0U
    lrt2: lmx_msg_runtime_new()
    st: lmx_msg_create(lrt2, 0U, 1U, payload, 4U, @ lp2)
    st: lmx_msg_create(lrt2, lp2, 1U, payload, 4U, @ lc2)
    st: lmx_msg_end_turn(lrt2, lp2, 1)
    st: lmx_msg_set_now(lrt2, 10U)
    st: lmx_msg_live_query(lrt2, lc2)
    st: lmx_msg_end_turn(lrt2, lc2, 1)
    st: lmx_msg_pump(lrt2)
    st: lmx_msg_set_now(lrt2, 40U)
    if: lmx_msg_live_check(lrt2, lc2, 40U, 5U) < 1
        c.printf("missing parent reply did not request child close\n")
        fail: fail + 1
    st: lmx_msg_end_turn(lrt2, lc2, 1)
    if: lmx_msg_state(lrt2, lc2) != c.LMX_MSG_STATE_STOPPED
        c.printf("child did not close after missing reply\n")
        fail: fail + 1
    @: LmxMsgRuntime lrt3
    unsigned: lp3 0U
    unsigned: lc3 0U
    lrt3: lmx_msg_runtime_new()
    st: lmx_msg_create(lrt3, 0U, 1U, payload, 4U, @ lp3)
    st: lmx_msg_create(lrt3, lp3, 1U, payload, 4U, @ lc3)
    st: lmx_msg_end_turn(lrt3, lp3, 1)
    st: lmx_msg_set_now(lrt3, 10U)
    st: lmx_msg_set_now(lrt3, 40U)
    if: lmx_msg_live_check(lrt3, lp3, 40U, 5U) < 1
        c.printf("parent missing child query did not request close\n")
        fail: fail + 1
    st: lmx_msg_end_turn(lrt3, lc3, 1)
    if: lmx_msg_state(lrt3, lc3) != c.LMX_MSG_STATE_STOPPED
        c.printf("silent child not closed by parent check\n")
        fail: fail + 1
    st: lmx_msg_live_query(lrt, lc)
    if: st != c.LMX_MSG_STAGED
        c.printf("discard query not staged\n")
        fail: fail + 1
    ---
    st: lmx_msg_end_turn(lrt, lc, 0)
    st: lmx_msg_set_now(lrt, 90U)
    if: lmx_msg_live_check(lrt, lc, 90U, 5U) != 0
        c.printf("discarded query still timed out\n")
        fail: fail + 1
    st: lmx_msg_live_test_set_seq(lrt, lc, 4294967295U)
    st: lmx_msg_live_query(lrt, lc)
    if: st != c.LMX_MSG_NOMEM
        c.printf("live_seq wrap\n")
        fail: fail + 1
    @: LmxMsgRuntime lrt4
    unsigned: lp4 0U
    unsigned: lc4 0U
    lrt4: lmx_msg_runtime_new()
