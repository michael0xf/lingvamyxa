    st: lmx_msg_create(lrt4, lp4, 1U, payload, 4U, @ lc4)
    st: lmx_msg_set_now(lrt4, 10U)
    st: lmx_msg_end_turn(lrt4, lp4, 1)
    st: lmx_msg_set_now(lrt4, 12U)
    st: lmx_msg_end_turn(lrt4, lp4, 1)
