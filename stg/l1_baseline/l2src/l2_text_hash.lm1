predef: "l2src/lmx_size.lm1"
include: "<stdint.h>" "<string.h>" "l1src/p0.h"

# FNV-1a 64-bit (Fowler-Noll-Vo), width u64, unsigned wrap.
# offset 0xcbf29ce484222325, prime 1099511628211ULL.
# Not crypto. Not intern id. Not a runtime name table.
#
# No view cache and no process-global bind table. Frozen p0.h stays
# {data, length}. identifier_payload keeps aliasing; a mutable
# LmP0Text is not treated as immutable.
#
# l2_hash_eq at each call:
#   query hash = FNV of value[0..n) (n already from the original strlen)
#   text hash  = FNV of the bytes currently at text->data[0..n)
#   mismatch -> false; equal hashes still memcmp.
# Nothing is retained across calls, so nothing is released.

fn: l2_fnv1a64 (const: @(char p); size_t: n) u64
    u64: h
    size_t: i
    h: 0xcbf29ce484222325ULL
    i: 0U
    if: p = 0
        return: h
    while: i < n
        h: (h ^ (cast: (u64) (cast: (u8) p[i]))) * 1099511628211ULL
        i: i + 1U
return: h

fn: l2_hash_eq (const: @(LmP0Text text); const: @(char value); size_t: n) int
    u64: th
    u64: vh
    if: text = 0 || value = 0
        return: 0
    if: text\length != n
        return: 0
    vh: l2_fnv1a64(value, n)
    th: l2_fnv1a64(text\data, n)
    if: th != vh
        return: 0
return: c.memcmp(text\data, value, n) = 0

fn: l2_hash_eq_forced (const: @(LmP0Text text); const: @(char value); size_t: n; u64: th; u64: vh) int
    if: text = 0 || value = 0
        return: 0
    if: text\length != n
        return: 0
    if: th != vh
        return: 0
return: c.memcmp(text\data, value, n) = 0
