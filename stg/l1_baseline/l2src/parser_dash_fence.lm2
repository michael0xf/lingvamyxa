end: lm_p0_skip_python_string_unchecked
fn: lm_p0_scan_c_quoted_token (const: @(char text); size_t: end_index; size_t: quote_index) size_t
    size_t: cq_i
    size_t: cq_w
    size_t: cq_n
    char: cq_q
    char: cq_ch
    if: quote_index >= end_index
        return: quote_index
    cq_ch: text[quote_index]
    if: cq_ch != 39 && cq_ch != 34
        return: quote_index
    cq_q: cq_ch
    cq_i: quote_index + 1U
    while: cq_i < end_index
        cq_ch: text[cq_i]
        cq_w: 0U
        cq_n: cq_i + 1U
        if: cq_ch = 92 && cq_i + 1U < end_index
            cq_w: lm_p0_line_break_width_at(text, end_index, cq_n)
        if: cq_ch = 92 && cq_i + 1U < end_index && cq_w > 0U
            cq_i: cq_i + (1U + cq_w)
            continue
        if: cq_ch = 92 && cq_i + 1U < end_index
            cq_i: cq_i + 2U
            continue
        if: cq_ch = 92
            cq_i: cq_i + 1U
            continue
        if: cq_ch = cq_q
            return: cq_i + 1U
        if: lm_p0_is_line_break(cq_ch) != 0
            return: quote_index + 1U
        cq_i: cq_i + 1U
    return: quote_index + 1U
end: lm_p0_scan_c_quoted_token
fn: lm_p0_starts_c_prefixed_quote (const: @(char text); size_t: end_index; size_t: start) int
    char: q
    if: start + 1U >= end_index
        return: 0
    if: text[start] != 76
        return: 0
    q: text[start + 1U]
    return: q = 39 || q = 34
end: lm_p0_starts_c_prefixed_quote
fn: lm_p0_scan_c_char_token (const: @(char text); size_t: end_index; size_t: start) size_t
    char: cc_ch
    if: start >= end_index
        return: start
    cc_ch: text[start]
    if: cc_ch != 39
        return: start
    return: lm_p0_scan_c_quoted_token(text, end_index, start)
end: lm_p0_scan_c_char_token
fn: lm_p0_scan_c_prefixed_quote_token (const: @(char text); size_t: end_index; size_t: start) size_t
    size_t: quoted_end
    size_t: qstart
    if: lm_p0_starts_c_prefixed_quote(text, end_index, start) = 0
        return: start
    qstart: start + 1U
    quoted_end: lm_p0_scan_c_quoted_token(text, end_index, qstart)
    if: quoted_end > start + 2U
        return: quoted_end
    return: start + 1U
end: lm_p0_scan_c_prefixed_quote_token
fn: main () int
    return: 0
end: main
