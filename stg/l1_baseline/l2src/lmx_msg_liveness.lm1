predef: "l2src/lmx_msg_liveness.h.lm1"

fn: lmx_msg_ptr_in_block (const: @(void p); const: @(LmxMsgBlock block)) int
    if: p = 0 || block = 0 || block\base = 0 || block\n = 0U
        return: 0
    if: (cast: (uintptr_t) p) < (cast: (uintptr_t) block\base)
        return: 0
    # Subtraction avoids both unrelated-object pointer ordering and base+n.
    if: ((cast: (uintptr_t) p) - (cast: (uintptr_t) block\base)) < block\n
        return: 1
    return: 0

fn: lmx_msg_block_has_range (const: @(LmxOwnedRange ranges); const: @(LmxMsgBlock block)) int
    const: @(LmxOwnedRange range) ranges
    if: block = 0
        return: 0
    while: range != 0
        # Preserve the current collector's endpoint association rule, not a
        # newly invented overlap or type-inference policy.
        if: lmx_msg_ptr_in_block(range\lo, block) != 0 || lmx_msg_ptr_in_block(range\hi, block) != 0
            return: 1
        range: range\next
    ---
    return: 0

fn: lmx_msg_block_is_live (const: @(Lmx graph); const: @(LmxOwnedRange ranges); const: @(LmxMsgBlock block); const: @(LmxVisit seen)) int
    size_t: i 0U
    const: @(Lmx x)
    if: lmx_msg_block_has_range(ranges, block) = 0
        return: 1
    if: graph = 0
        return: 0
    if: seen = 0
        return: 1
    # A failed/incomplete mark cannot authorize freeing a block. The normal
    # collector already skips sweep on OOM; keep this standalone API safe too.
    if: seen\oom != 0 || seen\n > seen\cap || seen\pn > seen\pcap
        return: 1
    if: (seen\n != 0U && seen\v = 0) || (seen\pn != 0U && seen\p = 0)
        return: 1
    while: i < seen\n
        x: seen\v[i]
        if: x = 0
            return: 1
        if: lmx_msg_ptr_in_block(x, block) != 0
            return: 1
        if: lmx_msg_ptr_in_block(x\data, block) != 0
            return: 1
        if: lmx_msg_ptr_in_block(x\node, block) != 0
            return: 1
        i: i + 1U
    ---
    i: 0U
    while: i < seen\pn
        if: lmx_msg_ptr_in_block(seen\p[i], block) != 0
            return: 1
        i: i + 1U
    ---
    return: 0
