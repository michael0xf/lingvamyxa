include: "l1src/p0.lm1.h"

# Header unit for the clean L2 port of l1src/parser.lm1's stack/stream
# event machine (parser-in-L2 port ticket, Stage d). lm_own_new_zero/
# lm_own_delete are L1-implemented (l1src/own.lm1, compiled into the
# same oracle object this L2 unit links against) -- Stage A rule: an
# LMX name needs a prototype: declaration here, never c. --
# lm_p0_trailer_role/lm_p0_trailer_role_is_tail_cutter are still
# oracle-native (not yet ported by any stage); p0_stream_event_is_
# tail_cutter calls them through this same Stage A shape, and the
# calls retarget automatically once/if those names are ever ported
# and added to a stage's Funcs list -- no source change needed then.
# Removed from this header in the same commit that ports each one.

prototype:
    fn: lm_own_new_zero (size_t: size) @: void
    fn: lm_own_resize (@: void object; size_t: size) @: void
    sub: lm_own_delete (@: void object; LmOwnDestroyFields: destroy_fields)
    sub: lm_p0_set_diagnostic (@: LmP0Document document; int: code; size_t: line; size_t: column; const: @(char message))
    fn: lm_p0_trailer_role (const: @(char text); size_t: length) LmP0TrailerRole
    fn: lm_p0_trailer_role_is_tail_cutter (LmP0TrailerRole: role) int
end: prototype
