profile: runtime
predef: "l2src/lmx_sched_record.h.lm1"
predef: "l2src/lmx_branch_owned.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_array_owned.h.lm1"
predef: "l2src/lmx_owned_ranges.h.lm1"
predef: "l2src/lmx_msg_blocks.h.lm1"
include: "l2src/lmx.h" "l2src/lmx_message.h"

# Stage 3c-1 (L2_RUNTIME_PLAN_20260914.md): the parent's scheduler record as
# Structure data. Written directly in L2 (decision 15: the level is the review
# chat's choice); there is no L1 oracle, the selftest is the acceptance.
#
# The record R lives in the OWNER's arena and is retained by the owner as a
# root, so the owner's end-turn collection keeps it and reclaims what R no
# longer references (an outgrown ring). Layout, three slots:
#   R.child[0]  the ring: an Array of Message pointers (opaque domain
#               LMX_SCHED_MSG_POINTER_ID), capacity = its len
#   R.child[1]  head, a size_t cell: index of the oldest queued child
#   R.child[2]  count, a size_t cell: number of queued children
# FIFO of the owner's ready direct children, one entry per child (a second
# enqueue of a queued child is refused as DUPLICATE, as the intrusive list of
# lmx_msg_sched_ready refuses it), growth by doubling into a fresh ring in the
# same arena. No lock: the owner's scheduler runs in the owner's serial lane
# (19.28.R2.2); the executor's own synchronization stays outside.
#
# Library unit, REAL symbols: nothing on a unit's open path allocates through
# a scheduler record.

fn: lmx_sched_record_new (@: LmxMsg owner) @: Lmx
    @: Lmx rec
    @: LmxArrayDesc ring
    @: void head
    @: void count
    int: ring_type
    if: owner = 0
        return: 0
    rec: lmx_node_new_owned(@ owner\blocks, @ owner\ranges)
    if: rec = 0
        return: 0
    ring_type: c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_SCHED_MSG_POINTER_ID
    ring: lmx_array_new_positive_owned(ring_type, 4U, @ owner\blocks, @ owner\ranges)
    head: lmx_size_new_owned(@ owner\blocks, @ owner\ranges)
    count: lmx_size_new_owned(@ owner\blocks, @ owner\ranges)
    if: ring = 0 || head = 0 || count = 0
        return: 0
    if: lmx_branch_open_owned(rec, 3U, @ owner\blocks, @ owner\ranges) != 0
        return: 0
    if: lmx_branch_store_known(rec, 0U, (cast: (@: void) ring)) != 0
        return: 0
    if: lmx_branch_store_known(rec, 1U, head) != 0
        return: 0
    if: lmx_branch_store_known(rec, 2U, count) != 0
        return: 0
    if: c.lmx_msg_root_attach(owner, (cast: (@: void) rec)) != c.LMX_MSG_OK
        return: 0
    return: rec
end: lmx_sched_record_new

fn: lmx_sched_record_n (@: Lmx rec) size_t
    @: void count_cell
    if: rec = 0
        return: 0U
    count_cell: lmx_branch_child_known(rec, 2U)
    if: count_cell = 0
        return: 0U
    return: lmx_size_value_known(count_cell)
end: lmx_sched_record_n

fn: lmx_sched_record_has (@: Lmx rec; @: LmxMsg child) int
    @: LmxArrayDesc ring
    @@: void slots
    @: void head_cell
    @: void count_cell
    size_t: head
    size_t: count
    size_t: cap
    size_t: i
    size_t: at
    if: rec = 0 || child = 0
        return: 0
    ring: (cast: (@: LmxArrayDesc) lmx_branch_child_known(rec, 0U))
    head_cell: lmx_branch_child_known(rec, 1U)
    count_cell: lmx_branch_child_known(rec, 2U)
    if: ring = 0 || head_cell = 0 || count_cell = 0 || ring\data = 0 || ring\len = 0U
        return: 0
    slots: (cast: (@@: void) ring\data)
    cap: ring\len
    head: lmx_size_value_known(head_cell)
    count: lmx_size_value_known(count_cell)
    i: 0U
    while: i < count
        at: (head + i) % cap
        if: slots[at] = (cast: (@: void) child)
            return: 1
        i: i + 1U
    ---
    return: 0
end: lmx_sched_record_has

fn: lmx_sched_record_enqueue (@: LmxMsg owner; @: Lmx rec; @: LmxMsg child) int
    @: LmxArrayDesc ring
    @: LmxArrayDesc bigger
    @@: void slots
    @@: void more
    @: void head_cell
    @: void count_cell
    size_t: head
    size_t: count
    size_t: cap
    size_t: i
    size_t: at
    int: ring_type
    if: owner = 0 || rec = 0 || child = 0
        return: c.LMX_MSG_INVALID
    ring: (cast: (@: LmxArrayDesc) lmx_branch_child_known(rec, 0U))
    head_cell: lmx_branch_child_known(rec, 1U)
    count_cell: lmx_branch_child_known(rec, 2U)
    if: ring = 0 || head_cell = 0 || count_cell = 0 || ring\data = 0 || ring\len = 0U
        return: c.LMX_MSG_INVALID
    if: lmx_sched_record_has(rec, child) != 0
        return: c.LMX_MSG_DUPLICATE
    slots: (cast: (@@: void) ring\data)
    cap: ring\len
    head: lmx_size_value_known(head_cell)
    count: lmx_size_value_known(count_cell)
    if: count = cap
        # Full: a fresh ring of twice the capacity in the owner's arena; the
        # entries move in FIFO order; the old ring becomes unreferenced and is
        # reclaimed by the owner's end-turn collection.
        ring_type: c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_SCHED_MSG_POINTER_ID
        bigger: lmx_array_new_positive_owned(ring_type, cap * 2U, @ owner\blocks, @ owner\ranges)
        if: bigger = 0 || bigger\data = 0
            return: c.LMX_MSG_NOMEM
        more: (cast: (@@: void) bigger\data)
        i: 0U
        while: i < count
            at: (head + i) % cap
            more[i]: slots[at]
            i: i + 1U
        ---
        if: lmx_branch_store_known(rec, 0U, (cast: (@: void) bigger)) != 0
            return: c.LMX_MSG_INVALID
        slots: more
        cap: bigger\len
        head: 0U
        if: lmx_size_store_known(head_cell, 0U) != 0
            return: c.LMX_MSG_INVALID
    ---
    at: (head + count) % cap
    slots[at]: (cast: (@: void) child)
    if: lmx_size_store_known(count_cell, count + 1U) != 0
        return: c.LMX_MSG_INVALID
    return: c.LMX_MSG_OK
end: lmx_sched_record_enqueue

fn: lmx_sched_record_dequeue (@: Lmx rec) @: LmxMsg
    @: LmxArrayDesc ring
    @@: void slots
    @: void head_cell
    @: void count_cell
    @: void taken
    size_t: head
    size_t: count
    size_t: cap
    if: rec = 0
        return: 0
    ring: (cast: (@: LmxArrayDesc) lmx_branch_child_known(rec, 0U))
    head_cell: lmx_branch_child_known(rec, 1U)
    count_cell: lmx_branch_child_known(rec, 2U)
    if: ring = 0 || head_cell = 0 || count_cell = 0 || ring\data = 0 || ring\len = 0U
        return: 0
    count: lmx_size_value_known(count_cell)
    if: count = 0U
        return: 0
    slots: (cast: (@@: void) ring\data)
    cap: ring\len
    head: lmx_size_value_known(head_cell)
    taken: slots[head]
    slots[head]: 0
    if: lmx_size_store_known(head_cell, (head + 1U) % cap) != 0
        return: 0
    if: lmx_size_store_known(count_cell, count - 1U) != 0
        return: 0
    return: (cast: (@: LmxMsg) taken)
end: lmx_sched_record_dequeue

# A child that closed or was unlinked leaves the queue wherever it stands;
# the others keep their order.
fn: lmx_sched_record_remove (@: Lmx rec; @: LmxMsg child) int
    @: LmxArrayDesc ring
    @@: void slots
    @: void head_cell
    @: void count_cell
    size_t: head
    size_t: count
    size_t: cap
    size_t: i
    size_t: at
    size_t: next_at
    int: found
    if: rec = 0 || child = 0
        return: c.LMX_MSG_INVALID
    ring: (cast: (@: LmxArrayDesc) lmx_branch_child_known(rec, 0U))
    head_cell: lmx_branch_child_known(rec, 1U)
    count_cell: lmx_branch_child_known(rec, 2U)
    if: ring = 0 || head_cell = 0 || count_cell = 0 || ring\data = 0 || ring\len = 0U
        return: c.LMX_MSG_INVALID
    slots: (cast: (@@: void) ring\data)
    cap: ring\len
    head: lmx_size_value_known(head_cell)
    count: lmx_size_value_known(count_cell)
    found: 0
    i: 0U
    while: i < count
        at: (head + i) % cap
        if: found = 0 && slots[at] = (cast: (@: void) child)
            found: 1
        ---
        if: found != 0 && i + 1U < count
            next_at: (head + i + 1U) % cap
            slots[at]: slots[next_at]
        ---
        i: i + 1U
    ---
    if: found = 0
        return: c.LMX_MSG_INVALID
    at: (head + count - 1U) % cap
    slots[at]: 0
    if: lmx_size_store_known(count_cell, count - 1U) != 0
        return: c.LMX_MSG_INVALID
    return: c.LMX_MSG_OK
end: lmx_sched_record_remove
