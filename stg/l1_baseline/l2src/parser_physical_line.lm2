fn: lm_p0_is_horizontal_space (char: value) int
    return: value = 32 || value = 9
end: lm_p0_is_horizontal_space
fn: lm_p0_is_line_break (char: value) int
    return: value = 10 || value = 13
end: lm_p0_is_line_break
fn: lm_p0_index_is_line_start (const: @(char text); size_t: index) int
    if: index = 0U
        return: 1
    return: text[index - 1U] = 10 || text[index - 1U] = 13
end: lm_p0_index_is_line_start
fn: lm_p0_find_physical_line_end (const: @(char source); size_t: length; size_t: start) size_t
    size_t: i
    char: ch
    i: start
    while: i < length
        ch: source[i]
        if: lm_p0_is_line_break(ch) != 0
            return: i
        i: i + 1U
    return: i
end: lm_p0_find_physical_line_end
fn: lm_p0_line_rest_is_horizontal_space (const: @(char source); size_t: start; size_t: end) int
    size_t: i
    char: ch
    i: start
    while: i < end
        ch: source[i]
        if: lm_p0_is_horizontal_space(ch) = 0
            return: 0
        i: i + 1U
    return: 1
end: lm_p0_line_rest_is_horizontal_space
fn: lm_p0_line_break_width_at (const: @(char source); size_t: length; size_t: index) size_t
    if: index >= length
        return: 0U
    if: source[index] = 13
        if: index + 1U < length && source[index + 1U] = 10
            return: 2U
        return: 1U
    if: source[index] = 10
        return: 1U
    return: 0U
end: lm_p0_line_break_width_at
fn: lm_p0_count_line_breaks (const: @(char source); size_t: start; size_t: end) size_t
    size_t: count
    size_t: i
    size_t: width
    count: 0U
    i: start
    while: i < end
        width: lm_p0_line_break_width_at(source, end, i)
        if: width != 0U
            count: count + 1U
            i: i + width
            continue
        i: i + 1U
    return: count
end: lm_p0_count_line_breaks
sub: lm_p0_position_in_slice (const: @(char text); size_t: length; size_t: index; size_t: base_line; size_t: base_column; @: size_t out_line; @: size_t out_column)
    size_t: i
    size_t: line
    size_t: column
    size_t: width
    line: base_line
    column: base_column
    if: index > length
        index: length
    i: 0U
    while: i < index
        width: lm_p0_line_break_width_at(text, index, i)
        if: width != 0U
            line: line + 1U
            column: 1U
            i: i + width
            continue
        column: column + 1U
        i: i + 1U
    out_line[0]: line
    out_column[0]: column
end: lm_p0_position_in_slice
fn: main () int
    return: 0
end: main

