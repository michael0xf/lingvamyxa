predef: "l2src/lmx_branch.lm1"
include: "l2src/lmx_own.h"

# Own fields as C working locals, with dirty-only checkpoints.
# Lingvamyxa_spec.txt 21.5, 21.6.
#
# This is the machinery a generated method body carries, written out by hand so
# the contract can be tested directly. The failure modes it guards are silent:
# a flush-all checkpoint and an automatic reload both keep every other test in
# this tree green while destroying the semantics.
#
# What is deliberately NOT here. Only fields the body uses unqualified become
# locals; an explicit path is not folded into the cache, so there is no helper
# that turns a path into one. Declared arguments and dynamic inputs have no
# write-back target and never appear.

# Entry. Loads one own field into a working local and records the slot it came
# from, which is what later publication is aimed at (21.5).
fn: lmx_own_load (@: LmxOwnLocal local; @: Lmx node; size_t: index) int
    @@: void slot
    if: local = 0
        return: 1
    slot: lmx_branch_slot(node, index)
    if: slot = 0
        return: 1
    local\from: slot
    local\value: slot[0]
    local\dirty: 0
return: 0

# An executed write, and the only thing that sets dirty. Making a local
# writable is not a write; 21.6 says a clean snapshot cannot become dirty from
# capability alone.
sub: lmx_own_write (@: LmxOwnLocal local; @: void value)
    if: local != 0
        local\value: value
        local\dirty: 1
    ---
end: lmx_own_write

fn: lmx_own_read (@: LmxOwnLocal local) @: void
    if: local = 0
        return: 0
return: local\value

# Checkpoint. Publishes only if dirty, and clears only its own dirty state.
# Clean locals must not be republished - that is the whole of 21.6 and the
# reason a flush-all epilogue is wrong rather than merely wasteful. The store
# itself is a slot write and cannot fail; a failing checkpoint store is
# diagnostic assert (SPEC 21.6, ABI 14.23), never a silent success code.
fn: lmx_own_checkpoint (@: LmxOwnLocal local) int
    if: local = 0
        return: 1
    if: local\dirty = 0
        return: 0
    if: local\from = 0
        return: 1
    local\from[0]: local\value
    local\dirty: 0
return: 0

# What an explicit node\field write does, for contrast: it reaches the graph on
# every execution and is never routed through anyone's cache (21.5).
fn: lmx_field_write (@: Lmx node; size_t: index; @: void value) int
return: lmx_branch_store(node, index, value)

fn: lmx_field_read (@: Lmx node; size_t: index) @: void
return: lmx_branch_child(node, index)
