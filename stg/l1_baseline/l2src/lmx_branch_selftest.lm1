predef: "l2src/lmx_branch.lm1"
include: "<stdio.h>"

# The settled child representation asserted rather than assumed (SPEC 2,
# ABI 3.3, 14.1, 14.22): len is the child count, data addresses an ordered
# array of void * slots, a slot's ADDRESS classifies as slot storage while the
# VALUE it holds classifies by its own range, addresses are stable, the field
# count is fixed while references may be rebound, and released storage retires
# exactly its own range.
#
# The old inline-header child block and its shallow lmx_branch_copy are gone
# with the withdrawn model; copying a graph is lmx_graph_copy_owned, which
# copies the complete used graph and rewrites node links.

fn: main () int
    @: Lmx root
    @: Lmx other
    @@: void a
    @@: void b
    @@: void c
    @@: void again
    @: void cell_a
    @: void cell_b
    int: failures
    size_t: cycle
    failures: 0

    if: lmx_ranges_init(8U) != 0
        c.printf("lmx: range table init failed\n")
        return: 1
    if: lmx_chars_init() != 0
        c.printf("lmx: char pool init failed\n")
        return: 1
    root: (cast: (@: Lmx) c.calloc(1U, c.sizeof(c.Lmx)))
    other: (cast: (@: Lmx) c.calloc(1U, c.sizeof(c.Lmx)))
    if: root = 0 || other = 0
        c.printf("lmx: allocation failed\n")
        return: 1

    if: lmx_branch_open(root, 3U) != 0
        c.printf("lmx: branch open failed\n")
        return: 1

    # len is exclusively the child count (ABI 14.2): three slots means 3.
    if: root\len != 3
        c.printf("lmx: len is not the child count\n")
        failures: failures + 1
    if: lmx_branch_count(root) != 3U
        c.printf("lmx: child count disagrees with len\n")
        failures: failures + 1

    a: lmx_branch_slot(root, 0U)
    b: lmx_branch_slot(root, 1U)
    c: lmx_branch_slot(root, 2U)
    if: a = 0 || b = 0 || c = 0
        c.printf("lmx: slot by index missing\n")
        return: 1

    # Ordered children: order is the slot index, and [0] is slot zero.
    if: b != a + 1 || c != a + 2
        c.printf("lmx: slots are not contiguous in order\n")
        failures: failures + 1
    if: lmx_branch_slot(root, 3U) != 0
        c.printf("lmx: index past the child count returned a slot\n")
        failures: failures + 1

    # A fresh slot holds nothing; a child is whatever was stored into it.
    if: a[0] != 0 || b[0] != 0 || c[0] != 0
        c.printf("lmx: fresh slots are not null\n")
        failures: failures + 1
    if: lmx_branch_child(root, 0U) != 0
        c.printf("lmx: an unset slot read as a child\n")
        failures: failures + 1

    # Range classification: a pointer into the slot array is slot storage, and
    # the array is one range, so an interior slot classifies like the first.
    if: lmx_type_of(cast: (@: void) a) != c.LMX_TYPE_BRANCH
        c.printf("lmx: first slot is not branch storage\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) c) != c.LMX_TYPE_BRANCH
        c.printf("lmx: last slot is not branch storage\n")
        failures: failures + 1
    if: lmx_classify(cast: (@: void) b) != c.LMX_KIND_CHILDREN
        c.printf("lmx: slot does not read as children storage\n")
        failures: failures + 1

    # Stable addresses: nothing relocates, so asking again gives the same slot.
    again: lmx_branch_slot(root, 1U)
    if: again != b
        c.printf("lmx: a slot moved between two lookups\n")
        failures: failures + 1

    # The child's type comes from the address STORED in the slot, never from
    # the slot's own address. Both readings coexist over the same field.
    cell_a: lmx_char_cell(65)
    cell_b: lmx_char_cell(66)
    if: lmx_branch_store(root, 0U, cell_a) != 0
        c.printf("lmx: storing a child failed\n")
        return: 1
    if: lmx_branch_child(root, 0U) != cell_a
        c.printf("lmx: the slot does not read back its stored child\n")
        failures: failures + 1
    if: lmx_type_of(lmx_branch_child(root, 0U)) != c.LMX_TYPE_CHAR
        c.printf("lmx: the child value lost its own type\n")
        failures: failures + 1
    if: lmx_type_of(cast: (@: void) a) != c.LMX_TYPE_BRANCH
        c.printf("lmx: storing a child changed the slot's own range\n")
        failures: failures + 1
    if: lmx_char_value(lmx_branch_child(root, 0U)) != 65
        c.printf("lmx: the child does not hold its character\n")
        failures: failures + 1

    # Fixed field count, writable references (ABI 14.22): rebinding replaces
    # the reference in place, changes no count, and leaves the old referent.
    if: lmx_branch_store(root, 0U, cell_b) != 0
        c.printf("lmx: rebinding a child failed\n")
        return: 1
    if: lmx_branch_child(root, 0U) != cell_b || root\len != 3
        c.printf("lmx: rebinding changed the field count\n")
        failures: failures + 1
    if: lmx_char_value(cell_a) != 65
        c.printf("lmx: rebinding mutated the interned character cell\n")
        failures: failures + 1
    if: lmx_branch_store(root, 3U, cell_a) = 0
        c.printf("lmx: a store past the child count succeeded\n")
        failures: failures + 1

    # A second Structure has its own slots; storing the same child value in
    # both is ordinary sharing and copies nothing.
    if: lmx_branch_open(other, 2U) != 0
        c.printf("lmx: second branch open failed\n")
        return: 1
    if: lmx_branch_store(other, 1U, cell_b) != 0
        c.printf("lmx: second branch store failed\n")
        return: 1
    if: lmx_branch_child(other, 1U) != lmx_branch_child(root, 0U)
        c.printf("lmx: two slots cannot address one child\n")
        failures: failures + 1
    if: lmx_branch_slot(other, 1U) = lmx_branch_slot(root, 0U)
        c.printf("lmx: two Structures share one slot\n")
        failures: failures + 1

    lmx_branch_release(root)
    if: lmx_range_count != 2U || root\data != 0 || root\len != 0
        c.printf("lmx: released source retained its range or storage\n")
        failures: failures + 1
    if: lmx_branch_child(other, 1U) != cell_b || lmx_char_value(cell_b) != 66
        c.printf("lmx: source release disturbed a live Structure or its child\n")
        failures: failures + 1
    lmx_branch_release(root)
    lmx_branch_release(0)
    if: lmx_range_count != 2U
        c.printf("lmx: repeated or null release disturbed live ranges\n")
        failures: failures + 1

    # More lifetimes than registry slots: freed arrays must not accumulate.
    # Keep the second Structure and the character pool live throughout.
    cycle: 0U
    while: cycle < 32U
        if: lmx_branch_open(root, 1U + cycle % 4U) != 0
            c.printf("lmx: repeated branch lifetime exhausted range slots\n")
            failures: failures + 1
            break
        if: lmx_range_count != 3U || lmx_type_of(root\data) != c.LMX_TYPE_BRANCH
            c.printf("lmx: reopened slot array was not registered\n")
            failures: failures + 1
        lmx_branch_release(root)
        if: lmx_range_count != 2U || lmx_branch_child(other, 1U) != cell_b
            c.printf("lmx: branch retirement damaged surviving ranges\n")
            failures: failures + 1
        cycle: cycle + 1U
    ---
    lmx_branch_release(other)
    if: lmx_range_count != 1U
        c.printf("lmx: release did not retire exactly its own range\n")
        failures: failures + 1
    c.free(root)
    c.free(other)
    lmx_chars_release()
    if: lmx_range_count != 0U
        c.printf("lmx: final release left registered storage\n")
        failures: failures + 1
    lmx_ranges_release()

    if: failures != 0
        c.printf("lmx branch selftest FAILED checks=%d\n", failures)
        return: 1
    c.printf("lmx branch selftest ok\n")
    return: 0
