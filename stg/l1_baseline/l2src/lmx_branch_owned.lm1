predef: "l2src/lmx_branch_owned.h.lm1"
include: "<stdlib.h>" "<limits.h>"

# The range record lives in its payload allocation; the block-list node must
# remain a separate free-compatible allocation. Message cleanup removes ranges
# before releasing blocks, so there is no detached range allocation to leak.
#
# The payload is the void * child-pointer array of one Structure (ABI 3.3). It
# registers as one CHILDREN range of type BRANCH with stride sizeof(void *), so
# a pointer into it classifies as slot storage, never as a child value. Slots
# start null; construction stores each child's typed address afterwards.
fn: lmx_branch_open_owned (@: Lmx parent; size_t: children; @@: LmxMsgBlock blocks; @@: LmxOwnedRange ranges) int
    size_t: offset c.sizeof(c.LmxOwnedRange)
    size_t: slot c.sizeof(@: void)
    size_t: padding (slot - (offset % slot)) % slot
    size_t: bytes
    size_t: index 0U
    @: char allocation
    @@: void slots
    @: LmxMsgBlock prepared_blocks
    @: LmxOwnedRange prepared_ranges
    if: parent = 0 || blocks = 0 || ranges = 0 || children = 0U
        return: 1
    if: parent\data != 0 || parent\len != 0
        return: 1
    # len is int: the child count must be representable (SPEC 2).
    if: children > (cast: (size_t) c.INT_MAX)
        return: 1
    if: offset > ((cast: (size_t) -1) - padding)
        return: 1
    offset: offset + padding
    if: children > (((cast: (size_t) -1) - offset) / slot)
        return: 1
    bytes: offset + children * slot
    prepared_blocks: (cast: (@: LmxMsgBlock) c.malloc(c.sizeof(c.LmxMsgBlock)))
    if: prepared_blocks = 0
        return: 1
    allocation: (cast: (@: char) c.malloc(bytes))
    if: allocation = 0
        c.free(prepared_blocks)
        return: 1
    # malloc alignment plus a multiple of sizeof(void *) aligns the slot array
    # without C11 alignof, flexible-array extensions or moving live addresses.
    slots: (cast: (@@: void) (allocation + offset))
    while: index < children
        slots[index]: 0
        index: index + 1U
    ---
    prepared_ranges: (cast: (@: LmxOwnedRange) allocation)
    prepared_ranges\lo: (cast: (@: void) slots)
    prepared_ranges\hi: (cast: (@: void) (slots + children))
    prepared_ranges\stride: slot
    prepared_ranges\kind: c.LMX_KIND_CHILDREN
    prepared_ranges\type: c.LMX_TYPE_BRANCH
    prepared_ranges\next: 0
    prepared_blocks\base: (cast: (@: void) allocation)
    prepared_blocks\n: bytes
    prepared_blocks\class: c.LMX_TYPE_BRANCH
    prepared_blocks\dispose: 0
    prepared_blocks\next: 0
    if: lmx_msg_storage_move_all(blocks, ranges, @ prepared_blocks, @ prepared_ranges) != c.LMX_MSG_STORAGE_OK
        c.free(allocation)
        c.free(prepared_blocks)
        return: 1
    parent\data: (cast: (@: void) slots)
    parent\len: (cast: (int) children)
    return: 0

# Slot address for a compiler-proven child index. Null only for a null
# parent/data or an out-of-range index; the slot's current value may itself be
# null before construction has stored a child.
fn: lmx_branch_slot_known (@: Lmx parent; size_t: index) @@: void
    if: parent = 0 || parent\data = 0 || parent\len < 0
        return: 0
    if: index >= (cast: (size_t) parent\len)
        return: 0
    return: (cast: (@@: void) parent\data) + index

fn: lmx_branch_child_known (@: Lmx parent; size_t: index) @: void
    @@: void slot lmx_branch_slot_known(parent, index)
    if: slot = 0
        return: 0
    return: slot[0]

# Rebinds one child reference (ABI 14.22). The referenced object is not
# touched; the previous referent is neither freed nor retained here.
fn: lmx_branch_store_known (@: Lmx parent; size_t: index; @: void value) int
    @@: void slot lmx_branch_slot_known(parent, index)
    if: slot = 0
        return: 1
    slot[0]: value
    return: 0

fn: lmx_branch_struct_known (@: Lmx parent; size_t: index) @: Lmx
    return: (cast: (@: Lmx) lmx_branch_child_known(parent, index))
