include: "l2src/lmx_message.h" "l2src/lmx_message_host.h" "l2src/lmx_message_exec.h" "<stdlib.h>" "<string.h>"

prototype:
    fn: lmx_msg_post_dead (@: LmxMsgRuntime rt; LmxMsgAddr: from; LmxMsgAddr: to; unsigned: correlation) int
    fn: lmx_msg_pump (@: LmxMsgRuntime rt) int
end: prototype

# Copy-only Message mailbox. Spec 19.29.7.1.
# Send stages a transport-owned copy. Admission enqueues a fresh copy on the
# recipient inbox. Handler materialization is recv at turn entry.

fn: lmx_msg_copy_bytes (const: @(uchar src); size_t: n) @: uchar
    @: uchar p
    if: n = 0U
        return: 0
    if: src = 0
        return: 0
    p: (cast: (@: uchar) c.malloc(n))
    if: p = 0
        return: 0
    c.memcpy(p, src, n)
return: p

sub: lmx_msg_copy_free (@: LmxMsgCopy node)
    @: LmxMsgCopy next
    while: node != 0
        next: node\next
        if: node\bytes != 0
            c.free((cast: (@: void) node\bytes))
        ---
        c.free((cast: (@: void) node))
        node: next
    ---
end: lmx_msg_copy_free

fn: lmx_msg_copy_dup (const: @(LmxMsgCopy src)) @: LmxMsgCopy
    @: LmxMsgCopy n
    if: src = 0
        return: 0
    n: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: n = 0
        return: 0
    n\id: src\id
    n\correlation: src\correlation
    n\reply_to: src\reply_to
    n\from: src\from
    n\to: src\to
    n\kind: src\kind
    n\number: src\number
    n\n: src\n
    n\next: 0
    n\bytes: lmx_msg_copy_bytes(src\bytes, src\n)
    if: src\n != 0U && n\bytes = 0
        c.free((cast: (@: void) n))
        return: 0
return: n

sub: lmx_msg_q_push (@@: LmxMsgCopy head; @@: LmxMsgCopy tail; @: LmxMsgCopy node)
    if: node = 0
        return
    node\next: 0
    if: head[0] = 0
        head[0]: node
        tail[0]: node
        return
    tail[0]\next: node
    tail[0]: node
end: lmx_msg_q_push

fn: lmx_msg_q_pop (@@: LmxMsgCopy head; @@: LmxMsgCopy tail) @: LmxMsgCopy
    @: LmxMsgCopy n
    n: head[0]
    if: n = 0
        return: 0
    head[0]: n\next
    if: head[0] = 0
        tail[0]: 0
    ---
    n\next: 0
return: n

fn: lmx_msg_find (@: LmxMsgRuntime rt; LmxMsgAddr: addr) @: LmxMsg
    @: LmxMsg m
    int: i 0
    if: rt = 0 || addr = 0U
        return: 0
    while: i < rt\n
        m: rt\tab[i]
        if: m\addr = addr && m\state != c.LMX_MSG_STATE_RELEASED
            return: m
        i: i + 1
return: 0

fn: lmx_msg_find_create (@: LmxMsgRuntime rt; LmxMsgAddr: parent; unsigned: create_id) @: LmxMsg
    @: LmxMsg m
    int: i 0
    if: rt = 0 || create_id = 0U
        return: 0
    while: i < rt\n
        m: rt\tab[i]
        if: m\parent = parent && m\create_id = create_id && m\state != c.LMX_MSG_STATE_RELEASED
            return: m
        i: i + 1
return: 0

fn: lmx_msg_done_has (@: LmxMsg m; LmxMsgAddr: from; unsigned: id) int
    int: i 0
    if: m = 0
        return: 0
    while: i < m\done_n
        if: m\done_from[i] = from && m\done_id[i] = id
            return: 1
        i: i + 1
return: 0

fn: lmx_msg_done_add (@: LmxMsg m; LmxMsgAddr: from; unsigned: id) int
    if: m = 0
        return: 1
    if: lmx_msg_done_has(m, from, id) != 0
        return: 0
    if: m\done_n >= 32
        return: 1
    m\done_from[m\done_n]: from
    m\done_id[m\done_n]: id
    m\done_n: m\done_n + 1
return: 0

fn: lmx_msg_require_owner (@: LmxMsgRuntime rt) int
    if: rt = 0
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_host_is_owner(rt) = 0
        return: c.LMX_MSG_INVALID
    return: c.LMX_MSG_OK

fn: lmx_msg_require_turn (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    if: rt = 0 || who = 0U
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_exec_holding_turn(rt, who) != 0
        return: c.LMX_MSG_OK
    if: c.lmx_msg_host_is_owner(rt) != 0 && c.lmx_msg_exec_workers(rt) = 0
        return: c.LMX_MSG_OK
    return: c.LMX_MSG_INVALID

fn: lmx_msg_runtime_new () @: LmxMsgRuntime
    @: LmxMsgRuntime rt
    rt: (cast: (@: LmxMsgRuntime) c.calloc(1U, c.sizeof(c.LmxMsgRuntime)))
    if: rt = 0
        return: 0
    rt\next_addr: 1U
    if: c.lmx_msg_host_attach(rt) != 0
        c.free((cast: (@: void) rt))
        return: 0
    if: c.lmx_msg_exec_attach(rt) != 0
        c.lmx_msg_host_detach(rt)
        c.free((cast: (@: void) rt))
        return: 0
return: rt

fn: lmx_msg_runtime_shutdown (@: LmxMsgRuntime rt) int
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    return: c.lmx_msg_host_shutdown(rt)

fn: lmx_msg_host_post (@: LmxMsgRuntime rt; LmxMsgAddr: dest; const: @(LmxMsgEnv env)) int
    @: LmxMsgCopy node
    @: uchar bytes
    if: rt = 0 || env = 0 || dest = 0U
        return: c.LMX_MSG_INVALID
    if: env\n != 0U && env\bytes = 0
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_host_lock(rt) != 0
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_host_is_shutdown(rt) != 0
        c.lmx_msg_host_unlock(rt)
        return: c.LMX_MSG_STOPPED
    if: c.lmx_msg_host_test_get_nomem() != 0
        c.lmx_msg_host_unlock(rt)
        return: c.LMX_MSG_NOMEM
    node: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: node = 0
        c.lmx_msg_host_unlock(rt)
        return: c.LMX_MSG_NOMEM
    bytes: lmx_msg_copy_bytes(env\bytes, env\n)
    if: env\n != 0U && bytes = 0
        c.free((cast: (@: void) node))
        c.lmx_msg_host_unlock(rt)
        return: c.LMX_MSG_NOMEM
    node\id: env\id
    node\correlation: env\correlation
    node\reply_to: env\reply_to
    node\from: c.LMX_MSG_HOST_FROM
    node\to: dest
    node\kind: env\kind
    node\number: env\number
    node\bytes: bytes
    node\n: env\n
    lmx_msg_q_push(@ rt\host_head, @ rt\host_tail, node)
    c.lmx_msg_host_wake(rt)
    c.lmx_msg_host_unlock(rt)
return: c.LMX_MSG_STAGED

fn: lmx_msg_host_drain (@: LmxMsgRuntime rt) int
    @: LmxMsgCopy n
    @: LmxMsgCopy nxt
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_host_lock(rt) != 0
        return: c.LMX_MSG_INVALID
    n: rt\host_head
    rt\host_head: 0
    rt\host_tail: 0
    c.lmx_msg_host_unlock(rt)
    c.lmx_msg_exec_lock(rt)
    while: n != 0
        nxt: n\next
        n\next: 0
        lmx_msg_q_push(@ rt\transport, @ rt\transport_tail, n)
        n: nxt
    ---
    c.lmx_msg_exec_unlock(rt)
return: lmx_msg_pump(rt)

sub: lmx_msg_runtime_delete (@: LmxMsgRuntime rt)
    @: LmxMsg m
    @: LmxMsgCopy leftover
    int: i 0
    if: rt = 0
        return
    if: c.lmx_msg_host_is_owner(rt) = 0
        return
    c.lmx_msg_host_shutdown(rt)
    c.lmx_msg_host_lock(rt)
    leftover: rt\host_head
    rt\host_head: 0
    rt\host_tail: 0
    c.lmx_msg_host_unlock(rt)
    lmx_msg_copy_free(leftover)
    c.lmx_msg_exec_stop(rt)
    while: i < rt\n
        m: rt\tab[i]
        lmx_msg_copy_free(m\inbox)
        lmx_msg_copy_free(m\outbox)
        if: m\init != 0
            c.free((cast: (@: void) m\init))
        ---
        c.free((cast: (@: void) m))
        i: i + 1
    lmx_msg_copy_free(rt\transport)
    if: rt\tab != 0
        c.free((cast: (@: void) rt\tab))
    ---
    c.lmx_msg_exec_detach(rt)
    c.lmx_msg_host_detach(rt)
    c.free((cast: (@: void) rt))
end: lmx_msg_runtime_delete

fn: lmx_msg_grow (@: LmxMsgRuntime rt) int
    if: rt = 0
        return: 1
    return: c.lmx_msg_tab_grow(rt)

fn: lmx_msg_assign_path (@: LmxMsgRuntime rt; @: LmxMsg slot; LmxMsgAddr: parent) int
    @: LmxMsg p
    int: i 0
    if: rt = 0 || slot = 0
        return: c.LMX_MSG_INVALID
    if: parent = 0U
        if: rt\root_seq + 1U = 0U
            return: c.LMX_MSG_NOMEM
        rt\root_seq: rt\root_seq + 1U
        slot\path[0]: rt\root_seq
        slot\path_n: 1
        return: c.LMX_MSG_OK
    p: lmx_msg_find(rt, parent)
    if: p = 0
        return: c.LMX_MSG_INVALID
    if: p\path_n < 1 || p\path_n >= c.LMX_MSG_PATH_CAP
        return: c.LMX_MSG_NOMEM
    if: p\child_seq + 1U = 0U
        return: c.LMX_MSG_NOMEM
    p\child_seq: p\child_seq + 1U
    while: i < p\path_n
        slot\path[i]: p\path[i]
        i: i + 1
    slot\path[p\path_n]: p\child_seq
    slot\path_n: p\path_n + 1
return: c.LMX_MSG_OK

fn: lmx_msg_create (@: LmxMsgRuntime rt; LmxMsgAddr: parent; unsigned: create_id; const: @(uchar init); size_t: n; @: LmxMsgAddr out) int
    @: LmxMsg m
    @: LmxMsg slot
    int: st
    if: out = 0 || create_id = 0U
        return: c.LMX_MSG_INVALID
    if: parent = 0U
        if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
            return: c.LMX_MSG_INVALID
        ---
    ---
    if: parent != 0U
        if: lmx_msg_require_turn(rt, parent) != c.LMX_MSG_OK
            return: c.LMX_MSG_INVALID
        ---
    ---
    c.lmx_msg_exec_lock(rt)
    m: lmx_msg_find_create(rt, parent, create_id)
    if: m != 0
        out[0]: m\addr
        c.lmx_msg_exec_unlock(rt)
        return: c.LMX_MSG_OK
    if: parent != 0U && lmx_msg_find(rt, parent) = 0
        c.lmx_msg_exec_unlock(rt)
        return: c.LMX_MSG_INVALID
    if: lmx_msg_grow(rt) != 0
        c.lmx_msg_exec_unlock(rt)
        return: c.LMX_MSG_NOMEM
    slot: c.lmx_msg_slot_new()
    if: slot = 0
        c.lmx_msg_exec_unlock(rt)
        return: c.LMX_MSG_NOMEM
    rt\tab[rt\n]: slot
    st: lmx_msg_assign_path(rt, slot, parent)
    if: st != c.LMX_MSG_OK
        c.free((cast: (@: void) slot))
        rt\tab[rt\n]: 0
        c.lmx_msg_exec_unlock(rt)
        return: st
    slot\addr: rt\next_addr
    rt\next_addr: rt\next_addr + 1U
    slot\parent: parent
    slot\create_id: create_id
    slot\state: c.LMX_MSG_STATE_INACTIVE
    slot\committed: 0
    if: parent = 0U
        slot\committed: 1
        slot\state: c.LMX_MSG_STATE_RUNNING
    ---
    slot\init_n: n
    slot\init: lmx_msg_copy_bytes(init, n)
    if: n != 0U && slot\init = 0
        c.free((cast: (@: void) slot))
        rt\tab[rt\n]: 0
        c.lmx_msg_exec_unlock(rt)
        return: c.LMX_MSG_NOMEM
    rt\n: rt\n + 1
    out[0]: slot\addr
    c.lmx_msg_exec_unlock(rt)
return: c.LMX_MSG_OK

fn: lmx_msg_send (@: LmxMsgRuntime rt; LmxMsgAddr: from; LmxMsgAddr: to; const: @(LmxMsgEnv env)) int
    @: LmxMsg src
    @: LmxMsgCopy node
    if: lmx_msg_require_turn(rt, from) != c.LMX_MSG_OK || env = 0 || from = 0U || to = 0U
        return: c.LMX_MSG_INVALID
    node: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: node = 0
        return: c.LMX_MSG_NOMEM
    node\id: env\id
    node\correlation: env\correlation
    node\reply_to: env\reply_to
    node\from: from
    node\to: to
    node\kind: env\kind
    node\number: env\number
    node\n: env\n
    node\bytes: lmx_msg_copy_bytes(env\bytes, env\n)
    if: env\n != 0U && node\bytes = 0
        c.free((cast: (@: void) node))
        return: c.LMX_MSG_NOMEM
    c.lmx_msg_exec_lock(rt)
    src: lmx_msg_find(rt, from)
    if: src = 0
        c.lmx_msg_exec_unlock(rt)
        lmx_msg_copy_free(node)
        return: c.LMX_MSG_INVALID
    if: src\state = c.LMX_MSG_STATE_DEAD
        c.lmx_msg_exec_unlock(rt)
        lmx_msg_copy_free(node)
        return: c.LMX_MSG_DEAD
    if: src\state = c.LMX_MSG_STATE_STOPPED
        c.lmx_msg_exec_unlock(rt)
        lmx_msg_copy_free(node)
        return: c.LMX_MSG_STOPPED
    lmx_msg_q_push(@ src\outbox, @ src\outbox_tail, node)
    c.lmx_msg_exec_unlock(rt)
return: c.LMX_MSG_STAGED

fn: lmx_msg_stop (@: LmxMsgRuntime rt; LmxMsgAddr: from; LmxMsgAddr: to) int
    @: LmxMsgEnv env
    int: st
    if: lmx_msg_require_turn(rt, from) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    env: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    if: env = 0
        return: c.LMX_MSG_NOMEM
    env\kind: c.LMX_MSG_KIND_STOP
    env\reply_to: from
    st: lmx_msg_send(rt, from, to, env)
    c.free((cast: (@: void) env))
return: st

sub: lmx_msg_release_slot (@: LmxMsg m)
    if: m = 0
        return
    lmx_msg_copy_free(m\inbox)
    lmx_msg_copy_free(m\outbox)
    m\inbox: 0
    m\inbox_tail: 0
    m\outbox: 0
    m\outbox_tail: 0
    if: m\init != 0
        c.free((cast: (@: void) m\init))
    ---
    m\init: 0
    m\init_n: 0U
    m\state: c.LMX_MSG_STATE_RELEASED
    m\committed: 0
end: lmx_msg_release_slot

sub: lmx_msg_request_children_close (@: LmxMsgRuntime rt; LmxMsgAddr: who)
    @: LmxMsg ch
    int: i 0
    if: rt = 0
        return
    while: i < rt\n
        ch: rt\tab[i]
        if: ch\parent = who && ch\state != c.LMX_MSG_STATE_DEAD && ch\state != c.LMX_MSG_STATE_RELEASED && ch\state != c.LMX_MSG_STATE_STOPPED
            ch\closing: 1
            c.lmx_msg_exec_ready(rt, ch\addr)
        ---
        i: i + 1
end: lmx_msg_request_children_close

fn: lmx_msg_end_turn (@: LmxMsgRuntime rt; LmxMsgAddr: who; int: success) int
    @: LmxMsg m
    @: LmxMsg ch
    @: LmxMsgCopy n
    int: i
    if: lmx_msg_require_turn(rt, who) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    c.lmx_msg_exec_lock(rt)
    m: lmx_msg_find(rt, who)
    if: m = 0
        c.lmx_msg_exec_unlock(rt)
        return: c.LMX_MSG_INVALID
    if: m\state = c.LMX_MSG_STATE_DEAD
        lmx_msg_copy_free(m\outbox)
        m\outbox: 0
        m\outbox_tail: 0
        c.lmx_msg_exec_unlock(rt)
        return: c.LMX_MSG_DEAD
    m\exec_live: 0
    m\last_beat: rt\clock
    if: success = 0
        lmx_msg_copy_free(m\outbox)
        m\outbox: 0
        m\outbox_tail: 0
        i: 0
        while: i < rt\n
            ch: rt\tab[i]
            if: ch\parent = who && ch\committed = 0 && ch\state = c.LMX_MSG_STATE_INACTIVE
                lmx_msg_release_slot(ch)
            ---
            i: i + 1
        if: m\closing != 0
            m\state: c.LMX_MSG_STATE_STOPPED
            m\exec_live: 0
            lmx_msg_request_children_close(rt, who)
        ---
        c.lmx_msg_exec_unlock(rt)
        return: c.LMX_MSG_OK
    i: 0
    while: i < rt\n
        ch: rt\tab[i]
        if: ch\parent = who && ch\state = c.LMX_MSG_STATE_INACTIVE
            ch\committed: 1
            c.lmx_msg_exec_ready(rt, ch\addr)
        ---
        i: i + 1
    while: m\outbox != 0
        n: lmx_msg_q_pop(@ m\outbox, @ m\outbox_tail)
        lmx_msg_q_push(@ rt\transport, @ rt\transport_tail, n)
    ---
    if: m\closing != 0
        m\state: c.LMX_MSG_STATE_STOPPED
        m\exec_live: 0
        lmx_msg_request_children_close(rt, who)
    ---
    c.lmx_msg_exec_unlock(rt)
return: lmx_msg_pump(rt)

fn: lmx_msg_admit_one (@: LmxMsgRuntime rt; @: LmxMsgCopy node) int
    @: LmxMsg dest
    @: LmxMsgCopy fresh
    if: rt = 0 || node = 0
        lmx_msg_copy_free(node)
        return: c.LMX_MSG_INVALID
    dest: lmx_msg_find(rt, node\to)
    if: dest = 0 || dest\state = c.LMX_MSG_STATE_DEAD || dest\state = c.LMX_MSG_STATE_STOPPED || dest\state = c.LMX_MSG_STATE_RELEASED
        lmx_msg_copy_free(node)
        return: c.LMX_MSG_GONE
    if: dest\state = c.LMX_MSG_STATE_INACTIVE && dest\committed = 0
        lmx_msg_copy_free(node)
        return: c.LMX_MSG_GONE
    if: node\id != 0U && lmx_msg_done_has(dest, node\from, node\id) != 0
        lmx_msg_copy_free(node)
        return: c.LMX_MSG_DUPLICATE
    if: dest\state = c.LMX_MSG_STATE_INACTIVE
        dest\state: c.LMX_MSG_STATE_RUNNING
    ---
    if: node\kind = c.LMX_MSG_KIND_STOP
        dest\closing: 1
        lmx_msg_copy_free(node)
        return: c.LMX_MSG_OK
    ---
    fresh: lmx_msg_copy_dup(node)
    lmx_msg_copy_free(node)
    if: fresh = 0
        return: c.LMX_MSG_NOMEM
    if: fresh\id != 0U && lmx_msg_done_add(dest, fresh\from, fresh\id) != 0
        lmx_msg_copy_free(fresh)
        return: c.LMX_MSG_NOMEM
    lmx_msg_q_push(@ dest\inbox, @ dest\inbox_tail, fresh)
    c.lmx_msg_exec_ready(rt, dest\addr)
return: c.LMX_MSG_OK

fn: lmx_msg_pump (@: LmxMsgRuntime rt) int
    @: LmxMsgCopy n
    int: st
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
        if: c.lmx_msg_exec_holding_any(rt) = 0
            return: c.LMX_MSG_INVALID
        ---
    ---
    c.lmx_msg_exec_lock(rt)
    while: rt\transport != 0
        n: lmx_msg_q_pop(@ rt\transport, @ rt\transport_tail)
        st: lmx_msg_admit_one(rt, n)
        if: st = c.LMX_MSG_NOMEM
            c.lmx_msg_exec_unlock(rt)
            return: st
        ---
    ---
    c.lmx_msg_exec_unlock(rt)
return: c.LMX_MSG_OK

fn: lmx_msg_recv (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: LmxMsgEnv out) int
    @: LmxMsg m
    @: LmxMsgCopy n
    if: lmx_msg_require_turn(rt, who) != c.LMX_MSG_OK || out = 0
        return: c.LMX_MSG_INVALID
    c.lmx_msg_exec_lock(rt)
    m: lmx_msg_find(rt, who)
    if: m = 0
        c.lmx_msg_exec_unlock(rt)
        return: c.LMX_MSG_INVALID
    n: lmx_msg_q_pop(@ m\inbox, @ m\inbox_tail)
    if: n = 0
        c.lmx_msg_exec_unlock(rt)
        return: c.LMX_MSG_EMPTY
    out\id: n\id
    out\correlation: n\correlation
    out\reply_to: n\reply_to
    out\kind: n\kind
    out\number: n\number
    out\n: n\n
    out\bytes: n\bytes
    n\bytes: 0
    m\exec_id: n\id
    m\exec_corr: n\correlation
    m\exec_from: n\from
    m\exec_reply: n\reply_to
    m\exec_live: 1
    m\last_beat: rt\clock
    c.free((cast: (@: void) n))
    c.lmx_msg_exec_unlock(rt)
return: c.LMX_MSG_OK

sub: lmx_msg_env_release (@: LmxMsgEnv env)
    if: env = 0
        return
    if: env\bytes != 0
        c.free((cast: (@: void) env\bytes))
    ---
    env\bytes: 0
    env\n: 0U
end: lmx_msg_env_release

fn: lmx_msg_post_dead (@: LmxMsgRuntime rt; LmxMsgAddr: from; LmxMsgAddr: to; unsigned: correlation) int
    @: LmxMsgCopy node
    if: rt = 0 || to = 0U || to = from
        return: c.LMX_MSG_OK
    if: lmx_msg_find(rt, to) = 0
        return: c.LMX_MSG_GONE
    node: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: node = 0
        return: c.LMX_MSG_NOMEM
    node\from: from
    node\to: to
    node\kind: c.LMX_MSG_KIND_DEAD
    node\id: correlation
    node\correlation: correlation
    node\number: (cast: (int) from)
    lmx_msg_q_push(@ rt\transport, @ rt\transport_tail, node)
return: c.LMX_MSG_OK

fn: lmx_msg_fail (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    @: LmxMsgCopy n
    unsigned: parent
    unsigned: req
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    m: lmx_msg_find(rt, who)
    if: m = 0
        return: c.LMX_MSG_INVALID
    m\state: c.LMX_MSG_STATE_DEAD
    lmx_msg_copy_free(m\outbox)
    m\outbox: 0
    m\outbox_tail: 0
    parent: m\parent
    req: m\exec_id
    if: m\exec_live != 0 && m\exec_reply != 0U && m\exec_reply != parent
        if: lmx_msg_post_dead(rt, who, m\exec_reply, req) = c.LMX_MSG_NOMEM
            return: c.LMX_MSG_NOMEM
        ---
    ---
    n: m\inbox
    while: n != 0
        if: n\reply_to != 0U && n\reply_to != parent && (m\exec_live = 0 || n\reply_to != m\exec_reply)
            req: n\id
            if: lmx_msg_post_dead(rt, who, n\reply_to, req) = c.LMX_MSG_NOMEM
                return: c.LMX_MSG_NOMEM
            ---
        ---
        n: n\next
    lmx_msg_copy_free(m\inbox)
    m\inbox: 0
    m\inbox_tail: 0
    m\exec_live: 0
    if: parent != 0U
        if: lmx_msg_post_dead(rt, who, parent, m\exec_id) = c.LMX_MSG_NOMEM
            return: c.LMX_MSG_NOMEM
        ---
    ---
return: lmx_msg_pump(rt)

fn: lmx_msg_parent_gone (@: LmxMsgRuntime rt; @: LmxMsg child; unsigned: now; unsigned: threshold) int
    @: LmxMsg p
    unsigned: idle
    if: child = 0 || child\parent = 0U
        return: 0
    p: lmx_msg_find(rt, child\parent)
    if: p = 0
        return: 1
    if: p\state = c.LMX_MSG_STATE_DEAD || p\state = c.LMX_MSG_STATE_STOPPED || p\state = c.LMX_MSG_STATE_RELEASED
        return: 1
    if: p\exec_live != 0 && threshold != 0U
        idle: now
        if: now >= p\last_beat
            idle: now - p\last_beat
        ---
        if: idle > threshold
            return: 1
        ---
    ---
return: 0

fn: lmx_msg_poll (@: LmxMsgRuntime rt; LmxMsgAddr: who; unsigned: now; unsigned: threshold; @: LmxMsgAddr out; int: cap) int
    @: LmxMsg ch
    int: i 0
    int: n 0
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
        return: -1
    c.lmx_msg_exec_lock(rt)
    while: i < rt\n
        ch: rt\tab[i]
        if: ch\parent != 0U && (ch\state = c.LMX_MSG_STATE_RUNNING || (ch\state = c.LMX_MSG_STATE_INACTIVE && ch\committed != 0))
            if: who = 0U || ch\addr = who
                if: lmx_msg_parent_gone(rt, ch, now, threshold) != 0
                    ch\closing: 1
                    c.lmx_msg_exec_ready(rt, ch\addr)
                    if: out != 0 && n < cap
                        out[n]: ch\addr
                    ---
                    n: n + 1
                ---
            ---
        ---
        i: i + 1
    c.lmx_msg_exec_unlock(rt)
return: n

fn: lmx_msg_set_now (@: LmxMsgRuntime rt; unsigned: now) int
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    c.lmx_msg_exec_lock(rt)
    rt\clock: now
    c.lmx_msg_exec_unlock(rt)
return: c.LMX_MSG_OK

fn: lmx_msg_drive_should_close (@: LmxMsg m) int
    if: m = 0
        return: 0
    if: m\closing = 0 || m\exec_live != 0 || m\inbox != 0
        return: 0
    if: m\state = c.LMX_MSG_STATE_RUNNING
        return: 1
    if: m\state = c.LMX_MSG_STATE_INACTIVE && m\committed != 0
        return: 1
return: 0

fn: lmx_msg_drive (@: LmxMsgRuntime rt; unsigned: now; unsigned: threshold) int
    @: LmxMsg m
    @: LmxMsgAddr none
    int: i
    int: st
    unsigned: a
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    st: lmx_msg_set_now(rt, now)
    if: st != c.LMX_MSG_OK
        return: st
    none: 0
    st: lmx_msg_poll(rt, 0U, now, threshold, none, 0)
    if: st < 0
        return: c.LMX_MSG_INVALID
    ---
    c.lmx_msg_exec_lock(rt)
    i: 0
    while: i < rt\n
        m: rt\tab[i]
        a: 0U
        if: lmx_msg_drive_should_close(m) != 0
            a: m\addr
        ---
        i: i + 1
        if: a != 0U
            c.lmx_msg_exec_unlock(rt)
            if: c.lmx_msg_exec_is_bound(rt, a) != 0
                c.lmx_msg_exec_ready(rt, a)
            ---
            if: c.lmx_msg_exec_is_bound(rt, a) = 0
                st: c.lmx_msg_exec_unbound_close(rt, a)
                if: st != c.LMX_MSG_OK
                    return: st
                ---
            ---
            c.lmx_msg_exec_lock(rt)
        ---
    c.lmx_msg_exec_unlock(rt)
    st: lmx_msg_pump(rt)
    if: st != c.LMX_MSG_OK
        return: st
return: c.LMX_MSG_OK

fn: lmx_msg_state (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    int: s
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
        if: c.lmx_msg_exec_holding_turn(rt, who) = 0
            return: -1
        ---
    ---
    c.lmx_msg_exec_lock(rt)
    m: lmx_msg_find(rt, who)
    if: m = 0
        c.lmx_msg_exec_unlock(rt)
        return: -1
    s: m\state
    c.lmx_msg_exec_unlock(rt)
return: s

fn: lmx_msg_inbox_n (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    @: LmxMsgCopy n
    int: cnt 0
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
        if: c.lmx_msg_exec_holding_turn(rt, who) = 0
            return: -1
        ---
    ---
    c.lmx_msg_exec_lock(rt)
    m: lmx_msg_find(rt, who)
    if: m = 0
        c.lmx_msg_exec_unlock(rt)
        return: -1
    n: m\inbox
    while: n != 0
        cnt: cnt + 1
        n: n\next
    c.lmx_msg_exec_unlock(rt)
return: cnt

fn: lmx_msg_path_n (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK
        return: -1
    m: lmx_msg_find(rt, who)
    if: m = 0
        return: -1
return: m\path_n

fn: lmx_msg_path_seg (@: LmxMsgRuntime rt; LmxMsgAddr: who; int: i; @: unsigned out) int
    @: LmxMsg m
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK || out = 0 || i < 0
        return: c.LMX_MSG_INVALID
    m: lmx_msg_find(rt, who)
    if: m = 0 || i >= m\path_n
        return: c.LMX_MSG_INVALID
    out[0]: m\path[i]
return: c.LMX_MSG_OK

fn: lmx_msg_init_copy (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: LmxMsgEnv out) int
    @: LmxMsg m
    if: lmx_msg_require_owner(rt) != c.LMX_MSG_OK || out = 0
        return: c.LMX_MSG_INVALID
    m: lmx_msg_find(rt, who)
    if: m = 0
        return: c.LMX_MSG_INVALID
    out\id: 0U
    out\correlation: 0U
    out\reply_to: m\parent
    out\kind: c.LMX_MSG_KIND_BYTES
    out\number: 0
    out\n: m\init_n
    out\bytes: lmx_msg_copy_bytes(m\init, m\init_n)
    if: m\init_n != 0U && out\bytes = 0
        return: c.LMX_MSG_NOMEM
return: c.LMX_MSG_OK
