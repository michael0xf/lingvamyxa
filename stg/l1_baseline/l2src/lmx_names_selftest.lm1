predef: "l2src/lmx_names.lm1"
include: "<stdio.h>"

# Checks the identity contract 14.4 calls settled, and nothing beyond it:
# equal short names compare equal, distinct names cannot silently alias, and a
# node's name identity survives being carried to another node. Nothing here
# derives an id from text - that part 14.4 leaves open.

fn: main () int
    @: LmxNames names
    @: Lmx a
    @: Lmx b
    @: Lmx c
    @: LmxShortNameId got
    int: failures
    failures: 0

    names: (cast: (@: LmxNames) c.calloc(1U, c.sizeof(c.LmxNames)))
    a: (cast: (@: Lmx) c.calloc(1U, c.sizeof(c.Lmx)))
    b: (cast: (@: Lmx) c.calloc(1U, c.sizeof(c.Lmx)))
    c: (cast: (@: Lmx) c.calloc(1U, c.sizeof(c.Lmx)))
    got: (cast: (@: LmxShortNameId) c.calloc(1U, c.sizeof(c.LmxShortNameId)))
    if: names = 0 || a = 0 || b = 0 || c = 0 || got = 0
        c.printf("lmx: allocation failed\n")
        return: 1
    if: lmx_names_open(names, 4U) != 0
        c.printf("lmx: name table open failed\n")
        return: 1

    # A node that was never named is absent, and absence leaves the out
    # parameter alone rather than inventing a reserved id.
    got[0]: 4242U
    if: lmx_name_get(names, a, got) = 0
        c.printf("lmx: unnamed node reported a name\n")
        failures: failures + 1
    if: got[0] != 4242U
        c.printf("lmx: failed lookup wrote to the out parameter\n")
        failures: failures + 1

    if: lmx_name_set(names, a, 7U) != 0
        c.printf("lmx: naming a node failed\n")
        failures: failures + 1
    if: lmx_name_get(names, a, got) != 0
        c.printf("lmx: named node reported absent\n")
        failures: failures + 1
    if: got[0] != 7U
        c.printf("lmx: node did not keep its own name id\n")
        failures: failures + 1

    # Equal short names compare equal: two distinct nodes may carry one id, and
    # each still answers for itself.
    if: lmx_name_set(names, b, 7U) != 0
        c.printf("lmx: second node with the same id refused\n")
        failures: failures + 1
    if: lmx_name_get(names, b, got) != 0 || got[0] != 7U
        c.printf("lmx: shared id not readable from the second node\n")
        failures: failures + 1
    if: lmx_name_get(names, a, got) != 0 || got[0] != 7U
        c.printf("lmx: naming a second node disturbed the first\n")
        failures: failures + 1

    # Distinct names cannot silently alias: a different id on a third node
    # leaves the other two untouched.
    if: lmx_name_set(names, c, 9U) != 0
        c.printf("lmx: third node refused\n")
        failures: failures + 1
    if: lmx_name_get(names, c, got) != 0 || got[0] != 9U
        c.printf("lmx: third node lost its id\n")
        failures: failures + 1
    if: lmx_name_get(names, a, got) != 0 || got[0] != 7U
        c.printf("lmx: a distinct id aliased onto an earlier node\n")
        failures: failures + 1

    # Re-naming replaces, and does not accumulate.
    if: lmx_name_set(names, a, 11U) != 0
        c.printf("lmx: renaming failed\n")
        failures: failures + 1
    if: lmx_name_get(names, a, got) != 0 || got[0] != 11U
        c.printf("lmx: renaming did not take\n")
        failures: failures + 1
    if: names\count != 3U
        c.printf("lmx: renaming changed the entry count\n")
        failures: failures + 1

    # 19.29.4: entries for dead occurrences are removed, and removal must not
    # cut the probe chain of anything that collided past the freed slot.
    if: lmx_name_drop(names, b) != 0
        c.printf("lmx: dropping an entry failed\n")
        failures: failures + 1
    if: lmx_name_get(names, b, got) = 0
        c.printf("lmx: dropped node still reported a name\n")
        failures: failures + 1
    if: lmx_name_get(names, a, got) != 0 || got[0] != 11U
        c.printf("lmx: dropping one entry lost another\n")
        failures: failures + 1
    if: lmx_name_get(names, c, got) != 0 || got[0] != 9U
        c.printf("lmx: dropping one entry cut a probe chain\n")
        failures: failures + 1
    if: lmx_name_drop(names, b) = 0
        c.printf("lmx: dropping the same node twice succeeded\n")
        failures: failures + 1

    # The freed slot is reusable: a table that has seen drops must not refuse
    # while standing half empty.
    if: lmx_name_set(names, b, 13U) != 0
        c.printf("lmx: freed slot was not reused\n")
        failures: failures + 1
    if: lmx_name_get(names, b, got) != 0 || got[0] != 13U
        c.printf("lmx: reused slot lost its id\n")
        failures: failures + 1

    lmx_names_release(names)
    c.free(a)
    c.free(b)
    c.free(c)
    c.free(names)
    c.free(got)

    if: failures != 0
        c.printf("lmx names selftest FAILED checks=%d\n", failures)
        return: 1
    c.printf("lmx names selftest ok\n")
    return: 0
