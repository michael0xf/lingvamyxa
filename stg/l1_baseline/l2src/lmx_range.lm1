include: "l2src/lmx.h" "<stdio.h>" "<stdlib.h>" "<stddef.h>"

# Registered address ranges. Lingvamyxa_spec.txt 2, 6.5, 12.1.
#
# A field carries no type tag. `data` is a pointer, and its type is whichever
# registered range the pointer falls into. 6.5 states the classification is
# globally available and that this does not share any mutable cell between
# Messages, so the table itself is unit state, not Message state.
#
# The table is addressed as a base pointer plus an index, so every entry access
# stays a typed address. That is the form the spec prefers: 11.2 keeps minimal
# field-follow address-oriented, `value\field` being the direct form when the
# binding is a typed address, and reserves ANSI C value-member access for the
# explicit C door `c.value.field`. Ordinary values here are references, so the
# ordinary form applies and the C door is not needed.

@: LmxRange lmx_range_table 0
size_t: lmx_range_count 0U
size_t: lmx_range_capacity 0U

fn: lmx_ranges_init (size_t: capacity) int
    if: capacity = 0U
        return: 1
    if: lmx_range_table != 0
        return: 1
    lmx_range_table: (cast: (@: LmxRange) c.malloc(capacity * c.sizeof(lmx_range_table[0])))
    if: lmx_range_table = 0
        return: 1
    lmx_range_count: 0U
    lmx_range_capacity: capacity
return: 0

sub: lmx_ranges_release ()
    if: lmx_range_table != 0
        c.free(lmx_range_table)
    ---
    lmx_range_table: 0
    lmx_range_count: 0U
    lmx_range_capacity: 0U
end: lmx_ranges_release

fn: lmx_range_register (@: void lo; @: void hi; size_t: stride; int: kind; int: type) int
    @: LmxRange entry
    if: lmx_range_table = 0
        return: 1
    if: lmx_range_count >= lmx_range_capacity
        return: 1
    if: lo = 0
        return: 1
    if: hi <= lo
        return: 1
    if: stride = 0U
        return: 1
    entry: lmx_range_table + lmx_range_count
    entry\lo: lo
    entry\hi: hi
    entry\stride: stride
    entry\kind: kind
    entry\type: type
    lmx_range_count: lmx_range_count + 1U
return: 0

# Remove exactly one registered allocation before its storage is released.
# This prototype registry is owner-serialized, like registration; this adds no
# synchronization or cross-Message access. Preserve the order of other ranges.
fn: lmx_range_unregister (@: void lo; @: void hi) int
    @: LmxRange entry
    @: LmxRange next
    size_t: index
    if: lmx_range_table = 0 || lo = 0 || hi = 0
        return: 1
    index: 0U
    while: index < lmx_range_count
        entry: lmx_range_table + index
        if: entry\lo = lo && entry\hi = hi
            while: index + 1U < lmx_range_count
                next: entry + 1
                entry\lo: next\lo
                entry\hi: next\hi
                entry\stride: next\stride
                entry\kind: next\kind
                entry\type: next\type
                index: index + 1U
                entry: next
            ---
            entry\lo: 0
            entry\hi: 0
            entry\stride: 0U
            entry\kind: c.LMX_KIND_NONE
            entry\type: c.LMX_TYPE_NONE
            lmx_range_count: lmx_range_count - 1U
            return: 0
        index: index + 1U
    ---
return: 1

# The whole mechanism: no tag is read, only membership is tested. Two calls,
# because 2's table has two columns - how to read an entry, and which typed
# service array it came from. Both are answered by the address alone.
fn: lmx_classify (@: void p) int
    @: LmxRange entry
    size_t: index
    if: p = 0
        return: c.LMX_KIND_NONE
    index: 0U
    while: index < lmx_range_count
        entry: lmx_range_table + index
        if: p >= entry\lo && p < entry\hi
            return: entry\kind
        ---
        index: index + 1U
    ---
return: c.LMX_KIND_NONE

# 6.5: for every used Array type T there is a pool all_array_of_T. So two
# descriptors are told apart by which range they land in, not by anything held
# in either of them.
fn: lmx_type_of (@: void p) int
    @: LmxRange entry
    size_t: index
    if: p = 0
        return: c.LMX_TYPE_NONE
    index: 0U
    while: index < lmx_range_count
        entry: lmx_range_table + index
        if: p >= entry\lo && p < entry\hi
            return: entry\type
        ---
        index: index + 1U
    ---
return: c.LMX_TYPE_NONE

# Sets the two fields the spec has decided: node is the containment parent (2),
# data is the classified payload pointer (2, 6.5). len is zeroed as raw storage
# hygiene and nothing more: its unit is open (struct_refactoring_version_2.txt
# 14.2) and the encoding of an empty value is open with it (14.3). Writing 0 is
# not a claim that len counts children, elements or bytes, and not a claim that
# 0 denotes empty. Nothing in this unit reads len; see l2src\OPEN_POINTS.txt
# before the first read.
sub: lmx_cell_init (@: Lmx cell; @: Lmx parent; @: void data)
    if: cell != 0
        cell\node: parent
        cell\len: 0U
        cell\data: data
    ---
end: lmx_cell_init
