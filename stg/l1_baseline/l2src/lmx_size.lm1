predef: "l2src/lmx_branch.lm1"

# Mutable size_t cells. Spec 2: interned chars share an address by value;
# mutable primitives need their own registered domain. Each own size_t field
# gets one cell from this pool at construction; assignment stores through
# that cell (unique backing, no interned shared size_t, no int narrowing).

@: LmxPool lmx_size_pool 0

fn: lmx_size_init () int
    size_t: z 0U
    if: lmx_size_pool != 0
        return: 1
    lmx_size_pool: (cast: (@: LmxPool) c.calloc(1U, c.sizeof(c.LmxPool)))
    if: lmx_size_pool = 0
        return: 1
    if: lmx_pool_open(lmx_size_pool, c.sizeof(z), 16U, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_SIZE_T) != 0
        c.free(lmx_size_pool)
        lmx_size_pool: 0
        return: 1
return: 0

fn: lmx_size_take () @: void
    @: void cell
    @: size_t p
    if: lmx_size_pool = 0
        return: 0
    cell: lmx_pool_take(lmx_size_pool)
    if: cell = 0
        return: 0
    p: (cast: (@: size_t) cell)
    p[0]: 0U
return: cell

fn: lmx_size_value (@: void cell) size_t
    @: size_t p
    if: cell = 0
        return: 0U
    if: lmx_type_of(cell) != c.LMX_TYPE_SIZE_T
        return: 0U
    p: (cast: (@: size_t) cell)
return: p[0]

fn: lmx_size_store (@: void cell; size_t: v) int
    @: size_t p
    if: cell = 0
        return: 1
    if: lmx_type_of(cell) != c.LMX_TYPE_SIZE_T
        return: 1
    p: (cast: (@: size_t) cell)
    p[0]: v
return: 0
