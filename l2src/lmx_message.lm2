profile: runtime
predef: "l2src/lmx_msg_visit.h.lm1"
predef: "l2src/lmx_msg_liveness.h.lm1"
predef: "l2src/lmx_msg_blocks.h.lm1"
predef: "l2src/lmx_owned_ranges.h.lm1"
predef: "l2src/lmx_msg_storage.h.lm1"
predef: "l2src/lmx_message_graph_copy.h.lm1"
predef: "l2src/lmx_chars_owned.h.lm1"
include: "l2src/lmx_message.h" "l2src/lmx_message_host.h" "l2src/lmx_message_exec.h" "l2src/lmx.h" "<stdlib.h>" "<string.h>" "<limits.h>" "<stdint.h>"

# Clean-L2 source for l2src/lmx_message.lm1: the Message runtime core. Same
# ABI shapes, same behaviour, same refusals, in the oracle's order: the
# collector's mark and sweep over one Message's blocks; RETAIN roots; the
# copy-only mailbox (copy, queue); address lookup in the tree of families;
# executor readiness (scan, ready, drop-stale); duplicate-delivery
# records; runtime lifetime and the host ingress queue; path assignment and
# Message creation (with or without a graph); send, stop, end_turn, admission,
# pump, recv; failure and dead notices; the poll/drive parent-gone sweep;
# the query surface; the liveness protocol; the
# executor's completion and endpoint queries; and send_cap.
#
# Library unit: no entry. Bootstrap shape is REDIRECT: create, find,
# runtime_new, runtime_delete and graph are the unit's own open path, so the
# methods carry the unit names (lmx_ prefix dropped), the native module stays
# in the link, and the runner redirects the selftest's call sites with -D.
#
# profile: runtime (LEAD_REVIEW decision 14, translator 73e01271): this unit
# is the executor's own core, called by the executor during an unwind, so no
# escape poll is emitted in its methods; the checkpoint diagnostics stay.
# running=0 inside a turn means a stop request; complete sets only success.
#
# Spelling differences from the oracle, none behavioural:
# - Internal calls target the unit's own methods, including the oracle's
#   eight self-calls of lmx_msg_exec_ready and four of lmx_msg_exec_ready_msg
#   through c. (S2 moved end_turn's four child calls to the record form).
# - LMX functions of the predef'd modules (visit, liveness, blocks, ranges,
#   path storage, graph copy install, chars) are called by their own names;
#   C functions of exec.c / host.c and the test hooks go through c.; C
#   constants and types go through c.. Namespace rule of 2026-09-14.
# - LmxMsgAddr formals are spelled as written (admitted since 642b6700, Stage
#   B step 2b; before it l2trans refused a typedef'd by-value formal). Locals
#   holding addresses are unsigned, exactly as the oracle spells them; no
#   LmxMsgAddr local exists in either file, so no runtime header needs to
#   declare the type to L1.
# - The oracle's locals and formals called "node" are called "entry" or
#   "elem": that name is the reserved argument of every callable (SPEC 21.2).

fn: msg_mark_array (@: LmxMsg m; @: LmxArrayDesc desc; @: LmxVisit seen) int
    @: LmxOwnedRange rg
    @@: Lmx nodes 0
    @@: LmxArrayDesc descs 0
    @@: LmxMethod methods 0
    @: Lmx elem
    @: LmxArrayDesc inner
    @: LmxMethod rec
    size_t: i 0U
    if: m = 0 || desc = 0 || seen = 0 || seen\oom != 0
        return: 0
    if: lmx_msg_visit_has_ptr(seen, desc) != 0
        return: 0
    lmx_msg_visit_add_ptr(seen, desc)
    if: seen\oom != 0
        return: 0
    if: desc\data != 0
        lmx_msg_visit_add_ptr(seen, desc\data)
        if: seen\oom != 0
            return: 0
        ---
    ---
    rg: lmx_owned_ranges_find(m\ranges, desc)
    if: rg = 0 || desc\data = 0
        return: 0
    if: rg\type = c.LMX_TYPE_ARRAY_OF_LMX
        nodes: (cast: (@@: Lmx) desc\data)
        while: i < desc\len
            elem: nodes[i]
            if: elem != 0
                msg_mark_from(m, elem, seen)
            ---
            i: i + 1U
        ---
    ---
    if: rg\type = c.LMX_TYPE_ARRAY_OF_DESC
        descs: (cast: (@@: LmxArrayDesc) desc\data)
        while: i < desc\len
            inner: descs[i]
            if: inner != 0
                msg_mark_array(m, inner, seen)
            ---
            i: i + 1U
        ---
    ---
    if: rg\type = c.LMX_TYPE_ARRAY_OF_METHOD
        methods: (cast: (@@: LmxMethod) desc\data)
        while: i < desc\len
            rec: methods[i]
            if: rec != 0
                lmx_msg_visit_add_ptr(seen, rec)
            ---
            i: i + 1U
        ---
    ---
    return: 0
end: msg_mark_array

fn: msg_mark_child_value (@: LmxMsg m; @: void p; @: LmxVisit seen) int
    @: LmxOwnedRange rg
    if: m = 0 || p = 0 || seen = 0 || seen\oom != 0
        return: 0
    rg: lmx_owned_ranges_find(m\ranges, p)
    if: rg = 0
        lmx_msg_visit_add_ptr(seen, p)
        return: 0
    ---
    if: rg\kind = c.LMX_KIND_STRUCT
        msg_mark_from(m, (cast: (@: Lmx) p), seen)
        return: 0
    ---
    if: rg\kind = c.LMX_KIND_ARRAY
        msg_mark_array(m, (cast: (@: LmxArrayDesc) p), seen)
        return: 0
    ---
    lmx_msg_visit_add_ptr(seen, p)
    return: 0
end: msg_mark_child_value

# A RETAIN root may be the CHILDREN allocation itself rather than its owning
# Structure. The range is the only complete shape available in that case, so
# traverse every registered slot in the half-open range. This preserves all
# referents exactly as rooting the owning Structure would, without recovering
# a header by pointer arithmetic or imposing a slot-count limit.
fn: msg_mark_children_range (@: LmxMsg m; @: LmxOwnedRange rg; @: LmxVisit seen) int
    @@: void slots 0
    size_t: bytes
    size_t: count
    size_t: i 0U
    if: m = 0 || rg = 0 || seen = 0 || seen\oom != 0
        return: 0
    if: rg\kind != c.LMX_KIND_CHILDREN || rg\lo = 0 || rg\hi = 0 || rg\stride != c.sizeof(@: void)
        return: 0
    if: (cast: (uintptr_t) rg\hi) <= (cast: (uintptr_t) rg\lo)
        return: 0
    bytes: (cast: (size_t) ((cast: (uintptr_t) rg\hi) - (cast: (uintptr_t) rg\lo)))
    if: bytes % rg\stride != 0U
        return: 0
    count: bytes / rg\stride
    slots: (cast: (@@: void) rg\lo)
    while: i < count && seen\oom = 0
        msg_mark_child_value(m, slots[i], seen)
        i: i + 1U
    ---
    return: 0
end: msg_mark_children_range

fn: msg_mark_from (@: LmxMsg m; @: Lmx x; @: LmxVisit seen) int
    @: LmxOwnedRange rg
    @@: void slots 0
    @: void child
    size_t: i 0U
    if: m = 0 || x = 0 || seen = 0 || seen\oom != 0
        return: 0
    if: lmx_msg_visit_has(seen, x) != 0
        return: 0
    lmx_msg_visit_add(seen, x)
    if: seen\oom != 0
        return: 0
    if: x\node != 0
        msg_mark_child_value(m, (cast: (@: void) x\node), seen)
    ---
    if: x\data = 0
        return: 0
    lmx_msg_visit_add_ptr(seen, x\data)
    if: seen\oom != 0
        return: 0
    rg: lmx_owned_ranges_find(m\ranges, x\data)
    if: rg != 0 && rg\kind = c.LMX_KIND_CHILDREN && x\len > 0
        slots: (cast: (@@: void) x\data)
        while: i < x\len
            child: slots[i]
            msg_mark_child_value(m, child, seen)
            i: i + 1U
        ---
    ---
    if: rg != 0 && rg\kind = c.LMX_KIND_ARRAY
        msg_mark_array(m, (cast: (@: LmxArrayDesc) x\data), seen)
    ---
    if: rg != 0 && rg\kind = c.LMX_KIND_METHOD
        lmx_msg_visit_add_ptr(seen, x\data)
    ---
    return: 0
end: msg_mark_from

# Eternal branches and shared METHOD records are roots for their owning
# Message even when they are not reachable from the current graph. Imported
# classifier entries may name foreign storage; recording those addresses is
# harmless because collection only compares them with this Message's blocks.
fn: msg_mark_classifier (@: LmxOwnedRange ranges; @: LmxVisit seen) int
    @: LmxOwnedRange r ranges
    if: seen = 0 || seen\oom != 0
        return: 0
    while: r != 0 && seen\oom = 0
        if: r\lo != 0
            lmx_msg_visit_add_ptr(seen, r\lo)
        ---
        r: r\next
    ---
    return: 0
end: msg_mark_classifier

fn: msg_mark_roots (@: LmxMsg m; @: LmxVisit seen) int
    @: LmxMsgRoot r
    @: LmxOwnedRange rg
    if: m = 0 || seen = 0 || seen\oom != 0
        return: 0
    r: m\roots
    while: r != 0
        if: r\p != 0
            rg: lmx_owned_ranges_find(m\ranges, r\p)
            if: rg != 0 && rg\kind = c.LMX_KIND_ARRAY
                msg_mark_array(m, (cast: (@: LmxArrayDesc) r\p), seen)
            ---
            if: rg != 0 && rg\kind = c.LMX_KIND_STRUCT
                msg_mark_from(m, (cast: (@: Lmx) r\p), seen)
            ---
            if: rg != 0 && (rg\kind = c.LMX_KIND_PRIMITIVE || rg\kind = c.LMX_KIND_METHOD)
                lmx_msg_visit_add_ptr(seen, r\p)
            ---
            if: rg != 0 && rg\kind = c.LMX_KIND_CHILDREN
                lmx_msg_visit_add_ptr(seen, r\p)
                if: seen\oom = 0
                    msg_mark_children_range(m, rg, seen)
                ---
            ---
        ---
        r: r\next
    ---
    return: 0
end: msg_mark_roots

fn: msg_seen_holds_block (@: LmxVisit seen; @: LmxMsgBlock b) int
    size_t: i 0U
    @: Lmx x
    if: seen = 0 || b = 0 || seen\oom != 0 || seen\n > seen\cap || seen\pn > seen\pcap
        return: 1
    if: (seen\n != 0U && seen\v = 0) || (seen\pn != 0U && seen\p = 0)
        return: 1
    while: i < seen\n
        x: seen\v[i]
        if: x = 0
            return: 1
        if: lmx_msg_ptr_in_block(x, b) != 0
            return: 1
        if: lmx_msg_ptr_in_block(x\data, b) != 0
            return: 1
        if: lmx_msg_ptr_in_block(x\node, b) != 0
            return: 1
        i: i + 1U
    ---
    i: 0U
    while: i < seen\pn
        if: lmx_msg_ptr_in_block(seen\p[i], b) != 0
            return: 1
        i: i + 1U
    ---
    return: 0
end: msg_seen_holds_block

fn: msg_root_attach (@: LmxMsg m; @: void p) int
    @: LmxOwnedRange rg
    @: LmxMsgRoot n
    @: LmxMsgRoot cur
    if: m = 0 || p = 0
        return: c.LMX_MSG_INVALID
    rg: lmx_owned_ranges_find(m\ranges, p)
    if: rg = 0 || (rg\kind != c.LMX_KIND_PRIMITIVE && rg\kind != c.LMX_KIND_METHOD && rg\kind != c.LMX_KIND_ARRAY && rg\kind != c.LMX_KIND_CHILDREN && rg\kind != c.LMX_KIND_STRUCT)
        return: c.LMX_MSG_INVALID
    cur: m\roots
    while: cur != 0
        if: cur\p = p
            if: (cur\roles & c.LMX_MSG_ROOT_RETAIN) != 0U
                return: c.LMX_MSG_DUPLICATE
            ---
            cur\roles: cur\roles | c.LMX_MSG_ROOT_RETAIN
            return: c.LMX_MSG_OK
        ---
        cur: cur\next
    ---
    if: c.lmx_msg_test_root_alloc_should_fail() != 0
        return: c.LMX_MSG_NOMEM
    ---
    n: (cast: (@: LmxMsgRoot) c.malloc(c.sizeof(c.LmxMsgRoot)))
    if: n = 0
        return: c.LMX_MSG_NOMEM
    n\p: p
    n\roles: c.LMX_MSG_ROOT_RETAIN
    n\next: m\roots
    m\roots: n
    return: c.LMX_MSG_OK
end: msg_root_attach

fn: msg_root_release (@: LmxMsg m; @: void p) int
    @: LmxMsgRoot cur
    @: LmxMsgRoot prev 0
    if: m = 0 || p = 0
        return: c.LMX_MSG_INVALID
    cur: m\roots
    while: cur != 0
        if: cur\p = p
            if: (cur\roles & c.LMX_MSG_ROOT_RETAIN) = 0U
                return: c.LMX_MSG_INVALID
            ---
            cur\roles: cur\roles - c.LMX_MSG_ROOT_RETAIN
            if: cur\roles = 0U
                if: prev != 0
                    prev\next: cur\next
                ---
                if: prev = 0
                    m\roots: cur\next
                ---
                c.free((cast: (@: void) cur))
            ---
            return: c.LMX_MSG_OK
        ---
        prev: cur
        cur: cur\next
    ---
    return: c.LMX_MSG_INVALID
end: msg_root_release

fn: msg_collect_block (@: LmxMsg m; @: LmxMsgBlock b) int
    @: LmxOwnedRange r
    @: LmxOwnedRange rn
    @: LmxMsgBlock tmp 0
    if: m = 0 || b = 0
        return: 0
    r: m\ranges
    while: r != 0
        rn: r\next
        if: lmx_msg_ptr_in_block(r\lo, b) != 0
            lmx_owned_ranges_remove(@ m\ranges, r)
        ---
        r: rn
    ---
    if: lmx_msg_blocks_remove(@ m\blocks, b) = c.LMX_MSG_BLOCKS_OK
        tmp: 0
        if: lmx_msg_blocks_push(@ tmp, b) = c.LMX_MSG_BLOCKS_OK
            lmx_msg_blocks_dispose_all(@ tmp)
        ---
    ---
    return: 0
end: msg_collect_block

fn: msg_arena_collect (@: LmxMsg m) int
    LmxVisit: seen
    @: LmxVisit sp
    @: LmxMsgBlock b
    @: LmxMsgBlock nxt
    if: m = 0
        return: 0
    sp: @ seen
    lmx_msg_visit_init(sp)
    if: m\graph != 0
        # A graph root is an address-classified value. Failure transport may
        # carry a primitive-only graph, so do not dereference it as Structure
        # before classification.
        msg_mark_child_value(m, (cast: (@: void) m\graph), sp)
        if: sp\oom != 0
            lmx_msg_visit_dispose(sp)
            return: 0
        ---
    ---
    msg_mark_roots(m, sp)
    if: sp\oom != 0
        lmx_msg_visit_dispose(sp)
        return: 0
    ---
    msg_mark_classifier(m\eternal_ranges, sp)
    msg_mark_classifier(m\method_ranges, sp)
    if: sp\oom != 0
        lmx_msg_visit_dispose(sp)
        return: 0
    ---
    b: m\blocks
    while: b != 0
        nxt: b\next
        if: lmx_msg_block_has_range(m\ranges, b) != 0
            # The completed mark contains graph, explicit roots and the two
            # classifier root sets. Its result is therefore authoritative even
            # when graph = 0 and there are no ordinary roots.
            if: msg_seen_holds_block(sp, b) = 0
                msg_collect_block(m, b)
            ---
        ---
        b: nxt
    ---
    lmx_msg_visit_dispose(sp)
    return: 0
end: msg_arena_collect

# Copy-only Message mailbox. Spec 19.29.7.1.
# Send stages a transport-owned copy. Admission enqueues a fresh copy on the
# recipient inbox. Handler materialization is recv at turn entry.

fn: msg_copy_bytes (const: @(uchar src); size_t: n) @: uchar
    @: uchar p
    if: n = 0U
        return: 0
    if: src = 0
        return: 0
    if: c.lmx_msg_test_copy_should_fail() != 0
        return: 0
    p: (cast: (@: uchar) c.malloc(n))
    if: p = 0
        return: 0
    c.memcpy(p, src, n)
    return: p
end: msg_copy_bytes

# O1 (lock removal, 2026-09-15): an allocation in the turn Message's own arena,
# reached without a runtime handle. The arena is the Message's blocks list (spec
# 19.29.2): one zeroed block pushed onto it, written on the Message's own lane.
# 0 outside any turn; on refusal nothing is pushed. Freed with the arena: the
# slot's free at its release, or its parent's settle write when adopted.
fn: msg_turn_new_zero (size_t: size) @: void
    @: LmxMsg m
    @: LmxMsgBlock b
    @: void p
    m: c.lmx_msg_turn_current()
    if: m = 0 || size = 0U
        return: 0
    b: (cast: (@: LmxMsgBlock) c.calloc(1U, c.sizeof(c.LmxMsgBlock)))
    if: b = 0
        return: 0
    p: c.calloc(1U, size)
    if: p = 0
        c.free((cast: (@: void) b))
        return: 0
    b\base: p
    b\n: size
    if: lmx_msg_blocks_push(@ m\blocks, b) != c.LMX_MSG_BLOCKS_OK
        c.free(p)
        c.free((cast: (@: void) b))
        return: 0
    return: p
end: msg_turn_new_zero

fn: msg_turn_copy_bytes (const: @(char source); size_t: length) @: char
    @: char copy
    if: length = (cast: (size_t) -1)
        return: 0
    copy: (cast: (@: char) msg_turn_new_zero(length + 1U))
    if: copy = 0
        return: 0
    if: source != 0 && length > 0U
        c.memcpy(copy, source, length)
    return: copy
end: msg_turn_copy_bytes

# Ordinary delivery (SPEC 19.29.7, model §23/§27, decision 15): the delivered
# Message is created by the copier in its own arena, one copy by the same
# traversal as create, and moves from the sender's outbox through the
# transport into the recipient's inbox without a second clone. It has no turn
# and no mailbox of its own: a Message, not an L3 Thread.
# Frees a delivery that never reached its handler (a failed sending turn, a
# dropped admission). Range records live inside the blocks.
sub: msg_delivery_dispose (@: LmxMsg d)
    if: d = 0
        return
    lmx_msg_blocks_dispose_all(@ d\blocks)
    d\ranges: 0
    d\graph: 0
    c.free((cast: (@: void) d))
end: msg_delivery_dispose

fn: msg_delivery_new (@: Lmx graph; @: LmxOwnedRange src_ranges; @: LmxOwnedRange eternal_ranges; @: LmxOwnedRange method_ranges) @: LmxMsg
    @: LmxMsg d
    @: char chars
    if: graph = 0 || src_ranges = 0
        return: 0
    d: (cast: (@: LmxMsg) c.calloc(1U, c.sizeof(c.LmxMsg)))
    if: d = 0
        return: 0
    chars: lmx_chars_new_owned(@ d\blocks, @ d\ranges)
    if: chars = 0
        msg_delivery_dispose(d)
        return: 0
    if: lmx_msg_graph_copy_install(d, graph, src_ranges, eternal_ranges, method_ranges, chars) != c.LMX_MSG_OK
        msg_delivery_dispose(d)
        return: 0
    d\state: c.LMX_MSG_STATE_INACTIVE
    c.lmx_msg_running_store(d, 1)
    c.lmx_msg_success_store(d, 0)
    return: d
end: msg_delivery_new

# Recv-side materialization of a delivery: its blocks and ranges join the
# handler's one arena at their addresses; nothing is relocated or rewritten.
fn: msg_delivery_receive (@: LmxMsg m; @: LmxMsgCopy entry; @: LmxMsgEnv out) int
    @: LmxMsg d
    if: m = 0 || entry = 0 || out = 0
        return: c.LMX_MSG_INVALID
    d: entry\delivered
    if: d = 0
        return: c.LMX_MSG_OK
    if: lmx_msg_storage_can_move(@ m\blocks, @ m\ranges, @ d\blocks, @ d\ranges) != c.LMX_MSG_STORAGE_OK
        return: c.LMX_MSG_INVALID
    if: lmx_msg_storage_move_all(@ m\blocks, @ m\ranges, @ d\blocks, @ d\ranges) != c.LMX_MSG_STORAGE_OK
        return: c.LMX_MSG_INVALID
    out\graph: d\graph
    d\graph: 0
    entry\delivered: 0
    msg_delivery_dispose(d)
    return: c.LMX_MSG_OK
end: msg_delivery_receive

sub: msg_copy_free (@: LmxMsgCopy entry)
    @: LmxMsgCopy next
    while: entry != 0
        next: entry\next
        if: entry\bytes != 0
            c.free((cast: (@: void) entry\bytes))
        ---
        if: entry\delivered != 0
            msg_delivery_dispose(entry\delivered)
            entry\delivered: 0
        ---
        # S6-2: the carried destination is a handle, not a hold -- nothing to
        # release, because nothing was counted when it was taken.
        entry\dest_msg: 0
        c.free((cast: (@: void) entry))
        entry: next
    ---
end: msg_copy_free

fn: msg_copy_dup (const: @(LmxMsgCopy src)) @: LmxMsgCopy
    @: LmxMsgCopy n
    if: src = 0
        return: 0
    # A delivered Message is moved, never duplicated (SPEC 19.29.7).
    if: src\delivered != 0
        return: 0
    n: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: n = 0
        return: 0
    n\id: src\id
    n\correlation: src\correlation
    n\reply_to: src\reply_to
    n\from: src\from
    n\to: src\to
    n\kind: src\kind
    n\number: src\number
    n\n: src\n
    n\next: 0
    n\bytes: msg_copy_bytes(src\bytes, src\n)
    if: src\n != 0U && n\bytes = 0
        c.free((cast: (@: void) n))
        return: 0
    # S6-2: the copy carries the same handle. No count is taken, so a duplication
    # can no longer fail for want of one.
    n\dest_msg: src\dest_msg
    return: n
end: msg_copy_dup

sub: msg_q_push (@@: LmxMsgCopy head; @@: LmxMsgCopy tail; @: LmxMsgCopy entry)
    @: LmxMsgCopy current_tail
    if: entry = 0
        return
    entry\next: 0
    if: \head = 0
        \head: entry
        \tail: entry
        return
    current_tail: \tail
    current_tail\next: entry
    \tail: entry
end: msg_q_push

fn: msg_q_pop (@@: LmxMsgCopy head; @@: LmxMsgCopy tail) @: LmxMsgCopy
    @: LmxMsgCopy n
    n: \head
    if: n = 0
        return: 0
    \head: n\next
    if: \head = 0
        \tail: 0
    ---
    n\next: 0
    return: n
end: msg_q_pop

fn: msg_find_tree (@: LmxMsg m; LmxMsgAddr: addr) @: LmxMsg
    @: LmxMsg ch
    @: LmxMsg f
    if: m = 0 || addr = 0U
        return: 0
    if: m\addr = addr && m\state != c.LMX_MSG_STATE_RELEASED
        return: m
    ch: m\first_child
    while: ch != 0
        f: msg_find_tree(ch, addr)
        if: f != 0
            return: f
        ch: ch\next_sibling
    ---
    return: 0
end: msg_find_tree

# S5: R0 is the one root, so the lookup is R0's tree.
fn: msg_find (@: LmxMsgRuntime rt; LmxMsgAddr: addr) @: LmxMsg
    if: rt = 0 || addr = 0U
        return: 0
    return: msg_find_tree(rt\root, addr)
end: msg_find

fn: msg_dest_from_src (@: LmxMsg src; LmxMsgAddr: to; @: LmxMsgRuntime rt) @: LmxMsg
    @: LmxMsg d
    if: to = 0U
        return: 0
    if: src != 0
        d: msg_find_tree(src, to)
        if: d != 0
            return: d
        ---
        if: src\parent_msg != 0 && src\parent_msg\addr = to && src\parent_msg\state != c.LMX_MSG_STATE_RELEASED
            return: src\parent_msg
        ---
    ---
    return: msg_find(rt, to)
end: msg_dest_from_src

fn: msg_self_or_find (@: LmxMsgRuntime rt; LmxMsgAddr: addr) @: LmxMsg
    @: LmxMsg m
    m: c.lmx_msg_turn_self(rt)
    if: m != 0 && m\addr = addr && m\state != c.LMX_MSG_STATE_RELEASED
        return: m
    ---
    return: msg_find(rt, addr)
end: msg_self_or_find

fn: msg_turn_slot (@: LmxMsgRuntime rt; LmxMsgAddr: who) @: LmxMsg
    @: LmxMsg m
    if: rt = 0 || who = 0U
        return: 0
    m: c.lmx_msg_turn_self(rt)
    if: m != 0 && m\addr = who && m\state != c.LMX_MSG_STATE_RELEASED
        return: m
    ---
    return: 0
end: msg_turn_slot

sub: msg_child_link (@: LmxMsg parent; @: LmxMsg child)
    if: parent = 0 || child = 0
        return
    child\parent_msg: parent
    child\next_sibling: 0
    if: parent\first_child = 0
        parent\first_child: child
        parent\last_child: child
        return
    parent\last_child\next_sibling: child
    parent\last_child: child
end: msg_child_link

# AD (c): LmxMsg.parent, the parent's id, is retired as a duplicate of parent_msg
# (every reparenting site wrote both in lockstep). A reader that wants the id reads
# it from the record parent_msg names; 0 when there is none (R0).
fn: msg_parent_id (@: LmxMsg m) LmxMsgAddr
    if: m = 0 || m\parent_msg = 0
        return: 0U
    ---
    return: m\parent_msg\addr
end: msg_parent_id

fn: msg_child_chain_remove (@: LmxMsg parent; @: LmxMsg child) int
    @: LmxMsg p
    @: LmxMsg n
    p: 0
    n: parent\first_child
    while: n != 0
        if: n = child
            if: p = 0
                parent\first_child: child\next_sibling
            ---
            if: p != 0
                p\next_sibling: child\next_sibling
            ---
            if: parent\last_child = child
                parent\last_child: p
            ---
            child\next_sibling: 0
            return: 1
        ---
        p: n
        n: n\next_sibling
    ---
    return: 0
end: msg_child_chain_remove

fn: msg_child_unlink (@: LmxMsg parent; @: LmxMsg child) int
    if: parent = 0 || child = 0
        return: c.LMX_MSG_OK
    # Stage 3b-8: a bound child cannot leave its family; unbind it first.
    if: c.lmx_msg_exec_msg_bound(child) != 0
        return: c.LMX_MSG_INVALID
    # S6-2, SPEC 19.29.7: parent_msg is the owner cell, so the unlink takes the
    # child out of the chain and leaves the cell naming the parent whose storage
    # the child is now part of. A late sender reaching a settled record follows it
    # to the owner and is refused on that lane. The two callers that move a child
    # to a NEW owner (handoff_supervision, orphan_children) do not come through
    # here: each calls child_chain_remove and then child_link, which writes the
    # cell itself.
    msg_child_chain_remove(parent, child)
    return: c.LMX_MSG_OK
end: msg_child_unlink

# Decision 17 rule 4 (Mikhail, 2026-09-14): a running Message survives its
# parent's closing only by a handoff of supervision to another live parent.
# The child keeps its arena, mailbox, turn, record and its ready flag (decision
# 18). Its parent link (parent_msg; the separate parent id was retired in AD (c)),
# its index at the parent and its liveness window move to the new parent. Addresses are the bootstrap's capabilities: "the new
# parent is live in the same runtime" is the check until 19.28.R2.
fn: msg_handoff_supervision (@: LmxMsgRuntime rt; LmxMsgAddr: old_parent; LmxMsgAddr: child; LmxMsgAddr: new_parent) int
    @: LmxMsg p
    @: LmxMsg ch
    @: LmxMsg q
    @: LmxMsg a
    if: rt = 0 || old_parent = 0U || child = 0U || new_parent = 0U
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_exec_holding_turn(rt, old_parent) = 0
        if: c.lmx_msg_host_is_owner(rt) = 0 || c.lmx_msg_exec_holding_any(rt) != 0
            return: c.LMX_MSG_INVALID
        ---
    ---
    p: msg_self_or_find(rt, old_parent)
    ch: msg_self_or_find(rt, child)
    q: msg_self_or_find(rt, new_parent)
    # A root has no parent to hand over from: its only new parent would be the
    # World Wide Mix ancestor, a stub until stage 5.
    if: ch != 0 && ch\parent_msg = 0
        return: c.LMX_MSG_INVALID
    if: p = 0 || ch = 0 || q = 0 || ch\parent_msg != p || q = p || q = ch
        return: c.LMX_MSG_INVALID
    if: q\state = c.LMX_MSG_STATE_STOPPED || q\state = c.LMX_MSG_STATE_DEAD || q\state = c.LMX_MSG_STATE_RELEASED || q\closing != 0 || q\disposed != 0
        return: c.LMX_MSG_INVALID
    # The new parent inside the child's subtree would cut the family off rt->root.
    a: q\parent_msg
    while: a != 0
        if: a = ch
            return: c.LMX_MSG_INVALID
        ---
        a: a\parent_msg
    ---
    if: q\child_seq + 1U = 0U
        return: c.LMX_MSG_NOMEM
    ---
    msg_child_chain_remove(p, ch)
    msg_child_link(q, ch)
    # S6-2 (SPEC 19.29.7): "when a Message changes parent its address changes,
    # composed from the parent's address and its index" -- the index is minted by
    # the new parent exactly as at creation, so it never collides with a sibling
    # there; every descendant's address follows by the walk, with nothing stored.
    q\child_seq: q\child_seq + 1U
    ch\index: q\child_seq
    ch\child_heard_at: c.lmx_msg_now(rt)
    ch\live_query_id: 0U
    ch\live_query_pend_id: 0U
    return: c.LMX_MSG_OK
end: msg_handoff_supervision

# S2: the record form. A caller that holds the Message (end_turn's walk over
# its own children) passes it; nothing resolves an address.
fn: msg_exec_is_runnable_msg_locked (@: LmxMsg m) int
    if: m = 0
        return: 0
    if: m\state = c.LMX_MSG_STATE_STOPPED || m\state = c.LMX_MSG_STATE_DEAD || m\state = c.LMX_MSG_STATE_RELEASED
        return: 0
    if: c.lmx_msg_mail_inbox_has_input(m) != 0
        return: 1
    ---
    if: m\closing != 0 && m\state != c.LMX_MSG_STATE_STOPPED
        return: 1
    ---
    return: 0
end: msg_exec_is_runnable_msg_locked

fn: msg_exec_is_runnable_locked (@: LmxMsgRuntime rt; LmxMsgAddr: addr) int
    if: rt = 0 || addr = 0U
        return: 0
    return: msg_exec_is_runnable_msg_locked(msg_self_or_find(rt, addr))
end: msg_exec_is_runnable_locked

fn: msg_exec_is_runnable_msg (@: LmxMsgRuntime rt; @: LmxMsg m) int
    int: r
    if: rt = 0 || m = 0
        return: 0
    r: msg_exec_is_runnable_msg_locked(m)
    return: r
end: msg_exec_is_runnable_msg

fn: msg_exec_is_runnable (@: LmxMsgRuntime rt; LmxMsgAddr: addr) int
    int: r
    if: rt = 0 || addr = 0U
        return: 0
    r: msg_exec_is_runnable_locked(rt, addr)
    return: r
end: msg_exec_is_runnable

# Decision 18 (2026-09-14): readiness is the Message's own control flag
# (class 3), set here by its designated writers: the sender at admission, the
# closing requester, the bind kick. The lane that takes the Message's turn
# clears it. Nothing is appended to a parent's cells.
sub: msg_exec_ready (@: LmxMsgRuntime rt; LmxMsgAddr: addr)
    @: LmxMsg m
    if: rt = 0 || addr = 0U
        return
    m: msg_self_or_find(rt, addr)
    if: m = 0
        return
    ---
    m\ready: 1
    # S3 (no wake): admission into the mailbox is all; the owner looks into it in its own round.
end: msg_exec_ready

# S2: the record form of exec_ready, for a caller that holds the Message.
sub: msg_exec_ready_msg (@: LmxMsgRuntime rt; @: LmxMsg m)
    if: rt = 0 || m = 0
        return
    m\ready: 1
end: msg_exec_ready_msg

fn: msg_done_has (@: LmxMsg m; LmxMsgAddr: from; unsigned: id) int
    int: i 0
    if: m = 0
        return: 0
    while: i < m\done_n
        if: m\done_from[i] = from && m\done_id[i] = id
            return: 1
        i: i + 1
    return: 0
end: msg_done_has

fn: msg_done_grow (@: LmxMsg m) int
    @: unsigned next_from
    @: unsigned next_id
    int: next_cap 8
    size_t: bytes
    if: m = 0 || m\done_n < 0 || m\done_cap < 0 || m\done_n > m\done_cap
        return: 1
    if: m\done_n < m\done_cap
        return: 0
    if: m\done_cap != 0
        if: m\done_cap > c.INT_MAX / 2
            return: 1
        next_cap: m\done_cap * 2
    ---
    if: (cast: (size_t) next_cap) > ((cast: (size_t) -1) / c.sizeof(unsigned))
        return: 1
    bytes: (cast: (size_t) next_cap) * c.sizeof(unsigned)
    next_from: (cast: (@: unsigned) c.malloc(bytes))
    if: next_from = 0
        return: 1
    next_id: (cast: (@: unsigned) c.malloc(bytes))
    if: next_id = 0
        c.free((cast: (@: void) next_from))
        return: 1
    if: m\done_n != 0
        c.memcpy((cast: (@: void) next_from), (cast: (@: void) m\done_from), (cast: (size_t) m\done_n) * c.sizeof(unsigned))
        c.memcpy((cast: (@: void) next_id), (cast: (@: void) m\done_id), (cast: (size_t) m\done_n) * c.sizeof(unsigned))
    ---
    c.free((cast: (@: void) m\done_from))
    c.free((cast: (@: void) m\done_id))
    m\done_from: next_from
    m\done_id: next_id
    m\done_cap: next_cap
    return: 0
end: msg_done_grow

fn: msg_done_add (@: LmxMsg m; LmxMsgAddr: from; unsigned: id) int
    if: m = 0
        return: 1
    if: msg_done_has(m, from, id) != 0
        return: 0
    if: msg_done_grow(m) != 0
        return: 1
    m\done_from[m\done_n]: from
    m\done_id[m\done_n]: id
    m\done_n: m\done_n + 1
    return: 0
end: msg_done_add

fn: msg_require_owner (@: LmxMsgRuntime rt) int
    if: rt = 0
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_host_is_owner(rt) = 0
        return: c.LMX_MSG_INVALID
    return: c.LMX_MSG_OK
end: msg_require_owner

fn: msg_require_turn (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    if: rt = 0 || who = 0U
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_exec_holding_turn(rt, who) != 0
        return: c.LMX_MSG_OK
    if: c.lmx_msg_host_is_owner(rt) != 0 && c.lmx_msg_exec_workers(rt) = 0 && c.lmx_msg_exec_contexts_live(rt) = 0
        return: c.LMX_MSG_OK
    return: c.LMX_MSG_INVALID
end: msg_require_turn

fn: msg_runtime_new () @: LmxMsgRuntime
    @: LmxMsgRuntime rt
    unsigned: r0 0U
    unsigned: ui 0U
    rt: (cast: (@: LmxMsgRuntime) c.calloc(1U, c.sizeof(c.LmxMsgRuntime)))
    if: rt = 0
        return: 0
    rt\next_addr: 1U
    if: c.lmx_msg_host_attach(rt) != 0
        c.free((cast: (@: void) rt))
        return: 0
    if: c.lmx_msg_exec_attach(rt) != 0
        c.lmx_msg_host_detach(rt)
        c.free((cast: (@: void) rt))
        return: 0
    # Stage 5 (d1), spec 19.29.6 stage-5 clarification (i): creating the runtime
    # creates its root Message R0, address 1, the only Message without a parent.
    if: msg_create_prepare(rt, 0U, 0, 0, 0, 0, 0, 0U, @ r0, 0) != c.LMX_MSG_OK
        c.lmx_msg_exec_detach(rt)
        c.lmx_msg_host_detach(rt)
        c.free((cast: (@: void) rt))
        return: 0
    # M: the runtime creates no UI lane; a UI lane is an L3 Thread its application
    # creates as a child of R0 and maps like any child.
    return: rt
end: msg_runtime_new

# S6 (c): shutdown is set under R0's mailbox monitor, the one lock kept, so a
# post (checked under the same monitor) is ordered against it.
fn: msg_runtime_shutdown (@: LmxMsgRuntime rt) int
    @: LmxMsg root
    int: st
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    root: rt\root
    if: root != 0
        c.lmx_msg_mail_lock(root)
    ---
    st: c.lmx_msg_host_shutdown(rt)
    if: root != 0
        c.lmx_msg_mail_unlock(root)
    ---
    return: st
end: msg_runtime_shutdown

# Stage 5 (d1): the ingress root is R0, the runtime's only root. Exec lock held.
fn: msg_ingress_root (@: LmxMsgRuntime rt) @: LmxMsg
    return: rt\root
end: msg_ingress_root

# Stage 5 (d1): R0's address; 0 for a runtime without one.
fn: msg_root_addr (@: LmxMsgRuntime rt) unsigned
    if: rt = 0 || rt\root = 0
        return: 0U
    return: rt\root\addr
end: msg_root_addr

# Stage 5 (b): a host post is an admission into the root Message's mailbox, an
# internal INGRESS envelope that the root's drain forwards between its turns (spec
# 19.29.6 stage-5 clarification (iii)). Any OS thread may post; R0's mailbox
# monitor orders a post against runtime_shutdown (S6 (c): no host lock). No root:
# GONE, never a silent drop.
fn: msg_host_post (@: LmxMsgRuntime rt; LmxMsgAddr: dest; const: @(LmxMsgEnv env)) int
    @: LmxMsgCopy entry
    @: uchar bytes
    @: LmxMsg root
    if: rt = 0 || env = 0 || dest = 0U
        return: c.LMX_MSG_INVALID
    if: env\n != 0U && env\bytes = 0
        return: c.LMX_MSG_INVALID
    # S6 (c): no host lock. This early look is only a fast path; the post is ordered
    # against runtime_shutdown by the check under R0's mailbox monitor below.
    if: c.lmx_msg_host_is_shutdown(rt) != 0
        return: c.LMX_MSG_STOPPED
    if: c.lmx_msg_host_test_get_nomem() != 0
        return: c.LMX_MSG_NOMEM
    # S6-2, SPEC 19.29.7: R0 was pinned across this window so it could not be freed
    # under the post. Nothing frees a record any more except R0's own teardown, and
    # a post cannot outlive R0's teardown by construction.
    root: msg_ingress_root(rt)
    if: root = 0
        return: c.LMX_MSG_GONE
    entry: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: entry = 0
        return: c.LMX_MSG_NOMEM
    bytes: msg_copy_bytes(env\bytes, env\n)
    if: env\n != 0U && bytes = 0
        c.free((cast: (@: void) entry))
        return: c.LMX_MSG_NOMEM
    entry\id: env\id
    entry\correlation: env\correlation
    entry\reply_to: env\reply_to
    entry\from: c.LMX_MSG_HOST_FROM
    entry\to: dest
    entry\kind: c.LMX_MSG_KIND_INGRESS
    entry\ingress_kind: env\kind
    entry\number: env\number
    entry\bytes: bytes
    entry\n: env\n
    c.lmx_msg_mail_lock(root)
    # S6 (c), 5.6: a post after runtime_shutdown is refused here, under the monitor
    # the shutdown was set under, with a status to the poster.
    if: c.lmx_msg_host_is_shutdown(rt) != 0
        c.lmx_msg_mail_unlock(root)
        msg_copy_free(entry)
        return: c.LMX_MSG_STOPPED
    msg_q_push(@ root\inbox, @ root\inbox_tail, entry)
    c.lmx_msg_mail_unlock(root)
    return: c.LMX_MSG_STAGED
end: msg_host_post

# Stage 5 (b): the root's between-turns work on the root's lane: forward every
# INGRESS envelope in admission order, its own kind restored, then pump. While the
# bootstrap is the host that lane is the host outside any turn; from another thread
# or from inside any turn, the root's own included, it refuses (the loop's shape:
# one input per turn, the drain between turns).
fn: msg_host_drain (@: LmxMsgRuntime rt) int
    @: LmxMsg root
    @: LmxMsgCopy n 0
    @: LmxMsgCopy nxt
    if: msg_require_owner(rt) != c.LMX_MSG_OK || c.lmx_msg_exec_holding_any(rt) != 0
        return: c.LMX_MSG_INVALID
    # S6-2: the drain's pin on R0 goes for the same reason as the post's.
    root: msg_ingress_root(rt)
    if: root != 0
        c.lmx_msg_mail_inbox_take_ingress(root, @ n)
    ---
    # S6 (a): the transport is R0's own relay hop (root's inbox -> here -> pump ->
    # the real destination's inbox), so it is ordered under R0's mailbox monitor --
    # the one cross-lane synchronization the model permits, SPEC 11551 -- and not
    # under any runtime-wide lock. The inbox take above is entered and left before
    # this loop, so the two holds are sequential, never nested.
    c.lmx_msg_mail_lock(root)
    while: n != 0
        nxt: n\next
        n\next: 0
        n\kind: n\ingress_kind
        n\ingress_kind: 0
        msg_q_push(@ rt\transport, @ rt\transport_tail, n)
        n: nxt
    ---
    c.lmx_msg_mail_unlock(root)
    return: msg_pump(rt)
end: msg_host_drain

# S6-2: R0's teardown frees what is still attached to R0's tree, and not a
# runtime-wide registry walk, which 5.1 forbids. Nothing else needs reaching:
# a closed Message is freed by its own release chain (19.29.6), so the only
# records alive at teardown are the ones still on the tree.
# Two passes, in the order the old walk used and for the same reason: every mailbox
# is drained first, because slot_free destroys the monitor; the transport teardown
# runs between them under R0's monitor; only then is anything freed.
sub: msg_teardown_drain (@: LmxMsg m)
    @: LmxMsg s
    @: LmxMsg nxt
    @: LmxMsgCopy inb 0
    @: LmxMsgCopy outb 0
    if: m = 0
        return
    c.lmx_msg_mail_inbox_take(m, @ inb)
    msg_copy_free(inb)
    c.lmx_msg_mail_outbox_take(m, @ outb)
    msg_copy_free(outb)
    s: m\first_child
    while: s != 0
        nxt: s\next_sibling
        msg_teardown_drain(s)
        s: nxt
    ---
end: msg_teardown_drain

# Bottom-up: a record's children are freed before it, so every link is read
# before the record holding it is freed.
sub: msg_teardown_free (@: LmxMsg m)
    @: LmxMsg s
    @: LmxMsg nxt
    if: m = 0
        return
    s: m\first_child
    m\first_child: 0
    m\last_child: 0
    while: s != 0
        nxt: s\next_sibling
        msg_teardown_free(s)
        s: nxt
    ---
    if: m\init != 0
        c.free((cast: (@: void) m\init))
    ---
    m\init: 0
    c.lmx_msg_slot_free(m)
end: msg_teardown_free

# AD (2026-09-16): the id order's search, the counterpart of the address order's
# search below. SPEC 19.29.7 makes a capability "the target's id" and requires a
# Message to be found by it "in bounded time, never by scanning one by one", so
# the same pair (record pointer, id) is also kept in a second, id-sorted order.
# \at receives the index when found and the insertion point when not. Placed
# here, above the sweep, for the same no-forward-declaration reason the sweep is
# placed here (see the note below): its only callee is the pair of arrays.
fn: msg_live_find_id (@: LmxMsg svc; LmxMsgAddr: id; @: int at) int
    int: lo 0
    int: hi
    int: mid
    if: svc = 0 || id = 0U || at = 0
        return: 0
    hi: svc\live_n
    while: lo < hi
        mid: lo + ((hi - lo) / 2)
        if: svc\byid_id[mid] = id
            \at: mid
            return: 1
        ---
        if: svc\byid_id[mid] < id
            lo: mid + 1
        else:
            hi: mid
        ---
    ---
    \at: lo
    return: 0
end: msg_live_find_id

# AD: drop the id's entry from the id order. A miss is OK -- a freed record's
# entry may already be gone -- and the caller that must know whether a RECORD was
# live reads the address order, which is the order that decides that question.
# Placed here beside its search: the sweep below calls it.
sub: msg_live_byid_remove (@: LmxMsg svc; LmxMsgAddr: id)
    int: at 0
    int: i
    if: svc = 0 || id = 0U
        return
    if: msg_live_find_id(svc, id, @ at) = 0
        return
    i: at
    while: i < svc\live_n - 1
        svc\byid_m[i]: svc\byid_m[i + 1]
        svc\byid_id[i]: svc\byid_id[i + 1]
        i: i + 1
    ---
    svc\byid_m[svc\live_n - 1]: 0
    svc\byid_id[svc\live_n - 1]: 0U
end: msg_live_byid_remove

# S6-2: teardown's collector for records the service never got to free -- see the
# call in msg_runtime_delete for why they exist and why this runs before
# msg_teardown_free. R0 itself is skipped: teardown_free frees it, and freeing it
# here would leave the walk below reading a freed record.
# PLACED HERE, above every caller, because lm2 has no forward-declaration block
# (lm1 does, and its three names are in it): L1 emits functions in source order
# and does not hoist, so a call earlier in the file than its definition compiles
# as an implicit declaration and this gate uses
# -Werror=implicit-function-declaration. Its callees -- msg_copy_free 517,
# msg_q_push 565, msg_self_or_find 632, msg_ingress_root 939, and AD's
# msg_live_byid_remove placed just above it -- are all above
# this point, so nothing is pushed forward by the move.
sub: msg_live_sweep (@: LmxMsg svc)
    int: i 0
    @: LmxMsg m
    if: svc = 0
        return
    while: i < svc\live_n
        m: svc\live_m[i]
        if: m != 0 && m != svc && m\state = c.LMX_MSG_STATE_RELEASED
            # AD: the id order loses the entry before the record is freed.
            msg_live_byid_remove(svc, svc\live_id[i])
            c.lmx_msg_slot_free(m)
            svc\live_m[i]: 0
        ---
        i: i + 1
    ---
end: msg_live_sweep

# S6-2 (SPEC 19.29.7, the removal ruling): the unregister-and-free letter. Same
# shape as msg_post_register, opposite act: the service removes the entry and then
# calls slot_free, in that order, on its own lane. msg_release_slot cannot do
# either itself -- writing the live set would be a cross-lane write, and freeing
# the record would leave the service holding an entry that names freed memory
# until it next drains.
fn: msg_post_unregister (@: LmxMsgRuntime rt; @: LmxMsg m) int
    @: LmxMsgCopy entry
    @: LmxMsg root
    if: rt = 0 || m = 0
        return: c.LMX_MSG_INVALID
    entry: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: entry = 0
        return: c.LMX_MSG_NOMEM
    entry\from: m\addr
    entry\to: m\addr
    entry\kind: c.LMX_MSG_KIND_UNREGISTER
    entry\dest_msg: m
    root: msg_ingress_root(rt)
    c.lmx_msg_mail_lock(root)
    msg_q_push(@ rt\transport, @ rt\transport_tail, entry)
    c.lmx_msg_mail_unlock(root)
    return: c.LMX_MSG_OK
end: msg_post_unregister

# S6-2 (SPEC 19.29.7): the registration letter, modelled on msg_post_dead -- the
# same shape of unsolicited notice, with R0's monitor taken and left on its own.
# It carries the record itself in dest_msg, which for this kind is the payload and
# not a delivery target, and the id in to; msg_admit_one intercepts it before any
# destination is resolved. Posted by the creating lane, drained by the service's,
# which is what keeps the live set single-writer.
fn: msg_post_register (@: LmxMsgRuntime rt; @: LmxMsg m) int
    @: LmxMsgCopy entry
    @: LmxMsg root
    if: rt = 0 || m = 0
        return: c.LMX_MSG_INVALID
    entry: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: entry = 0
        return: c.LMX_MSG_NOMEM
    entry\from: m\addr
    entry\to: m\addr
    entry\kind: c.LMX_MSG_KIND_REGISTER
    entry\dest_msg: m
    root: msg_ingress_root(rt)
    c.lmx_msg_mail_lock(root)
    msg_q_push(@ rt\transport, @ rt\transport_tail, entry)
    c.lmx_msg_mail_unlock(root)
    return: c.LMX_MSG_OK
end: msg_post_register

sub: msg_runtime_delete (@: LmxMsgRuntime rt)
    @: LmxMsg root
    if: rt = 0
        return
    if: c.lmx_msg_host_is_owner(rt) = 0
        return
    c.lmx_msg_host_shutdown(rt)
    c.lmx_msg_exec_stop(rt)
    c.lmx_msg_exec_drop_binds(rt)
    c.lmx_msg_exec_set_no_retire(rt, 1)
    msg_teardown_drain(rt\root)
    # S6 (a): the teardown of the relay queue runs under R0's monitor too, and it
    # runs before the free below in which slot_free destroys that monitor.
    root: msg_ingress_root(rt)
    c.lmx_msg_mail_lock(root)
    msg_copy_free(rt\transport)
    rt\transport: 0
    rt\transport_tail: 0
    c.lmx_msg_mail_unlock(root)
    # S6-2: sweep R0's live set before the tree is freed. A record whose
    # unregister-and-free letter was still queued when the runtime is deleted has
    # that letter dropped with the transport just above, and msg_release_slot
    # already unlinked it from its parent, so msg_teardown_free's walk over
    # first_child never reaches it; the same happens when the letter could not be
    # allocated at all. Its only remaining referent is this set. RELEASED plus
    # presence in the set is exactly the "released but not yet freed" condition
    # and needs no new state. It must run BEFORE msg_teardown_free, which frees R0
    # and takes live_m and live_id with it.
    msg_live_sweep(rt\root)
    msg_teardown_free(rt\root)
    rt\root: 0
    c.lmx_msg_exec_set_no_retire(rt, 0)
    c.lmx_msg_exec_detach(rt)
    c.lmx_msg_host_detach(rt)
    c.free((cast: (@: void) rt))
end: msg_runtime_delete

fn: msg_grow (@: LmxMsgRuntime rt) int
    if: rt = 0
        return: 1
    return: c.lmx_msg_tab_grow(rt)
end: msg_grow

# S6-2 (SPEC 19.29.7): a Message's address field reduces to its index at its
# parent; the full address is composed by msg_address_of walking the parent links.
# The path arrays this function used to fill were a materialized cache of that
# walk, and went with the path_storage module. Nothing is allocated here any more.
fn: msg_assign_path (@: LmxMsgRuntime rt; @: LmxMsg slot; @: LmxMsg p) int
    if: rt = 0 || slot = 0
        return: c.LMX_MSG_INVALID
    if: p = 0
        # S5: only R0 is created without a parent; its index is the whole of its
        # address, [1].
        slot\index: 1U
        return: c.LMX_MSG_OK
    if: p\child_seq + 1U = 0U
        return: c.LMX_MSG_NOMEM
    p\child_seq: p\child_seq + 1U
    slot\index: p\child_seq
    return: c.LMX_MSG_OK
end: msg_assign_path

# S6-2 (SPEC 19.29.7, Mikhail's thirteenth and fourteenth lines): the mail service
# a Message delegates to. Every common-API operation's default body reads this and
# delegates; the service's own reference points at itself, which is what terminates
# the delegation. A Message created before this field existed reads as its own
# service rather than as a null, so no caller has to test for 0.
fn: msg_service_of (@: LmxMsg m) @: LmxMsg
    if: m = 0
        return: 0
    if: m\service = 0
        return: m
    return: m\service
end: msg_service_of

# Membership in bounded time (SPEC 19.29.7), never a scan: the live set is kept
# sorted by the record's own address, compared as uintptr_t exactly as the arena's
# range checks already compare block bounds. One walk answers both questions a
# caller has -- whether the record is live, and where it would be inserted.
fn: msg_live_find (@: LmxMsg svc; @: LmxMsg m; @: int at) int
    int: lo 0
    int: hi
    int: mid
    if: svc = 0 || m = 0 || at = 0
        return: 0
    hi: svc\live_n
    while: lo < hi
        mid: lo + ((hi - lo) / 2)
        if: (cast: (uintptr_t) svc\live_m[mid]) = (cast: (uintptr_t) m)
            \at: mid
            return: 1
        ---
        if: (cast: (uintptr_t) svc\live_m[mid]) < (cast: (uintptr_t) m)
            lo: mid + 1
        else:
            hi: mid
        ---
    ---
    \at: lo
    return: 0
end: msg_live_find

# AD: the record the service holds under this id, or 0. This is the bounded-time
# answer to a target named only by its id: a released record, an id the service
# never held and an address that fell off all answer 0, and the caller refuses.
fn: msg_live_lookup (@: LmxMsg svc; LmxMsgAddr: id) @: LmxMsg
    int: at 0
    if: svc = 0 || id = 0U
        return: 0
    if: msg_live_find_id(svc, id, @ at) = 0
        return: 0
    return: svc\byid_m[at]
end: msg_live_lookup

# Both arrays grow together and always have the same length, which is the one
# risk two parallel arrays carry and the reason live_cap describes both. If the
# second realloc fails after the first succeeded, live_cap is NOT advanced: the
# pointer array is merely larger than claimed, which wastes a little memory and
# stays correct, and the next growth retries from the recorded cap.
# Sizes follow the tree's own precedent for these two element types: c.sizeof(@:
# void) for a pointer array, and c.sizeof(unsigned) for an LmxMsgAddr array,
# exactly as the done_from / done_id arrays are sized.
# (c.sizeof(@: LmxMsgAddr) would size a POINTER to the id, not the id.)
fn: msg_live_grow (@: LmxMsg svc; int: need) int
    int: cap
    @@: LmxMsg grown_m
    @: unsigned grown_id
    @@: LmxMsg grown_byid_m
    @: unsigned grown_byid_id
    if: svc = 0 || need < 1
        return: c.LMX_MSG_INVALID
    if: svc\live_cap >= need
        return: c.LMX_MSG_OK
    cap: svc\live_cap
    if: cap < 1
        cap: 8
    while: cap < need
        if: cap > 2147483647 / 2
            return: c.LMX_MSG_NOMEM
        cap: cap * 2
    ---
    if: (cast: (size_t) cap) > ((cast: (size_t) -1) / c.sizeof(@: void))
        return: c.LMX_MSG_NOMEM
    grown_m: (cast: (@@: LmxMsg) c.realloc((cast: (@: void) svc\live_m), (cast: (size_t) cap) * c.sizeof(@: void)))
    if: grown_m = 0
        return: c.LMX_MSG_NOMEM
    svc\live_m: grown_m
    grown_id: (cast: (@: unsigned) c.realloc((cast: (@: void) svc\live_id), (cast: (size_t) cap) * c.sizeof(unsigned)))
    if: grown_id = 0
        return: c.LMX_MSG_NOMEM
    svc\live_id: grown_id
    # AD: the id order grows with the address order, under the same cap and with
    # the same "cap advances only when every array did" rule.
    grown_byid_m: (cast: (@@: LmxMsg) c.realloc((cast: (@: void) svc\byid_m), (cast: (size_t) cap) * c.sizeof(@: void)))
    if: grown_byid_m = 0
        return: c.LMX_MSG_NOMEM
    svc\byid_m: grown_byid_m
    grown_byid_id: (cast: (@: unsigned) c.realloc((cast: (@: void) svc\byid_id), (cast: (size_t) cap) * c.sizeof(unsigned)))
    if: grown_byid_id = 0
        return: c.LMX_MSG_NOMEM
    svc\byid_id: grown_byid_id
    svc\live_cap: cap
    return: c.LMX_MSG_OK
end: msg_live_grow

# AD: insert the pair into the id order. The growth and the shift are the address
# order's own insert below; an id already present has its record replaced rather
# than duplicated, because an id names exactly one Message for its whole life.
fn: msg_live_byid_add (@: LmxMsg svc; @: LmxMsg m; LmxMsgAddr: id) int
    int: at 0
    int: i
    int: st
    if: svc = 0 || m = 0
        return: c.LMX_MSG_INVALID
    if: msg_live_find_id(svc, id, @ at) != 0
        svc\byid_m[at]: m
        return: c.LMX_MSG_OK
    st: msg_live_grow(svc, svc\live_n + 1)
    if: st != c.LMX_MSG_OK
        return: st
    i: svc\live_n
    while: i > at
        svc\byid_m[i]: svc\byid_m[i - 1]
        svc\byid_id[i]: svc\byid_id[i - 1]
        i: i - 1
    ---
    svc\byid_m[at]: m
    svc\byid_id[at]: id
    return: c.LMX_MSG_OK
end: msg_live_byid_add

# Registration: the record joins the service's live set, sorted by address so the
# membership test stays a binary search. Written ONLY on the service's own lane.
# Idempotent: registering a record already in the set is OK, not a second entry.
fn: msg_service_register (@: LmxMsg svc; @: LmxMsg m; LmxMsgAddr: id) int
    int: at 0
    int: i
    int: st
    if: svc = 0 || m = 0
        return: c.LMX_MSG_INVALID
    if: msg_live_find(svc, m, @ at) != 0
        # Already live at this address. If the id differs the entry is a stale one
        # for a freed record whose address was reused, so it is REPLACED rather
        # than duplicated: the new record is the live one at that address now.
        # AD: the id order moves with the replacement -- the old id's entry goes
        # and the new id names this record.
        msg_live_byid_remove(svc, svc\live_id[at])
        svc\live_id[at]: id
        return: msg_live_byid_add(svc, m, id)
    st: msg_live_grow(svc, svc\live_n + 1)
    if: st != c.LMX_MSG_OK
        return: st
    # AD: the id order first, while live_n still counts the entries that exist in
    # it; its own grow call is a no-op because the cap is already raised above.
    st: msg_live_byid_add(svc, m, id)
    if: st != c.LMX_MSG_OK
        return: st
    i: svc\live_n
    while: i > at
        svc\live_m[i]: svc\live_m[i - 1]
        svc\live_id[i]: svc\live_id[i - 1]
        i: i - 1
    ---
    svc\live_m[at]: m
    svc\live_id[at]: id
    svc\live_n: svc\live_n + 1
    return: c.LMX_MSG_OK
end: msg_service_register

# Removal at release, BEFORE the record is freed: after this a send holding the
# address is refused rather than dereferencing freed memory. Removing a record
# that is not in the set is OK -- a release may run for a Message whose
# registration letter never arrived.
fn: msg_service_unregister (@: LmxMsg svc; @: LmxMsg m; LmxMsgAddr: id) int
    int: at 0
    int: i
    if: svc = 0 || m = 0
        return: c.LMX_MSG_INVALID
    # S6-2 (the found-and-removed ruling): OK means THIS call removed the entry, and
    # nothing else does. Every miss returns GONE, so a caller can tell a real
    # removal from a record the service never held -- the distinction that decides
    # whether the record may be freed.
    if: msg_live_find(svc, m, @ at) = 0
        return: c.LMX_MSG_GONE
    # The id must match: an entry at this address belonging to a DIFFERENT record
    # is not ours to remove, and removing it would unregister a live Message
    # because its predecessor's address was reused.
    if: svc\live_id[at] != id
        return: c.LMX_MSG_GONE
    i: at
    while: i < svc\live_n - 1
        svc\live_m[i]: svc\live_m[i + 1]
        svc\live_id[i]: svc\live_id[i + 1]
        i: i + 1
    ---
    # AD: the id order loses the entry too, before live_n shrinks past it.
    msg_live_byid_remove(svc, id)
    svc\live_n: svc\live_n - 1
    svc\live_m[svc\live_n]: 0
    svc\live_id[svc\live_n]: 0U
    return: c.LMX_MSG_OK
end: msg_service_unregister

# The membership test the send path uses: an address absent from the live set is
# REFUSED, never dereferenced. This is the whole of what replaces refs.
fn: msg_service_is_live (@: LmxMsg svc; @: LmxMsg m; LmxMsgAddr: id) int
    int: at 0
    if: svc = 0 || m = 0
        return: 0
    if: msg_live_find(svc, m, @ at) = 0
        return: 0
    # BOTH must match. The address alone is not enough: malloc reuses addresses,
    # so a handle that outlived its record can name a new record at the same
    # address, and the id -- minted monotonically and never reused -- is what
    # tells them apart. A mismatch is refused, not dereferenced.
    if: svc\live_id[at] != id
        return: 0
    return: 1
end: msg_service_is_live

# S6-2 (SPEC 19.29.7): compose an address by walking the parent links and reading
# each index, root-first. R0's parent_msg is 0, which terminates the walk. No
# allocation, so no free-partner.
# The chain can change between the count and the fill: a handoff or an orphaning
# re-links a child that may be running on another lane. So the fill never writes
# outside out[0..n-1] (n <= cap), and a chain that is longer or shorter than the
# count reads -1 rather than a mixed address; with cap < n nothing is written.
# PRE-EXISTING, recorded with its home in AD and not fixed here: parent_msg is read
# across lanes with no atomic cell, and a walker can load an ancestor just before
# the settling lane re-links it and R0 frees it. The earlier premise ("parent_msg
# is written only by child_link, a parent is never freed before its children")
# does not hold: child_link runs on the old parent's lane and on the settling lane
# while the child may run. The lock-free fix is atomic link cells plus a free grace.
fn: msg_address_of (@: LmxMsg m; @: unsigned out; int: cap) int
    @: LmxMsg x
    int: n 0
    int: i
    if: m = 0
        return: -1
    x: m
    while: x != 0
        n: n + 1
        x: x\parent_msg
    ---
    if: out = 0 || cap < n
        return: n
    ---
    x: m
    i: n - 1
    while: x != 0 && i >= 0
        out[i]: x\index
        i: i - 1
        x: x\parent_msg
    ---
    if: x != 0 || i != -1
        return: -1
    ---
    return: n
end: msg_address_of

fn: msg_create_prepare (@: LmxMsgRuntime rt; LmxMsgAddr: parent; @: Lmx source; @: LmxOwnedRange src_ranges; @: LmxOwnedRange eternal_ranges; @: LmxOwnedRange method_ranges; const: @(uchar init); size_t: n; @: LmxMsgAddr out; @@: LmxMsg out_msg) int
    @: LmxMsg slot
    @: LmxMsg p 0
    @: uchar initp 0
    @: char dst_chars 0
    int: st
    int: top 0
    if: out = 0 || (source != 0 && src_ranges = 0)
        return: c.LMX_MSG_INVALID
    if: parent = 0U
        if: msg_require_owner(rt) != c.LMX_MSG_OK
            return: c.LMX_MSG_INVALID
        ---
    ---
    if: parent != 0U
        if: msg_require_turn(rt, parent) != c.LMX_MSG_OK
            return: c.LMX_MSG_INVALID
        ---
    ---
    # Stage 5 (d1), spec 19.29.6 stage-5 clarification (iv): R0 is the one top
    # level, so once R0 exists a create without a parent makes R0's child. The
    # host authority checked above stays until stage 5 (d3).
    if: parent = 0U && rt\root != 0
        p: rt\root
        top: 1
    ---
    if: parent != 0U
        p: msg_self_or_find(rt, parent)
        if: p = 0
            return: c.LMX_MSG_INVALID
        ---
    ---
    initp: msg_copy_bytes(init, n)
    if: n != 0U && initp = 0
        return: c.LMX_MSG_NOMEM
    slot: c.lmx_msg_slot_new()
    if: slot = 0
        if: initp != 0
            c.free((cast: (@: void) initp))
        ---
        return: c.LMX_MSG_NOMEM
    slot\owner_rt: rt
    if: source != 0
        dst_chars: lmx_chars_new_owned(@ slot\blocks, @ slot\ranges)
        if: dst_chars = 0
            c.lmx_msg_slot_free(slot)
            if: initp != 0
                c.free((cast: (@: void) initp))
            ---
            return: c.LMX_MSG_NOMEM
        ---
        st: lmx_msg_graph_copy_install(slot, source, src_ranges, eternal_ranges, method_ranges, dst_chars)
        if: st != c.LMX_MSG_OK
            c.lmx_msg_slot_free(slot)
            if: initp != 0
                c.free((cast: (@: void) initp))
            ---
            return: st
        ---
        st: c.lmx_msg_eternal_clone(slot, eternal_ranges)
        if: st != c.LMX_MSG_OK
            c.lmx_msg_slot_free(slot)
            if: initp != 0
                c.free((cast: (@: void) initp))
            ---
            return: st
        ---
        st: c.lmx_msg_method_clone(slot, method_ranges)
        if: st != c.LMX_MSG_OK
            c.lmx_msg_slot_free(slot)
            if: initp != 0
                c.free((cast: (@: void) initp))
            ---
            return: st
        ---
    ---
    st: msg_assign_path(rt, slot, p)
    if: st != c.LMX_MSG_OK
        c.lmx_msg_slot_free(slot)
        if: initp != 0
            c.free((cast: (@: void) initp))
        ---
        return: st
    # S5: the address comes from the runtime's order-free atomic counter (no owner lane).
    slot\addr: c.lmx_msg_addr_take(rt)
    slot\state: c.LMX_MSG_STATE_INACTIVE
    slot\committed: 0
    if: parent = 0U
        slot\committed: 1
        slot\state: c.LMX_MSG_STATE_RUNNING
        slot\next_sibling: 0
    ---
    slot\init_n: n
    slot\init: initp
    # S6-2: no runtime-wide registry. A record is reachable through its family and,
    # once it closes, through its owner's settled list -- which is what teardown
    # walks and what a late sender follows.
    # S5: top = 0 with no parent means no root exists yet; this is R0.
    if: parent = 0U && top = 0
        rt\root: slot
    ---
    # S6-2 (SPEC 19.29.7, Mikhail's thirteenth line): the mail service reference is
    # "born with the Message and set from its parent". It is NOT the parent: it is
    # whatever the parent's service was, so every chain terminates at R0, whose own
    # reference points at itself. A reparent does not rewrite it -- the field is
    # reassignable by an explicit act, and a new parent is not a new service.
    if: p != 0
        slot\service: p\service
    else:
        slot\service: slot
    ---
    if: p != 0
        msg_child_link(p, slot)
    ---
    # S6-2 (SPEC 19.29.7): register the new record with its service. A child is
    # created on its PARENT's lane (require_turn above), so this cannot write the
    # service's live set directly -- that would be the cross-lane write this stage
    # exists to delete. It is a letter, and it is pushed HERE, BEFORE the address
    # leaves in \out below: the caller holds the handle the moment create returns,
    # and with the FIFO transport (q_push at the tail, q_pop at the head) any send
    # it then makes is pushed after this and drains after it. That ordering is the
    # whole of what makes delivery by memory address safe without a holder count.
    # A service that is its own record registers directly: R0's creation runs on
    # the owner's lane and there is no letter to send to itself.
    if: slot\service = slot
        msg_service_register(slot, slot, slot\addr)
    else:
        st: msg_post_register(rt, slot)
        if: st != c.LMX_MSG_OK
            return: st
        ---
    ---
    \out: slot\addr
    # AD (2026-09-16): create hands the new record back as the pair the ruling
    # gives a target -- the id it just wrote through \out, and the record itself
    # here.  A caller that takes this can name the child without any lookup,
    # which is what the create-adjacent call sites need: the child's registration
    # is a LETTER that has not drained yet, so the service's id order cannot
    # answer for it until R0's round runs. 0 means the caller does not want it.
    if: out_msg != 0
        \out_msg: slot
    ---
    return: c.LMX_MSG_OK
end: msg_create_prepare

fn: msg_create (@: LmxMsgRuntime rt; LmxMsgAddr: parent; const: @(uchar init); size_t: n; @: LmxMsgAddr out; @@: LmxMsg out_msg) int
    return: msg_create_prepare(rt, parent, 0, 0, 0, 0, init, n, out, out_msg)
end: msg_create

fn: msg_create_graph (@: LmxMsgRuntime rt; LmxMsgAddr: parent; @: Lmx source; @: LmxOwnedRange src_ranges; @: LmxOwnedRange eternal_ranges; @: LmxOwnedRange method_ranges; const: @(uchar init); size_t: n; @: LmxMsgAddr out; @@: LmxMsg out_msg) int
    if: source = 0 || src_ranges = 0
        return: c.LMX_MSG_INVALID
    return: msg_create_prepare(rt, parent, source, src_ranges, eternal_ranges, method_ranges, init, n, out, out_msg)
end: msg_create_graph

fn: msg_send (@: LmxMsgRuntime rt; LmxMsgAddr: from; LmxMsgAddr: to; const: @(LmxMsgEnv env)) int
    @: LmxMsg src
    @: LmxMsg destn
    @: LmxMsgCopy entry
    if: msg_require_turn(rt, from) != c.LMX_MSG_OK || env = 0 || from = 0U || to = 0U
        return: c.LMX_MSG_INVALID
    entry: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: entry = 0
        return: c.LMX_MSG_NOMEM
    entry\id: env\id
    entry\correlation: env\correlation
    entry\reply_to: env\reply_to
    entry\from: from
    entry\to: to
    entry\kind: env\kind
    entry\number: env\number
    entry\n: env\n
    entry\bytes: msg_copy_bytes(env\bytes, env\n)
    if: env\n != 0U && entry\bytes = 0
        c.free((cast: (@: void) entry))
        return: c.LMX_MSG_NOMEM
    # AD (2026-09-16): the sender as the pair the ruling gives a target. A caller
    # that holds the record (the turn's own, create's result, the answered
    # letter) passes it and nothing is resolved; the id is checked against the
    # record's own addr, because malloc reuses addresses and ids never are.
    src: env\from_msg
    if: src = 0 || src\addr != from
        src: msg_self_or_find(rt, from)
    ---
    if: src = 0
        msg_copy_free(entry)
        return: c.LMX_MSG_INVALID
    if: src\state = c.LMX_MSG_STATE_DEAD
        msg_copy_free(entry)
        return: c.LMX_MSG_DEAD
    if: src\state = c.LMX_MSG_STATE_STOPPED
        msg_copy_free(entry)
        return: c.LMX_MSG_STOPPED
    # AD (2026-09-16): the destination as the pair, when the caller holds it --
    # the record it answers, or create's result. Only 0 falls back to the
    # resolution by scanning that this stage deletes, and the id is checked
    # against the record's own addr first.
    destn: 0
    if: env\to_msg != 0 && env\to_msg\addr = to
        destn: env\to_msg
    else:
        destn: msg_dest_from_src(src, to, rt)
    ---
    # S6-2, SPEC 19.29.7: the carried destination is a handle, not a hold. No count
    # is taken here, so nothing is released when the copy is freed -- the two go
    # together, and removing only the release left the count rising and never
    # falling, which the fixture's leak checks caught in one run.
    if: destn != 0
        entry\dest_msg: destn
    ---
    # S6-2: the sender is not counted either. It is inside its own turn for the
    # whole of this staging, so it cannot be freed under itself.
    c.lmx_msg_mail_lock(src)
    msg_q_push(@ src\outbox, @ src\outbox_tail, entry)
    c.lmx_msg_mail_unlock(src)
    return: c.LMX_MSG_STAGED
end: msg_send

# Ordinary delivery of a graph (SPEC 19.29.7): the sending turn stages a
# Message created by the copier in its own arena; the sender keeps its
# original, the copy is independently transferable. Publication, FIFO
# admission and dedup are those of send; recv moves the copy's storage into
# the handler's arena and hands over its root as env.graph.
fn: msg_send_graph (@: LmxMsgRuntime rt; LmxMsgAddr: from; LmxMsgAddr: to; const: @(LmxMsgEnv env); @: Lmx graph) int
    @: LmxMsg src
    @: LmxMsg destn
    @: LmxMsgCopy entry
    if: msg_require_turn(rt, from) != c.LMX_MSG_OK || env = 0 || from = 0U || to = 0U || graph = 0
        return: c.LMX_MSG_INVALID
    entry: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: entry = 0
        return: c.LMX_MSG_NOMEM
    entry\id: env\id
    entry\correlation: env\correlation
    entry\reply_to: env\reply_to
    entry\from: from
    entry\to: to
    entry\kind: c.LMX_MSG_KIND_GRAPH
    entry\number: env\number
    entry\n: 0U
    entry\bytes: 0
    # AD (2026-09-16): the sender as the pair the ruling gives a target. A caller
    # that holds the record (the turn's own, create's result, the answered
    # letter) passes it and nothing is resolved; the id is checked against the
    # record's own addr, because malloc reuses addresses and ids never are.
    src: env\from_msg
    if: src = 0 || src\addr != from
        src: msg_self_or_find(rt, from)
    ---
    if: src = 0
        msg_copy_free(entry)
        return: c.LMX_MSG_INVALID
    if: src\state = c.LMX_MSG_STATE_DEAD
        msg_copy_free(entry)
        return: c.LMX_MSG_DEAD
    if: src\state = c.LMX_MSG_STATE_STOPPED
        msg_copy_free(entry)
        return: c.LMX_MSG_STOPPED
    entry\delivered: msg_delivery_new(graph, src\ranges, c.lmx_msg_eternal_ranges(src), c.lmx_msg_method_ranges(src))
    if: entry\delivered = 0
        msg_copy_free(entry)
        return: c.LMX_MSG_NOMEM
    # AD (2026-09-16): the destination as the pair, when the caller holds it --
    # the record it answers, or create's result. Only 0 falls back to the
    # resolution by scanning that this stage deletes, and the id is checked
    # against the record's own addr first.
    destn: 0
    if: env\to_msg != 0 && env\to_msg\addr = to
        destn: env\to_msg
    else:
        destn: msg_dest_from_src(src, to, rt)
    ---
    # S6-2, SPEC 19.29.7: the carried destination is a handle, not a hold. No count
    # is taken here, so nothing is released when the copy is freed -- the two go
    # together, and removing only the release left the count rising and never
    # falling, which the fixture's leak checks caught in one run.
    if: destn != 0
        entry\dest_msg: destn
    ---
    # S6-2: the sender is not counted either. It is inside its own turn for the
    # whole of this staging, so it cannot be freed under itself.
    c.lmx_msg_mail_lock(src)
    msg_q_push(@ src\outbox, @ src\outbox_tail, entry)
    c.lmx_msg_mail_unlock(src)
    return: c.LMX_MSG_STAGED
end: msg_send_graph

fn: msg_send_owned (@: LmxMsgRuntime rt; LmxMsgAddr: from; LmxMsgAddr: to; @: LmxMsgEnv env) int
    @: LmxMsg src
    @: LmxMsg destn
    @: LmxMsgCopy entry
    if: msg_require_turn(rt, from) != c.LMX_MSG_OK || env = 0 || from = 0U || to = 0U
        return: c.LMX_MSG_INVALID
    if: env\kind != c.LMX_MSG_KIND_BYTES && env\kind != c.LMX_MSG_KIND_NUMBER
        return: c.LMX_MSG_INVALID
    if: env\n != 0U && env\bytes = 0
        return: c.LMX_MSG_INVALID
    entry: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: entry = 0
        return: c.LMX_MSG_NOMEM
    entry\id: env\id
    entry\correlation: env\correlation
    entry\reply_to: env\reply_to
    entry\from: from
    entry\to: to
    entry\kind: env\kind
    entry\number: env\number
    entry\n: env\n
    entry\bytes: (cast: (@: uchar) env\bytes)
    entry\owned: 1
    env\bytes: 0
    env\n: 0U
    # AD (2026-09-16): the sender as the pair the ruling gives a target. A caller
    # that holds the record (the turn's own, create's result, the answered
    # letter) passes it and nothing is resolved; the id is checked against the
    # record's own addr, because malloc reuses addresses and ids never are.
    src: env\from_msg
    if: src = 0 || src\addr != from
        src: msg_self_or_find(rt, from)
    ---
    if: src = 0
        env\bytes: entry\bytes
        env\n: entry\n
        entry\bytes: 0
        c.free((cast: (@: void) entry))
        return: c.LMX_MSG_INVALID
    if: src\state = c.LMX_MSG_STATE_DEAD || src\state = c.LMX_MSG_STATE_STOPPED
        env\bytes: entry\bytes
        env\n: entry\n
        entry\bytes: 0
        c.free((cast: (@: void) entry))
        if: src\state = c.LMX_MSG_STATE_DEAD
            return: c.LMX_MSG_DEAD
        return: c.LMX_MSG_STOPPED
    # AD (2026-09-16): the destination as the pair, when the caller holds it --
    # the record it answers, or create's result. Only 0 falls back to the
    # resolution by scanning that this stage deletes, and the id is checked
    # against the record's own addr first.
    destn: 0
    if: env\to_msg != 0 && env\to_msg\addr = to
        destn: env\to_msg
    else:
        destn: msg_dest_from_src(src, to, rt)
    ---
    if: destn != 0
        # S6-2: the carried destination is a handle, not a hold (as above).
        entry\dest_msg: destn
    ---
    # S6-2: as above -- the sender is in its own turn and is not counted.
    c.lmx_msg_mail_lock(src)
    msg_q_push(@ src\outbox, @ src\outbox_tail, entry)
    c.lmx_msg_mail_unlock(src)
    return: c.LMX_MSG_STAGED
end: msg_send_owned

fn: msg_stop (@: LmxMsgRuntime rt; LmxMsgAddr: from; LmxMsgAddr: to) int
    @: LmxMsgEnv env
    int: st
    if: msg_require_turn(rt, from) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    env: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    if: env = 0
        return: c.LMX_MSG_NOMEM
    env\kind: c.LMX_MSG_KIND_STOP
    env\reply_to: from
    st: msg_send(rt, from, to, env)
    c.free((cast: (@: void) env))
    return: st
end: msg_stop

# S6-2 (respecified 2026-09-16): the owner's list of closed records is gone with
# the settle it enumerated. A closed Message is freed by its own release chain,
# so no owner has closed records to enumerate.


sub: msg_release_slot (@: LmxMsgRuntime rt; @: LmxMsg m)
    @: LmxMsgCopy inb 0
    @: LmxMsgCopy outb 0
    int: ust
    if: m = 0
        return
    # Stage 3b-8: unbind while m is still in its family, so a bound Message is
    # never outside its family tree; unbind cannot retire m while parent_msg is set.
    # The unbind is the settling lane's write of the parent's mapping cell
    # (19.28.R2.2 (2), 19.29.6), so it cannot be refused here; a TEST tripwire
    # makes a wrong-lane release loud under the lane check.
    ust: c.lmx_msg_exec_unbind_msg(rt, m)
    c.lmx_msg_test_unbind_refused(rt, m, ust, "release_slot")
    # Stage 3b-9: every family-tree reader holds the exec lock, so the tree
    # changes under it. Unbind stays outside: it joins reaps on the host.
    c.lmx_msg_test_release_tree(rt, m)
    if: m\parent_msg != 0
        msg_child_unlink(m\parent_msg, m)
    ---
    # S5: only R0 has no parent, and it is the one root.
    if: rt != 0 && m\parent_msg = 0
        if: rt\root = m
            rt\root: 0
        ---
        m\next_sibling: 0
    ---
    # S6-2, SPEC 19.29.7 as respecified 2026-09-16: a closed Message's slot and
    # arena are freed by the release chain, as 19.29.6 says. The mailbox is drained
    # and destroyed here with the record: a capability is the target's ID, so no
    # sender holds a pointer into this storage and nothing has to outlive it.
    c.lmx_msg_mail_inbox_take(m, @ inb)
    msg_copy_free(inb)
    c.lmx_msg_mail_outbox_take(m, @ outb)
    msg_copy_free(outb)
    if: m\init != 0
        c.free((cast: (@: void) m\init))
    ---
    m\init: 0
    m\init_n: 0U
    m\state: c.LMX_MSG_STATE_RELEASED
    m\committed: 0
    # S6-2 (the removal ruling): the record is freed by its SERVICE, not here.
    # msg_release_slot runs on the RELEASING lane -- the parent's dispose, or this
    # Message's own end-turn -- so it can do neither of the two obvious things:
    # writing the service's live set would be the cross-lane write this stage
    # exists to delete, and freeing the record here would leave the service
    # holding an entry that names freed memory until it next drains, which is
    # strictly worse than the refs hazard it replaces.
    # The window until the service acts is closed by the RELEASED state set just
    # above: msg_admit_one refuses a RELEASED destination under the mailbox's own
    # monitor, so a send arriving meanwhile is refused, not admitted.
    # The arena has already moved to the owner before every call site that marks
    # (adopt_mark, dispose_mark, reclaim_mark), and lmx_msg_blocks_move_all clears
    # the source owner, so the dispose inside slot_free walks an empty list; the
    # one site with no mark before it releases an uncommitted INACTIVE child,
    # which never received blocks in create_prepare.
    # A service releasing ITSELF has no letter to send and does both directly.
    if: m\service = m
        # The found-and-removed rule applies here too: free only on a real removal.
        ust: msg_service_unregister(m, m, m\addr)
        if: ust = c.LMX_MSG_OK
            c.lmx_msg_slot_free(m)
        else:
            c.lmx_msg_test_unregister_absent(rt, m, m\addr, ust, "msg_release_slot")
        ---
    else:
        # A failed post (calloc under pressure) leaves the record RELEASED and
        # unfreed rather than freed behind the service's back. It is out of the
        # family chain and its only referent is the service's live set, so the
        # teardown sweep collects it: an OOM becomes a bounded leak until the
        # runtime closes, never a use-after-free. Recorded as an accepted cost.
        msg_post_unregister(rt, m)
    ---
end: msg_release_slot

# Decision 17 with spec 19.29.8: settling a direct child into its parent,
# bottom-up. The child's own settled children are settled into it first (a
# descendant still running, not handoff-ready, is re-rooted at the runtime as
# an orphan). Then a failed child with storage is adopted into the parent, and
# any other child's storage is reclaimed. Then its slot is released. A refused
# adopt (storage_can_move INVALID, history prepare NOMEM) returns that status
# with nothing half-moved; children already settled stay settled, and the
# retry is the caller's. Authority is checked once, by the public entry.
fn: msg_first_settled_child (@: LmxMsgRuntime rt; @: LmxMsg m) @: LmxMsg
    @: LmxMsg ch
    @: LmxMsg found 0
    ch: m\first_child
    while: ch != 0 && found = 0
        # Stage 5 (d1b), spec 19.29.8: an orphan is settled only by the sweep.
        if: ch\handoff_ready != 0 && ch\native_users = 0 && ch\disposed = 0 && ch\orphan = 0 && c.lmx_msg_running_load(ch) = 0
            found: ch
        ---
        ch: ch\next_sibling
    ---
    return: found
end: msg_first_settled_child

# Decision 17 with spec 19.29.6 (iii) and stage-5 clarification (iv): a child
# of x still running when x is settled is re-rooted under R0 as an orphan,
# closing by the chain. Its arena, mailbox, record and ready flag stay; its
# supervision (parent_msg) goes to R0, and with it its address: S6-2 (SPEC
# 19.29.7, "when a Message changes parent its address changes") -- R0 mints the
# orphan's index exactly as handoff_supervision's new parent does, so the address
# composed by the walk never repeats a live R0 child's. x is settled, so the lane
# that settles it writes x's family cells.
sub: msg_orphan_children (@: LmxMsgRuntime rt; @: LmxMsg x)
    @: LmxMsg g
    int: wake
    int: more 1
    unsigned: a
    while: more != 0
        g: x\first_child
        if: g = 0
            more: 0
        else:
            msg_child_chain_remove(x, g)
            g\orphan: 1
            msg_child_link(rt\root, g)
            # An orphaning cannot fail, so an exhausted counter gives index 0, which
            # no minted index ever equals, so it never collides with a live minted
            # child's address. Two such orphans DO share [1,0] -- after about 2^32
            # R0 children -- and a letter to that address falls off, naming no child.
            if: rt\root\child_seq + 1U = 0U
                g\index: 0U
            else:
                rt\root\child_seq: rt\root\child_seq + 1U
                g\index: rt\root\child_seq
            ---
            wake: 0
            if: g\state != c.LMX_MSG_STATE_DEAD && g\state != c.LMX_MSG_STATE_RELEASED && g\state != c.LMX_MSG_STATE_STOPPED
                g\closing: 1
                wake: 1
            ---
            a: g\addr
            if: wake != 0
                msg_exec_ready(rt, a)
            ---
        ---
    ---
end: msg_orphan_children

# An orphan whose turn has left run_one: not running, handoff-ready, unused.
# Called under the exec lock.
fn: msg_orphan_settled (@: LmxMsg m) int
    return: m\orphan != 0 && m\disposed = 0 && m\native_users = 0 && c.lmx_msg_running_load(m) = 0 && m\handoff_ready != 0 && m\state != c.LMX_MSG_STATE_RELEASED
end: msg_orphan_settled

# A failed orphan's retention deadline (spec 19.29.8): now plus the runtime's
# orphan retention; 0 means no deadline, so a wrapped 0 becomes 1.
fn: msg_orphan_deadline (@: LmxMsgRuntime rt; unsigned: now) unsigned
    unsigned: d
    d: now + c.lmx_root_record_orphan_retain(rt\root_record)
    if: d = 0U
        d: 1U
    ---
    return: d
end: msg_orphan_deadline

# S2: a child address named in its parent's own turn resolves on that parent's
# child list; a caller without that turn (the host) resolves through the tree.
fn: msg_child_of_caller (@: LmxMsgRuntime rt; LmxMsgAddr: parent; LmxMsgAddr: child) @: LmxMsg
    @: LmxMsg p
    @: LmxMsg ch
    p: c.lmx_msg_turn_self(rt)
    if: p = 0 || p\addr != parent
        return: msg_self_or_find(rt, child)
    ch: p\first_child
    while: ch != 0
        if: ch\addr = child
            return: ch
        ch: ch\next_sibling
    ---
    return: 0
end: msg_child_of_caller

# S2: the settle by records. p is the parent's own record (its turn's, or the
# child being disposed in the recursion), so no address is resolved inside.
fn: msg_settle_child_msg (@: LmxMsgRuntime rt; @: LmxMsg p; @: LmxMsg child) int
    @: LmxMsg g
    int: ok
    int: failed
    int: st
    ok: p != 0 && child\parent_msg = p && p\disposed = 0 && child\disposed = 0 && child\native_users = 0 && c.lmx_msg_running_load(child) = 0 && child\handoff_ready != 0
    if: ok = 0
        return: c.LMX_MSG_INVALID
    g: msg_first_settled_child(rt, child)
    while: g != 0
        st: msg_settle_child_msg(rt, child, g)
        if: st != c.LMX_MSG_OK
            return: st
        g: msg_first_settled_child(rt, child)
    ---
    msg_orphan_children(rt, child)
    failed: c.lmx_msg_success_load(child) = 0 && (child\init != 0 || child\blocks != 0 || child\ranges != 0)
    if: failed != 0
        st: c.lmx_msg_exec_adopt_mark_msg(rt, p, child)
    else:
        st: c.lmx_msg_exec_dispose_mark_msg(rt, p, child)
    ---
    if: st != c.LMX_MSG_OK
        return: st
    msg_release_slot(rt, child)
    return: c.LMX_MSG_OK
end: msg_settle_child_msg

# The address form: the parent is found once, and the settle runs on records.
fn: msg_settle_child (@: LmxMsgRuntime rt; LmxMsgAddr: parent; @: LmxMsg child) int
    @: LmxMsg p
    p: msg_self_or_find(rt, parent)
    return: msg_settle_child_msg(rt, p, child)
end: msg_settle_child

# The parent releases a direct child: the child is settled (a failed arena is
# adopted by the runtime for the parent, a successful history reclaimed) and its
# slot released, with its settled subtree first.
fn: msg_dispose_child (@: LmxMsgRuntime rt; LmxMsgAddr: parent; LmxMsgAddr: child) int
    @: LmxMsg m
    if: rt = 0 || parent = 0U || child = 0U
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_exec_holding_turn(rt, parent) = 0
        if: c.lmx_msg_host_is_owner(rt) = 0 || c.lmx_msg_exec_holding_any(rt) != 0
            return: c.LMX_MSG_INVALID
        ---
    ---
    m: msg_child_of_caller(rt, parent, child)
    if: m = 0
        return: c.LMX_MSG_INVALID
    return: msg_settle_child(rt, parent, m)
end: msg_dispose_child

# The parent adopts a failed direct child: the same settle, keeping adopt's
# refusals of a successful child and of a child with nothing to adopt.
fn: msg_adopt_failed (@: LmxMsgRuntime rt; LmxMsgAddr: parent; LmxMsgAddr: child) int
    @: LmxMsg m
    int: ok
    if: rt = 0 || parent = 0U || child = 0U
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_exec_holding_turn(rt, parent) = 0
        if: c.lmx_msg_host_is_owner(rt) = 0 || c.lmx_msg_exec_holding_any(rt) != 0
            return: c.LMX_MSG_INVALID
        ---
    ---
    m: msg_child_of_caller(rt, parent, child)
    ok: m != 0 && c.lmx_msg_success_load(m) = 0 && (m\init != 0 || m\blocks != 0 || m\ranges != 0)
    if: ok = 0
        return: c.LMX_MSG_INVALID
    return: msg_settle_child(rt, parent, m)
end: msg_adopt_failed

# Decision 17: an orphan's own end. Its settled children settle into it, its
# still-running ones are re-rooted in turn, its storage is reclaimed (nobody
# adopts an orphan's arena) and its slot is released. The host runs it once
# the orphan's turn has left run_one; the caller checked orphan_settled.
fn: msg_reclaim_orphan (@: LmxMsgRuntime rt; @: LmxMsg m) int
    @: LmxMsg g
    int: st
    g: msg_first_settled_child(rt, m)
    while: g != 0
        st: msg_settle_child_msg(rt, m, g)
        if: st != c.LMX_MSG_OK
            return: st
        ---
        g: msg_first_settled_child(rt, m)
    ---
    msg_orphan_children(rt, m)
    st: c.lmx_msg_exec_reclaim_mark(rt, m)
    if: st != c.LMX_MSG_OK
        return: st
    ---
    msg_release_slot(rt, m)
    return: c.LMX_MSG_OK
end: msg_reclaim_orphan

# Decision 17 (spec 19.29.8), stage 5 (c): the sweep in msg_drive is the one
# settlement path for orphan roots, whether the orphan's last turn ran on the
# host or on its own context. A settled successful orphan is reclaimed at the
# root's next maintenance. A failed one gets its deadline, and once now reaches
# it the orphan is reclaimed and its arena dropped.
fn: msg_orphan_sweep (@: LmxMsgRuntime rt; unsigned: now) int
    @: LmxMsg m
    @: LmxMsg hit
    int: more 1
    int: st
    while: more != 0
        hit: 0
        # Stage 5 (d1): orphans are R0's children.
        m: rt\root
        if: m != 0
            m: m\first_child
        ---
        while: m != 0 && hit = 0
            if: msg_orphan_settled(m) != 0
                if: c.lmx_msg_success_load(m) = 0 && m\orphan_until = 0U
                    m\orphan_until: msg_orphan_deadline(rt, now)
                ---
                if: c.lmx_msg_success_load(m) != 0 || now >= m\orphan_until
                    # S6-2: the sweep took a pin so the orphan could not be freed
                    # between choosing it and reclaiming it. Nothing frees it now.
                    hit: m
                ---
            ---
            m: m\next_sibling
        ---
        if: hit = 0
            more: 0
        else:
            st: msg_reclaim_orphan(rt, hit)
            if: st != c.LMX_MSG_OK
                return: st
            ---
        ---
    ---
    return: c.LMX_MSG_OK
end: msg_orphan_sweep

sub: msg_request_children_close (@: LmxMsgRuntime rt; LmxMsgAddr: who)
    @: LmxMsg m
    @: LmxMsg ch
    if: rt = 0
        return
    m: msg_self_or_find(rt, who)
    if: m = 0
        return
    ch: m\first_child
    while: ch != 0
        if: ch\state != c.LMX_MSG_STATE_DEAD && ch\state != c.LMX_MSG_STATE_RELEASED && ch\state != c.LMX_MSG_STATE_STOPPED
            ch\closing: 1
            msg_exec_ready_msg(rt, ch)
        ---
        ch: ch\next_sibling
    ---
end: msg_request_children_close

# S6-1, SPEC 12766-12771: an unbound closing Message has no handler and no lane,
# so its close is end-turn bookkeeping written by the maintaining lane (the host's
# drive today, R0's maintenance later), not a step, and it leaves the Message
# stopped and handoff-safe so its parent's dispose or adopt can settle it. R0's
# maintenance writes that bookkeeping as its own act: end_turn admits it here, so
# no turn identity is borrowed and no held-address flag is needed.
fn: msg_maintenance_close_ok (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    if: c.lmx_msg_host_is_owner(rt) = 0
        return: 0
    if: c.lmx_msg_exec_is_bound(rt, who) != 0
        return: 0
    m: msg_find(rt, who)
    if: m = 0
        return: 0
    if: m\closing = 0
        return: 0
    if: m\exec_live != 0
        return: 0
    return: 1
end: msg_maintenance_close_ok

fn: msg_end_turn (@: LmxMsgRuntime rt; LmxMsgAddr: who; int: success) int
    @: LmxMsg m
    @: LmxMsg ch
    @: LmxMsg nxt
    @: LmxMsg root
    @: LmxMsgCopy n
    @: LmxMsgCopy outb 0
    if: msg_require_turn(rt, who) != c.LMX_MSG_OK && msg_maintenance_close_ok(rt, who) = 0
        return: c.LMX_MSG_INVALID
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: c.LMX_MSG_INVALID
    if: m\state = c.LMX_MSG_STATE_DEAD
        c.lmx_msg_mail_outbox_take(m, @ outb)
        msg_copy_free(outb)
        return: c.LMX_MSG_DEAD
    m\exec_live: 0
    m\last_beat: c.lmx_msg_now(rt)
    # Mikhail 2026-09-14: running=0 follows success=1 only here, at the turn
    # boundary; inside a turn running stays 1, so running=0 means a stop request.
    if: c.lmx_msg_success_load(m) != 0
        c.lmx_msg_running_store(m, 0)
    ---
    ch: m\first_child
    while: ch != 0
        if: c.lmx_msg_success_load(ch) != 0
            ch\tracked: 0
        ---
        ch: ch\next_sibling
    ---
    if: success = 0
        m\live_query_pend_id: 0U
        c.lmx_msg_mail_outbox_take(m, @ outb)
        msg_copy_free(outb)
        ch: m\first_child
        while: ch != 0
            nxt: ch\next_sibling
            if: ch\committed = 0 && ch\state = c.LMX_MSG_STATE_INACTIVE
                msg_release_slot(rt, ch)
            ---
            ch: nxt
        ---
        if: m\closing != 0
            m\state: c.LMX_MSG_STATE_STOPPED
            m\exec_live: 0
            ch: m\first_child
            while: ch != 0
                c.lmx_msg_running_store(ch, 0)
                msg_exec_ready_msg(rt, ch)
                ch: ch\next_sibling
            ---
            msg_request_children_close(rt, who)
        ---
        msg_arena_collect(m)
        return: c.LMX_MSG_OK
    ch: m\first_child
    while: ch != 0
        if: ch\state = c.LMX_MSG_STATE_INACTIVE
            if: ch\committed = 0
                ch\committed: 1
                ch\child_heard_at: c.lmx_msg_now(rt)
            ---
            if: msg_exec_is_runnable_msg(rt, ch) != 0
                msg_exec_ready_msg(rt, ch)
            ---
        ---
        ch: ch\next_sibling
    ---
    if: m\live_query_pend_id != 0U
        m\live_query_id: m\live_query_pend_id
        m\live_query_at: c.lmx_msg_now(rt)
        m\live_query_pend_id: 0U
    ---
    # S6-2: this Message is inside its own end-turn; nothing can free it here.
    c.lmx_msg_mail_outbox_take(m, @ outb)
    c.lmx_msg_after_outbox_xfer(rt, m, outb)
    # S6 (a): this Message's own outbox was taken and released above under its own
    # monitor; the relay onto R0's queue is a second, sequential hold.
    root: msg_ingress_root(rt)
    c.lmx_msg_mail_lock(root)
    while: outb != 0
        n: outb
        outb: n\next
        n\next: 0
        msg_q_push(@ rt\transport, @ rt\transport_tail, n)
    ---
    c.lmx_msg_mail_unlock(root)
    if: m\closing != 0
        m\state: c.LMX_MSG_STATE_STOPPED
        m\exec_live: 0
        ch: m\first_child
        while: ch != 0
            c.lmx_msg_running_store(ch, 0)
            msg_exec_ready_msg(rt, ch)
            ch: ch\next_sibling
        ---
        msg_request_children_close(rt, who)
    ---
    msg_arena_collect(m)
    # S6-2 (the drain ruling): the transport is R0's INBOX, and a Message's own data
    # is touched only on its own lane, so only R0's lane drains it. Every other
    # lane only PUSHES -- which this function already did above, moving the outbox
    # into rt\transport under R0's monitor. Draining here from an arbitrary lane is
    # what let msg_service_register / msg_service_unregister (which realloc and
    # shift the live set) run on two lanes at once. R0 ending its own turn IS R0's
    # round, so it drains; any other Message returns having pushed, and its letters
    # are delivered in R0's next round.
    if: who = msg_root_addr(rt)
        return: msg_pump(rt)
    ---
    return: c.LMX_MSG_OK
end: msg_end_turn

# S6-2, SPEC 19.29.7 (respecified 2026-09-16): a capability is the target's ID,
# and "a late send resolves the id and is refused with a status when the target is
# not found or closed". The refusal is the mail service's act -- the service is R0,
# which resolves every send in its own drain -- and this is the status it sends
# back. Modelled on msg_post_dead, the same shape of unsolicited notice. It takes
# R0's monitor on its own and holds no other when it does.
fn: msg_post_rejected (@: LmxMsgRuntime rt; LmxMsgAddr: from; LmxMsgAddr: to; unsigned: correlation) int
    @: LmxMsgCopy entry
    @: LmxMsg root
    if: rt = 0 || to = 0U || to = from
        return: c.LMX_MSG_OK
    if: msg_self_or_find(rt, to) = 0
        return: c.LMX_MSG_GONE
    ---
    entry: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: entry = 0
        return: c.LMX_MSG_NOMEM
    entry\from: from
    entry\to: to
    entry\kind: c.LMX_MSG_KIND_REJECTED
    entry\id: correlation
    entry\correlation: correlation
    entry\number: (cast: (int) from)
    root: msg_ingress_root(rt)
    c.lmx_msg_mail_lock(root)
    msg_q_push(@ rt\transport, @ rt\transport_tail, entry)
    c.lmx_msg_mail_unlock(root)
    return: c.LMX_MSG_OK
end: msg_post_rejected

fn: msg_admit_one (@: LmxMsgRuntime rt; @: LmxMsgCopy entry) int
    @: LmxMsg dest
    @: LmxMsgCopy fresh
    @: LmxMsgCopy put
    unsigned: dest_addr
    int: ust
    if: rt = 0 || entry = 0
        msg_copy_free(entry)
        return: c.LMX_MSG_INVALID
    # S6-2 (SPEC 19.29.7): a registration letter, intercepted BEFORE the
    # destination resolution below. Its dest_msg is the PAYLOAD -- the record
    # being registered -- not a delivery target, so letting it fall through would
    # admit a Message's own handle into its own inbox. This runs on the drain's
    # lane, which is the service's, so the live set is written by its owner. The
    # id travels in to, so the drain registers the pair without dereferencing the
    # record to ask it what its id is.
    if: entry\kind = c.LMX_MSG_KIND_REGISTER
        if: entry\dest_msg != 0
            msg_service_register(msg_service_of(entry\dest_msg), entry\dest_msg, entry\to)
        ---
        msg_copy_free(entry)
        return: c.LMX_MSG_OK
    ---
    # S6-2 (the removal ruling): unregister-and-free, the opposite act, and the
    # ORDER is the point -- the entry goes first, then the record is freed, both
    # on this lane, so there is never a moment when the set names freed memory.
    # The record is still readable here: msg_release_slot left it RELEASED and
    # unfreed precisely so that this lane could be the one to free it.
    if: entry\kind = c.LMX_MSG_KIND_UNREGISTER
        if: entry\dest_msg != 0
            # S6-2 (the found-and-removed ruling): free ONLY an entry this call
            # actually removed. The service is rt\root: this is R0's drain, and
            # asking the record for its service would read the record first.
            ust: msg_service_unregister(rt\root, entry\dest_msg, entry\to)
            if: ust = c.LMX_MSG_OK
                c.lmx_msg_slot_free(entry\dest_msg)
            else:
                c.lmx_msg_test_unregister_absent(rt, entry\dest_msg, entry\to, ust, "msg_admit_one")
            ---
        ---
        msg_copy_free(entry)
        return: c.LMX_MSG_OK
    ---
    dest: entry\dest_msg
    # S6-2 (step 3, the send through the service): delivery by memory address is
    # safe with no count of holders ONLY because the service checks its live set
    # BEFORE touching the record. dest_msg is a handle a sender kept; the record it
    # names may have been released and freed by an unregister-and-free letter that
    # drained earlier in this very drain (FIFO). So nothing below may read dest
    # until is_live says the pointer AND its id are still registered.
    # The service here is rt\root, never dest\service: reading dest\service would be
    # the dereference this check exists to prevent, and since only R0's lane drains
    # the transport, the service in this drain IS R0.
    # A REJECTED letter is never itself refused: msg_pump keeps popping while
    # msg_post_rejected pushes, so refusing a refusal to a vanished sender would loop.
    # msg_self_or_find below needs no check -- it walks the live tree and returns
    # only a record that is still there.
    if: dest != 0 && msg_service_is_live(rt\root, dest, entry\to) = 0
        if: entry\kind != c.LMX_MSG_KIND_REJECTED
            msg_post_rejected(rt, entry\to, entry\from, entry\correlation)
        ---
        msg_copy_free(entry)
        return: c.LMX_MSG_GONE
    ---
    if: dest = 0
        dest: msg_self_or_find(rt, entry\to)
    ---
    if: dest != 0 && dest\owner_rt != rt
        msg_copy_free(entry)
        return: c.LMX_MSG_GONE
    ---
    if: dest = 0 || dest\state = c.LMX_MSG_STATE_DEAD || dest\state = c.LMX_MSG_STATE_STOPPED
        msg_copy_free(entry)
        return: c.LMX_MSG_GONE
    if: dest\state = c.LMX_MSG_STATE_INACTIVE && dest\committed = 0
        msg_copy_free(entry)
        return: c.LMX_MSG_GONE
    if: entry\id != 0U && msg_done_has(dest, entry\from, entry\id) != 0
        msg_copy_free(entry)
        return: c.LMX_MSG_DUPLICATE
    if: dest\state = c.LMX_MSG_STATE_INACTIVE
        dest\state: c.LMX_MSG_STATE_RUNNING
    ---
    if: entry\kind = c.LMX_MSG_KIND_STOP
        dest\closing: 1
        msg_copy_free(entry)
        return: c.LMX_MSG_OK
    ---
    # S6-2: the destination was pinned from here until the push below, so it could
    # not be freed between the checks and the admission. Nothing frees it now.
    dest_addr: dest\addr
    if: entry\owned != 0 || entry\delivered != 0
        if: entry\id != 0U && msg_done_add(dest, entry\from, entry\id) != 0
            msg_copy_free(entry)
            return: c.LMX_MSG_NOMEM
        ---
        put: entry
    else:
        fresh: msg_copy_dup(entry)
        msg_copy_free(entry)
        if: fresh = 0
            return: c.LMX_MSG_NOMEM
        ---
        if: fresh\id != 0U && msg_done_add(dest, fresh\from, fresh\id) != 0
            msg_copy_free(fresh)
            return: c.LMX_MSG_NOMEM
        ---
        put: fresh
    ---
    c.lmx_msg_mail_lock(dest)
    msg_q_push(@ dest\inbox, @ dest\inbox_tail, put)
    c.lmx_msg_mail_unlock(dest)
    c.lmx_msg_test_on_admit(dest_addr, put)
    # S2/S6-2: ready it by its record. The record is reached directly, not through
    # a pin: the address lookup it replaced is what the pin used to protect.
    msg_exec_ready_msg(rt, dest)
    return: c.LMX_MSG_OK
end: msg_admit_one

fn: msg_pump (@: LmxMsgRuntime rt) int
    @: LmxMsgCopy n
    @: LmxMsg root
    int: st
    # S6-2 (the drain ruling): only R0's lane drains the transport, and admit_one
    # writes R0's live set, so pump requires the owner -- the host, which runs R0's
    # turns. The fallback that let any lane holding a turn pump served "every
    # end_turn drains", which the ruling ended; kept, a mapped child's turn calling
    # pump would write the live set off R0's lane.
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    ---
    # S6 (a): the take is under R0's mailbox monitor and is left before admit_one
    # takes MAIL on the destination, so the two mailboxes are held in sequence.
    root: msg_ingress_root(rt)
    c.lmx_msg_mail_lock(root)
    while: rt\transport != 0
        n: msg_q_pop(@ rt\transport, @ rt\transport_tail)
        c.lmx_msg_mail_unlock(root)
        st: msg_admit_one(rt, n)
        if: st = c.LMX_MSG_NOMEM
            return: st
        ---
        c.lmx_msg_mail_lock(root)
    ---
    c.lmx_msg_mail_unlock(root)
    return: c.LMX_MSG_OK
end: msg_pump

fn: msg_recv (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: LmxMsgEnv out) int
    @: LmxMsg m
    @: LmxMsgCopy n
    if: msg_require_turn(rt, who) != c.LMX_MSG_OK || out = 0
        return: c.LMX_MSG_INVALID
    m: c.lmx_msg_turn_self(rt)
    if: m != 0 && m\addr = who
        n: c.lmx_msg_mail_inbox_pop_input(m)
        if: n = 0
            return: c.LMX_MSG_EMPTY
        ---
        out\id: n\id
        out\correlation: n\correlation
        out\reply_to: n\reply_to
        out\kind: n\kind
        out\number: n\number
        out\n: n\n
        out\bytes: n\bytes
        n\bytes: 0
        out\graph: 0
        if: msg_delivery_receive(m, n, out) != c.LMX_MSG_OK
            msg_copy_free(n)
            return: c.LMX_MSG_INVALID
        ---
        m\exec_id: n\id
        m\exec_corr: n\correlation
        m\exec_from: n\from
        m\exec_reply: n\reply_to
        m\exec_live: 1
        m\last_beat: c.lmx_msg_now(rt)
        msg_copy_free(n)
        return: c.LMX_MSG_OK
    ---
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: c.LMX_MSG_INVALID
    # S6-2: recv pinned the receiver across the pop. The hook stays -- it is the
    # test's window into this point -- but it is no longer conditional on a count.
    c.lmx_msg_after_recv_pin(rt, m)
    n: c.lmx_msg_mail_inbox_pop_input(m)
    if: n = 0
        return: c.LMX_MSG_EMPTY
    ---
    out\id: n\id
    out\correlation: n\correlation
    out\reply_to: n\reply_to
    out\kind: n\kind
    out\number: n\number
    out\n: n\n
    out\bytes: n\bytes
    n\bytes: 0
    out\graph: 0
    if: msg_delivery_receive(m, n, out) != c.LMX_MSG_OK
        msg_copy_free(n)
        return: c.LMX_MSG_INVALID
    ---
    m\exec_id: n\id
    m\exec_corr: n\correlation
    m\exec_from: n\from
    m\exec_reply: n\reply_to
    m\exec_live: 1
    m\last_beat: c.lmx_msg_now(rt)
    msg_copy_free(n)
    return: c.LMX_MSG_OK
end: msg_recv

sub: msg_env_release (@: LmxMsgEnv env)
    if: env = 0
        return
    if: env\bytes != 0
        c.free((cast: (@: void) env\bytes))
    ---
    env\bytes: 0
    env\n: 0U
    # A received graph already belongs to the handler's arena.
    env\graph: 0
end: msg_env_release

# S6-2 (SPEC 19.29.7): the registration letter, modelled on msg_post_dead -- the
# same shape of unsolicited notice, with R0's monitor taken and left on its own.
# It carries the record itself in dest_msg, which for this kind is the payload and
# not a delivery target, and the id in to; msg_admit_one intercepts it before any
# destination is resolved. Posted by the creating lane, drained by the service's,
# which is what keeps the live set single-writer.
# S6-2: teardown's collector for records the service never got to free -- see the
# call in msg_runtime_delete for why they exist and why this runs before
# msg_teardown_free. R0 itself is skipped: teardown_free frees it, and freeing it
# here would leave the walk below reading a freed record.
# [S6-2: the three functions this comment introduced were MOVED above
# msg_runtime_delete -- lm2 has no forward-declaration block, and L1 emits in
# source order without hoisting. See them after end: msg_teardown_free.]

fn: msg_post_dead (@: LmxMsgRuntime rt; LmxMsgAddr: from; LmxMsgAddr: to; unsigned: correlation) int
    @: LmxMsgCopy entry
    @: LmxMsg root
    if: rt = 0 || to = 0U || to = from
        return: c.LMX_MSG_OK
    if: msg_self_or_find(rt, to) = 0
        return: c.LMX_MSG_GONE
    if: c.lmx_msg_test_post_dead_fail() != 0
        return: c.LMX_MSG_NOMEM
    ---
    entry: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: entry = 0
        return: c.LMX_MSG_NOMEM
    entry\from: from
    entry\to: to
    entry\kind: c.LMX_MSG_KIND_DEAD
    entry\id: correlation
    entry\correlation: correlation
    entry\number: (cast: (int) from)
    # S6 (a): the caller (msg_fail) holds no mailbox monitor here, so this is R0's
    # monitor taken and left on its own.
    root: msg_ingress_root(rt)
    c.lmx_msg_mail_lock(root)
    msg_q_push(@ rt\transport, @ rt\transport_tail, entry)
    c.lmx_msg_mail_unlock(root)
    return: c.LMX_MSG_OK
end: msg_post_dead

fn: msg_fail (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    @: LmxMsgCopy n
    @: LmxMsgCopy inb 0
    @: LmxMsgCopy outb 0
    @: LmxMsgCopy prev 0
    unsigned: parent
    unsigned: req
    if: msg_require_turn(rt, who) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: c.LMX_MSG_INVALID
    m\state: c.LMX_MSG_STATE_DEAD
    parent: msg_parent_id(m)
    req: m\exec_id
    # S6-2: fail pinned m across its post_dead calls and its mailbox work. Nothing
    # frees a record now, and m is this turn's own Message throughout.
    if: m\exec_live != 0 && m\exec_reply != 0U && m\exec_reply != parent
        if: msg_post_dead(rt, who, m\exec_reply, req) = c.LMX_MSG_NOMEM
            return: c.LMX_MSG_NOMEM
        ---
    ---
    c.lmx_msg_mail_outbox_take(m, @ outb)
    msg_copy_free(outb)
    c.lmx_msg_mail_inbox_take(m, @ inb)
    n: inb
    prev: 0
    while: n != 0
        if: n\reply_to != 0U && n\reply_to != parent && (m\exec_live = 0 || n\reply_to != m\exec_reply)
            req: n\id
            if: msg_post_dead(rt, who, n\reply_to, req) = c.LMX_MSG_NOMEM
                if: prev != 0
                    prev\next: 0
                else:
                    inb: 0
                ---
                msg_copy_free(inb)
                c.lmx_msg_mail_inbox_prepend(m, n)
                return: c.LMX_MSG_NOMEM
            ---
        ---
        prev: n
        n: n\next
    ---
    msg_copy_free(inb)
    m\exec_live: 0
    if: parent != 0U
        if: msg_post_dead(rt, who, parent, m\exec_id) = c.LMX_MSG_NOMEM
            return: c.LMX_MSG_NOMEM
        ---
    ---
    # S6-2 (the drain ruling): push-only, as in msg_end_turn. msg_post_dead above
    # already pushed the notice into R0's transport; delivering it is R0's round,
    # not this failing Message's. R0 failing is its own round and drains.
    if: who = msg_root_addr(rt)
        return: msg_pump(rt)
    ---
    return: c.LMX_MSG_OK
end: msg_fail

fn: msg_parent_gone (@: LmxMsgRuntime rt; @: LmxMsg child; unsigned: now; unsigned: threshold) int
    @: LmxMsg p
    unsigned: idle
    if: child = 0 || child\parent_msg = 0
        return: 0
    p: child\parent_msg
    if: p = 0
        return: 1
    if: p\state = c.LMX_MSG_STATE_DEAD || p\state = c.LMX_MSG_STATE_STOPPED || p\state = c.LMX_MSG_STATE_RELEASED
        return: 1
    if: p\exec_live != 0 && threshold != 0U
        idle: now
        if: now >= p\last_beat
            idle: now - p\last_beat
        ---
        if: idle > threshold
            return: 1
        ---
    ---
    return: 0
end: msg_parent_gone

fn: msg_poll_mark (@: LmxMsgRuntime rt; @: LmxMsg m; unsigned: now; unsigned: threshold; @: LmxMsgAddr out; int: cap; int: n) int
    if: m = 0
        return: n
    if: m\parent_msg != 0 && (m\state = c.LMX_MSG_STATE_RUNNING || (m\state = c.LMX_MSG_STATE_INACTIVE && m\committed != 0))
        if: msg_parent_gone(rt, m, now, threshold) != 0
            m\closing: 1
            msg_exec_ready(rt, m\addr)
            if: out != 0 && n < cap
                out[n]: m\addr
            ---
            n: n + 1
        ---
    ---
    return: n
end: msg_poll_mark

fn: msg_poll_kids (@: LmxMsgRuntime rt; @: LmxMsg m; unsigned: now; unsigned: threshold; @: LmxMsgAddr out; int: cap; int: n) int
    @: LmxMsg ch
    if: m = 0
        return: n
    ch: m\first_child
    while: ch != 0
        n: msg_poll_mark(rt, ch, now, threshold, out, cap, n)
        n: msg_poll_kids(rt, ch, now, threshold, out, cap, n)
        ch: ch\next_sibling
    ---
    return: n
end: msg_poll_kids

fn: msg_poll (@: LmxMsgRuntime rt; LmxMsgAddr: who; unsigned: now; unsigned: threshold; @: LmxMsgAddr out; int: cap) int
    @: LmxMsg m
    int: n 0
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: -1
    if: who != 0U
        m: msg_self_or_find(rt, who)
        n: msg_poll_mark(rt, m, now, threshold, out, cap, n)
    else:
        # S5: R0 is the one root.
        if: rt\root != 0
            n: msg_poll_kids(rt, rt\root, now, threshold, out, cap, n)
        ---
    ---
    return: n
end: msg_poll

# Stage 5 (e): the clock is R0's management state, written only on R0's lane:
# R0's own turn, or until (f) the host outside any turn. Refused, nothing moves.
fn: msg_set_now (@: LmxMsgRuntime rt; unsigned: now) int
    if: rt = 0 || rt\root = 0
        return: c.LMX_MSG_INVALID
    if: c.lmx_msg_exec_holding_turn(rt, rt\root\addr) = 0 && (c.lmx_msg_host_is_owner(rt) = 0 || c.lmx_msg_exec_holding_any(rt) != 0)
        return: c.LMX_MSG_INVALID
    # Created at the first set on R0's lane, as a parent's scheduler record is at
    # its first step: runtime_new cannot call the generated unit (6f's rule).
    if: rt\root_record = 0
        rt\root_record: c.lmx_root_record_new(rt\root)
        if: rt\root_record = 0
            return: c.LMX_MSG_NOMEM
        ---
    ---
    if: c.lmx_root_record_set_clock(rt\root_record, now) != c.LMX_MSG_OK || c.lmx_root_record_set_clock_test(rt\root_record, 1) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    return: c.LMX_MSG_OK
end: msg_set_now

fn: msg_drive_should_close (@: LmxMsg m) int
    if: m = 0
        return: 0
    if: m\closing = 0 || m\exec_live != 0
        return: 0
    if: m\state = c.LMX_MSG_STATE_RUNNING
        return: 1
    if: m\state = c.LMX_MSG_STATE_INACTIVE && m\committed != 0
        return: 1
    return: 0
end: msg_drive_should_close

fn: msg_drive_one (@: LmxMsgRuntime rt; @: LmxMsg m) int
    unsigned: a 0U
    int: st
    if: m = 0
        return: c.LMX_MSG_OK
    # S6-2: drive_one pinned m across its unlocked checks. The re-checks below --
    # still closing, inbox still empty, same address, not RELEASED -- are what
    # actually guard the decision, and they stay.
    if: msg_drive_should_close(m) = 0
        return: c.LMX_MSG_OK
    ---
    a: m\addr
    if: c.lmx_msg_mail_inbox_empty(m) = 0
        return: c.LMX_MSG_OK
    ---
    if: msg_drive_should_close(m) = 0 || m\addr != a || m\state = c.LMX_MSG_STATE_RELEASED
        return: c.LMX_MSG_OK
    ---
    if: c.lmx_msg_exec_is_bound(rt, a) != 0
        msg_exec_ready(rt, a)
    ---
    if: c.lmx_msg_exec_is_bound(rt, a) = 0
        st: c.lmx_msg_exec_unbound_close(rt, a)
        if: st != c.LMX_MSG_OK
            return: st
        ---
    ---
    return: c.LMX_MSG_OK
end: msg_drive_one

fn: msg_drive_tree (@: LmxMsgRuntime rt; @: LmxMsg m) int
    int: st
    if: m = 0
        return: c.LMX_MSG_OK
    st: msg_drive_one(rt, m)
    if: st != c.LMX_MSG_OK
        return: st
    return: c.lmx_msg_drive_walk_children(rt, m)
end: msg_drive_tree

# Stage 5 (c): the root's self-maintenance between its turns, with the drain's
# authority (the host outside any turn): the clock, the liveness poll, the
# orphan sweep, the walk, the pump.
fn: msg_drive (@: LmxMsgRuntime rt; unsigned: now; unsigned: threshold) int
    @: LmxMsgAddr none
    int: st
    if: msg_require_owner(rt) != c.LMX_MSG_OK || c.lmx_msg_exec_holding_any(rt) != 0
        return: c.LMX_MSG_INVALID
    st: msg_set_now(rt, now)
    if: st != c.LMX_MSG_OK
        return: st
    none: 0
    st: msg_poll(rt, 0U, now, threshold, none, 0)
    if: st < 0
        return: c.LMX_MSG_INVALID
    ---
    st: msg_orphan_sweep(rt, now)
    if: st != c.LMX_MSG_OK
        return: st
    ---
    st: c.lmx_msg_drive_walk_roots(rt)
    if: st != c.LMX_MSG_OK
        return: st
    ---
    st: msg_pump(rt)
    if: st != c.LMX_MSG_OK
        return: st
    return: c.LMX_MSG_OK
end: msg_drive

fn: msg_state (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    int: s
    m: msg_turn_slot(rt, who)
    if: m != 0
        return: m\state
    ---
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: -1
    ---
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: -1
    s: m\state
    return: s
end: msg_state

fn: msg_inbox_n (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    int: cnt 0
    m: msg_turn_slot(rt, who)
    if: m != 0
        return: c.lmx_msg_mail_inbox_n(m)
    ---
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: -1
    ---
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: -1
    cnt: c.lmx_msg_mail_inbox_n(m)
    return: cnt
end: msg_inbox_n

# S6-2 (SPEC 19.29.7, Mikhail's getAddress): the public address composer. It
# resolves the Message the way msg_inbox_n already does -- the turn's own slot
# first, otherwise the owner's lane and a find -- and then walks the parent links.
# Returns the number of indices, or -1 when the Message is not reachable; fills
# out[0..n-1] root-first when out is non-zero and cap is at least n, and otherwise
# returns the count while writing nothing, so a caller can size its buffer first.
# Nothing is allocated, so there is no free-partner to owe.
fn: msg_get_address (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: unsigned out; int: cap) int
    @: LmxMsg m
    m: msg_turn_slot(rt, who)
    if: m != 0
        return: msg_address_of(m, out, cap)
    ---
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: -1
    ---
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: -1
    ---
    return: msg_address_of(m, out, cap)
end: msg_get_address

# S6-2 (SPEC 19.29.7, the common mail API's SECOND ENTRY; ruled 2026-09-16 on
# Mikhail's fourteenth line): send by string address. The service's body today
# delivers nothing by string address: the hop-by-hop chain needs each holder's own
# round to look at a hop letter, and the bootstrap executor cannot run the round of
# a Message with no bound turn, so the chain waits for its stage. What is written
# now is the interface, so no caller changes when the body is swapped: the service
# refuses with KIND_REJECTED to the sender and returns LMX_MSG_UNDELIVERABLE. It
# reads no other Message's links -- only its own addr and the sender's handle.
fn: msg_service_send_address (@: LmxMsgRuntime rt; @: LmxMsg svc; LmxMsgAddr: from; const: @(unsigned addr); int: addr_n; const: @(LmxMsgEnv env)) int
    int: pst
    if: rt = 0 || svc = 0 || addr = 0 || addr_n < 1 || env = 0
        return: c.LMX_MSG_INVALID
    ---
    pst: msg_post_rejected(rt, svc\addr, from, env\correlation)
    if: pst = c.LMX_MSG_NOMEM
        return: pst
    ---
    return: c.LMX_MSG_UNDELIVERABLE
end: msg_service_send_address

# The default body every L3 Thread carries: read the sender's own service reference
# and delegate. The sender is inside its own turn, so its record cannot be freed
# under the call.
fn: msg_send_address (@: LmxMsgRuntime rt; LmxMsgAddr: from; const: @(unsigned addr); int: addr_n; const: @(LmxMsgEnv env)) int
    @: LmxMsg src
    if: msg_require_turn(rt, from) != c.LMX_MSG_OK || env = 0 || from = 0U
        return: c.LMX_MSG_INVALID
    ---
    # AD (2026-09-16): the sender as the pair the ruling gives a target. A caller
    # that holds the record (the turn's own, create's result, the answered
    # letter) passes it and nothing is resolved; the id is checked against the
    # record's own addr, because malloc reuses addresses and ids never are.
    src: env\from_msg
    if: src = 0 || src\addr != from
        src: msg_self_or_find(rt, from)
    ---
    if: src = 0
        return: c.LMX_MSG_INVALID
    ---
    return: msg_service_send_address(rt, msg_service_of(src), from, addr, addr_n, env)
end: msg_send_address

fn: msg_child_n (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    @: LmxMsg ch
    int: n 0
    m: msg_turn_slot(rt, who)
    if: m != 0
        ch: m\first_child
        while: ch != 0
            n: n + 1
            ch: ch\next_sibling
        ---
        return: n
    ---
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: -1
    ---
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: -1
    ch: m\first_child
    while: ch != 0
        n: n + 1
        ch: ch\next_sibling
    ---
    return: n
end: msg_child_n

fn: msg_child_at (@: LmxMsgRuntime rt; LmxMsgAddr: who; int: i) unsigned
    @: LmxMsg m
    @: LmxMsg ch
    int: k 0
    unsigned: a 0U
    if: i < 0
        return: 0U
    m: msg_turn_slot(rt, who)
    if: m != 0
        ch: m\first_child
        while: ch != 0
            if: k = i
                return: ch\addr
            ---
            k: k + 1
            ch: ch\next_sibling
        ---
        return: 0U
    ---
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: 0U
    ---
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: 0U
    ch: m\first_child
    while: ch != 0
        if: k = i
            a: ch\addr
            return: a
        ---
        k: k + 1
        ch: ch\next_sibling
    ---
    return: 0U
end: msg_child_at

fn: msg_init_copy (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: LmxMsgEnv out) int
    @: LmxMsg m
    @: uchar initp
    size_t: n
    unsigned: parent
    if: out = 0
        return: c.LMX_MSG_INVALID
    m: msg_turn_slot(rt, who)
    if: m != 0
        parent: msg_parent_id(m)
        n: m\init_n
        initp: msg_copy_bytes(m\init, n)
        if: n != 0U && initp = 0
            return: c.LMX_MSG_NOMEM
        ---
        out\id: 0U
        out\correlation: 0U
        out\reply_to: parent
        out\kind: c.LMX_MSG_KIND_BYTES
        out\number: 0
        out\n: n
        out\bytes: initp
        return: c.LMX_MSG_OK
    ---
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    ---
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: c.LMX_MSG_INVALID
    parent: msg_parent_id(m)
    n: m\init_n
    initp: msg_copy_bytes(m\init, n)
    if: n != 0U && initp = 0
        return: c.LMX_MSG_NOMEM
    out\id: 0U
    out\correlation: 0U
    out\reply_to: parent
    out\kind: c.LMX_MSG_KIND_BYTES
    out\number: 0
    out\n: n
    out\bytes: initp
    return: c.LMX_MSG_OK
end: msg_init_copy

fn: msg_live_query (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    @: LmxMsgEnv env
    unsigned: parent 0U
    unsigned: qid 0U
    int: st
    if: msg_require_turn(rt, who) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    m: msg_turn_slot(rt, who)
    if: m = 0
        m: msg_self_or_find(rt, who)
        if: m = 0 || m\parent_msg = 0
            return: c.LMX_MSG_INVALID
        ---
        if: m\live_query_id != 0U || m\live_query_pend_id != 0U
            return: c.LMX_MSG_OK
        ---
        if: m\live_seq = 4294967295U
            return: c.LMX_MSG_NOMEM
        ---
        m\live_seq: m\live_seq + 1U
        qid: m\live_seq
        parent: msg_parent_id(m)
    ---
    if: m != 0 && qid = 0U
        if: m\parent_msg = 0
            return: c.LMX_MSG_INVALID
        ---
        if: m\live_query_id != 0U || m\live_query_pend_id != 0U
            return: c.LMX_MSG_OK
        ---
        if: m\live_seq = 4294967295U
            return: c.LMX_MSG_NOMEM
        ---
        m\live_seq: m\live_seq + 1U
        qid: m\live_seq
        parent: msg_parent_id(m)
    ---
    env: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    if: env = 0
        return: c.LMX_MSG_NOMEM
    env\kind: c.LMX_MSG_KIND_PROGRESS
    env\number: c.LMX_MSG_PROF_LIVE_Q
    env\correlation: qid
    env\reply_to: who
    st: msg_send(rt, who, parent, env)
    c.free((cast: (@: void) env))
    if: st != c.LMX_MSG_STAGED
        return: st
    m: msg_turn_slot(rt, who)
    if: m != 0
        m\live_query_pend_id: qid
        m\live_query_pend_at: c.lmx_msg_now(rt)
    ---
    if: m = 0
        m: msg_self_or_find(rt, who)
        if: m != 0
            m\live_query_pend_id: qid
            m\live_query_pend_at: c.lmx_msg_now(rt)
        ---
    ---
    return: st
end: msg_live_query

fn: msg_live_handle (@: LmxMsgRuntime rt; LmxMsgAddr: who; const: @(LmxMsgEnv env)) int
    @: LmxMsg m
    @: LmxMsg ch
    @: LmxMsgEnv out
    unsigned: from 0U
    unsigned: dest 0U
    unsigned: qid 0U
    int: st
    if: msg_require_turn(rt, who) != c.LMX_MSG_OK || env = 0
        return: c.LMX_MSG_INVALID
    if: env\kind != c.LMX_MSG_KIND_PROGRESS
        return: c.LMX_MSG_OK
    m: msg_turn_slot(rt, who)
    if: m != 0
        if: m\exec_live = 0
            return: c.LMX_MSG_INVALID
        ---
        from: m\exec_from
        if: env\number = c.LMX_MSG_PROF_LIVE_R
            if: from = msg_parent_id(m) && env\correlation != 0U && env\correlation = m\live_query_id
                m\live_query_id: 0U
            ---
            return: c.LMX_MSG_OK
        ---
        if: env\number != c.LMX_MSG_PROF_LIVE_Q
            return: c.LMX_MSG_OK
        ---
        ch: m\first_child
        while: ch != 0
            if: ch\addr = from
                ch\child_heard_at: c.lmx_msg_now(rt)
                dest: from
                qid: env\correlation
                ch: 0
            ---
            if: ch != 0
                ch: ch\next_sibling
            ---
        ---
    ---
    if: m = 0
        m: msg_self_or_find(rt, who)
        if: m = 0 || m\exec_live = 0
            return: c.LMX_MSG_INVALID
        ---
        from: m\exec_from
        if: env\number = c.LMX_MSG_PROF_LIVE_R
            if: from = msg_parent_id(m) && env\correlation != 0U && env\correlation = m\live_query_id
                m\live_query_id: 0U
            ---
            return: c.LMX_MSG_OK
        ---
        if: env\number != c.LMX_MSG_PROF_LIVE_Q
            return: c.LMX_MSG_OK
        ---
        ch: m\first_child
        dest: 0U
        while: ch != 0
            if: ch\addr = from
                ch\child_heard_at: c.lmx_msg_now(rt)
                dest: from
                qid: env\correlation
                ch: 0
            ---
            if: ch != 0
                ch: ch\next_sibling
            ---
        ---
    ---
    if: dest = 0U
        return: c.LMX_MSG_OK
    out: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    if: out = 0
        return: c.LMX_MSG_NOMEM
    out\kind: c.LMX_MSG_KIND_PROGRESS
    out\number: c.LMX_MSG_PROF_LIVE_R
    out\correlation: qid
    out\reply_to: who
    st: msg_send(rt, who, dest, out)
    c.free((cast: (@: void) out))
    return: st
end: msg_live_handle

fn: msg_live_check (@: LmxMsgRuntime rt; LmxMsgAddr: who; unsigned: now; unsigned: threshold) int
    @: LmxMsg m
    @: LmxMsg ch
    @: LmxMsg nxt
    unsigned: wake 0U
    int: n 0
    if: c.lmx_msg_exec_holding_turn(rt, who) = 0
        if: c.lmx_msg_host_is_owner(rt) = 0 || c.lmx_msg_exec_holding_any(rt) != 0
            return: -1
        ---
    ---
    m: msg_turn_slot(rt, who)
    if: m != 0
        if: m\live_query_id != 0U && threshold != 0U && now > m\live_query_at && (now - m\live_query_at) > threshold
            m\closing: 1
            n: n + 1
            msg_exec_ready(rt, who)
        ---
        ch: m\first_child
        while: ch != 0
            wake: 0U
            nxt: ch\next_sibling
            if: ch\mapped = 0 && ch\tracked != 0 && ch\committed != 0 && ch\state != c.LMX_MSG_STATE_DEAD && ch\state != c.LMX_MSG_STATE_STOPPED && ch\state != c.LMX_MSG_STATE_RELEASED
                if: threshold != 0U && now > ch\child_heard_at && (now - ch\child_heard_at) > threshold
                    ch\closing: 1
                    n: n + 1
                    wake: ch\addr
                ---
            ---
            if: wake != 0U
                msg_exec_ready(rt, wake)
            ---
            ch: nxt
        ---
        return: n
    ---
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: -1
    if: m\live_query_id != 0U && threshold != 0U && now > m\live_query_at && (now - m\live_query_at) > threshold
        m\closing: 1
        n: n + 1
        msg_exec_ready(rt, who)
        m: msg_self_or_find(rt, who)
        if: m = 0
            return: n
        ---
    ---
    ch: m\first_child
    while: ch != 0
        wake: 0U
        nxt: ch\next_sibling
        if: ch\tracked != 0 && ch\committed != 0 && ch\state != c.LMX_MSG_STATE_DEAD && ch\state != c.LMX_MSG_STATE_STOPPED && ch\state != c.LMX_MSG_STATE_RELEASED
            if: threshold != 0U && now > ch\child_heard_at && (now - ch\child_heard_at) > threshold
                ch\closing: 1
                n: n + 1
                wake: ch\addr
            ---
        ---
        if: wake != 0U
            msg_exec_ready(rt, wake)
        ---
        ch: nxt
    ---
    return: n
end: msg_live_check

fn: msg_live_test_set_seq (@: LmxMsgRuntime rt; LmxMsgAddr: who; unsigned: v) int
    @: LmxMsg m
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: c.LMX_MSG_INVALID
    m\live_seq: v
    return: c.LMX_MSG_OK
end: msg_live_test_set_seq

fn: msg_live_test_set_wait_th (@: LmxMsgRuntime rt; LmxMsgAddr: who; unsigned: th) int
    @: LmxMsg m
    if: msg_require_owner(rt) != c.LMX_MSG_OK
        return: c.LMX_MSG_INVALID
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: c.LMX_MSG_INVALID
    m\live_wait_th: th
    return: c.LMX_MSG_OK
end: msg_live_test_set_wait_th

fn: msg_complete (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    if: c.lmx_msg_exec_holding_turn(rt, who) = 0
        if: c.lmx_msg_host_is_owner(rt) = 0 || c.lmx_msg_exec_holding_any(rt) != 0
            return: c.LMX_MSG_INVALID
        ---
    ---
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: c.LMX_MSG_INVALID
    # Mikhail 2026-09-14: the child declares its work done (success=1); running
    # is cleared from success only at the turn boundary, in end_turn.
    c.lmx_msg_success_store(m, 1)
    m\closing: 1
    msg_exec_ready(rt, who)
    return: c.LMX_MSG_OK
end: msg_complete

fn: msg_tracked (@: LmxMsgRuntime rt; LmxMsgAddr: who) int
    @: LmxMsg m
    int: t 0
    if: rt = 0 || who = 0U
        return: -1
    m: msg_self_or_find(rt, who)
    if: m = 0
        return: -1
    t: m\tracked
    return: t
end: msg_tracked

fn: msg_send_cap (@: LmxMsgRuntime rt; LmxMsgAddr: from; @: LmxMsg dest; const: @(LmxMsgEnv env)) int
    @: LmxMsg src
    @: LmxMsgCopy entry
    if: msg_require_turn(rt, from) != c.LMX_MSG_OK || env = 0 || from = 0U || dest = 0
        return: c.LMX_MSG_INVALID
    entry: (cast: (@: LmxMsgCopy) c.calloc(1U, c.sizeof(c.LmxMsgCopy)))
    if: entry = 0
        return: c.LMX_MSG_NOMEM
    entry\id: env\id
    entry\correlation: env\correlation
    entry\reply_to: env\reply_to
    entry\from: from
    entry\to: dest\addr
    entry\kind: env\kind
    entry\number: env\number
    entry\n: env\n
    entry\bytes: msg_copy_bytes(env\bytes, env\n)
    if: env\n != 0U && entry\bytes = 0
        c.free((cast: (@: void) entry))
        return: c.LMX_MSG_NOMEM
    # AD (2026-09-16): the sender as the pair the ruling gives a target. A caller
    # that holds the record (the turn's own, create's result, the answered
    # letter) passes it and nothing is resolved; the id is checked against the
    # record's own addr, because malloc reuses addresses and ids never are.
    src: env\from_msg
    if: src = 0 || src\addr != from
        src: msg_self_or_find(rt, from)
    ---
    if: src = 0
        msg_copy_free(entry)
        return: c.LMX_MSG_INVALID
    if: src\state = c.LMX_MSG_STATE_DEAD
        msg_copy_free(entry)
        return: c.LMX_MSG_DEAD
    if: src\state = c.LMX_MSG_STATE_STOPPED
        msg_copy_free(entry)
        return: c.LMX_MSG_STOPPED
    if: dest\owner_rt != rt
        msg_copy_free(entry)
        return: c.LMX_MSG_INVALID
    ---
    # S6-2, SPEC 19.29.7 ("there is no count of holders"): a capability is the
    # target's mailbox handle, and holding one is not counted. The retain that used
    # to gate this staging refused every send to a SETTLED target -- endp_retain
    # returns 0 below refs 1, and a settled record's refs are already 0 -- so a valid
    # handle was refused by the count before the mechanism could answer it. Measured:
    # the planted red failed with send_cap=NOMEM, nothing staged at all.
    entry\dest_msg: dest
    # S6-2: the sender is not counted either. It is inside its own turn for the
    # whole of this staging, so it cannot be freed under itself.
    c.lmx_msg_mail_lock(src)
    msg_q_push(@ src\outbox, @ src\outbox_tail, entry)
    c.lmx_msg_mail_unlock(src)
    return: c.LMX_MSG_STAGED
end: msg_send_cap
