predef: "l2src/parser_text_port_l2.h.lm1"
include: "<string.h>"

# L2 port of l1src/parser_text.lm1, Stage a of the parser-in-L2 port
# ticket. Bodies are ported straight from l1src/parser_text.lm1 (the
# oracle, unedited); parser_text_predicates.lm2, parser_text_heap.lm2,
# parser_text_line_break.lm2, parser_text_starts_python.lm2 and
# parser_text_views.lm2 (the pre-existing fragments) carry the same
# logic under lm_p0_ names for a different purpose -- this unit is the
# real port, named p0_* per the ticket (never lm_p0_, the translator's
# reserved adapter family), and never calls lm_p0_* either.

fn: p0_text_equals (const: @(LmP0Text text); const: @(char value)) int
    size_t: value_length
    if: text = 0 || value = 0
        return: 0
    value_length: c.strlen(value)
    return: text\length = value_length && c.memcmp(text\data, value, value_length) = 0
end: p0_text_equals

fn: p0_identifier_payload (const: @(LmP0Text atom); @: LmP0Text out_payload) int
    if: atom = 0 || out_payload = 0 || atom\data = 0
        return: 0
    out_payload\data: atom\data
    out_payload\length: atom\length
    if: atom\length >= 2U && atom\data[0] = 96 && atom\data[atom\length - 1U] = 96
        out_payload\data: atom\data + 1U
        out_payload\length: atom\length - 2U
    return: 1
end: p0_identifier_payload

fn: p0_is_horizontal_space (char: value) int
    return: value = 32 || value = 9
end: p0_is_horizontal_space

fn: p0_is_line_break (char: value) int
    return: value = 10 || value = 13
end: p0_is_line_break

fn: p0_line_break_width_at (const: @(char source); size_t: length; size_t: index) size_t
    if: index >= length
        return: 0U
    if: source[index] = 13
        if: index + 1U < length && source[index + 1U] = 10
            return: 2U
        return: 1U
    if: source[index] = 10
        return: 1U
    return: 0U
end: p0_line_break_width_at

fn: p0_is_field_space (char: value) int
    return: p0_is_horizontal_space(value) || p0_is_line_break(value)
end: p0_is_field_space

fn: p0_is_field_separator (char: value) int
    return: value = 44 || value = 59
end: p0_is_field_separator

fn: p0_is_short_form_separator (char: value) int
    return: value = 59
end: p0_is_short_form_separator

fn: p0_is_quoted_token_boundary (char: value) int
    return: p0_is_field_space(value) || p0_is_field_separator(value) || value = 40 || value = 41 || value = 35
end: p0_is_quoted_token_boundary

fn: p0_starts_python_string (const: @(char text); size_t: length; size_t: index) int
    char: quote
    if: index + 2U >= length
        return: 0
    quote: text[index]
    if: quote != 34 && quote != 39
        return: 0
    return: text[index + 1U] = quote && text[index + 2U] = quote
end: p0_starts_python_string

fn: p0_is_decimal_digit (char: value) int
    return: value >= 48 && value <= 57
end: p0_is_decimal_digit

fn: p0_copy_bytes (const: @(char source); size_t: length) @: char
    return: lm_own_copy_bytes(source, length)
end: p0_copy_bytes

fn: p0_text_view_new_cstr (const: @(char text)) @: LmP0Text
    @: LmP0Text result
    result: lm_own_new_zero(1U * c.sizeof(c.LmP0Text))
    if: result = 0
        return: 0
    if: text != 0
        result\data: text
    if: text = 0
        result\data: ""
    result\length: c.strlen(result\data)
    return: result
end: p0_text_view_new_cstr

sub: p0_text_view_delete (@: LmP0Text text)
    lm_own_delete(text, 0)
end: p0_text_view_delete

fn: p0_text_from_cstr (const: @(char text)) @: LmP0Text
    return: p0_text_view_new_cstr(text)
end: p0_text_from_cstr
