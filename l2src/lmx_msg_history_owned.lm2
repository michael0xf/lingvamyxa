predef: "l2src/lmx_msg_history_owned.h.lm1"
predef: "l2src/lmx_owned_ranges.h.lm1"
include: "l2src/lmx.h" "<stdlib.h>"

# Clean-L2 source for l2src/lmx_msg_history_owned.lm1. Same ABI, same
# behaviour, same refusals: exclusive-owner bookkeeping of the HISTORY roots a
# failed child hands to its parent (model §34): prepare builds a fresh private
# list of the source's history-eligible roots (the graph root and every root
# carrying the HISTORY role, each classified by the source's own ranges);
# commit merges that list into the destination's roots without allocating
# (an existing root gains the role, a new one is linked in); dispose frees
# only private list nodes, never payload.
#
# Library unit: no entry. The ABI names are REAL symbols: the callers are the
# executor's handoff path (lmx_message_exec.c), never a unit's open path.
#
# Spelling differences from the oracle, none behavioural, both the namespace
# rule (2026-09-14): C constants LMX_KIND_* / LMX_MSG_* / LMX_MSG_ROOT_HISTORY
# go through the c. door, and the LMX function lmx_owned_ranges_find is
# called by its own name through its predef'd header, not through c..

fn: lmx_msg_history_has (const: @(LmxMsgRoot head); @: void p) int
    while: head != 0
        if: head\p = p
            return: 1
        head: head\next
    ---
    return: 0
end: lmx_msg_history_has

fn: lmx_msg_history_kind (const: @(LmxOwnedRange rg)) int
    return: rg != 0 && (rg\kind = c.LMX_KIND_PRIMITIVE || rg\kind = c.LMX_KIND_ARRAY || rg\kind = c.LMX_KIND_CHILDREN || rg\kind = c.LMX_KIND_STRUCT)
end: lmx_msg_history_kind

sub: lmx_msg_history_dispose (@: LmxMsgRoot head)
    @: LmxMsgRoot next
    while: head != 0
        next: head\next
        c.free(head)
        head: next
    ---
end: lmx_msg_history_dispose

# The handwritten module calls the fresh list node "node". In L2 that name is
# the reserved argument of every callable (SPEC 21.2), so this source calls
# it "entry"; a local's spelling is not part of the ABI.
fn: lmx_msg_history_push (@@: LmxMsgRoot head; @: void p) int
    @: LmxMsgRoot entry
    if: head = 0 || p = 0 || lmx_msg_history_has(\head, p) != 0
        return: c.LMX_MSG_OK
    entry: (cast: (@: LmxMsgRoot) c.malloc(c.sizeof(c.LmxMsgRoot)))
    if: entry = 0
        return: c.LMX_MSG_NOMEM
    entry\p: p
    entry\roles: c.LMX_MSG_ROOT_HISTORY
    entry\next: \head
    \head: entry
    return: c.LMX_MSG_OK
end: lmx_msg_history_push

fn: lmx_msg_history_prepare (@: LmxMsg src; @@: LmxMsgRoot out) int
    @: LmxMsgRoot head 0
    @: LmxMsgRoot cur
    @: LmxOwnedRange rg
    if: out = 0
        return: c.LMX_MSG_INVALID
    \out: 0
    if: src = 0
        return: c.LMX_MSG_INVALID
    if: src\graph != 0
        rg: lmx_owned_ranges_find(src\ranges, src\graph)
        if: lmx_msg_history_kind(rg) != 0 && lmx_msg_history_push(@ head, src\graph) != c.LMX_MSG_OK
            lmx_msg_history_dispose(head)
            return: c.LMX_MSG_NOMEM
        ---
    ---
    cur: src\roots
    while: cur != 0
        if: cur\p != 0 && (cur\roles & c.LMX_MSG_ROOT_HISTORY) != 0U
            rg: lmx_owned_ranges_find(src\ranges, cur\p)
            if: lmx_msg_history_kind(rg) != 0 && lmx_msg_history_push(@ head, cur\p) != c.LMX_MSG_OK
                lmx_msg_history_dispose(head)
                return: c.LMX_MSG_NOMEM
            ---
        ---
        cur: cur\next
    ---
    \out: head
    return: c.LMX_MSG_OK
end: lmx_msg_history_prepare

sub: lmx_msg_history_commit (@: LmxMsg dst; @: LmxMsgRoot head)
    @: LmxMsgRoot next
    @: LmxMsgRoot have
    if: dst = 0
        lmx_msg_history_dispose(head)
        return
    while: head != 0
        next: head\next
        have: dst\roots
        while: have != 0 && have\p != head\p
            have: have\next
        ---
        if: have != 0
            have\roles: have\roles | c.LMX_MSG_ROOT_HISTORY
            c.free(head)
        else:
            head\roles: c.LMX_MSG_ROOT_HISTORY
            head\next: dst\roots
            dst\roots: head
        ---
        head: next
    ---
end: lmx_msg_history_commit
