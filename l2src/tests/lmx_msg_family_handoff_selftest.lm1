include: "l2src/lmx_message.h" "l2src/lmx_message_exec.h" "<stdio.h>" "<stdlib.h>" "<windows.h>"
predef: "l2src/lmx_value_owned.h.lm1" "l2src/lmx_branch_owned.h.lm1"

# Model section 34 (failure, history and the handoff of a graph to the parent),
# acceptance. The failed branch P <- C <- G carries REAL graphs: each Message's
# unit graph is built in its own arena with the owned builders (one block per
# allocation) and installed with lmx_msg_set_graph, which is what end-turn
# collection keeps (8ab7387d: unrooted ranged blocks die at the end-turn) and
# what adopt_failed carries to the parent as HISTORY roots (bdd6a62a: adopt
# copies only the child's graph and its HISTORY roots; a RETAIN root is
# owner-local retention and does not travel; 0c714cd8: the source's stale
# roots are dropped on handoff). The successful sibling K keeps a raw unrooted
# block to pin the collection rule itself. Rewritten 2026-09-14 (e2) after the
# lead bisected the old fixture's premise, unrooted raw blocks that live until
# dispose, to 8ab7387d.

# Test-driver instrumentation only, not Message runtime state or application
# synchronization. The GNU free wrapper observes the owner BEFORE payload free;
# a block's payload is freed before its record, so a watched record is readable
# when its payload goes.
prototype:
    fn: __real_free (@: void p) void
end: prototype
int: family_checks 0
int: family_watched_frees 0
@: LmxMsg family_watch_owner 0
@: LmxMsgBlock family_watch_a 0
@: LmxMsgBlock family_watch_b 0

sub: family_check (int: ok; const: @(char label))
    family_checks: family_checks + 1
    if: ok = 0
        c.printf("FAIL %s\n", label)
        c.exit(1)
    ---
end: family_check

fn: family_in_block (@: void ptr; @: LmxMsgBlock b) int
    @: char lo
    @: char q
    if: ptr = 0 || b = 0 || b\base = 0
        return: 0
    lo: (cast: (@: char) b\base)
    q: (cast: (@: char) ptr)
    return: q >= lo && q < lo + b\n

# Whether any of the owner's range records still lies inside the block.
fn: family_block_ranged (@: LmxOwnedRange ranges; @: LmxMsgBlock b) int
    @: LmxOwnedRange r
    r: ranges
    while: r != 0
        if: family_in_block(r\lo, b) != 0
            return: 1
        r: r\next
    ---
    return: 0

sub: __wrap_free (@: void p)
    if: p != 0 && family_watch_a != 0 && p = family_watch_a\base
        family_check(family_watch_owner != 0 && family_block_ranged(family_watch_owner\ranges, family_watch_a) = 0, "a block's range records leave the owner before its payload is freed")
        family_watched_frees: family_watched_frees + 1
        family_watch_a: 0
    ---
    if: p != 0 && family_watch_b != 0 && p = family_watch_b\base
        family_check(family_watch_owner != 0 && family_block_ranged(family_watch_owner\ranges, family_watch_b) = 0, "a block's range records leave the owner before its payload is freed")
        family_watched_frees: family_watched_frees + 1
        family_watch_b: 0
    ---
    c.__real_free(p)
end: __wrap_free

fn: family_end (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    if: ctx != 0
        return: 1
    return: lmx_msg_end_turn(rt, who, 0)

# One arena block contains its range record and one byte of test data. Metadata
# ownership follows the same allocation; records are not separately freed.
# Used for K only: an unrooted block, so that K's end-turn collects it.
fn: family_block (@: LmxMsg m; int: tag) @: LmxMsgBlock
    @: LmxMsgBlock b
    @: LmxOwnedRange r
    @: char payload
    size_t: offset c.sizeof(c.LmxOwnedRange)
    b: (cast: (@: LmxMsgBlock) c.calloc(1U, c.sizeof(c.LmxMsgBlock)))
    payload: (cast: (@: char) c.calloc(1U, offset + 1U))
    family_check(b != 0 && payload != 0, "allocate test block")
    r: (cast: (@: LmxOwnedRange) payload)
    r\lo: payload + offset
    r\hi: payload + offset + 1U
    r\stride: 1U
    r\kind: 1
    r\type: tag
    payload[offset]: (cast: (char) tag)
    b\base: payload
    b\n: offset + 1U
    b\class: (cast: (unsigned) tag)
    family_check(lmx_msg_blocks_push(@ m\blocks, b) = LMX_MSG_BLOCKS_OK, "attach test arena block")
    family_check(lmx_owned_ranges_add(@ m\ranges, r) = LMX_OWNED_RANGES_OK, "register embedded range")
    return: b

# A Message's unit graph: one node holding one int cell with the tag, built in
# the Message's own arena and installed as its graph.
fn: family_graph (@: LmxMsg m; int: tag) @: Lmx
    @: Lmx node
    @: void cell
    node: lmx_node_new_owned(@ m\blocks, @ m\ranges)
    cell: lmx_int_new_owned(@ m\blocks, @ m\ranges)
    family_check(node != 0 && cell != 0, "allocate a graph in the own arena")
    family_check(lmx_branch_open_owned(node, 1U, @ m\blocks, @ m\ranges) = 0 && lmx_branch_store_known(node, 0U, cell) = 0 && lmx_int_store_known(cell, tag) = 0, "shape the graph [cell]")
    lmx_msg_set_graph(m, node)
    return: node

# The graph's cell, for reading the payload after each handoff.
fn: family_cell (@: Lmx node) @: void
    return: lmx_branch_child_known(node, 0U)

# The roles of m's root at p, 0U when m has no root there.
fn: family_root_roles (@: LmxMsg m; @: void p) unsigned
    @: LmxMsgRoot r
    r: m\roots
    while: r != 0
        if: r\p = p
            return: r\roles
        r: r\next
    ---
    return: 0U

# The block of m's list that holds ptr, 0 when none does.
fn: family_block_of (@: LmxMsg m; @: void ptr) @: LmxMsgBlock
    @: LmxMsgBlock b
    b: m\blocks
    while: b != 0
        if: family_in_block(ptr, b) != 0
            return: b
        b: b\next
    ---
    return: 0

# Whether a block with this base is on m's block list.
fn: family_has_block (@: LmxMsg m; @: void base) int
    @: LmxMsgBlock b
    b: m\blocks
    while: b != 0
        if: b\base = base
            return: 1
        b: b\next
    ---
    return: 0

# Stage M: yield-round observation. No wait, no Sleep, no wall clock, no
# round bound; SwitchToThread between reads so the bound Message's own
# thread makes progress, and the runner's own timeout is the loop's real
# bound. A closing turn's own end (state -> STOPPED) is a safe one-way
# cross-thread read; an ordinary turn has no such monotonic transition, so
# its handler sets the kernel's own success flag as its last act, after
# its own end_turn's work is done, and the observer polls that instead
# (family_release_17's pattern: running/success reads, never a wait). The
# same text in every migrated test that waits on a Message's own thread.
# S6-2 (the drain ruling): no worker drains the transport; the driver thread is
# R0's lane, so each wait below runs R0's round (lmx_msg_pump) every round, and
# send_via_root runs it after the root child's entry turn.
fn: yield_until_stopped (@: LmxMsgRuntime rt; unsigned: who) int
    while: lmx_msg_state(rt, who) != c.LMX_MSG_STATE_STOPPED
        lmx_msg_pump(rt)
        c.SwitchToThread()
    return: 1

# S6-1 (a3): STOPPED is written by end_turn, handoff_ready by the turn's LAST
# step (native_leave_addr, after end_turn returns), so a reader that waits for
# STOPPED can look before the lane has finished leaving. The executor lock used
# to hide that window. Wait for the state the next check requires, as
# family_release_17, orphan_mapped_17 and scenario36 already do.
fn: yield_until_handoff_ready (@: LmxMsgRuntime rt; unsigned: who) int
    while: lmx_msg_handoff_ready(rt, who) = 0
        lmx_msg_pump(rt)
        c.SwitchToThread()
    return: 1

fn: yield_until_success (@: LmxMsgRuntime rt; unsigned: who) int
    @: LmxMsg m
    m: lmx_msg_find(rt, who)
    if: m = 0
        return: 0
    while: c.lmx_msg_success_load(m) = 0
        lmx_msg_pump(rt)
        c.SwitchToThread()
    return: 1

# A deeper descendant is woken by admitting mail through R0's direct
# child's own synchronous turn (lmx_msg_run_entry_turn, M's "what stays"),
# since the bootstrap thread loses its blanket send/recv/end_turn
# privilege the moment any context has ever been started.
unsigned: send_via_root_to 0U
@: LmxMsgEnv send_via_root_env 0

fn: send_via_root_turn (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    if: ctx != 0
        return: 1
    if: lmx_msg_send(rt, who, send_via_root_to, send_via_root_env) != c.LMX_MSG_STAGED
        return: 1
    ---
    return: lmx_msg_end_turn(rt, who, 1)

fn: send_via_root (@: LmxMsgRuntime rt; unsigned: root; unsigned: to; @: LmxMsgEnv env) int
    send_via_root_to: to
    int: st
    send_via_root_env: env
    st: c.lmx_msg_run_entry_turn(rt, root, send_via_root_turn, 0)
    lmx_msg_pump(rt)
    return: st

# parent's own final end_turn (below) is an ordinary turn on a Message
# that is not R0's direct child, so it needs the same real-thread wake.
fn: parent_finish_turn (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    @: LmxMsgEnv wake
    @: LmxMsg self
    int: st
    if: ctx != 0
        return: 1
    wake: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    if: wake != 0
        if: lmx_msg_recv(rt, who, wake) = c.LMX_MSG_OK
            lmx_msg_env_release(wake)
        ---
        c.free(wake)
    ---
    self: lmx_msg_turn_self(rt)
    st: lmx_msg_end_turn(rt, who, 1)
    c.lmx_msg_success_store(self, 1)
    return: st

fn: main () int
    @: LmxMsgRuntime rt
    # This pinned prototype typedefs LmxMsgAddr as unsigned. This test does not
    # make that integer lookup a language-level capability representation.
    unsigned: root 0U
    unsigned: parent 0U
    unsigned: child 0U
    unsigned: grandchild 0U
    unsigned: sibling 0U
    unsigned: successful 0U
    uchar: initial 7
    @: LmxMsg rootm
    @: LmxMsg p
    @: LmxMsg m
    @: LmxMsg g
    @: LmxMsg s
    @: LmxMsg k
    @: Lmx pnode
    @: Lmx cnode
    @: Lmx gnode
    @: Lmx snode
    @: Lmx gextra
    @: void pcell
    @: void ccell
    @: void gcell
    @: LmxMsgBlock pb
    @: LmxMsgBlock cb
    @: LmxMsgBlock gb
    @: LmxMsgBlock gxb
    @: LmxMsgBlock sb
    @: LmxMsgBlock bk
    @: void gx_base
    @: LmxOwnedRange rp_node
    @: LmxOwnedRange rc_node
    @: LmxOwnedRange rg_node
    @: LmxOwnedRange rg_cell
    @: LmxOwnedRange rs_head
    @: LmxMsgEnv wake
    @: void child_init
    @: void grand_init
    @: void sibling_init
    int: nroot
    int: np
    int: nc
    int: ng
    int: ns
    int: status
    int: c_status

    rt: lmx_msg_runtime_new()
    family_check(rt != 0, "create root host fixture")
    family_check(lmx_msg_create(rt, 0U, @ initial, 1U, @ root) = LMX_MSG_OK, "create fixture root")
    family_check(lmx_msg_create(rt, root, @ initial, 1U, @ parent) = LMX_MSG_OK && lmx_msg_end_turn(rt, root, 1) = LMX_MSG_OK, "create P and commit")
    family_check(lmx_msg_create(rt, parent, @ initial, 1U, @ child) = LMX_MSG_OK, "create C")
    family_check(lmx_msg_create(rt, parent, @ initial, 1U, @ sibling) = LMX_MSG_OK, "create unrelated S")
    family_check(lmx_msg_create(rt, parent, @ initial, 1U, @ successful) = LMX_MSG_OK && lmx_msg_end_turn(rt, parent, 1) = LMX_MSG_OK, "create K and commit siblings")
    family_check(lmx_msg_create(rt, child, @ initial, 1U, @ grandchild) = LMX_MSG_OK && lmx_msg_end_turn(rt, child, 1) = LMX_MSG_OK, "create G and commit")
    rootm: lmx_msg_find(rt, root)
    p: lmx_msg_find(rt, parent)
    m: lmx_msg_find(rt, child)
    g: lmx_msg_find(rt, grandchild)
    s: lmx_msg_find(rt, sibling)
    k: lmx_msg_find(rt, successful)
    family_check(rootm != 0 && p != 0 && m != 0 && g != 0 && s != 0 && k != 0, "resolve fixture participants")

    # --- every Message of the failed branch, and S, owns a real graph; G also
    # holds a second node under an ordinary (RETAIN) root: it survives G's own
    # end-turn, its block travels with G's storage, but the root does not, so
    # in P the block is unrooted and dies at P's end-turn.
    pnode: family_graph(p, 11)
    cnode: family_graph(m, 12)
    gnode: family_graph(g, 13)
    snode: family_graph(s, 14)
    gextra: lmx_node_new_owned(@ g\blocks, @ g\ranges)
    family_check(gextra != 0 && lmx_msg_root_attach(g, (cast: (@: void) gextra)) = LMX_MSG_OK && family_root_roles(g, (cast: (@: void) gextra)) = LMX_MSG_ROOT_RETAIN, "G retains a second node under a RETAIN root")
    bk: family_block(k, 15)
    pcell: family_cell(pnode)
    ccell: family_cell(cnode)
    gcell: family_cell(gnode)
    pb: family_block_of(p, (cast: (@: void) pnode))
    cb: family_block_of(m, (cast: (@: void) cnode))
    gb: family_block_of(g, (cast: (@: void) gnode))
    gxb: family_block_of(g, (cast: (@: void) gextra))
    sb: s\blocks
    rp_node: lmx_owned_ranges_find(p\ranges, (cast: (@: void) pnode))
    rc_node: lmx_owned_ranges_find(m\ranges, (cast: (@: void) cnode))
    rg_node: lmx_owned_ranges_find(g\ranges, (cast: (@: void) gnode))
    rg_cell: lmx_owned_ranges_find(g\ranges, gcell)
    rs_head: s\ranges
    child_init: m\init
    grand_init: g\init
    sibling_init: s\init
    nroot: lmx_msg_adopted_n(rt, root)
    np: lmx_msg_adopted_n(rt, parent)
    nc: lmx_msg_adopted_n(rt, child)
    ng: lmx_msg_adopted_n(rt, grandchild)
    ns: lmx_msg_adopted_n(rt, sibling)
    family_check(pb != 0 && cb != 0 && gb != 0 && gxb != 0 && gxb != gb && sb != 0 && rp_node != 0 && rc_node != 0 && rg_node != 0 && rg_cell != 0 && child_init != 0 && grand_init != 0 && np > 0 && nc > 0 && ng > 0 && ns > 0, "fixture storage resolved")
    gx_base: gxb\base
    family_check(lmx_msg_exec_bind(rt, child, family_end, 0, LMX_MSG_AFFINITY_ANY) = LMX_MSG_OK && lmx_msg_exec_bind(rt, grandchild, family_end, 0, LMX_MSG_AFFINITY_ANY) = LMX_MSG_OK, "bind failed branch")
    family_check(lmx_msg_exec_bind(rt, successful, family_end, 0, LMX_MSG_AFFINITY_ANY) = LMX_MSG_OK, "bind success branch")
    # Stage M: all three are bound but unmapped; start_contexts launches each
    # its own thread now (child and grandchild stay idle until their own
    # wake below; nothing here relies on the bootstrap thread's blanket
    # send/recv/end_turn/complete privilege past this point except through
    # a Message that is actually holding its own turn).
    family_check(c.lmx_msg_exec_start_contexts(rt) = LMX_MSG_OK, "start contexts for the three bound threads")

    # Completion does not add the successful branch to P's failure history.
    family_check(lmx_msg_complete(rt, successful) = LMX_MSG_OK, "K marks success")
    # K's test block is unrooted arena data: nothing in K's graph references it.
    # The model collects unrooted data at the end of the turn that owns it
    # (end-turn collection of ranged blocks the Message graph does not hold,
    # 8ab7387d; the delivery test pins the same for an unrooted received graph).
    # So K's closing turn frees the block, and dispose frees nothing twice. The
    # watch is armed before that turn. Do not move it back after the turn: the
    # old placement read a freed block and tested the pre-8ab7387d lifetime.
    family_watch_owner: k
    family_watch_a: bk
    status: yield_until_stopped(rt, successful)
    status: yield_until_handoff_ready(rt, successful)
    family_check((status = LMX_MSG_OK || status = 1) && lmx_msg_handoff_ready(rt, successful) != 0 && lmx_msg_success_load(k) != 0, "K settled successfully")
    family_check(family_watched_frees = 1 && family_watch_a = 0, "unrooted K block died at K's end-turn")
    family_check(lmx_msg_dispose_child(rt, parent, successful) = LMX_MSG_OK, "dispose K after success")
    family_check(family_watched_frees = 1 && family_watch_a = 0 && lmx_msg_find(rt, successful) = 0, "successful arena freed once; the disposed K is gone (decision 17)")
    family_check(lmx_msg_adopted_n(rt, parent) = np && lmx_msg_graph(p) = pnode && lmx_owned_ranges_find(p\ranges, (cast: (@: void) pnode)) = rp_node, "K left nothing in P's storage")

    # --- the failed branch: G and C are stopped, run their closing turns, and
    # keep their graphs as the failure's real state (section 34).
    family_check(lmx_msg_emergency_cancel(rt, grandchild) = LMX_MSG_OK && lmx_msg_emergency_cancel(rt, child) = LMX_MSG_OK, "stop failed branch")
    # Stage M: G and C each close on their own thread now, concurrently;
    # wait for G's own closing turn to finish before unbinding it, so its
    # own thread is not still touching its record when unbind runs.
    family_check(yield_until_stopped(rt, grandchild) != 0, "G's own closing turn finishes on its own thread")
    c_status: yield_until_stopped(rt, child)
    lmx_msg_exec_unbind(rt, grandchild)
    status: lmx_msg_drive(rt, 0U, 0U)
    status: yield_until_handoff_ready(rt, grandchild)
    family_check((status = LMX_MSG_OK || status = 1) && lmx_msg_handoff_ready(rt, grandchild) != 0, "G native activation left")
    family_check(lmx_msg_graph(g) = gnode && family_block_of(g, (cast: (@: void) gnode)) = gb && lmx_owned_ranges_find(g\ranges, (cast: (@: void) gnode)) = rg_node && lmx_int_value_known(gcell) = 13 && lmx_msg_adopted_n(rt, grandchild) = ng, "G's failed end-turn keeps its graph")
    family_check(family_block_of(g, (cast: (@: void) gextra)) = gxb && family_root_roles(g, (cast: (@: void) gextra)) = LMX_MSG_ROOT_RETAIN, "G's RETAIN root keeps its node through the end-turn")
    c_status: yield_until_handoff_ready(rt, child)
    status: c_status
    family_check((status = LMX_MSG_OK || status = 1) && lmx_msg_handoff_ready(rt, child) != 0, "C native activation left")
    family_check(lmx_msg_graph(m) = cnode && family_block_of(m, (cast: (@: void) cnode)) = cb && lmx_owned_ranges_find(m\ranges, (cast: (@: void) cnode)) = rc_node && lmx_int_value_known(ccell) = 12 && lmx_msg_adopted_n(rt, child) = nc, "C's failed end-turn keeps its graph")
    # Decision 17 with SPEC 19.29.8 (2026-09-14): a parent's adopt of C while
    # G is unsettled is no longer refused; the chain settles G into C first
    # (G's failed arena joins C, then C's joins P) and releases both. That is
    # pinned by lmx_model_family_release_17_selftest; this fixture adopts G
    # into C explicitly to check each step's identities on the way.
    family_check(lmx_msg_adopt_failed(rt, sibling, grandchild) = LMX_MSG_INVALID && g\init = grand_init && lmx_msg_graph(g) = gnode && lmx_msg_adopted_n(rt, grandchild) = ng && lmx_msg_adopted_n(rt, sibling) = ns, "sibling cannot adopt G")

    # --- G to C: storage moves with its range identities; G's graph becomes
    # C's HISTORY root; G's RETAIN root neither travels nor stays.
    family_check(lmx_msg_adopt_failed(rt, child, grandchild) = LMX_MSG_OK, "G to C")
    family_check(lmx_msg_find(rt, grandchild) = 0 && lmx_msg_child_n(rt, child) = 0, "G's ownership moved and G is gone: adoption closes the adopted (rule 5)")
    family_check(lmx_owned_ranges_find(m\ranges, (cast: (@: void) gnode)) = rg_node && lmx_owned_ranges_find(m\ranges, gcell) = rg_cell && lmx_owned_ranges_find(m\ranges, (cast: (@: void) cnode)) = rc_node, "G's range records follow C with their identity; C's own stay")
    family_check(family_has_block(m, gb\base) != 0 && family_has_block(m, gx_base) != 0 && family_has_block(m, grand_init) != 0 && family_has_block(m, cb\base) != 0 && lmx_msg_adopted_n(rt, child) = nc + ng + 1, "C owns its blocks, all of G's blocks and G's init block")
    family_check(family_root_roles(m, (cast: (@: void) gnode)) = LMX_MSG_ROOT_HISTORY && family_root_roles(m, (cast: (@: void) gextra)) = 0U, "G's graph is C's HISTORY root; G's RETAIN root did not travel and was dropped")
    family_check(lmx_msg_graph(m) = cnode && lmx_int_value_known(ccell) = 12 && lmx_int_value_known(gcell) = 13, "C's own graph and G's payload intact")
    # Section 34 (2026-09-14, from the lead's audit): a transferred graph is
    # not declared eternal by the transfer; C's eternal ranges gain nothing
    # for G's graph, its cell or its second node.
    family_check(lmx_owned_ranges_find(lmx_msg_eternal_ranges(m), (cast: (@: void) gnode)) = 0 && lmx_owned_ranges_find(lmx_msg_eternal_ranges(m), gcell) = 0 && lmx_owned_ranges_find(lmx_msg_eternal_ranges(m), (cast: (@: void) gextra)) = 0, "section 34: the move made nothing of G's eternal in C")

    # --- C to P: the same, and G's history is carried through C.
    family_check(lmx_msg_adopt_failed(rt, parent, child) = LMX_MSG_OK, "C to P")
    family_check(lmx_msg_find(rt, child) = 0 && lmx_msg_child_n(rt, parent) = 1 && lmx_msg_child_at(rt, parent, 0) = sibling, "C's ownership moved and C is gone; S is P's only child left")
    family_check(lmx_owned_ranges_find(p\ranges, (cast: (@: void) gnode)) = rg_node && lmx_owned_ranges_find(p\ranges, (cast: (@: void) cnode)) = rc_node && lmx_owned_ranges_find(p\ranges, (cast: (@: void) pnode)) = rp_node, "both range identities survive the second handoff; P's own stay")
    family_check(family_has_block(p, gb\base) != 0 && family_has_block(p, gx_base) != 0 && family_has_block(p, cb\base) != 0 && family_has_block(p, grand_init) != 0 && family_has_block(p, child_init) != 0 && family_has_block(p, pb\base) != 0 && lmx_msg_adopted_n(rt, parent) = np + nc + ng + 2, "P holds the failed branch's blocks, both init blocks and its own")
    family_check(family_root_roles(p, (cast: (@: void) cnode)) = LMX_MSG_ROOT_HISTORY && family_root_roles(p, (cast: (@: void) gnode)) = LMX_MSG_ROOT_HISTORY && family_root_roles(p, (cast: (@: void) gextra)) = 0U, "P's HISTORY roots: C's graph and G's graph carried through C, nothing else")
    family_check(lmx_msg_graph(p) = pnode && lmx_int_value_known(pcell) = 11 && lmx_int_value_known(ccell) = 12 && lmx_int_value_known(gcell) = 13, "failed graph payload unchanged; P's own graph untouched")
    family_check(lmx_owned_ranges_find(lmx_msg_eternal_ranges(p), (cast: (@: void) cnode)) = 0 && lmx_owned_ranges_find(lmx_msg_eternal_ranges(p), (cast: (@: void) gnode)) = 0 && lmx_owned_ranges_find(lmx_msg_eternal_ranges(p), gcell) = 0, "section 34: the move made nothing of C's or G's eternal in P")
    family_check(s\blocks = sb && s\ranges = rs_head && s\init = sibling_init && lmx_msg_graph(s) = snode && lmx_msg_adopted_n(rt, sibling) = ns && lmx_msg_running_load(s) != 0 && s\disposed = 0, "unrelated S storage and liveness untouched")
    family_check(s\parent_msg = p && lmx_msg_child_n(rt, parent) = 1, "the adopted are gone from the family, not reparented: only S remains P's child")

    # --- P's own successful end-turn: the HISTORY roots retain the adopted
    # graphs through P's collection; the block that only G's RETAIN root held
    # is unrooted in P and dies here (a transferred block is not rooted by the
    # transfer, section 34); nothing of the history reaches P's parent.
    family_watch_owner: p
    family_watch_a: gxb
    # Stage M: parent is not R0's direct child, so its own final end-turn
    # needs a real thread of its own, same as K and C above but for an
    # ordinary (non-closing) turn: bind, wake through root, wait for the
    # kernel's own success flag.
    wake: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    family_check(wake != 0 && lmx_msg_exec_bind(rt, parent, parent_finish_turn, 0, LMX_MSG_AFFINITY_ANY) = LMX_MSG_OK, "bind parent's own final turn")
    family_check(send_via_root(rt, root, parent, wake) = LMX_MSG_OK, "root admits the wake envelope into parent's inbox")
    c.free(wake)
    family_check(yield_until_success(rt, parent) != 0, "P ends a successful turn holding the history")
    lmx_msg_exec_unbind(rt, parent)
    family_check(family_watched_frees = 2 && family_watch_a = 0 && family_has_block(p, gx_base) = 0 && lmx_owned_ranges_find(p\ranges, (cast: (@: void) gextra)) = 0, "the block only G's RETAIN root held dies at P's end-turn")
    family_check(family_has_block(p, gb\base) != 0 && family_has_block(p, cb\base) != 0, "P's collection keeps the HISTORY-rooted blocks")
    family_check(lmx_owned_ranges_find(p\ranges, (cast: (@: void) gnode)) = rg_node && lmx_owned_ranges_find(p\ranges, (cast: (@: void) cnode)) = rc_node, "the history's range records stay P's")
    family_check(lmx_int_value_known(gcell) = 13 && lmx_int_value_known(ccell) = 12 && lmx_int_value_known(pcell) = 11, "the history's payload is intact after P's collection")
    family_check(lmx_msg_adopted_n(rt, root) = nroot && family_root_roles(rootm, (cast: (@: void) cnode)) = 0U && family_root_roles(rootm, (cast: (@: void) gnode)) = 0U, "the history is P's; P's parent did not inherit it")

    # --- the retained history dies with P: the runtime frees each adopted block
    # exactly once, its range records detached first.
    family_watch_owner: p
    family_watch_a: gb
    family_watch_b: cb
    lmx_msg_runtime_delete(rt)
    family_check(family_watched_frees = 4 && family_watch_a = 0 && family_watch_b = 0, "G's and C's graph blocks freed exactly once, with P")
    family_watch_owner: 0
    c.printf("family handoff checks=%d failures=0 watched_frees=%d\n", family_checks, family_watched_frees)
    return: 0
