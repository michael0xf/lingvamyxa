# S6-2 deleted rt\n with the runtime's slot list. This unit is NOT about the slot
# count: it pins the const LmxMsgRuntime formal and a named field read reaching C
# as itself, with the slot count merely its subject -- the same trap as
# unit_msg_cursor. So it is re-pointed at a field that survives rather than deleted
# with the module, which would have dropped that coverage silently.
# The function keeps its name for this pass: renaming is a second change, and I do
# not yet know which graph_abi assertions key on emitted method names.
# S6-2 step 5 deleted path_n with the path arrays; re-pointed again, at live_n
# (R0's live-set count, an int field that survives), for the same reason.
fn: slots_n (const: @(LmxMsgRuntime rt)) int
    if: rt = 0 || rt\root = 0
        return: 0
    return: rt\root\live_n
end: slots_n
fn: move_heads (@@: LmxMsgBlock db; @@: LmxOwnedRange dr; @@: LmxMsgBlock sb; @@: LmxOwnedRange sr) int
    if: db = 0 || dr = 0 || sb = 0 || sr = 0
        return: 1
    return: 0
end: move_heads
fn: main () int
    size_t: a
    size_t: b
    a: slots_n(0)
    if: a != 0U
        return: 81
    b: move_heads(0, 0, 0, 0)
    if: b != 1U
        return: 82
    return: 0
end: main
