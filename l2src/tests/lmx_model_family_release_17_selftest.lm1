include: "l2src/lmx.h" "l2src/lmx_message.h" "l2src/lmx_message_exec.h" "<stdio.h>" "<stdlib.h>" "<string.h>" "<windows.h>"

# Decision 17 (Mikhail, 2026-09-14; model section 32, SPEC 19.29.6): a
# released branch is never retained, and release does not wait for the
# children. (1) A parent that releases a child starts a chain reaction down
# the subtree, and the branch's slots are freed by that chain, never at
# runtime_delete. (2) A child's self-close starts the same chain for its own
# subtree. (3) A parent whose own algorithm sets success while its children
# still run declares their work unneeded, and the chain closes and releases
# them. Written as acceptance first: on the runtime of 2026-09-14 (main
# 0fb56413) the three release checks are RED, because dispose_child only marks
# disposed=1 and a disposed child stays linked to its parent, which therefore
# never retires before runtime_delete (found during stage 3b-8). The test is
# opt-in in run_model_scenario36.ps1 (-Tests) until the lead's implementation
# lands; then it joins the default set.
#
# Host-driven: R (root) has P1, P2, P3, P4; each has one child C. P4's
# child is still running when R releases P4 (scenario 4, added 2026-09-14
# after the settled chain landed, main 0bf1e35d): by SPEC 19.29.6 (iii) and
# 19.29.8 the release returns at once, the running descendant is closed by
# the chain and, as a successful orphan, is settled at its own end-turn and
# reclaimed by the root's next maintenance (stage 5 (c));
# the failed orphan (scenario 5, added on the orphan step e09bc3f4): never
# completed, re-rooted by its parent's release, it keeps its handoff-safe
# arena under the runtime's orphan-retention policy (lmx_msg_set_orphan_retain,
# SPEC 19.29.8) and is reclaimed by the host's drive once the logical clock
# passes its deadline; nothing waits for it, nothing keeps it past that. Red on the settled-chain runtime, which keeps the released
# parent's slot until its running child stops and never releases the child.
# "Gone" WAS measured by the runtime's slot count rt\n, not by lmx_msg_find: find
# walks only what rt->root reaches, so a subtree released from its parent but still
# retained (the very state decision 17 forbids) would read as gone (the lead's
# finding on the no-cascade mutation, 2026-09-14).
# S6-2 deletes that count, and the finding above is exactly why these checks could
# not simply become gone(): after the settle, "released from its parent and still
# in memory" is the NORMAL state rather than the forbidden one, so find is even
# less able to tell the two apart than it was. What replaces the count is stronger
# than either: the OWNER'S SETTLED LIST, which said not just that a record left the
# tree but WHOSE storage it became -- itself deleted later in S6-2; its successor is
# gone_after_r0_round below (find AND R0's live set, after R0's round).
#
# Stage M: no Message steps another, and the runtime creates R0 alone (the
# slot counts below have no UI lane). Each P is mapped onto its own context by
# R's own turn (run_entry_turn on the host thread; R is one of R0's direct
# children) at its former step point, and P1's own turn maps C1. C2 and C3 are
# never mapped: the host's drive closes them as idle closers. C4 and C5 are
# mapped by R0's own turn only after their parents' release re-rooted them:
# before its map point a child has no thread, so every check on it up to that
# point is deterministic, and "the release does not wait for C4" is read by
# flags when the release returns (C4 not settled, success 0, not stopped); its
# close is read on later rounds. The host reads each mapped Message's effect
# in yield rounds on a flag or a state: handoff-ready, STOPPED.

int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

# A turn that takes nothing and ends successfully; the closing path of
# end_turn handles a Message whose closing flag is set.
fn: turn_ok (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    if: ctx != 0
        return: 1
    return: lmx_msg_end_turn(rt, who, 1)

# The address is gone from the runtime: no Message resolves to it any more.
fn: gone (@: LmxMsgRuntime rt; LmxMsgAddr: a) int
    return: lmx_msg_find(rt, a) = 0

# S6-2 (SPEC 19.29.7): the count this fixture was written on is deleted, and the
# header above says exactly why it could not simply become gone(): find walks what
# rt->root reaches, so it cannot tell a record that was reclaimed from one that was
# released and retained -- the state decision 17 forbids. The owner's settled list
# that first replaced the count was deleted in turn (respecified 2026-09-16 by the
# removal ruling): a released record is freed BY ITS SERVICE in R0's round. So the
# reading is: run R0's round (lmx_msg_pump; the host is R0's lane), then the record
# is gone in both senses -- find no longer reaches it AND R0's live set no longer
# holds its id. The live-set entry is removed only by the service's found-and-
# removed unregister, immediately before its free, so a released-but-retained
# record still fails this check, which is the property the header asks for. The
# set is read by id, so no freed record is dereferenced. owner is kept so each site
# still names whose storage the record was; nothing records that any more.
fn: gone_after_r0_round (@: LmxMsgRuntime rt; LmxMsgAddr: owner; LmxMsgAddr: who) int
    @: LmxMsg r0
    int: i 0
    lmx_msg_pump(rt)
    if: lmx_msg_find(rt, who) != 0
        return: 0
    r0: lmx_msg_find(rt, lmx_msg_root_addr(rt))
    if: r0 = 0
        return: 0
    while: i < r0\live_n
        if: r0\live_id[i] = who
            return: 0
        ---
        i: i + 1
    ---
return: 1

# Stage M: P1's own turn maps its child C1 (named in its cell) and takes P1's
# input; ctx is the cell, [0] the child, [1] map_child's status.
fn: turn_map_own_child (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    @: unsigned cell
    @: LmxMsgEnv got
    if: ctx = 0
        return: 1
    cell: (cast: (@: unsigned) ctx)
    cell[1]: (cast: (unsigned) lmx_msg_map_child(rt, who, cell[0]))
    got: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    if: got = 0
        return: 1
    if: lmx_msg_recv(rt, who, got) = c.LMX_MSG_OK
        lmx_msg_env_release(got)
    ---
    c.free((cast: (@: void) got))
    return: lmx_msg_end_turn(rt, who, 1)

# R's own turn: it maps its child P named in the cell and, when [2] is 1,
# stages one input for P, published by this end-turn. [1] is map_child's
# status; [2] becomes 2 when the send is refused.
fn: turn_r_map (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    @: unsigned cell
    @: LmxMsgEnv env
    if: ctx = 0
        return: 1
    cell: (cast: (@: unsigned) ctx)
    if: cell[2] = 1U
        env: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
        if: env = 0
            return: 1
        env\kind: c.LMX_MSG_KIND_NUMBER
        env\number: 1
        if: lmx_msg_send(rt, who, cell[0], env) != c.LMX_MSG_STAGED
            cell[2]: 2U
        ---
        c.free((cast: (@: void) env))
    ---
    cell[1]: (cast: (unsigned) lmx_msg_map_child(rt, who, cell[0]))
    return: lmx_msg_end_turn(rt, who, 1)

# R0's own turn maps an orphan re-rooted under R0; ctx is the cell, [0] the
# child, [1] map_child's status.
fn: turn_root_map (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    @: unsigned cell
    if: ctx = 0
        return: 1
    cell: (cast: (@: unsigned) ctx)
    cell[1]: (cast: (unsigned) lmx_msg_map_child(rt, who, cell[0]))
    return: lmx_msg_end_turn(rt, who, 1)

int: g_settle_st -1

# Spec 19.29.8: R0's own turn runs R0's settle of its settled children, which
# never takes an orphan: a failed orphan is retained until its deadline and
# nobody adopts its arena.
fn: turn_root_settle (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    if: ctx != 0
        return: 1
    g_settle_st: lmx_msg_parent_settle(rt, who)
    return: lmx_msg_end_turn(rt, who, 1)

[]: unsigned c1_cell 2
[]: unsigned r_cell 3
[]: unsigned root_cell 2
unsigned: g_r 0U

# R maps P in R's own turn; with feed 1, P is given one input too. Returns
# run_entry_turn's status, else the send's refusal, else map_child's.
fn: r_maps (@: LmxMsgRuntime rt; unsigned: p; unsigned: feed) int
    int: st
    r_cell[0]: p
    r_cell[1]: (cast: (unsigned) c.LMX_MSG_INVALID)
    r_cell[2]: feed
    st: lmx_msg_run_entry_turn(rt, g_r, turn_r_map, (cast: (@: void) r_cell))
    # S6-2 (the drain ruling): R's end-turn only pushes the input for P; the host
    # (R0's lane) runs R0's round here and in every wait below.
    lmx_msg_pump(rt)
    if: st != c.LMX_MSG_OK
        return: st
    if: r_cell[2] = 2U
        return: c.LMX_MSG_INVALID
    return: (cast: (int) r_cell[1])

# R0 maps an orphan re-rooted under it, in R0's own turn. Returns root_turn's
# status, else map_child's.
fn: root_maps (@: LmxMsgRuntime rt; unsigned: child) int
    int: st
    root_cell[0]: child
    root_cell[1]: (cast: (unsigned) c.LMX_MSG_INVALID)
    st: lmx_msg_root_turn(rt, turn_root_map, (cast: (@: void) root_cell))
    if: st != c.LMX_MSG_OK
        return: st
    return: (cast: (int) root_cell[1])

fn: main () int
    @: LmxMsgRuntime rt
    @: LmxMsg cm
    unsigned: r 0U
    unsigned: p1 0U
    unsigned: c1 0U
    unsigned: p2 0U
    unsigned: c2 0U
    unsigned: p3 0U
    unsigned: c3 0U
    unsigned: p4 0U
    unsigned: c4 0U
    unsigned: p5 0U
    unsigned: c5 0U
    uchar: ini 1
    int: st
    int: adopted0

    # Unbuffered: a run the runner kills still shows its reading lines and FAILs.
    c.setvbuf(c.stdout, 0, c._IONBF, 0U)
    rt: lmx_msg_runtime_new()
    check(rt != 0 && lmx_msg_create(rt, 0U, @ ini, 1U, @ r) = c.LMX_MSG_OK, "R, the root, created")
    if: rt = 0 || r = 0U
        return: 2
    g_r: r
    check(lmx_msg_create(rt, r, @ ini, 1U, @ p1) = c.LMX_MSG_OK && lmx_msg_create(rt, r, @ ini, 1U, @ p2) = c.LMX_MSG_OK && lmx_msg_create(rt, r, @ ini, 1U, @ p3) = c.LMX_MSG_OK && lmx_msg_create(rt, r, @ ini, 1U, @ p4) = c.LMX_MSG_OK && lmx_msg_create(rt, r, @ ini, 1U, @ p5) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, r, 1) = c.LMX_MSG_OK, "P1 to P5 created and published")
    check(lmx_msg_create(rt, p1, @ ini, 1U, @ c1) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, p1, 1) = c.LMX_MSG_OK, "C1 created by P1 and published")
    check(lmx_msg_create(rt, p2, @ ini, 1U, @ c2) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, p2, 1) = c.LMX_MSG_OK, "C2 created by P2 and published")
    check(lmx_msg_create(rt, p3, @ ini, 1U, @ c3) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, p3, 1) = c.LMX_MSG_OK, "C3 created by P3 and published")
    check(lmx_msg_create(rt, p4, @ ini, 1U, @ c4) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, p4, 1) = c.LMX_MSG_OK, "C4 created by P4 and published")
    check(lmx_msg_create(rt, p5, @ ini, 1U, @ c5) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, p5, 1) = c.LMX_MSG_OK, "C5 created by P5 and published")
    c1_cell[0]: c1
    c1_cell[1]: (cast: (unsigned) c.LMX_MSG_INVALID)
    check(lmx_msg_exec_bind(rt, p1, turn_map_own_child, (cast: (@: void) c1_cell), c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, c1, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, p2, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, c2, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, p3, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, c3, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, p4, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, c4, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, p5, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, c5, turn_ok, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK, "all ten bound; none is mapped yet")
    check(lmx_msg_child_n(rt, r) = 5 && lmx_msg_child_n(rt, p1) = 1 && lmx_msg_child_n(rt, p2) = 1 && lmx_msg_child_n(rt, p3) = 1 && lmx_msg_child_n(rt, p4) = 1 && lmx_msg_child_n(rt, p5) = 1, "the families as created")

    # --- (1) orderly: C1 completes, P1 disposes it; the disposed child leaves
    # its family and its slot; then P1 completes, R disposes P1; P1 is gone too.
    check(lmx_msg_complete(rt, c1) = c.LMX_MSG_OK, "C1 marks success")
    st: r_maps(rt, p1, 1U)
    check(st = c.LMX_MSG_OK, "R's own turn maps P1 and gives it an input; P1's own turn maps C1")
    cm: lmx_msg_find(rt, c1)
    c.printf("reading: C1 handoff-ready, settled at its end-turn on its worker\n")
    while: cm != 0 && lmx_msg_handoff_ready(rt, c1) = 0
        lmx_msg_pump(rt)
        c.SwitchToThread()
    ---
    check(cm != 0 && lmx_msg_handoff_ready(rt, c1) != 0 && lmx_msg_success_load(cm) != 0 && lmx_msg_running_load(cm) = 0, "C1 settled at its own end-turn: success, not running, handoff-ready")
    check(lmx_msg_dispose_child(rt, p1, c1) = c.LMX_MSG_OK, "P1 disposes C1")
    check(gone(rt, c1) != 0 && lmx_msg_child_n(rt, p1) = 0, "a disposed child leaves its family and is not kept on it")
    check(gone_after_r0_round(rt,p1, c1) != 0, "C1 became P1's storage: on P1's settled list, RELEASED")
    check(lmx_msg_complete(rt, p1) = c.LMX_MSG_OK, "P1 marks success")
    c.printf("reading: P1 handoff-ready, settled at its end-turn on its worker\n")
    while: lmx_msg_handoff_ready(rt, p1) = 0
        lmx_msg_pump(rt)
        c.SwitchToThread()
    ---
    check(lmx_msg_handoff_ready(rt, p1) != 0, "P1 settled at its own end-turn")
    check(lmx_msg_dispose_child(rt, r, p1) = c.LMX_MSG_OK, "R disposes P1")
    check(gone(rt, p1) != 0 && lmx_msg_child_n(rt, r) = 4, "the released parent is gone with its branch: R has four children left")
    # The upward settle carries C1 with P1, so both become R's storage.
    check(gone_after_r0_round(rt,r, p1) != 0 && gone_after_r0_round(rt,r, c1) != 0, "P1 and the C1 it owned both became R's storage")

    # --- (2) forced: C2 still runs; R stops P2 and releases it; the chain
    # closes and releases C2 without R touching a grandchild.
    check(lmx_msg_emergency_cancel(rt, p2) = c.LMX_MSG_OK, "R stops P2 while C2 runs")
    st: r_maps(rt, p2, 0U)
    check(st = c.LMX_MSG_OK, "R's own turn maps P2: its closing turn runs on its own worker")
    cm: lmx_msg_find(rt, c2)
    # The release below settles P2 only when P2 is handoff-ready (its worker has
    # left the turn: native_users 0), which run_one sets after the end-turn that
    # writes STOPPED; so the loop reads both.
    c.printf("reading: P2 STOPPED and handoff-ready after its closing turn on its worker\n")
    while: lmx_msg_state(rt, p2) != c.LMX_MSG_STATE_STOPPED || lmx_msg_handoff_ready(rt, p2) = 0
        lmx_msg_pump(rt)
        c.SwitchToThread()
    ---
    check(lmx_msg_state(rt, p2) = c.LMX_MSG_STATE_STOPPED && cm != 0 && lmx_msg_running_load(cm) = 0, "P2 stopped at its end-turn and requested C2's close: the chain, one level")
    # Stage 5 (d), shape (a): C2's parent P2 is stopped and runs no turn body.
    # C2 is an idle closer: its owning executor applies the close without a new
    # user turn (SPEC 19.29.7.1, lines 13073-13074); the host unbinds it and
    # drive's close runs its end-turn. C2 was never mapped.
    lmx_msg_exec_unbind(rt, c2)
    st: lmx_msg_drive(rt, lmx_msg_now(rt), 0U)
    check((st = c.LMX_MSG_OK || st = 1) && lmx_msg_state(rt, c2) = c.LMX_MSG_STATE_STOPPED, "C2 stopped at its own end-turn")
    check(lmx_msg_dispose_child(rt, r, p2) = c.LMX_MSG_OK, "R releases P2 without disposing C2 itself: release does not wait for the children")
    check(gone(rt, p2) != 0 && gone(rt, c2) != 0 && lmx_msg_child_n(rt, r) = 3, "the forced release took the whole branch off the tree: P2 and C2 are gone")
    check(gone_after_r0_round(rt,r, p2) != 0 && gone_after_r0_round(rt,r, c2) != 0, "the chain settled the whole branch into R: both records are R's storage, neither a retained subtree")

    # --- (3) success with a running child: P3's own algorithm completes while
    # C3 runs; that declares C3's work unneeded, and the chain closes and
    # releases it.
    cm: lmx_msg_find(rt, c3)
    check(cm != 0 && lmx_msg_running_load(cm) != 0 && lmx_msg_complete(rt, p3) = c.LMX_MSG_OK, "P3 marks success while C3 still runs")
    st: r_maps(rt, p3, 0U)
    check(st = c.LMX_MSG_OK, "R's own turn maps P3: its closing turn runs on its own worker")
    c.printf("reading: P3 handoff-ready, settled at its end-turn on its worker\n")
    while: lmx_msg_handoff_ready(rt, p3) = 0
        lmx_msg_pump(rt)
        c.SwitchToThread()
    ---
    check(lmx_msg_handoff_ready(rt, p3) != 0 && lmx_msg_running_load(cm) = 0, "P3's end-turn closes C3: success with running children means their work is unneeded")
    # Stage 5 (d), shape (a): C3's parent P3 completed and runs no turn body; the
    # host unbinds C3 and drive's close runs its end-turn (as for C2).
    lmx_msg_exec_unbind(rt, c3)
    st: lmx_msg_drive(rt, lmx_msg_now(rt), 0U)
    check((st = c.LMX_MSG_OK || st = 1) && lmx_msg_state(rt, c3) = c.LMX_MSG_STATE_STOPPED, "C3 stopped at its own end-turn")
    check(lmx_msg_dispose_child(rt, r, p3) = c.LMX_MSG_OK, "R releases P3")
    check(gone(rt, p3) != 0 && gone(rt, c3) != 0 && lmx_msg_child_n(rt, r) = 2, "the successful parent's branch left the tree by the chain: R has P4 and P5 left")
    # An ABSOLUTE pin: it stated WHO remained, which no count could. Membership says
    # it directly, and ownership says where the others went.
    check(gone_after_r0_round(rt,r, p3) != 0 && gone_after_r0_round(rt,r, c3) != 0, "P3's branch became R's storage")
    check(lmx_msg_find(rt, lmx_msg_root_addr(rt)) != 0 && lmx_msg_find(rt, r) != 0 && lmx_msg_find(rt, p4) != 0 && lmx_msg_find(rt, c4) != 0 && lmx_msg_find(rt, p5) != 0 && lmx_msg_find(rt, c5) != 0, "exactly R0, R, P4, C4, P5 and C5 are still on the tree")

    # --- (4) a running descendant at release time: R stops P4 and releases it
    # while C4 still runs; the release returns at once; C4 is closed by the
    # chain and, having completed, is settled at its own end-turn as a
    # successful orphan and reclaimed by the root's next maintenance (stage 5
    # (c): the sweep is the one settlement path); P4's slot goes at its release. Nothing
    # waits for C4 inside R's call, and nothing is kept until runtime_delete.
    check(lmx_msg_emergency_cancel(rt, p4) = c.LMX_MSG_OK, "R stops P4 while C4 runs")
    st: r_maps(rt, p4, 0U)
    check(st = c.LMX_MSG_OK, "R's own turn maps P4: its closing turn runs on its own worker")
    cm: lmx_msg_find(rt, c4)
    c.printf("reading: P4 STOPPED and handoff-ready after its closing turn on its worker\n")
    while: lmx_msg_state(rt, p4) != c.LMX_MSG_STATE_STOPPED || lmx_msg_handoff_ready(rt, p4) = 0
        lmx_msg_pump(rt)
        c.SwitchToThread()
    ---
    # C4 has no thread until R0 maps it after P4's release, so nothing runs it
    # between here and that map point: the checks on C4 up to it are
    # deterministic.
    check(lmx_msg_state(rt, p4) = c.LMX_MSG_STATE_STOPPED && cm != 0 && lmx_msg_running_load(cm) = 0 && lmx_msg_state(rt, c4) != c.LMX_MSG_STATE_STOPPED, "P4 stopped and requested C4's close; C4 has not yet run its closing turn")
    check(lmx_msg_dispose_child(rt, r, p4) = c.LMX_MSG_OK && lmx_msg_child_n(rt, r) = 1, "R releases P4 at once, with C4 still to run its closing turn")
    check(lmx_msg_success_load(cm) = 0 && lmx_msg_handoff_ready(rt, c4) = 0 && lmx_msg_state(rt, c4) != c.LMX_MSG_STATE_STOPPED, "the release does not wait for C4: when it returns C4 is not settled, success 0, not stopped")
    check(lmx_msg_complete(rt, c4) = c.LMX_MSG_OK, "C4's own algorithm completes before its closing turn")
    # C4 was re-rooted under R0 at P4's release, so R0's own turn is its
    # parent's turn: R0 maps it, and its closing turn runs on its own worker.
    st: root_maps(rt, c4)
    check(st = c.LMX_MSG_OK, "R0's own turn maps the re-rooted C4 onto its own context")
    c.printf("reading: C4 handoff-ready, settled at its closing end-turn on its worker\n")
    while: lmx_msg_handoff_ready(rt, c4) = 0
        lmx_msg_pump(rt)
        c.SwitchToThread()
    ---
    check(lmx_msg_handoff_ready(rt, c4) != 0, "C4 ran its closing turn as an orphan")
    check(lmx_msg_find(rt, c4) != 0 && lmx_msg_handoff_ready(rt, c4) != 0 && gone(rt, p4) != 0 && gone_after_r0_round(rt,r, p4) != 0, "C4 is settled at its end-turn and still there until the root's next maintenance; P4 became R's storage at its release")
    # The second ABSOLUTE pin: "R0, R, P5 and C5 remain". Membership states it, and
    # the orphan's reclaim is now a change of owner rather than a disappearance.
    check(lmx_msg_drive(rt, lmx_msg_now(rt), 0U) = c.LMX_MSG_OK && gone(rt, c4) != 0 && gone_after_r0_round(rt,lmx_msg_root_addr(rt), c4) != 0, "the root's next maintenance settles the successful orphan into R0")
    check(lmx_msg_find(rt, lmx_msg_root_addr(rt)) != 0 && lmx_msg_find(rt, r) != 0 && lmx_msg_find(rt, p5) != 0 && lmx_msg_find(rt, c5) != 0, "exactly R0, R, P5 and C5 are still on the tree")

    # --- (5) a failed orphan: C5 runs, never completes; R stops P5 and
    # releases it at once; C5 is re-rooted, runs its closing turn and, having
    # failed with storage, is retained under the runtime's orphan-retention
    # policy (19.29.8): one drive gives it its deadline, the clock passes it,
    # the next drive reclaims it and drops its arena. Logical clock, no waits.
    check(lmx_msg_set_now(rt, 5000U) = c.LMX_MSG_OK && lmx_msg_set_orphan_retain(rt, 100U) = c.LMX_MSG_OK, "clock 5000; the orphan-retention policy set to 100")
    check(lmx_msg_emergency_cancel(rt, p5) = c.LMX_MSG_OK, "R stops P5 while C5 runs")
    st: r_maps(rt, p5, 0U)
    check(st = c.LMX_MSG_OK, "R's own turn maps P5: its closing turn runs on its own worker")
    c.printf("reading: P5 STOPPED and handoff-ready after its closing turn on its worker\n")
    while: lmx_msg_state(rt, p5) != c.LMX_MSG_STATE_STOPPED || lmx_msg_handoff_ready(rt, p5) = 0
        lmx_msg_pump(rt)
        c.SwitchToThread()
    ---
    check(lmx_msg_state(rt, p5) = c.LMX_MSG_STATE_STOPPED, "P5 stopped and requested C5's close")
    check(lmx_msg_dispose_child(rt, r, p5) = c.LMX_MSG_OK && lmx_msg_child_n(rt, r) = 0 && gone_after_r0_round(rt,r, p5) != 0, "R releases P5 at once; P5 becomes R's storage, C5 is re-rooted under R0")
    # C5 had no thread until this map point, as C4 above.
    st: root_maps(rt, c5)
    check(st = c.LMX_MSG_OK, "R0's own turn maps the re-rooted C5 onto its own context")
    cm: lmx_msg_find(rt, c5)
    c.printf("reading: C5 handoff-ready, settled at its closing end-turn on its worker\n")
    while: cm != 0 && lmx_msg_handoff_ready(rt, c5) = 0
        lmx_msg_pump(rt)
        c.SwitchToThread()
    ---
    check(cm != 0 && lmx_msg_success_load(cm) = 0 && lmx_msg_handoff_ready(rt, c5) != 0 && cm\parent_msg = lmx_msg_find(rt, lmx_msg_root_addr(rt)), "C5 ran its closing turn as a failed orphan: handoff-safe, re-rooted under R0, still held")
    # Spec 19.29.8: R0's own turn runs R0's settle of its settled children,
    # which never takes an orphan: a failed orphan is retained until its
    # deadline and nobody adopts its arena.
    # Stage 5 (e): R0's arena holds R0's policy record since the first set_now
    # above, so "not adopted" is R0's block count unchanged by the settle, not 0.
    # lmx_msg_adopted_n counts every block of the Message's arena (its own graph
    # included), so it reads as "adopted" only against a baseline; R0's arena
    # holds its policy record's five blocks by design (6f).
    adopted0: lmx_msg_adopted_n(rt, lmx_msg_root_addr(rt))
    check(lmx_msg_root_turn(rt, turn_root_settle, 0) = c.LMX_MSG_OK && (g_settle_st = c.LMX_MSG_OK || g_settle_st = 1), "R0's own turn runs its settle of its settled children")
    check(lmx_msg_find(rt, c5) != 0 && lmx_msg_adopted_n(rt, lmx_msg_root_addr(rt)) = adopted0 && gone_after_r0_round(rt,lmx_msg_root_addr(rt), c5) = 0, "R0's settle leaves the failed orphan C5 to the sweep: still found, not adopted, not yet R0's storage")
    check(lmx_msg_find(rt, r) != 0, "R is still there after R0's settle")
    # The third and fourth ABSOLUTE pins (= 3, then = 2). Retention is "still on the
    # tree and not yet anyone's storage"; the reclaim is "off the tree and now R0's".
    check(lmx_msg_drive(rt, 5000U, 0U) = c.LMX_MSG_OK && lmx_msg_find(rt, c5) != 0 && gone_after_r0_round(rt,lmx_msg_root_addr(rt), c5) = 0, "the host's drive gives the failed orphan its deadline and keeps it: retention, not a drop")
    check(lmx_msg_set_now(rt, 5050U) = c.LMX_MSG_OK && lmx_msg_drive(rt, 5050U, 0U) = c.LMX_MSG_OK && lmx_msg_find(rt, c5) != 0 && gone_after_r0_round(rt,lmx_msg_root_addr(rt), c5) = 0, "within the retention window the orphan is still retained")
    check(lmx_msg_set_now(rt, 5100U) = c.LMX_MSG_OK && lmx_msg_drive(rt, 5100U, 0U) = c.LMX_MSG_OK && gone(rt, c5) != 0 && gone_after_r0_round(rt,lmx_msg_root_addr(rt), c5) != 0, "past its deadline the drive reclaims the failed orphan into R0's storage; only R0 and R are still on the tree")
    check(lmx_msg_find(rt, r) != 0 && lmx_msg_running_load(lmx_msg_find(rt, r)) != 0, "the root runs on")

    # exec_stop's own rounds read the worker count until every worker has left.
    lmx_msg_exec_stop(rt)
    lmx_msg_runtime_delete(rt)
    c.printf("family release 17: %d checks, %d failures\n", checks, failures)
    if: failures != 0
        return: 1
    return: 0
