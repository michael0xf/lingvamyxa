L2:
    predef: "l1src/parser.lm1"
    include: "<stdio.h>"
    fn: main (int: count; @@: char values) int
        @: LmP0Document document 0
        int: status
        if: count != 2
            return: 1
        status: lm_p0_parse_file: values[1] @ document
        if: status != 0
            lm_p0_document_destroy: document
            return: 1
        if: document = 0
            return: 1
        lm_p0_document_destroy: document
        return: 0
    end: main
end: L2

