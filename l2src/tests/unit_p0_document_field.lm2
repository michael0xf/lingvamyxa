include: "l1src/p0.lm1.h" "<stdlib.h>"

# Field access on a LmP0Document pointer, as a formal and as a local (5e, parser
# Stage c: `document\tree_arena`). LmP0Document had the fixed formal and local
# code 13, which bypassed the foreign field path, so every `doc\field` was
# "unknown foreign field" while LmP0Frame fields worked. It is now a foreign
# pointer type like LmP0Frame (Stage B).
fn: doc_len (@: LmP0Document doc) size_t
    if: doc = 0
        return: 0U
    return: doc\source_length
end: doc_len

fn: doc_field () int
    @: LmP0Document d
    d: (cast: (@: LmP0Document) c.calloc(1U, c.sizeof(c.LmP0Document)))
    if: d = 0
        return: 1
    d\source_length: 7U
    if: doc_len(d) != 7U
        c.free(d)
        return: 2
    c.free(d)
    return: 0
end: doc_field

fn: main () int
    return: doc_field()
end: main
