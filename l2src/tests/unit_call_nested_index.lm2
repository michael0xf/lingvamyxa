# A nested index is one actual (b5's repro 7acecbbd, parser-l2 Stage e slice 3):
# text[index[0]] passed to a call was split into text, [, index[0], ] and the
# bare brackets were boxed into temps, which l1trans refused.
fn: is_hash (char: value) int
    if: value = '#'
        return: 1
    return: 0
end: is_hash
fn: is_hash_int (int: value) int
    if: value = 35
        return: 1
    return: 0
end: is_hash_int
fn: count_hash (const: @(char text); size_t: length; @: size_t index) int
    int: n
    n: 0
    while: index[0] < length
        if: is_hash(text[index[0]]) != 0
            n: n + 1
        # The same index as the operand after a binary operator.
        if: is_hash_int(0 + text[index[0]]) != 0
            n: n + 1
        index[0]: index[0] + 1U
    return: n
end: count_hash
fn: main () int
    size_t: i
    i: 0U
    return: count_hash("a#b#c", 5U, @ i)
end: main
