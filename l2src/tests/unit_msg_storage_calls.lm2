# The four Message storage list operations, admitted by name and by shape:
# two owner head slots in, a status out. Nothing else about those lists is
# reachable from L2, and nothing about the lists is reimplemented here.
fn: preflight (@@: LmxMsgBlock db; @@: LmxOwnedRange dr; @@: LmxMsgBlock sb; @@: LmxOwnedRange sr) int
    if: c.lmx_msg_blocks_can_move(db, sb) != 0
        return: 1
    if: c.lmx_owned_ranges_can_move(dr, sr) != 0
        return: 1
    return: 0
end: preflight
fn: transfer (@@: LmxMsgBlock db; @@: LmxOwnedRange dr; @@: LmxMsgBlock sb; @@: LmxOwnedRange sr) int
    if: preflight(db, dr, sb, sr) != 0
        return: 1
    if: c.lmx_msg_blocks_move_all(db, sb) != 0
        return: 1
    if: c.lmx_owned_ranges_move_all(dr, sr) != 0
        return: 1
    return: 0
end: transfer
fn: main () int
    int: a
    int: b
    # A null head slot is not an owner. Both operations must say so, and the
    # move must say so without having moved anything.
    a: preflight(0, 0, 0, 0)
    if: a != 1
        return: 81
    b: transfer(0, 0, 0, 0)
    if: b != 1
        return: 82
    return: 0
end: main
