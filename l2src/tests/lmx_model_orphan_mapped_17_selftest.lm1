include: "l2src/lmx.h" "l2src/lmx_message.h" "l2src/lmx_message_exec.h" "<stdio.h>" "<stdlib.h>" "<string.h>" "<windows.h>"

# Decision 17 with spec 19.29.8, the mapped path (2026-09-14, written from
# the lead's section-34 audit): a failed orphan whose turn ended on its own
# context gets its retention deadline from the host's sweep in lmx_msg_drive
# (lmx_msg_orphan_sweep), the one settlement path for orphan roots on both
# paths since stage 5 (c). Scenario 5 of lmx_model_family_release_17_selftest
# pins the host path; the executor selftest's mapped orphan is a successful
# one. This test pins the sweep: R has P, P has C; C is bound with one input;
# R stops P and releases it at once, so C is re-rooted at the runtime as an
# orphan, still bound; C's turn then ends on its own context without
# completing (failed). Logical clock 5000, retention 100: the first drive gives
# C its deadline (5100) and keeps it, a drive at 5050 keeps it, a drive at 5100
# reclaims it (S6-2: this WAS the slot count rt\n, because find cannot tell a
# retained unreachable subtree from a freed one -- and after the settle that state
# is the normal one; the owner's settled list that replaced it was deleted in turn,
# and gone_after_r0_round below reads the record freed by its service in R0's round)
# through release_slot's unbind-first path, and its
# context worker leaves (lmx_msg_exec_workers). Red-first: deleting the sweep's
# deadline assignment reclaims the orphan at the first drive, so "within the
# retention window" fails.
#
# Stage M: no Message steps another, and the runtime creates R0 alone (the
# slot counts have no UI lane). P is mapped onto its own context by R's own
# turn (run_entry_turn on the host thread; R is one of R0's direct children)
# and runs its closing turn there. C is mapped by R0's own turn only after P's
# release re-rooted it under R0: before its map point C has no thread, so the
# checks on C up to there are deterministic, and "the release does not wait
# for C" is read by flags when the release returns (C not settled, success 0).
# This replaces the test-driver cells that held C inside its turn and their
# wall-clock waits: C's turn ends failed on its own context after the release,
# read on later rounds. Observation loops yield
# between reads, with no deadline.

int: checks 0
int: failures 0

# S6-2 (respecified 2026-09-16 by the removal ruling): the owner's settled list is
# deleted. A released record is freed BY ITS SERVICE, in R0's round, so "the
# record became storage" is literal now: after R0's round it is gone. The helper
# runs that round (lmx_msg_pump; the host is R0's lane) and answers whether the
# record is gone in both senses: find no longer reaches it, AND R0's live set no
# longer holds its id. find alone cannot tell a freed record from a released one
# still retained (a released record is unlinked before its service frees it); the
# live-set entry is removed only by the service's found-and-removed unregister,
# immediately before its free. The set is read by id on R0's lane (the host), so
# no freed record is dereferenced. owner is kept so each site still names whose
# storage the record was; nothing records that any more, so it is not read.
fn: gone_after_r0_round (@: LmxMsgRuntime rt; LmxMsgAddr: owner; LmxMsgAddr: who) int
    @: LmxMsg r0
    int: i 0
    lmx_msg_pump(rt)
    if: lmx_msg_find(rt, who) != 0
        return: 0
    r0: lmx_msg_find(rt, lmx_msg_root_addr(rt))
    if: r0 = 0
        return: 0
    while: i < r0\live_n
        if: r0\live_id[i] = who
            return: 0
        ---
        i: i + 1
    ---
return: 1

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

# P's turn: it ends failed at once (its closing turn after R's stop).
fn: turn_parent_fail (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    if: ctx != 0
        return: 1
    return: lmx_msg_end_turn(rt, who, 0)

# C's turn on its own context: take the input if the body runs, then end
# without completing: a failed orphan by then.
fn: turn_orphan_fail (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    @: LmxMsgEnv got
    if: ctx != 0
        return: 1
    got: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    if: got = 0
        return: 2
    if: lmx_msg_recv(rt, who, got) = c.LMX_MSG_OK
        lmx_msg_env_release(got)
    ---
    c.free((cast: (@: void) got))
    return: lmx_msg_end_turn(rt, who, 0)

# R's own turn maps its child P named in the cell; [1] is map_child's status.
fn: turn_r_map (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    @: unsigned cell
    if: ctx = 0
        return: 1
    cell: (cast: (@: unsigned) ctx)
    cell[1]: (cast: (unsigned) lmx_msg_map_child(rt, who, cell[0]))
    return: lmx_msg_end_turn(rt, who, 1)

# R0's own turn maps an orphan re-rooted under R0; [1] is map_child's status.
fn: turn_root_map (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    @: unsigned cell
    if: ctx = 0
        return: 1
    cell: (cast: (@: unsigned) ctx)
    cell[1]: (cast: (unsigned) lmx_msg_map_child(rt, who, cell[0]))
    return: lmx_msg_end_turn(rt, who, 1)

[]: unsigned r_cell 2
[]: unsigned root_cell 2

# R maps P in R's own turn. Returns run_entry_turn's status, else map_child's.
fn: r_maps (@: LmxMsgRuntime rt; unsigned: r; unsigned: p) int
    int: st
    r_cell[0]: p
    r_cell[1]: (cast: (unsigned) c.LMX_MSG_INVALID)
    st: lmx_msg_run_entry_turn(rt, r, turn_r_map, (cast: (@: void) r_cell))
    if: st != c.LMX_MSG_OK
        return: st
    return: (cast: (int) r_cell[1])

# R0 maps an orphan re-rooted under it, in R0's own turn. Returns root_turn's
# status, else map_child's.
fn: root_maps (@: LmxMsgRuntime rt; unsigned: child) int
    int: st
    root_cell[0]: child
    root_cell[1]: (cast: (unsigned) c.LMX_MSG_INVALID)
    st: lmx_msg_root_turn(rt, turn_root_map, (cast: (@: void) root_cell))
    if: st != c.LMX_MSG_OK
        return: st
    return: (cast: (int) root_cell[1])

fn: main () int
    @: LmxMsgRuntime rt
    @: LmxMsgEnv env
    @: LmxMsg cm
    unsigned: r 0U
    unsigned: p 0U
    unsigned: cc 0U
    int: st 0
    uchar: ini 1

    # Unbuffered: a run the runner kills still shows its reading lines and FAILs.
    c.setvbuf(c.stdout, 0, c._IONBF, 0U)
    rt: lmx_msg_runtime_new()
    check(rt != 0 && lmx_msg_create(rt, 0U, @ ini, 1U, @ r, 0) = c.LMX_MSG_OK, "R, the root, created")
    if: rt = 0 || r = 0U
        return: 2
    check(lmx_msg_create(rt, r, @ ini, 1U, @ p, 0) = c.LMX_MSG_OK && lmx_msg_end_turn(rt, r, 1) = c.LMX_MSG_OK, "P created and published")
    env: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    if: env = 0
        return: 2
    env\kind: c.LMX_MSG_KIND_NUMBER
    env\number: 7
    env\from_msg: c.lmx_msg_turn_self(rt)
    # AD pair: to_msg CANNOT — no handle (create+send same expr; capture needs split)
    check(lmx_msg_create(rt, p, @ ini, 1U, @ cc, 0) = c.LMX_MSG_OK && lmx_msg_send(rt, p, cc, env) = c.LMX_MSG_STAGED && lmx_msg_end_turn(rt, p, 1) = c.LMX_MSG_OK, "C created by P with one input staged; P published")
    c.free((cast: (@: void) env))
    check(lmx_msg_exec_bind(rt, p, turn_parent_fail, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK && lmx_msg_exec_bind(rt, cc, turn_orphan_fail, 0, c.LMX_MSG_AFFINITY_ANY) = c.LMX_MSG_OK, "P and C bound")
    check(lmx_msg_pump(rt) = c.LMX_MSG_OK && lmx_msg_inbox_n(rt, cc) = 1 && lmx_msg_exec_workers(rt) = 0, "C's input admitted; nothing is mapped yet")
    check(lmx_msg_set_now(rt, 5000U) = c.LMX_MSG_OK && lmx_msg_set_orphan_retain(rt, 100U) = c.LMX_MSG_OK, "clock 5000; the orphan-retention policy set to 100")
    check(lmx_msg_emergency_cancel(rt, p) = c.LMX_MSG_OK, "R stops P while C runs")
    st: r_maps(rt, r, p)
    check(st = c.LMX_MSG_OK, "R's own turn maps P: its closing turn runs on its own worker")
    # R's release below settles P only when P is handoff-ready (its worker has
    # left the turn: native_users 0), which run_one sets after the end-turn that
    # writes STOPPED; so the loop reads both.
    c.printf("reading: P STOPPED and handoff-ready after its closing turn on its worker\n")
    while: lmx_msg_state(rt, p) != c.LMX_MSG_STATE_STOPPED || lmx_msg_handoff_ready(rt, p) = 0
        c.SwitchToThread()
    ---
    check(lmx_msg_state(rt, p) = c.LMX_MSG_STATE_STOPPED, "P ran its closing turn: stopped, C's close requested")
    # C has no thread until R0 maps it after P's release: the checks on C up to
    # that map point are deterministic.
    cm: lmx_msg_find(rt, cc)
    check(lmx_msg_dispose_child(rt, r, p) = c.LMX_MSG_OK && lmx_msg_find(rt, p) = 0 && lmx_msg_find(rt, cc) != 0 && lmx_msg_child_n(rt, r) = 0 && gone_after_r0_round(rt, r, p) != 0 && lmx_msg_exec_is_bound(rt, cc) != 0, "R releases P at once: P becomes R's storage, C is re-rooted at the runtime, still bound")
    check(cm != 0 && lmx_msg_success_load(cm) = 0 && lmx_msg_handoff_ready(rt, cc) = 0, "the release does not wait for C: when it returns C is not settled, success 0")
    st: root_maps(rt, cc)
    check(st = c.LMX_MSG_OK, "R0's own turn maps the re-rooted C onto its own context")
    c.printf("reading: C handoff-ready and not running, its turn ended failed on its worker\n")
    while: cm != 0 && (lmx_msg_handoff_ready(rt, cc) = 0 || lmx_msg_running_load(cm) != 0)
        c.SwitchToThread()
    ---
    check(cm != 0 && cm\orphan != 0 && cm\parent_msg = lmx_msg_find(rt, lmx_msg_root_addr(rt)) && lmx_msg_handoff_ready(rt, cc) != 0 && lmx_msg_running_load(cm) = 0 && lmx_msg_success_load(cm) = 0 && lmx_msg_find(rt, cc) != 0 && gone_after_r0_round(rt, lmx_msg_root_addr(rt), cc) = 0, "C's turn ended failed on its context: a settled orphan re-rooted under R0, not yet R0's storage")
    check(lmx_msg_drive(rt, 5000U, 0U) = c.LMX_MSG_OK && lmx_msg_find(rt, cc) != 0 && gone_after_r0_round(rt, lmx_msg_root_addr(rt), cc) = 0 && cm\orphan_until = 5100U, "the first drive's sweep gives the mapped failed orphan its deadline, 5100, and keeps it")
    check(lmx_msg_set_now(rt, 5050U) = c.LMX_MSG_OK && lmx_msg_drive(rt, 5050U, 0U) = c.LMX_MSG_OK && lmx_msg_find(rt, cc) != 0 && gone_after_r0_round(rt, lmx_msg_root_addr(rt), cc) = 0, "within the retention window the orphan is retained")
    check(lmx_msg_set_now(rt, 5100U) = c.LMX_MSG_OK, "clock 5100")
    c.printf("reading: the slot count after the host's drives at 5100\n")
    st: lmx_msg_drive(rt, 5100U, 0U)
    # S6-2: the loop waited on the count. The property it was really after is that
    # the sweep has finished with the orphan -- it has left the tree -- and the
    # assertion that follows carries what that means, which is that it became R0's
    # storage. A wait and the assertion after it must not share a predicate, or the
    # case passes vacuously.
    while: lmx_msg_find(rt, cc) != 0
        c.SwitchToThread()
        st: lmx_msg_drive(rt, 5100U, 0U)
    ---
    check(st = c.LMX_MSG_OK && gone_after_r0_round(rt, lmx_msg_root_addr(rt), cc) != 0 && lmx_msg_find(rt, r) != 0, "past its deadline the drive reclaims the failed orphan through release_slot: it is R0's storage now, and only R0 and R are still on the tree")
    c.printf("reading: the worker count after the reclaim's unbind\n")
    while: lmx_msg_exec_workers(rt) != 0
        st: lmx_msg_drive(rt, 5100U, 0U)
        c.SwitchToThread()
    ---
    check(lmx_msg_exec_workers(rt) = 0, "the orphan's context worker left after the reclaim's unbind")
    lmx_msg_exec_stop(rt)
    check(lmx_msg_find(rt, r) != 0 && lmx_msg_running_load(lmx_msg_find(rt, r)) != 0, "the root runs on")
    lmx_msg_runtime_delete(rt)
    c.printf("orphan mapped 17: %d checks, %d failures\n", checks, failures)
    if: failures != 0
        return: 1
    return: 0
