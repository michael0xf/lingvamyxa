include: "<stdlib.h>" "<wchar.h>"

# c.sizeof as a C call argument arrives as a frame, not the surface atom, and
# its single operand was checked against a closed type list ("unknown foreign
# type" for `c.sizeof(c.wchar_t)`, 5e's fileio_win32). The operand is now a
# type spelled as written, or a formal or own field lowered to its C spelling.
fn: size_args (ulong: w) int
    int: zero 0
    if: c.abs(c.sizeof(c.wchar_t)) < 1
        return: 1
    if: c.abs(c.sizeof(zero)) != c.abs(c.sizeof(c.int))
        return: 2
    if: c.abs(c.sizeof(w)) < 4
        return: 3
    if: zero != 0 || w != 7U
        return: 4
    return: 0
end: size_args

fn: main () int
    return: size_args(7U)
end: main
