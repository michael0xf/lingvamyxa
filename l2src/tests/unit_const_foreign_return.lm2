include: "l1src/p0.lm1.h" "<stdlib.h>"

# A const-qualified pointer return of a foreign type, `const: @(T)` (Stage B).
# Only `const: @(char)` had a code; any other pointee was "unknown foreign
# type". The return and the call-result temporary keep the qualifier:
# `) const: @(LmP0Text)` and `const: @(LmP0Text l2_tN)`.
fn: same_text (const: @(LmP0Text t)) const: @(LmP0Text)
    return: t
end: same_text

fn: const_return () int
    @: LmP0Text x
    x: (cast: (@: LmP0Text) c.calloc(1U, c.sizeof(c.LmP0Text)))
    if: x = 0
        return: 1
    if: same_text(x) != x
        c.free(x)
        return: 2
    c.free(x)
    return: 0
end: const_return

fn: main () int
    return: const_return()
end: main
