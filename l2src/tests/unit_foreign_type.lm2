predef: "l2src/tests/unit_foreign_type.h.lm1"

fn: identity (@: L2ForeignPair p) @: L2ForeignPair
    return: p
end: identity

fn: is_null (const: @(L2ForeignPair p)) int
    if: p = 0
        return: 1
    return: 0
end: is_null

fn: main () int
    @: L2ForeignPair p 0
    if: identity(p) != 0
        return: 81
    if: is_null(p) != 1
        return: 82
    return: 0
end: main
