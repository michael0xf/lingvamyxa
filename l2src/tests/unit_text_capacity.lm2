predef: "l2src/tests/unit_text_capacity.h.lm1"

# app_controller's "translation failed with no located diagnostic": a call whose
# emitted text passed 255 bytes failed l2_cat's fixed-buffer check in
# l2_emit_ccall, and nothing on that path printed a diagnostic. Twelve field-path
# actuals emit about 460 bytes, past the old 256-byte buffers and inside the
# text capacity.

fn: probe_text_long (@: ProbeTextCtx ctx) int
    return: probe_text_take12(ctx\probe_text_capacity_field_00, ctx\probe_text_capacity_field_01, ctx\probe_text_capacity_field_02, ctx\probe_text_capacity_field_03, ctx\probe_text_capacity_field_04, ctx\probe_text_capacity_field_05, ctx\probe_text_capacity_field_06, ctx\probe_text_capacity_field_07, ctx\probe_text_capacity_field_08, ctx\probe_text_capacity_field_09, ctx\probe_text_capacity_field_10, ctx\probe_text_capacity_field_11)
end: probe_text_long

fn: main () int
    return: 0
end: main
