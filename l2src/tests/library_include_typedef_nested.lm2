predef: "l2src/tests/library_include_typedef_nested.h.lm1"

# Two levels of C header below the predef'd .h.lm1. L2TestOuter is declared in
# the header the .h.lm1 includes; L2TestInner only in a header THAT one includes.
# The two headers include each other under guards, so following #include lines
# must stop on the cycle.

fn: l2_test_outer_nonnull (@: L2TestOuter handle) int
    if: handle = 0
        return: 0
    return: 1
end: l2_test_outer_nonnull

fn: l2_test_inner_nonnull (@: L2TestInner handle) int
    if: handle = 0
        return: 0
    return: 1
end: l2_test_inner_nonnull
