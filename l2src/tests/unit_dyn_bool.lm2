fn: leaf () int
    node\quote: 90
    if: quote = 65
        return: 1
    return: 0
end: leaf
fn: mid () int
    return: leaf()
end: mid
fn: wrap (int: x) int
    return: x
end: wrap
fn: m (int: z) int
    char: quote
    quote: 65
    if: z = 0
        return: 0 && leaf()
    if: z = 1
        return: 1 || leaf()
    if: z = 2
        return: 1 && leaf()
    if: z = 3
        return: 0 || leaf()
    if: z = 4
        return: 1 && mid()
    if: z = 5
        return: 0 && mid()
    if: z = 6
        return: 1 && wrap(leaf())
    if: z = 7
        return: 0 && wrap(leaf())
    return: 9
end: m
fn: main () int
    return: 0
end: main
