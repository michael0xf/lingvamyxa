include: "l2src/lmx_message.h" "<stdio.h>" "<stdlib.h>" "<windows.h>"

# Single-thread test-driver observation only, not shared Message runtime state.
prototype:
    fn: __real_free (@: void p) void
end: prototype
int: send_checks 0
int: owned_frees 0
@: void watched_owned 0

# Stage M: yield-round observation. No wait, no Sleep, no wall clock, no
# round bound; SwitchToThread between reads so the bound Message's own
# thread makes progress, and the runner's own timeout is the loop's real
# bound. lmx_msg_exec_holding_turn reads per-thread TLS (true only on the
# thread that holds the turn), so it cannot answer "has some other thread
# taken this turn yet" -- an observer polls a mailbox-lock-protected
# property instead (inbox_n back to 0: the mail this test sent to wake
# the Message has been received). The same text in every migrated test
# that waits on a Message's own thread.
# The kernel's own success flag, set once by the handler as its last act,
# is the observer-safe "this turn's checks fully ran" signal (matching the
# family_release_17 pattern: running/success reads, never a wait). Draining
# the mail alone only proves the turn started, not that it finished.
fn: yield_until_success (@: LmxMsgRuntime rt; unsigned: who) int
    @: LmxMsg m
    m: lmx_msg_live_lookup(rt\root, who)
    if: m = 0
        return: 0
    while: c.lmx_msg_success_load(m) = 0
        # S6-2 (the drain ruling): no worker drains; the driver thread is R0's lane.
        lmx_msg_pump(rt)
        c.SwitchToThread()
    return: 1

# Stage M: send_query_turn's target is not R0's direct child, so it needs a
# real thread of its own (bind, start_contexts, the yield-round wait above).
# The mail that wakes it is admitted through R0's direct child's own
# synchronous turn (lmx_msg_run_entry_turn, M's "what stays"), since the
# bootstrap thread loses its blanket send/recv/end_turn privilege the
# moment any context has ever been started.
unsigned: send_via_root_to 0U
@: LmxMsgEnv send_via_root_env 0

fn: send_via_root_turn (@: LmxMsgRuntime rt; LmxMsgAddr: who; @: void ctx) int
    if: ctx != 0
        return: 1
    send_via_root_env\from_msg: c.lmx_msg_turn_self(rt)
    # AD pair: to_msg CANNOT — id from configuration
    if: lmx_msg_send(rt, who, send_via_root_to, send_via_root_env) != c.LMX_MSG_STAGED
        return: 1
    ---
    return: lmx_msg_end_turn(rt, who, 1)

# R0's direct child (root) admits one envelope into a deeper descendant's
# inbox, synchronously, before any context is started.
fn: send_via_root (@: LmxMsgRuntime rt; unsigned: root; unsigned: to; @: LmxMsgEnv env) int
    send_via_root_to: to
    int: st
    send_via_root_env: env
    st: c.lmx_msg_run_entry_turn(rt, root, send_via_root_turn, 0)
    # S6-2 (the drain ruling): root's end-turn only pushes; R0's round admits.
    lmx_msg_pump(rt)
    return: st

sub: send_check (int: ok; const: @(char label))
    send_checks: send_checks + 1
    if: ok = 0
        c.printf("FAIL %s\n", label)
        c.exit(1)
    ---
end: send_check

sub: __wrap_free (@: void p)
    if: p != 0 && p = watched_owned
        owned_frees: owned_frees + 1
        watched_owned: 0
    ---
    c.__real_free(p)
end: __wrap_free

sub: send_init_case (@: LmxMsgRuntime rt; unsigned: who; @: LmxMsg source)
    @: LmxMsgEnv got
    @: uchar owned_copy
    got: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    send_check(got != 0, "allocate init result")
    got\id: 91U
    got\number: 92
    send_check(lmx_msg_init_copy(rt, who, 0) = LMX_MSG_INVALID, "null init output refused")
    send_check(lmx_msg_init_copy(rt, 0U, got) = LMX_MSG_INVALID, "invalid init address refused")
    send_check(got\id = 91U && got\number = 92 && got\bytes = 0 && got\n = 0U, "invalid init leaves output unchanged")
    send_check(lmx_msg_init_copy(rt, who, got) = LMX_MSG_OK, "copy initial data")
    send_check(got\id = 0U && got\correlation = 0U && source\parent_msg != 0 && got\reply_to = source\parent_msg\addr && got\kind = LMX_MSG_KIND_BYTES && got\number = 0, "init metadata contract")
    send_check(got\n = 1U && got\bytes != 0 && got\bytes != source\init && got\bytes[0] = 7, "init copy has independent allocation")
    # This returned allocation belongs to this test; the API exposes a const
    # view, so make the deliberate alias-independence probe explicit.
    owned_copy: (cast: (@: uchar) got\bytes)
    owned_copy[0]: 99
    send_check(source\init[0] = 7, "editing init copy preserves source")
    lmx_msg_env_release(got)
    send_check(got\bytes = 0 && got\n = 0U, "release init copy")
    send_check(lmx_msg_init_copy(rt, who, got) = LMX_MSG_OK && got\bytes[0] = 7, "repeat copy sees original data")
    lmx_msg_env_release(got)
    c.free(got)
end: send_init_case

# Stage M: child now runs on its own thread; the dummy envelope that woke
# it (send_via_root) is drained here first so its inbox is empty for the
# self query below, exactly as the pre-M forced turn found it.
fn: send_query_turn (@: LmxMsgRuntime rt; unsigned: who; @: void ctx) int
    @: LmxMsg source
    @: LmxMsgEnv wake
    c.array: [16]: unsigned addr
    int: addr_n 0
    int: st
    source: (cast: (@: LmxMsg) ctx)
    wake: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    send_check(wake != 0 && lmx_msg_recv(rt, who, wake) = LMX_MSG_OK, "drain the wake envelope in the real turn")
    lmx_msg_env_release(wake)
    c.free(wake)
    send_check(lmx_msg_turn_self(rt) = source, "real self-turn callback context")
    send_check(lmx_msg_state(rt, who) = source\state, "self state query")
    send_check(lmx_msg_inbox_n(rt, who) = 0, "self empty inbox query")
    # S6-2: the path accessors went with the arrays; the address is composed by
    # the walk, and its last index is the record's own index at its parent.
    addr_n: lmx_msg_get_address(rt, who, addr, 16)
    send_check(addr_n >= 2 && addr_n <= 16, "self address length query")
    send_check(addr_n >= 2 && addr_n <= 16 && addr[0] = 1U && addr[addr_n - 1] = source\index, "self address index query")
    send_check(lmx_msg_child_n(rt, who) = 0 && lmx_msg_child_at(rt, who, 0) = 0U, "self empty child queries")
    send_init_case(rt, who, source)
    st: lmx_msg_end_turn(rt, who, 1)
    # Last act, after end_turn's own work (collection, pump) is fully done:
    # the kernel's own success flag is this turn's observer-safe "fully ran"
    # signal (see yield_until_success above), not just "the handler started".
    c.lmx_msg_success_store(source, 1)
    return: st

sub: send_copy_case (@: LmxMsgRuntime rt; unsigned: from; unsigned: to; unsigned: untouched; unsigned: id)
    @: LmxMsgEnv env
    @: LmxMsgEnv got
    @: LmxMsg src
    @: LmxMsg dst
    @: LmxMsg other
    @: void other_init
    int: other_state
    []: uchar bytes 4
    env: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    got: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    send_check(env != 0 && got != 0, "allocate envelope fixture")
    src: lmx_msg_live_lookup(rt\root, from)
    # AD: keep tree walk — registration not drained
    dst: lmx_msg_find(rt, to)
    # AD: keep tree walk — registration not drained
    other: lmx_msg_find(rt, untouched)
    send_check(src != 0 && dst != 0 && other != 0, "find fixture endpoints")
    other_init: other\init
    other_state: other\state
    bytes[0]: 17
    bytes[1]: 0
    bytes[2]: 255
    bytes[3]: 41
    env\id: id
    env\correlation: id + 100U
    env\kind: LMX_MSG_KIND_BYTES
    env\number: 37
    env\bytes: bytes
    env\n: 4U
    send_check(src\outbox = 0 && dst\inbox = 0 && other\inbox = 0, "clean endpoint queues")
    env\from_msg: c.lmx_msg_turn_self(rt)
    # AD pair: to_msg CANNOT — no handle
    send_check(lmx_msg_send(rt, from, to, env) = LMX_MSG_STAGED, "send staged")
    send_check(src\outbox != 0 && src\outbox = src\outbox_tail && src\outbox\dest_msg = dst, "staged destination is exact endpoint")
    send_check(dst\inbox = 0 && other\inbox = 0, "staging is not admission")
    send_check(env\bytes = bytes && env\n = 4U && src\outbox\bytes != bytes, "copy send retains caller buffer")
    bytes[0]: 99
    send_check(src\outbox\bytes[0] = 17, "caller mutation does not change staged copy")
    # S6-2 (the drain ruling): a non-R0 end-turn only pushes; the host runs R0's round.
    send_check(lmx_msg_end_turn(rt, from, 1) = LMX_MSG_OK && lmx_msg_pump(rt) = LMX_MSG_OK, "commit sender turn")
    send_check(src\outbox = 0 && src\outbox_tail = 0 && dst\inbox != 0 && dst\inbox = dst\inbox_tail, "one admitted envelope and empty sender outbox")
    send_check(lmx_msg_recv(rt, to, got) = LMX_MSG_OK, "receive at intended destination")
    send_check(got\id = id && got\correlation = id + 100U && got\reply_to = 0U && got\kind = LMX_MSG_KIND_BYTES && got\number = 37, "envelope fields unchanged")
    send_check(got\n = 4U && got\bytes != 0 && got\bytes != bytes && got\bytes[0] = 17 && got\bytes[1] = 0 && got\bytes[2] = 255 && got\bytes[3] = 41, "binary payload delivered without caller alias")
    lmx_msg_env_release(got)
    send_check(got\bytes = 0 && got\n = 0U, "receive payload released")
    send_check(lmx_msg_end_turn(rt, to, 1) = LMX_MSG_OK, "finish receiver turn")
    send_check(lmx_msg_recv(rt, to, got) = LMX_MSG_EMPTY, "no duplicate envelope")
    send_check(other\inbox = 0 && other\inbox_tail = 0 && other\outbox = 0 && other\init = other_init && other\state = other_state, "unrelated sibling untouched")
    c.free(got)
    c.free(env)
end: send_copy_case

fn: main () int
    @: LmxMsgRuntime rt
    unsigned: root 0U
    unsigned: parent 0U
    unsigned: child 0U
    unsigned: sibling 0U
    unsigned: cousin_parent 0U
    unsigned: cousin 0U
    uchar: initial 7
    @: LmxMsg p
    @: LmxMsg d
    @: LmxMsg s
    @: LmxMsg q
    @: LmxMsg t
    @: LmxMsgEnv env
    @: LmxMsgEnv got
    @: LmxMsgEnv wake
    @: uchar payload
    @: void sibling_init
    int: sibling_state

    # The pinned prototype typedefs LmxMsgAddr as unsigned. One root, two
    # branches; the unrelated Q/T branch exercises the fallback lookup without
    # asserting a new global registry or a multi-root language model.
    rt: lmx_msg_runtime_new()
    send_check(rt != 0, "allocate runtime fixture")
    send_check(lmx_msg_create(rt, 0U, @ initial, 1U, @ root, 0) = LMX_MSG_OK, "create root")
    send_check(lmx_msg_create(rt, root, @ initial, 1U, @ parent, 0) = LMX_MSG_OK && lmx_msg_create(rt, root, @ initial, 1U, @ cousin_parent, 0) = LMX_MSG_OK, "create two branches")
    send_check(lmx_msg_end_turn(rt, root, 1) = LMX_MSG_OK, "commit branches")
    send_check(lmx_msg_create(rt, parent, @ initial, 1U, @ child, 0) = LMX_MSG_OK && lmx_msg_create(rt, parent, @ initial, 1U, @ sibling, 0) = LMX_MSG_OK && lmx_msg_end_turn(rt, parent, 1) = LMX_MSG_OK, "create direct child and sibling")
    send_check(lmx_msg_create(rt, cousin_parent, @ initial, 1U, @ cousin, 0) = LMX_MSG_OK && lmx_msg_end_turn(rt, cousin_parent, 1) = LMX_MSG_OK, "create unrelated branch recipient")
    # AD: keep tree walk — registration not drained
    p: lmx_msg_find(rt, parent)
    # AD: keep tree walk — registration not drained
    d: lmx_msg_find(rt, child)
    # AD: keep tree walk — registration not drained
    s: lmx_msg_find(rt, sibling)
    # AD: keep tree walk — registration not drained
    q: lmx_msg_find(rt, cousin_parent)
    # AD: keep tree walk — registration not drained
    t: lmx_msg_find(rt, cousin)
    send_check(p != 0 && d != 0 && s != 0 && q != 0 && t != 0, "resolve participants")
    send_check(d\parent_msg = p && s\parent_msg = p && t\parent_msg = q && q != p && p\parent_msg = q\parent_msg, "fixture family relations")
    send_copy_case(rt, parent, parent, sibling, 11U)
    send_copy_case(rt, parent, child, sibling, 12U)
    send_copy_case(rt, child, parent, sibling, 13U)
    send_copy_case(rt, parent, cousin, sibling, 14U)

    # Ownership transfer of a byte envelope is distinct from arena handoff.
    # After send_owned succeeds, payload is only an identity observation here;
    # the sender no longer reads, writes or frees its relinquished buffer.
    env: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    got: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    payload: (cast: (@: uchar) c.calloc(4U, 1U))
    send_check(env != 0 && got != 0 && payload != 0, "allocate owned envelope fixture")
    payload[0]: 23
    payload[1]: 0
    payload[2]: 255
    payload[3]: 47
    env\id: 15U
    env\correlation: 115U
    env\kind: LMX_MSG_KIND_BYTES
    env\bytes: payload
    env\n: 4U
    watched_owned: payload
    sibling_init: s\init
    sibling_state: s\state
    env\from_msg: c.lmx_msg_turn_self(rt)
    # AD pair: to_msg CANNOT — no handle
    send_check(lmx_msg_send_owned(rt, parent, child, env) = LMX_MSG_STAGED, "owned send staged")
    send_check(env\bytes = 0 && env\n = 0U && owned_frees = 0, "sender ownership consumed without freeing payload")
    send_check(p\outbox != 0 && p\outbox\dest_msg = d && p\outbox\bytes = payload && p\outbox\owned != 0 && d\inbox = 0, "owned staged pointer identity")
    send_check(lmx_msg_end_turn(rt, parent, 1) = LMX_MSG_OK && lmx_msg_pump(rt) = LMX_MSG_OK, "commit owned send")
    send_check(p\outbox = 0 && d\inbox != 0 && d\inbox\bytes = payload && d\inbox\owned != 0 && owned_frees = 0, "admission retains original payload address")
    send_check(lmx_msg_recv(rt, child, got) = LMX_MSG_OK && got\bytes = payload && got\n = 4U && got\id = 15U && got\correlation = 115U, "receiver obtains original buffer")
    send_check(got\bytes[0] = 23 && got\bytes[1] = 0 && got\bytes[2] = 255 && got\bytes[3] = 47 && owned_frees = 0, "owned bytes intact")
    payload: 0
    lmx_msg_env_release(got)
    send_check(owned_frees = 1 && watched_owned = 0 && got\bytes = 0 && got\n = 0U, "receiver frees original allocation once")
    lmx_msg_env_release(got)
    send_check(owned_frees = 1, "repeat release is empty")
    send_check(lmx_msg_end_turn(rt, child, 1) = LMX_MSG_OK && lmx_msg_recv(rt, child, got) = LMX_MSG_EMPTY, "owned delivery occurs once")
    send_check(s\inbox = 0 && s\outbox = 0 && s\init = sibling_init && s\state = sibling_state, "owned send also leaves sibling untouched")
    c.free(got)
    c.free(env)
    send_init_case(rt, child, d)
    # Stage M: child is not R0's direct child, so its query turn runs on its
    # own thread once contexts are started. Nothing before this point in the
    # test relies on the bootstrap thread's blanket send/recv/end_turn
    # privilege any more, so start_contexts only now.
    send_check(lmx_msg_exec_bind(rt, child, send_query_turn, d, LMX_MSG_AFFINITY_ANY) = LMX_MSG_OK, "bind real query callback")
    send_check(c.lmx_msg_exec_start_contexts(rt) = LMX_MSG_OK, "start contexts for the query callback's own thread")
    wake: (cast: (@: LmxMsgEnv) c.calloc(1U, c.sizeof(c.LmxMsgEnv)))
    send_check(wake != 0, "allocate wake envelope")
    wake\kind: LMX_MSG_KIND_NUMBER
    wake\id: 71U
    wake\number: 0
    send_check(send_via_root(rt, root, child, wake) = LMX_MSG_OK, "root admits the wake envelope into child's inbox")
    c.free(wake)
    send_check(yield_until_success(rt, child) != 0, "wait for the query callback's own turn to run and finish")
    lmx_msg_exec_unbind(rt, child)
    send_check(lmx_msg_turn_self(rt) = 0, "driver thread holds no turn of its own")
    lmx_msg_runtime_delete(rt)
    send_check(owned_frees = 1, "runtime teardown does not free released envelope again")
    c.printf("send local checks=%d failures=0 owned_frees=%d\n", send_checks, owned_frees)
    return: 0
