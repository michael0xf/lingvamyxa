# @: own addresses the graph-backed payload cell. Taking the address does not
# expose or dirty the activation cache. node\n reads that mutated graph cell.
fn: set_one (@: int p) int
    \p: 1
    return: 0
end: set_one
fn: test () int
    int: n
    n: 0
    set_one(@: n)
    c.printf: "%d %d\n" n node\n
    return: 0
end: test
fn: main () int
    return: test()
end: main
