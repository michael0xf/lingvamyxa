include: "l2src/lmx.h" "l2src/lmx_message.h" "<stdio.h>" "<stdlib.h>" "<string.h>"

# Test-only linker wrapping for library_open_failure.lm2. lmx_msg_runtime_new
# fails a set number of times; the mode argument picks the abort policy
# ("a" = abort, anything else = no abort). The generated library links the real
# Message core.
prototype:
    fn: lof_status () int
    fn: __real_lmx_msg_runtime_new () @: LmxMsgRuntime
end: prototype

int: fail_news 0
int: abort_policy 1

fn: __wrap_lmx_msg_runtime_new () @: LmxMsgRuntime
    if: fail_news > 0
        fail_news: fail_news - 1
        return: 0
    return: c.__real_lmx_msg_runtime_new()

fn: __wrap_lmx_msg_poll_abort () int
    return: abort_policy

# Two calls while the open fails, then one after it can succeed. Without the
# abort policy both failed calls report and return zero, and the third returns
# the real 7. With it, the first failed call reports and aborts.
fn: main (int: argc; @@: char argv) int
    int: r1
    int: r2
    int: r3
    if: argc != 2
        return: 9
    abort_policy: 0
    if: c.strcmp(argv[1], "a") = 0
        abort_policy: 1
    fail_news: 2
    r1: lof_status()
    r2: lof_status()
    c.printf("r1=%d r2=%d\n", r1, r2)
    r3: lof_status()
    c.printf("r3=%d\n", r3)
    return: 0
