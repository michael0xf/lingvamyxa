include: "mixa_manager/mixa_app_controller.h" "<stdio.h>" "<stdlib.h>" "<windows.h>"

# Clean L2 translation of mixa_app_main.lm1 (ticket 20260913-133500).
# No predef and no L2-owned struct header at all -- this file is the
# smallest possible honest adapter, which here is NONE: MixaAppController
# is genuinely opaque (a plain C `typedef struct MixaAppController
# MixaAppController;` with no body anywhere), and MixaBackendVTable is
# only ever passed through as an opaque pointer, never dereferenced --
# main() itself touches no struct field of any kind. mixa_app_
# controller.h/mixa_backend.h are both plain, hand-written C headers,
# included directly exactly like the real oracle does; ordinary C
# prototype resolution at gcc-compile time supplies mixa_backend_
# default_table/mixa_app_controller_open/step/running/close, no L1-
# level forward declare needed for any of them (matching the fix
# already established for mixa_console_window/mixa_cmdline_dispatch).
#
# Body is UNCHANGED L1-family text -- no adaptation of any kind was
# needed. Preserves exactly: the argv[1]-or-"." root selection, the
# backend-table-unavailable early refusal, controller-open failure
# handling (prints and returns 1, no loop entered), the step loop's
# own "stop on either not-running or had_error" condition (had_error
# is sticky -- once set, the loop does not call step() again), the
# had_error diagnostic print, and close()-then-check-had_error exit
# code (1 on error, 0 otherwise) -- close() is called unconditionally
# on the way out, whether or not an error occurred.

fn: main (int: argc; @: @(char) argv) int
    const: @(char root_utf8)
    const: @(MixaBackendVTable vt)
    @: MixaAppController c
    int: had_error
    int: rc
    if: argc >= 2
        root_utf8: argv[1]
    else:
        root_utf8: "."
    ---
    vt: mixa_backend_default_table()
    if: vt = 0
        c.printf("mixa_app_main: no backend table available\n")
        return: 1
    ---
    c: 0
    rc: mixa_app_controller_open(@ c, vt, root_utf8)
    if: rc != MIXA_APP_CONTROLLER_OK
        c.printf("mixa_app_main: controller open failed (%d)\n", rc)
        return: 1
    ---
    had_error: 0
    while: mixa_app_controller_running(c) != 0 && had_error = 0
        mixa_app_controller_step(c, @ had_error)
        if: had_error != 0
            c.printf("mixa_app_main: controller reported an error -- terminating cleanly\n")
        ---
    ---
    mixa_app_controller_close(c)
    if: had_error != 0
        return: 1
    ---
return: 0
