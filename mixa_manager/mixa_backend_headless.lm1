predef: "mixa_manager/mixa_event_fifo.lm1"
include: "mixa_manager/mixa_backend_headless.h" "<stdlib.h>" "<string.h>"

# Headless MixaBackend: no window, no font, no platform. Seam ops plus
# push_event / frame_at for tests. Design: BACKEND_SEAM.txt.
# Event queue is mixa_event_fifo (Milestone 3 groundwork).

fn: mixa_backend_open (@: MixaBackend backend; size_t: cols; size_t: rows; @: MixaCellMetrics metrics) int
    size_t: width
    size_t: height
    size_t: nbytes
    size_t: cell_width
    size_t: cell_height
    size_t: upper_cell_width
    size_t: upper_cell_height
    @: MixaU8 block
    @: MixaEventFifo inbox
    if: backend = 0
        return: 1
    if: metrics = 0
        return: 1
    if: cols = 0U
        return: 1
    if: rows = 0U
        return: 1
    if: metrics\text_cell_width = 0U
        return: 1
    if: metrics\text_cell_height = 0U
        return: 1
    if: metrics\upper_cell_width = 0U
        return: 1
    if: metrics\upper_cell_height = 0U
        return: 1
    # Honour the request for both layers; geometry uses the TEXT cell only.
    cell_width: metrics\text_cell_width
    cell_height: metrics\text_cell_height
    upper_cell_width: metrics\upper_cell_width
    upper_cell_height: metrics\upper_cell_height
    if: backend\is_open != 0
        return: 1
    if: backend\frame != 0
        return: 1
    if: cols > ((cast: (size_t) -1) / cell_width)
        return: 1
    if: rows > ((cast: (size_t) -1) / cell_height)
        return: 1
    width: cols * cell_width
    height: rows * cell_height
    if: width = 0U
        return: 1
    if: height = 0U
        return: 1
    if: height > ((cast: (size_t) -1) / width)
        return: 1
    if: (width * height) > ((cast: (size_t) -1) / 4U)
        return: 1
    nbytes: width * height * 4U
    block: (cast: (@: MixaU8) c.calloc(nbytes, 1U))
    if: block = 0
        return: 1
    inbox: (cast: (@: MixaEventFifo) c.calloc(1U, c.sizeof(c.MixaEventFifo)))
    if: inbox = 0
        c.free(block)
        return: 1
    if: mixa_event_fifo_init(inbox) != 0
        c.free(inbox)
        c.free(block)
        return: 1
    backend\is_open: 1
    backend\cols: cols
    backend\rows: rows
    backend\cell_width: cell_width
    backend\cell_height: cell_height
    backend\frame_w: width
    backend\frame_h: height
    backend\frame_bytes: nbytes
    backend\frame: block
    backend\inbox: inbox
    # Write back what we actually used (honour request for both layers).
    metrics\text_cell_width: cell_width
    metrics\text_cell_height: cell_height
    metrics\upper_cell_width: upper_cell_width
    metrics\upper_cell_height: upper_cell_height
return: 0
fn: mixa_backend_present (@: MixaBackend backend; const: @(MixaU8 rgba); size_t: bytes) int
    if: backend = 0
        return: 1
    if: backend\is_open = 0
        return: 1
    if: backend\frame = 0
        return: 1
    if: rgba = 0
        return: 1
    if: bytes < backend\frame_bytes
        return: 1
    c.memcpy(backend\frame, rgba, backend\frame_bytes)
return: 0

fn: mixa_backend_poll (@: MixaBackend backend; @: MixaEvent out) int
    @: MixaU8 block
    @: MixaU8 old_frame
    size_t: new_cols
    size_t: new_rows
    size_t: cw
    size_t: ch
    size_t: width
    size_t: height
    size_t: nbytes
    if: backend = 0
        return: 1
    if: out = 0
        return: 1
    if: backend\is_open = 0
        out\kind: MIXA_EVENT_NONE
        return: 1
    if: backend\inbox = 0
        out\kind: MIXA_EVENT_NONE
        return: 1
    if: mixa_event_fifo_pop(backend\inbox, out) != 0
        out\kind: MIXA_EVENT_NONE
        return: 0
    ---
    # Delivering RESIZE also adopts the new geometry (BACKEND_SEAM / F1).
    if: out\kind = MIXA_EVENT_RESIZE
        new_cols: out\cols
        new_rows: out\rows
        cw: backend\cell_width
        ch: backend\cell_height
        if: new_cols = 0U
            return: 1
        ---
        if: new_rows = 0U
            return: 1
        ---
        if: cw = 0U
            return: 1
        ---
        if: ch = 0U
            return: 1
        ---
        if: new_cols > ((cast: (size_t) -1) / cw)
            return: 1
        ---
        if: new_rows > ((cast: (size_t) -1) / ch)
            return: 1
        ---
        width: new_cols * cw
        height: new_rows * ch
        if: width = 0U
            return: 1
        ---
        if: height = 0U
            return: 1
        ---
        if: height > ((cast: (size_t) -1) / width)
            return: 1
        ---
        if: (width * height) > ((cast: (size_t) -1) / 4U)
            return: 1
        ---
        nbytes: width * height * 4U
        block: (cast: (@: MixaU8) c.calloc(nbytes, 1U))
        if: block = 0
            return: 1
        ---
        # New buffer secured; only then replace the old surface.
        old_frame: backend\frame
        backend\frame: block
        backend\cols: new_cols
        backend\rows: new_rows
        backend\frame_w: width
        backend\frame_h: height
        backend\frame_bytes: nbytes
        if: old_frame != 0
            c.free(old_frame)
        ---
    ---
return: 0

fn: mixa_backend_clipboard_get (@: MixaBackend backend; @: char out; size_t: cap) size_t
    size_t: n
    if: backend = 0
        return: 0U
    if: out = 0
        return: 0U
    if: backend\is_open = 0
        return: 0U
    if: backend\clipboard = 0
        if: cap < 1U
            return: 0U
        out[0]: (cast: (char) 0)
        return: 0U
    n: backend\clipboard_len
    if: cap < (n + 1U)
        return: n
    c.memcpy(out, backend\clipboard, n)
    out[n]: (cast: (char) 0)
return: n

fn: mixa_backend_clipboard_set (@: MixaBackend backend; const: @(char text)) int
    size_t: n
    @: char block
    if: backend = 0
        return: 1
    if: backend\is_open = 0
        return: 1
    if: text = 0
        return: 1
    n: c.strlen(text)
    block: (cast: (@: char) c.malloc(n + 1U))
    if: block = 0
        return: 1
    c.memcpy(block, text, n + 1U)
    if: backend\clipboard != 0
        c.free(backend\clipboard)
    ---
    backend\clipboard: block
    backend\clipboard_len: n
return: 0

sub: mixa_backend_close (@: MixaBackend backend)
    if: backend != 0
        if: backend\frame != 0
            c.free(backend\frame)
        ---
        if: backend\clipboard != 0
            c.free(backend\clipboard)
        ---
        if: backend\inbox != 0
            mixa_event_fifo_release(backend\inbox)
            c.free(backend\inbox)
        ---
        backend\frame: 0
        backend\clipboard: 0
        backend\inbox: 0
        backend\frame_w: 0U
        backend\frame_h: 0U
        backend\frame_bytes: 0U
        backend\cols: 0U
        backend\rows: 0U
        backend\cell_width: 0U
        backend\cell_height: 0U
        backend\clipboard_len: 0U
        backend\is_open: 0
    ---
end: mixa_backend_close

fn: mixa_backend_push_event (@: MixaBackend backend; const: @(MixaEvent ev)) int
    @: MixaEvent local
    if: backend = 0
        return: 1
    if: ev = 0
        return: 1
    if: backend\is_open = 0
        return: 1
    if: backend\inbox = 0
        return: 1
    local: (cast: (@: MixaEvent) c.malloc(c.sizeof(c.MixaEvent)))
    if: local = 0
        return: 1
    c.memcpy(local, ev, c.sizeof(c.MixaEvent))
    # Mouse: incoming col/row are pixels; convert once to cells before push.
    if: local\kind = MIXA_EVENT_MOUSE
        if: backend\cell_width = 0U || backend\cell_height = 0U
            c.free(local)
            return: 1
        ---
        local\col: local\col / backend\cell_width
        local\row: local\row / backend\cell_height
    ---
    if: mixa_event_fifo_push(backend\inbox, local) != 0
        c.free(local)
        return: 1
    c.free(local)
return: 0

fn: mixa_backend_frame_at (@: MixaBackend backend; size_t: x; size_t: y; @: MixaU8 out) int
    @: MixaU8 px
    if: backend = 0
        return: 1
    if: out = 0
        return: 1
    if: backend\is_open = 0
        return: 1
    if: backend\frame = 0
        return: 1
    if: x >= backend\frame_w
        return: 1
    if: y >= backend\frame_h
        return: 1
    px: backend\frame + ((y * backend\frame_w + x) * 4U)
    out[0]: px[0]
    out[1]: px[1]
    out[2]: px[2]
    out[3]: px[3]
return: 0