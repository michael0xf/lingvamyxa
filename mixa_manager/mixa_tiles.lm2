predef: "mixa_manager/mixa_tiles_l2.h.lm1"
include: "mixa_manager/mixa_overlay.h" "<string.h>"

# Clean L2 translation of mixa_tiles.lm1 (ticket 20260913-093000).
# Every function body below is unchanged L1-family colon/indentation
# syntax except for the 5 array-indexed field writes noted below (a
# mechanical adaptation to this L2 header's own byte-field
# representation, not a behavioral change -- see mixa_tiles_l2.h.lm1's
# own comment for why MixaCell's fg/bg/flags/width/alpha are declared as
# 1-element char arrays here instead of scalar unsigned char fields).
#
# Predefs mixa_tiles_l2.h.lm1 (MixaCell/MixaTextRect struct declarations
# + the 6 tile constants this file's own body uses + a forward
# declaration of mixa_cell_at, linked against the real, unchanged
# mixa_text_rect.lm1 object -- that module is out of this ticket's own
# scope and is not being ported). Plainly `include:`s the real
# mixa_overlay.h (MixaU8, mixa_palette_rgb, the 16-color palette table)
# directly -- it is a struct-free, self-contained C header (verified: it
# does not itself include mixa_core.h), so no redefinition risk against
# the predef'd MixaCell/MixaTextRect above.
#
# Real typed MixaCell*/MixaTextRect*/MixaU8* API throughout, no fixed
# caps, no flattened void* substitute, the real growable/dynamic
# addressing (row-major cell indexing via mixa_cell_at, pixel buffer
# indexing via (py*width+px)*4) and the real src-over alpha blend
# arithmetic preserved exactly. Pure library of leaf functions (no
# main), matching the accepted L2 style already used by
# stg/l1_baseline/l2src/tests/unit_ptr_pass.lm2.
#
# Per Codex's own ticket: the frontend currently on main does not yet
# have the integrated support for custom struct pointers/casts/native
# pointer indexing/[]: size_t backing-pointer decay this file uses
# throughout -- a refusal on current main is expected and is NOT a
# defect in this source; see mixa_tiles_l2_port.txt for the measured,
# current-main diagnostic and run_mixa_tiles_l2_parity.ps1 for the
# harness that will turn green once the integrated frontend lands.

fn: mixa_tile_gap_px (size_t: cell_h) size_t
    size_t: g
    g: cell_h >> 5U
    if: g = 0U
        g: 1U
    ---
return: g

fn: mixa_tile_is (unsigned: codepoint) int
    if: codepoint >= MIXA_TILE_BASE && codepoint <= MIXA_TILE_LAST
        return: 1
return: 0

fn: mixa_tile_gaps (unsigned: codepoint) unsigned
    if: mixa_tile_is(codepoint) = 0
        return: 0U
return: codepoint & 0xFU

fn: mixa_tile_from_gaps (unsigned: gaps) unsigned
return: MIXA_TILE_BASE | (gaps & 0xFU)

fn: mixa_tile_pixel_solid (unsigned: codepoint; size_t: lx; size_t: ly; size_t: cell_w; size_t: cell_h) int
    unsigned: gaps
    size_t: g
    if: mixa_tile_is(codepoint) = 0
        return: 0
    if: cell_w = 0U || cell_h = 0U
        return: 0
    if: lx >= cell_w || ly >= cell_h
        return: 0
    gaps: mixa_tile_gaps(codepoint)
    g: mixa_tile_gap_px(cell_h)
    if: (gaps & MIXA_TILE_GAP_L) != 0U
        if: lx < g
            return: 0
        ---
    ---
    if: (gaps & MIXA_TILE_GAP_R) != 0U
        if: cell_w <= g
            return: 0
        ---
        if: lx >= (cell_w - g)
            return: 0
        ---
    ---
    if: (gaps & MIXA_TILE_GAP_T) != 0U
        if: ly < g
            return: 0
        ---
    ---
    if: (gaps & MIXA_TILE_GAP_B) != 0U
        if: cell_h <= g
            return: 0
        ---
        if: ly >= (cell_h - g)
            return: 0
        ---
    ---
return: 1

fn: mixa_tile_paint_cell (unsigned: codepoint; unsigned: bg; unsigned: alpha; size_t: cell_x; size_t: cell_y; size_t: cell_w; size_t: cell_h; @: MixaU8 out_rgba; size_t: width; size_t: height) int
    @: MixaU8 p
    []: MixaU8 pr 1
    []: MixaU8 pg 1
    []: MixaU8 pb 1
    size_t: lx
    size_t: ly
    size_t: px
    size_t: py
    unsigned: sa
    unsigned: inv
    unsigned: sr
    unsigned: sg
    unsigned: sb
    unsigned: dr
    unsigned: dg
    unsigned: db
    if: out_rgba = 0
        return: 1
    if: mixa_tile_is(codepoint) = 0
        return: 0
    if: cell_w = 0U || cell_h = 0U
        return: 0
    sa: alpha
    if: sa = 0U
        return: 0
    c.mixa_palette_rgb(bg, pr, pg, pb)
    ly: 0U
    while: ly < cell_h
        lx: 0U
        while: lx < cell_w
            if: mixa_tile_pixel_solid(codepoint, lx, ly, cell_w, cell_h) != 0
                px: cell_x + lx
                py: cell_y + ly
                if: px < width && py < height
                    p: out_rgba + ((py * width + px) * 4U)
                    if: sa = 255U
                        p[0]: pr[0]
                        p[1]: pg[0]
                        p[2]: pb[0]
                        p[3]: (cast: (MixaU8) 255)
                    else:
                        inv: 255U - sa
                        sr: pr[0]
                        sg: pg[0]
                        sb: pb[0]
                        dr: p[0]
                        dg: p[1]
                        db: p[2]
                        p[0]: (cast: (MixaU8) ((sr * sa + dr * inv) / 255U))
                        p[1]: (cast: (MixaU8) ((sg * sa + dg * inv) / 255U))
                        p[2]: (cast: (MixaU8) ((sb * sa + db * inv) / 255U))
                        p[3]: (cast: (MixaU8) 255)
                    ---
                ---
            ---
            lx: lx + 1U
        ---
        ly: ly + 1U
    ---
return: 0

fn: mixa_tile_fill_button (@: MixaTextRect rect; size_t: row; size_t: col; size_t: nrows; size_t: ncols; unsigned: fg; unsigned: bg; unsigned: alpha) int
    size_t: i
    size_t: j
    size_t: r
    size_t: ccol
    unsigned: gaps
    @: MixaCell p
    if: rect = 0 || rect\cells = 0
        return: 1
    if: nrows = 0U || ncols = 0U
        return: 1
    if: row >= rect\rows || col >= rect\cols
        return: 1
    if: (row + nrows) > rect\rows || (col + ncols) > rect\cols
        return: 1
    i: 0U
    while: i < nrows
        j: 0U
        while: j < ncols
            gaps: 0U
            if: i = 0U
                gaps: gaps | MIXA_TILE_GAP_T
            ---
            if: i = (nrows - 1U)
                gaps: gaps | MIXA_TILE_GAP_B
            ---
            if: j = 0U
                gaps: gaps | MIXA_TILE_GAP_L
            ---
            if: j = (ncols - 1U)
                gaps: gaps | MIXA_TILE_GAP_R
            ---
            r: row + i
            ccol: col + j
            p: mixa_cell_at(rect, r, ccol)
            if: p = 0
                return: 1
            ---
            p\codepoint: mixa_tile_from_gaps(gaps)
            # fg/bg/flags/width/alpha are plain scalar MixaCellByte
            # fields in mixa_tiles_l2.h.lm1 (`MixaCellByte fg;`, not an
            # array) -- write them directly, no [0] index. The earlier
            # [0]-indexed writes were a bug that never got exercised
            # until d6's Stage B translator work cleared the barriers
            # blocking this module before it; found and fixed
            # 2026-09-14 re-verifying against that work.
            p\fg: (cast: (char) fg)
            p\bg: (cast: (char) bg)
            p\flags: (cast: (char) 0U)
            p\width: (cast: (char) 1U)
            p\alpha: (cast: (char) alpha)
            j: j + 1U
        ---
        i: i + 1U
    ---
return: 0
