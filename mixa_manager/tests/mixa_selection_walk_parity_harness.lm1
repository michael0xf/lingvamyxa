predef: "mixa_manager/mixa_selection_walk_l2.h.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# Real L1-vs-L2 parity harness for mixa_selection_walk (ticket
# 20260913-175200's own continuation, in dependency order). ONE
# harness source, compiled/linked twice (oracle/L2), "declare then
# link" -- mixa_selection_walk/mixa_selection_walk_is_root's own real
# bodies come from either the unchanged mixa_selection_walk.lm1
# (oracle side) or the generated mixa_selection_walk.lm2 (L2 side).
# mixa_selection_*/mixa_sel_cut_parent are real plain-C functions
# already visible via the L2 header's own predef chain -- no forward
# declare needed for any of them.
#
# Scenario coverage is drawn directly from the existing, already-
# accepted mixa_selection_walk_selftest.lm1 (12 scenarios): one
# selected directory walked whole in enter/children/complete structure
# (checked by POSITION, never assumed sibling order); a child exception
# excludes its whole subtree while siblings survive; a lower explicit
# selection under an exception is still reached as its own root; nested
# effective roots visited exactly once; the documented child-first
# consolidation case from SELECTION_MODEL.txt; an empty directory and a
# real UTF-8 (Cyrillic) directory name; a missing selected root reports
# the seam's own real status without touching the selection;
# cancellation and a caller-supplied failure code propagated verbatim
# with an exact call count; laziness (the first callback arrives before
# the whole tree is enumerated, measured via a real allocation
# counter); a real deterministic allocation-fault sweep across every
# owned allocation step (each refusal reports ERR_NOMEM, leaks
# nothing, changes nothing); root-array consolidation DURING the scan
# not losing the last root; argument negatives and an empty-selection
# no-op.

fn: mixa_selection_walk (@: MixaSelection sel; const: @(MixaSelWalkSink sink); const: @(MixaSelWalkAllocVTable av)) int
fn: mixa_selection_walk_is_root (@: MixaSelection sel; const: @(char path)) int

[]: char g_trace 8000
size_t: g_trace_len
int: g_stop_after
int: g_calls
int: g_fail_code
int: g_first_call_alloc_seq

int: g_alloc_fail_at
int: g_alloc_seq
int: g_alloc_live

fn: t_alloc (size_t: n) @: void
    @: void p
    g_alloc_seq: g_alloc_seq + 1
    if: g_alloc_fail_at != 0 && g_alloc_seq = g_alloc_fail_at
        return: 0
    ---
    p: c.malloc(n)
    if: p != 0
        g_alloc_live: g_alloc_live + 1
    ---
return: p

sub: t_free (@: void p)
    if: p = 0
        return
    ---
    g_alloc_live: g_alloc_live - 1
    c.free(p)
end: t_free

@: MixaSelWalkAllocVTable g_av
int: g_av_ready

fn: t_table () const: @(MixaSelWalkAllocVTable)
    if: g_av_ready = 0
        g_av: (cast: (@: MixaSelWalkAllocVTable) c.calloc(1U, c.sizeof(c.MixaSelWalkAllocVTable)))
        g_av\alloc: t_alloc
        g_av\free: t_free
        g_av_ready: 1
    ---
return: g_av

fn: t_base (const: @(char path)) const: @(char)
    size_t: n
    size_t: i
    size_t: last
    int: found
    n: c.strlen(path)
    last: 0U
    found: 0
    i: 0U
    while: i < n
        if: path[i] = (cast: (char) 92) || path[i] = (cast: (char) 47)
            last: i
            found: 1
        ---
        i: i + 1U
    ---
    if: found = 0
        return: path
return: path + last + 1U

sub: t_record (const: @(char kind); const: @(char path))
    const: @(char b)
    size_t: room
    b: t_base(path)
    if: g_trace_len + 64U >= 8000U
        return
    ---
    room: 8000U - g_trace_len
    c.snprintf(g_trace + g_trace_len, room, "%s:%s|", kind, b)
    g_trace_len: c.strlen(g_trace)
end: t_record

fn: t_note (const: @(char kind); const: @(char path)) int
    g_calls: g_calls + 1
    if: g_calls = 1
        g_first_call_alloc_seq: g_alloc_seq
    ---
    t_record(kind, path)
    if: g_fail_code != 0 && g_calls >= g_stop_after && g_stop_after != 0
        return: g_fail_code
    ---
    if: g_stop_after != 0 && g_calls >= g_stop_after
        return: MIXA_SEL_WALK_STOP
    ---
return: MIXA_SEL_WALK_GO

fn: t_on_dir (@: void ctx; const: @(char path); int: is_dir) int
return: t_note("D", path)

fn: t_on_file (@: void ctx; const: @(char path); int: is_dir) int
return: t_note("F", path)

fn: t_on_done (@: void ctx; const: @(char path); int: is_dir) int
return: t_note("E", path)

@: MixaSelWalkSink g_sink
int: g_sink_ready

fn: t_sink () const: @(MixaSelWalkSink)
    if: g_sink_ready = 0
        g_sink: (cast: (@: MixaSelWalkSink) c.calloc(1U, c.sizeof(c.MixaSelWalkSink)))
        g_sink\on_dir_enter: t_on_dir
        g_sink\on_file: t_on_file
        g_sink\on_dir_done: t_on_done
        g_sink\ctx: 0
        g_sink_ready: 1
    ---
return: g_sink

sub: t_reset ()
    g_trace[0]: 0
    g_trace_len: 0U
    g_calls: 0
    g_stop_after: 0
    g_fail_code: 0
    g_first_call_alloc_seq: 0
end: t_reset

fn: t_count (const: @(char needle)) int
    const: @(char p)
    int: n
    n: 0
    p: c.strstr(g_trace, needle)
    while: p != 0
        n: n + 1
        p: c.strstr(p + 1U, needle)
    ---
return: n

fn: t_pos (const: @(char needle)) int
    const: @(char p)
    p: c.strstr(g_trace, needle)
    if: p = 0
        return: -1
return: (cast: (int) (p - g_trace))

sub: t_touch (const: @(char path))
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "wb")
    if: fh[0] != 0
        c.fputs("x", fh[0])
        c.fclose(fh[0])
    ---
end: t_touch

[]: int g_failures 1

sub: t_check_int (const: @(char label); int: got; int: want)
    if: got != want
        c.printf("CHK %s got=%d want=%d FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%d want=%d PASS\n", label, got, want)
end: t_check_int

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char root 1040
    []: char pa 1040
    []: char pb 1040
    []: char pbb 1040
    []: char pc 1040
    []: char pd 1040
    []: char pe 1040
    []: char puni 1040
    []: char missing 1040
    []: char p1 1200
    []: char cmd 2400
    []: char uni 24
    @: MixaSelection sel
    int: rc
    int: k
    int: live_before
    int: sel_before
    int: full_allocs
    c.setbuf((cast: (@: void) c.stdout), 0)

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    else:
        c.snprintf(base, 520U, "build/mixa/claude/selection_walk_parity/tmp")
    ---
    uni[0]: (cast: (char) 0xD1)
    uni[1]: (cast: (char) 0x84)
    uni[2]: 0

    c.snprintf(root, 1040U, "%s\\root", base)
    c.snprintf(pa, 1040U, "%s\\a", root)
    c.snprintf(pb, 1040U, "%s\\b", pa)
    c.snprintf(pbb, 1040U, "%s\\bb", pb)
    c.snprintf(pc, 1040U, "%s\\c", pa)
    c.snprintf(pd, 1040U, "%s\\d", pc)
    c.snprintf(pe, 1040U, "%s\\e", root)
    c.snprintf(puni, 1040U, "%s\\%s", root, uni)
    c.snprintf(missing, 1040U, "%s\\no_such", root)

    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", pa)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", pb)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", pbb)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", pc)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", pd)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", pe)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", puni)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\a1.txt", pa)
    t_touch(p1)
    c.snprintf(p1, 1200U, "%s\\b1.txt", pb)
    t_touch(p1)
    c.snprintf(p1, 1200U, "%s\\bb1.txt", pbb)
    t_touch(p1)
    c.snprintf(p1, 1200U, "%s\\c1.txt", pc)
    t_touch(p1)
    c.snprintf(p1, 1200U, "%s\\d1.txt", pd)
    t_touch(p1)
    c.snprintf(p1, 1200U, "%s\\u1.txt", puni)
    t_touch(p1)
    c.snprintf(p1, 1200U, "%s\\top.txt", root)
    t_touch(p1)

    sel: (cast: (@: MixaSelection) c.calloc(1U, c.sizeof(c.MixaSelection)))
    if: sel = 0
        c.printf("selection walk parity: alloc failed\n")
        return: 1
    ---
    t_check_int("selection init", mixa_selection_init(sel), MIXA_SEL_OK)

    # --- Scenario 1: one selected directory walked whole. ---
    mixa_selection_select(sel, pa)
    t_reset()
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s1 rc", rc, MIXA_SEL_WALK_OK)
    t_check_int("s1 file coverage", (cast: (int) (t_count("F:a1.txt|") = 1 && t_count("F:b1.txt|") = 1 && t_count("F:bb1.txt|") = 1 && t_count("F:c1.txt|") = 1 && t_count("F:d1.txt|") = 1)), 1)
    t_check_int("s1 no outside visit", (cast: (int) (t_count("F:top.txt|") = 0 && t_count("F:u1.txt|") = 0)), 1)
    t_check_int("s1 dir callbacks", (cast: (int) (t_count("D:a|") = 1 && t_count("E:a|") = 1 && t_count("D:b|") = 1 && t_count("E:b|") = 1)), 1)
    t_check_int("s1 a brackets a1.txt", (cast: (int) (t_pos("D:a|") < t_pos("F:a1.txt|") && t_pos("E:a|") > t_pos("F:a1.txt|"))), 1)
    t_check_int("s1 b brackets grandchild", (cast: (int) (t_pos("D:b|") < t_pos("F:bb1.txt|") && t_pos("E:b|") > t_pos("F:bb1.txt|"))), 1)
    t_check_int("s1 bb nested inside b", (cast: (int) (t_pos("D:bb|") > t_pos("D:b|") && t_pos("E:bb|") < t_pos("E:b|"))), 1)

    # --- Scenario 2: one child exception. ---
    mixa_selection_deselect(sel, pc)
    t_reset()
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s2 rc", rc, MIXA_SEL_WALK_OK)
    t_check_int("s2 excluded subtree not visited", (cast: (int) (t_count("D:c|") = 0 && t_count("F:c1.txt|") = 0 && t_count("F:d1.txt|") = 0)), 1)
    t_check_int("s2 unrelated entries survive", (cast: (int) (t_count("F:a1.txt|") = 1 && t_count("F:b1.txt|") = 1)), 1)

    # --- Scenario 3: a lower selection under an exception is its own root. ---
    mixa_selection_select(sel, pd)
    t_check_int("s3 lower selection is root", mixa_selection_walk_is_root(sel, pd), 1)
    t_reset()
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s3 rc", rc, MIXA_SEL_WALK_OK)
    t_check_int("s3 lower selection visited once", (cast: (int) (t_count("F:d1.txt|") = 1 && t_count("D:d|") = 1)), 1)
    t_check_int("s3 sibling still excluded", t_count("F:c1.txt|"), 0)
    t_check_int("s3 outer root intact", t_count("F:a1.txt|"), 1)

    # --- Scenario 4: nested effective roots visited exactly once. ---
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    mixa_selection_select(sel, pb)
    mixa_selection_select(sel, pa)
    t_check_int("s4 nested root filtering", (cast: (int) (mixa_selection_walk_is_root(sel, pa) = 1 && mixa_selection_walk_is_root(sel, pb) = 0)), 1)
    t_reset()
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s4 rc", rc, MIXA_SEL_WALK_OK)
    t_check_int("s4 nested root visited once", (cast: (int) (t_count("F:b1.txt|") = 1 && t_count("D:b|") = 1 && t_count("E:b|") = 1)), 1)
    t_check_int("s4 outer root complete", (cast: (int) (t_count("F:a1.txt|") = 1 && t_count("F:c1.txt|") = 1)), 1)

    # --- Scenario 5: documented child-first consolidation case. ---
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    mixa_selection_select(sel, pb)
    mixa_selection_select(sel, pa)
    mixa_selection_select(sel, pbb)
    mixa_selection_deselect(sel, pa)
    t_check_int("s5 b kept", mixa_selection_query(sel, pb), 1)
    t_reset()
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s5 rc", rc, MIXA_SEL_WALK_OK)
    t_check_int("s5 b/bb coverage", (cast: (int) (t_count("F:b1.txt|") = 1 && t_count("F:bb1.txt|") = 1)), 1)
    t_check_int("s5 deselected ancestor excluded", (cast: (int) (t_count("F:a1.txt|") = 0 && t_count("F:c1.txt|") = 0)), 1)

    # --- Scenario 6: empty directory and a real UTF-8 name. ---
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    mixa_selection_select(sel, pe)
    mixa_selection_select(sel, puni)
    t_reset()
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s6 rc", rc, MIXA_SEL_WALK_OK)
    t_check_int("s6 empty dir entered+completed", (cast: (int) (t_count("D:e|") = 1 && t_count("E:e|") = 1)), 1)
    t_check_int("s6 utf8 content visited", t_count("F:u1.txt|"), 1)
    c.snprintf(p1, 1200U, "D:%s|", uni)
    t_check_int("s6 utf8 dir name reported", t_count(p1), 1)

    # --- Scenario 7: a missing selected root reports the real status. ---
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    mixa_selection_select(sel, missing)
    sel_before: (cast: (int) sel\selected_count)
    t_reset()
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s7 rc ERR_MISSING", rc, MIXA_SEL_WALK_ERR_MISSING)
    t_check_int("s7 selection unchanged", (cast: (int) sel\selected_count), sel_before)

    # --- Scenario 8: cancellation and caller failure. ---
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    mixa_selection_select(sel, pa)
    t_reset()
    g_stop_after: 1
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s8 cancel rc", rc, MIXA_SEL_WALK_CANCELLED)
    t_check_int("s8 cancel exactly one call", g_calls, 1)
    t_reset()
    g_stop_after: 2
    g_fail_code: 4242
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s8 caller error propagated verbatim", rc, 4242)
    t_check_int("s8 caller error exactly two calls", g_calls, 2)

    # --- Scenario 9: laziness. ---
    t_reset()
    g_alloc_seq: 0
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    full_allocs: g_alloc_seq
    t_check_int("s9 full walk rc", rc, MIXA_SEL_WALK_OK)
    t_check_int("s9 full walk nontrivial allocs", (cast: (int) (full_allocs >= 8)), 1)
    t_check_int("s9 first callback before full enumeration", (cast: (int) (g_first_call_alloc_seq < full_allocs)), 1)
    t_reset()
    g_stop_after: 1
    g_alloc_seq: 0
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s9 cancel-at-first cheaper than full", (cast: (int) (g_alloc_seq < full_allocs)), 1)
    t_check_int("s9 subtrees not entered after first cancel", (cast: (int) (t_count("D:b|") = 0 && t_count("D:c|") = 0)), 1)

    # --- Scenario 10: allocation-fault sweep across every owned step. ---
    t_reset()
    sel_before: (cast: (int) sel\selected_count)
    k: 1
    while: k <= 20
        live_before: g_alloc_live
        g_alloc_seq: 0
        g_alloc_fail_at: k
        t_reset()
        rc: mixa_selection_walk(sel, t_sink(), t_table())
        g_alloc_fail_at: 0
        if: g_alloc_seq >= k
            t_check_int("s10 OOM ERR_NOMEM", rc, MIXA_SEL_WALK_ERR_NOMEM)
            t_check_int("s10 OOM no leak", g_alloc_live, live_before)
            t_check_int("s10 OOM selection unchanged", (cast: (int) sel\selected_count), sel_before)
        ---
        k: k + 1
    ---
    t_reset()
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s10 clean after OOM sweep rc", rc, MIXA_SEL_WALK_OK)
    t_check_int("s10 no live allocs after clean walk", g_alloc_live, 0)

    # --- Scenario 11: root-array consolidation during the scan. ---
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    mixa_selection_select(sel, pbb)
    mixa_selection_select(sel, pb)
    mixa_selection_select(sel, pa)
    mixa_selection_select(sel, pe)
    t_check_int("s11 four live selections before scan", (cast: (int) sel\selected_count), 4)
    t_reset()
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s11 rc", rc, MIXA_SEL_WALK_OK)
    t_check_int("s11 unrelated root not skipped", (cast: (int) (t_count("D:e|") = 1 && t_count("E:e|") = 1)), 1)
    t_check_int("s11 nest coverage exact", (cast: (int) (t_count("F:a1.txt|") = 1 && t_count("F:b1.txt|") = 1 && t_count("F:bb1.txt|") = 1)), 1)
    t_check_int("s11 no leak after consolidation walk", g_alloc_live, 0)

    # --- Scenario 12: argument negatives; empty selection walks to nothing. ---
    t_check_int("s12 null selection", mixa_selection_walk(0, t_sink(), t_table()), MIXA_SEL_WALK_ERR_ARG)
    t_check_int("s12 null sink", mixa_selection_walk(sel, 0, t_table()), MIXA_SEL_WALK_ERR_ARG)
    t_check_int("s12 is_root null selection", mixa_selection_walk_is_root(0, pa), 0)
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    t_reset()
    rc: mixa_selection_walk(sel, t_sink(), t_table())
    t_check_int("s12 empty selection rc", rc, MIXA_SEL_WALK_OK)
    t_check_int("s12 empty selection no calls", g_calls, 0)

    mixa_selection_release(sel)
    c.free(sel)

    if: g_failures[0] != 0
        c.printf("mixa selection walk parity harness FAILED checks=%d\n", g_failures[0])
        return: 1
    c.printf("mixa selection walk parity harness ok\n")
return: 0
