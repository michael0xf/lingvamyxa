predef: "mixa_manager/mixa_remove_l2.h.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# Real L1-vs-L2 parity harness for mixa_remove (ticket 20260913-
# 171800). ONE harness source, compiled/linked twice (oracle/L2),
# "declare then link" -- mixa_remove_selected_run's own real body comes
# from either the unchanged mixa_remove.lm1 (oracle side) or the
# generated mixa_remove.lm2 (L2 side). mixa_selection_init/_release/
# _select/_deselect/_query, mixa_selection_walk, mixa_dir_stat are real
# plain-C or already-real-header-declared functions reached via the L2
# header's own predef chain -- no forward declare needed for any of
# them.
#
# Scenario coverage is drawn directly from the existing, already-
# accepted mixa_remove_selftest.lm1 (9 scenarios): a real nested tree
# with strict postorder directory removal and an untouched sibling; an
# explicit exception under a selected root (a REAL ERROR_DIR_NOT_EMPTY
# rmdir failure, root stays selected for retry); nested selected roots
# consolidated and processed exactly once; a REAL read-only-file
# removal fault (sibling still removed, root stays selected, retry
# after clearing the attribute finishes cleanly); a REAL enumeration
# fault via icacls deny (walk-domain status propagated verbatim, root
# stays selected -- best-effort, since icacls deny may be ineffective
# in some CI environments, reported either way); a deterministic
# allocation fault via the walk's own optional MixaSelWalkAllocVTable
# (root stays selected, retry after lifting it finishes); cancellation
# between two independent roots (the already-finished root is
# deselected, the untouched one stays selected); a real Unicode
# (Cyrillic) file name round-tripping through selection and removal;
# argument negatives and an empty-selection no-op.

fn: mixa_remove_selected_run (@: MixaSelection sel; const: @(MixaRemoveSink sink); const: @(MixaSelWalkAllocVTable av)) int

fn: mixa_dir_stat (const: @(char path_utf8); @: MixaDirEntry out) int

int: g_calls
[]: char g_trace 4000
size_t: g_trace_len
int: g_fail_at_call
int: g_fail_status

fn: t_base (const: @(char path)) const: @(char)
    size_t: n
    size_t: i
    size_t: last
    int: found
    n: c.strlen(path)
    last: 0U
    found: 0
    i: 0U
    while: i < n
        if: path[i] = (cast: (char) 92) || path[i] = (cast: (char) 47)
            last: i + 1U
            found: 1
        ---
        i: i + 1U
    ---
    if: found = 0
        return: path
return: path + last

sub: t_record (const: @(char kind); const: @(char path); int: status)
    size_t: room
    if: g_trace_len + 80U >= 4000U
        return
    ---
    room: 4000U - g_trace_len
    c.snprintf(g_trace + g_trace_len, room, "%s:%s:%d|", kind, t_base(path), status)
    g_trace_len: c.strlen(g_trace)
end: t_record

fn: t_note (const: @(char kind); const: @(char path); int: status) int
    g_calls: g_calls + 1
    t_record(kind, path, status)
    if: g_fail_at_call != 0 && g_calls = g_fail_at_call
        return: g_fail_status
return: MIXA_SEL_WALK_GO

fn: cb_file (@: void ctx; const: @(char path); int: is_dir; int: status) int
return: t_note("F", path, status)

fn: cb_dir_done (@: void ctx; const: @(char path); int: is_dir; int: status) int
return: t_note("E", path, status)

@: MixaRemoveSink g_sink
int: g_sink_ready

fn: t_sink () const: @(MixaRemoveSink)
    if: g_sink_ready = 0
        g_sink: (cast: (@: MixaRemoveSink) c.calloc(1U, c.sizeof(c.MixaRemoveSink)))
        g_sink\on_file: cb_file
        g_sink\on_dir_done: cb_dir_done
        g_sink_ready: 1
    ---
return: g_sink

sub: t_reset ()
    g_calls: 0
    g_trace[0]: 0
    g_trace_len: 0U
    g_fail_at_call: 0
    g_fail_status: 0
end: t_reset

fn: t_count (const: @(char needle)) int
    const: @(char p)
    int: n
    n: 0
    p: c.strstr(g_trace, needle)
    while: p != 0
        n: n + 1
        p: c.strstr(p + 1U, needle)
return: n

sub: t_touch (const: @(char path); const: @(char content))
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "wb")
    if: fh[0] != 0
        c.fputs(content, fh[0])
        c.fclose(fh[0])
    ---
end: t_touch

fn: t_exists (const: @(char path)) int
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "rb")
    if: fh[0] = 0
        return: 0
    ---
    c.fclose(fh[0])
return: 1

fn: t_dir_exists (const: @(char path)) int
    @: MixaDirEntry e
    int: st
    e: (cast: (@: MixaDirEntry) c.calloc(1U, c.sizeof(c.MixaDirEntry)))
    if: e = 0
        return: 0
    st: mixa_dir_stat(path, e)
    c.free(e)
    if: st = MIXA_DIR_OK
        return: 1
return: 0

int: g_alloc_calls
int: g_alloc_fail_at

fn: t_alloc (size_t: n) @: void
    g_alloc_calls: g_alloc_calls + 1
    if: g_alloc_fail_at >= 0
        if: g_alloc_calls > g_alloc_fail_at
            return: 0
        ---
    ---
return: c.malloc(n)

sub: t_free (@: void p)
    c.free(p)
end: t_free

@: MixaSelWalkAllocVTable g_av
int: g_av_ready

fn: t_av () const: @(MixaSelWalkAllocVTable)
    if: g_av_ready = 0
        g_av: (cast: (@: MixaSelWalkAllocVTable) c.calloc(1U, c.sizeof(c.MixaSelWalkAllocVTable)))
        g_av\alloc: t_alloc
        g_av\free: t_free
        g_av_ready: 1
    ---
return: g_av

[]: int g_failures 1

sub: t_check_int (const: @(char label); int: got; int: want)
    if: got != want
        c.printf("CHK %s got=%d want=%d FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%d want=%d PASS\n", label, got, want)
end: t_check_int

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char root1 1040
    []: char suba 1040
    []: char subb 1040
    []: char subb_nested 1040
    []: char sibling 1040
    []: char root2 1040
    []: char keepme 1040
    []: char root3 1040
    []: char root3sub 1040
    []: char root4 1040
    []: char root4_ro 1040
    []: char root4_ok 1040
    []: char root5 1040
    []: char root5_locked 1040
    []: char rootc1 1040
    []: char rootc2 1040
    []: char p1 1200
    []: char cmd 2400
    @: MixaSelection sel
    const: @(MixaRemoveSink sink)
    int: rc
    int: a_gone
    int: b_gone
    c.setbuf((cast: (@: void) c.stdout), 0)

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    else:
        c.snprintf(base, 520U, "build/mixa/claude/remove_parity/tmp")
    ---

    sel: (cast: (@: MixaSelection) c.calloc(1U, c.sizeof(c.MixaSelection)))
    if: sel = 0
        c.printf("remove parity: alloc failed\n")
        return: 1
    ---
    t_check_int("selection init", mixa_selection_init(sel), MIXA_SEL_OK)
    sink: t_sink()

    # --- Scenario 1: real nested tree, postorder proof. ---
    c.snprintf(root1, 1040U, "%s\\root1", base)
    c.snprintf(suba, 1040U, "%s\\a", root1)
    c.snprintf(subb, 1040U, "%s\\b", root1)
    c.snprintf(subb_nested, 1040U, "%s\\nested", subb)
    c.snprintf(sibling, 1040U, "%s\\sibling.txt", base)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", suba)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", subb_nested)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\a1.txt", suba)
    t_touch(p1, "a1")
    c.snprintf(p1, 1200U, "%s\\a2.txt", suba)
    t_touch(p1, "a2")
    c.snprintf(p1, 1200U, "%s\\deep.txt", subb_nested)
    t_touch(p1, "deep")
    t_touch(sibling, "sibling-content")

    mixa_selection_select(sel, root1)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    t_check_int("s1 rc", rc, MIXA_REMOVE_OK)
    t_check_int("s1 root1 gone", t_dir_exists(root1), 0)
    t_check_int("s1 sibling survives", t_exists(sibling), 1)
    if: 1
        const: @(char p_nested)
        const: @(char p_b)
        const: @(char p_root1)
        p_nested: c.strstr(g_trace, "E:nested:0|")
        p_b: c.strstr(g_trace, "E:b:0|")
        p_root1: c.strstr(g_trace, "E:root1:0|")
        t_check_int("s1 postorder", (cast: (int) (p_nested != 0 && p_b != 0 && p_root1 != 0 && p_nested < p_b && p_b < p_root1)), 1)
    ---
    t_check_int("s1 root1 deselected", mixa_selection_query(sel, root1), 0)

    # --- Scenario 2: explicit exception survives; root's own rmdir fails
    # with a real ERROR_DIR_NOT_EMPTY; root stays selected for retry. ---
    c.snprintf(root2, 1040U, "%s\\root2", base)
    c.snprintf(keepme, 1040U, "%s\\keepme", root2)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", keepme)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\onlykeep.txt", keepme)
    t_touch(p1, "keep-content")
    c.snprintf(p1, 1200U, "%s\\deleteme.txt", root2)
    t_touch(p1, "delete-content")
    mixa_selection_select(sel, root2)
    mixa_selection_deselect(sel, keepme)
    t_check_int("s2 keepme not selected pre-run", mixa_selection_query(sel, keepme), 0)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    t_check_int("s2 rc", rc, MIXA_REMOVE_OK)
    c.snprintf(p1, 1200U, "%s\\onlykeep.txt", keepme)
    t_check_int("s2 excepted file survives", t_exists(p1), 1)
    t_check_int("s2 excepted dir survives", t_dir_exists(keepme), 1)
    c.snprintf(p1, 1200U, "%s\\deleteme.txt", root2)
    t_check_int("s2 deleteme.txt gone", t_exists(p1), 0)
    t_check_int("s2 root2 survives (not empty)", t_dir_exists(root2), 1)
    t_check_int("s2 root2 real IO failure reported once", t_count("E:root2:203|"), 1)
    t_check_int("s2 root2 stays selected", mixa_selection_query(sel, root2), 1)
    mixa_selection_deselect(sel, root2)
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul", root2)
    c.system(cmd)

    # --- Scenario 3: nested selected roots consolidated, processed once. ---
    c.snprintf(root3, 1040U, "%s\\root3", base)
    c.snprintf(root3sub, 1040U, "%s\\sub", root3)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root3sub)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\x.txt", root3sub)
    t_touch(p1, "x")
    mixa_selection_select(sel, root3)
    mixa_selection_select(sel, root3sub)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    t_check_int("s3 rc", rc, MIXA_REMOVE_OK)
    t_check_int("s3 root3 gone", t_dir_exists(root3), 0)
    t_check_int("s3 root3 deselected", (cast: (int) (mixa_selection_query(sel, root3) != 0 || mixa_selection_query(sel, root3sub) != 0)), 0)
    t_check_int("s3 root3 visited once", t_count("E:root3:0|"), 1)

    # --- Scenario 4: a REAL read-only file removal fault. ---
    c.snprintf(root4, 1040U, "%s\\root4", base)
    c.snprintf(root4_ro, 1040U, "%s\\locked.txt", root4)
    c.snprintf(root4_ok, 1040U, "%s\\ok.txt", root4)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root4)
    c.system(cmd)
    t_touch(root4_ro, "locked-content")
    t_touch(root4_ok, "ok-content")
    c.snprintf(cmd, 2400U, "cmd /c attrib +r \"%s\"", root4_ro)
    c.system(cmd)
    mixa_selection_select(sel, root4)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    t_check_int("s4 rc", rc, MIXA_REMOVE_OK)
    t_check_int("s4 locked.txt reported once", t_count("F:locked.txt:203|"), 1)
    t_check_int("s4 sibling ok.txt gone", t_exists(root4_ok), 0)
    t_check_int("s4 locked.txt survives", t_exists(root4_ro), 1)
    t_check_int("s4 root4 stays selected", mixa_selection_query(sel, root4), 1)
    c.snprintf(cmd, 2400U, "cmd /c attrib -r \"%s\"", root4_ro)
    c.system(cmd)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    t_check_int("s4 retry rc", rc, MIXA_REMOVE_OK)
    t_check_int("s4 retry root4 gone", t_dir_exists(root4), 0)
    t_check_int("s4 retry root4 deselected", mixa_selection_query(sel, root4), 0)

    # --- Scenario 5: a REAL enumeration fault (icacls deny). Best-effort:
    # the deny may be ineffective in some CI environments, so this is
    # reported either way, not hard-failed on the negative branch. ---
    c.snprintf(root5, 1040U, "%s\\root5", base)
    c.snprintf(root5_locked, 1040U, "%s\\locked", root5)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root5_locked)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\inside.txt", root5_locked)
    t_touch(p1, "inside")
    c.snprintf(cmd, 2400U, "cmd /c icacls \"%s\" /deny \"%%USERNAME%%\":(RD,REA) >nul 2>nul", root5_locked)
    c.system(cmd)
    mixa_selection_select(sel, root5)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    c.printf("CHK s5 enumeration-fault rc=%d (icacls deny may be ineffective in this environment) INFO\n", rc)
    if: rc = MIXA_SEL_WALK_ERR_ACCESS
        t_check_int("s5 root5 stays selected", mixa_selection_query(sel, root5), 1)
    ---
    c.snprintf(cmd, 2400U, "cmd /c icacls \"%s\" /reset >nul 2>nul", root5_locked)
    c.system(cmd)
    mixa_selection_deselect(sel, root5)
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul", root5)
    c.system(cmd)

    # --- Scenario 6: a deterministic allocation fault via the walk's own
    # optional MixaSelWalkAllocVTable. ---
    c.snprintf(rootc1, 1040U, "%s\\rootc1", base)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", rootc1)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\y.txt", rootc1)
    t_touch(p1, "y")
    mixa_selection_select(sel, rootc1)
    t_reset()
    g_alloc_calls: 0
    g_alloc_fail_at: 0
    rc: mixa_remove_selected_run(sel, sink, t_av())
    t_check_int("s6 alloc-fault rc", rc, MIXA_SEL_WALK_ERR_NOMEM)
    t_check_int("s6 rootc1 stays selected", mixa_selection_query(sel, rootc1), 1)
    t_check_int("s6 rootc1 survives", t_dir_exists(rootc1), 1)
    g_alloc_fail_at: -1
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, t_av())
    t_check_int("s6 retry rc", rc, MIXA_REMOVE_OK)
    t_check_int("s6 retry rootc1 gone", t_dir_exists(rootc1), 0)

    # --- Scenario 7: cancellation between two independent roots. ---
    c.snprintf(rootc1, 1040U, "%s\\cancelA", base)
    c.snprintf(rootc2, 1040U, "%s\\cancelB", base)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", rootc1)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", rootc2)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\z1.txt", rootc1)
    t_touch(p1, "z1")
    c.snprintf(p1, 1200U, "%s\\z2.txt", rootc2)
    t_touch(p1, "z2")
    mixa_selection_select(sel, rootc1)
    mixa_selection_select(sel, rootc2)
    t_reset()
    g_fail_at_call: 2
    g_fail_status: MIXA_SEL_WALK_STOP
    rc: mixa_remove_selected_run(sel, sink, 0)
    t_check_int("s7 rc", rc, MIXA_REMOVE_CANCELLED)
    a_gone: 0
    if: t_dir_exists(rootc1) = 0
        a_gone: 1
    ---
    b_gone: 0
    if: t_dir_exists(rootc2) = 0
        b_gone: 1
    ---
    t_check_int("s7 exactly one root finished", a_gone + b_gone, 1)
    if: a_gone != 0
        t_check_int("s7 finished root A deselected", mixa_selection_query(sel, rootc1), 0)
        t_check_int("s7 untouched root B stays selected", mixa_selection_query(sel, rootc2), 1)
    else:
        t_check_int("s7 finished root B deselected", mixa_selection_query(sel, rootc2), 0)
        t_check_int("s7 untouched root A stays selected", mixa_selection_query(sel, rootc1), 1)
    ---
    mixa_selection_deselect(sel, rootc1)
    mixa_selection_deselect(sel, rootc2)
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul", rootc1)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul", rootc2)
    c.system(cmd)

    # --- Scenario 8: a real Unicode (Cyrillic) file name. ---
    c.snprintf(root1, 1040U, "%s\\root_uni", base)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root1)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\\xd0\xbf\xd1\x80\xd0\xb8\xd0\xb2\xd0\xb5\xd1\x82.txt", root1)
    t_touch(p1, "unicode-content")
    mixa_selection_select(sel, root1)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    t_check_int("s8 rc", rc, MIXA_REMOVE_OK)
    t_check_int("s8 unicode-named removed", t_dir_exists(root1), 0)

    # --- Scenario 9: argument negatives; empty selection no-op. ---
    t_check_int("s9 null selection", mixa_remove_selected_run(0, sink, 0), MIXA_REMOVE_ERR_ARG)
    t_check_int("s9 null sink", mixa_remove_selected_run(sel, 0, 0), MIXA_REMOVE_ERR_ARG)
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    t_check_int("s9 empty selection rc", rc, MIXA_REMOVE_OK)
    t_check_int("s9 empty selection no calls", g_calls, 0)

    mixa_selection_release(sel)
    c.free(sel)

    if: g_failures[0] != 0
        c.printf("mixa remove parity harness FAILED checks=%d\n", g_failures[0])
        return: 1
    c.printf("mixa remove parity harness ok\n")
return: 0
