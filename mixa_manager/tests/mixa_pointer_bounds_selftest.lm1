    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    p\row: 7U
    p\col: 9U
    p\octant: MIXA_POINTER_UP_LEFT
    mixa_pointer_release(p)
    expect_oct(p\is_open, 0, "release-1 open", @ failures, @ checks)
    expect_oct(p\octant, MIXA_POINTER_DOWN_RIGHT, "release-1 octant", @ failures, @ checks)
    expect_pos(p\row, 0U, "release-1 row", @ failures, @ checks)
    expect_pos(p\col, 0U, "release-1 col", @ failures, @ checks)
    
    # Case 2: Nudge on released pointer must ERR, all 4 fields remain unchanged
    snap_oct_mt: p\octant
    snap_open_mt: p\is_open
    snap_row_mt: p\row
    snap_col_mt: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) 1))
    if: rc != MIXA_POINTER_ERR
        c.printf("mixa_pointer_bounds: nudge-released should fail\n")
        failures: failures + 1
    expect_oct(p\octant, snap_oct_mt, "release-nudge octant", @ failures, @ checks)
    expect_oct(p\is_open, snap_open_mt, "release-nudge open", @ failures, @ checks)
    expect_pos(p\row, snap_row_mt, "release-nudge row", @ failures, @ checks)
    expect_pos(p\col, snap_col_mt, "release-nudge col", @ failures, @ checks)
    
    # Case 3: move_to on released pointer must ERR, all 4 fields unchanged (same snapshot)
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 1U, 1U)
    if: rc != MIXA_POINTER_ERR
        c.printf("mixa_pointer_bounds: move_to-released should fail\n")
        failures: failures + 1
    expect_oct(p\octant, snap_oct_mt, "release-move octant", @ failures, @ checks)
    expect_oct(p\is_open, snap_open_mt, "release-move open", @ failures, @ checks)
    expect_pos(p\row, snap_row_mt, "release-move row", @ failures, @ checks)
    expect_pos(p\col, snap_col_mt, "release-move col", @ failures, @ checks)
    
    # Case 4: Release again (idempotent)
    mixa_pointer_release(p)
    expect_oct(p\octant, snap_oct_mt, "release-2 octant", @ failures, @ checks)
    expect_oct(p\is_open, snap_open_mt, "release-2 open", @ failures, @ checks)
    expect_pos(p\row, snap_row_mt, "release-2 row", @ failures, @ checks)
    expect_pos(p\col, snap_col_mt, "release-2 col", @ failures, @ checks)
    
    # Case 5: NULL pointer operations
    # init(NULL) must ERR
    assertions: assertions + 1
    rc: mixa_pointer_init(null_p)
    if: rc != MIXA_POINTER_ERR
        c.printf("mixa_pointer_bounds: init-null should fail\n")
        failures: failures + 1
    # nudge(NULL) must ERR
    assertions: assertions + 1
    rc: mixa_pointer_nudge(null_p, (cast: (i32) 1), (cast: (i32) 1))
    if: rc != MIXA_POINTER_ERR
        c.printf("mixa_pointer_bounds: nudge-null should fail\n")
        failures: failures + 1
    # move_to(NULL) must ERR
    assertions: assertions + 1
    rc: mixa_pointer_move_to(null_p, 1U, 1U)
    if: rc != MIXA_POINTER_ERR
        c.printf("mixa_pointer_bounds: move_to-null should fail\n")
        failures: failures + 1
    # release(NULL) is safe no-op (void, no assertion)
    mixa_pointer_release(null_p)
    
    mixa_pointer_release(p)
    c.free(p)
    
    if: failures = 0
        c.printf("mixa_pointer_bounds_selftest: scenarios=8 member_checks=%d api_assertions=%d failures=0\n", checks, assertions)
        c.printf("mixa_pointer_bounds_selftest OK\n")
        return: 0
    c.printf("mixa_pointer_bounds_selftest FAILED: %d check(s)\n", failures)
    return: 1
