predef: "mixa_manager/mixa_pointer.lm1"
include: "<stdio.h>" "<stdlib.h>"

# Pointer bounds: comprehensive coverage
# 8 scenarios covering:
# - Basic 8-direction nudges and zero-delta preservation
# - Underflow rejection at boundaries (0,0)
# - Successful boundary operations (one step from underflow)
# - SIZE_MAX boundary conditions
# - INT32 extremes (INT32_MIN, INT32_MAX)
# - move_to displacement limits (±2147483647)
# - Released/closed and NULL pointer behavior
# Note: dx changes COL, dy changes ROW; move_to uses row,col directly

fn: expect_oct (int: got; int: want; const: @(char label); @: int failures; @: int checks) int
    checks[0]: checks[0] + 1
    if: got != want
        c.printf("mixa_pointer_bounds: %s got=%d want=%d\n", label, got, want)
        failures[0]: failures[0] + 1
        return: 1
return: 0

fn: expect_pos (size_t: got; size_t: want; const: @(char label); @: int failures; @: int checks) int
    checks[0]: checks[0] + 1
    if: got != want
        c.printf("mixa_pointer_bounds: %s got=%zu want=%zu\n", label, got, want)
        failures[0]: failures[0] + 1
        return: 1
return: 0

fn: main () int
    @: MixaPointer p
    int: failures
    int: checks
    int: assertions
    int: rc
    
    failures: 0
    checks: 0
    assertions: 0
    
    p: (cast: (@: MixaPointer) c.calloc(1U, c.sizeof(c.MixaPointer)))
    if: p = 0
        c.printf("mixa_pointer_bounds: alloc failed\n")
        return: 1
    if: mixa_pointer_init(p) != MIXA_POINTER_OK
        c.printf("mixa_pointer_bounds: init failed\n")
        return: 1
    
    # Scenario 1: Eight successful nudge directions from safe position (100,100)
    # Expected results: dx changes COL, dy changes ROW
    
    # Direction UP (dy=-1, dx=0): pos (99,100), octant UP(0)
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        c.printf("mixa_pointer_bounds: move_to(100,100) failed rc=%d\n", rc)
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) -1))
    if: rc != MIXA_POINTER_OK
        c.printf("mixa_pointer_bounds: UP nudge failed rc=%d\n", rc)
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_UP, "UP octant", @ failures, @ checks)
    expect_pos(p\row, 99U, "UP row", @ failures, @ checks)
    expect_pos(p\col, 100U, "UP col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "UP is_open", @ failures, @ checks)
    
    # Direction UP_RIGHT (dy=-1, dx=1): pos (99,101), octant UP_RIGHT(1)
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) -1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_UP_RIGHT, "UP_RIGHT octant", @ failures, @ checks)
    expect_pos(p\row, 99U, "UP_RIGHT row", @ failures, @ checks)
    expect_pos(p\col, 101U, "UP_RIGHT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "UP_RIGHT is_open", @ failures, @ checks)
    
    # Direction RIGHT (dx=1, dy=0): pos (100,101), octant RIGHT(2)
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_RIGHT, "RIGHT octant", @ failures, @ checks)
    expect_pos(p\row, 100U, "RIGHT row", @ failures, @ checks)
    expect_pos(p\col, 101U, "RIGHT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "RIGHT is_open", @ failures, @ checks)
    
    # Direction DOWN_RIGHT (dx=1, dy=1): pos (101,101), octant DOWN_RIGHT(3)
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) 1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_DOWN_RIGHT, "DOWN_RIGHT octant", @ failures, @ checks)
    expect_pos(p\row, 101U, "DOWN_RIGHT row", @ failures, @ checks)
    expect_pos(p\col, 101U, "DOWN_RIGHT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "DOWN_RIGHT is_open", @ failures, @ checks)
    
    # Direction DOWN (dy=1, dx=0): pos (101,100), octant DOWN(4)
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_DOWN, "DOWN octant", @ failures, @ checks)
    expect_pos(p\row, 101U, "DOWN row", @ failures, @ checks)
    expect_pos(p\col, 100U, "DOWN col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "DOWN is_open", @ failures, @ checks)
    
    # Direction DOWN_LEFT (dx=-1, dy=1): pos (101,99), octant DOWN_LEFT(5)
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) 1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_DOWN_LEFT, "DOWN_LEFT octant", @ failures, @ checks)
    expect_pos(p\row, 101U, "DOWN_LEFT row", @ failures, @ checks)
    expect_pos(p\col, 99U, "DOWN_LEFT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "DOWN_LEFT is_open", @ failures, @ checks)
    
    # Direction LEFT (dx=-1, dy=0): pos (100,99), octant LEFT(6)
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_LEFT, "LEFT octant", @ failures, @ checks)
    expect_pos(p\row, 100U, "LEFT row", @ failures, @ checks)
    expect_pos(p\col, 99U, "LEFT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "LEFT is_open", @ failures, @ checks)
    
    # Direction UP_LEFT (dx=-1, dy=-1): pos (99,99), octant UP_LEFT(7)
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) -1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_UP_LEFT, "UP_LEFT octant", @ failures, @ checks)
    expect_pos(p\row, 99U, "UP_LEFT row", @ failures, @ checks)
    expect_pos(p\col, 99U, "UP_LEFT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "UP_LEFT is_open", @ failures, @ checks)
    
    # Scenario 2: Zero-delta preserves all 4 fields for each direction
    
    # Zero-delta in UP octant
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) -1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    int: snap_oct
    size_t: snap_row
    size_t: snap_col
    snap_oct: p\octant
    snap_row: p\row
    snap_col: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, snap_oct, "zero-delta UP octant", @ failures, @ checks)
    expect_pos(p\row, snap_row, "zero-delta UP row", @ failures, @ checks)
    expect_pos(p\col, snap_col, "zero-delta UP col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "zero-delta UP open", @ failures, @ checks)
    
    # Zero-delta in UP_RIGHT
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) -1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    snap_oct: p\octant
    snap_row: p\row
    snap_col: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, snap_oct, "zero-delta UP_RIGHT octant", @ failures, @ checks)
    expect_pos(p\row, snap_row, "zero-delta UP_RIGHT row", @ failures, @ checks)
    expect_pos(p\col, snap_col, "zero-delta UP_RIGHT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "zero-delta UP_RIGHT open", @ failures, @ checks)
    
    # Zero-delta in RIGHT
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    snap_oct: p\octant
    snap_row: p\row
    snap_col: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, snap_oct, "zero-delta RIGHT octant", @ failures, @ checks)
    expect_pos(p\row, snap_row, "zero-delta RIGHT row", @ failures, @ checks)
    expect_pos(p\col, snap_col, "zero-delta RIGHT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "zero-delta RIGHT open", @ failures, @ checks)
    
    # Zero-delta in DOWN_RIGHT
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) 1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    snap_oct: p\octant
    snap_row: p\row
    snap_col: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, snap_oct, "zero-delta DOWN_RIGHT octant", @ failures, @ checks)
    expect_pos(p\row, snap_row, "zero-delta DOWN_RIGHT row", @ failures, @ checks)
    expect_pos(p\col, snap_col, "zero-delta DOWN_RIGHT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "zero-delta DOWN_RIGHT open", @ failures, @ checks)
    
    # Zero-delta in DOWN
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    snap_oct: p\octant
    snap_row: p\row
    snap_col: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, snap_oct, "zero-delta DOWN octant", @ failures, @ checks)
    expect_pos(p\row, snap_row, "zero-delta DOWN row", @ failures, @ checks)
    expect_pos(p\col, snap_col, "zero-delta DOWN col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "zero-delta DOWN open", @ failures, @ checks)
    
    # Zero-delta in DOWN_LEFT
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) 1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    snap_oct: p\octant
    snap_row: p\row
    snap_col: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, snap_oct, "zero-delta DOWN_LEFT octant", @ failures, @ checks)
    expect_pos(p\row, snap_row, "zero-delta DOWN_LEFT row", @ failures, @ checks)
    expect_pos(p\col, snap_col, "zero-delta DOWN_LEFT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "zero-delta DOWN_LEFT open", @ failures, @ checks)
    
    # Zero-delta in LEFT
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    snap_oct: p\octant
    snap_row: p\row
    snap_col: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, snap_oct, "zero-delta LEFT octant", @ failures, @ checks)
    expect_pos(p\row, snap_row, "zero-delta LEFT row", @ failures, @ checks)
    expect_pos(p\col, snap_col, "zero-delta LEFT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "zero-delta LEFT open", @ failures, @ checks)
    
    # Zero-delta in UP_LEFT
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 100U, 100U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) -1))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    snap_oct: p\octant
    snap_row: p\row
    snap_col: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    expect_oct(p\octant, snap_oct, "zero-delta UP_LEFT octant", @ failures, @ checks)
    expect_pos(p\row, snap_row, "zero-delta UP_LEFT row", @ failures, @ checks)
    expect_pos(p\col, snap_col, "zero-delta UP_LEFT col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "zero-delta UP_LEFT open", @ failures, @ checks)
    
    # Scenario 3: Zero/one underflow boundary - ERR cases (all 4 fields unchanged)
    # Case 1: start(0,0), delta(-1,0) - col underflows (dx=-1 affects COL)
    assertions: assertions + 1
    rc: mixa_pointer_init(p)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    int: snap_oct_uf
    int: snap_open_uf
    size_t: snap_row_uf
    size_t: snap_col_uf
    snap_oct_uf: p\octant
    snap_open_uf: p\is_open
    snap_row_uf: p\row
    snap_col_uf: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) 0))
    if: rc != MIXA_POINTER_ERR
        c.printf("mixa_pointer_bounds: underflow-col should fail\n")
        failures: failures + 1
    expect_oct(p\octant, snap_oct_uf, "underflow-col octant", @ failures, @ checks)
    expect_oct(p\is_open, snap_open_uf, "underflow-col open", @ failures, @ checks)
    expect_pos(p\row, snap_row_uf, "underflow-col row", @ failures, @ checks)
    expect_pos(p\col, snap_col_uf, "underflow-col col", @ failures, @ checks)
    
    # Case 2: start(0,0), delta(0,-1) - row underflows (dx=0, dy=-1 affects ROW)
    assertions: assertions + 1
    rc: mixa_pointer_init(p)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    snap_oct_uf: p\octant
    snap_open_uf: p\is_open
    snap_row_uf: p\row
    snap_col_uf: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) -1))
    if: rc != MIXA_POINTER_ERR
        c.printf("mixa_pointer_bounds: underflow-row2 should fail\n")
        failures: failures + 1
    expect_oct(p\octant, snap_oct_uf, "underflow-row2 octant", @ failures, @ checks)
    expect_oct(p\is_open, snap_open_uf, "underflow-row2 open", @ failures, @ checks)
    expect_pos(p\row, snap_row_uf, "underflow-row2 row", @ failures, @ checks)
    expect_pos(p\col, snap_col_uf, "underflow-row2 col", @ failures, @ checks)
    
    # Case 3: start(0,1), delta(1,-1) - row underflows (dx=1 valid, dy=-1 affects ROW)
    assertions: assertions + 1
    rc: mixa_pointer_init(p)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 0U, 1U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    snap_oct_uf: p\octant
    snap_open_uf: p\is_open
    snap_row_uf: p\row
    snap_col_uf: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) -1))
    if: rc != MIXA_POINTER_ERR
        c.printf("mixa_pointer_bounds: underflow-row3 should fail\n")
        failures: failures + 1
    expect_oct(p\octant, snap_oct_uf, "underflow-row3 octant", @ failures, @ checks)
    expect_oct(p\is_open, snap_open_uf, "underflow-row3 open", @ failures, @ checks)
    expect_pos(p\row, snap_row_uf, "underflow-row3 row", @ failures, @ checks)
    expect_pos(p\col, snap_col_uf, "underflow-row3 col", @ failures, @ checks)
    
    # Case 4: start(1,0), delta(-1,1) - col underflows (dy=1 valid, dx=-1 affects COL)
    assertions: assertions + 1
    rc: mixa_pointer_init(p)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 1U, 0U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    snap_oct_uf: p\octant
    snap_open_uf: p\is_open
    snap_row_uf: p\row
    snap_col_uf: p\col
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) 1))
    if: rc != MIXA_POINTER_ERR
        c.printf("mixa_pointer_bounds: underflow-col2 should fail\n")
        failures: failures + 1
    expect_oct(p\octant, snap_oct_uf, "underflow-col2 octant", @ failures, @ checks)
    expect_oct(p\is_open, snap_open_uf, "underflow-col2 open", @ failures, @ checks)
    expect_pos(p\row, snap_row_uf, "underflow-col2 row", @ failures, @ checks)
    expect_pos(p\col, snap_col_uf, "underflow-col2 col", @ failures, @ checks)
    
    # Scenario 4: Successful boundary cases (one step from underflow)
    # Case 1: start(1,1), delta(-1,0) -> (1,0), octant LEFT
    assertions: assertions + 1
    rc: mixa_pointer_init(p)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 1U, 1U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) 0))
    if: rc != MIXA_POINTER_OK
        c.printf("mixa_pointer_bounds: boundary-left should succeed\n")
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_LEFT, "boundary-left octant", @ failures, @ checks)
    expect_pos(p\row, 1U, "boundary-left row", @ failures, @ checks)
    expect_pos(p\col, 0U, "boundary-left col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "boundary-left open", @ failures, @ checks)
    
    # Case 2: start(1,1), delta(0,-1) -> (0,1), octant UP
    assertions: assertions + 1
    rc: mixa_pointer_init(p)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 1U, 1U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) -1))
    if: rc != MIXA_POINTER_OK
        c.printf("mixa_pointer_bounds: boundary-up should succeed\n")
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_UP, "boundary-up octant", @ failures, @ checks)
    expect_pos(p\row, 0U, "boundary-up row", @ failures, @ checks)
    expect_pos(p\col, 1U, "boundary-up col", @ failures, @ checks)
    expect_oct(p\is_open, 1, "boundary-up open", @ failures, @ checks)
    
    # Case 3: start(1,1), delta(-1,-1) -> (0,0), octant UP_LEFT
    assertions: assertions + 1
    rc: mixa_pointer_init(p)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_move_to(p, 1U, 1U)
    if: rc != MIXA_POINTER_OK
        failures: failures + 1
    assertions: assertions + 1
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) -1))
    if: rc != MIXA_POINTER_OK
        c.printf("mixa_pointer_bounds: boundary-ul should succeed\n")
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_UP_LEFT, "boundary-ul octant", @ failures, @ checks)
