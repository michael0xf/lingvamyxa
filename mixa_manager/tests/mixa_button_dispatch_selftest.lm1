predef: "mixa_manager/mixa_button_dispatch.h.lm1"
predef: "mixa_manager/mixa_button_dispatch.lm1"
include: "<stdio.h>" "<string.h>"

# Button-hit dispatch selftest (ticket 20260912-045346's "button/nested-
# failure UI" next step). Real button panel hit-test + the real nested
# "нет функции" window (mixa_app_window_open/_hit); no mocks. Covers: a
# wired action being called instead of the fallback, an unwired button
# opening the real fallback window (content + dismiss both verified), a
# miss (gap/outside) doing neither, and a null action table not crashing.

int: g_action_calls
@: void g_last_ctx

fn: test_send_action (@: void ctx) int
    g_action_calls: g_action_calls + 1
    g_last_ctx: ctx
return: 42

fn: main () int
    MixaAppWindowStack: stack_storage
    @: MixaTextRect rect
    @: MixaAppWindowStack stack
    @: MixaButtonPanel panel
    @: MixaAppWindow top
    @: MixaButtonAction actions
    []: char msg 22
    c.array: []: unsigned exp_msg 11
    size_t: r
    size_t: c
    int: rc
    int: action_result
    int: failures
    int: checks
    const: @(MixaCell cq)
    int: sentinel_ctx

    failures: 0
    checks: 0
    sentinel_ctx: 7

    rect: (cast: (@: MixaTextRect) c.calloc(1U, c.sizeof(c.MixaTextRect)))
    panel: (cast: (@: MixaButtonPanel) c.calloc(1U, c.sizeof(c.MixaButtonPanel)))
    actions: (cast: (@: MixaButtonAction) c.calloc(1U, c.sizeof(c.MixaButtonAction)))
    stack: @ stack_storage
    if: rect = 0 || panel = 0 || actions = 0
        c.printf("button dispatch: alloc failed\n")
        return: 1
    ---

    # "нет функции" as UTF-8 (NUL-terminated) -- same bytes as
    # mixa_app_window_selftest.lm1's own fixture, reused verbatim so a
    # transcription slip here can't silently diverge from the already-
    # proven-correct message.
    msg[0]: (cast: (char 0xD0))
    msg[1]: (cast: (char 0xBD))
    msg[2]: (cast: (char 0xD0))
    msg[3]: (cast: (char 0xB5))
    msg[4]: (cast: (char 0xD1))
    msg[5]: (cast: (char 0x82))
    msg[6]: (cast: (char 0x20))
    msg[7]: (cast: (char 0xD1))
    msg[8]: (cast: (char 0x84))
    msg[9]: (cast: (char 0xD1))
    msg[10]: (cast: (char 0x83))
    msg[11]: (cast: (char 0xD0))
    msg[12]: (cast: (char 0xBD))
    msg[13]: (cast: (char 0xD0))
    msg[14]: (cast: (char 0xBA))
    msg[15]: (cast: (char 0xD1))
    msg[16]: (cast: (char 0x86))
    msg[17]: (cast: (char 0xD0))
    msg[18]: (cast: (char 0xB8))
    msg[19]: (cast: (char 0xD0))
    msg[20]: (cast: (char 0xB8))
    msg[21]: (cast: (char 0x00))

    exp_msg[0]: 0x043DU
    exp_msg[1]: 0x0435U
    exp_msg[2]: 0x0442U
    exp_msg[3]: 0x0020U
    exp_msg[4]: 0x0444U
    exp_msg[5]: 0x0443U
    exp_msg[6]: 0x043DU
    exp_msg[7]: 0x043AU
    exp_msg[8]: 0x0446U
    exp_msg[9]: 0x0438U
    exp_msg[10]: 0x0438U

    checks: checks + 1
    if: mixa_rect_open(rect, 20U, 40U) != 0
        failures: failures + 1
        c.printf("button dispatch: rect open failed\n")
    ---
    checks: checks + 1
    if: mixa_app_window_stack_init(stack) != MIXA_APP_WINDOW_OK
        failures: failures + 1
        c.printf("button dispatch: stack init failed\n")
    ---

    # Main (outer) toolbar: two square hb=4 buttons, "Send" (idx0, wired)
    # and "Foo" (idx1, deliberately unwired). Same layout math as
    # mixa_buttons_selftest.lm1: margin=hb>>5=0, so with both labels short
    # enough to stay square, Foo starts immediately at col hb=4.
    if: mixa_button_panel_init(panel, 4U) != MIXA_BUTTONS_OK
        c.printf("button dispatch: panel init failed\n")
        return: 1
    ---
    if: mixa_button_panel_add(panel, 0U, "Send", 15U, 10U, 96U) != MIXA_BUTTONS_OK
        c.printf("button dispatch: add Send failed\n")
        return: 1
    ---
    if: mixa_button_panel_add(panel, 0U, "Foo", 15U, 10U, 96U) != MIXA_BUTTONS_OK
        c.printf("button dispatch: add Foo failed\n")
        return: 1
    ---
    if: mixa_button_panel_layout(panel) != MIXA_BUTTONS_OK
        c.printf("button dispatch: layout failed\n")
        return: 1
    ---
    panel\origin_row: 10U
    panel\origin_col: 0U
    panel\view_w: panel\panel_w
    panel\scroll_x: 0U

    actions\btn_idx: 0
    actions\fn: test_send_action
    actions\ctx: (cast: (@: void) @ sentinel_ctx)

    # --- Scenario A: hit "Send" (wired) -- action runs, no fallback window ---
    action_result: -1
    rc: mixa_button_dispatch_hit(panel, 10U, 0U, actions, 1U, stack, rect, 0U, 0U, 6U, 24U, 3U, msg, @ action_result)
    checks: checks + 1
    if: rc != MIXA_DISPATCH_HANDLED
        failures: failures + 1
        c.printf("button dispatch: scenarioA rc=%d\n", rc)
    ---
    checks: checks + 1
    if: g_action_calls != 1 || action_result != 42
        failures: failures + 1
        c.printf("button dispatch: scenarioA calls=%d result=%d\n", g_action_calls, action_result)
    ---
    checks: checks + 1
    if: g_last_ctx != (cast: (@: void) @ sentinel_ctx)
        failures: failures + 1
        c.printf("button dispatch: scenarioA ctx not forwarded\n")
    ---
    checks: checks + 1
    if: mixa_app_window_count(stack) != 0U
        failures: failures + 1
        c.printf("button dispatch: scenarioA opened a window count=%d\n", (cast: (int) mixa_app_window_count(stack)))
    ---

    # --- Scenario B: hit "Foo" (unwired) -- real нет функции window opens ---
    # "Send" is 4 chars, at/above mixa_button_width's own "len<4 -> square"
    # threshold, so it is NOT square: width = wb-(wb>>2) = 6 for hb=4. "Foo"
    # (3 chars, <4) IS square (width=hb=4) and starts right after, at col 6.
    rc: mixa_button_dispatch_hit(panel, 10U, 6U, actions, 1U, stack, rect, 0U, 0U, 6U, 24U, 3U, msg, @ action_result)
    checks: checks + 1
    if: rc != MIXA_DISPATCH_FALLBACK_OK
        failures: failures + 1
        c.printf("button dispatch: scenarioB rc=%d\n", rc)
    ---
    checks: checks + 1
    if: g_action_calls != 1
        failures: failures + 1
        c.printf("button dispatch: scenarioB action ran again calls=%d\n", g_action_calls)
    ---
    checks: checks + 1
    if: mixa_app_window_count(stack) != 1U
        failures: failures + 1
        c.printf("button dispatch: scenarioB window count=%d\n", (cast: (int) mixa_app_window_count(stack)))
    ---
    top: mixa_app_window_top(stack)
    checks: checks + 1
    if: top = 0
        failures: failures + 1
        c.printf("button dispatch: scenarioB top window null\n")
    else:
        r: 0U
        while: r < 11U
            cq: mixa_cell_at_const(rect, top\msg_row, top\msg_col + r)
            if: cq = 0 || cq\codepoint != exp_msg[r]
                failures: failures + 1
                c.printf("button dispatch: scenarioB message mismatch at %d\n", (cast: (int) r))
            ---
            r: r + 1U
        ---
        checks: checks + 1
    ---

    # Dismiss the real fallback window (its own single OK button, drawn at
    # the bottom padding row of the window this call opened). "OK" is 2
    # chars (<4), always square at width=hb=3 for this window's own hb=3 --
    # NOT related to the outer main panel\panel_w used above for "Send"/
    # "Foo", a different, unrelated panel belonging to a different window.
    rc: mixa_app_window_hit(stack, rect, 0U + (6U - 3U - 1U), 0U + ((24U - 3U) / 2U))
    checks: checks + 1
    if: rc != 1
        failures: failures + 1
        c.printf("button dispatch: scenarioB dismiss rc=%d\n", rc)
    ---
    checks: checks + 1
    if: mixa_app_window_count(stack) != 0U
        failures: failures + 1
        c.printf("button dispatch: scenarioB window not dismissed count=%d\n", (cast: (int) mixa_app_window_count(stack)))
    ---

    # --- Scenario C: hit empty space -- neither an action nor a window ---
    rc: mixa_button_dispatch_hit(panel, 10U, 100U, actions, 1U, stack, rect, 0U, 0U, 6U, 24U, 3U, msg, @ action_result)
    checks: checks + 1
    if: rc != MIXA_DISPATCH_NONE
        failures: failures + 1
        c.printf("button dispatch: scenarioC rc=%d\n", rc)
    ---
    checks: checks + 1
    if: g_action_calls != 1 || mixa_app_window_count(stack) != 0U
        failures: failures + 1
        c.printf("button dispatch: scenarioC side effects calls=%d windows=%d\n", g_action_calls, (cast: (int) mixa_app_window_count(stack)))
    ---

    # --- Scenario D: null action table on a real hit -- falls back safely ---
    rc: mixa_button_dispatch_hit(panel, 10U, 0U, 0, 0U, stack, rect, 0U, 0U, 6U, 24U, 3U, msg, @ action_result)
    checks: checks + 1
    if: rc != MIXA_DISPATCH_FALLBACK_OK
        failures: failures + 1
        c.printf("button dispatch: scenarioD rc=%d\n", rc)
    ---
    checks: checks + 1
    if: mixa_app_window_count(stack) != 1U
        failures: failures + 1
        c.printf("button dispatch: scenarioD window count=%d\n", (cast: (int) mixa_app_window_count(stack)))
    ---
    mixa_app_window_dismiss(stack, rect)

    if: failures = 0
        c.printf("button dispatch selftest: %d checks, 0 failures\n", checks)
    else:
        c.printf("button dispatch selftest: %d checks, %d failures\n", checks, failures)
    ---
return: failures
