predef: "mixa_manager/mixa_process_marker.lm1"
predef: "mixa_manager/mixa_process_win32.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# PROCESS_SEAM 4.1 marker selftest (ticket 20260912-145000, corrections
# from review 20260912-151000). Real child processes for the end-to-end
# scenarios; pure in-process byte-feeding for the parser's own edge
# cases (this is how "every split position" is actually covered: the
# scanner is fed ONE BYTE AT A TIME by default -- if that is correct,
# any coarser real-world read() fragmentation is too, since the
# algorithm's own logic has no chunk-size-dependent branch anywhere;
# each scenario is ALSO fed as one whole buffer to prove both extremes
# agree). No fixed output cap in the test harness itself beyond a
# generous fixed scratch buffer (this is TEST code, not the parser).

[]: char g_out 65536
size_t: g_out_len
int: g_sink_fail_target
int: g_sink_calls
int: g_fault_calls
int: g_fault_target
int: g_collide_calls
int: g_collide_target

fn: cb_ordinary (@: void ctx; const: @(char bytes); size_t: len) int
    c.memcpy(g_out + g_out_len, bytes, len)
    g_out_len: g_out_len + len
    g_out[g_out_len]: 0
return: 0

fn: cb_ordinary_failing (@: void ctx; const: @(char bytes); size_t: len) int
    g_sink_calls: g_sink_calls + 1
    if: g_sink_fail_target > 0 && g_sink_calls >= g_sink_fail_target
        return: 7
    ---
    c.memcpy(g_out + g_out_len, bytes, len)
    g_out_len: g_out_len + len
    g_out[g_out_len]: 0
return: 0

sub: t_reset_out ()
    g_out_len: 0U
    g_out[0]: 0
    g_sink_calls: 0
    g_sink_fail_target: 0
end: t_reset_out

fn: t_sink () @: MixaProcessMarkerSink
    @: MixaProcessMarkerSink sink
    sink: (cast: (@: MixaProcessMarkerSink) c.calloc(1U, c.sizeof(c.MixaProcessMarkerSink)))
    sink\on_ordinary: cb_ordinary
    sink\ctx: 0
return: sink

fn: t_failing_sink () @: MixaProcessMarkerSink
    @: MixaProcessMarkerSink sink
    sink: (cast: (@: MixaProcessMarkerSink) c.calloc(1U, c.sizeof(c.MixaProcessMarkerSink)))
    sink\on_ordinary: cb_ordinary_failing
    sink\ctx: 0
return: sink

# --- Deterministic allocation-fault injection (review item 7). Global
# counters (not a per-instance ctx struct -- local struct: definitions
# are only supported in .h.lm1 header files in this codebase, not plain
# .lm1 files) since scenarios 23/24 use fault injection serially, never
# concurrently.
fn: t_on_alloc (@: void ctx; size_t: requested_size) int
    g_fault_calls: g_fault_calls + 1
    if: g_fault_target > 0 && g_fault_calls = g_fault_target
        return: 1
    ---
return: 0

fn: t_fault (int: target) @: MixaProcessMarkerFaultVTable
    @: MixaProcessMarkerFaultVTable v
    g_fault_calls: 0
    g_fault_target: target
    v: (cast: (@: MixaProcessMarkerFaultVTable) c.calloc(1U, c.sizeof(c.MixaProcessMarkerFaultVTable)))
    v\on_alloc: t_on_alloc
    v\ctx: 0
return: v

# --- Deterministic collision injection (ticket 20260912-153000 item 1).
# Forces the first `target` retry attempts in mixa_marker_create_wrapper
# _file to be treated as a real ERROR_FILE_EXISTS collision WITHOUT
# touching the filesystem, then lets the (target+1)-th attempt proceed
# as a genuine CreateFileW call -- proving the retry loop survives an
# arbitrary run of collisions (used with target=65) with no cap coded
# anywhere in the implementation.
fn: t_on_collide (@: void ctx) int
    g_collide_calls: g_collide_calls + 1
    if: g_collide_calls <= g_collide_target
        return: 1
    ---
return: 0

fn: t_collide_fault (int: target) @: MixaProcessMarkerFaultVTable
    @: MixaProcessMarkerFaultVTable v
    g_collide_calls: 0
    g_collide_target: target
    v: (cast: (@: MixaProcessMarkerFaultVTable) c.calloc(1U, c.sizeof(c.MixaProcessMarkerFaultVTable)))
    v\on_alloc: 0
    v\on_collide: t_on_collide
    v\ctx: 0
return: v

# Feeds bytes one at a time, propagating the consumed contract and
# stopping immediately (returning the nonzero status) on any failure or
# once the scanner becomes done, matching the "no-op once done" rule.
fn: t_feed_bytewise (@: MixaProcessMarkerScanner sc; const: @(MixaProcessMarkerSink sink); const: @(char input); size_t: len) int
    size_t: i
    []: size_t consumed_slot 1
    int: rc
    i: 0U
    while: i < len
        if: mixa_process_marker_scanner_done(sc) != 0
            return: 0
        ---
        consumed_slot[0]: 0U
        rc: mixa_process_marker_scanner_feed(sc, sink, input + i, 1U, consumed_slot)
        if: rc != MIXA_PROCESS_MARKER_OK
            return: rc
        ---
        i: i + 1U
    ---
return: 0

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    @: MixaProcessMarkerScanner sc
    @: MixaProcessMarkerSink sink
    @: MixaProcessMarkerSink fsink
    const: @(char marker)
    const: @(char input)
    int: failures
    int: checks
    []: size_t consumed 1
    int: rc
    c.setbuf((cast: (@: void) c.stdout), 0)
    failures: 0
    checks: 0
    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    ---
    if: argc < 2
        c.snprintf(base, 520U, "build/mixa/claude/process_marker/tmp")
    ---
    sink: t_sink()
    fsink: t_failing_sink()
    marker: "MIXA_MARK_00000000_00000000cafef00d"

    # --- Scenario 1: basic record, byte-wise AND whole-buffer, both agree.
    input: "line one\nline two\nMIXA_MARK_00000000_00000000cafef00d\t0\t/tmp/dir\n"
    sc: (cast: (@: MixaProcessMarkerScanner) c.calloc(1U, c.sizeof(c.MixaProcessMarkerScanner)))
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0
        failures: failures + 1
        c.printf("marker: scenario1 bytewise not done\n")
    ---
    checks: checks + 1
    if: sc\exit_code != 0 || sc\cwd_len != 8U || c.strncmp(sc\cwd, "/tmp/dir", 8U) != 0
        failures: failures + 1
        c.printf("marker: scenario1 bytewise exit=%d cwd=[%.*s]\n", sc\exit_code, (cast: (int) sc\cwd_len), sc\cwd)
    ---
    checks: checks + 1
    if: c.strcmp(g_out, "line one\nline two\n") != 0
        failures: failures + 1
        c.printf("marker: scenario1 bytewise ordinary=[%s]\n", g_out)
    ---
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    consumed[0]: 0U
    mixa_process_marker_scanner_feed(sc, sink, input, c.strlen(input), consumed)
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || sc\exit_code != 0 || c.strncmp(sc\cwd, "/tmp/dir", 8U) != 0
        failures: failures + 1
        c.printf("marker: scenario1 whole-buffer mismatch\n")
    ---
    checks: checks + 1
    if: c.strcmp(g_out, "line one\nline two\n") != 0
        failures: failures + 1
        c.printf("marker: scenario1 whole-buffer ordinary=[%s]\n", g_out)
    ---
    checks: checks + 1
    if: consumed[0] != c.strlen(input)
        failures: failures + 1
        c.printf("marker: scenario1 whole-buffer consumed=%zu want %zu (record ends exactly at input end)\n", consumed[0], c.strlen(input))
    ---

    # --- Scenario 2: nonzero status.
    input: "MIXA_MARK_00000000_00000000cafef00d\t42\t/a\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || sc\exit_code != 42
        failures: failures + 1
        c.printf("marker: scenario2 exit=%d want 42\n", sc\exit_code)
    ---

    # --- Scenario 3: negative status.
    input: "MIXA_MARK_00000000_00000000cafef00d\t-7\t/a\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || sc\exit_code != -7
        failures: failures + 1
        c.printf("marker: scenario3 exit=%d want -7\n", sc\exit_code)
    ---

    # --- Scenario 4: spaces in the final directory.
    input: "MIXA_MARK_00000000_00000000cafef00d\t0\tC:\\Program Files\\x\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || c.strncmp(sc\cwd, "C:\\Program Files\\x", sc\cwd_len) != 0
        failures: failures + 1
        c.printf("marker: scenario4 cwd=[%.*s]\n", (cast: (int) sc\cwd_len), sc\cwd)
    ---

    # --- Scenario 5: non-ASCII (UTF-8 Cyrillic) in the final directory.
    input: "MIXA_MARK_00000000_00000000cafef00d\t0\tC:\\\xD0\xBF\xD0\xB0\xD0\xBF\xD0\xBA\xD0\xB0\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || sc\cwd_len != 13U
        failures: failures + 1
        c.printf("marker: scenario5 cwd_len=%zu want 13\n", sc\cwd_len)
    ---

    # --- Scenario 6: quotes in the final directory.
    input: "MIXA_MARK_00000000_00000000cafef00d\t0\t\"C:\\a b\"\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || c.strncmp(sc\cwd, "\"C:\\a b\"", sc\cwd_len) != 0
        failures: failures + 1
        c.printf("marker: scenario6 cwd=[%.*s]\n", (cast: (int) sc\cwd_len), sc\cwd)
    ---

    # --- Scenario 7: a DECEPTIVE marker-like string -- same prefix, WRONG
    # identity (different tail) -- must be ordinary output, never matched.
    input: "before MIXA_MARK_00000000_00000000deadbeef\t0\t/x\n after\nMIXA_MARK_00000000_00000000cafef00d\t0\t/real\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || c.strncmp(sc\cwd, "/real", 5U) != 0
        failures: failures + 1
        c.printf("marker: scenario7 did not find the REAL marker, cwd=[%.*s]\n", (cast: (int) sc\cwd_len), sc\cwd)
    ---
    checks: checks + 1
    if: c.strstr(g_out, "deadbeef") = 0
        failures: failures + 1
        c.printf("marker: scenario7 the wrong-identity marker was not emitted as ordinary output: [%s]\n", g_out)
    ---
    checks: checks + 1
    if: c.strstr(g_out, "before") = 0 || c.strstr(g_out, "after") = 0
        failures: failures + 1
        c.printf("marker: scenario7 surrounding ordinary text missing: [%s]\n", g_out)
    ---

    # --- Scenario 8: an INCOMPLETE marker occurrence (a genuine prefix
    # that breaks mid-way, right after a line start) followed later by the
    # real marker -- proves recovery via the flush-whole-buffer-on-
    # mismatch rule (review item 2's simplified SCAN mismatch handling).
    input: "x\nMIXA_MARK_00000000_ZZZZ stray\nMIXA_MARK_00000000_00000000cafef00d\t3\t/p\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || sc\exit_code != 3
        failures: failures + 1
        c.printf("marker: scenario8 did not recover after a broken partial match, exit=%d done=%d\n", sc\exit_code, mixa_process_marker_scanner_done(sc))
    ---
    checks: checks + 1
    if: c.strstr(g_out, "MIXA_MARK_00000000_ZZZZ") = 0
        failures: failures + 1
        c.printf("marker: scenario8 the broken partial match was not flushed as ordinary: [%s]\n", g_out)
    ---

    # --- Scenario 9: the marker text EMBEDDED but NOT at a real record
    # boundary (no tab immediately after it) -- malformed, ordinary.
    input: "MIXA_MARK_00000000_00000000cafef00d is just a word here\nMIXA_MARK_00000000_00000000cafef00d\t0\t/q\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || c.strncmp(sc\cwd, "/q", 2U) != 0
        failures: failures + 1
        c.printf("marker: scenario9 embedded-not-at-boundary confused the parser, cwd=[%.*s]\n", (cast: (int) sc\cwd_len), sc\cwd)
    ---
    checks: checks + 1
    if: c.strstr(g_out, "is just a word here") = 0
        failures: failures + 1
        c.printf("marker: scenario9 embedded occurrence not flushed as ordinary: [%s]\n", g_out)
    ---

    # --- Scenario 9b (review item 2): an EXACT, otherwise fully valid
    # marker/status/cwd record appearing immediately after a NON-newline
    # byte (mid-line, not a real record start) -- must remain entirely
    # ordinary and `done` must stay false, unlike every other scenario.
    input: "xMIXA_MARK_00000000_00000000cafef00d\t0\t/mid\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    mixa_process_marker_scanner_eof(sc, sink)
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) != 0
        failures: failures + 1
        c.printf("marker: scenario9b a mid-line exact-looking record was wrongly accepted as a real record\n")
    ---
    checks: checks + 1
    if: c.strcmp(g_out, input) != 0
        failures: failures + 1
        c.printf("marker: scenario9b ordinary=[%s] want the whole line verbatim (marker not at a line start)\n", g_out)
    ---

    # --- Scenario 9c (review item 2): the SAME exact record, but now
    # genuinely AT a line start (right after LF) -- must be recognized,
    # proving the gating is about position, not content.
    input: "x\nMIXA_MARK_00000000_00000000cafef00d\t0\t/afterlf\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || c.strncmp(sc\cwd, "/afterlf", 8U) != 0
        failures: failures + 1
        c.printf("marker: scenario9c a genuine post-LF record was wrongly rejected, done=%d\n", mixa_process_marker_scanner_done(sc))
    ---

    # --- Scenario 10: malformed integer (a letter where a digit is
    # expected) -- the whole tentative record is ordinary output.
    input: "MIXA_MARK_00000000_00000000cafef00d\tXY\t/r\nMIXA_MARK_00000000_00000000cafef00d\t5\t/s\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || sc\exit_code != 5
        failures: failures + 1
        c.printf("marker: scenario10 malformed integer not handled, exit=%d\n", sc\exit_code)
    ---
    checks: checks + 1
    if: c.strstr(g_out, "MIXA_MARK_00000000_00000000cafef00d\tXY") = 0
        failures: failures + 1
        c.printf("marker: scenario10 malformed record not flushed verbatim: [%s]\n", g_out)
    ---

    # --- Scenario 11: overflow integer (far beyond i32 range).
    input: "MIXA_MARK_00000000_00000000cafef00d\t99999999999999\t/t\nMIXA_MARK_00000000_00000000cafef00d\t6\t/u\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || sc\exit_code != 6
        failures: failures + 1
        c.printf("marker: scenario11 overflow integer not rejected, exit=%d\n", sc\exit_code)
    ---

    # --- Scenario 12: CRLF line ending on the record itself.
    input: "MIXA_MARK_00000000_00000000cafef00d\t0\t/crlf\r\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || sc\cwd_len != 5U || c.strncmp(sc\cwd, "/crlf", 5U) != 0
        failures: failures + 1
        c.printf("marker: scenario12 CRLF cwd_len=%zu cwd=[%.*s] want 5/[/crlf] (CR must be stripped)\n", sc\cwd_len, (cast: (int) sc\cwd_len), sc\cwd)
    ---

    # --- Scenario 13: EOF without any marker at all -- "no status",
    # everything buffered flushed as ordinary, done stays false.
    input: "just some output with no marker ever\nmore output\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    mixa_process_marker_scanner_eof(sc, sink)
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) != 0
        failures: failures + 1
        c.printf("marker: scenario13 done should stay false with no marker\n")
    ---
    checks: checks + 1
    if: c.strcmp(g_out, input) != 0
        failures: failures + 1
        c.printf("marker: scenario13 ordinary=[%s] want the whole input verbatim\n", g_out)
    ---

    # --- Scenario 14: EOF exactly MID-MARKER (a genuine partial prefix,
    # stream ends before it can be confirmed either way) -- flushed as
    # ordinary, no status invented.
    input: "some text\nMIXA_MARK_00000000_0000"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) != 0
        failures: failures + 1
        c.printf("marker: scenario14 should not be done before eof()\n")
    ---
    mixa_process_marker_scanner_eof(sc, sink)
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) != 0
        failures: failures + 1
        c.printf("marker: scenario14 done should stay false after eof() with no complete record\n")
    ---
    checks: checks + 1
    if: c.strcmp(g_out, input) != 0
        failures: failures + 1
        c.printf("marker: scenario14 ordinary=[%s] want the whole partial input verbatim\n", g_out)
    ---

    # --- Scenario 15: eof() after an ALREADY-complete record is a no-op
    # (does not re-flush or corrupt the already-recognized result).
    input: "MIXA_MARK_00000000_00000000cafef00d\t0\t/done\n"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0
        failures: failures + 1
        c.printf("marker: scenario15 setup not done\n")
    ---
    mixa_process_marker_scanner_eof(sc, sink)
    checks: checks + 1
    if: mixa_process_marker_scanner_done(sc) = 0 || c.strncmp(sc\cwd, "/done", 5U) != 0
        failures: failures + 1
        c.printf("marker: scenario15 eof() after done corrupted the result\n")
    ---
    checks: checks + 1
    if: g_out_len != 0U
        failures: failures + 1
        c.printf("marker: scenario15 eof() after done wrongly flushed something: [%s]\n", g_out)
    ---

    # --- Scenario 16: embedded NUL inside the cwd field -- explicitly
    # rejected, not silently truncated at the NUL.
    if: 1
        []: char raw 64
        size_t: n
        c.memcpy(raw, "MIXA_MARK_00000000_00000000cafef00d\t0\t/a", 41U)
        raw[41]: 0
        raw[42]: (cast: (char) 98)
        raw[43]: (cast: (char) 10)
        n: 44U
        mixa_process_marker_scanner_release(sc)
        mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
        t_reset_out()
        t_feed_bytewise(sc, sink, raw, n)
        checks: checks + 1
        if: mixa_process_marker_scanner_done(sc) != 0
            failures: failures + 1
            c.printf("marker: scenario16 embedded NUL should NOT yield a completed record\n")
        ---
    ---

    # --- Scenario 17: identity generation is unique across calls.
    if: 1
        @: MixaProcessMarkerGen gen
        []: (@: char) m1_slot 1
        []: (@: char) m2_slot 1
        @: char m1
        @: char m2
        gen: (cast: (@: MixaProcessMarkerGen) c.calloc(1U, c.sizeof(c.MixaProcessMarkerGen)))
        m1_slot[0]: 0
        m2_slot[0]: 0
        mixa_process_marker_generate(gen, m1_slot, 0)
        mixa_process_marker_generate(gen, m2_slot, 0)
        m1: m1_slot[0]
        m2: m2_slot[0]
        checks: checks + 1
        if: m1 = 0 || m2 = 0 || c.strcmp(m1, m2) = 0
            failures: failures + 1
            c.printf("marker: scenario17 two generated markers were not unique: [%s] [%s]\n", m1, m2)
        ---
        c.free(m1)
        c.free(m2)
        c.free(gen)
    ---
    checks: checks + 1
    if: mixa_process_marker_generate(0, 0, 0) != MIXA_PROCESS_MARKER_ERR_ARG
        failures: failures + 1
        c.printf("marker: generate null args not ERR_ARG\n")
    ---
    checks: checks + 1
    if: mixa_process_marker_scanner_open(0, marker, c.strlen(marker), 0) != MIXA_PROCESS_MARKER_ERR_ARG
        failures: failures + 1
        c.printf("marker: scanner_open null sc not ERR_ARG\n")
    ---
    consumed[0]: 99U
    checks: checks + 1
    if: mixa_process_marker_scanner_feed(0, sink, "x", 1U, consumed) != MIXA_PROCESS_MARKER_ERR_ARG || consumed[0] != 0U
        failures: failures + 1
        c.printf("marker: scanner_feed null sc not ERR_ARG/consumed=0\n")
    ---
    checks: checks + 1
    if: mixa_process_marker_scanner_feed(sc, sink, "x", 1U, 0) != MIXA_PROCESS_MARKER_ERR_ARG
        failures: failures + 1
        c.printf("marker: scanner_feed null consumed not ERR_ARG\n")
    ---
    mixa_process_marker_scanner_release(0)
    checks: checks + 1
    if: mixa_process_marker_scanner_done(0) != 0
        failures: failures + 1
        c.printf("marker: scanner_done(0) not 0\n")
    ---

    # --- Scenario 20 (review item 1): sink failure inside feed()'s own
    # direct-emit fast path, deterministically after a CHOSEN byte. The
    # exact propagated status and *consumed (bytes processed, failing
    # byte included, nothing after it touched) are both asserted.
    input: "abcdef"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    g_sink_fail_target: 3
    g_sink_calls: 0
    consumed[0]: 0U
    rc: mixa_process_marker_scanner_feed(sc, fsink, input, c.strlen(input), consumed)
    checks: checks + 1
    if: rc != 7
        failures: failures + 1
        c.printf("marker: scenario20 feed sink failure rc=%d want 7\n", rc)
    ---
    checks: checks + 1
    if: consumed[0] != 3U
        failures: failures + 1
        c.printf("marker: scenario20 feed sink failure consumed=%zu want 3\n", consumed[0])
    ---
    checks: checks + 1
    if: c.strcmp(g_out, "ab") != 0
        failures: failures + 1
        c.printf("marker: scenario20 ordinary before failure=[%s] want [ab]\n", g_out)
    ---
    g_sink_fail_target: 0

    # --- Scenario 21 (review item 1): sink failure during eof()'s own
    # flush of buffered (partial-match) bytes.
    input: "MIXA_MARK_00000000_0000"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    t_feed_bytewise(sc, sink, input, c.strlen(input))
    t_reset_out()
    g_sink_fail_target: 1
    g_sink_calls: 0
    rc: mixa_process_marker_scanner_eof(sc, fsink)
    checks: checks + 1
    if: rc != 7
        failures: failures + 1
        c.printf("marker: scenario21 eof sink failure rc=%d want 7\n", rc)
    ---
    g_sink_fail_target: 0

    # --- Scenario 22 (review item 8): bytes AFTER a complete record in
    # the SAME feed() call are NOT examined at all -- consumed stops
    # exactly at the record's own end, and a later feed() call on the
    # already-done scanner is a no-op with consumed==0.
    input: "MIXA_MARK_00000000_00000000cafef00d\t0\t/z\nEXTRA_BYTES_AFTER"
    mixa_process_marker_scanner_release(sc)
    mixa_process_marker_scanner_open(sc, marker, c.strlen(marker), 0)
    t_reset_out()
    consumed[0]: 0U
    rc: mixa_process_marker_scanner_feed(sc, sink, input, c.strlen(input), consumed)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK || mixa_process_marker_scanner_done(sc) = 0
        failures: failures + 1
        c.printf("marker: scenario22 record not completed, rc=%d\n", rc)
    ---
    checks: checks + 1
    if: consumed[0] != 41U
        failures: failures + 1
        c.printf("marker: scenario22 consumed=%zu want 41 (record ends right after its own LF)\n", consumed[0])
    ---
    checks: checks + 1
    if: g_out_len != 0U
        failures: failures + 1
        c.printf("marker: scenario22 trailing bytes were wrongly examined/emitted: [%s]\n", g_out)
    ---
    consumed[0]: 99U
    rc: mixa_process_marker_scanner_feed(sc, sink, input + consumed[0], 5U, consumed)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        failures: failures + 1
        c.printf("marker: scenario22 feed after done should be OK no-op, rc=%d\n", rc)
    ---

    # --- Scenario 23 (review item 7): deterministic allocation failure
    # at the scanner's own FIRST pending-buffer growth (the moment a
    # tentative match begins), proving ERR_NOMEM is returned, nothing is
    # invented, and *consumed still accounts for the failing byte.
    if: 1
        @: MixaProcessMarkerFaultVTable fv
        @: MixaProcessMarkerScanner scf
        fv: t_fault(1)
        scf: (cast: (@: MixaProcessMarkerScanner) c.calloc(1U, c.sizeof(c.MixaProcessMarkerScanner)))
        mixa_process_marker_scanner_open(scf, marker, c.strlen(marker), fv)
        t_reset_out()
        consumed[0]: 0U
        rc: mixa_process_marker_scanner_feed(scf, sink, marker, 1U, consumed)
        checks: checks + 1
        if: rc != MIXA_PROCESS_MARKER_ERR_NOMEM
            failures: failures + 1
            c.printf("marker: scenario23 forced growth failure rc=%d want ERR_NOMEM\n", rc)
        ---
        checks: checks + 1
        if: consumed[0] != 1U
            failures: failures + 1
            c.printf("marker: scenario23 consumed=%zu want 1\n", consumed[0])
        ---
        mixa_process_marker_scanner_release(scf)
        c.free(scf)
        c.free(fv)
    ---

    # --- Scenario 24 (review item 7): deterministic allocation failure
    # inside build_wrapper's own FIRST allocation (GetTempPathW's own
    # required-size buffer) -- proves a clean ERR_NOMEM with both out
    # params left null (nothing to clean up yet).
    if: 1
        @: MixaProcessMarkerFaultVTable fv2
        []: (@: char) wcmd_slot 1
        []: (@: char) wpath_slot 1
        fv2: t_fault(1)
        wcmd_slot[0]: 0
        wpath_slot[0]: 0
        rc: mixa_process_marker_build_wrapper("echo hi", marker, fv2, wcmd_slot, wpath_slot)
        checks: checks + 1
        if: rc != MIXA_PROCESS_MARKER_ERR_NOMEM
            failures: failures + 1
            c.printf("marker: scenario24 build_wrapper forced first-alloc failure rc=%d want ERR_NOMEM\n", rc)
        ---
        checks: checks + 1
        if: wcmd_slot[0] != 0 || wpath_slot[0] != 0
            failures: failures + 1
            c.printf("marker: scenario24 outputs should stay null on failure\n")
        ---
        c.free(fv2)
    ---

    # --- Scenario 25 (review item 5): a real build_wrapper call succeeds,
    # produces BOTH a quoted command and an unquoted path, and
    # cleanup_wrapper on that path (simulating a spawn() failure) removes
    # it -- proven by a second cleanup_wrapper call on the now-already-
    # gone path still returning OK (best-effort, safe on a missing file).
    if: 1
        []: (@: char) wcmd2_slot 1
        []: (@: char) wpath2_slot 1
        @: char wcmd2
        @: char wpath2
        wcmd2_slot[0]: 0
        wpath2_slot[0]: 0
        rc: mixa_process_marker_build_wrapper("echo hi", marker, 0, wcmd2_slot, wpath2_slot)
        checks: checks + 1
        if: rc != MIXA_PROCESS_MARKER_OK || wcmd2_slot[0] = 0 || wpath2_slot[0] = 0
            failures: failures + 1
            c.printf("marker: scenario25 build_wrapper rc=%d\n", rc)
        ---
        wcmd2: wcmd2_slot[0]
        wpath2: wpath2_slot[0]
        checks: checks + 1
        if: c.strstr(wcmd2, wpath2) = 0
            failures: failures + 1
            c.printf("marker: scenario25 quoted command does not contain the unquoted path\n")
        ---
        checks: checks + 1
        if: mixa_process_marker_cleanup_wrapper(wpath2) != MIXA_PROCESS_MARKER_OK
            failures: failures + 1
            c.printf("marker: scenario25 first cleanup_wrapper failed\n")
        ---
        checks: checks + 1
        if: mixa_process_marker_cleanup_wrapper(wpath2) != MIXA_PROCESS_MARKER_OK
            failures: failures + 1
            c.printf("marker: scenario25 second cleanup_wrapper (already-gone file) should still be OK\n")
        ---
        checks: checks + 1
        if: mixa_process_marker_cleanup_wrapper(0) != MIXA_PROCESS_MARKER_OK
            failures: failures + 1
            c.printf("marker: scenario25 cleanup_wrapper(0) should be OK\n")
        ---
        c.free(wcmd2)
        c.free(wpath2)
    ---

    # --- Scenario 26 (review item 4, collision-proofing): repeated rapid
    # build_wrapper calls each produce a DISTINCT wrapper path. This is
    # indirect evidence of the CREATE_NEW-atomic, retry-on-collision
    # design under real load, not a forced exact-collision reproduction
    # (the candidate name is derived from PID + QueryPerformanceCounter
    # bits + an attempt counter that this test has no seam to predict or
    # pin without adding a test-only hook into the name generator, which
    # would work against keeping this module owner-local as instructed;
    # this gap is disclosed, not silently skipped).
    if: 1
        []: (@: char) paths 20
        int: dupe
        int: pi
        int: pj
        []: (@: char) wc_slot 1
        []: (@: char) wp_slot 1
        @: char one_path
        dupe: 0
        pi: 0
        while: pi < 20
            wc_slot[0]: 0
            wp_slot[0]: 0
            mixa_process_marker_build_wrapper("echo hi", marker, 0, wc_slot, wp_slot)
            one_path: (cast: (@: char) wp_slot[0])
            paths[pi]: (cast: (@: char) c.malloc(c.strlen(one_path) + 1U))
            c.strcpy(paths[pi], one_path)
            mixa_process_marker_cleanup_wrapper(one_path)
            c.free(wc_slot[0])
            c.free(wp_slot[0])
            pi: pi + 1
        ---
        pi: 0
        while: pi < 20
            pj: pi + 1
            while: pj < 20
                if: c.strcmp(paths[pi], paths[pj]) = 0
                    dupe: 1
                ---
                pj: pj + 1
            ---
            pi: pi + 1
        ---
        checks: checks + 1
        if: dupe != 0
            failures: failures + 1
            c.printf("marker: scenario26 two of 20 rapid wrapper paths collided\n")
        ---
        pi: 0
        while: pi < 20
            c.free(paths[pi])
            pi: pi + 1
        ---
    ---

    # --- Scenario 27 (ticket 20260912-153000 item 2): a deterministic
    # allocation failure on mixa_process_marker_generate's own single
    # allocation -- proves the fault seam now sweeps this site too (the
    # prior ticket's disclosed exception is closed).
    if: 1
        @: MixaProcessMarkerFaultVTable fv3
        @: MixaProcessMarkerGen genf
        []: (@: char) mf_slot 1
        fv3: t_fault(1)
        genf: (cast: (@: MixaProcessMarkerGen) c.calloc(1U, c.sizeof(c.MixaProcessMarkerGen)))
        mf_slot[0]: 0
        rc: mixa_process_marker_generate(genf, mf_slot, fv3)
        checks: checks + 1
        if: rc != MIXA_PROCESS_MARKER_ERR_NOMEM
            failures: failures + 1
            c.printf("marker: scenario27 generate forced-alloc-failure rc=%d want ERR_NOMEM\n", rc)
        ---
        checks: checks + 1
        if: mf_slot[0] != 0
            failures: failures + 1
            c.printf("marker: scenario27 out_marker should stay null on failure\n")
        ---
        c.free(genf)
        c.free(fv3)
    ---

    # --- Scenario 28 (ticket 20260912-153000 item 1): the CREATE_NEW
    # retry loop survives 65 CONSECUTIVE forced collisions and still
    # succeeds on the 66th attempt -- proving there is no coded cap
    # (the implementation itself never compares the attempt counter
    # against any constant; only real Win32 exhaustion or a non-
    # collision error would stop it).
    if: 1
        @: MixaProcessMarkerFaultVTable fv4
        []: (@: char) wc4_slot 1
        []: (@: char) wp4_slot 1
        fv4: t_collide_fault(65)
        wc4_slot[0]: 0
        wp4_slot[0]: 0
        rc: mixa_process_marker_build_wrapper("echo hi", marker, fv4, wc4_slot, wp4_slot)
        checks: checks + 1
        if: rc != MIXA_PROCESS_MARKER_OK
            failures: failures + 1
            c.printf("marker: scenario28 build_wrapper after 65 forced collisions rc=%d want OK\n", rc)
        ---
        checks: checks + 1
        if: g_collide_calls != 66
            failures: failures + 1
            c.printf("marker: scenario28 collide hook was called %d times, want 66 (65 collisions + 1 real success)\n", g_collide_calls)
        ---
        checks: checks + 1
        if: wc4_slot[0] = 0 || wp4_slot[0] = 0
            failures: failures + 1
            c.printf("marker: scenario28 outputs should be set on eventual success\n")
        ---
        if: wp4_slot[0] != 0
            mixa_process_marker_cleanup_wrapper((cast: (@: char) wp4_slot[0]))
        ---
        c.free(wc4_slot[0])
        c.free(wp4_slot[0])
        c.free(fv4)
    ---

    # --- Scenario 18: real end-to-end -- spawn a real shell wrapper
    # child, read its real merged output through the real process seam,
    # feed a real live byte stream through the scanner.
    if: 1
        @: MixaProcessMarkerGen gen2
        []: (@: char) marker2_slot 1
        @: char marker2
        []: (@: char) wrapper_slot 1
        []: (@: char) wrapper_path_slot 1
        @: char wrapper
        @: char wrapper_path
        @: MixaProcess p
        @: MixaProcessMarkerScanner sc2
        []: char readbuf 4096
        size_t: got
        int: rc2
        int: running
        int: code
        int: i
        []: size_t consumed2 1
        gen2: (cast: (@: MixaProcessMarkerGen) c.calloc(1U, c.sizeof(c.MixaProcessMarkerGen)))
        marker2_slot[0]: 0
        mixa_process_marker_generate(gen2, marker2_slot, 0)
        marker2: marker2_slot[0]
        wrapper_slot[0]: 0
        wrapper_path_slot[0]: 0
        rc2: mixa_process_marker_build_wrapper("echo real1 & echo real2", marker2, 0, wrapper_slot, wrapper_path_slot)
        checks: checks + 1
        if: rc2 != MIXA_PROCESS_MARKER_OK
            failures: failures + 1
            c.printf("marker: scenario18 build_wrapper rc=%d\n", rc2)
        ---
        wrapper: wrapper_slot[0]
        wrapper_path: wrapper_path_slot[0]
        sc2: (cast: (@: MixaProcessMarkerScanner) c.calloc(1U, c.sizeof(c.MixaProcessMarkerScanner)))
        mixa_process_marker_scanner_open(sc2, marker2, c.strlen(marker2), 0)
        t_reset_out()
        p: 0
        rc2: mixa_process_spawn(@ p, wrapper, base, 0)
        checks: checks + 1
        if: rc2 != MIXA_PROC_OK || p = 0
            failures: failures + 1
            c.printf("marker: scenario18 spawn rc=%d\n", rc2)
            mixa_process_marker_cleanup_wrapper(wrapper_path)
        ---
        running: 1
        i: 0
        while: i < 300 && (running != 0 || mixa_process_marker_scanner_done(sc2) = 0)
            mixa_process_status(p, @ running, @ code)
            got: 0U
            rc2: mixa_process_read(p, readbuf, 4096U, @ got)
            if: got > 0U
                consumed2[0]: 0U
                mixa_process_marker_scanner_feed(sc2, sink, readbuf, got, consumed2)
            ---
            if: rc2 = MIXA_PROC_EOF
                mixa_process_marker_scanner_eof(sc2, sink)
                i: 300
            ---
            c.Sleep(10U)
            i: i + 1
        ---
        checks: checks + 1
        if: mixa_process_marker_scanner_done(sc2) = 0
            failures: failures + 1
            c.printf("marker: scenario18 real end-to-end did not complete a record\n")
        ---
        checks: checks + 1
        if: sc2\exit_code != 0
            failures: failures + 1
            c.printf("marker: scenario18 real exit_code=%d want 0\n", sc2\exit_code)
        ---
        checks: checks + 1
        if: c.strstr(g_out, "real1") = 0 || c.strstr(g_out, "real2") = 0
            failures: failures + 1
            c.printf("marker: scenario18 real ordinary output missing lines: [%s]\n", g_out)
        ---
        checks: checks + 1
        if: sc2\cwd_len = 0U
            failures: failures + 1
            c.printf("marker: scenario18 real cwd empty\n")
        ---
        mixa_process_close(@ p)
        mixa_process_marker_scanner_release(sc2)
        c.free(sc2)
        c.free(wrapper)
        c.free(wrapper_path)
        c.free(marker2)
        c.free(gen2)
    ---

    # --- Scenario 19: real end-to-end with a real nonzero exit code.
    if: 1
        @: MixaProcessMarkerGen gen3
        []: (@: char) marker3_slot 1
        @: char marker3
        []: (@: char) wrapper3_slot 1
        []: (@: char) wrapper3_path_slot 1
        @: char wrapper3
        @: char wrapper3_path
        @: MixaProcess p3
        @: MixaProcessMarkerScanner sc3
        []: char readbuf3 4096
        size_t: got3
        int: rc3
        int: running3
        int: code3
        int: i3
        []: size_t consumed3 1
        gen3: (cast: (@: MixaProcessMarkerGen) c.calloc(1U, c.sizeof(c.MixaProcessMarkerGen)))
        marker3_slot[0]: 0
        mixa_process_marker_generate(gen3, marker3_slot, 0)
        marker3: marker3_slot[0]
        wrapper3_slot[0]: 0
        wrapper3_path_slot[0]: 0
        mixa_process_marker_build_wrapper("cmd /c exit /b 9", marker3, 0, wrapper3_slot, wrapper3_path_slot)
        wrapper3: wrapper3_slot[0]
        wrapper3_path: wrapper3_path_slot[0]
        sc3: (cast: (@: MixaProcessMarkerScanner) c.calloc(1U, c.sizeof(c.MixaProcessMarkerScanner)))
        mixa_process_marker_scanner_open(sc3, marker3, c.strlen(marker3), 0)
        t_reset_out()
        p3: 0
        rc3: mixa_process_spawn(@ p3, wrapper3, base, 0)
        checks: checks + 1
        if: rc3 != MIXA_PROC_OK || p3 = 0
            failures: failures + 1
            c.printf("marker: scenario19 spawn rc=%d\n", rc3)
            mixa_process_marker_cleanup_wrapper(wrapper3_path)
        ---
        running3: 1
        i3: 0
        while: i3 < 300 && (running3 != 0 || mixa_process_marker_scanner_done(sc3) = 0)
            mixa_process_status(p3, @ running3, @ code3)
            got3: 0U
            rc3: mixa_process_read(p3, readbuf3, 4096U, @ got3)
            if: got3 > 0U
                consumed3[0]: 0U
                mixa_process_marker_scanner_feed(sc3, sink, readbuf3, got3, consumed3)
            ---
            if: rc3 = MIXA_PROC_EOF
                mixa_process_marker_scanner_eof(sc3, sink)
                i3: 300
            ---
            c.Sleep(10U)
            i3: i3 + 1
        ---
        checks: checks + 1
        if: mixa_process_marker_scanner_done(sc3) = 0 || sc3\exit_code != 9
            failures: failures + 1
            c.printf("marker: scenario19 real nonzero exit_code=%d want 9\n", sc3\exit_code)
        ---
        mixa_process_close(@ p3)
        mixa_process_marker_scanner_release(sc3)
        c.free(sc3)
        c.free(wrapper3)
        c.free(wrapper3_path)
        c.free(marker3)
        c.free(gen3)
    ---

    mixa_process_marker_scanner_release(sc)
    c.free(sc)
    c.free(sink)
    c.free(fsink)

    if: failures = 0
        c.printf("process marker selftest: %d checks, 0 failures\n", checks)
    else:
        c.printf("process marker selftest: %d checks, %d failures\n", checks, failures)
    ---
return: failures
