predef: "mixa_manager/mixa_remove.h.lm1"
predef: "mixa_manager/mixa_remove.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# Remove-selected operation selftest (ticket 20260913-021200), porting
# FSync.java's del()/DelAction/removeSelect2 as a reusable manager-owned
# operation seam. Real, test-owned directory trees under this run's own
# directory; every mutation happens inside that fixture root, verified
# before any write. No user files anywhere.

int: g_calls
[]: char g_trace 4000
size_t: g_trace_len
int: g_fail_at_call
int: g_fail_status

fn: t_base (const: @(char path)) const: @(char)
    size_t: n
    size_t: i
    size_t: last
    int: found
    n: c.strlen(path)
    last: 0U
    found: 0
    i: 0U
    while: i < n
        if: path[i] = (cast: (char) 92) || path[i] = (cast: (char) 47)
            last: i + 1U
            found: 1
        ---
        i: i + 1U
    ---
    if: found = 0
        return: path
return: path + last

sub: t_record (const: @(char kind); const: @(char path); int: status)
    size_t: room
    if: g_trace_len + 80U >= 4000U
        return
    ---
    room: 4000U - g_trace_len
    c.snprintf(g_trace + g_trace_len, room, "%s:%s:%d|", kind, t_base(path), status)
    g_trace_len: c.strlen(g_trace)
end: t_record

fn: t_note (const: @(char kind); const: @(char path); int: status) int
    g_calls: g_calls + 1
    t_record(kind, path, status)
    if: g_fail_at_call != 0 && g_calls = g_fail_at_call
        return: g_fail_status
return: MIXA_SEL_WALK_GO

fn: cb_file (@: void ctx; const: @(char path); int: is_dir; int: status) int
return: t_note("F", path, status)

fn: cb_dir_done (@: void ctx; const: @(char path); int: is_dir; int: status) int
return: t_note("E", path, status)

@: MixaRemoveSink g_sink
int: g_sink_ready

fn: t_sink () const: @(MixaRemoveSink)
    if: g_sink_ready = 0
        g_sink: (cast: (@: MixaRemoveSink) c.calloc(1U, c.sizeof(c.MixaRemoveSink)))
        g_sink\on_file: cb_file
        g_sink\on_dir_done: cb_dir_done
        g_sink_ready: 1
    ---
return: g_sink

sub: t_reset ()
    g_calls: 0
    g_trace[0]: 0
    g_trace_len: 0U
    g_fail_at_call: 0
    g_fail_status: 0
end: t_reset

fn: t_count (const: @(char needle)) int
    const: @(char p)
    int: n
    n: 0
    p: c.strstr(g_trace, needle)
    while: p != 0
        n: n + 1
        p: c.strstr(p + 1U, needle)
return: n

sub: t_touch (const: @(char path); const: @(char content))
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "wb")
    if: fh[0] != 0
        c.fputs(content, fh[0])
        c.fclose(fh[0])
    ---
end: t_touch

fn: t_exists (const: @(char path)) int
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "rb")
    if: fh[0] = 0
        return: 0
    ---
    c.fclose(fh[0])
return: 1

# t_exists (fopen-based) can never succeed on a DIRECTORY path -- it is
# only valid for real files. This is the directory-existence equivalent,
# reusing the already-available mixa_dir_stat (mixa_remove.h.lm1's own
# predef chain brings mixa_dir.h.lm1 transitively, so nothing new needed).
fn: t_dir_exists (const: @(char path)) int
    @: MixaDirEntry e
    int: st
    e: (cast: (@: MixaDirEntry) c.calloc(1U, c.sizeof(c.MixaDirEntry)))
    if: e = 0
        return: 0
    st: mixa_dir_stat(path, e)
    c.free(e)
    if: st = MIXA_DIR_OK
        return: 1
return: 0

int: g_alloc_calls
int: g_alloc_fail_at

fn: t_alloc (size_t: n) @: void
    g_alloc_calls: g_alloc_calls + 1
    if: g_alloc_fail_at >= 0
        if: g_alloc_calls > g_alloc_fail_at
            return: 0
        ---
    ---
return: c.malloc(n)

sub: t_free (@: void p)
    c.free(p)
end: t_free

@: MixaSelWalkAllocVTable g_av
int: g_av_ready

fn: t_av () const: @(MixaSelWalkAllocVTable)
    if: g_av_ready = 0
        g_av: (cast: (@: MixaSelWalkAllocVTable) c.calloc(1U, c.sizeof(c.MixaSelWalkAllocVTable)))
        g_av\alloc: t_alloc
        g_av\free: t_free
        g_av_ready: 1
    ---
return: g_av

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char root1 1040
    []: char suba 1040
    []: char subb 1040
    []: char subb_nested 1040
    []: char sibling 1040
    []: char root2 1040
    []: char keepme 1040
    []: char root3 1040
    []: char root3sub 1040
    []: char root4 1040
    []: char root4_ro 1040
    []: char root4_ok 1040
    []: char root5 1040
    []: char root5_locked 1040
    []: char rootc1 1040
    []: char rootc2 1040
    []: char p1 1200
    []: char cmd 2400
    @: MixaSelection sel
    const: @(MixaRemoveSink sink)
    int: rc
    int: failures
    int: checks
    c.setbuf((cast: (@: void) c.stdout), 0)
    failures: 0
    checks: 0

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    ---
    if: argc < 2
        c.snprintf(base, 520U, "build/mixa/claude/remove/tmp")
    ---

    sel: (cast: (@: MixaSelection) c.calloc(1U, c.sizeof(c.MixaSelection)))
    if: sel = 0
        c.printf("remove: alloc failed\n")
        return: 1
    ---
    checks: checks + 1
    if: mixa_selection_init(sel) != MIXA_SEL_OK
        failures: failures + 1
        c.printf("remove: selection init failed\n")
        return: 1
    ---
    sink: t_sink()

    # --- Scenario 1: real nested tree, postorder proof. root1/suba has
    # two files; root1/subb/nested has one file three levels deep; a
    # sibling OUTSIDE root1 must survive untouched.
    c.snprintf(root1, 1040U, "%s\\root1", base)
    c.snprintf(suba, 1040U, "%s\\a", root1)
    c.snprintf(subb, 1040U, "%s\\b", root1)
    c.snprintf(subb_nested, 1040U, "%s\\nested", subb)
    c.snprintf(sibling, 1040U, "%s\\sibling.txt", base)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", suba)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", subb_nested)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\a1.txt", suba)
    t_touch(p1, "a1")
    c.snprintf(p1, 1200U, "%s\\a2.txt", suba)
    t_touch(p1, "a2")
    c.snprintf(p1, 1200U, "%s\\deep.txt", subb_nested)
    t_touch(p1, "deep")
    t_touch(sibling, "sibling-content")

    mixa_selection_select(sel, root1)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    checks: checks + 1
    if: rc != MIXA_REMOVE_OK
        failures: failures + 1
        c.printf("remove: nested-tree run rc=%d trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: t_dir_exists(root1) != 0
        failures: failures + 1
        c.printf("remove: root1 still exists after removal\n")
    ---
    checks: checks + 1
    if: t_exists(sibling) = 0
        failures: failures + 1
        c.printf("remove: unrelated sibling was removed\n")
    ---
    # Postorder proof: every directory's own "E" (dir_done/removed) event
    # must come strictly AFTER every "F"/"E" event for its own children --
    # nested's own completion before b's, b's own before root1's.
    checks: checks + 1
    if: 1
        const: @(char p_nested)
        const: @(char p_b)
        const: @(char p_root1)
        p_nested: c.strstr(g_trace, "E:nested:0|")
        p_b: c.strstr(g_trace, "E:b:0|")
        p_root1: c.strstr(g_trace, "E:root1:0|")
        if: p_nested = 0 || p_b = 0 || p_root1 = 0 || p_nested >= p_b || p_b >= p_root1
            failures: failures + 1
            c.printf("remove: directories not removed strictly postorder: %s\n", g_trace)
        ---
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, root1) != 0
        failures: failures + 1
        c.printf("remove: fully-removed root was not deselected\n")
    ---

    # --- Scenario 2: an explicit exception under a selected root survives
    # completely untouched, AND the root's own rmdir genuinely fails
    # (real ERROR_DIR_NOT_EMPTY) because that excepted child is still
    # there -- a REAL directory-removal fault, not a synthetic one. The
    # root stays selected for retry; deleteme.txt is gone.
    c.snprintf(root2, 1040U, "%s\\root2", base)
    c.snprintf(keepme, 1040U, "%s\\keepme", root2)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", keepme)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\onlykeep.txt", keepme)
    t_touch(p1, "keep-content")
    c.snprintf(p1, 1200U, "%s\\deleteme.txt", root2)
    t_touch(p1, "delete-content")
    mixa_selection_select(sel, root2)
    mixa_selection_deselect(sel, keepme)
    checks: checks + 1
    if: mixa_selection_query(sel, keepme) != 0
        failures: failures + 1
        c.printf("remove: keepme unexpectedly still reads as selected before the run\n")
    ---
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    checks: checks + 1
    if: rc != MIXA_REMOVE_OK
        failures: failures + 1
        c.printf("remove: exception-scenario run rc=%d (per-node status, not aborted) trace=%s\n", rc, g_trace)
    ---
    c.snprintf(p1, 1200U, "%s\\onlykeep.txt", keepme)
    checks: checks + 1
    if: t_exists(p1) = 0
        failures: failures + 1
        c.printf("remove: excepted file was removed\n")
    ---
    checks: checks + 1
    if: t_dir_exists(keepme) = 0
        failures: failures + 1
        c.printf("remove: excepted directory was removed\n")
    ---
    c.snprintf(p1, 1200U, "%s\\deleteme.txt", root2)
    checks: checks + 1
    if: t_exists(p1) != 0
        failures: failures + 1
        c.printf("remove: deleteme.txt was not removed\n")
    ---
    checks: checks + 1
    if: t_dir_exists(root2) = 0
        failures: failures + 1
        c.printf("remove: root2 itself was removed despite a surviving excepted child\n")
    ---
    checks: checks + 1
    if: t_count("E:root2:203|") != 1
        failures: failures + 1
        c.printf("remove: root2's own rmdir did not report the exact real IO failure: %s\n", g_trace)
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, root2) != 1
        failures: failures + 1
        c.printf("remove: root2 was wrongly deselected despite the surviving excepted child\n")
    ---
    mixa_selection_deselect(sel, root2)
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul", root2)
    c.system(cmd)

    # --- Scenario 3: nested selected roots are consolidated and processed
    # ONCE. Selecting both root3 and root3\\sub explicitly must not cause
    # sub to be walked as a second, independent root (no double-removal,
    # no crash on an already-gone path); the end state is simply "all
    # gone, root3 deselected".
    c.snprintf(root3, 1040U, "%s\\root3", base)
    c.snprintf(root3sub, 1040U, "%s\\sub", root3)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root3sub)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\x.txt", root3sub)
    t_touch(p1, "x")
    mixa_selection_select(sel, root3)
    mixa_selection_select(sel, root3sub)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    checks: checks + 1
    if: rc != MIXA_REMOVE_OK
        failures: failures + 1
        c.printf("remove: nested-root consolidation run rc=%d trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: t_dir_exists(root3) != 0
        failures: failures + 1
        c.printf("remove: root3 (with a nested selected sub) still exists\n")
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, root3) != 0 || mixa_selection_query(sel, root3sub) != 0
        failures: failures + 1
        c.printf("remove: nested-root consolidation left a stale selection entry\n")
    ---
    # Exactly one dir_done event for root3 itself -- not visited twice.
    checks: checks + 1
    if: t_count("E:root3:0|") != 1
        failures: failures + 1
        c.printf("remove: root3 was processed more than once (or not at all): %s\n", g_trace)
    ---

    # --- Scenario 4: a REAL file-removal fault. Mark one file read-only
    # (a genuine Win32 DeleteFileW refusal, not a synthetic hook) inside
    # an otherwise-removable root; the sink continues past it (its own
    # return value, matching mixa_copy's on_file asymmetry), so the OTHER
    # sibling file still gets removed and the failure is reported with
    # the exact real status on exactly the failing path. The root stays
    # selected because it did not finish cleanly.
    c.snprintf(root4, 1040U, "%s\\root4", base)
    c.snprintf(root4_ro, 1040U, "%s\\locked.txt", root4)
    c.snprintf(root4_ok, 1040U, "%s\\ok.txt", root4)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root4)
    c.system(cmd)
    t_touch(root4_ro, "locked-content")
    t_touch(root4_ok, "ok-content")
    c.snprintf(cmd, 2400U, "cmd /c attrib +r \"%s\"", root4_ro)
    c.system(cmd)
    mixa_selection_select(sel, root4)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    checks: checks + 1
    if: rc != MIXA_REMOVE_OK
        failures: failures + 1
        c.printf("remove: real file-removal-fault run rc=%d (sink continues past it) trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: t_count("F:locked.txt:203|") != 1
        failures: failures + 1
        c.printf("remove: read-only file did not report the exact real IO failure: %s\n", g_trace)
    ---
    checks: checks + 1
    if: t_exists(root4_ok) != 0
        failures: failures + 1
        c.printf("remove: the OTHER, unaffected sibling file was not removed\n")
    ---
    checks: checks + 1
    if: t_exists(root4_ro) = 0
        failures: failures + 1
        c.printf("remove: the read-only file was removed despite the real OS refusal\n")
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, root4) != 1
        failures: failures + 1
        c.printf("remove: root4 was wrongly deselected despite a real file failure under it\n")
    ---
    # Clear the attribute and retry: everything finishes and deselects.
    c.snprintf(cmd, 2400U, "cmd /c attrib -r \"%s\"", root4_ro)
    c.system(cmd)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    checks: checks + 1
    if: rc != MIXA_REMOVE_OK
        failures: failures + 1
        c.printf("remove: retry after clearing read-only rc=%d trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: t_dir_exists(root4) != 0
        failures: failures + 1
        c.printf("remove: root4 still exists after the successful retry\n")
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, root4) != 0
        failures: failures + 1
        c.printf("remove: root4 not deselected once the retry actually finished it\n")
    ---

    # --- Scenario 5: a REAL enumeration fault. Deny list/read access on a
    # nested subdirectory so the walk's own real Win32 FindFirstFileW
    # call inside it genuinely fails; this module propagates that
    # walk-domain status VERBATIM (MIXA_SEL_WALK_ERR_ACCESS, not one of
    # this module's own MIXA_REMOVE_ERR_* codes) rather than remapping or
    # swallowing it. The root stays selected (on_dir_done for it, and for
    # every ancestor already entered, never fires once the walk itself
    # aborts structurally).
    c.snprintf(root5, 1040U, "%s\\root5", base)
    c.snprintf(root5_locked, 1040U, "%s\\locked", root5)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root5_locked)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\inside.txt", root5_locked)
    t_touch(p1, "inside")
    c.snprintf(cmd, 2400U, "cmd /c icacls \"%s\" /deny \"%%USERNAME%%\":(RD,REA) >nul 2>nul", root5_locked)
    c.system(cmd)
    mixa_selection_select(sel, root5)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    checks: checks + 1
    if: rc != MIXA_SEL_WALK_ERR_ACCESS
        c.printf("remove: enumeration-fault rc=%d (icacls deny may be ineffective in this environment; see report) trace=%s\n", rc, g_trace)
    else:
        checks: checks + 1
        if: mixa_selection_query(sel, root5) != 1
            failures: failures + 1
            c.printf("remove: root5 was wrongly deselected despite a real enumeration failure under it\n")
        ---
    ---
    c.snprintf(cmd, 2400U, "cmd /c icacls \"%s\" /reset >nul 2>nul", root5_locked)
    c.system(cmd)
    mixa_selection_deselect(sel, root5)
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul", root5)
    c.system(cmd)

    # --- Scenario 6: a deterministic ALLOCATION fault, injected through
    # the walk's own optional MixaSelWalkAllocVTable (forwarded verbatim
    # by mixa_remove_selected_run, unlike mixa_copy_run's own deliberate
    # omission of it) -- proves this module's status/retry contract holds
    # under a walk-internal allocation failure too, not only a real
    # filesystem one.
    c.snprintf(rootc1, 1040U, "%s\\rootc1", base)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", rootc1)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\y.txt", rootc1)
    t_touch(p1, "y")
    mixa_selection_select(sel, rootc1)
    t_reset()
    g_alloc_calls: 0
    g_alloc_fail_at: 0
    rc: mixa_remove_selected_run(sel, sink, t_av())
    checks: checks + 1
    if: rc != MIXA_SEL_WALK_ERR_NOMEM
        failures: failures + 1
        c.printf("remove: allocation-fault rc=%d want MIXA_SEL_WALK_ERR_NOMEM trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, rootc1) != 1
        failures: failures + 1
        c.printf("remove: rootc1 was wrongly deselected despite an allocation failure\n")
    ---
    checks: checks + 1
    if: t_dir_exists(rootc1) = 0
        failures: failures + 1
        c.printf("remove: rootc1 itself vanished despite an allocation failure aborting the walk\n")
    ---
    g_alloc_fail_at: -1
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, t_av())
    checks: checks + 1
    if: rc != MIXA_REMOVE_OK
        failures: failures + 1
        c.printf("remove: retry after allocation fault lifted rc=%d\n", rc)
    ---
    checks: checks + 1
    if: t_dir_exists(rootc1) != 0
        failures: failures + 1
        c.printf("remove: rootc1 still exists after the successful retry\n")
    ---

    # --- Scenario 7: cancellation between roots. Two independent roots
    # selected; the sink returns STOP right after the FIRST root's own
    # completion event, before the second root is ever entered. The
    # already-finished first root must be deselected (its success is not
    # relabeled a failure just because the OVERALL run is cancelled), and
    # the untouched second root must stay selected.
    c.snprintf(rootc1, 1040U, "%s\\cancelA", base)
    c.snprintf(rootc2, 1040U, "%s\\cancelB", base)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", rootc1)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", rootc2)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\z1.txt", rootc1)
    t_touch(p1, "z1")
    c.snprintf(p1, 1200U, "%s\\z2.txt", rootc2)
    t_touch(p1, "z2")
    mixa_selection_select(sel, rootc1)
    mixa_selection_select(sel, rootc2)
    t_reset()
    g_fail_at_call: 2
    g_fail_status: MIXA_SEL_WALK_STOP
    rc: mixa_remove_selected_run(sel, sink, 0)
    checks: checks + 1
    if: rc != MIXA_REMOVE_CANCELLED
        failures: failures + 1
        c.printf("remove: cancel-between-roots rc=%d want CANCELLED trace=%s\n", rc, g_trace)
    ---
    # Exactly one of the two roots finished before cancellation (mixa_
    # selection_walk's own root iteration order is not this test's own
    # contract to assert -- only that ONE finished and ONE did not).
    checks: checks + 1
    if: 1
        int: a_gone
        int: b_gone
        a_gone: 0
        if: t_dir_exists(rootc1) = 0
            a_gone: 1
        ---
        b_gone: 0
        if: t_dir_exists(rootc2) = 0
            b_gone: 1
        ---
        if: (a_gone + b_gone) != 1
            failures: failures + 1
            c.printf("remove: expected exactly one root to finish before cancellation, got a_gone=%d b_gone=%d\n", a_gone, b_gone)
        ---
        if: a_gone != 0
            checks: checks + 1
            if: mixa_selection_query(sel, rootc1) != 0
                failures: failures + 1
                c.printf("remove: finished-then-cancelled root A was not deselected\n")
            ---
            checks: checks + 1
            if: mixa_selection_query(sel, rootc2) != 1
                failures: failures + 1
                c.printf("remove: untouched root B lost its selection on cancellation\n")
            ---
        else:
            checks: checks + 1
            if: mixa_selection_query(sel, rootc2) != 0
                failures: failures + 1
                c.printf("remove: finished-then-cancelled root B was not deselected\n")
            ---
            checks: checks + 1
            if: mixa_selection_query(sel, rootc1) != 1
                failures: failures + 1
                c.printf("remove: untouched root A lost its selection on cancellation\n")
            ---
        ---
    ---
    mixa_selection_deselect(sel, rootc1)
    mixa_selection_deselect(sel, rootc2)
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul", rootc1)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul", rootc2)
    c.system(cmd)

    # --- Scenario 8: a real, ordinary Unicode (Cyrillic) file name round-
    # trips through selection and removal using the existing seam, no
    # special-casing anywhere in this module.
    c.snprintf(root1, 1040U, "%s\\root_uni", base)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root1)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\\xd0\xbf\xd1\x80\xd0\xb8\xd0\xb2\xd0\xb5\xd1\x82.txt", root1)
    t_touch(p1, "unicode-content")
    mixa_selection_select(sel, root1)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    checks: checks + 1
    if: rc != MIXA_REMOVE_OK
        failures: failures + 1
        c.printf("remove: unicode-name run rc=%d trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: t_dir_exists(root1) != 0
        failures: failures + 1
        c.printf("remove: unicode-named file/dir was not fully removed\n")
    ---

    # --- Scenario 9: argument negatives.
    checks: checks + 1
    if: mixa_remove_selected_run(0, sink, 0) != MIXA_REMOVE_ERR_ARG
        failures: failures + 1
        c.printf("remove: null selection not ERR_ARG\n")
    ---
    checks: checks + 1
    if: mixa_remove_selected_run(sel, 0, 0) != MIXA_REMOVE_ERR_ARG
        failures: failures + 1
        c.printf("remove: null sink not ERR_ARG\n")
    ---
    # An empty selection removes nothing and succeeds trivially.
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    t_reset()
    rc: mixa_remove_selected_run(sel, sink, 0)
    checks: checks + 1
    if: rc != MIXA_REMOVE_OK || g_calls != 0
        failures: failures + 1
        c.printf("remove: empty selection rc=%d calls=%d\n", rc, g_calls)
    ---

    mixa_selection_release(sel)
    c.free(sel)

    if: failures = 0
        c.printf("remove selftest: %d checks, 0 failures\n", checks)
    else:
        c.printf("remove selftest: %d checks, %d failures\n", checks, failures)
    ---
return: failures
