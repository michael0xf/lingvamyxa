predef: "mixa_manager/mixa_fm_remove_l2.h.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

fn: mixa_fm_remove_selected (@: MixaFm fm; const: @(MixaRemoveSink sink)) int

# Real L1-vs-L2 parity harness for mixa_fm_remove (ticket 20260913-
# 161000). ONE harness source, compiled/linked twice (oracle/L2),
# "declare then link" -- mixa_fm_remove_selected's own real body comes
# from either the unchanged mixa_fm_remove.lm1 (oracle side) or the
# generated mixa_fm_remove.lm2 (L2 side). Every other function called
# here (mixa_fm_init/_release/_select/_count/_name/_refresh, mixa_
# selection_init/_release/_query) is a real plain-C-header function
# already visible via the L2 header's own predef chain (mixa_file_
# manager.h.lm1's own `include: mixa_manager/mixa_selection.h` line) --
# no forward declare needed for any of them (the established "no-
# forward-declare-needed for plain-C-header functions" pattern), and
# their real bodies are linked from the real, separately-linked mixa_
# file_manager.o/mixa_selection.o/mixa_dir_win32.o objects.
#
# Scenario coverage is drawn directly from the existing, already-
# accepted mixa_fm_remove_selftest.lm1: select a real file and a real
# directory (with its own real nested content) through real FM
# indices, remove them, and prove BOTH the disk state and the FM's own
# view (unconditionally refreshed, per mixa_fm_remove.h.lm1's own
# documented "no single destination to compare against" rationale) --
# the deleted entries are gone from the next listing with no manual
# refresh call, the untouched sibling survives both on disk and in the
# listing, and the completed selections are drained. Plus argument
# negatives and an empty-selection no-op that still refreshes.

fn: cb_file (@: void ctx; const: @(char path); int: is_dir; int: status) int
return: MIXA_SEL_WALK_GO

fn: cb_dir_done (@: void ctx; const: @(char path); int: is_dir; int: status) int
return: MIXA_SEL_WALK_GO

@: MixaRemoveSink g_sink
int: g_sink_ready

fn: t_sink () const: @(MixaRemoveSink)
    if: g_sink_ready = 0
        g_sink: (cast: (@: MixaRemoveSink) c.calloc(1U, c.sizeof(c.MixaRemoveSink)))
        g_sink\on_file: cb_file
        g_sink\on_dir_done: cb_dir_done
        g_sink_ready: 1
    ---
return: g_sink

@: MixaFmAllocVTable g_av
int: g_av_ready

fn: fm_alloc (size_t: n) @: void
return: c.malloc(n)

sub: fm_free (@: void p)
    c.free(p)
end: fm_free

fn: t_fm_table () const: @(MixaFmAllocVTable)
    if: g_av_ready = 0
        g_av: (cast: (@: MixaFmAllocVTable) c.calloc(1U, c.sizeof(c.MixaFmAllocVTable)))
        g_av\alloc: fm_alloc
        g_av\free: fm_free
        g_av_ready: 1
    ---
return: g_av

fn: t_index_of (@: MixaFm fm; const: @(char name)) int
    size_t: i
    const: @(char nm)
    i: 0U
    while: i < mixa_fm_count(fm)
        nm: mixa_fm_name(fm, i)
        if: nm != 0
            if: c.strcmp(nm, name) = 0
                return: (cast: (int) i)
            ---
        ---
        i: i + 1U
    ---
return: -1

sub: t_touch (const: @(char path); const: @(char content))
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "wb")
    if: fh[0] != 0
        c.fputs(content, fh[0])
        c.fclose(fh[0])
    ---
end: t_touch

fn: t_exists (const: @(char path)) int
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "rb")
    if: fh[0] = 0
        return: 0
    ---
    c.fclose(fh[0])
return: 1

[]: int g_failures 1

sub: t_check_int (const: @(char label); int: got; int: want)
    if: got != want
        c.printf("CHK %s got=%d want=%d FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%d want=%d PASS\n", label, got, want)
end: t_check_int

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char root 1040
    []: char subdir 1040
    []: char single_file 1040
    []: char keep_file 1040
    []: char p1 1200
    []: char cmd 2400
    @: MixaFm fm
    @: MixaSelection sel
    const: @(MixaRemoveSink sink)
    int: rc
    int: idx
    c.setbuf((cast: (@: void) c.stdout), 0)

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    else:
        c.snprintf(base, 520U, "build/mixa/claude/fm_remove_parity/tmp")
    ---
    c.snprintf(root, 1040U, "%s\\root", base)
    c.snprintf(subdir, 1040U, "%s\\gonedir", root)
    c.snprintf(single_file, 1040U, "%s\\gone.txt", root)
    c.snprintf(keep_file, 1040U, "%s\\keep.txt", root)

    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", subdir)
    c.system(cmd)
    t_touch(single_file, "gone-content")
    t_touch(keep_file, "keep-content")
    c.snprintf(p1, 1200U, "%s\\inner.txt", subdir)
    t_touch(p1, "inner-content")

    sel: (cast: (@: MixaSelection) c.calloc(1U, c.sizeof(c.MixaSelection)))
    fm: (cast: (@: MixaFm) c.calloc(1U, c.sizeof(c.MixaFm)))
    if: sel = 0 || fm = 0
        c.printf("fm_remove parity: alloc failed\n")
        return: 1
    ---
    t_check_int("selection init", mixa_selection_init(sel), MIXA_SEL_OK)
    t_check_int("fm init", mixa_fm_init(fm, root, sel, t_fm_table()), MIXA_FM_OK)
    sink: t_sink()

    # --- select a real file and a real directory through real FM
    # indices, remove them, prove disk + unconditionally-refreshed view. ---
    idx: t_index_of(fm, "gone.txt")
    t_check_int("gone.txt found", (cast: (int) (idx >= 0)), 1)
    t_check_int("select gone.txt", mixa_fm_select(fm, (cast: (size_t) idx), 1), MIXA_FM_OK)
    idx: t_index_of(fm, "gonedir")
    t_check_int("gonedir found", (cast: (int) (idx >= 0)), 1)
    t_check_int("select gonedir", mixa_fm_select(fm, (cast: (size_t) idx), 1), MIXA_FM_OK)

    rc: mixa_fm_remove_selected(fm, sink)
    t_check_int("remove rc", rc, MIXA_REMOVE_OK)
    t_check_int("gone.txt off disk", t_exists(single_file), 0)
    c.snprintf(p1, 1200U, "%s\\inner.txt", subdir)
    t_check_int("gonedir content off disk", t_exists(p1), 0)
    t_check_int("keep.txt still on disk", t_exists(keep_file), 1)
    t_check_int("gone.txt not in view", (cast: (int) (t_index_of(fm, "gone.txt") >= 0)), 0)
    t_check_int("gonedir not in view", (cast: (int) (t_index_of(fm, "gonedir") >= 0)), 0)
    t_check_int("keep.txt still in view", (cast: (int) (t_index_of(fm, "keep.txt") >= 0)), 1)
    t_check_int("gone.txt selection drained", mixa_selection_query(sel, single_file), 0)
    t_check_int("gonedir selection drained", mixa_selection_query(sel, subdir), 0)

    # --- argument negatives ---
    t_check_int("null fm", mixa_fm_remove_selected(0, sink), MIXA_REMOVE_ERR_ARG)
    t_check_int("null sink", mixa_fm_remove_selected(fm, 0), MIXA_REMOVE_ERR_ARG)

    # --- empty selection: trivial success, still refreshes unconditionally. ---
    rc: mixa_fm_remove_selected(fm, sink)
    t_check_int("empty selection rc", rc, MIXA_REMOVE_OK)
    t_check_int("keep.txt survives empty-selection refresh", (cast: (int) (t_index_of(fm, "keep.txt") >= 0)), 1)

    mixa_selection_release(sel)
    mixa_fm_release(fm)
    c.free(sel)
    c.free(fm)

    if: g_failures[0] != 0
        c.printf("mixa fm remove parity harness FAILED checks=%d\n", g_failures[0])
        return: 1
    c.printf("mixa fm remove parity harness ok\n")
return: 0
