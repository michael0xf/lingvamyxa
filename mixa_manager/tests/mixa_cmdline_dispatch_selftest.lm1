predef: "mixa_manager/mixa_process_marker.lm1"
predef: "mixa_manager/mixa_process_win32.lm1"
predef: "mixa_manager/mixa_cmdline_dispatch.lm1"
predef: "mixa_manager/mixa_file_win32.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>" "<windows.h>"

# Enter dispatch focused selftest (ticket 20260913-002013). REAL spawned
# children through the accepted process/process-marker seams, a REAL
# file-backed console -- no window, no app loop, no keyboard. Proves the
# exact console bytes a real command produces, exit-code/cwd recovery,
# a spawn failure, and that release() while still running does not hang
# (PROCESS_SEAM's own "kill and mean it").
#
# predef's mixa_process_win32.h/.lm1 directly (not just mixa_process.h)
# because this file needs mixa_process_spawn's own real implementation
# linked into the SAME translation unit for a single-file build (this
# runner translates one file, unlike run_app_loop_selftest.ps1's own
# multi-object link) -- matching mixa_process_marker_selftest.lm1's own
# established predef shape exactly.

fn: t_read_whole (const: @(char path); @: char out_buf; size_t: cap; @: size_t out_len) int
    @: MixaFile f
    size_t: got
    if: mixa_file_open(@ f, path, MIXA_FILE_MODE_READ) != MIXA_FILE_OK
        return: 1
    ---
    got: 0U
    if: mixa_file_read(f, out_buf, cap, @ got) != MIXA_FILE_OK
        mixa_file_close(f)
        return: 1
    ---
    mixa_file_close(f)
    out_len[0]: got
return: 0

fn: t_run_to_done (@: MixaCmdDispatch d; @: int out_exit; @@: char out_cwd) int
    int: rc
    int: i
    rc: MIXA_CMD_DISPATCH_RUNNING
    i: 0
    while: i < 500 && rc = MIXA_CMD_DISPATCH_RUNNING
        rc: mixa_cmd_dispatch_poll(d, out_exit, out_cwd)
        if: rc = MIXA_CMD_DISPATCH_RUNNING
            c.Sleep(10U)
        ---
        i: i + 1
    ---
return: rc

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char console_path 600
    @: MixaFile cf
    @: MixaCmdDispatch d
    []: int exit_slot 1
    []: (@: char) cwd_slot 1
    int: rc
    int: failures
    int: checks
    []: size_t got_len 1
    []: char readbuf 8192
    c.setbuf((cast: (@: void) c.stdout), 0)
    failures: 0
    checks: 0
    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    else:
        c.snprintf(base, 520U, "build/mixa/claude/cmdline_dispatch/tmp")
    ---
    c.snprintf(console_path, 600U, "%s\\dispatch_console.log", base)
    c.remove(console_path)

    # --- Scenario 1: a real, fast, successful command. Exact console
    # bytes checked: the echoed command line, then the command's own
    # real output, with NO marker text ever leaking into the file (the
    # scanner consumes the marker record itself; only ordinary bytes
    # reach console_file).
    if: mixa_file_open(@ cf, console_path, MIXA_FILE_MODE_APPEND) != MIXA_FILE_OK
        c.printf("dispatch: scenario1 could not create fixture file\n")
        return: 1
    ---
    d: 0
    rc: mixa_cmd_dispatch_start("echo hello-from-dispatch", base, cf, @ d)
    checks: checks + 1
    if: rc != MIXA_CMD_DISPATCH_OK || d = 0
        failures: failures + 1
        c.printf("dispatch: scenario1 start rc=%d\n", rc)
    ---
    checks: checks + 1
    if: mixa_cmd_dispatch_running(d) = 0
        failures: failures + 1
        c.printf("dispatch: scenario1 should be running right after start\n")
    ---
    exit_slot[0]: -999
    cwd_slot[0]: 0
    rc: t_run_to_done(d, exit_slot, cwd_slot)
    checks: checks + 1
    if: rc != MIXA_CMD_DISPATCH_DONE
        failures: failures + 1
        c.printf("dispatch: scenario1 did not complete, rc=%d\n", rc)
    ---
    checks: checks + 1
    if: exit_slot[0] != 0
        failures: failures + 1
        c.printf("dispatch: scenario1 exit_code=%d want 0\n", exit_slot[0])
    ---
    checks: checks + 1
    if: cwd_slot[0] = 0
        failures: failures + 1
        c.printf("dispatch: scenario1 new_cwd should be recovered, got null\n")
    ---
    checks: checks + 1
    if: mixa_cmd_dispatch_running(d) != 0
        failures: failures + 1
        c.printf("dispatch: scenario1 should report not-running after DONE\n")
    ---
    mixa_file_close(cf)
    got_len[0]: 0U
    if: t_read_whole(console_path, readbuf, 8192U, got_len) != 0
        failures: failures + 1
        c.printf("dispatch: scenario1 could not read back the console file\n")
    else:
        readbuf[got_len[0]]: 0
        checks: checks + 1
        if: c.strstr(readbuf, "echo hello-from-dispatch") = 0
            failures: failures + 1
            c.printf("dispatch: scenario1 echoed command missing from console: [%s]\n", readbuf)
        ---
        checks: checks + 1
        if: c.strstr(readbuf, "hello-from-dispatch") = 0
            failures: failures + 1
            c.printf("dispatch: scenario1 real command output missing from console: [%s]\n", readbuf)
        ---
        checks: checks + 1
        if: c.strstr(readbuf, "MIXA_MARK_") != 0
            failures: failures + 1
            c.printf("dispatch: scenario1 marker text leaked into the console file: [%s]\n", readbuf)
        ---
    ---
    if: cwd_slot[0] != 0
        c.free(cwd_slot[0])
    ---
    mixa_cmd_dispatch_release(d)

    # --- Scenario 2: a real nonzero exit code, recovered exactly.
    c.remove(console_path)
    if: mixa_file_open(@ cf, console_path, MIXA_FILE_MODE_APPEND) != MIXA_FILE_OK
        c.printf("dispatch: scenario2 could not create fixture file\n")
        return: 1
    ---
    d: 0
    rc: mixa_cmd_dispatch_start("cmd /c exit /b 9", base, cf, @ d)
    checks: checks + 1
    if: rc != MIXA_CMD_DISPATCH_OK || d = 0
        failures: failures + 1
        c.printf("dispatch: scenario2 start rc=%d\n", rc)
    ---
    exit_slot[0]: -999
    cwd_slot[0]: 0
    rc: t_run_to_done(d, exit_slot, cwd_slot)
    checks: checks + 1
    if: rc != MIXA_CMD_DISPATCH_DONE || exit_slot[0] != 9
        failures: failures + 1
        c.printf("dispatch: scenario2 rc=%d exit_code=%d want DONE/9\n", rc, exit_slot[0])
    ---
    mixa_file_close(cf)
    if: cwd_slot[0] != 0
        c.free(cwd_slot[0])
    ---
    mixa_cmd_dispatch_release(d)

    # --- Scenario 3: poll() after DONE is idempotent -- same status,
    # no re-read, no crash.
    c.remove(console_path)
    if: mixa_file_open(@ cf, console_path, MIXA_FILE_MODE_APPEND) != MIXA_FILE_OK
        c.printf("dispatch: scenario3 could not create fixture file\n")
        return: 1
    ---
    d: 0
    mixa_cmd_dispatch_start("echo idempotent-check", base, cf, @ d)
    exit_slot[0]: -999
    cwd_slot[0]: 0
    t_run_to_done(d, exit_slot, cwd_slot)
    if: cwd_slot[0] != 0
        c.free(cwd_slot[0])
    ---
    exit_slot[0]: -999
    cwd_slot[0]: (cast: (@: char) 1)
    rc: mixa_cmd_dispatch_poll(d, exit_slot, cwd_slot)
    checks: checks + 1
    if: rc != MIXA_CMD_DISPATCH_DONE || exit_slot[0] != 0
        failures: failures + 1
        c.printf("dispatch: scenario3 poll-after-done rc=%d exit=%d want DONE/0\n", rc, exit_slot[0])
    ---
    checks: checks + 1
    if: cwd_slot[0] != 0
        failures: failures + 1
        c.printf("dispatch: scenario3 poll-after-done should set out_new_cwd to null (already consumed)\n")
    ---
    mixa_file_close(cf)
    mixa_cmd_dispatch_release(d)

    # --- Scenario 4: a spawn failure (invalid working directory) -- *out
    # stays null, nothing was echoed to the console (spawn never
    # succeeded, so no command is "real and running" to echo for).
    c.remove(console_path)
    if: mixa_file_open(@ cf, console_path, MIXA_FILE_MODE_APPEND) != MIXA_FILE_OK
        c.printf("dispatch: scenario4 could not create fixture file\n")
        return: 1
    ---
    d: (cast: (@: MixaCmdDispatch) 1)
    rc: mixa_cmd_dispatch_start("echo unreachable", "Z:\\definitely\\not\\a\\real\\path\\at\\all", cf, @ d)
    checks: checks + 1
    if: rc != MIXA_CMD_DISPATCH_ERR_SPAWN
        failures: failures + 1
        c.printf("dispatch: scenario4 rc=%d want ERR_SPAWN\n", rc)
    ---
    checks: checks + 1
    if: d != 0
        failures: failures + 1
        c.printf("dispatch: scenario4 *out should be null on a spawn failure\n")
    ---
    mixa_file_close(cf)
    got_len[0]: 0U
    if: t_read_whole(console_path, readbuf, 8192U, got_len) != 0
        failures: failures + 1
        c.printf("dispatch: scenario4 could not read back the console file\n")
    else:
        checks: checks + 1
        if: got_len[0] != 0U
            failures: failures + 1
            c.printf("dispatch: scenario4 a spawn failure should echo nothing, wrote %zu bytes\n", got_len[0])
        ---
    ---

    # --- Scenario 5: release() on a STILL-RUNNING command does not hang
    # and does not crash (PROCESS_SEAM "kill and mean it"). A real,
    # genuinely long-lived child (ping loop) started, released almost
    # immediately, with a bounded wall-clock check that release()
    # returned promptly rather than blocking on the child's own full
    # duration.
    c.remove(console_path)
    if: mixa_file_open(@ cf, console_path, MIXA_FILE_MODE_APPEND) != MIXA_FILE_OK
        c.printf("dispatch: scenario5 could not create fixture file\n")
        return: 1
    ---
    d: 0
    rc: mixa_cmd_dispatch_start("ping -n 30 127.0.0.1 >nul", base, cf, @ d)
    checks: checks + 1
    if: rc != MIXA_CMD_DISPATCH_OK || d = 0
        failures: failures + 1
        c.printf("dispatch: scenario5 start rc=%d\n", rc)
    else:
        checks: checks + 1
        if: mixa_cmd_dispatch_running(d) = 0
            failures: failures + 1
            c.printf("dispatch: scenario5 the ping loop should still be running\n")
        ---
        mixa_cmd_dispatch_release(d)
        checks: checks + 1
        c.printf("dispatch: scenario5 release() on a running command returned (checked by reaching this line, not a 30-second wait)\n")
    ---
    mixa_file_close(cf)

    # --- Scenario 6: argument negatives.
    checks: checks + 1
    if: mixa_cmd_dispatch_start(0, base, cf, @ d) != MIXA_CMD_DISPATCH_ERR_ARG
        failures: failures + 1
        c.printf("dispatch: start(0,...) not ERR_ARG\n")
    ---
    checks: checks + 1
    if: mixa_cmd_dispatch_poll(0, 0, 0) != MIXA_CMD_DISPATCH_ERR_ARG
        failures: failures + 1
        c.printf("dispatch: poll(0,...) not ERR_ARG\n")
    ---
    checks: checks + 1
    if: mixa_cmd_dispatch_running(0) != 0
        failures: failures + 1
        c.printf("dispatch: running(0) not 0\n")
    ---
    mixa_cmd_dispatch_release(0)
    checks: checks + 1
    c.printf("dispatch: release(0) did not crash (checked by reaching this line)\n")

    if: failures = 0
        c.printf("cmdline dispatch selftest: %d checks, 0 failures\n", checks)
    else:
        c.printf("cmdline dispatch selftest: %d checks, %d failures\n", checks, failures)
    ---
return: failures
