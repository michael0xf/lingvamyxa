predef: "mixa_manager/mixa_backend_ctors_headless_l2.h.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# Real L1-vs-L2 parity harness for mixa_backend_ctors_headless (share-
# and-backends ticket 20260913-192700, the ctors pair, module 1 of 2:
# headless first, then win32). ONE harness source, compiled/linked
# twice (oracle/L2), linked against the real mixa_backend_headless
# object (and its own mixa_event_fifo dependency) since this module's
# own real body calls mixa_backend_headless_table directly. No
# dedicated selftest exists for this tiny per-build constructor list
# alone -- it is exercised indirectly every time run_mixa.ps1's own
# regression sweep links a headless-only build (mixa_backend_table_
# selftest.lm1 and others already cover mixa_backend_tables() pulling
# from this exact registry). This harness exercises its own real
# contract directly: count() reports exactly 1, get(0) returns the
# real headless table (the SAME pointer mixa_backend_headless_table()
# itself returns, not a copy), and every out-of-range index returns
# null.

fn: mixa_backend_ctors_count () size_t
fn: mixa_backend_ctors_get (size_t: i) const: @(MixaBackendVTable)
fn: mixa_backend_headless_table () const: @(MixaBackendVTable)

[]: int g_failures 1

sub: t_check_int (const: @(char label); int: got; int: want)
    if: got != want
        c.printf("CHK %s got=%d want=%d FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%d want=%d PASS\n", label, got, want)
end: t_check_int

fn: main () int
    const: @(MixaBackendVTable headless_t)
    const: @(MixaBackendVTable got0)
    c.setbuf((cast: (@: void) c.stdout), 0)

    t_check_int("S1 count is 1", (cast: (int) mixa_backend_ctors_count()), 1)

    headless_t: mixa_backend_headless_table()
    got0: mixa_backend_ctors_get(0U)
    t_check_int("S2 get(0) matches headless table", (cast: (int) (got0 = headless_t)), 1)
    t_check_int("S2 get(0) non-null", (cast: (int) (got0 != 0)), 1)

    t_check_int("S3 get(1) out of range is null", (cast: (int) (mixa_backend_ctors_get(1U) = 0)), 1)
    t_check_int("S3 get(999) out of range is null", (cast: (int) (mixa_backend_ctors_get(999U) = 0)), 1)

    if: g_failures[0] != 0
        c.printf("mixa backend ctors headless parity harness FAILED checks=%d\n", g_failures[0])
        return: 1
    c.printf("mixa backend ctors headless parity harness ok\n")
return: 0
