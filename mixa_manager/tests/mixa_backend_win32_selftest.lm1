predef: "mixa_manager/mixa_backend_win32.lm1" "mixa_manager/mixa_composite.lm1" "mixa_manager/mixa_composite_glyphs.lm1" "mixa_manager/mixa_pump.lm1"
include: "<stdio.h>" "<string.h>"

# Win32 backend seam selftest. Drives input with PostMessage; window closes itself.

fn: mixa_win32_drain (@: MixaBackend be; @: MixaEvent got; int: maxn) int
    int: i
    int: rc
    i: 0
    while: i < maxn
        rc: mixa_backend_poll(be, got)
        if: got\kind = MIXA_EVENT_NONE
            return: 0
        ---
        i: i + 1
    ---
return: 1

fn: main () int
    @: MixaBackend be
    @: MixaTextRect rect
    @: MixaTextRect upper
    @: MixaEvent got
    @: MixaCellMetrics m
    @: MixaCell ucell
    @: MixaPump pump
    @: MixaU8 out
    @: MixaU8 first_bits
    @: MixaU8 old_bits
    []: MixaU8 pix 4
    []: MixaU8 shortbuf 4
    []: char clip_out 64
    []: char clip_tiny 4
    size_t: need
    size_t: i
    size_t: n
    size_t: old_bytes
    size_t: new_bytes
    size_t: px
    size_t: py
    int: failures
    int: rc
    size_t: tw
    size_t: th
    size_t: uw
    size_t: uh
    size_t: fw
    size_t: fh
    size_t: grow_cols
    size_t: grow_rows
    size_t: grow_px_w
    size_t: grow_px_h
    size_t: shrink_cols
    size_t: shrink_rows
    size_t: shrink_px_w
    size_t: shrink_px_h
    size_t: cov_n
    size_t: cov_i
    size_t: non_zero
    size_t: outside_hits
    @: MixaGlyph g1
    @: MixaGlyph g2
    @: MixaU8 gp
    size_t: gx
    size_t: gy
    failures: 0
    tw: 0U
    th: 0U
    uw: 0U
    uh: 0U

    be: (cast: (@: MixaBackend) c.calloc(1U, c.sizeof(c.MixaBackend)))
    rect: (cast: (@: MixaTextRect) c.calloc(1U, c.sizeof(c.MixaTextRect)))
    upper: (cast: (@: MixaTextRect) c.calloc(1U, c.sizeof(c.MixaTextRect)))
    got: (cast: (@: MixaEvent) c.calloc(1U, c.sizeof(c.MixaEvent)))
    pump: (cast: (@: MixaPump) c.calloc(1U, c.sizeof(c.MixaPump)))
    m: (cast: (@: MixaCellMetrics) c.calloc(1U, c.sizeof(c.MixaCellMetrics)))
    if: be = 0 || rect = 0 || upper = 0 || got = 0 || pump = 0 || m = 0
        c.printf("mixa win32: alloc failed\n")
        return: 1

    # --- open refusals ---
    if: mixa_backend_open(be, 3U, 2U, 0) = 0
        c.printf("mixa win32: open accepted null metrics\n")
        failures: failures + 1
    m\text_cell_width: 0U
    m\text_cell_height: 5U
    m\upper_cell_width: 8U
    m\upper_cell_height: 10U
    if: mixa_backend_open(be, 3U, 2U, m) = 0
        c.printf("mixa win32: open accepted zero text_cell_width\n")
        failures: failures + 1
    m\text_cell_width: 4U
    m\text_cell_height: 0U
    if: mixa_backend_open(be, 3U, 2U, m) = 0
        c.printf("mixa win32: open accepted zero text_cell_height\n")
        failures: failures + 1
    m\text_cell_height: 5U
    m\upper_cell_width: 0U
    if: mixa_backend_open(be, 3U, 2U, m) = 0
        c.printf("mixa win32: open accepted zero upper_cell_width\n")
        failures: failures + 1
    m\upper_cell_width: 8U
    m\upper_cell_height: 0U
    if: mixa_backend_open(be, 3U, 2U, m) = 0
        c.printf("mixa win32: open accepted zero upper_cell_height\n")
        failures: failures + 1
    m\upper_cell_height: 10U
    if: mixa_backend_open(be, 0U, 2U, m) = 0
        c.printf("mixa win32: open accepted zero cols\n")
        failures: failures + 1
    if: mixa_backend_open(be, 2U, 0U, m) = 0
        c.printf("mixa win32: open accepted zero rows\n")
        failures: failures + 1
    m\text_cell_width: 2U
    m\text_cell_height: 1U
    m\upper_cell_width: 2U
    m\upper_cell_height: 1U
    if: mixa_backend_open(be, ((cast: (size_t) -1) / 2U) + 1U, 1U, m) = 0
        c.printf("mixa win32: open accepted overflow dims\n")
        failures: failures + 1

    # Request absurd cells; Win32 must overwrite with the font's native metrics.
    m\text_cell_width: 4U
    m\text_cell_height: 5U
    m\upper_cell_width: 8U
    m\upper_cell_height: 10U
    if: mixa_backend_open(be, 3U, 2U, m) != 0
        c.printf("mixa win32: open 3x2 failed\n")
        return: 1
    tw: m\text_cell_width
    th: m\text_cell_height
    uw: m\upper_cell_width
    uh: m\upper_cell_height
    if: tw = 0U || th = 0U || uw = 0U || uh = 0U
        c.printf("mixa win32: open wrote zero metrics\n")
        return: 1
    if: tw = 4U && th = 5U && uw = 8U && uh = 10U
        c.printf("mixa win32: open still honoured requested metrics (expected font-native)\n")
        failures: failures + 1
    if: be\frame_w != (3U * tw) || be\frame_h != (2U * th) || be\frame_bytes != ((3U * tw) * (2U * th) * 4U)
        c.printf("mixa win32: open frame not derived from returned text cell fw=%u fh=%u tw=%u th=%u\n", (cast: (unsigned int) be\frame_w), (cast: (unsigned int) be\frame_h), (cast: (unsigned int) tw), (cast: (unsigned int) th))
        failures: failures + 1
    if: be\cell_width != tw || be\cell_height != th
        c.printf("mixa win32: backend cell_* != returned text metrics\n")
        failures: failures + 1
    if: be\hwnd = 0
        c.printf("mixa win32: open left hwnd null\n")
        failures: failures + 1

    # Drain create-time WM_SIZE and friends.
    if: mixa_win32_drain(be, got, 64) != 0
        c.printf("mixa win32: drain after open stuck\n")
        failures: failures + 1

    first_bits: be\bits
    m\text_cell_width: 4U
    m\text_cell_height: 5U
    m\upper_cell_width: 8U
    m\upper_cell_height: 10U
    rc: mixa_backend_open(be, 4U, 4U, m)
    if: rc = 0
        c.printf("mixa win32: re-open accepted\n")
        failures: failures + 1
    if: be\bits != first_bits
        c.printf("mixa win32: re-open replaced bits pointer\n")
        failures: failures + 1
    if: be\cols != 3U || be\rows != 2U
        c.printf("mixa win32: re-open changed geometry\n")
        failures: failures + 1

    # present short refused
    i: 0U
    while: i < 4U
        shortbuf[i]: (cast: (MixaU8) 7)
        i: i + 1U
    ---
    n: be\frame_bytes
    out: (cast: (@: MixaU8) c.malloc(n))
    if: out = 0
        c.printf("mixa win32: out alloc failed\n")
        return: 1
    i: 0U
    while: i < n
        out[i]: (cast: (MixaU8) 1)
        i: i + 1U
    ---
    if: mixa_backend_present(be, out, n) != 0
        c.printf("mixa win32: initial present failed\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, 0U, 0U, pix) != 0 || pix[0] != 1
        c.printf("mixa win32: frame_at pixel not 1 after present\n")
        failures: failures + 1
    rc: mixa_backend_present(be, shortbuf, 4U)
    if: rc = 0
        c.printf("mixa win32: present accepted short buffer\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, 0U, 0U, pix) != 0 || pix[0] != 1
        c.printf("mixa win32: short present still mutated frame\n")
        failures: failures + 1

    i: 0U
    while: i < n
        out[i]: (cast: (MixaU8) 2)
        i: i + 1U
    ---
    if: mixa_backend_present(be, out, n) != 0
        c.printf("mixa win32: second present failed\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, 0U, 0U, pix) != 0 || pix[0] != 2
        c.printf("mixa win32: second present did not replace\n")
        failures: failures + 1

    # poll empty
    if: mixa_backend_poll(be, got) != 0
        c.printf("mixa win32: poll empty returned error\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_NONE
        c.printf("mixa win32: poll empty not NONE\n")
        failures: failures + 1
    got\kind: MIXA_EVENT_KEY
    if: mixa_backend_poll(be, got) != 0 || got\kind != MIXA_EVENT_NONE
        c.printf("mixa win32: second empty poll stale or error\n")
        failures: failures + 1

    # clipboard UTF-8 round-trip
    if: mixa_backend_clipboard_set(be, "ok\xD0\xA9") != 0
        c.printf("mixa win32: clipboard_set failed\n")
        failures: failures + 1
    n: mixa_backend_clipboard_get(be, clip_out, 64U)
    if: n != 4U
        c.printf("mixa win32: clipboard_get length wrong (%u)\n", (cast: (unsigned int) n))
        failures: failures + 1
    if: c.strcmp(clip_out, "ok\xD0\xA9") != 0
        c.printf("mixa win32: clipboard UTF-8 mismatch\n")
        failures: failures + 1
    i: 0U
    while: i < 4U
        clip_tiny[i]: (cast: (char) 88)
        i: i + 1U
    ---
    n: mixa_backend_clipboard_get(be, clip_tiny, 4U)
    if: n != 4U
        c.printf("mixa win32: clipboard tiny did not return needed 4\n")
        failures: failures + 1
    if: clip_tiny[0] != 88 || clip_tiny[1] != 88 || clip_tiny[2] != 88 || clip_tiny[3] != 88
        c.printf("mixa win32: clipboard tiny wrote buffer\n")
        failures: failures + 1
    if: mixa_backend_clipboard_set(be, "") != 0
        c.printf("mixa win32: clipboard_set empty failed\n")
        failures: failures + 1
    n: mixa_backend_clipboard_get(be, clip_out, 64U)
    if: n != 0U
        c.printf("mixa win32: empty clipboard did not return 0\n")
        failures: failures + 1
    if: clip_out[0] != (cast: (char) 0)
        c.printf("mixa win32: empty clipboard did not write NUL\n")
        failures: failures + 1

    # --- e2e composite + present (STUB path: mixa_composite, no backend glyphs) ---
    mixa_backend_close(be)
    c.memset(be, 0, c.sizeof(c.MixaBackend))
    m\text_cell_width: 4U
    m\text_cell_height: 5U
    m\upper_cell_width: 8U
    m\upper_cell_height: 10U
    if: mixa_backend_open(be, 3U, 2U, m) != 0
        c.printf("mixa win32: reopen for e2e failed\n")
        return: 1
    tw: m\text_cell_width
    th: m\text_cell_height
    uw: m\upper_cell_width
    uh: m\upper_cell_height
    mixa_win32_drain(be, got, 64)
    if: mixa_rect_open(rect, 2U, 3U) != 0
        c.printf("mixa win32: text rect open failed\n")
        return: 1
    if: mixa_rect_open(upper, 2U, 3U) != 0
        c.printf("mixa win32: upper rect open failed\n")
        return: 1
    mixa_rect_fill(rect, 0U, 15U, 1U, 0U)
    mixa_rect_put_text(rect, 0U, 1U, "A", 15U, 1U, 0U)
    fw: 3U * tw
    fh: 2U * th
    need: fw * fh * 4U
    c.free(out)
    out: (cast: (@: MixaU8) c.malloc(need))
    if: out = 0
        c.printf("mixa win32: e2e out alloc failed\n")
        return: 1
    # Stub compositor still paints full-cell fg; cell size must match the frame.
    if: mixa_composite(rect, tw, th, upper, tw, th, out, need, fw, fh) != 0
        c.printf("mixa win32: composite clear failed\n")
        failures: failures + 1
    if: mixa_backend_present(be, out, need) != 0
        c.printf("mixa win32: e2e present failed\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, 0U, 0U, pix) != 0
        c.printf("mixa win32: e2e frame_at bg failed\n")
        failures: failures + 1
    if: pix[0] != 170 || pix[1] != 0 || pix[2] != 0 || pix[3] != 255
        c.printf("mixa win32: e2e bg not palette[1]\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, tw, 0U, pix) != 0
        c.printf("mixa win32: e2e frame_at glyph failed\n")
        failures: failures + 1
    if: pix[0] != 255 || pix[1] != 255 || pix[2] != 255 || pix[3] != 255
        c.printf("mixa win32: e2e glyph not palette[fg]\n")
        failures: failures + 1

    # opaque upper cell: palette[4]={0,0,170} (cell model has no raw RGB)
    c.memset(upper\cells, 0, upper\rows * upper\cols * c.sizeof(c.MixaCell))
    ucell: mixa_cell_at(upper, 0U, 1U)
    if: ucell = 0
        c.printf("mixa win32: upper cell_at failed\n")
        return: 1
    ucell\codepoint: 0U
    ucell\bg: 4U
    ucell\alpha: 255U
    if: mixa_composite(rect, tw, th, upper, tw, th, out, need, fw, fh) != 0
        c.printf("mixa win32: composite opaque failed\n")
        failures: failures + 1
    if: mixa_backend_present(be, out, need) != 0
        c.printf("mixa win32: opaque present failed\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, tw, 0U, pix) != 0
        c.printf("mixa win32: opaque frame_at failed\n")
        failures: failures + 1
    if: pix[0] != 0 || pix[1] != 0 || pix[2] != 170 || pix[3] != 255
        c.printf("mixa win32: opaque overlay did not cover glyph\n")
        failures: failures + 1

    # --- input via PostMessage ---
    # WM_CHAR 258 with codepoint 1041 (Cyrillic Be)
    c.PostMessageA(be\hwnd, 258U, 1041U, 0)
    if: mixa_backend_poll(be, got) != 0
        c.printf("mixa win32: poll text key failed\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_KEY || got\codepoint != 1041U || got\keycode != MIXA_KEY_NONE
        c.printf("mixa win32: text key fields wrong kind=%d cp=%u kc=%d\n", got\kind, got\codepoint, got\keycode)
        failures: failures + 1

    # WM_KEYDOWN 256 VK_F5=116
    c.PostMessageA(be\hwnd, 256U, 116U, 0)
    if: mixa_backend_poll(be, got) != 0
        c.printf("mixa win32: poll F5 failed\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_KEY || got\codepoint != 0U || got\keycode != MIXA_KEY_F5
        c.printf("mixa win32: F5 fields wrong\n")
        failures: failures + 1

    # mouse: pixel (0,0) and (4,0); WM_LBUTTONDOWN=513, MK_LBUTTON|MK_SHIFT = 1|4 = 5
    c.PostMessageA(be\hwnd, 513U, 5U, 0)
    if: mixa_backend_poll(be, got) != 0
        c.printf("mixa win32: poll mouse0 failed\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_MOUSE || got\col != 0U || got\row != 0U
        c.printf("mixa win32: mouse0 cell wrong\n")
        failures: failures + 1
    if: got\buttons != MIXA_BUTTON_LEFT
        c.printf("mixa win32: mouse0 buttons wrong\n")
        failures: failures + 1
    if: (got\modifiers & MIXA_MOD_SHIFT) = 0U
        c.printf("mixa win32: mouse0 missing SHIFT from MK_SHIFT\n")
        failures: failures + 1

    px: tw
    py: 0U
    c.PostMessageA(be\hwnd, 513U, 1U, (cast: (LPARAM) (px | (py << 16U))))
    if: mixa_backend_poll(be, got) != 0
        c.printf("mixa win32: poll mouse1 failed\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_MOUSE || got\col != 1U || got\row != 0U
        c.printf("mixa win32: mouse1 cell wrong (expected col 1)\n")
        failures: failures + 1

    # --- resize grow 3x2 -> 5x4 via WM_SIZE (client = 5*tw x 4*th) ---
    grow_cols: 5U
    grow_rows: 4U
    grow_px_w: grow_cols * tw
    grow_px_h: grow_rows * th
    old_bytes: be\frame_bytes
    old_bits: be\bits
    c.PostMessageA(be\hwnd, 5U, 0U, (cast: (LPARAM) (grow_px_w | (grow_px_h << 16U))))
    if: mixa_backend_poll(be, got) != 0
        c.printf("mixa win32: poll grow resize failed\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_RESIZE || got\cols != grow_cols || got\rows != grow_rows
        c.printf("mixa win32: grow resize event fields wrong cols=%u rows=%u\n", (cast: (unsigned int) got\cols), (cast: (unsigned int) got\rows))
        failures: failures + 1
    if: be\cols != grow_cols || be\rows != grow_rows
        c.printf("mixa win32: grow did not adopt cell geometry\n")
        failures: failures + 1
    if: be\frame_w != grow_px_w || be\frame_h != grow_px_h || be\frame_bytes != (grow_px_w * grow_px_h * 4U)
        c.printf("mixa win32: grow frame size wrong\n")
        failures: failures + 1
    if: be\cell_width != tw || be\cell_height != th
        c.printf("mixa win32: grow changed cell size\n")
        failures: failures + 1
    if: be\bits = 0 || be\bits = old_bits
        c.printf("mixa win32: grow did not replace DIB bits\n")
        failures: failures + 1
    c.free(out)
    new_bytes: be\frame_bytes
    out: (cast: (@: MixaU8) c.malloc(new_bytes))
    if: out = 0
        c.printf("mixa win32: grow out alloc failed\n")
        return: 1
    i: 0U
    while: i < new_bytes
        out[i]: (cast: (MixaU8) 9)
        i: i + 1U
    ---
    if: mixa_backend_present(be, out, new_bytes) != 0
        c.printf("mixa win32: present NEW size after grow refused\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, grow_px_w - 1U, grow_px_h - 1U, pix) != 0 || pix[0] != 9
        c.printf("mixa win32: frame_at new extent after grow failed\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, grow_px_w, 0U, pix) = 0
        c.printf("mixa win32: frame_at outside new w accepted\n")
        failures: failures + 1
    if: mixa_backend_present(be, out, old_bytes) = 0
        c.printf("mixa win32: present OLD size after grow accepted\n")
        failures: failures + 1

    # --- shrink 5x4 -> 2x1 (client = 2*tw x 1*th) ---
    shrink_cols: 2U
    shrink_rows: 1U
    shrink_px_w: shrink_cols * tw
    shrink_px_h: shrink_rows * th
    old_bytes: be\frame_bytes
    old_bits: be\bits
    c.PostMessageA(be\hwnd, 5U, 0U, (cast: (LPARAM) (shrink_px_w | (shrink_px_h << 16U))))
    if: mixa_backend_poll(be, got) != 0
        c.printf("mixa win32: poll shrink resize failed\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_RESIZE || got\cols != shrink_cols || got\rows != shrink_rows
        c.printf("mixa win32: shrink resize event fields wrong\n")
        failures: failures + 1
    if: be\cols != shrink_cols || be\rows != shrink_rows
        c.printf("mixa win32: shrink did not adopt cell geometry\n")
        failures: failures + 1
    if: be\frame_w != shrink_px_w || be\frame_h != shrink_px_h || be\frame_bytes != (shrink_px_w * shrink_px_h * 4U)
        c.printf("mixa win32: shrink frame size wrong\n")
        failures: failures + 1
    if: be\bits = 0 || be\bits = old_bits
        c.printf("mixa win32: shrink did not replace DIB bits\n")
        failures: failures + 1
    c.free(out)
    new_bytes: be\frame_bytes
    out: (cast: (@: MixaU8) c.malloc(new_bytes))
    if: out = 0
        c.printf("mixa win32: shrink out alloc failed\n")
        return: 1
    i: 0U
    while: i < new_bytes
        out[i]: (cast: (MixaU8) 11)
        i: i + 1U
    ---
    if: mixa_backend_present(be, out, new_bytes) != 0
        c.printf("mixa win32: present NEW size after shrink refused\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, shrink_px_w - 1U, shrink_px_h - 1U, pix) != 0 || pix[0] != 11
        c.printf("mixa win32: frame_at new extent after shrink failed\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, shrink_px_w, 0U, pix) = 0
        c.printf("mixa win32: frame_at outside shrink w accepted\n")
        failures: failures + 1

    # --- adopt failure: WM_SIZE with client smaller than one cell (cols=0) ---
    # SIZE_MAX overflow cannot be injected: WM_SIZE packs cx/cy into 16-bit LOWORD/HIWORD.
    old_bytes: be\frame_bytes
    old_bits: be\bits
    c.PostMessageA(be\hwnd, 5U, 0U, (cast: (LPARAM) (1U | (1U << 16U))))
    got\kind: MIXA_EVENT_NONE
    got\cols: 99U
    got\rows: 99U
    rc: mixa_backend_poll(be, got)
    if: rc = 0
        c.printf("mixa win32: zero-cell resize poll succeeded\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_RESIZE || got\cols != 0U || got\rows != 0U
        c.printf("mixa win32: zero-cell resize did not write event\n")
        failures: failures + 1
    if: be\bits != old_bits
        c.printf("mixa win32: zero-cell resize freed/replaced old bits\n")
        failures: failures + 1
    if: be\cols != 2U || be\rows != 1U || be\frame_bytes != old_bytes
        c.printf("mixa win32: zero-cell resize mutated geometry\n")
        failures: failures + 1
    if: mixa_backend_present(be, out, old_bytes) != 0
        c.printf("mixa win32: old surface unusable after zero-cell resize\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, 0U, 0U, pix) != 0 || pix[0] != 11
        c.printf("mixa win32: old pixels lost after zero-cell resize\n")
        failures: failures + 1

    # --- pump driven from Win32: burst PostMessage, single drain, turn boundary ---
    # Geometry here is 2x1 cell 4x5 after shrink + failed zero-cell adopt.
    # Clear any leftover queue noise before the burst.
    if: mixa_win32_drain(be, got, 64) != 0
        c.printf("mixa win32: pre-pump drain stuck\n")
        failures: failures + 1
    c.memset(pump, 0, c.sizeof(c.MixaPump))
    if: mixa_pump_open(pump) != 0
        c.printf("mixa win32: pump open failed\n")
        failures: failures + 1

    # Burst: WM_CHAR, WM_KEYDOWN F5, WM_LBUTTONDOWN, WM_SIZE grow 2x1 -> 5x4
    grow_cols: 5U
    grow_rows: 4U
    grow_px_w: grow_cols * tw
    grow_px_h: grow_rows * th
    c.PostMessageA(be\hwnd, 258U, 1041U, 0)
    c.PostMessageA(be\hwnd, 256U, 116U, 0)
    c.PostMessageA(be\hwnd, 513U, 1U, 0)
    c.PostMessageA(be\hwnd, 5U, 0U, (cast: (LPARAM) (grow_px_w | (grow_px_h << 16U))))

    # Single drain only -- do not loop drain-until-empty if the burst fragments.
    if: mixa_pump_drain(pump, be) != 0
        c.printf("mixa win32: pump drain burst failed\n")
        failures: failures + 1
    if: mixa_pump_pending(pump) != 4U
        c.printf("mixa win32: pump burst pending not 4 (got %u) -- single-drain may not take full PostMessage burst\n", (cast: (unsigned int) mixa_pump_pending(pump)))
        failures: failures + 1
    got\kind: MIXA_EVENT_KEY
    if: mixa_backend_poll(be, got) != 0 || got\kind != MIXA_EVENT_NONE
        c.printf("mixa win32: backend not empty after pump drain\n")
        failures: failures + 1

    if: mixa_pump_next(pump, got) != 0 || got\kind != MIXA_EVENT_KEY || got\codepoint != 1041U || got\keycode != MIXA_KEY_NONE
        c.printf("mixa win32: pump next burst[0] CHAR wrong\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\kind != MIXA_EVENT_KEY || got\codepoint != 0U || got\keycode != MIXA_KEY_F5
        c.printf("mixa win32: pump next burst[1] F5 wrong\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\kind != MIXA_EVENT_MOUSE || got\col != 0U || got\row != 0U
        c.printf("mixa win32: pump next burst[2] mouse wrong\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\kind != MIXA_EVENT_RESIZE || got\cols != grow_cols || got\rows != grow_rows
        c.printf("mixa win32: pump next burst[3] resize wrong\n")
        failures: failures + 1
    if: be\cols != grow_cols || be\rows != grow_rows
        c.printf("mixa win32: pump burst resize did not adopt via poll-in-drain\n")
        failures: failures + 1
    if: be\frame_w != grow_px_w || be\frame_h != grow_px_h || be\frame_bytes != (grow_px_w * grow_px_h * 4U)
        c.printf("mixa win32: pump burst resize frame size wrong\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) = 0
        c.printf("mixa win32: pump next after burst still had events\n")
        failures: failures + 1

    # Turn boundary against real Win32 source: post AFTER drain; not in this inbox.
    c.PostMessageA(be\hwnd, 258U, 66U, 0)
    c.PostMessageA(be\hwnd, 258U, 67U, 0)
    if: mixa_pump_drain(pump, be) != 0
        c.printf("mixa win32: pump turn drain failed\n")
        failures: failures + 1
    if: mixa_pump_pending(pump) != 2U
        c.printf("mixa win32: pump turn pending not 2\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\codepoint != 66U
        c.printf("mixa win32: pump process 66 failed\n")
        failures: failures + 1
    c.PostMessageA(be\hwnd, 258U, 99U, 0)
    if: mixa_pump_pending(pump) != 1U
        c.printf("mixa win32: mid-turn PostMessage leaked into inbox\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\codepoint != 67U
        c.printf("mixa win32: pump process 67 failed\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) = 0
        c.printf("mixa win32: mid-turn event wrongly available\n")
        failures: failures + 1
    if: mixa_pump_drain(pump, be) != 0
        c.printf("mixa win32: pump second drain failed\n")
        failures: failures + 1
    if: mixa_pump_pending(pump) != 1U
        c.printf("mixa win32: pump second drain pending not 1\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\codepoint != 99U
        c.printf("mixa win32: mid-turn event not taken by next drain\n")
        failures: failures + 1

    mixa_pump_release(pump)


    # --- TASK23: glyph rasterization ---
    g1: (cast: (@: MixaGlyph) c.calloc(1U, c.sizeof(c.MixaGlyph)))
    g2: (cast: (@: MixaGlyph) c.calloc(1U, c.sizeof(c.MixaGlyph)))
    if: g1 = 0 || g2 = 0
        c.printf("mixa win32: glyph alloc failed\n")
        return: 1
    if: mixa_backend_glyph(be, MIXA_LAYER_TEXT, 65U, g1) != 0
        c.printf("mixa win32: glyph('A') hard-failed\n")
        failures: failures + 1
    else:
        if: g1\missing != 0
            c.printf("mixa win32: glyph('A') reported missing\n")
            failures: failures + 1
        ---
        if: g1\width = 0U || g1\height = 0U || g1\coverage = 0
            c.printf("mixa win32: glyph('A') empty coverage\n")
            failures: failures + 1
        ---
        if: g1\width > tw * 2U || g1\height > th * 2U
            c.printf("mixa win32: glyph('A') extent implausible w=%u h=%u cell=%ux%u\n", (cast: (unsigned int) g1\width), (cast: (unsigned int) g1\height), (cast: (unsigned int) tw), (cast: (unsigned int) th))
            failures: failures + 1
        ---
        non_zero: 0U
        cov_n: g1\width * g1\height
        cov_i: 0U
        while: cov_i < cov_n
            if: g1\coverage[cov_i] != 0
                non_zero: non_zero + 1U
            ---
            cov_i: cov_i + 1U
        ---
        if: non_zero = 0U
            c.printf("mixa win32: glyph('A') all-zero coverage\n")
            failures: failures + 1
        ---
        # Cache: second call identical pointer/data
        if: mixa_backend_glyph(be, MIXA_LAYER_TEXT, 65U, g2) != 0
            c.printf("mixa win32: glyph('A') second call failed\n")
            failures: failures + 1
        ---
        if: g2\coverage != g1\coverage || g2\width != g1\width || g2\height != g1\height || g2\bearing_x != g1\bearing_x || g2\bearing_y != g1\bearing_y || g2\advance != g1\advance || g2\missing != g1\missing
            c.printf("mixa win32: glyph cache mismatch on second 'A'\n")
            failures: failures + 1
        ---
    ---

    # Missing codepoint: unassigned BMP U+0378 must not be blank-substituted.
    c.memset(g1, 0, c.sizeof(c.MixaGlyph))
    if: mixa_backend_glyph(be, MIXA_LAYER_TEXT, 0x0378U, g1) != 0
        c.printf("mixa win32: glyph(missing) hard-failed\n")
        failures: failures + 1
    else:
        if: g1\missing = 0
            c.printf("mixa win32: glyph(U+0378) not reported missing\n")
            failures: failures + 1
        ---
        if: g1\coverage != 0
            c.printf("mixa win32: glyph(U+0378) substituted coverage\n")
            failures: failures + 1
        ---
    ---

    # Wide: fullwidth A U+FF21 should advance two cells on MS Gothic / NSimSun.
    c.memset(g1, 0, c.sizeof(c.MixaGlyph))
    if: mixa_backend_glyph(be, MIXA_LAYER_TEXT, 0xFF21U, g1) != 0
        c.printf("mixa win32: glyph(wide) hard-failed\n")
        failures: failures + 1
    else:
        if: g1\missing != 0
            c.printf("mixa win32: glyph(U+FF21) missing on chosen font\n")
            failures: failures + 1
        ---
        if: g1\advance < (tw * 2U)
            c.printf("mixa win32: wide advance %u < 2*cell %u\n", (cast: (unsigned int) g1\advance), (cast: (unsigned int) (tw * 2U)))
            failures: failures + 1
        ---
    ---

    # Real-glyph composite: non-bg pixels inside the cell, none outside it.
    mixa_rect_release(rect)
    mixa_rect_release(upper)
    c.memset(rect, 0, c.sizeof(c.MixaTextRect))
    c.memset(upper, 0, c.sizeof(c.MixaTextRect))
    if: mixa_rect_open(rect, 1U, 1U) != 0 || mixa_rect_open(upper, 1U, 1U) != 0
        c.printf("mixa win32: glyph composite rect open failed\n")
        return: 1
    mixa_rect_fill(rect, 0U, 15U, 1U, 0U)
    mixa_rect_put_text(rect, 0U, 0U, "A", 15U, 1U, 0U)
    # present buffer must match current backend frame; paint into a 1-cell view
    # sized to text cell, then only assert within that cell against a local buffer.
    need: tw * th * 4U
    c.free(out)
    out: (cast: (@: MixaU8) c.malloc(need))
    if: out = 0
        c.printf("mixa win32: glyph composite out alloc failed\n")
        return: 1
    if: mixa_composite_glyphs(be, rect, tw, th, upper, tw, th, out, need, tw, th) != 0
        c.printf("mixa win32: composite_glyphs failed\n")
        failures: failures + 1
    else:
        non_zero: 0U
        outside_hits: 0U
        # Inside cell: count pixels that differ from palette[1]={170,0,0}.
        cov_i: 0U
        while: cov_i < (tw * th)
            gp: out + (cov_i * 4U)
            if: gp[0] != 170 || gp[1] != 0 || gp[2] != 0
                non_zero: non_zero + 1U
            ---
            cov_i: cov_i + 1U
        ---
        if: non_zero = 0U
            c.printf("mixa win32: composite_glyphs left cell all background\n")
            failures: failures + 1
        ---
        # Re-run into a 3x3 cell frame and ensure no paint outside centre cell (1,1).
        mixa_rect_release(rect)
        mixa_rect_release(upper)
        c.memset(rect, 0, c.sizeof(c.MixaTextRect))
        c.memset(upper, 0, c.sizeof(c.MixaTextRect))
        if: mixa_rect_open(rect, 3U, 3U) != 0 || mixa_rect_open(upper, 3U, 3U) != 0
            c.printf("mixa win32: 3x3 rect open failed\n")
            return: 1
        mixa_rect_fill(rect, 0U, 15U, 1U, 0U)
        mixa_rect_put_text(rect, 1U, 1U, "A", 15U, 1U, 0U)
        fw: 3U * tw
        fh: 3U * th
        need: fw * fh * 4U
        c.free(out)
        out: (cast: (@: MixaU8) c.malloc(need))
        if: out = 0
            c.printf("mixa win32: 3x3 out alloc failed\n")
            return: 1
        if: mixa_composite_glyphs(be, rect, tw, th, upper, tw, th, out, need, fw, fh) != 0
            c.printf("mixa win32: 3x3 composite_glyphs failed\n")
            failures: failures + 1
        else:
            outside_hits: 0U
            non_zero: 0U
            gy: 0U
            while: gy < fh
                gx: 0U
                while: gx < fw
                    gp: out + ((gy * fw + gx) * 4U)
                    if: gp[0] != 170 || gp[1] != 0 || gp[2] != 0
                        # Inside centre cell?
                        if: gx >= tw && gx < (tw + tw) && gy >= th && gy < (th + th)
                            non_zero: non_zero + 1U
                        else:
                            outside_hits: outside_hits + 1U
                        ---
                    ---
                    gx: gx + 1U
                ---
                gy: gy + 1U
            ---
            if: non_zero = 0U
                c.printf("mixa win32: real glyph produced no interior pixels\n")
                failures: failures + 1
            ---
            if: outside_hits != 0U
                c.printf("mixa win32: real glyph painted outside its cell (%u px)\n", (cast: (unsigned int) outside_hits))
                failures: failures + 1
            ---
        ---
    ---
    c.free(g1)
    c.free(g2)

    # WM_CLOSE
    c.PostMessageA(be\hwnd, 16U, 0U, 0)
    if: mixa_backend_poll(be, got) != 0
        c.printf("mixa win32: poll close failed\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_CLOSE
        c.printf("mixa win32: close event missing\n")
        failures: failures + 1

    # close then refuse
    mixa_backend_close(be)
    if: mixa_backend_present(be, out, need) = 0
        c.printf("mixa win32: present after close accepted\n")
        failures: failures + 1
    if: mixa_backend_frame_at(be, 0U, 0U, pix) = 0
        c.printf("mixa win32: frame_at after close accepted\n")
        failures: failures + 1
    if: mixa_backend_clipboard_set(be, "x") = 0
        c.printf("mixa win32: clipboard_set after close accepted\n")
        failures: failures + 1
    n: mixa_backend_clipboard_get(be, clip_out, 64U)
    if: n != 0U
        c.printf("mixa win32: clipboard_get after close returned data\n")
        failures: failures + 1
    got\kind: MIXA_EVENT_KEY
    if: mixa_backend_poll(be, got) = 0
        c.printf("mixa win32: poll after close accepted\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_NONE
        c.printf("mixa win32: poll after close did not write NONE\n")
        failures: failures + 1

    c.free(out)
    mixa_rect_release(upper)
    mixa_rect_release(rect)
    c.free(upper)
    c.free(rect)
    c.free(got)
    c.free(pump)
    c.free(m)
    c.free(be)

    if: failures != 0
        c.printf("mixa win32 backend selftest FAILED checks=%d\n", failures)
        return: 1
    c.printf("mixa win32 backend selftest ok\n")
    return: 0