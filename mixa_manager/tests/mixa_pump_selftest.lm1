predef: "mixa_manager/mixa_backend_headless.lm1" "mixa_manager/mixa_pump.lm1"
include: "<stdio.h>" "<string.h>"

# mixa_event_fifo + mixa_pump. Milestone 3 groundwork (BACKEND_SEAM 7.1).

fn: main () int
    @: MixaEventFifo fifo
    @: MixaPump pump
    @: MixaBackend be
    @: MixaCellMetrics m
    @: MixaEvent ev
    @: MixaEvent got
    []: MixaU8 pr 1
    []: MixaU8 pg 1
    []: MixaU8 pb 1
    size_t: i
    size_t: n
    int: failures
    failures: 0

    fifo: (cast: (@: MixaEventFifo) c.calloc(1U, c.sizeof(c.MixaEventFifo)))
    pump: (cast: (@: MixaPump) c.calloc(1U, c.sizeof(c.MixaPump)))
    be: (cast: (@: MixaBackend) c.calloc(1U, c.sizeof(c.MixaBackend)))
    ev: (cast: (@: MixaEvent) c.calloc(1U, c.sizeof(c.MixaEvent)))
    got: (cast: (@: MixaEvent) c.calloc(1U, c.sizeof(c.MixaEvent)))
    if: fifo = 0 || pump = 0 || be = 0 || ev = 0 || got = 0
        c.printf("mixa pump: alloc failed\n")
        return: 1
    # Reference mixa_palette_rgb so -Wunused-function stays quiet in this TU
    # (overlay.h arrives via mixa_backend.h for MixaU8).
    mixa_palette_rgb(0U, pr, pg, pb)

    # --- fifo: push then pop returns events in order, fields intact ---
    if: mixa_event_fifo_init(fifo) != 0
        c.printf("mixa fifo: init failed\n")
        return: 1
    c.memset(ev, 0, c.sizeof(c.MixaEvent))
    ev\kind: MIXA_EVENT_KEY
    ev\codepoint: 65U
    ev\keycode: MIXA_KEY_NONE
    ev\modifiers: MIXA_MOD_SHIFT
    if: mixa_event_fifo_push(fifo, ev) != 0
        c.printf("mixa fifo: push A failed\n")
        failures: failures + 1
    c.memset(ev, 0, c.sizeof(c.MixaEvent))
    ev\kind: MIXA_EVENT_KEY
    ev\codepoint: 0U
    ev\keycode: MIXA_KEY_F1
    ev\modifiers: MIXA_MOD_CTRL
    if: mixa_event_fifo_push(fifo, ev) != 0
        c.printf("mixa fifo: push F1 failed\n")
        failures: failures + 1
    if: mixa_event_fifo_count(fifo) != 2U
        c.printf("mixa fifo: count after two pushes wrong\n")
        failures: failures + 1
    c.memset(got, 0, c.sizeof(c.MixaEvent))
    if: mixa_event_fifo_pop(fifo, got) != 0
        c.printf("mixa fifo: pop A failed\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_KEY || got\codepoint != 65U || got\keycode != MIXA_KEY_NONE || got\modifiers != MIXA_MOD_SHIFT
        c.printf("mixa fifo: pop A fields wrong\n")
        failures: failures + 1
    if: mixa_event_fifo_pop(fifo, got) != 0
        c.printf("mixa fifo: pop F1 failed\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_KEY || got\codepoint != 0U || got\keycode != MIXA_KEY_F1 || got\modifiers != MIXA_MOD_CTRL
        c.printf("mixa fifo: pop F1 fields wrong\n")
        failures: failures + 1

    # --- fifo: pop on empty refuses and does not invent an event ---
    got\kind: MIXA_EVENT_CLOSE
    got\codepoint: 99U
    if: mixa_event_fifo_pop(fifo, got) = 0
        c.printf("mixa fifo: pop empty accepted\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_CLOSE || got\codepoint != 99U
        c.printf("mixa fifo: pop empty invented/mutated event\n")
        failures: failures + 1

    # --- fifo: growth across a wrap preserves order ---
    i: 0U
    while: i < 10U
        c.memset(ev, 0, c.sizeof(c.MixaEvent))
        ev\kind: MIXA_EVENT_KEY
        ev\codepoint: (cast: (unsigned) (1000U + i))
        if: mixa_event_fifo_push(fifo, ev) != 0
            c.printf("mixa fifo: growth push failed\n")
            failures: failures + 1
        ---
        i: i + 1U
    ---
    if: mixa_event_fifo_count(fifo) != 10U
        c.printf("mixa fifo: count after 10 pushes wrong\n")
        failures: failures + 1
    i: 0U
    while: i < 3U
        if: mixa_event_fifo_pop(fifo, got) != 0
            c.printf("mixa fifo: wrap pop failed\n")
            failures: failures + 1
        ---
        if: got\codepoint != (1000U + i)
            c.printf("mixa fifo: wrap early order wrong\n")
            failures: failures + 1
        ---
        i: i + 1U
    ---
    i: 0U
    while: i < 5U
        c.memset(ev, 0, c.sizeof(c.MixaEvent))
        ev\kind: MIXA_EVENT_KEY
        ev\codepoint: (cast: (unsigned) (2000U + i))
        if: mixa_event_fifo_push(fifo, ev) != 0
            c.printf("mixa fifo: post-wrap push failed\n")
            failures: failures + 1
        ---
        i: i + 1U
    ---
    if: mixa_event_fifo_count(fifo) != 12U
        c.printf("mixa fifo: count after wrap pushes wrong\n")
        failures: failures + 1
    i: 3U
    while: i < 10U
        if: mixa_event_fifo_pop(fifo, got) != 0 || got\codepoint != (1000U + i)
            c.printf("mixa fifo: mid order wrong\n")
            failures: failures + 1
        ---
        i: i + 1U
    ---
    i: 0U
    while: i < 5U
        if: mixa_event_fifo_pop(fifo, got) != 0 || got\codepoint != (2000U + i)
            c.printf("mixa fifo: late order wrong\n")
            failures: failures + 1
        ---
        i: i + 1U
    ---

    # --- fifo: release then use refused ---
    mixa_event_fifo_release(fifo)
    c.memset(ev, 0, c.sizeof(c.MixaEvent))
    ev\kind: MIXA_EVENT_KEY
    if: mixa_event_fifo_push(fifo, ev) = 0
        c.printf("mixa fifo: push after release accepted\n")
        failures: failures + 1
    got\kind: MIXA_EVENT_NONE
    if: mixa_event_fifo_pop(fifo, got) = 0
        c.printf("mixa fifo: pop after release accepted\n")
        failures: failures + 1
    if: mixa_event_fifo_count(fifo) != 0U
        c.printf("mixa fifo: count after release not 0\n")
        failures: failures + 1

    # --- pump: drain takes every queued event and leaves backend poll empty ---
    c.memset(fifo, 0, c.sizeof(c.MixaEventFifo))
    c.memset(pump, 0, c.sizeof(c.MixaPump))
    c.memset(be, 0, c.sizeof(c.MixaBackend))
    m: (cast: (@: MixaCellMetrics) c.calloc(1U, c.sizeof(c.MixaCellMetrics)))
    if: m = 0
        c.printf("mixa pump: metrics alloc failed\n")
        return: 1
    m\text_cell_width: 4U
    m\text_cell_height: 5U
    m\upper_cell_width: 8U
    m\upper_cell_height: 10U
    if: mixa_backend_open(be, 3U, 2U, m) != 0
        c.printf("mixa pump: backend open failed\n")
        return: 1
    if: mixa_pump_open(pump) != 0
        c.printf("mixa pump: open failed\n")
        return: 1
    c.memset(ev, 0, c.sizeof(c.MixaEvent))
    ev\kind: MIXA_EVENT_KEY
    ev\codepoint: 10U
    if: mixa_backend_push_event(be, ev) != 0
        c.printf("mixa pump: backend push 10 failed\n")
        failures: failures + 1
    c.memset(ev, 0, c.sizeof(c.MixaEvent))
    ev\kind: MIXA_EVENT_KEY
    ev\codepoint: 11U
    if: mixa_backend_push_event(be, ev) != 0
        c.printf("mixa pump: backend push 11 failed\n")
        failures: failures + 1
    c.memset(ev, 0, c.sizeof(c.MixaEvent))
    ev\kind: MIXA_EVENT_KEY
    ev\codepoint: 12U
    if: mixa_backend_push_event(be, ev) != 0
        c.printf("mixa pump: backend push 12 failed\n")
        failures: failures + 1
    if: mixa_pump_drain(pump, be) != 0
        c.printf("mixa pump: drain three failed\n")
        failures: failures + 1
    if: mixa_pump_pending(pump) != 3U
        c.printf("mixa pump: pending after drain not 3\n")
        failures: failures + 1
    got\kind: MIXA_EVENT_KEY
    if: mixa_backend_poll(be, got) != 0 || got\kind != MIXA_EVENT_NONE
        c.printf("mixa pump: backend not empty after drain\n")
        failures: failures + 1

    # --- pump: drain on idle backend takes nothing ---
    n: mixa_pump_pending(pump)
    if: mixa_pump_drain(pump, be) != 0
        c.printf("mixa pump: idle drain failed\n")
        failures: failures + 1
    if: mixa_pump_pending(pump) != n
        c.printf("mixa pump: idle drain changed pending\n")
        failures: failures + 1

    # --- pump: next yields them in push order ---
    if: mixa_pump_next(pump, got) != 0 || got\codepoint != 10U
        c.printf("mixa pump: next 10 wrong\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\codepoint != 11U
        c.printf("mixa pump: next 11 wrong\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\codepoint != 12U
        c.printf("mixa pump: next 12 wrong\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) = 0
        c.printf("mixa pump: next on empty accepted\n")
        failures: failures + 1

    # --- pump: event pushed DURING processing is NOT seen by current turn ---
    c.memset(ev, 0, c.sizeof(c.MixaEvent))
    ev\kind: MIXA_EVENT_KEY
    ev\codepoint: 20U
    if: mixa_backend_push_event(be, ev) != 0
        c.printf("mixa pump: push 20 failed\n")
        failures: failures + 1
    c.memset(ev, 0, c.sizeof(c.MixaEvent))
    ev\kind: MIXA_EVENT_KEY
    ev\codepoint: 21U
    if: mixa_backend_push_event(be, ev) != 0
        c.printf("mixa pump: push 21 failed\n")
        failures: failures + 1
    if: mixa_pump_drain(pump, be) != 0
        c.printf("mixa pump: drain turn failed\n")
        failures: failures + 1
    if: mixa_pump_pending(pump) != 2U
        c.printf("mixa pump: turn pending not 2\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\codepoint != 20U
        c.printf("mixa pump: process 20 failed\n")
        failures: failures + 1
    c.memset(ev, 0, c.sizeof(c.MixaEvent))
    ev\kind: MIXA_EVENT_KEY
    ev\codepoint: 99U
    if: mixa_backend_push_event(be, ev) != 0
        c.printf("mixa pump: mid-turn push failed\n")
        failures: failures + 1
    if: mixa_pump_pending(pump) != 1U
        c.printf("mixa pump: mid-turn push leaked into inbox\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\codepoint != 21U
        c.printf("mixa pump: process 21 failed\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) = 0
        c.printf("mixa pump: mid-turn event wrongly available\n")
        failures: failures + 1
    if: mixa_pump_drain(pump, be) != 0
        c.printf("mixa pump: second drain failed\n")
        failures: failures + 1
    if: mixa_pump_pending(pump) != 1U
        c.printf("mixa pump: second drain pending not 1\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0 || got\codepoint != 99U
        c.printf("mixa pump: mid-turn event not taken by next drain\n")
        failures: failures + 1

    # --- pump: resize drained through pump still adopts geometry ---
    c.memset(ev, 0, c.sizeof(c.MixaEvent))
    ev\kind: MIXA_EVENT_RESIZE
    ev\cols: 5U
    ev\rows: 4U
    if: mixa_backend_push_event(be, ev) != 0
        c.printf("mixa pump: push resize failed\n")
        failures: failures + 1
    if: mixa_pump_drain(pump, be) != 0
        c.printf("mixa pump: drain resize failed\n")
        failures: failures + 1
    if: be\cols != 5U || be\rows != 4U
        c.printf("mixa pump: resize did not adopt via poll-in-drain\n")
        failures: failures + 1
    if: be\frame_w != 20U || be\frame_h != 20U || be\frame_bytes != 1600U
        c.printf("mixa pump: resize frame size wrong\n")
        failures: failures + 1
    if: mixa_pump_next(pump, got) != 0
        c.printf("mixa pump: next resize failed\n")
        failures: failures + 1
    if: got\kind != MIXA_EVENT_RESIZE || got\cols != 5U || got\rows != 4U
        c.printf("mixa pump: resize event fields wrong\n")
        failures: failures + 1

    mixa_pump_release(pump)
    mixa_backend_close(be)
    c.free(m)
    c.free(got)
    c.free(ev)
    c.free(be)
    c.free(pump)
    c.free(fifo)

    if: failures != 0
        c.printf("mixa pump selftest FAILED checks=%d\n", failures)
        return: 1
    c.printf("mixa pump selftest ok\n")
    return: 0