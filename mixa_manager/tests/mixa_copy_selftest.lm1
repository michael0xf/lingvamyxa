predef: "mixa_manager/mixa_copy.h.lm1"
predef: "mixa_manager/mixa_copy.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# First bounded copy-operation selftest (ticket 20260912-092435).
# Real, test-owned directory trees under this run's own directory; every
# mutation happens inside that fixture root, verified before any write.
# No user files anywhere.

int: g_calls
[]: char g_trace 4000
size_t: g_trace_len
int: g_fail_at_call
int: g_fail_status

fn: t_base (const: @(char path)) const: @(char)
    size_t: n
    size_t: i
    size_t: last
    int: found
    n: c.strlen(path)
    last: 0U
    found: 0
    i: 0U
    while: i < n
        if: path[i] = (cast: (char) 92) || path[i] = (cast: (char) 47)
            last: i + 1U
            found: 1
        ---
        i: i + 1U
    ---
    if: found = 0
        return: path
return: path + last

sub: t_record (const: @(char kind); const: @(char path); int: status)
    size_t: room
    if: g_trace_len + 80U >= 4000U
        return
    ---
    room: 4000U - g_trace_len
    c.snprintf(g_trace + g_trace_len, room, "%s:%s:%d|", kind, t_base(path), status)
    g_trace_len: c.strlen(g_trace)
end: t_record

fn: t_note (const: @(char kind); const: @(char path); int: status) int
    g_calls: g_calls + 1
    t_record(kind, path, status)
    if: g_fail_at_call != 0 && g_calls = g_fail_at_call
        return: g_fail_status
    ---
return: MIXA_SEL_WALK_GO

fn: cb_dir_enter (@: void ctx; const: @(char src); const: @(char dst); int: is_dir; int: status) int
return: t_note("D", src, status)

fn: cb_file (@: void ctx; const: @(char src); const: @(char dst); int: is_dir; int: status) int
return: t_note("F", src, status)

fn: cb_dir_done (@: void ctx; const: @(char src); const: @(char dst); int: is_dir; int: status) int
return: t_note("E", src, status)

@: MixaCopySink g_sink
int: g_sink_ready

fn: t_sink () const: @(MixaCopySink)
    if: g_sink_ready = 0
        g_sink: (cast: (@: MixaCopySink) c.calloc(1U, c.sizeof(c.MixaCopySink)))
        g_sink\on_dir_enter: cb_dir_enter
        g_sink\on_file: cb_file
        g_sink\on_dir_done: cb_dir_done
        g_sink_ready: 1
    ---
return: g_sink

sub: t_reset ()
    g_calls: 0
    g_trace[0]: 0
    g_trace_len: 0U
    g_fail_at_call: 0
    g_fail_status: 0
end: t_reset

fn: t_count (const: @(char needle)) int
    const: @(char p)
    int: n
    n: 0
    p: c.strstr(g_trace, needle)
    while: p != 0
        n: n + 1
        p: c.strstr(p + 1U, needle)
    ---
return: n

sub: t_touch (const: @(char path); const: @(char content))
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "wb")
    if: fh[0] != 0
        c.fputs(content, fh[0])
        c.fclose(fh[0])
    ---
end: t_touch

fn: t_read_all (const: @(char path); @: char out_buf; size_t: cap) int
    []: (@: void) fh 1
    size_t: n
    fh[0]: c.fopen(path, "rb")
    if: fh[0] = 0
        return: -1
    ---
    n: c.fread(out_buf, 1U, cap - 1U, fh[0])
    out_buf[n]: 0
    c.fclose(fh[0])
return: (cast: (int) n)

fn: t_exists (const: @(char path)) int
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "rb")
    if: fh[0] = 0
        return: 0
    ---
    c.fclose(fh[0])
return: 1

int: g_fault_at
int: g_fault_calls

fn: fault_hook (@: void ctx; size_t: bytes_done) int
    g_fault_calls: g_fault_calls + 1
    if: g_fault_at >= 0
        if: (cast: (int) bytes_done) >= g_fault_at
            return: MIXA_FIO_ERR_IO
        ---
    ---
return: MIXA_FIO_OK

@: MixaFioFaultVTable g_fv
int: g_fv_ready

fn: t_fv () const: @(MixaFioFaultVTable)
    if: g_fv_ready = 0
        g_fv: (cast: (@: MixaFioFaultVTable) c.calloc(1U, c.sizeof(c.MixaFioFaultVTable)))
        g_fv\on_read: fault_hook
        g_fv\on_write: fault_hook
        g_fv_ready: 1
    ---
return: g_fv

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char src_root 1040
    []: char dira 1040
    []: char dirb 1040
    []: char dest1 1040
    []: char dest2 1040
    []: char dest3 1040
    []: char single_file 1040
    []: char nested_dest 1040
    []: char p1 1200
    []: char cmd 2400
    []: char readbuf 4100
    @: MixaSelection sel
    const: @(MixaCopySink sink)
    int: rc
    int: st
    int: failures
    int: checks
    c.setbuf((cast: (@: void) c.stdout), 0)
    failures: 0
    checks: 0
    g_fault_at: -1

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    ---
    if: argc < 2
        c.snprintf(base, 520U, "build/mixa/claude/copy/tmp")
    ---
    c.snprintf(src_root, 1040U, "%s\\src", base)
    c.snprintf(dira, 1040U, "%s\\a", src_root)
    c.snprintf(dirb, 1040U, "%s\\b", src_root)
    c.snprintf(single_file, 1040U, "%s\\top.txt", src_root)
    c.snprintf(dest1, 1040U, "%s\\dest1", base)
    c.snprintf(dest2, 1040U, "%s\\dest2", base)
    c.snprintf(dest3, 1040U, "%s\\dest3", base)

    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", src_root)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dira)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dirb)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest1)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest2)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest3)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\a1.txt", dira)
    t_touch(p1, "content-a1")
    c.snprintf(p1, 1200U, "%s\\a2.txt", dira)
    t_touch(p1, "content-a2")
    c.snprintf(p1, 1200U, "%s\\b1.txt", dirb)
    t_touch(p1, "content-b1")
    t_touch(single_file, "top-level-content")

    sel: (cast: (@: MixaSelection) c.calloc(1U, c.sizeof(c.MixaSelection)))
    if: sel = 0
        c.printf("copy: alloc failed\n")
        return: 1
    ---
    checks: checks + 1
    if: mixa_selection_init(sel) != MIXA_SEL_OK
        failures: failures + 1
        c.printf("copy: selection init failed\n")
        return: 1
    ---
    sink: t_sink()

    # --- Scenario 1: content equality. Select the whole tree, copy into
    # dest1, verify every real byte round-trips and the structure is
    # rebuilt correctly.
    mixa_selection_select(sel, src_root)
    t_reset()
    rc: mixa_copy_run(sel, dest1, sink, 0)
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("copy: content-equality run rc=%d trace=%s\n", rc, g_trace)
    ---
    c.snprintf(p1, 1200U, "%s\\src\\a\\a1.txt", dest1)
    st: t_read_all(p1, readbuf, 4100U)
    checks: checks + 1
    if: st < 0 || c.strcmp(readbuf, "content-a1") != 0
        failures: failures + 1
        c.printf("copy: a1.txt content=[%s]\n", readbuf)
    ---
    c.snprintf(p1, 1200U, "%s\\src\\a\\a2.txt", dest1)
    st: t_read_all(p1, readbuf, 4100U)
    checks: checks + 1
    if: st < 0 || c.strcmp(readbuf, "content-a2") != 0
        failures: failures + 1
        c.printf("copy: a2.txt content=[%s]\n", readbuf)
    ---
    c.snprintf(p1, 1200U, "%s\\src\\b\\b1.txt", dest1)
    st: t_read_all(p1, readbuf, 4100U)
    checks: checks + 1
    if: st < 0 || c.strcmp(readbuf, "content-b1") != 0
        failures: failures + 1
        c.printf("copy: b1.txt content=[%s]\n", readbuf)
    ---
    checks: checks + 1
    if: t_count("D:a:0|") != 1 || t_count("D:b:0|") != 1 || t_count("E:a:0|") != 1 || t_count("E:b:0|") != 1
        failures: failures + 1
        c.printf("copy: directory event coverage: %s\n", g_trace)
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, src_root) != 0
        failures: failures + 1
        c.printf("copy: fully-copied root was not deselected\n")
    ---

    # --- Scenario 2: existing-destination preservation. Copying the same
    # tree again refuses EVERY file with the real Win32 status (no
    # overwrite). A per-file conflict does not abort the whole copy --
    # the sink decides that, and this test's sink continues past it, so
    # the overall run reports OK while each individual file event carries
    # its own real MIXA_COPY_ERR_EXISTS; nothing on disk is disturbed.
    mixa_selection_select(sel, src_root)
    t_reset()
    rc: mixa_copy_run(sel, dest1, sink, 0)
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("copy: re-copy rc=%d want OK (per-file EXISTS, not aborted) trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: t_count("F:a1.txt:104|") != 1 || t_count("F:a2.txt:104|") != 1 || t_count("F:b1.txt:104|") != 1 || t_count("F:top.txt:104|") != 1
        failures: failures + 1
        c.printf("copy: re-copy did not refuse every existing file: %s\n", g_trace)
    ---
    c.snprintf(p1, 1200U, "%s\\src\\a\\a1.txt", dest1)
    st: t_read_all(p1, readbuf, 4100U)
    checks: checks + 1
    if: st < 0 || c.strcmp(readbuf, "content-a1") != 0
        failures: failures + 1
        c.printf("copy: existing destination content disturbed: [%s]\n", readbuf)
    ---
    # Every file conflicted, so nothing under the root finished cleanly:
    # the root stays selected for a retry against a different/cleared
    # destination.
    checks: checks + 1
    if: mixa_selection_query(sel, src_root) != 1
        failures: failures + 1
        c.printf("copy: root wrongly deselected when every file conflicted\n")
    ---
    mixa_selection_deselect(sel, src_root)

    # --- Scenario 3: a directory that already exists at the destination
    # is MERGED into (not an error) -- only files respect no-overwrite.
    # Fresh, isolated selection: select ONLY dirb (src_root is NOT
    # selected here, so dirb is a real effective root of its own, not
    # covered/no-op'd by an ancestor's own inherited selection). Since
    # dirb is now a top-level root, its own destination is dest1\\b --
    # pre-create THAT exact directory with a conflicting b1.txt already
    # in it (dest1's earlier src_root-based copy landed under
    # dest1\\src\\b instead, a different path, so it cannot be reused to
    # manufacture this collision).
    c.snprintf(p1, 1200U, "%s\\b", dest1)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", p1)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\b\\b1.txt", dest1)
    t_touch(p1, "pre-existing-conflict")
    c.snprintf(p1, 1200U, "%s\\b2.txt", dirb)
    t_touch(p1, "content-b2")
    checks: checks + 1
    if: mixa_selection_select(sel, dirb) != MIXA_SEL_OK
        failures: failures + 1
        c.printf("copy: selecting dirb in isolation failed\n")
    ---
    t_reset()
    rc: mixa_copy_run(sel, dest1, sink, 0)
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("copy: merge run rc=%d want OK (b1.txt conflicts, b2.txt does not) trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: t_count("F:b1.txt:104|") != 1
        failures: failures + 1
        c.printf("copy: pre-existing b1.txt was not refused: %s\n", g_trace)
    ---
    c.snprintf(p1, 1200U, "%s\\b\\b2.txt", dest1)
    checks: checks + 1
    if: t_exists(p1) = 0
        failures: failures + 1
        c.printf("copy: new file inside a merged existing directory missing\n")
    ---
    checks: checks + 1
    if: t_count("D:b:0|") != 1
        failures: failures + 1
        c.printf("copy: existing destination directory was not merged (event trace): %s\n", g_trace)
    ---
    # b1.txt conflicted, so dirb itself did not finish cleanly and stays
    # selected.
    checks: checks + 1
    if: mixa_selection_query(sel, dirb) != 1
        failures: failures + 1
        c.printf("copy: dirb wrongly deselected while b1.txt still conflicts\n")
    ---
    mixa_selection_deselect(sel, dirb)

    # --- Scenario 4: cancellation and retry. Fresh selection (src_root
    # only). Cancel a copy partway (on the 2nd event), leaving whatever
    # finished on disk and the source root still selected; running again
    # with no cap finishes the rest.
    checks: checks + 1
    if: mixa_selection_select(sel, src_root) != MIXA_SEL_OK
        failures: failures + 1
        c.printf("copy: re-selecting src_root for scenario 4 failed\n")
    ---
    t_reset()
    g_fail_at_call: 2
    g_fail_status: MIXA_SEL_WALK_STOP
    rc: mixa_copy_run(sel, dest2, sink, 0)
    checks: checks + 1
    if: rc != MIXA_COPY_CANCELLED
        failures: failures + 1
        c.printf("copy: cancel rc=%d want CANCELLED trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, src_root) != 1
        failures: failures + 1
        c.printf("copy: cancelled root was deselected\n")
    ---
    t_reset()
    rc: mixa_copy_run(sel, dest2, sink, 0)
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("copy: retry-after-cancel rc=%d trace=%s\n", rc, g_trace)
    ---
    c.snprintf(p1, 1200U, "%s\\src\\a\\a1.txt", dest2)
    checks: checks + 1
    if: t_exists(p1) = 0
        failures: failures + 1
        c.printf("copy: retry did not complete the remainder\n")
    ---
    c.snprintf(p1, 1200U, "%s\\src\\b\\b1.txt", dest2)
    checks: checks + 1
    if: t_exists(p1) = 0
        failures: failures + 1
        c.printf("copy: retry missed b1.txt\n")
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, src_root) != 0
        failures: failures + 1
        c.printf("copy: root not deselected once retry actually finished it\n")
    ---

    # --- Scenario 5: an I/O failure mid-file. The fault hook forces a
    # real write failure after 4 real bytes; the partial destination file
    # is cleaned up (removed), the file event reports the exact status,
    # and the source stays selected so a retry will re-attempt it.
    mixa_selection_select(sel, single_file)
    t_reset()
    g_fault_at: 4
    g_fault_calls: 0
    rc: mixa_copy_run(sel, dest3, sink, t_fv())
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("copy: io-failure run rc=%d want OK (sink continues past the one failed file) trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: g_fault_calls = 0
        failures: failures + 1
        c.printf("copy: fault hook never called\n")
    ---
    c.snprintf(p1, 1200U, "%s\\top.txt", dest3)
    checks: checks + 1
    if: t_exists(p1) != 0
        failures: failures + 1
        c.printf("copy: partial destination file was not cleaned up\n")
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, single_file) != 1
        failures: failures + 1
        c.printf("copy: source deselected despite a real I/O failure\n")
    ---
    checks: checks + 1
    if: t_count("F:top.txt:105|") != 1
        failures: failures + 1
        c.printf("copy: file event did not report the exact IO status: %s\n", g_trace)
    ---
    # Retry with the fault lifted succeeds and completes the source.
    g_fault_at: -1
    t_reset()
    rc: mixa_copy_run(sel, dest3, sink, t_fv())
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("copy: retry after IO failure rc=%d\n", rc)
    ---
    st: t_read_all(p1, readbuf, 4100U)
    checks: checks + 1
    if: st < 0 || c.strcmp(readbuf, "top-level-content") != 0
        failures: failures + 1
        c.printf("copy: retried file content=[%s]\n", readbuf)
    ---

    # --- Scenario 6: nested-destination termination. Copying dira into a
    # destination that is INSIDE dira itself is refused up front, with no
    # descent and no directory created.
    c.snprintf(nested_dest, 1040U, "%s\\nested_inside", dira)
    mixa_selection_select(sel, dira)
    t_reset()
    rc: mixa_copy_run(sel, nested_dest, sink, 0)
    checks: checks + 1
    if: rc != MIXA_COPY_ERR_NESTED
        failures: failures + 1
        c.printf("copy: nested-destination rc=%d want ERR_NESTED trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: t_exists(nested_dest) != 0
        failures: failures + 1
        c.printf("copy: nested destination directory was created despite refusal\n")
    ---
    checks: checks + 1
    if: t_count("F:") != 0
        failures: failures + 1
        c.printf("copy: nested-destination refusal still copied files: %s\n", g_trace)
    ---
    # A destination equal to the source root itself is refused the same
    # way (equal counts as nested, not merely a strict descendant).
    t_reset()
    rc: mixa_copy_run(sel, dira, sink, 0)
    checks: checks + 1
    if: rc != MIXA_COPY_ERR_NESTED
        failures: failures + 1
        c.printf("copy: dest==source rc=%d want ERR_NESTED\n", rc)
    ---
    mixa_selection_deselect(sel, dira)

    # --- Scenario 7: a resolved destination that is NOT inside the
    # source is unaffected by the nested check -- ordinary unrelated
    # copies still work (already exercised above, reconfirmed with a
    # sibling-looking path that shares a string prefix but is not a real
    # descendant, e.g. "dest1x" against "dest1").
    []: char dest1x 1040
    c.snprintf(dest1x, 1040U, "%sx", dest1)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest1x)
    c.system(cmd)
    mixa_selection_select(sel, single_file)
    t_reset()
    rc: mixa_copy_run(sel, dest1x, sink, 0)
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("copy: prefix-sharing sibling dest rc=%d want OK\n", rc)
    ---

    # --- Scenario 8: argument negatives.
    checks: checks + 1
    if: mixa_copy_run(0, dest1, sink, 0) != MIXA_COPY_ERR_ARG
        failures: failures + 1
        c.printf("copy: null selection not ERR_ARG\n")
    ---
    checks: checks + 1
    if: mixa_copy_run(sel, 0, sink, 0) != MIXA_COPY_ERR_ARG
        failures: failures + 1
        c.printf("copy: null dest not ERR_ARG\n")
    ---
    checks: checks + 1
    if: mixa_copy_run(sel, dest1, 0, 0) != MIXA_COPY_ERR_ARG
        failures: failures + 1
        c.printf("copy: null sink not ERR_ARG\n")
    ---
    # An empty selection copies nothing and succeeds trivially.
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    t_reset()
    rc: mixa_copy_run(sel, dest1, sink, 0)
    checks: checks + 1
    if: rc != MIXA_COPY_OK || g_calls != 0
        failures: failures + 1
        c.printf("copy: empty selection rc=%d calls=%d\n", rc, g_calls)
    ---

    mixa_selection_release(sel)
    c.free(sel)

    if: failures = 0
        c.printf("copy selftest: %d checks, 0 failures\n", checks)
    else:
        c.printf("copy selftest: %d checks, %d failures\n", checks, failures)
    ---
return: failures
