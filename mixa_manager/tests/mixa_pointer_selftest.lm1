predef: "mixa_manager/mixa_pointer.lm1"
include: "<stdio.h>" "<stdlib.h>"

# Task 27: eight octants from last nonzero half-cell displacement (UI_MODEL 6).

fn: expect_oct (int: got; int: want; const: @(char label); @: int failures) int
    if: got != want
        c.printf("mixa pointer: %s got=%d want=%d\n", label, got, want)
        failures[0]: failures[0] + 1
        return: 1
return: 0

fn: expect_cp (unsigned: got; unsigned: want; const: @(char label); @: int failures) int
    if: got != want
        c.printf("mixa pointer: %s cp got=U+%04X want=U+%04X\n", label, got, want)
        failures[0]: failures[0] + 1
        return: 1
return: 0

fn: expect_unchanged (@: MixaPointer p; int: want_oct; size_t: want_row; size_t: want_col; const: @(char label); @: int failures) int
    if: p\octant != want_oct || p\row != want_row || p\col != want_col || p\is_open != 1
        c.printf("mixa pointer: %s state oct=%d row=%u col=%u open=%d (want oct=%d row=%u col=%u open=1)\n", label, p\octant, (cast: (unsigned) p\row), (cast: (unsigned) p\col), p\is_open, want_oct, (cast: (unsigned) want_row), (cast: (unsigned) want_col))
        failures[0]: failures[0] + 1
        return: 1
return: 0

fn: main () int
    @: MixaPointer p
    int: failures
    int: oc
    int: rc
    size_t: max_sz
    failures: 0
    max_sz: (cast: (size_t) -1)

    p: (cast: (@: MixaPointer) c.calloc(1U, c.sizeof(c.MixaPointer)))
    if: p = 0
        c.printf("mixa pointer: alloc failed\n")
        return: 1
    if: mixa_pointer_init(p) != MIXA_POINTER_OK
        c.printf("mixa pointer: init failed\n")
        return: 1

    # Initial octant before any move: down-right U+2B0A
    expect_oct(p\octant, MIXA_POINTER_DOWN_RIGHT, "initial octant", @ failures)
    expect_cp(mixa_pointer_codepoint(p), MIXA_POINTER_CP_DOWN_RIGHT, "initial cp", @ failures)

    # Zero displacement leaves octant unchanged
    oc: mixa_pointer_octant_from_delta((cast: (i32) 0), (cast: (i32) 0), MIXA_POINTER_DOWN_RIGHT)
    expect_oct(oc, MIXA_POINTER_DOWN_RIGHT, "zero keeps prev", @ failures)
    if: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 0)) != MIXA_POINTER_OK
        c.printf("mixa pointer: zero nudge failed\n")
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_DOWN_RIGHT, "zero nudge octant", @ failures)
    if: p\row != 0U || p\col != 0U
        c.printf("mixa pointer: zero nudge moved position\n")
        failures: failures + 1

    # All eight octants (both signs)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 0), (cast: (i32) -10), 0), MIXA_POINTER_UP, "up", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 10), (cast: (i32) -10), 0), MIXA_POINTER_UP_RIGHT, "up-right", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 10), (cast: (i32) 0), 0), MIXA_POINTER_RIGHT, "right", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 10), (cast: (i32) 10), 0), MIXA_POINTER_DOWN_RIGHT, "down-right", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 0), (cast: (i32) 10), 0), MIXA_POINTER_DOWN, "down", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) -10), (cast: (i32) 10), 0), MIXA_POINTER_DOWN_LEFT, "down-left", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) -10), (cast: (i32) 0), 0), MIXA_POINTER_LEFT, "left", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) -10), (cast: (i32) -10), 0), MIXA_POINTER_UP_LEFT, "up-left", @ failures)

    # Codepoints for each octant
    expect_cp(mixa_pointer_codepoint_for_octant(MIXA_POINTER_UP), MIXA_POINTER_CP_UP, "cp up", @ failures)
    expect_cp(mixa_pointer_codepoint_for_octant(MIXA_POINTER_UP_RIGHT), MIXA_POINTER_CP_UP_RIGHT, "cp ur", @ failures)
    expect_cp(mixa_pointer_codepoint_for_octant(MIXA_POINTER_RIGHT), MIXA_POINTER_CP_RIGHT, "cp right", @ failures)
    expect_cp(mixa_pointer_codepoint_for_octant(MIXA_POINTER_DOWN_RIGHT), MIXA_POINTER_CP_DOWN_RIGHT, "cp dr", @ failures)
    expect_cp(mixa_pointer_codepoint_for_octant(MIXA_POINTER_DOWN), MIXA_POINTER_CP_DOWN, "cp down", @ failures)
    expect_cp(mixa_pointer_codepoint_for_octant(MIXA_POINTER_DOWN_LEFT), MIXA_POINTER_CP_DOWN_LEFT, "cp dl", @ failures)
    expect_cp(mixa_pointer_codepoint_for_octant(MIXA_POINTER_LEFT), MIXA_POINTER_CP_LEFT, "cp left", @ failures)
    expect_cp(mixa_pointer_codepoint_for_octant(MIXA_POINTER_UP_LEFT), MIXA_POINTER_CP_UP_LEFT, "cp ul", @ failures)

    # Boundary 5/12: just inside / just outside (strict <)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 12), (cast: (i32) 4), 0), MIXA_POINTER_RIGHT, "horiz inside +", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) -12), (cast: (i32) 4), 0), MIXA_POINTER_LEFT, "horiz inside -", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 12), (cast: (i32) -4), 0), MIXA_POINTER_RIGHT, "horiz inside + dy-", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 12), (cast: (i32) 5), 0), MIXA_POINTER_DOWN_RIGHT, "horiz outside +", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) -12), (cast: (i32) 5), 0), MIXA_POINTER_DOWN_LEFT, "horiz outside -", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 12), (cast: (i32) -5), 0), MIXA_POINTER_UP_RIGHT, "horiz outside dy-", @ failures)

    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 4), (cast: (i32) 12), 0), MIXA_POINTER_DOWN, "vert inside +", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 4), (cast: (i32) -12), 0), MIXA_POINTER_UP, "vert inside -", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) -4), (cast: (i32) 12), 0), MIXA_POINTER_DOWN, "vert inside dx-", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 5), (cast: (i32) 12), 0), MIXA_POINTER_DOWN_RIGHT, "vert outside +", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) -5), (cast: (i32) 12), 0), MIXA_POINTER_DOWN_LEFT, "vert outside -", @ failures)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) 5), (cast: (i32) -12), 0), MIXA_POINTER_UP_RIGHT, "vert outside dy-", @ failures)

    # Underflow position refused; octant must stay unchanged on failed nudge
    rc: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) -1))
    if: rc == MIXA_POINTER_OK
        c.printf("mixa pointer: nudge up from row0 should fail\n")
        failures: failures + 1
    expect_unchanged(p, MIXA_POINTER_DOWN_RIGHT, 0U, 0U, "failed pure-up nudge", @ failures)

    # Mixed-axis underflow: dx would succeed, dy underflows — ALL state unchanged
    # (review: prior code wrote col before validating dy)
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) -1))
    if: rc == MIXA_POINTER_OK
        c.printf("mixa pointer: mixed under dx+ dy- from origin should fail\n")
        failures: failures + 1
    expect_unchanged(p, MIXA_POINTER_DOWN_RIGHT, 0U, 0U, "mixed under dx+dy-", @ failures)

    # Mixed-axis underflow other order: park col>0 row=0; dx- ok then dy- fails
    p\row: 0U
    p\col: 10U
    p\octant: MIXA_POINTER_LEFT
    rc: mixa_pointer_nudge(p, (cast: (i32) -1), (cast: (i32) -1))
    if: rc == MIXA_POINTER_OK
        c.printf("mixa pointer: mixed under dx- dy- from row0 should fail\n")
        failures: failures + 1
    expect_unchanged(p, MIXA_POINTER_LEFT, 0U, 10U, "mixed under dx-dy-", @ failures)

    # Mixed-axis overflow: col at max; dx+ overflows, dy- would succeed
    p\row: 10U
    p\col: max_sz
    p\octant: MIXA_POINTER_UP
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) -1))
    if: rc == MIXA_POINTER_OK
        c.printf("mixa pointer: mixed over dx+ dy- at colmax should fail\n")
        failures: failures + 1
    expect_unchanged(p, MIXA_POINTER_UP, 10U, max_sz, "mixed over dx+dy-", @ failures)

    # Mixed-axis overflow: row at max; dx+ would succeed, dy+ overflows
    p\row: max_sz
    p\col: 10U
    p\octant: MIXA_POINTER_RIGHT
    rc: mixa_pointer_nudge(p, (cast: (i32) 1), (cast: (i32) 1))
    if: rc == MIXA_POINTER_OK
        c.printf("mixa pointer: mixed over dx+ dy+ at rowmax should fail\n")
        failures: failures + 1
    expect_unchanged(p, MIXA_POINTER_RIGHT, max_sz, 10U, "mixed over dx+dy+", @ failures)

    # Reset to origin for remaining park tests
    p\row: 0U
    p\col: 0U
    p\octant: MIXA_POINTER_DOWN_RIGHT

    # Park away from origin; move_to and nudge update octant + position
    if: mixa_pointer_move_to(p, 20U, 20U) != MIXA_POINTER_OK
        c.printf("mixa pointer: move_to park failed\n")
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_DOWN_RIGHT, "move_to park octant", @ failures)
    if: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) -3)) != MIXA_POINTER_OK
        c.printf("mixa pointer: nudge up from park failed\n")
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_UP, "nudge up from park", @ failures)
    if: p\row != 17U || p\col != 20U
        c.printf("mixa pointer: park nudge pos row=%u col=%u\n", (cast: (unsigned) p\row), (cast: (unsigned) p\col))
        failures: failures + 1
    if: mixa_pointer_nudge(p, (cast: (i32) 0), (cast: (i32) 0)) != MIXA_POINTER_OK
        c.printf("mixa pointer: zero after up failed\n")
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_UP, "zero keeps up", @ failures)
    expect_cp(mixa_pointer_codepoint(p), MIXA_POINTER_CP_UP, "zero keeps up cp", @ failures)

    if: mixa_pointer_move_to(p, p\row, p\col) != MIXA_POINTER_OK
        c.printf("mixa pointer: move_to same failed\n")
        failures: failures + 1
    expect_oct(p\octant, MIXA_POINTER_UP, "move_to same keeps up", @ failures)

    # INT32_MIN abs path: pure left (horizontal)
    expect_oct(mixa_pointer_octant_from_delta((cast: (i32) -2147483647) - (cast: (i32) 1), (cast: (i32) 0), MIXA_POINTER_UP), MIXA_POINTER_LEFT, "INT_MIN left", @ failures)

    mixa_pointer_release(p)
    c.free(p)

    if: failures != 0
        c.printf("mixa pointer selftest FAILED checks=%d\n", failures)
        return: 1
    c.printf("mixa pointer selftest ok\n")
    return: 0