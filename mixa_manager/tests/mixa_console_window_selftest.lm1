predef: "mixa_manager/mixa_console_window.lm1"
predef: "mixa_manager/mixa_file_win32.lm1"
include: "mixa_manager/mixa_backend_headless.h" "<stdio.h>" "<string.h>" "<stdlib.h>"

# Console view selftest (ticket 20260912-140500). Real, test-owned files
# under this run's own directory; every mutation stays inside that root.
# No user files.

fn: t_write_new (const: @(char path); const: @(char content); size_t: len) int
    @: MixaFile f
    size_t: wrote
    int: rc
    rc: mixa_file_open(@ f, path, MIXA_FILE_MODE_APPEND)
    if: rc != MIXA_FILE_OK
        return: rc
    ---
    wrote: 0U
    rc: mixa_file_append(f, content, len, @ wrote)
    mixa_file_close(f)
    if: rc != MIXA_FILE_OK
        return: rc
    ---
    if: wrote != len
        return: MIXA_FILE_ERR_IO
return: MIXA_FILE_OK

fn: t_open_read (const: @(char path)) @: MixaFile
    @: MixaFile f
    if: mixa_file_open(@ f, path, MIXA_FILE_MODE_READ) != MIXA_FILE_OK
        return: 0
return: f

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char p_empty 1040
    []: char p_short 1040
    []: char p_nonl 1040
    []: char p_wrap 1040
    []: char p_utf8 1040
    []: char p_long 1040
    []: char p_resize 1040
    []: char p_pend_empty 1040
    []: char p_pend_mid 1040
    []: char p_pend_wrap 1040
    []: char p_pend_hist 1040
    []: char p_pend_bottom 1040
    []: char cmd 2400
    []: char linebuf 64
    []: char dumpbuf 8192
    @: MixaConsoleView view
    @: MixaTextRect rect
    @: MixaFile f
    @: MixaCell cell
    int: i
    int: failures
    int: checks
    size_t: n
    c.setbuf((cast: (@: void) c.stdout), 0)
    failures: 0
    checks: 0

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    ---
    if: argc < 2
        c.snprintf(base, 520U, "build/mixa/claude/console_window/tmp")
    ---
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", base)
    c.system(cmd)
    c.snprintf(p_empty, 1040U, "%s\\empty.log", base)
    c.snprintf(p_short, 1040U, "%s\\short.log", base)
    c.snprintf(p_nonl, 1040U, "%s\\nonl.log", base)
    c.snprintf(p_wrap, 1040U, "%s\\wrap.log", base)
    c.snprintf(p_utf8, 1040U, "%s\\utf8.log", base)
    c.snprintf(p_long, 1040U, "%s\\long.log", base)
    c.snprintf(p_resize, 1040U, "%s\\resize.log", base)
    c.snprintf(p_pend_empty, 1040U, "%s\\pend_empty.log", base)
    c.snprintf(p_pend_mid, 1040U, "%s\\pend_mid.log", base)
    c.snprintf(p_pend_wrap, 1040U, "%s\\pend_wrap.log", base)
    c.snprintf(p_pend_hist, 1040U, "%s\\pend_hist.log", base)
    c.snprintf(p_pend_bottom, 1040U, "%s\\pend_bottom.log", base)

    view: (cast: (@: MixaConsoleView) c.calloc(1U, c.sizeof(c.MixaConsoleView)))
    rect: (cast: (@: MixaTextRect) c.calloc(1U, c.sizeof(c.MixaTextRect)))
    if: view = 0 || rect = 0
        c.printf("console_window: alloc failed\n")
        return: 1
    ---

    # --- Scenario 1: argument negatives -- checked first, before any real
    # file exists, so a later success cannot mask a broken null path.
    checks: checks + 1
    if: mixa_console_view_init(0, (cast: (@: MixaFile) 1), 5U, 10U) != MIXA_CONSOLE_ERR_ARG
        failures: failures + 1
        c.printf("console_window: null view not ERR_ARG\n")
    ---
    checks: checks + 1
    if: mixa_console_view_init(view, 0, 5U, 10U) != MIXA_CONSOLE_ERR_ARG
        failures: failures + 1
        c.printf("console_window: null file not ERR_ARG\n")
    ---
    t_write_new(p_empty, "", 0U)
    f: t_open_read(p_empty)
    checks: checks + 1
    if: f = 0
        failures: failures + 1
        c.printf("console_window: opening empty fixture failed\n")
        return: 1
    ---
    checks: checks + 1
    if: mixa_console_view_init(view, f, 0U, 10U) != MIXA_CONSOLE_ERR_ARG
        failures: failures + 1
        c.printf("console_window: rows=0 not ERR_ARG\n")
    ---
    checks: checks + 1
    if: mixa_console_view_init(view, f, 5U, 0U) != MIXA_CONSOLE_ERR_ARG
        failures: failures + 1
        c.printf("console_window: cols=0 not ERR_ARG\n")
    ---

    # --- Scenario 2: allocation failure -- an absurdly large rows count
    # that calloc(rows, sizeof(size_t)) genuinely cannot satisfy on any
    # real machine (rows * 8 bytes vastly exceeds available memory), a
    # real NOMEM path, not a simulated one.
    checks: checks + 1
    if: mixa_console_view_init(view, f, 100000000000U, 10U) != MIXA_CONSOLE_ERR_NOMEM
        failures: failures + 1
        c.printf("console_window: absurd rows did not report NOMEM\n")
    ---

    # --- Scenario 3: empty file. Cursor at top-left, exactly as
    # FIRST_VERSION.txt 5 settles it ("the file is empty, so the cursor is
    # at the TOP").
    checks: checks + 1
    if: mixa_console_view_init(view, f, 5U, 10U) != MIXA_CONSOLE_OK
        failures: failures + 1
        c.printf("console_window: empty-file init failed\n")
    ---
    checks: checks + 1
    if: view\top_offset != 0U || view\cursor_row != 0U || view\cursor_col != 0U || view\file_size != 0U
        failures: failures + 1
        c.printf("console_window: empty file layout top=%zu row=%zu col=%zu size=%zu\n", view\top_offset, view\cursor_row, view\cursor_col, view\file_size)
    ---
    checks: checks + 1
    if: mixa_rect_open(rect, 5U, 10U) != 0
        failures: failures + 1
        c.printf("console_window: rect_open failed\n")
        return: 1
    ---
    checks: checks + 1
    if: mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, 0) != MIXA_CONSOLE_OK
        failures: failures + 1
        c.printf("console_window: empty-file render failed\n")
    ---
    cell: mixa_cell_at(rect, 0U, 0U)
    checks: checks + 1
    if: cell = 0 || cell\codepoint != 32U || (cell\flags & MIXA_STYLE_REVERSE) = 0
        failures: failures + 1
        c.printf("console_window: empty-file cursor cell not a reversed space\n")
    ---
    mixa_rect_release(rect)
    mixa_file_close(f)

    # --- Scenario 4: short file, fewer wrapped rows than the viewport,
    # WITH a trailing newline -- the cursor's own row is a fresh empty row
    # after the last real line, not the last line itself.
    t_write_new(p_short, "abc\ndef\n", 8U)
    f: t_open_read(p_short)
    checks: checks + 1
    if: f = 0 || mixa_console_view_init(view, f, 5U, 10U) != MIXA_CONSOLE_OK
        failures: failures + 1
        c.printf("console_window: short-file init failed\n")
    ---
    checks: checks + 1
    if: view\top_offset != 0U || view\cursor_row != 2U || view\cursor_col != 0U
        failures: failures + 1
        c.printf("console_window: short-file layout top=%zu row=%zu col=%zu\n", view\top_offset, view\cursor_row, view\cursor_col)
    ---
    mixa_rect_open(rect, 5U, 10U)
    mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, 0)
    n: mixa_rect_dump(rect, dumpbuf, 8192U)
    checks: checks + 1
    if: n = 0U || c.strncmp(dumpbuf, "abc       \ndef       \n", 22U) != 0
        failures: failures + 1
        c.printf("console_window: short-file dump=[%s]\n", dumpbuf)
    ---
    mixa_rect_release(rect)
    mixa_file_close(f)

    # --- Scenario 5: final line WITHOUT a trailing newline -- the cursor
    # lands mid-row, at the exact column count of the last (in-progress)
    # line, not on a fresh row.
    t_write_new(p_nonl, "abc\ndef", 7U)
    f: t_open_read(p_nonl)
    checks: checks + 1
    if: f = 0 || mixa_console_view_init(view, f, 5U, 10U) != MIXA_CONSOLE_OK
        failures: failures + 1
        c.printf("console_window: no-trailing-newline init failed\n")
    ---
    checks: checks + 1
    if: view\cursor_row != 1U || view\cursor_col != 3U
        failures: failures + 1
        c.printf("console_window: no-trailing-newline cursor row=%zu col=%zu want 1/3\n", view\cursor_row, view\cursor_col)
    ---
    mixa_file_close(f)

    # --- Scenario 6: character-wrap boundary -- content wraps EXACTLY at
    # `cols`, never by word, and the boundary case (content length is an
    # exact multiple of cols) must push a fresh empty row for the cursor,
    # the same way an explicit trailing newline does.
    t_write_new(p_wrap, "abcdefgh", 8U)
    f: t_open_read(p_wrap)
    checks: checks + 1
    if: f = 0 || mixa_console_view_init(view, f, 5U, 4U) != MIXA_CONSOLE_OK
        failures: failures + 1
        c.printf("console_window: wrap-boundary init failed\n")
    ---
    checks: checks + 1
    if: view\cursor_row != 2U || view\cursor_col != 0U
        failures: failures + 1
        c.printf("console_window: wrap-boundary cursor row=%zu col=%zu want 2/0\n", view\cursor_row, view\cursor_col)
    ---
    mixa_rect_open(rect, 5U, 4U)
    mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, 0)
    n: mixa_rect_dump(rect, dumpbuf, 8192U)
    checks: checks + 1
    if: n = 0U || c.strncmp(dumpbuf, "abcd\nefgh\n", 10U) != 0
        failures: failures + 1
        c.printf("console_window: wrap-boundary dump=[%s]\n", dumpbuf)
    ---
    mixa_rect_release(rect)
    mixa_file_close(f)

    # --- Scenario 7: UTF-8 -- wrapping counts CODEPOINTS, not bytes.
    # "\xD0\xBF\xD1\x80\xD0\xB8\xD0\xB2\xD0\xB5\xD1\x82" is Cyrillic
    # "привет" (6 codepoints, 12 bytes) followed by a newline (13 bytes).
    # cols=6 must NOT wrap it (byte count would, codepoint count must not).
    t_write_new(p_utf8, "\xD0\xBF\xD1\x80\xD0\xB8\xD0\xB2\xD0\xB5\xD1\x82\n", 13U)
    f: t_open_read(p_utf8)
    checks: checks + 1
    if: f = 0 || mixa_console_view_init(view, f, 5U, 6U) != MIXA_CONSOLE_OK
        failures: failures + 1
        c.printf("console_window: utf8 init failed\n")
    ---
    # cols=6 exactly fits the 6-codepoint word, so the wrap check (which
    # fires the moment a row reaches `cols`, matching the wrap-boundary
    # scenario above) pushes a row for "привет" AND a second, empty row
    # right before the following '\n' is even decoded -- the same
    # exact-boundary-then-newline case scenario 6 already established,
    # just reached through codepoints instead of ASCII. Cursor is
    # therefore on row 2 (the THIRD row: word, the wrap-artifact empty
    # row, then the cursor's own fresh row), not row 1 -- proven by the
    # content check below landing on the right glyphs regardless.
    checks: checks + 1
    if: view\cursor_row != 2U || view\cursor_col != 0U
        failures: failures + 1
        c.printf("console_window: utf8 cursor row=%zu col=%zu want 2/0\n", view\cursor_row, view\cursor_col)
    ---
    mixa_rect_open(rect, 5U, 6U)
    mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, 0)
    cell: mixa_cell_at(rect, 0U, 0U)
    checks: checks + 1
    if: cell = 0 || cell\codepoint != 0x043FU
        failures: failures + 1
        c.printf("console_window: utf8 first cell codepoint=%u want 0x43F (Cyrillic pe)\n", cell\codepoint)
    ---
    cell: mixa_cell_at(rect, 0U, 5U)
    checks: checks + 1
    if: cell = 0 || cell\codepoint != 0x0442U
        failures: failures + 1
        c.printf("console_window: utf8 last cell codepoint=%u want 0x442 (Cyrillic te)\n", cell\codepoint)
    ---
    mixa_rect_release(rect)
    mixa_file_close(f)

    # --- Scenario 8: long file -- more than 128 wrapped rows, so no
    # hidden cap survives. 300 lines "L<idx>\n", cols wide enough that
    # each line is exactly one row, rows=20 viewport. Only the LAST 20
    # lines may be visible (scroll-follow); verified both by cursor
    # position and by reading the actual byte content AT top_offset,
    # which must be line 280 ("L281"), not line 0 or any cached value.
    f: 0
    if: 1
        []: (@: void) fh 1
        fh[0]: c.fopen(p_long, "wb")
        if: fh[0] != 0
            i: 0
            while: i < 300
                c.snprintf(linebuf, 64U, "L%d\n", i)
                c.fputs(linebuf, fh[0])
                i: i + 1
            ---
            c.fclose(fh[0])
        ---
    ---
    f: t_open_read(p_long)
    checks: checks + 1
    if: f = 0 || mixa_console_view_init(view, f, 20U, 10U) != MIXA_CONSOLE_OK
        failures: failures + 1
        c.printf("console_window: long-file init failed\n")
    ---
    checks: checks + 1
    if: view\cursor_row != 19U || view\cursor_col != 0U
        failures: failures + 1
        c.printf("console_window: long-file cursor row=%zu col=%zu want 19/0\n", view\cursor_row, view\cursor_col)
    ---
    checks: checks + 1
    if: view\top_offset = 0U
        failures: failures + 1
        c.printf("console_window: long-file top_offset still 0 -- scroll-follow did not move\n")
    ---
    mixa_rect_open(rect, 20U, 10U)
    mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, 0)
    n: mixa_rect_dump(rect, dumpbuf, 8192U)
    checks: checks + 1
    if: n = 0U || c.strncmp(dumpbuf, "L281      \n", 11U) != 0
        failures: failures + 1
        c.printf("console_window: long-file top row=[%.10s] want L281\n", dumpbuf)
    ---
    checks: checks + 1
    if: c.strstr(dumpbuf, "L299") = 0
        failures: failures + 1
        c.printf("console_window: long-file view does not show the last real line L299\n")
    ---
    mixa_rect_release(rect)

    # --- Scenario 9: resize recomputation. Same file, shrink cols so the
    # SAME lines now wrap into more rows, and shrink rows so fewer of them
    # fit -- both must be reflected by a fresh recompute, not a stale
    # cached layout from the previous geometry.
    checks: checks + 1
    if: mixa_console_view_resize(view, 8U, 2U) != MIXA_CONSOLE_OK
        failures: failures + 1
        c.printf("console_window: resize failed\n")
    ---
    checks: checks + 1
    if: view\rows != 8U || view\cols != 2U
        failures: failures + 1
        c.printf("console_window: resize did not update rows/cols\n")
    ---
    checks: checks + 1
    if: view\cursor_col >= 2U
        failures: failures + 1
        c.printf("console_window: resize cursor_col=%zu out of the new 2-wide bound\n", view\cursor_col)
    ---
    mixa_file_close(f)

    # --- Scenario 10: one real presented headless frame -- the render
    # hook (ticket requirement 3), through the real composite + present
    # pipeline, not a stand-in.
    t_write_new(p_resize, "hi\n", 3U)
    f: t_open_read(p_resize)
    checks: checks + 1
    if: f = 0 || mixa_console_view_init(view, f, 3U, 4U) != MIXA_CONSOLE_OK
        failures: failures + 1
        c.printf("console_window: present-scenario init failed\n")
    ---
    if: 1
        @: MixaBackend be
        @: MixaCellMetrics m
        @: MixaTextRect upper
        @: MixaU8 rgba
        size_t: width_px
        size_t: height_px
        size_t: rgba_size
        []: MixaU8 px 4
        const: @(MixaBackendVTable vt)
        mixa_rect_open(rect, 3U, 4U)
        upper: (cast: (@: MixaTextRect) c.calloc(1U, c.sizeof(c.MixaTextRect)))
        mixa_rect_open(upper, 3U, 4U)
        m: (cast: (@: MixaCellMetrics) c.calloc(1U, c.sizeof(c.MixaCellMetrics)))
        m\text_cell_width: 4U
        m\text_cell_height: 6U
        m\upper_cell_width: 4U
        m\upper_cell_height: 6U
        m\pointer_cell_width: 4U
        m\pointer_cell_height: 6U
        vt: mixa_backend_headless_table()
        be: 0
        checks: checks + 1
        if: mixa_backend_open(vt, @ be, 4U, 3U, m) != 0
            failures: failures + 1
            c.printf("console_window: headless backend open failed\n")
        ---
        width_px: 4U * 4U
        height_px: 3U * 6U
        rgba_size: width_px * height_px * 4U
        rgba: (cast: (@: MixaU8) c.calloc(rgba_size, 1U))
        checks: checks + 1
        if: mixa_console_window_present(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, upper, 4U, 6U, 4U, 6U, be, rgba, rgba_size, width_px, height_px, 0) != MIXA_CONSOLE_OK
            failures: failures + 1
            c.printf("console_window: present failed\n")
        ---
        checks: checks + 1
        if: mixa_headless_frame_at(be, 0U, 0U, px) != 0
            failures: failures + 1
            c.printf("console_window: frame_at failed after present\n")
        ---
        checks: checks + 1
        if: px[3] != 255U
            failures: failures + 1
            c.printf("console_window: presented frame pixel not opaque (alpha=%u)\n", px[3])
        ---
        mixa_backend_close(be)
        mixa_rect_release(upper)
        c.free(upper)
        c.free(m)
        c.free(rgba)
        mixa_rect_release(rect)
    ---
    mixa_file_close(f)

    # --- Scenario 11: present() argument negatives.
    checks: checks + 1
    if: mixa_console_window_present(0, 0, 0U, 0U, 0U, 0U, 0U, 0U, 0, 0U, 0U, 0U, 0U, 0, 0, 0U, 0U, 0U, 0) != MIXA_CONSOLE_ERR_ARG
        failures: failures + 1
        c.printf("console_window: present null-args not ERR_ARG\n")
    ---

    # --- Scenario 12 (ticket 20260913-004717): an EMPTY pending line
    # (len=0, cursor=0) over an otherwise-empty file. Must be visually
    # IDENTICAL to the legacy null-pending case: the cursor is a reversed
    # space at (0,0) -- proving len=0 draws nothing extra and moves
    # nothing.
    t_write_new(p_pend_empty, "", 0U)
    f: t_open_read(p_pend_empty)
    mixa_console_view_init(view, f, 5U, 10U)
    mixa_rect_open(rect, 5U, 10U)
    if: 1
        @: MixaConsolePending pend
        pend: (cast: (@: MixaConsolePending) c.calloc(1U, c.sizeof(c.MixaConsolePending)))
        pend\cps: 0
        pend\len: 0U
        pend\cursor: 0U
        checks: checks + 1
        if: mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, pend) != MIXA_CONSOLE_OK
            failures: failures + 1
            c.printf("console_window: pending-empty render failed\n")
        ---
        cell: mixa_cell_at(rect, 0U, 0U)
        checks: checks + 1
        if: cell = 0 || cell\codepoint != 32U || (cell\flags & MIXA_STYLE_REVERSE) = 0
            failures: failures + 1
            c.printf("console_window: pending-empty cursor cell not a reversed space\n")
        ---
        c.free(pend)
    ---
    mixa_rect_release(rect)
    mixa_file_close(f)

    # --- Scenario 13: pending line WITH content, cursor in the MIDDLE
    # ("ab|cd", cursor at index 2 -- between 'b' and 'c'). The reversed
    # cell must land ON the character the cursor is AT ('c'), not on a
    # blank one past it -- a real block-cursor-on-a-character behavior,
    # distinct from the file's own "one past the end" convention, and an
    # explicit, deliberate "ordinary implementation choice" this ticket
    # says needs no further question.
    t_write_new(p_pend_mid, "", 0U)
    f: t_open_read(p_pend_mid)
    mixa_console_view_init(view, f, 5U, 10U)
    mixa_rect_open(rect, 5U, 10U)
    if: 1
        []: unsigned mid_cps 4
        @: MixaConsolePending pend
        mid_cps[0]: 97U
        mid_cps[1]: 98U
        mid_cps[2]: 99U
        mid_cps[3]: 100U
        pend: (cast: (@: MixaConsolePending) c.calloc(1U, c.sizeof(c.MixaConsolePending)))
        pend\cps: mid_cps
        pend\len: 4U
        pend\cursor: 2U
        checks: checks + 1
        if: mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, pend) != MIXA_CONSOLE_OK
            failures: failures + 1
            c.printf("console_window: pending-mid render failed\n")
        ---
        n: mixa_rect_dump(rect, dumpbuf, 8192U)
        checks: checks + 1
        if: n = 0U || c.strncmp(dumpbuf, "abcd", 4U) != 0
            failures: failures + 1
            c.printf("console_window: pending-mid text=[%.10s] want starting [abcd]\n", dumpbuf)
        ---
        cell: mixa_cell_at(rect, 0U, 2U)
        checks: checks + 1
        if: cell = 0 || cell\codepoint != 99U || (cell\flags & MIXA_STYLE_REVERSE) = 0
            failures: failures + 1
            c.printf("console_window: pending-mid cursor should reverse 'c' at col 2, codepoint=%u flags=%u\n", cell\codepoint, cell\flags)
        ---
        cell: mixa_cell_at(rect, 0U, 0U)
        checks: checks + 1
        if: cell = 0 || (cell\flags & MIXA_STYLE_REVERSE) != 0
            failures: failures + 1
            c.printf("console_window: pending-mid col 0 should NOT be reversed\n")
        ---
        c.free(pend)
    ---
    mixa_rect_release(rect)
    mixa_file_close(f)

    # --- Scenario 14: cursor at the pending line's own END (cursor ==
    # len) -- the reversed cell is a blank ONE PAST the last real
    # character, matching the file's own end-of-content convention
    # exactly (render()'s own header comment: "it is always one past the
    # last written character").
    t_write_new(p_pend_mid, "", 0U)
    f: t_open_read(p_pend_mid)
    mixa_console_view_init(view, f, 5U, 10U)
    mixa_rect_open(rect, 5U, 10U)
    if: 1
        []: unsigned end_cps 2
        @: MixaConsolePending pend
        end_cps[0]: 120U
        end_cps[1]: 121U
        pend: (cast: (@: MixaConsolePending) c.calloc(1U, c.sizeof(c.MixaConsolePending)))
        pend\cps: end_cps
        pend\len: 2U
        pend\cursor: 2U
        mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, pend)
        cell: mixa_cell_at(rect, 0U, 2U)
        checks: checks + 1
        if: cell = 0 || cell\codepoint != 32U || (cell\flags & MIXA_STYLE_REVERSE) = 0
            failures: failures + 1
            c.printf("console_window: pending-end cursor cell not a reversed space past 'xy'\n")
        ---
        cell: mixa_cell_at(rect, 0U, 1U)
        checks: checks + 1
        if: cell = 0 || cell\codepoint != 121U || (cell\flags & MIXA_STYLE_REVERSE) != 0
            failures: failures + 1
            c.printf("console_window: pending-end 'y' at col 1 should be plain, not reversed\n")
        ---
        c.free(pend)
    ---
    mixa_rect_release(rect)
    mixa_file_close(f)

    # --- Scenario 15: pending content WRAPS across rows, BY CHARACTER
    # (never by word) -- a 6-character pending line on a 4-column
    # viewport wraps exactly like committed content already does
    # (scenario 6 above), continuing from row 0 col 0 since the file
    # itself is empty.
    t_write_new(p_pend_wrap, "", 0U)
    f: t_open_read(p_pend_wrap)
    mixa_console_view_init(view, f, 5U, 4U)
    mixa_rect_open(rect, 5U, 4U)
    if: 1
        []: unsigned wrap_cps 6
        @: MixaConsolePending pend
        wrap_cps[0]: 49U
        wrap_cps[1]: 50U
        wrap_cps[2]: 51U
        wrap_cps[3]: 52U
        wrap_cps[4]: 53U
        wrap_cps[5]: 54U
        pend: (cast: (@: MixaConsolePending) c.calloc(1U, c.sizeof(c.MixaConsolePending)))
        pend\cps: wrap_cps
        pend\len: 6U
        pend\cursor: 6U
        checks: checks + 1
        if: mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, pend) != MIXA_CONSOLE_OK
            failures: failures + 1
            c.printf("console_window: pending-wrap render failed\n")
        ---
        cell: mixa_cell_at(rect, 0U, 0U)
        checks: checks + 1
        if: cell = 0 || cell\codepoint != 49U
            failures: failures + 1
            c.printf("console_window: pending-wrap row0 col0 codepoint=%u want '1'\n", cell\codepoint)
        ---
        cell: mixa_cell_at(rect, 1U, 1U)
        checks: checks + 1
        if: cell = 0 || cell\codepoint != 54U
            failures: failures + 1
            c.printf("console_window: pending-wrap row1 col1 codepoint=%u want '6' (wrapped to the next row)\n", cell\codepoint)
        ---
        # cursor==len (6): one past the last character, which wrapped
        # onto row 1 col 2.
        cell: mixa_cell_at(rect, 1U, 2U)
        checks: checks + 1
        if: cell = 0 || (cell\flags & MIXA_STYLE_REVERSE) = 0
            failures: failures + 1
            c.printf("console_window: pending-wrap cursor should be reversed at row1 col2 (wrapped end)\n")
        ---
        c.free(pend)
    ---
    mixa_rect_release(rect)
    mixa_file_close(f)

    # --- Scenario 16: real committed HISTORY plus a pending line
    # together -- pending must start EXACTLY where the committed content
    # left off (continuing the SAME row/col the file's own cursor would
    # otherwise occupy), never overwriting or skipping a row.
    t_write_new(p_pend_hist, "ab\n", 3U)
    f: t_open_read(p_pend_hist)
    mixa_console_view_init(view, f, 5U, 10U)
    checks: checks + 1
    if: view\cursor_row != 1U || view\cursor_col != 0U
        failures: failures + 1
        c.printf("console_window: pending-hist file cursor row=%zu col=%zu want 1/0\n", view\cursor_row, view\cursor_col)
    ---
    mixa_rect_open(rect, 5U, 10U)
    if: 1
        []: unsigned hist_cps 2
        @: MixaConsolePending pend
        hist_cps[0]: 122U
        hist_cps[1]: 122U
        pend: (cast: (@: MixaConsolePending) c.calloc(1U, c.sizeof(c.MixaConsolePending)))
        pend\cps: hist_cps
        pend\len: 2U
        pend\cursor: 0U
        checks: checks + 1
        if: mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, pend) != MIXA_CONSOLE_OK
            failures: failures + 1
            c.printf("console_window: pending-hist render failed\n")
        ---
        n: mixa_rect_dump(rect, dumpbuf, 8192U)
        checks: checks + 1
        if: n = 0U || c.strncmp(dumpbuf, "ab", 2U) != 0
            failures: failures + 1
            c.printf("console_window: pending-hist committed text missing, dump=[%.20s]\n", dumpbuf)
        ---
        cell: mixa_cell_at(rect, 1U, 0U)
        checks: checks + 1
        if: cell = 0 || cell\codepoint != 122U
            failures: failures + 1
            c.printf("console_window: pending-hist pending 'z' should start at row1 col0 (right after 'ab\\n'), codepoint=%u\n", cell\codepoint)
        ---
        # The reversed cursor must be on the pending line now, NOT on the
        # file's own former end-of-content position -- proven by row 0
        # (the "ab" row) carrying no reverse flag anywhere.
        cell: mixa_cell_at(rect, 0U, 0U)
        checks: checks + 1
        if: cell = 0 || (cell\flags & MIXA_STYLE_REVERSE) != 0
            failures: failures + 1
            c.printf("console_window: pending-hist committed row must not carry the cursor\n")
        ---
        cell: mixa_cell_at(rect, 1U, 0U)
        checks: checks + 1
        if: cell = 0 || (cell\flags & MIXA_STYLE_REVERSE) = 0
            failures: failures + 1
            c.printf("console_window: pending-hist cursor should be at row1 col0 (pending\\cursor=0)\n")
        ---
        c.free(pend)
    ---
    mixa_rect_release(rect)
    mixa_file_close(f)

    # --- Scenario 17: BOTTOM BOUNDARY -- a pending line long enough that
    # some of its own characters (and its own cursor) would land AT OR
    # PAST the viewport's last row. Those characters are not drawn, and
    # the cursor is reported off-screen (not marked anywhere, including
    # not clamped to some in-bounds cell) rather than wrapped around to a
    # wrong location -- mixa_cmdline_char_position's own already-tested
    # boundary rule, honored here too.
    t_write_new(p_pend_bottom, "", 0U)
    f: t_open_read(p_pend_bottom)
    mixa_console_view_init(view, f, 2U, 2U)
    mixa_rect_open(rect, 2U, 2U)
    if: 1
        []: unsigned bot_cps 6
        @: MixaConsolePending pend
        i: 0
        while: i < 6
            bot_cps[i]: 65U + (cast: (unsigned) i)
            i: i + 1
        ---
        pend: (cast: (@: MixaConsolePending) c.calloc(1U, c.sizeof(c.MixaConsolePending)))
        pend\cps: bot_cps
        pend\len: 6U
        pend\cursor: 5U
        checks: checks + 1
        if: mixa_console_view_render(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, pend) != MIXA_CONSOLE_OK
            failures: failures + 1
            c.printf("console_window: pending-bottom render failed\n")
        ---
        # Only 4 cells exist (2x2): 'A','B' on row0, 'C','D' on row1 --
        # 'E'/'F' and the cursor (index 5) fall off the bottom and must
        # not appear or be marked anywhere in the rect.
        n: mixa_rect_dump(rect, dumpbuf, 8192U)
        checks: checks + 1
        if: n = 0U || c.strncmp(dumpbuf, "AB\nCD\n", 6U) != 0
            failures: failures + 1
            c.printf("console_window: pending-bottom visible text=[%.10s] want [AB/CD]\n", dumpbuf)
        ---
        checks: checks + 1
        if: c.strstr(dumpbuf, "E") != 0 || c.strstr(dumpbuf, "F") != 0
            failures: failures + 1
            c.printf("console_window: pending-bottom characters past the last row leaked into the rect\n")
        ---
        cell: mixa_cell_at(rect, 0U, 0U)
        checks: checks + 1
        if: cell = 0 || (cell\flags & MIXA_STYLE_REVERSE) != 0
            failures: failures + 1
            c.printf("console_window: pending-bottom off-screen cursor must not be marked anywhere\n")
        ---
        cell: mixa_cell_at(rect, 1U, 1U)
        checks: checks + 1
        if: cell = 0 || (cell\flags & MIXA_STYLE_REVERSE) != 0
            failures: failures + 1
            c.printf("console_window: pending-bottom off-screen cursor must not be clamped to the last visible cell either\n")
        ---
        c.free(pend)
    ---
    mixa_rect_release(rect)
    mixa_file_close(f)

    # --- Scenario 18: legacy equivalence, EXPLICIT A/B -- null pending
    # and an explicit len=0 pending struct over real committed history
    # must render IDENTICAL rects, byte for byte.
    t_write_new(p_pend_hist, "hi\n", 3U)
    f: t_open_read(p_pend_hist)
    mixa_console_view_init(view, f, 5U, 10U)
    if: 1
        @: MixaTextRect rect_a
        @: MixaTextRect rect_b
        @: MixaConsolePending pend0
        []: char dump_a 8192
        []: char dump_b 8192
        rect_a: (cast: (@: MixaTextRect) c.calloc(1U, c.sizeof(c.MixaTextRect)))
        rect_b: (cast: (@: MixaTextRect) c.calloc(1U, c.sizeof(c.MixaTextRect)))
        mixa_rect_open(rect_a, 5U, 10U)
        mixa_rect_open(rect_b, 5U, 10U)
        mixa_console_view_render(view, rect_a, 0U, 0U, 7U, 0U, 0U, 255U, 0)
        pend0: (cast: (@: MixaConsolePending) c.calloc(1U, c.sizeof(c.MixaConsolePending)))
        pend0\cps: 0
        pend0\len: 0U
        pend0\cursor: 0U
        mixa_console_view_render(view, rect_b, 0U, 0U, 7U, 0U, 0U, 255U, pend0)
        mixa_rect_dump(rect_a, dump_a, 8192U)
        mixa_rect_dump(rect_b, dump_b, 8192U)
        checks: checks + 1
        if: c.strcmp(dump_a, dump_b) != 0
            failures: failures + 1
            c.printf("console_window: null-pending vs empty-pending diverged: [%s] vs [%s]\n", dump_a, dump_b)
        ---
        c.free(pend0)
        mixa_rect_release(rect_a)
        mixa_rect_release(rect_b)
        c.free(rect_a)
        c.free(rect_b)
    ---
    mixa_file_close(f)

    c.free(view)
    c.free(rect)

    if: failures = 0
        c.printf("console window selftest: %d checks, 0 failures\n", checks)
    else:
        c.printf("console window selftest: %d checks, %d failures\n", checks, failures)
    ---
return: failures
