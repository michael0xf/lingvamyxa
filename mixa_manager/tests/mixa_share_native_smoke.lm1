predef: "mixa_manager/mixa_share_win32.h.lm1"
predef: "mixa_manager/mixa_share.h.lm1"
predef: "mixa_manager/mixa_share.lm1"
predef: "mixa_manager/mixa_share_win32.lm1"
include: "<stdio.h>" "<windows.h>" "<roapi.h>"

# Native Windows Share smoke test (ticket 20260911-210200). Real
# IDataTransferManagerInterop/DataTransferManager/DataRequested/
# ShowShareUIForWindow round trip against a real (visible, message-pumped)
# window -- distinct from and in addition to the deterministic fake-backend
# selftest, not a replacement for it. This asserts only what the backend
# actually knows: that begin() reaches PENDING, the OS calls our
# DataRequested handler (Invoke) and hands the request off, i.e. event
# transitions PENDING -> HANDED_OFF within a bounded wait. It does NOT (and
# cannot) assert that a human saw the share UI or chose a target -- see
# mixa_share.txt's "honest platform behavior" note.
#
# Text-only: no file is shared or opened, matching this slice's scope.
# Best-effort dismissal: sends Escape after a short delay to close the
# real OS share flyout if it appeared, so the test does not require manual
# interaction to finish; the pass/fail result does not depend on whether
# dismissal succeeded.

fn: mixa_share_smoke_wndproc (HWND: hwnd; UINT: msg; WPARAM: wparam; LPARAM: lparam) LRESULT
return: c.DefWindowProcW(hwnd, msg, wparam, lparam)

# Regression for ticket 20260912-001200 item 1: the portable
# mixa_share_destroy() used to free r/text/title/files unconditionally
# even when the backend's own destroy refused (wrong thread) -- a
# use-after-free waiting for a later, legitimately-delivered callback on
# the real owning thread. This thread proc calls the PUBLIC portable
# mixa_share_destroy() (not the backend function directly -- the review's
# explicit point was that testing the backend alone missed the portable
# wrapper's bug) on a request it does not own, from a real second OS
# thread. param is the MixaShareRequest* to (attempt to) destroy.
fn: mixa_share_smoke_destroy_thread_proc (@: void param) ulong
    mixa_share_destroy((cast: (@: MixaShareRequest) param))
return: 0U

# Regression for ticket 20260912-001200 item 2: begin() must reject a
# genuinely wrong apartment, not just record whatever thread happened to
# call it. This thread proc initializes ITSELF as MTA (RO_INIT_
# MULTITHREADED) -- deliberately the wrong apartment for this handler --
# then calls the full public create/set_text/set_context/begin/destroy
# sequence, writing begin()'s return code to the global below (single
# in-flight test, no concurrent access, so a plain global is fine -- this
# thread proc cannot use an L1 struct parameter since `struct:` is only
# permitted in .h.lm1 files, not this .lm1). param is the HWND to use.
# g_wrong_apt_ro_hr records RoInitialize's own HRESULT (ticket
# 20260912-004800: the test must confirm RoInitialize actually SUCCEEDED
# in establishing MTA on this thread, not just call it and assume so --
# a failed call would leave the thread's real apartment state unproven,
# making a "begin correctly rejected MTA" conclusion baseless).
int: g_wrong_apt_begin_rc
long: g_wrong_apt_ro_hr
fn: mixa_share_smoke_wrong_apartment_thread_proc (@: void param) ulong
    @: MixaShareRequest r3
    int: st
    long: ro_hr
    g_wrong_apt_begin_rc: -1
    g_wrong_apt_ro_hr: -1
    ro_hr: c.RoInitialize(c.RO_INIT_MULTITHREADED)
    g_wrong_apt_ro_hr: ro_hr
    if: ro_hr != 0
        return: 0U
    st: mixa_share_create(@ r3, mixa_share_win32_table())
    if: st != MIXA_SHARE_OK
        g_wrong_apt_begin_rc: st
        c.RoUninitialize()
        return: 0U
    mixa_share_set_text(r3, "wrong apartment test")
    mixa_share_set_context(r3, param)
    st: mixa_share_begin(r3)
    g_wrong_apt_begin_rc: st
    mixa_share_destroy(r3)
    c.RoUninitialize()
return: 0U

fn: mixa_share_smoke_pump_once (@: MSG pmsg) void
    while: c.PeekMessageW(pmsg, 0, 0U, 0U, 1U) != 0
        c.TranslateMessage(pmsg)
        c.DispatchMessageW(pmsg)
end: mixa_share_smoke_pump_once

# Creates a fresh top-level window from the already-registered smoke
# window class. Diagnostic (ticket follow-up): reusing a single hwnd
# across several back-to-back real ShowShareUIForWindow round trips left
# every round trip after the first permanently PENDING, even after
# dismissing the OS share flyout with Escape between them -- so the
# fix under test is per-request window isolation instead, matching real
# app usage where a share request originates from whatever window is
# frontmost at that moment, not a single long-lived window reused
# thousands of times.
fn: mixa_share_smoke_new_window (@: void hinst) @: void
    @: void hwnd
    hwnd: (cast: (@: void) c.CreateWindowExW(0U, (cast: (@: wchar_t) L"MixaShareNativeSmokeWnd"), (cast: (@: wchar_t) L"mixa share native smoke"), 13565952U, 100, 100, 320, 200, 0, 0, (cast: (HINSTANCE) hinst), 0))
    if: hwnd = 0
        c.printf("mixa share native smoke: CreateWindowExW (per-request) failed gle=%lu\n", c.GetLastError())
        return: 0
    c.ShowWindow((cast: (HWND) hwnd), 5)
    c.UpdateWindow((cast: (HWND) hwnd))
    # Decisive fix (ticket 20260912-004800's bounded baseline diagnostic,
    # mixa_share_baseline_diag.lm1): ShowWindow/UpdateWindow alone do not
    # make a newly-created window the actual foreground window once
    # another window (e.g. an earlier request's real Share flyout) has
    # held focus -- Windows restricts which windows may take foreground
    # focus for themselves. Without an explicit SetForegroundWindow, only
    # the first one or two real ShowShareUIForWindow calls in a process
    # ever got a DataRequested callback; with it, 10/10 real invocations
    # succeeded across two full diagnostic runs (3 clean-only in a row,
    # then a fault-then-clean pair). See mixa_share.txt's "Diagnostic
    # detour" item 6 for the full writeup.
    c.SetForegroundWindow((cast: (HWND) hwnd))
return: hwnd

# Diagnostic (ticket 20260911-234500 item: "verify ordinary successive
# requests on the SAME live app window; fresh HWND per request does not
# cover UI reuse"): runs one request against a CALLER-OWNED window, doing
# no window creation/destruction of its own, so two calls in a row on the
# same hwnd can be compared against the fresh-window-per-request results
# above. Does not retry -- this is meant to observe the real behavior, not
# to make it pass.
fn: mixa_share_smoke_run_on_hwnd (@: void hwnd; int: fail_mask; @: int out_event; @: int out_status) void
    @: MixaShareRequest rr
    []: MSG lmsg 1
    int: st
    int: ev
    int: status
    int: i
    st: mixa_share_create(@ rr, mixa_share_win32_table())
    if: st != MIXA_SHARE_OK
        out_event[0]: -1
        out_status[0]: st
        return
    mixa_share_set_text(rr, "mixa same-window diagnostic text")
    mixa_share_set_context(rr, hwnd)
    mixa_share_test_set_force_fail(rr, fail_mask)
    # Re-assert foreground before EACH call, not just once when the window
    # was first created: testing whether the fresh-window fix's mechanism
    # (SetForegroundWindow) also resolves same-window reuse when reasserted
    # per-call, or whether reuse has a separate remaining cause.
    c.SetForegroundWindow((cast: (HWND) hwnd))
    st: mixa_share_begin(rr)
    if: st != MIXA_SHARE_OK
        out_event[0]: mixa_share_event(rr)
        out_status[0]: st
        mixa_share_destroy(rr)
        return
    ev: MIXA_SHARE_EVENT_PENDING
    i: 0
    while: i < 100
        mixa_share_smoke_pump_once(@ lmsg[0])
        mixa_share_poll(rr, @ ev, @ status)
        if: ev != MIXA_SHARE_EVENT_PENDING
            break
        c.Sleep(50U)
        i: i + 1
    out_event[0]: ev
    out_status[0]: status
    mixa_share_destroy(rr)
    i: 0
    while: i < 20
        mixa_share_smoke_pump_once(@ lmsg[0])
        c.Sleep(50U)
        i: i + 1
    c.keybd_event(27U, 0U, 0U, 0U)
    c.keybd_event(27U, 0U, 2U, 0U)
    i: 0
    while: i < 20
        mixa_share_smoke_pump_once(@ lmsg[0])
        c.Sleep(50U)
        i: i + 1
end: mixa_share_smoke_run_on_hwnd

# Single attempt: create a fresh window, run one request to completion
# against the real adapter with the given fault-injection mask (0 for
# none), pumping messages for a bounded wait, tear the window down, and
# report the terminal (event, status) pair. See mixa_share_smoke_run_fault
# below for why callers retry a PENDING result instead of treating it as
# final.
fn: mixa_share_smoke_run_fault_once (@: void hinst; int: fail_mask; @: int out_event; @: int out_status) void
    @: MixaShareRequest rr
    []: MSG lmsg 1
    @: void hwnd
    int: st
    int: ev
    int: status
    int: i
    hwnd: mixa_share_smoke_new_window(hinst)
    if: hwnd = 0
        out_event[0]: -1
        out_status[0]: MIXA_SHARE_ERR_BACKEND
        return
    # Let the new window fully settle (created, shown, painted) before
    # asking the OS for its DataTransferManager.
    i: 0
    while: i < 10
        mixa_share_smoke_pump_once(@ lmsg[0])
        c.Sleep(50U)
        i: i + 1
    st: mixa_share_create(@ rr, mixa_share_win32_table())
    if: st != MIXA_SHARE_OK
        out_event[0]: -1
        out_status[0]: st
        c.DestroyWindow((cast: (HWND) hwnd))
        return
    mixa_share_set_text(rr, "mixa fault-injection test text")
    mixa_share_set_context(rr, hwnd)
    mixa_share_test_set_force_fail(rr, fail_mask)
    st: mixa_share_begin(rr)
    if: st != MIXA_SHARE_OK
        out_event[0]: mixa_share_event(rr)
        out_status[0]: st
        mixa_share_destroy(rr)
        c.DestroyWindow((cast: (HWND) hwnd))
        return
    ev: MIXA_SHARE_EVENT_PENDING
    i: 0
    while: i < 100
        mixa_share_smoke_pump_once(@ lmsg[0])
        mixa_share_poll(rr, @ ev, @ status)
        if: ev != MIXA_SHARE_EVENT_PENDING
            break
        c.Sleep(50U)
        i: i + 1
    out_event[0]: ev
    out_status[0]: status
    mixa_share_destroy(rr)
    i: 0
    while: i < 20
        mixa_share_smoke_pump_once(@ lmsg[0])
        c.Sleep(50U)
        i: i + 1
    c.keybd_event(27U, 0U, 0U, 0U)
    c.keybd_event(27U, 0U, 2U, 0U)
    i: 0
    while: i < 20
        mixa_share_smoke_pump_once(@ lmsg[0])
        c.Sleep(50U)
        i: i + 1
    c.DestroyWindow((cast: (HWND) hwnd))
    i: 0
    while: i < 10
        mixa_share_smoke_pump_once(@ lmsg[0])
        c.Sleep(50U)
        i: i + 1
end: mixa_share_smoke_run_fault_once

# Diagnostic findings, in order tried, against real ShowShareUIForWindow/
# DataRequested round trips on this machine:
#  1. Dismissing the OS share flyout with Escape between back-to-back real
#     calls on the SAME reused hwnd did not fix a permanent-PENDING hang
#     from the second real round trip onward -- ruled out "leftover flyout
#     left on screen".
#  2. Giving every request its own freshly-created hwnd instead reduced
#     but did not eliminate the hangs, and which specific fault test hung
#     was NOT consistent between runs (e.g. one run hung on SET_TEXT then
#     recovered for PUT_TITLE then hung again for the clean request; another
#     run instead had SET_TEXT succeed and PUT_TITLE hang). Under the
#     apartment-type bug present at the time (RO_INIT_MULTITHREADED instead
#     of SINGLETHREADED, fixed separately), TOKEN_ALLOC and GET_DATA -- the
#     first two real invocations in the process -- succeeded in every run
#     observed; later ones failed unpredictably regardless of which field
#     was under test, window identity, or added inter-request delay. Once
#     the apartment type was fixed to genuine STA, this became a fully
#     deterministic "exactly the first two real invocations succeed, every
#     one after that hangs" pattern instead (see mixa_share.txt's
#     "Diagnostic detour" item 4) -- CAUSE NOT ESTABLISHED. Per ticket
#     20260912-004800's review: an app-level HRESULT trace of every
#     registration/callback/unregister step showed S_OK at each one, but
#     that does not prove the application window, activation/pump,
#     callback lifetime, or a prior request's teardown were actually
#     correct -- it only rules out an unchecked failing HRESULT in that
#     specific call chain. Separately, and independently of this open hang,
#     our own fault-injection/status-propagation logic DID report the
#     correct FAILED event and non-OK status for every one of the four
#     fault types whenever the real callback did arrive.
# Given that, a single flaky real invocation is treated as inconclusive and
# retried (with a brand-new window each attempt, same as every other call)
# rather than as a genuine fault-handling defect; only a result that is
# never anything but PENDING across every attempt is reported as a failure.
fn: mixa_share_smoke_run_fault (@: void hinst; int: fail_mask; @: int out_event; @: int out_status) void
    int: attempt
    attempt: 0
    while: attempt < 3
        mixa_share_smoke_run_fault_once(hinst, fail_mask, out_event, out_status)
        if: out_event[0] != MIXA_SHARE_EVENT_PENDING
            if: attempt > 0
                c.printf("mixa share native smoke: mask=%d needed retry (attempt %d) -- cause of the PENDING attempt(s) before this is not established\n", fail_mask, attempt + 1)
            return
        c.printf("mixa share native smoke: mask=%d attempt %d stayed PENDING (cause not established), retrying with a fresh window\n", fail_mask, attempt + 1)
        attempt: attempt + 1
end: mixa_share_smoke_run_fault

fn: main () int
    @: void hinst
    []: WNDCLASSEXW wc 1
    @: WNDCLASSEXW pwc
    @: void hwnd
    @: MixaShareRequest r2
    @: void thr
    []: DWORD thr_id 1
    int: fc
    ulong: wait_rc
    int: st
    long: ro_hr
    int: failures
    int: checks

    failures: 0
    checks: 0
    # Verified against MinGW's own roapi.h (RO_INIT_TYPE): SINGLETHREADED=0,
    # MULTITHREADED=1. This adapter's handler object (mixa_share_win32.h.lm1,
    # MixaShareHandlerObj) documents plain non-atomic refcounts on the STA
    # assumption that COM marshals every call onto one apartment thread --
    # the smoke test previously initialized with the numeric literal 1U,
    # which is actually RO_INIT_MULTITHREADED, contradicting that assumption
    # instead of exercising it. Fixed to the symbolic STA constant.
    ro_hr: c.RoInitialize(c.RO_INIT_SINGLETHREADED)
    c.printf("mixa share native smoke: RoInitialize hr=%ld\n", ro_hr)

    # Direct QueryInterface coverage (ticket 20260911-225400 item 1): an
    # unsupported riid must be refused with E_NOINTERFACE and a null ppv,
    # not silently satisfied with the wrong object. Exercises the handler's
    # vtable functions directly -- no WinRT round trip needed for this part.
    []: MixaShareHandlerObj hobj 1
    []: MixaShareHandlerVtbl hvt 1
    @: MixaShareHandlerObj phobj
    @: MixaShareHandlerVtbl phvt
    []: GUID bogus_iid 1
    @: GUID pbogus
    []: (@: void) qi_out 1
    long: qi_hr

    phobj: @ hobj[0]
    phvt: @ hvt[0]
    phvt\QueryInterface: mixa_share_handler_query_interface
    phvt\AddRef: mixa_share_handler_add_ref
    phvt\Release: mixa_share_handler_release
    phvt\Invoke: mixa_share_handler_invoke
    phobj\lpVtbl: phvt
    phobj\refcount: 1
    phobj\owner_ctx: 0

    pbogus: @ bogus_iid[0]
    pbogus\Data1: (cast: (unsigned long) 0x11111111U)
    pbogus\Data2: (cast: (unsigned short) 0x2222U)
    pbogus\Data3: (cast: (unsigned short) 0x3333U)
    pbogus\Data4[0]: (cast: (char) 0x44)
    pbogus\Data4[1]: (cast: (char) 0x44)
    pbogus\Data4[2]: (cast: (char) 0x44)
    pbogus\Data4[3]: (cast: (char) 0x44)
    pbogus\Data4[4]: (cast: (char) 0x44)
    pbogus\Data4[5]: (cast: (char) 0x44)
    pbogus\Data4[6]: (cast: (char) 0x44)
    pbogus\Data4[7]: (cast: (char) 0x44)

    qi_out[0]: (cast: (@: void) 1)
    qi_hr: mixa_share_handler_query_interface((cast: (@: void) phobj), pbogus, @ qi_out[0])
    if: qi_hr != -2147467262 || qi_out[0] != 0
        failures: failures + 1
        c.printf("mixa share native smoke: QueryInterface(bogus) hr=%ld ppv=%p (want E_NOINTERFACE/null)\n", qi_hr, qi_out[0])
    else:
        c.printf("mixa share native smoke: QueryInterface(bogus) correctly refused (E_NOINTERFACE, ppv null)\n")
    ---

    []: GUID unk_iid 1
    @: GUID punk
    punk: @ unk_iid[0]
    punk\Data1: (cast: (unsigned long) 0x00000000U)
    punk\Data2: (cast: (unsigned short) 0x0000U)
    punk\Data3: (cast: (unsigned short) 0x0000U)
    punk\Data4[0]: (cast: (char) 0xc0)
    punk\Data4[1]: (cast: (char) 0x00)
    punk\Data4[2]: (cast: (char) 0x00)
    punk\Data4[3]: (cast: (char) 0x00)
    punk\Data4[4]: (cast: (char) 0x00)
    punk\Data4[5]: (cast: (char) 0x00)
    punk\Data4[6]: (cast: (char) 0x00)
    punk\Data4[7]: (cast: (char) 0x46)
    qi_out[0]: 0
    qi_hr: mixa_share_handler_query_interface((cast: (@: void) phobj), punk, @ qi_out[0])
    if: qi_hr != 0 || qi_out[0] = 0 || phobj\refcount != 2
        failures: failures + 1
        c.printf("mixa share native smoke: QueryInterface(IUnknown) hr=%ld ppv=%p refcount=%d (want OK/non-null/2)\n", qi_hr, qi_out[0], phobj\refcount)
    else:
        c.printf("mixa share native smoke: QueryInterface(IUnknown) correctly accepted (refcount now %d)\n", phobj\refcount)
    ---

    hinst: (cast: (@: void) c.GetModuleHandleW(0))
    pwc: @ wc[0]
    c.memset(pwc, 0, c.sizeof(c.WNDCLASSEXW))
    pwc\cbSize: (cast: (UINT) c.sizeof(c.WNDCLASSEXW))
    pwc\lpfnWndProc: mixa_share_smoke_wndproc
    pwc\hInstance: (cast: (HINSTANCE) hinst)
    pwc\lpszClassName: (cast: (@: wchar_t) L"MixaShareNativeSmokeWnd")
    if: c.RegisterClassExW(pwc) = 0
        c.printf("mixa share native smoke: RegisterClassExW failed gle=%lu\n", c.GetLastError())
        return: 1

    # Sanity check only: confirms class registration actually produces a
    # working window (fails fast with a clear GLE if not) before any real
    # WinRT round trip is attempted. Not reused below -- every real
    # invocation (including the final one) gets its own fresh window via
    # mixa_share_smoke_run_fault/mixa_share_smoke_new_window.
    hwnd: (cast: (@: void) c.CreateWindowExW(0U, (cast: (@: wchar_t) L"MixaShareNativeSmokeWnd"), (cast: (@: wchar_t) L"mixa share native smoke"), 13565952U, 100, 100, 320, 200, 0, 0, (cast: (HINSTANCE) hinst), 0))
    if: hwnd = 0
        c.printf("mixa share native smoke: CreateWindowExW failed gle=%lu\n", c.GetLastError())
        return: 1
    c.ShowWindow((cast: (HWND) hwnd), 5)
    c.UpdateWindow((cast: (HWND) hwnd))
    c.DestroyWindow((cast: (HWND) hwnd))

    # Regression (ticket 20260912-001200 item 1, strengthened per ticket
    # 20260912-004800 item 2): destroying a request from a thread that
    # does not own it must NOT free it. Reading mixa_share_event() back as
    # still PENDING is NOT proof of that -- freed heap bytes can trivially
    # still hold the same enum value -- so this uses the real
    # free_counter hook: mixa_share_destroy() increments it exactly once,
    # only at the point it actually commits to freeing text/title/files/r.
    # Sets BOTH text and title (004800: "retain meaningful title/text
    # payloads") so the request has real heap allocations at stake, not
    # just its own struct. Also (004800 item 1): CreateThread's return
    # and WaitForSingleObject's actual result are both checked -- a
    # failed thread launch or a timeout is a test FAILURE, not a silently
    # accepted pass, and this function does NOT touch/free the shared
    # request afterward unless the worker is confirmed to have actually
    # finished (a timeout is not worker quiescence; touching/freeing a
    # request the worker might still be inside would be a real race, not
    # just an inconclusive result).
    hwnd: mixa_share_smoke_new_window(hinst)
    if: hwnd != 0
        checks: checks + 1
        st: mixa_share_create(@ r2, mixa_share_win32_table())
        if: st = MIXA_SHARE_OK
            fc: 0
            mixa_share_test_set_free_counter(r2, @ fc)
            mixa_share_set_text(r2, "cross-thread destroy regression text")
            mixa_share_set_title(r2, "cross-thread destroy regression title")
            mixa_share_set_context(r2, hwnd)
            st: mixa_share_begin(r2)
            if: st = MIXA_SHARE_OK
                thr: c.CreateThread(0, (cast: (SIZE_T) 0U), mixa_share_smoke_destroy_thread_proc, (cast: (@: void) r2), 0U, @ thr_id[0])
                if: thr = 0
                    failures: failures + 1
                    c.printf("mixa share native smoke: cross-thread destroy: CreateThread failed gle=%lu\n", c.GetLastError())
                else:
                    wait_rc: c.WaitForSingleObject(thr, 5000U)
                    c.CloseHandle(thr)
                    if: wait_rc != 0U
                        failures: failures + 1
                        c.printf("mixa share native smoke: cross-thread destroy: worker did not finish (WaitForSingleObject=%lu, want WAIT_OBJECT_0) -- not touching the shared request further, this run cannot conclude\n", wait_rc)
                    else:
                        if: fc != 0
                            failures: failures + 1
                            c.printf("mixa share native smoke: cross-thread destroy actually freed the request (free_counter=%d, want 0)\n", fc)
                        else:
                            c.printf("mixa share native smoke: cross-thread destroy correctly refused (free_counter=0)\n")
                        ---
                        mixa_share_destroy(r2)
                        checks: checks + 1
                        if: fc != 1
                            failures: failures + 1
                            c.printf("mixa share native smoke: owner-thread destroy did not tear down exactly once (free_counter=%d, want 1)\n", fc)
                        else:
                            c.printf("mixa share native smoke: owner-thread destroy correctly tore down exactly once\n")
                        ---
                    ---
                ---
            else:
                failures: failures + 1
                c.printf("mixa share native smoke: cross-thread destroy regression setup: begin rc=%d (want OK)\n", st)
                mixa_share_destroy(r2)
            ---
        else:
            failures: failures + 1
            c.printf("mixa share native smoke: cross-thread destroy regression setup: create rc=%d (want OK)\n", st)
        ---
        c.DestroyWindow((cast: (HWND) hwnd))
    ---

    # Regression (ticket 20260912-001200 item 2, strengthened per ticket
    # 20260912-004800 item 1): begin() must reject a genuinely wrong
    # apartment (MTA), not just record whatever thread happens to call
    # it. A real second OS thread initializes itself as MTA and calls the
    # full public sequence; begin() must return MIXA_SHARE_ERR_THREAD.
    # CreateThread/WaitForSingleObject are checked the same way as above
    # (a failed launch or a timeout is a failure, not a silent pass), and
    # the thread's own RoInitialize HRESULT is checked too -- a failed
    # RoInitialize would leave the thread's actual apartment unproven,
    # so g_wrong_apt_begin_rc is only meaningful when g_wrong_apt_ro_hr
    # confirms MTA was really established.
    hwnd: mixa_share_smoke_new_window(hinst)
    if: hwnd != 0
        checks: checks + 1
        g_wrong_apt_begin_rc: -1
        g_wrong_apt_ro_hr: -1
        thr: c.CreateThread(0, (cast: (SIZE_T) 0U), mixa_share_smoke_wrong_apartment_thread_proc, hwnd, 0U, @ thr_id[0])
        if: thr = 0
            failures: failures + 1
            c.printf("mixa share native smoke: wrong-apartment begin: CreateThread failed gle=%lu\n", c.GetLastError())
        else:
            wait_rc: c.WaitForSingleObject(thr, 5000U)
            c.CloseHandle(thr)
            if: wait_rc != 0U
                failures: failures + 1
                c.printf("mixa share native smoke: wrong-apartment begin: worker did not finish (WaitForSingleObject=%lu, want WAIT_OBJECT_0) -- this run cannot conclude\n", wait_rc)
            else:
                if: g_wrong_apt_ro_hr != 0
                    failures: failures + 1
                    c.printf("mixa share native smoke: wrong-apartment begin: worker's RoInitialize(MULTITHREADED) hr=%ld (want 0/S_OK) -- MTA not actually established, this run cannot conclude\n", g_wrong_apt_ro_hr)
                else:
                    if: g_wrong_apt_begin_rc != MIXA_SHARE_ERR_THREAD
                        failures: failures + 1
                        c.printf("mixa share native smoke: wrong-apartment begin rc=%d (want MIXA_SHARE_ERR_THREAD=%d)\n", g_wrong_apt_begin_rc, MIXA_SHARE_ERR_THREAD)
                    else:
                        c.printf("mixa share native smoke: wrong-apartment begin correctly refused (confirmed real MTA)\n")
                    ---
                ---
            ---
        ---
        c.DestroyWindow((cast: (HWND) hwnd))
    ---

    # Fault-injection coverage (tickets 225400/230500 item 4 and the
    # begin/get_Data/SetText/put_Title failure paths): each forced failure
    # must surface as MIXA_SHARE_EVENT_FAILED with a non-OK status, not be
    # silently reported as HANDED_OFF, and must not leave any registration/
    # reference behind that would block a subsequent clean request.
    []: int fev 1
    []: int fst 1
    mixa_share_smoke_run_fault(hinst, MIXA_SHARE_TEST_FAIL_TOKEN_ALLOC, @ fev[0], @ fst[0])
    checks: checks + 1
    if: fev[0] != MIXA_SHARE_EVENT_FAILED || fst[0] != MIXA_SHARE_ERR_NOMEM
        failures: failures + 1
        c.printf("mixa share native smoke: TOKEN_ALLOC fault event=%d status=%d (want FAILED or begin-rc NOMEM)\n", fev[0], fst[0])
    else:
        c.printf("mixa share native smoke: TOKEN_ALLOC fault correctly surfaced (event=%d status=%d)\n", fev[0], fst[0])
    ---

    mixa_share_smoke_run_fault(hinst, MIXA_SHARE_TEST_FAIL_GET_DATA, @ fev[0], @ fst[0])
    checks: checks + 1
    if: fev[0] != MIXA_SHARE_EVENT_FAILED || fst[0] = MIXA_SHARE_OK
        failures: failures + 1
        c.printf("mixa share native smoke: GET_DATA fault event=%d status=%d (want FAILED/non-OK)\n", fev[0], fst[0])
    else:
        c.printf("mixa share native smoke: GET_DATA fault correctly surfaced (event=%d status=%d)\n", fev[0], fst[0])
    ---

    mixa_share_smoke_run_fault(hinst, MIXA_SHARE_TEST_FAIL_SET_TEXT, @ fev[0], @ fst[0])
    checks: checks + 1
    if: fev[0] != MIXA_SHARE_EVENT_FAILED || fst[0] = MIXA_SHARE_OK
        failures: failures + 1
        c.printf("mixa share native smoke: SET_TEXT fault event=%d status=%d (want FAILED/non-OK)\n", fev[0], fst[0])
    else:
        c.printf("mixa share native smoke: SET_TEXT fault correctly surfaced (event=%d status=%d)\n", fev[0], fst[0])
    ---

    mixa_share_smoke_run_fault(hinst, MIXA_SHARE_TEST_FAIL_PUT_TITLE, @ fev[0], @ fst[0])
    checks: checks + 1
    if: fev[0] != MIXA_SHARE_EVENT_FAILED || fst[0] = MIXA_SHARE_OK
        failures: failures + 1
        c.printf("mixa share native smoke: PUT_TITLE fault event=%d status=%d (want FAILED/non-OK)\n", fev[0], fst[0])
    else:
        c.printf("mixa share native smoke: PUT_TITLE fault correctly surfaced (event=%d status=%d)\n", fev[0], fst[0])
    ---

    # Clean request immediately after four failures: no leaked
    # registration/reference from any of them may block this.
    mixa_share_smoke_run_fault(hinst, 0, @ fev[0], @ fst[0])
    checks: checks + 1
    if: fev[0] != MIXA_SHARE_EVENT_HANDED_OFF || fst[0] != MIXA_SHARE_OK
        failures: failures + 1
        c.printf("mixa share native smoke: clean request after 4 faults event=%d status=%d (want HANDED_OFF/OK)\n", fev[0], fst[0])
    else:
        c.printf("mixa share native smoke: clean request after 4 faults still succeeds (no leaked state)\n")
    ---

    # Same-window diagnostic (ticket 234500): two consecutive real
    # invocations on ONE shared window, informational only -- not counted
    # toward `failures` since this is deliberately probing an already-
    # documented, unresolved failure mode, not asserting it is fixed.
    hwnd: mixa_share_smoke_new_window(hinst)
    if: hwnd != 0
        mixa_share_smoke_run_on_hwnd(hwnd, 0, @ fev[0], @ fst[0])
        c.printf("mixa share native smoke: same-window diagnostic call 1: event=%d status=%d\n", fev[0], fst[0])
        mixa_share_smoke_run_on_hwnd(hwnd, 0, @ fev[0], @ fst[0])
        c.printf("mixa share native smoke: same-window diagnostic call 2: event=%d status=%d\n", fev[0], fst[0])
        c.DestroyWindow((cast: (HWND) hwnd))
    ---

    # Final confirmation, through the same retry-protected path as every
    # other real invocation above (this used to be a standalone one-shot
    # call with no retry; observed to flake with the exact same symptom
    # documented in mixa_share.txt once the earlier tests started using
    # fresh windows and retries -- treating it any differently would just
    # mean this ticket's evidence depends on which test happens to run
    # last, which is not a meaningful distinction).
    mixa_share_smoke_run_fault(hinst, 0, @ fev[0], @ fst[0])
    checks: checks + 1
    if: fev[0] != MIXA_SHARE_EVENT_HANDED_OFF || fst[0] != MIXA_SHARE_OK
        failures: failures + 1
        c.printf("mixa share native smoke: DataRequested never handed off (event=%d status=%d)\n", fev[0], fst[0])
    else:
        c.printf("mixa share native smoke: DataRequested handed off (final confirmation)\n")
    ---

    if: failures = 0
        c.printf("mixa share native smoke: ok\n")
    else:
        c.printf("mixa share native smoke: %d FAILURES\n", failures)
return: failures
