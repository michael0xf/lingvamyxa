            if: st = MIXA_SHARE_OK
                mixa_share_set_text(r2, "mixa unicode attachment smoke text")
                file_paths[0]: unicode_test_file_path
                st: mixa_share_set_files(r2, file_paths, 1U, @ out_skipped[0])
                if: st = MIXA_SHARE_OK
                    mixa_share_test_set_force_fail(r2, MIXA_SHARE_TEST_CAPTURE_PACKAGE)
                    mixa_share_set_context(r2, hwnd)
                    st: mixa_share_begin(r2)
                    if: st = MIXA_SHARE_OK
                        fev[0]: MIXA_SHARE_EVENT_PENDING
                        i2: 0
                        while: i2 < 100
                            mixa_share_smoke_pump_once(@ fmsg[0])
                            mixa_share_poll(r2, @ fev[0], @ fst[0])
                            if: fev[0] != MIXA_SHARE_EVENT_PENDING
                                break
                            c.Sleep(50U)
                            i2: i2 + 1
                        checks: checks + 1
                        if: fev[0] != MIXA_SHARE_EVENT_HANDED_OFF || fst[0] != MIXA_SHARE_OK
                            failures: failures + 1
                            c.printf("mixa share native smoke: unicode attachment event=%d status=%d (want HANDED_OFF/OK) after %d iterations\n", fev[0], fst[0], i2)
                        else:
                            c.printf("mixa share native smoke: unicode attachment handed off after %d iterations\n", i2)
                        ---
                        checks: checks + 1
                        if: mixa_share_win32_test_get_iter_vend_count() < 1
                            failures: failures + 1
                            c.printf("mixa share native smoke: unicode attachment vend_count=%d (want >= 1 -- DataPackage never actually walked our IIterable)\n", mixa_share_win32_test_get_iter_vend_count())
                        else:
                            c.printf("mixa share native smoke: unicode attachment DataPackage actually walked our IIterable, vend_count=%d\n", mixa_share_win32_test_get_iter_vend_count())
                        ---
                        checks: checks + 1
                        captured_pkg_u: 0
                        if: mixa_share_win32_test_take_last_package(@ captured_pkg_u) = 0 || captured_pkg_u = 0
                            failures: failures + 1
                            c.printf("mixa share native smoke: unicode attachment: no package was captured for readback\n")
                        else:
                            dpv_u: 0
                            hr: c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackage_GetView((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackage) captured_pkg_u), (cast: (@@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackageView) @ dpv_u))
                            if: hr != 0 || dpv_u = 0
                                failures: failures + 1
                                c.printf("mixa share native smoke: unicode attachment: GetView failed hr=%ld\n", hr)
                            else:
                                items_async_op_u: 0
                                hr: c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackageView_GetStorageItemsAsync((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackageView) dpv_u), (cast: (@@: __FIAsyncOperation_1___FIVectorView_1_Windows__CStorage__CIStorageItem) @ items_async_op_u))
                                if: hr != 0 || items_async_op_u = 0
                                    failures: failures + 1
                                    c.printf("mixa share native smoke: unicode attachment: GetStorageItemsAsync failed hr=%ld\n", hr)
                                else:
                                    items_async_info_u: 0
                                    hr: c.__FIAsyncOperation_1___FIVectorView_1_Windows__CStorage__CIStorageItem_QueryInterface((cast: (@: __FIAsyncOperation_1___FIVectorView_1_Windows__CStorage__CIStorageItem) items_async_op_u), (cast: (const: @(IID)) @ c.IID_IAsyncInfo), @ items_async_info_u)
                                    items_status_out_u[0]: 0
                                    if: hr = 0 && items_async_info_u != 0
                                        i2: 0
                                        while: i2 < 100
                                            mixa_share_smoke_pump_once(@ fmsg[0])
                                            hr: c.IAsyncInfo_get_Status((cast: (@: IAsyncInfo) items_async_info_u), (cast: (@: AsyncStatus) @ items_status_out_u[0]))
                                            if: hr = 0 && items_status_out_u[0] != 0
                                                break
                                            c.Sleep(20U)
                                            i2: i2 + 1
                                        c.IAsyncInfo_Release((cast: (@: IAsyncInfo) items_async_info_u))
                                    ---
                                    if: items_status_out_u[0] != 1
                                        failures: failures + 1
                                        c.printf("mixa share native smoke: unicode attachment: GetStorageItemsAsync did not complete successfully, status=%d\n", items_status_out_u[0])
                                    else:
                                        items_vector_u: 0
                                        hr: c.__FIAsyncOperation_1___FIVectorView_1_Windows__CStorage__CIStorageItem_GetResults((cast: (@: __FIAsyncOperation_1___FIVectorView_1_Windows__CStorage__CIStorageItem) items_async_op_u), (cast: (@@: __FIVectorView_1_Windows__CStorage__CIStorageItem) @ items_vector_u))
                                        if: hr != 0 || items_vector_u = 0
                                            failures: failures + 1
                                            c.printf("mixa share native smoke: unicode attachment: GetResults(vector) failed hr=%ld\n", hr)
                                        else:
                                            items_size_u[0]: 0U
                                            c.__FIVectorView_1_Windows__CStorage__CIStorageItem_get_Size((cast: (@: __FIVectorView_1_Windows__CStorage__CIStorageItem) items_vector_u), @ items_size_u[0])
                                            if: items_size_u[0] != 1U
                                                failures: failures + 1
                                                c.printf("mixa share native smoke: unicode attachment: DataPackageView holds %u items (want 1)\n", items_size_u[0])
                                            else:
                                                one_item_u: 0
                                                c.__FIVectorView_1_Windows__CStorage__CIStorageItem_GetAt((cast: (@: __FIVectorView_1_Windows__CStorage__CIStorageItem) items_vector_u), 0U, (cast: (@@: __x_ABI_CWindows_CStorage_CIStorageItem) @ one_item_u))
                                                if: one_item_u = 0
                                                    failures: failures + 1
                                                    c.printf("mixa share native smoke: unicode attachment: GetAt(0) returned no item\n")
                                                else:
                                                    one_path_hstr_u: 0
                                                    c.__x_ABI_CWindows_CStorage_CIStorageItem_get_Path((cast: (@: __x_ABI_CWindows_CStorage_CIStorageItem) one_item_u), (cast: (@: void) @ one_path_hstr_u))
                                                    unicode_path_wide: mixa_share_win32_utf8_to_wide(unicode_test_file_path)
                                                    if: one_path_hstr_u = 0 || unicode_path_wide = 0 || c.wcscmp((cast: (const: @(wchar_t)) unicode_path_wide), c.WindowsGetStringRawBuffer((cast: (HSTRING) one_path_hstr_u), 0)) != 0
                                                        failures: failures + 1
