                                    c.__FIAsyncOperation_1___FIVectorView_1_Windows__CStorage__CIStorageItem_Release((cast: (@: __FIAsyncOperation_1___FIVectorView_1_Windows__CStorage__CIStorageItem) items_async_op_u))
                                ---
                                c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackageView_Release((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackageView) dpv_u))
                            ---
                            c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackage_Release((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackage) captured_pkg_u))
