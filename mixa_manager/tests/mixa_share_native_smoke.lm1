                                                    ---
                                                    if: unicode_path_wide != 0
                                                        c.free(unicode_path_wide)
                                                    ---
                                                    if: one_path_hstr_u != 0
                                                        c.WindowsDeleteString((cast: (HSTRING) one_path_hstr_u))
                                                    ---
