    ---

    # File-op handler async lifetime boundaries (ticket 20260912-032000):
    # "delayed completion after destroy" and "reentrant Cancel/cleanup"
    # both rely on the SAME single mechanism -- mixa_file_op_handler_invoke
    # checks self->owner_ctx and no-ops (returns without touching ctx or
    # dereferencing async_info at all) once destroy() has nulled it, which
    # is exactly what makes a callback firing reentrantly from INSIDE
    # destroy()'s own IAsyncInfo::Cancel() call (or genuinely later, after
    # destroy() has already returned) equally safe -- there is no separate
    # code path for "reentrant" vs "delayed", so proving one deterministic
    # instance of "owner_ctx already 0" proves both. No fake WinRT source
    # needed for this specific check since the whole point is that
    # async_info is never dereferenced on this path -- passing a
    # deliberately invalid, non-null pointer for it and confirming no
    # crash is itself part of the proof.
    checks: checks + 1
    handler_for_ac: (cast: (@: void) c.calloc(1U, c.sizeof(c.MixaFileOpHandlerObj)))
    if: handler_for_ac = 0
        failures: failures + 1
        c.printf("mixa share native smoke: async lifetime: could not allocate a handler, cannot run\n")
    else:
        # refcount=1, owner_ctx left at calloc's zero default -- exactly
        # the state mixa_share_win32_destroy leaves a file handler in
        # right before Releasing it, whether that Release happens because
        # destroy() ran first or because a genuinely late completion is
        # what triggers this handler's own final Release.
        handler_for_ac_typed: (cast: (@: MixaFileOpHandlerObj) handler_for_ac)
        handler_for_ac_typed\refcount: 1
        hr: mixa_file_op_handler_invoke(handler_for_ac, (cast: (@: void) 1), 1)
        if: hr != -2147467259
            failures: failures + 1
            c.printf("mixa share native smoke: async lifetime: Invoke() on a detached handler returned hr=%ld (want E_FAIL, -2147467259)\n", hr)
        else:
            c.printf("mixa share native smoke: async lifetime: Invoke() on a detached (owner_ctx=0) handler safely no-opped without dereferencing async_info\n")
        ---
        mixa_file_op_handler_release(handler_for_ac)
    ---

    # Real-OS complement to the deterministic check above: begin() a real
    # file-attaching share, then call destroy() IMMEDIATELY with no
    # polling at all, racing this test against the real OS's own
    # GetFileFromPathAsync completion. Whichever side wins that race --
    # destroy() nulls owner_ctx and cancels first, or the real completion
    # fires first and destroy() then tears down an already-finished
    # request -- must not crash or hang. This is the one real WinRT path
    # for this stage (deliberately not simulated), complementing rather
    # than duplicating the deterministic check above.
    if: mixa_share_smoke_make_test_file(test_file_path) = 0
        failures: failures + 1
        checks: checks + 1
        c.printf("mixa share native smoke: async lifetime (real): could not create the test-owned file, cannot run\n")
    else:
        checks: checks + 1
        hwnd: mixa_share_smoke_new_window(hinst)
        if: hwnd = 0
            failures: failures + 1
            c.printf("mixa share native smoke: async lifetime (real): window creation failed, cannot run\n")
        else:
            st: mixa_share_create(@ r2, mixa_share_win32_table())
            if: st = MIXA_SHARE_OK
                mixa_share_set_text(r2, "mixa async lifetime race smoke text")
                file_paths[0]: test_file_path
                st: mixa_share_set_files(r2, file_paths, 1U, @ out_skipped[0])
                if: st = MIXA_SHARE_OK
                    mixa_share_set_context(r2, hwnd)
                    st: mixa_share_begin(r2)
                    if: st = MIXA_SHARE_OK
                        # No polling at all -- destroy() races the real
                        # async resolution deliberately.
                        mixa_share_destroy(r2)
                        i2: 0
                        while: i2 < 20
                            mixa_share_smoke_pump_once(@ fmsg[0])
                            c.Sleep(50U)
                            i2: i2 + 1
                        c.printf("mixa share native smoke: async lifetime (real): destroy() raced against real async resolution without crashing\n")
                    else:
                        failures: failures + 1
                        c.printf("mixa share native smoke: async lifetime (real): begin rc=%d (want OK)\n", st)
                        mixa_share_destroy(r2)
                    ---
                else:
                    failures: failures + 1
                    c.printf("mixa share native smoke: async lifetime (real): set_files rc=%d (want OK, skipped=%llu)\n", st, (cast: (unsigned long long) out_skipped[0]))
                    mixa_share_destroy(r2)
                ---
            else:
                failures: failures + 1
                c.printf("mixa share native smoke: async lifetime (real): create rc=%d (want OK)\n", st)
            ---
            c.DestroyWindow((cast: (HWND) hwnd))
        ---
        c.DeleteFileA(test_file_path)
    ---

    # --- fake async-op seam: the three named registration/cancellation
    # transitions a real WinRT race cannot reliably force on demand
    # (ticket 20260912-033900) --------------------------------------

    # Scenario 1: put_Completed invokes the handler SYNCHRONOUSLY, before
    # returning. Exercises the real mixa_file_op_handler_invoke (through
    # the real SDK Invoke macro, called by our own fake put_Completed)
    # with a deterministic result_status=Error (3) so it takes the
    # failure branch, which is enough to prove every resource involved is
    # torn down exactly once even when completion is as immediate as
    # possible.
    checks: checks + 1
    fc_handler: 0
    fc_op: 0
    fc_pkg: 0
    fc_defer_release: 0
    fc_defer_complete: 0
    fake_pkg_a: fake_unk_create(@ fc_pkg)
    fake_defer_a: fake_defer_create(@ fc_defer_release, @ fc_defer_complete)
    fake_op_a: fake_async_op_create(1, 0, 3, @ fc_op)
    if: fake_pkg_a = 0 || fake_defer_a = 0 || fake_op_a = 0
        failures: failures + 1
        c.printf("mixa share native smoke: scenario1 (immediate completion): could not allocate fakes\n")
    else:
        r_a: 0
        ctx_a: 0
        handler_a: 0
        if: mixa_share_smoke_make_async_lifetime_ctx(fake_pkg_a, fake_defer_a, fake_op_a, @ fc_handler, 1, 0, @ r_a, @ ctx_a, @ handler_a) = 0
            failures: failures + 1
            c.printf("mixa share native smoke: scenario1 (immediate completion): could not build ctx\n")
        else:
            # Registers the handler exactly like begin_file_resolution
            # does; complete_synchronously=1 makes THIS call invoke the
            # handler synchronously before returning.
            c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_put_Completed((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) fake_op_a), (cast: (@: __FIAsyncOperationCompletedHandler_1_Windows__CStorage__CStorageFile) handler_a))
            checks: checks + 1
            if: fc_handler != 1 || fc_op != 1 || fc_pkg != 1 || fc_defer_release != 1 || fc_defer_complete != 1
                failures: failures + 1
                c.printf("mixa share native smoke: scenario1 (immediate completion): exact-once cleanup failed (handler=%d op=%d pkg=%d defer_release=%d defer_complete=%d, want all 1)\n", fc_handler, fc_op, fc_pkg, fc_defer_release, fc_defer_complete)
            else:
                c.printf("mixa share native smoke: scenario1 (immediate completion): put_Completed's synchronous Invoke() cleaned up every resource exactly once\n")
            ---
            r_a_typed: (cast: (@: MixaShareRequest) r_a)
            ctx_a_typed: (cast: (@: MixaShareWin32Ctx) ctx_a)
            checks: checks + 1
            if: ctx_a_typed\pending != 0 || ctx_a_typed\invoke_status != MIXA_SHARE_ERR_BACKEND
                failures: failures + 1
                c.printf("mixa share native smoke: scenario1 (immediate completion): ctx state pending=%d invoke_status=%d (want 0/ERR_BACKEND)\n", ctx_a_typed\pending, ctx_a_typed\invoke_status)
            else:
                c.printf("mixa share native smoke: scenario1 (immediate completion): ctx correctly reports the failed resolution\n")
            ---
            r_a_typed\impl: 0
            c.free(ctx_a)
            mixa_share_destroy(r_a)
        ---
    ---

    # Scenario 2: IAsyncInfo::Cancel invokes the handler REENTRANTLY, from
    # inside destroy()'s own Cancel() call, while ctx is still mid-
    # teardown. Exercises the real mixa_share_win32_destroy (through the
    # real portable mixa_share_destroy) end to end -- destroy() must null
    # the handler's owner_ctx BEFORE calling Cancel() (already fixed, see
    # item 1's own writeup) so the reentrant Invoke() takes the detached
    # branch and destroy() remains the sole owner of every release.
    checks: checks + 1
    fc_handler: 0
    fc_op: 0
    fc_pkg: 0
    fc_defer_release: 0
    fc_defer_complete: 0
    fake_pkg_a: fake_unk_create(@ fc_pkg)
    fake_defer_a: fake_defer_create(@ fc_defer_release, @ fc_defer_complete)
    fake_op_a: fake_async_op_create(0, 1, 3, @ fc_op)
    if: fake_pkg_a = 0 || fake_defer_a = 0 || fake_op_a = 0
        failures: failures + 1
        c.printf("mixa share native smoke: scenario2 (reentrant cancel): could not allocate fakes\n")
    else:
        r_a: 0
        ctx_a: 0
        handler_a: 0
        if: mixa_share_smoke_make_async_lifetime_ctx(fake_pkg_a, fake_defer_a, fake_op_a, @ fc_handler, 1, 0, @ r_a, @ ctx_a, @ handler_a) = 0
            failures: failures + 1
            c.printf("mixa share native smoke: scenario2 (reentrant cancel): could not build ctx\n")
        else:
            c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_put_Completed((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) fake_op_a), (cast: (@: __FIAsyncOperationCompletedHandler_1_Windows__CStorage__CStorageFile) handler_a))
            # destroy() nulls owner_ctx, then QueryInterface(IAsyncInfo)+
            # Cancel()s our fake, which reentrantly invokes the handler
            # from inside that Cancel() call -- ctx_a/r_a are both fully
            # freed by the time this returns; nothing after this may
            # touch either.
            mixa_share_destroy(r_a)
            checks: checks + 1
            if: fc_handler != 1 || fc_op != 1 || fc_pkg != 1 || fc_defer_release != 1 || fc_defer_complete != 1
                failures: failures + 1
                c.printf("mixa share native smoke: scenario2 (reentrant cancel): exact-once cleanup failed (handler=%d op=%d pkg=%d defer_release=%d defer_complete=%d, want all 1)\n", fc_handler, fc_op, fc_pkg, fc_defer_release, fc_defer_complete)
            else:
                c.printf("mixa share native smoke: scenario2 (reentrant cancel): destroy() alone completed/released every resource exactly once despite the reentrant Invoke() from inside Cancel()\n")
            ---
        ---
    ---

    # Scenario 3: a completion delivered AFTER destroy() has already
    # returned and freed ctx -- the "OS's own internal scheduler still
    # holds the handler" case. An extra AddRef on the fake op (taken
    # before destroy(), simulating that independent OS-side reference)
    # keeps the fake -- and the handler it holds -- alive through
    # destroy()'s own Release(ctx->file_op), which would otherwise free
    # both immediately as part of destroy()'s normal cleanup. The
    # "delayed" callback must find owner_ctx already detached (nulled by
    # destroy() before it ever touched Cancel) without reading the
    # now-freed ctx or async_info, and every reference must still balance
    # exactly once the simulated OS reference is finally dropped too.
    checks: checks + 1
    fc_handler: 0
    fc_op: 0
    fc_pkg: 0
    fc_defer_release: 0
    fc_defer_complete: 0
    fake_pkg_a: fake_unk_create(@ fc_pkg)
    fake_defer_a: fake_defer_create(@ fc_defer_release, @ fc_defer_complete)
    fake_op_a: fake_async_op_create(0, 0, 3, @ fc_op)
    if: fake_pkg_a = 0 || fake_defer_a = 0 || fake_op_a = 0
        failures: failures + 1
        c.printf("mixa share native smoke: scenario3 (delayed after destroy): could not allocate fakes\n")
    else:
        r_a: 0
        ctx_a: 0
        handler_a: 0
        if: mixa_share_smoke_make_async_lifetime_ctx(fake_pkg_a, fake_defer_a, fake_op_a, @ fc_handler, 1, 0, @ r_a, @ ctx_a, @ handler_a) = 0
            failures: failures + 1
            c.printf("mixa share native smoke: scenario3 (delayed after destroy): could not build ctx\n")
        else:
            c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_put_Completed((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) fake_op_a), (cast: (@: __FIAsyncOperationCompletedHandler_1_Windows__CStorage__CStorageFile) handler_a))
            c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_AddRef((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) fake_op_a))
            mixa_share_destroy(r_a)
            checks: checks + 1
            if: fc_pkg != 1 || fc_defer_release != 1 || fc_defer_complete != 1
                failures: failures + 1
                c.printf("mixa share native smoke: scenario3 (delayed after destroy): destroy() did not clean up package/deferral exactly once (pkg=%d defer_release=%d defer_complete=%d)\n", fc_pkg, fc_defer_release, fc_defer_complete)
            else:
                c.printf("mixa share native smoke: scenario3 (delayed after destroy): destroy() correctly cleaned up package/deferral even with the async op still retained\n")
            ---
            checks: checks + 1
            if: fc_handler != 0 || fc_op != 0
                failures: failures + 1
                c.printf("mixa share native smoke: scenario3 (delayed after destroy): handler/op freed too early by destroy() alone (handler=%d op=%d, want both still 0 -- the extra retained reference should have kept them alive)\n", fc_handler, fc_op)
            else:
                c.printf("mixa share native smoke: scenario3 (delayed after destroy): handler/op correctly still alive after destroy(), retained by the simulated OS reference\n")
            ---
            hr: c.__FIAsyncOperationCompletedHandler_1_Windows__CStorage__CStorageFile_Invoke((cast: (@: __FIAsyncOperationCompletedHandler_1_Windows__CStorage__CStorageFile) handler_a), (cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) fake_op_a), 1)
            checks: checks + 1
            if: hr != -2147467259 || fc_handler != 0
                failures: failures + 1
                c.printf("mixa share native smoke: scenario3 (delayed after destroy): delayed callback hr=%ld handler_free=%d (want E_FAIL/-2147467259 and still 0 -- must not read freed ctx or release early)\n", hr, fc_handler)
            else:
                c.printf("mixa share native smoke: scenario3 (delayed after destroy): delayed callback correctly found owner_ctx already detached, no premature release\n")
            ---
            c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_Release((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) fake_op_a))
            checks: checks + 1
            if: fc_handler != 1 || fc_op != 1
                failures: failures + 1
                c.printf("mixa share native smoke: scenario3 (delayed after destroy): final release handler_free=%d op_free=%d (want both 1)\n", fc_handler, fc_op)
            else:
                c.printf("mixa share native smoke: scenario3 (delayed after destroy): handler and fake op both released exactly once after the simulated delayed OS cleanup\n")
            ---
        ---
    ---

    # Scenario 4: mid-chain resolved-item Release-balance (ticket
    # 20260912-043851 item 2). The existing real-OS mid-chain-failure
    # test (above) proves vend_count=0 -- SetStorageItems was never
    # enumerated -- but that alone does not prove the already-resolved
    # FIRST item's own IStorageItem reference was actually released
    # rather than merely never handed to the OS. Simulates "file 1
    # already resolved, file 2 about to fail" directly and
    # deterministically: a real interface-shaped fake item (reusing
    # FakeUnkObj's bare 3-slot shape -- the abort loop only ever calls
    # Release() on pending_items[i], exactly what FakeUnkObj answers) is
    # placed at pending_items[0] by the test helper BEFORE any Invoke()
    # call runs, with pending_item_total=2/pending_item_next=1 --
    # matching exactly what the chain's own bookkeeping looks like right
    # after a real first file resolves and before a real second one
    # fails. A single synchronous put_Completed (GetResults always fails
    # on this fake, matching "file 2's resolution failed") then drives
    # the production abort loop directly, with every one of the five
    # resources it tears down (item, handler, op, package, deferral)
    # independently observable via its own external free_counter. The
    # existing real-OS delete-second-file test is kept as complementary
    # coverage, not replaced -- this one adds the specific evidence that
    # was missing, deterministically.
    checks: checks + 1
    fc_handler: 0
    fc_op: 0
    fc_pkg: 0
    fc_defer_release: 0
    fc_defer_complete: 0
    fc_item1: 0
    fake_pkg_a: fake_unk_create(@ fc_pkg)
    fake_defer_a: fake_defer_create(@ fc_defer_release, @ fc_defer_complete)
    fake_op_a: fake_async_op_create(1, 0, 3, @ fc_op)
    fake_item1: fake_unk_create(@ fc_item1)
    if: fake_pkg_a = 0 || fake_defer_a = 0 || fake_op_a = 0 || fake_item1 = 0
        failures: failures + 1
        c.printf("mixa share native smoke: scenario4 (mid-chain item release): could not allocate fakes\n")
    else:
        r_a: 0
        ctx_a: 0
        handler_a: 0
        if: mixa_share_smoke_make_async_lifetime_ctx(fake_pkg_a, fake_defer_a, fake_op_a, @ fc_handler, 2, fake_item1, @ r_a, @ ctx_a, @ handler_a) = 0
            failures: failures + 1
            c.printf("mixa share native smoke: scenario4 (mid-chain item release): could not build ctx\n")
        else:
            # complete_synchronously=1: this one call resolves "file 2",
            # which always fails (fake_ao_get_results never succeeds),
            # so Invoke() takes the abort branch and releases
            # pending_items[0] (fake_item1) as part of the same
            # synchronous call.
            c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_put_Completed((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) fake_op_a), (cast: (@: __FIAsyncOperationCompletedHandler_1_Windows__CStorage__CStorageFile) handler_a))
            checks: checks + 1
            if: fc_handler != 1 || fc_op != 1 || fc_pkg != 1 || fc_defer_release != 1 || fc_defer_complete != 1 || fc_item1 != 1
                failures: failures + 1
                c.printf("mixa share native smoke: scenario4 (mid-chain item release): exact-once cleanup failed (handler=%d op=%d pkg=%d defer_release=%d defer_complete=%d item1=%d, want all 1)\n", fc_handler, fc_op, fc_pkg, fc_defer_release, fc_defer_complete, fc_item1)
            else:
                c.printf("mixa share native smoke: scenario4 (mid-chain item release): already-resolved first item released exactly once, alongside every other resource, when the second file failed\n")
            ---
            r_a_typed: (cast: (@: MixaShareRequest) r_a)
            ctx_a_typed: (cast: (@: MixaShareWin32Ctx) ctx_a)
            checks: checks + 1
            if: ctx_a_typed\pending != 0 || ctx_a_typed\invoke_status != MIXA_SHARE_ERR_BACKEND
                failures: failures + 1
                c.printf("mixa share native smoke: scenario4 (mid-chain item release): ctx state pending=%d invoke_status=%d (want 0/ERR_BACKEND)\n", ctx_a_typed\pending, ctx_a_typed\invoke_status)
            else:
                c.printf("mixa share native smoke: scenario4 (mid-chain item release): ctx correctly reports the failed chain\n")
            ---
            r_a_typed\impl: 0
            c.free(ctx_a)
            mixa_share_destroy(r_a)
        ---
    ---

    # Unicode-native file attachment (ticket 20260912-043851 item 1): a
    # real test-owned file whose NAME contains a genuine non-ASCII code
    # point (not just a space/apostrophe), created with CreateFileW so
    # fixture creation does not depend on the active ANSI code page.
    # Exercises the exact same real WinRT StorageFile -> IStorageItem ->
    # SetStorageItems path as the earlier single-file test, plus the same
    # source-side DataPackageView readback the multi-file test already
    # uses -- proving the Unicode path survives UTF-8 -> wide -> HSTRING
    # -> real OS resolution -> real DataPackage storage -> readback
    # intact, not just that SOME file attached successfully.
