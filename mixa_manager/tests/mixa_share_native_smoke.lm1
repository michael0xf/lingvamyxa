# Builds a real MixaShareRequest (via mixa_share_create against the real
# win32 vtable, though begin() is never called -- these tests drive
# mixa_file_op_handler_invoke/mixa_share_win32_destroy directly) and a
# hand-built MixaShareWin32Ctx wired up exactly as
# mixa_share_win32_begin_file_resolution would have left it mid-flight:
# owner_tid set to the calling (test) thread, one file pending, the given
# fake package/deferral/async-op/handler all installed. Returns 1 on
# success with every out-pointer populated, 0 on any allocation failure
# (nothing partially built is leaked on that path).
fn: mixa_share_smoke_make_async_lifetime_ctx (@: void fake_pkg; @: void fake_defer; @: void fake_op; @: int handler_free_counter; int: item_total; @: void preresolved_item; @@: void out_r; @@: void out_ctx; @@: void out_handler) int
    @: MixaShareRequest r
    @: MixaShareWin32Ctx ctx
    @: MixaFileOpHandlerObj handler
    @: MixaFileOpHandlerVtbl vtbl
    @@: void items_arr
    int: st
    r: 0
    st: mixa_share_create(@ r, mixa_share_win32_table())
    if: st != MIXA_SHARE_OK || r = 0
        return: 0
    ctx: (cast: (@: MixaShareWin32Ctx) c.calloc(1U, c.sizeof(c.MixaShareWin32Ctx)))
    if: ctx = 0
        mixa_share_destroy(r)
        return: 0
    handler: (cast: (@: MixaFileOpHandlerObj) c.calloc(1U, c.sizeof(c.MixaFileOpHandlerObj)))
    if: handler = 0
        c.free(ctx)
        mixa_share_destroy(r)
        return: 0
    vtbl: (cast: (@: MixaFileOpHandlerVtbl) c.calloc(1U, c.sizeof(c.MixaFileOpHandlerVtbl)))
    if: vtbl = 0
        c.free(handler)
        c.free(ctx)
        mixa_share_destroy(r)
        return: 0
    vtbl\QueryInterface: mixa_file_op_handler_query_interface
    vtbl\AddRef: mixa_file_op_handler_add_ref
    vtbl\Release: mixa_file_op_handler_release
    vtbl\Invoke: mixa_file_op_handler_invoke
    handler\lpVtbl: vtbl
    handler\refcount: 1
    handler\owner_ctx: (cast: (@: void) ctx)
    handler\free_counter: handler_free_counter
    ctx\owner_tid: c.GetCurrentThreadId()
    ctx\req: (cast: (@: void) r)
    ctx\pending: 1
    ctx\pending_package: fake_pkg
    ctx\file_deferral: fake_defer
    ctx\file_op: fake_op
    ctx\file_handler: (cast: (@: void) handler)
    ctx\pending_items: c.calloc((cast: (size_t) item_total), c.sizeof(@: void))
    ctx\pending_item_total: item_total
    ctx\pending_item_next: 0
    # Optional: simulate "one file already resolved" for a mid-chain
    # deterministic test (ticket 20260912-043851) -- placed at index 0,
    # matching the chain's own ordering, so the very next Invoke() call
    # (for whatever occupies file_op/file_handler above) exercises the
    # abort loop's Release() on THIS item specifically.
    if: preresolved_item != 0 && ctx\pending_items != 0
        items_arr: (cast: (@@: void) ctx\pending_items)
        items_arr[0]: preresolved_item
        ctx\pending_item_next: 1
    ---
    r\impl: (cast: (@: void) ctx)
    out_r[0]: (cast: (@: void) r)
    out_ctx[0]: (cast: (@: void) ctx)
    out_handler[0]: (cast: (@: void) handler)
return: 1

fn: main () int
    @: void hinst
    []: WNDCLASSEXW wc 1
    @: WNDCLASSEXW pwc
    @: void hwnd
    @: MixaShareRequest r2
    @: void thr
    []: DWORD thr_id 1
    []: int fev 1
    []: int fst 1
