predef: "mixa_manager/mixa_fm_copy.h.lm1"
predef: "mixa_manager/mixa_fm_copy.lm1"
include: "mixa_manager/mixa_backend_headless.h" "<stdio.h>" "<string.h>" "<stdlib.h>"

# Copy Here selftest (ticket 20260912-122500). Real, test-owned directory
# trees under this run's own directory; every mutation happens inside
# that fixture root, verified before any write. No user files anywhere.

int: g_calls
[]: char g_trace 4000
size_t: g_trace_len
int: g_fail_at_call
int: g_fail_status

fn: t_base (const: @(char path)) const: @(char)
    size_t: n
    size_t: i
    size_t: last
    int: found
    n: c.strlen(path)
    last: 0U
    found: 0
    i: 0U
    while: i < n
        if: path[i] = (cast: (char) 92) || path[i] = (cast: (char) 47)
            last: i + 1U
            found: 1
        ---
        i: i + 1U
    ---
    if: found = 0
        return: path
return: path + last

sub: t_record (const: @(char kind); const: @(char path); int: status)
    size_t: room
    if: g_trace_len + 80U >= 4000U
        return
    ---
    room: 4000U - g_trace_len
    c.snprintf(g_trace + g_trace_len, room, "%s:%s:%d|", kind, t_base(path), status)
    g_trace_len: c.strlen(g_trace)
end: t_record

fn: t_note (const: @(char kind); const: @(char path); int: status) int
    g_calls: g_calls + 1
    t_record(kind, path, status)
    if: g_fail_at_call != 0 && g_calls = g_fail_at_call
        return: g_fail_status
    ---
return: MIXA_SEL_WALK_GO

fn: cb_dir_enter (@: void ctx; const: @(char src); const: @(char dst); int: is_dir; int: status) int
return: t_note("D", src, status)

fn: cb_file (@: void ctx; const: @(char src); const: @(char dst); int: is_dir; int: status) int
return: t_note("F", src, status)

fn: cb_dir_done (@: void ctx; const: @(char src); const: @(char dst); int: is_dir; int: status) int
return: t_note("E", src, status)

@: MixaCopySink g_sink
int: g_sink_ready

fn: t_sink () const: @(MixaCopySink)
    if: g_sink_ready = 0
        g_sink: (cast: (@: MixaCopySink) c.calloc(1U, c.sizeof(c.MixaCopySink)))
        g_sink\on_dir_enter: cb_dir_enter
        g_sink\on_file: cb_file
        g_sink\on_dir_done: cb_dir_done
        g_sink_ready: 1
    ---
return: g_sink

sub: t_reset ()
    g_calls: 0
    g_trace[0]: 0
    g_trace_len: 0U
    g_fail_at_call: 0
    g_fail_status: 0
end: t_reset

fn: t_count (const: @(char needle)) int
    const: @(char p)
    int: n
    n: 0
    p: c.strstr(g_trace, needle)
    while: p != 0
        n: n + 1
        p: c.strstr(p + 1U, needle)
    ---
return: n

int: g_fault_at
int: g_fault_calls

fn: fault_hook (@: void ctx; size_t: bytes_done) int
    g_fault_calls: g_fault_calls + 1
    if: g_fault_at >= 0
        if: (cast: (int) bytes_done) >= g_fault_at
            return: MIXA_FIO_ERR_IO
        ---
    ---
return: MIXA_FIO_OK

@: MixaFioFaultVTable g_fv
int: g_fv_ready

fn: t_fv () const: @(MixaFioFaultVTable)
    if: g_fv_ready = 0
        g_fv: (cast: (@: MixaFioFaultVTable) c.calloc(1U, c.sizeof(c.MixaFioFaultVTable)))
        g_fv\on_read: fault_hook
        g_fv\on_write: fault_hook
        g_fv_ready: 1
    ---
return: g_fv

# --- Ordinary (non-poisoning) file-manager allocator, used by most
# scenarios.
fn: fm_alloc (size_t: n) @: void
return: c.malloc(n)

sub: fm_free (@: void p)
    c.free(p)
end: fm_free

@: MixaFmAllocVTable g_av
int: g_av_ready

fn: t_fm_table () const: @(MixaFmAllocVTable)
    if: g_av_ready = 0
        g_av: (cast: (@: MixaFmAllocVTable) c.calloc(1U, c.sizeof(c.MixaFmAllocVTable)))
        g_av\alloc: fm_alloc
        g_av\free: fm_free
        g_av_ready: 1
    ---
return: g_av

# --- Poisoning allocator: `free` overwrites the buffer's own content
# with a recognizable pattern BEFORE actually releasing it, so a
# use-after-free read of a borrowed pointer is directly, deterministically
# observable as corrupted content -- proof by real evidence, not by
# relying on the allocator happening to reuse the same address.
fn: poison_alloc (size_t: n) @: void
return: c.malloc(n)

sub: poison_free (@: void p)
    @: char cp
    size_t: n
    if: p = 0
        return
    ---
    cp: (cast: (@: char) p)
    n: c.strlen(cp)
    c.memset(p, (cast: (char) 88), n)
    c.free(p)
end: poison_free

@: MixaFmAllocVTable g_pav
int: g_pav_ready

fn: t_poison_table () const: @(MixaFmAllocVTable)
    if: g_pav_ready = 0
        g_pav: (cast: (@: MixaFmAllocVTable) c.calloc(1U, c.sizeof(c.MixaFmAllocVTable)))
        g_pav\alloc: poison_alloc
        g_pav\free: poison_free
        g_pav_ready: 1
    ---
return: g_pav

fn: t_index_of (@: MixaFm fm; const: @(char name)) int
    size_t: i
    const: @(char nm)
    i: 0U
    while: i < mixa_fm_count(fm)
        nm: mixa_fm_name(fm, i)
        if: nm != 0
            if: c.strcmp(nm, name) = 0
                return: (cast: (int) i)
            ---
        ---
        i: i + 1U
    ---
return: -1

sub: t_touch (const: @(char path); const: @(char content))
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "wb")
    if: fh[0] != 0
        c.fputs(content, fh[0])
        c.fclose(fh[0])
    ---
end: t_touch

fn: t_exists (const: @(char path)) int
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "rb")
    if: fh[0] = 0
        return: 0
    ---
    c.fclose(fh[0])
return: 1

fn: t_read_all (const: @(char path); @: char out_buf; size_t: cap) int
    []: (@: void) fh 1
    size_t: n
    fh[0]: c.fopen(path, "rb")
    if: fh[0] = 0
        return: -1
    ---
    n: c.fread(out_buf, 1U, cap - 1U, fh[0])
    out_buf[n]: 0
    c.fclose(fh[0])
return: (cast: (int) n)

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char root 1040
    []: char srcdir 1040
    []: char single_file 1040
    []: char iofile 1040
    []: char inner_a 1040
    []: char dest_dir 1040
    []: char dest_probe 1040
    []: char dest_dir2 1040
    []: char dest_key 1040
    @: MixaBackend kbe
    @: MixaCellMetrics km
    @: MixaEvent kev
    @: MixaEvent kout
    const: @(MixaBackendVTable kvt)
    []: char p1 1200
    []: char cmd 2400
    []: char readbuf 4100
    @: MixaFm fm
    @: MixaSelection sel
    @: MixaFmCopyHereCtx ctx
    const: @(char bad_dest)
    []: char bad_dest_before 1200
    int: rc
    int: st
    int: idx
    int: failures
    int: checks
    c.setbuf((cast: (@: void) c.stdout), 0)
    failures: 0
    checks: 0
    g_fault_at: -1

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    ---
    if: argc < 2
        c.snprintf(base, 520U, "build/mixa/claude/fm_copy_here/tmp")
    ---
    c.snprintf(root, 1040U, "%s\\root", base)
    c.snprintf(srcdir, 1040U, "%s\\srcdir", root)
    c.snprintf(single_file, 1040U, "%s\\top.txt", root)
    c.snprintf(iofile, 1040U, "%s\\iofile.txt", root)
    c.snprintf(inner_a, 1040U, "%s\\inner.txt", srcdir)
    c.snprintf(dest_dir, 1040U, "%s\\dest", root)
    c.snprintf(dest_probe, 1040U, "%s\\dest_probe", root)
    c.snprintf(dest_dir2, 1040U, "%s\\dest2", root)
    c.snprintf(dest_key, 1040U, "%s\\dest_key", root)

    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", srcdir)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest_dir)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest_probe)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest_dir2)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest_key)
    c.system(cmd)
    t_touch(single_file, "top-level-content")
    t_touch(iofile, "io-fault-fixture-content")
    t_touch(inner_a, "inner-content")

    # --- Scenario 1: proving path lifetime is real, BEFORE testing the
    # real (safe) action. Enter dest_dir with a POISONING allocator, take
    # the BORROWED mixa_fm_cur_dir(fm) pointer, then call
    # mixa_fm_copy_selection DIRECTLY with that borrowed pointer as the
    # destination -- bypassing mixa_fm_copy_here_action's own owned-copy
    # discipline on purpose, to demonstrate why it exists. Since the
    # destination equals fm's own current directory, the completion
    # refresh fires and frees+reallocates fm's cur_dir buffer through the
    # poisoning free while that same call is still using it as
    # dest_root_utf8. Reading the borrowed pointer's content afterward
    # must show the poison pattern, not the real path -- real evidence
    # of a real use-after-free, not merely a documented risk.
    sel: (cast: (@: MixaSelection) c.calloc(1U, c.sizeof(c.MixaSelection)))
    fm: (cast: (@: MixaFm) c.calloc(1U, c.sizeof(c.MixaFm)))
    if: sel = 0 || fm = 0
        c.printf("fm_copy_here: alloc failed\n")
        return: 1
    ---
    mixa_selection_init(sel)
    mixa_fm_init(fm, root, sel, t_poison_table())
    idx: t_index_of(fm, "top.txt")
    mixa_fm_select(fm, (cast: (size_t) idx), 1)
    idx: t_index_of(fm, "dest_probe")
    mixa_fm_enter(fm, (cast: (size_t) idx))
    bad_dest: mixa_fm_cur_dir(fm)
    c.snprintf(bad_dest_before, 1200U, "%s", bad_dest)
    rc: mixa_fm_copy_selection(fm, bad_dest, t_sink(), 0)
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("fm_copy_here: poison-probe copy rc=%d\n", rc)
    ---
    checks: checks + 1
    if: c.strcmp(bad_dest, bad_dest_before) = 0
        failures: failures + 1
        c.printf("fm_copy_here: use-after-free NOT reproduced -- borrowed pointer still reads the original path [%s]. If this starts failing, the allocator's own reuse behaviour changed, not the hazard.\n", bad_dest_before)
    else:
        c.printf("fm_copy_here: use-after-free reproduced -- borrowed pointer was [%s], now reads corrupted/reused content instead\n", bad_dest_before)
    ---
    ---
    mixa_selection_release(sel)
    mixa_fm_release(fm)
    c.free(sel)
    c.free(fm)

    # --- Scenario 2 onward: the REAL action, always safe, via the
    # ordinary (non-poisoning) allocator plus a real poisoning check on
    # the SAFE path too, proving mixa_fm_copy_here_action's own owned
    # copy is immune to the same hazard.
    sel: (cast: (@: MixaSelection) c.calloc(1U, c.sizeof(c.MixaSelection)))
    fm: (cast: (@: MixaFm) c.calloc(1U, c.sizeof(c.MixaFm)))
    if: sel = 0 || fm = 0
        c.printf("fm_copy_here: alloc failed (2)\n")
        return: 1
    ---
    checks: checks + 1
    if: mixa_selection_init(sel) != MIXA_SEL_OK
        failures: failures + 1
        c.printf("fm_copy_here: selection init failed\n")
        return: 1
    ---
    checks: checks + 1
    if: mixa_fm_init(fm, root, sel, t_poison_table()) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: fm init failed\n")
        return: 1
    ---
    ctx: (cast: (@: MixaFmCopyHereCtx) c.calloc(1U, c.sizeof(c.MixaFmCopyHereCtx)))
    if: ctx = 0
        c.printf("fm_copy_here: ctx alloc failed\n")
        return: 1
    ---
    ctx\fm: fm
    ctx\sink: t_sink()

    # --- Scenario 2: the empty-selection no-op is explicit and does not
    # touch the filesystem or fm's own view at all.
    t_reset()
    rc: mixa_fm_copy_here_action((cast: (@: void) ctx))
    checks: checks + 1
    if: rc != MIXA_COPY_HERE_NOTHING_SELECTED
        failures: failures + 1
        c.printf("fm_copy_here: empty-selection rc=%d want NOTHING_SELECTED\n", rc)
    ---
    checks: checks + 1
    if: ctx\last_status != MIXA_COPY_HERE_NOTHING_SELECTED
        failures: failures + 1
        c.printf("fm_copy_here: ctx\\last_status=%d want NOTHING_SELECTED\n", ctx\last_status)
    ---
    checks: checks + 1
    if: g_calls != 0
        failures: failures + 1
        c.printf("fm_copy_here: empty-selection no-op still invoked the sink\n")
    ---

    # --- Scenario 3: a real headless button/controller event -- a hit
    # inside the button's own row/col bounds -- triggers Copy Here into
    # the CURRENT directory (root, holding top.txt and srcdir), with real
    # fixture files, using the POISONING allocator throughout so any
    # dangling-pointer regression in the real path would also be caught
    # here, not just in scenario 1's dedicated probe.
    idx: t_index_of(fm, "top.txt")
    checks: checks + 1
    if: idx < 0 || mixa_fm_select(fm, (cast: (size_t) idx), 1) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: selecting top.txt failed\n")
    ---
    idx: t_index_of(fm, "srcdir")
    checks: checks + 1
    if: idx < 0 || mixa_fm_select(fm, (cast: (size_t) idx), 1) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: selecting srcdir failed\n")
    ---
    idx: t_index_of(fm, "dest")
    checks: checks + 1
    if: idx < 0 || mixa_fm_enter(fm, (cast: (size_t) idx)) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: entering dest failed\n")
    ---
    t_reset()
    checks: checks + 1
    if: mixa_fm_copy_here_hit(ctx, 20U, 20U, 10U, 10U, 3U, 8U) != MIXA_COPY_HERE_HIT_NONE
        failures: failures + 1
        c.printf("fm_copy_here: a cell outside the button bounds was treated as a hit\n")
    ---
    checks: checks + 1
    if: g_calls != 0
        failures: failures + 1
        c.printf("fm_copy_here: a miss still invoked the sink\n")
    ---
    rc: mixa_fm_copy_here_hit(ctx, 10U, 12U, 10U, 10U, 3U, 8U)
    checks: checks + 1
    if: rc != MIXA_COPY_HERE_HIT_ACTION
        failures: failures + 1
        c.printf("fm_copy_here: real hit rc=%d want HIT_ACTION\n", rc)
    ---
    checks: checks + 1
    if: ctx\last_status != MIXA_COPY_OK
        failures: failures + 1
        c.printf("fm_copy_here: hit action last_status=%d want OK trace=%s\n", ctx\last_status, g_trace)
    ---
    c.snprintf(p1, 1200U, "%s\\top.txt", dest_dir)
    st: t_read_all(p1, readbuf, 4100U)
    checks: checks + 1
    if: st < 0 || c.strcmp(readbuf, "top-level-content") != 0
        failures: failures + 1
        c.printf("fm_copy_here: top.txt content=[%s]\n", readbuf)
    ---
    c.snprintf(p1, 1200U, "%s\\srcdir\\inner.txt", dest_dir)
    st: t_read_all(p1, readbuf, 4100U)
    checks: checks + 1
    if: st < 0 || c.strcmp(readbuf, "inner-content") != 0
        failures: failures + 1
        c.printf("fm_copy_here: inner.txt content=[%s]\n", readbuf)
    ---
    # --- Success drains the completed selection and refreshes the view
    # (which is the destination, so this is genuinely exercised).
    checks: checks + 1
    if: mixa_selection_query(sel, single_file) != 0 || mixa_selection_query(sel, srcdir) != 0
        failures: failures + 1
        c.printf("fm_copy_here: selection not drained after success (single=%d srcdir=%d) trace=%s single_file=[%s] srcdir=[%s]\n", mixa_selection_query(sel, single_file), mixa_selection_query(sel, srcdir), g_trace, single_file, srcdir)
    ---
    checks: checks + 1
    if: t_index_of(fm, "top.txt") < 0 || t_index_of(fm, "srcdir") < 0
        failures: failures + 1
        c.printf("fm_copy_here: view not refreshed after a same-directory Copy Here\n")
    ---

    # --- Scenario 4: existing-file conflict, using the poisoning
    # allocator throughout -- top.txt is already at dest_dir from
    # scenario 3. Exact status surfaces, view stays usable.
    mixa_fm_goto_root(fm)
    idx: t_index_of(fm, "top.txt")
    mixa_fm_select(fm, (cast: (size_t) idx), 1)
    idx: t_index_of(fm, "dest")
    mixa_fm_enter(fm, (cast: (size_t) idx))
    t_reset()
    rc: mixa_fm_copy_here_action((cast: (@: void) ctx))
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("fm_copy_here: conflict run rc=%d (sink continues past it) trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: t_count("F:top.txt:104|") != 1
        failures: failures + 1
        c.printf("fm_copy_here: existing-file conflict did not surface ERR_EXISTS: %s\n", g_trace)
    ---
    checks: checks + 1
    if: mixa_fm_count(fm) = 0U || t_index_of(fm, "top.txt") < 0
        failures: failures + 1
        c.printf("fm_copy_here: view corrupted by an existing-file conflict\n")
    ---
    mixa_selection_deselect(sel, single_file)

    # --- Scenario 5: cancellation on srcdir's own first event (genuinely
    # mid-subtree) then a retry that completes it and drains the
    # selection.
    mixa_fm_goto_root(fm)
    idx: t_index_of(fm, "srcdir")
    checks: checks + 1
    if: idx < 0 || mixa_fm_select(fm, (cast: (size_t) idx), 1) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: selecting srcdir for scenario 5 failed\n")
    ---
    idx: t_index_of(fm, "dest2")
    checks: checks + 1
    if: idx < 0 || mixa_fm_enter(fm, (cast: (size_t) idx)) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: entering dest2 for scenario 5 failed\n")
    ---
    t_reset()
    g_fail_at_call: 1
    g_fail_status: MIXA_SEL_WALK_STOP
    rc: mixa_fm_copy_here_action((cast: (@: void) ctx))
    checks: checks + 1
    if: rc != MIXA_COPY_CANCELLED
        failures: failures + 1
        c.printf("fm_copy_here: cancel rc=%d want CANCELLED trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, srcdir) != 1
        failures: failures + 1
        c.printf("fm_copy_here: cancelled selection not preserved\n")
    ---
    checks: checks + 1
    if: mixa_fm_count(fm) = 0U
        failures: failures + 1
        c.printf("fm_copy_here: view left unusable after cancellation\n")
    ---
    g_fail_at_call: 0
    t_reset()
    rc: mixa_fm_copy_here_action((cast: (@: void) ctx))
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("fm_copy_here: retry after cancel rc=%d trace=%s\n", rc, g_trace)
    ---
    c.snprintf(p1, 1200U, "%s\\srcdir\\inner.txt", dest_dir2)
    checks: checks + 1
    if: t_exists(p1) = 0
        failures: failures + 1
        c.printf("fm_copy_here: retry did not complete the copy\n")
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, srcdir) != 0
        failures: failures + 1
        c.printf("fm_copy_here: retry did not drain the now-completed selection\n")
    ---

    # --- Scenario 6: an injected mid-operation I/O failure, using
    # iofile.txt -- a fixture never copied before this scenario -- so the
    # fault hook is genuinely reached. Unfinished selection preserved,
    # partial file cleaned up, view stays usable, retry completes it.
    mixa_fm_goto_root(fm)
    idx: t_index_of(fm, "iofile.txt")
    checks: checks + 1
    if: idx < 0 || mixa_fm_select(fm, (cast: (size_t) idx), 1) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: selecting iofile.txt failed\n")
    ---
    idx: t_index_of(fm, "dest")
    mixa_fm_enter(fm, (cast: (size_t) idx))
    ctx\fv: t_fv()
    t_reset()
    g_fault_at: 4
    g_fault_calls: 0
    rc: mixa_fm_copy_here_action((cast: (@: void) ctx))
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("fm_copy_here: io-failure run rc=%d trace=%s\n", rc, g_trace)
    ---
    checks: checks + 1
    if: g_fault_calls = 0
        failures: failures + 1
        c.printf("fm_copy_here: fault hook never called\n")
    ---
    checks: checks + 1
    if: t_count("F:iofile.txt:105|") != 1
        failures: failures + 1
        c.printf("fm_copy_here: file event did not report the exact IO status: %s\n", g_trace)
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, iofile) != 1
        failures: failures + 1
        c.printf("fm_copy_here: io-failed source was wrongly deselected\n")
    ---
    c.snprintf(p1, 1200U, "%s\\iofile.txt", dest_dir)
    checks: checks + 1
    if: t_exists(p1) != 0
        failures: failures + 1
        c.printf("fm_copy_here: partial destination file was not cleaned up\n")
    ---
    checks: checks + 1
    if: mixa_fm_count(fm) = 0U
        failures: failures + 1
        c.printf("fm_copy_here: view left unusable after an IO failure\n")
    ---
    g_fault_at: -1
    t_reset()
    rc: mixa_fm_copy_here_action((cast: (@: void) ctx))
    checks: checks + 1
    if: rc != MIXA_COPY_OK
        failures: failures + 1
        c.printf("fm_copy_here: retry after IO failure rc=%d\n", rc)
    ---
    st: t_read_all(p1, readbuf, 4100U)
    checks: checks + 1
    if: st < 0 || c.strcmp(readbuf, "io-fault-fixture-content") != 0
        failures: failures + 1
        c.printf("fm_copy_here: retried file content=[%s]\n", readbuf)
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, iofile) != 0
        failures: failures + 1
        c.printf("fm_copy_here: retry after IO failure did not drain selection\n")
    ---
    ctx\fv: 0

    # --- Scenario 7: Ctrl+V key-event trigger (ticket 20260912-124720),
    # driven through a REAL MixaEvent shape round-tripped through the
    # headless backend's own push/poll seam -- not a hand-filled local
    # struct -- exactly the "headless/event seam" the ticket asked for.
    # single_file (top.txt) is unselected since scenario 4's deselect;
    # select it fresh and target its own untouched destination (dest_key)
    # so this scenario's real copy cannot contaminate an earlier or later
    # scenario's fixture assumptions.
    kvt: mixa_backend_headless_table()
    km: (cast: (@: MixaCellMetrics) c.calloc(1U, c.sizeof(c.MixaCellMetrics)))
    kev: (cast: (@: MixaEvent) c.calloc(1U, c.sizeof(c.MixaEvent)))
    kout: (cast: (@: MixaEvent) c.calloc(1U, c.sizeof(c.MixaEvent)))
    checks: checks + 1
    if: km = 0 || kev = 0 || kout = 0
        failures: failures + 1
        c.printf("fm_copy_here: key-event alloc failed\n")
    ---
    km\text_cell_width: 4U
    km\text_cell_height: 6U
    km\upper_cell_width: 8U
    km\upper_cell_height: 10U
    km\pointer_cell_width: 6U
    km\pointer_cell_height: 8U
    kbe: 0
    checks: checks + 1
    if: mixa_backend_open(kvt, @ kbe, 3U, 2U, km) != 0
        failures: failures + 1
        c.printf("fm_copy_here: key-event headless backend open failed\n")
    ---

    mixa_fm_goto_root(fm)
    idx: t_index_of(fm, "top.txt")
    checks: checks + 1
    if: idx < 0 || mixa_fm_select(fm, (cast: (size_t) idx), 1) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: selecting top.txt for key-event scenario failed\n")
    ---
    idx: t_index_of(fm, "dest_key")
    checks: checks + 1
    if: idx < 0 || mixa_fm_enter(fm, (cast: (size_t) idx)) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: entering dest_key failed\n")
    ---

    # 7a: V pressed with NO Ctrl modifier -- must do nothing at all.
    t_reset()
    c.memset(kev, 0, c.sizeof(c.MixaEvent))
    kev\kind: MIXA_EVENT_KEY
    kev\codepoint: 118U
    kev\modifiers: 0U
    mixa_headless_push_event(kbe, kev)
    mixa_backend_poll(kbe, kout)
    rc: mixa_fm_copy_here_key_event(ctx, kout)
    checks: checks + 1
    if: rc != MIXA_COPY_HERE_HIT_NONE
        failures: failures + 1
        c.printf("fm_copy_here: V without Ctrl was treated as a hit (rc=%d)\n", rc)
    ---
    checks: checks + 1
    if: g_calls != 0
        failures: failures + 1
        c.printf("fm_copy_here: V without Ctrl invoked the sink\n")
    ---

    # 7b: Ctrl held with an unrelated codepoint ('q') -- must do nothing.
    c.memset(kev, 0, c.sizeof(c.MixaEvent))
    kev\kind: MIXA_EVENT_KEY
    kev\codepoint: 113U
    kev\modifiers: (cast: (unsigned int) MIXA_MOD_CTRL)
    mixa_headless_push_event(kbe, kev)
    mixa_backend_poll(kbe, kout)
    rc: mixa_fm_copy_here_key_event(ctx, kout)
    checks: checks + 1
    if: rc != MIXA_COPY_HERE_HIT_NONE
        failures: failures + 1
        c.printf("fm_copy_here: Ctrl+q was treated as a hit (rc=%d)\n", rc)
    ---
    checks: checks + 1
    if: g_calls != 0
        failures: failures + 1
        c.printf("fm_copy_here: Ctrl+q invoked the sink\n")
    ---

    # 7c: mouse, resize, close -- none are MIXA_EVENT_KEY, must do nothing.
    c.memset(kev, 0, c.sizeof(c.MixaEvent))
    kev\kind: MIXA_EVENT_MOUSE
    kev\col: 1U
    kev\row: 1U
    kev\buttons: 1U
    mixa_headless_push_event(kbe, kev)
    mixa_backend_poll(kbe, kout)
    rc: mixa_fm_copy_here_key_event(ctx, kout)
    checks: checks + 1
    if: rc != MIXA_COPY_HERE_HIT_NONE || g_calls != 0
        failures: failures + 1
        c.printf("fm_copy_here: mouse event was treated as a key hit (rc=%d calls=%d)\n", rc, g_calls)
    ---
    c.memset(kev, 0, c.sizeof(c.MixaEvent))
    kev\kind: MIXA_EVENT_RESIZE
    kev\cols: 5U
    kev\rows: 5U
    mixa_headless_push_event(kbe, kev)
    mixa_backend_poll(kbe, kout)
    rc: mixa_fm_copy_here_key_event(ctx, kout)
    checks: checks + 1
    if: rc != MIXA_COPY_HERE_HIT_NONE || g_calls != 0
        failures: failures + 1
        c.printf("fm_copy_here: resize event was treated as a key hit (rc=%d calls=%d)\n", rc, g_calls)
    ---
    c.memset(kev, 0, c.sizeof(c.MixaEvent))
    kev\kind: MIXA_EVENT_CLOSE
    mixa_headless_push_event(kbe, kev)
    mixa_backend_poll(kbe, kout)
    rc: mixa_fm_copy_here_key_event(ctx, kout)
    checks: checks + 1
    if: rc != MIXA_COPY_HERE_HIT_NONE || g_calls != 0
        failures: failures + 1
        c.printf("fm_copy_here: close event was treated as a key hit (rc=%d calls=%d)\n", rc, g_calls)
    ---

    # 7d: the real gesture -- codepoint 'V' (uppercase) WITH Ctrl set, the
    # portable text+modifier spelling. Copies top.txt into dest_key,
    # drains the selection, refreshes the view (destination == cur dir).
    c.memset(kev, 0, c.sizeof(c.MixaEvent))
    kev\kind: MIXA_EVENT_KEY
    kev\codepoint: 86U
    kev\modifiers: (cast: (unsigned int) MIXA_MOD_CTRL)
    mixa_headless_push_event(kbe, kev)
    mixa_backend_poll(kbe, kout)
    rc: mixa_fm_copy_here_key_event(ctx, kout)
    checks: checks + 1
    if: rc != MIXA_COPY_HERE_HIT_ACTION
        failures: failures + 1
        c.printf("fm_copy_here: Ctrl+V (text form) rc=%d want HIT_ACTION\n", rc)
    ---
    checks: checks + 1
    if: ctx\last_status != MIXA_COPY_OK
        failures: failures + 1
        c.printf("fm_copy_here: Ctrl+V (text form) last_status=%d want OK trace=%s\n", ctx\last_status, g_trace)
    ---
    c.snprintf(p1, 1200U, "%s\\top.txt", dest_key)
    st: t_read_all(p1, readbuf, 4100U)
    checks: checks + 1
    if: st < 0 || c.strcmp(readbuf, "top-level-content") != 0
        failures: failures + 1
        c.printf("fm_copy_here: Ctrl+V (text form) copied content=[%s]\n", readbuf)
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, single_file) != 0
        failures: failures + 1
        c.printf("fm_copy_here: Ctrl+V (text form) did not drain the completed selection\n")
    ---
    checks: checks + 1
    if: t_index_of(fm, "top.txt") < 0
        failures: failures + 1
        c.printf("fm_copy_here: Ctrl+V (text form) did not refresh the view\n")
    ---

    # 7e: the real Win32-observed spelling -- codepoint 0x16 (ASCII SYN),
    # what a genuine Ctrl+V keypress actually delivers through WM_CHAR
    # (BACKEND_SEAM.txt 8.2), needing no modifier bit since the control
    # code already unambiguously encodes Ctrl+V. Fresh selection of
    # srcdir into the SAME dest_key -- srcdir was never copied there, so
    # this is a clean second gesture, not a retry.
    mixa_fm_goto_root(fm)
    idx: t_index_of(fm, "srcdir")
    checks: checks + 1
    if: idx < 0 || mixa_fm_select(fm, (cast: (size_t) idx), 1) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: selecting srcdir for the control-code scenario failed\n")
    ---
    idx: t_index_of(fm, "dest_key")
    checks: checks + 1
    if: idx < 0 || mixa_fm_enter(fm, (cast: (size_t) idx)) != MIXA_FM_OK
        failures: failures + 1
        c.printf("fm_copy_here: re-entering dest_key failed\n")
    ---
    t_reset()
    c.memset(kev, 0, c.sizeof(c.MixaEvent))
    kev\kind: MIXA_EVENT_KEY
    kev\codepoint: 22U
    kev\modifiers: 0U
    mixa_headless_push_event(kbe, kev)
    mixa_backend_poll(kbe, kout)
    rc: mixa_fm_copy_here_key_event(ctx, kout)
    checks: checks + 1
    if: rc != MIXA_COPY_HERE_HIT_ACTION
        failures: failures + 1
        c.printf("fm_copy_here: control-code Ctrl+V rc=%d want HIT_ACTION\n", rc)
    ---
    checks: checks + 1
    if: ctx\last_status != MIXA_COPY_OK
        failures: failures + 1
        c.printf("fm_copy_here: control-code Ctrl+V last_status=%d trace=%s\n", ctx\last_status, g_trace)
    ---
    c.snprintf(p1, 1200U, "%s\\srcdir\\inner.txt", dest_key)
    st: t_read_all(p1, readbuf, 4100U)
    checks: checks + 1
    if: st < 0 || c.strcmp(readbuf, "inner-content") != 0
        failures: failures + 1
        c.printf("fm_copy_here: control-code Ctrl+V copied content=[%s]\n", readbuf)
    ---
    checks: checks + 1
    if: mixa_selection_query(sel, srcdir) != 0
        failures: failures + 1
        c.printf("fm_copy_here: control-code Ctrl+V did not drain the completed selection\n")
    ---

    mixa_backend_close(kbe)
    c.free(km)
    c.free(kev)
    c.free(kout)

    # --- Scenario 8: argument negatives.
    checks: checks + 1
    if: mixa_fm_copy_here_action(0) != MIXA_COPY_ERR_ARG
        failures: failures + 1
        c.printf("fm_copy_here: null ctx not ERR_ARG\n")
    ---
    checks: checks + 1
    if: mixa_fm_copy_here_hit(0, 0U, 0U, 0U, 0U, 1U, 1U) != MIXA_COPY_HERE_HIT_NONE
        failures: failures + 1
        c.printf("fm_copy_here: null ctx hit not HIT_NONE\n")
    ---
    checks: checks + 1
    if: mixa_fm_copy_here_key_event(0, 0) != MIXA_COPY_HERE_HIT_NONE
        failures: failures + 1
        c.printf("fm_copy_here: null ctx key-event not HIT_NONE\n")
    ---
    checks: checks + 1
    if: mixa_fm_copy_here_key_event(ctx, 0) != MIXA_COPY_HERE_HIT_NONE
        failures: failures + 1
        c.printf("fm_copy_here: null event not HIT_NONE\n")
    ---

    mixa_selection_release(sel)
    mixa_fm_release(fm)
    c.free(sel)
    c.free(fm)
    c.free(ctx)

    if: failures = 0
        c.printf("fm copy here selftest: %d checks, 0 failures\n", checks)
    else:
        c.printf("fm copy here selftest: %d checks, %d failures\n", checks, failures)
    ---
return: failures
