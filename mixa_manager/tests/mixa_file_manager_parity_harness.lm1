predef: "mixa_manager/mixa_file_manager_l2.h.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# Real L1-vs-L2 parity harness for mixa_file_manager (dependency-order
# continuation after mixa_fileio_win32, the last module in the
# standing dependency-order list). ONE harness source, compiled/linked
# twice (oracle/L2), "declare then link" -- mixa_fm_*'s own real bodies
# come from either the unchanged mixa_file_manager.lm1 (oracle side) or
# the generated mixa_file_manager.lm2 (L2 side). Scenario coverage is
# drawn directly from the existing, already-accepted mixa_file_manager_
# selftest.lm1: unit checks on the path helpers (normalize/parent_of/
# map_dir_status, internal but externally linked, not part of the
# public prototype block); opening at a real root; the snapshot
# matching an INDEPENDENT mixa_dir walk of the same real tree entry for
# entry (order, is_dir, full path), including a real UTF-8 (Cyrillic)
# name; parent navigation refusing at the root without disturbing
# state; entering a file refused as NOT_DIR, an out-of-range index
# refused as RANGE; selection surviving a real refresh for a still-
# present entry and being dropped for one that disappeared, a newly
# added entry starting unselected; entering a child directory and
# returning; selecting a directory then entering it shows inherited
# selection on every child for free, one child exception recorded
# against the ancestor and surviving navigation away and back; an
# empty directory listing cleanly as empty; a real directory removed
# out from under an open model reporting the exact MISSING status while
# preserving the last-known visible state exactly (the module's own
# deliberate divergence from the reference); a real allocation-fault
# sweep across every owned step of a refresh (each refusal reports
# NOMEM, leaks nothing, disturbs nothing); OOM during init leaving
# nothing behind; a missing root refused by init with the exact status
# and no allocation; argument negatives across every entry point; and
# release disposing of everything owned while the borrowed selection
# survives untouched.

fn: mixa_fm_init (@: MixaFm fm; const: @(char root_utf8); @: MixaSelection sel; const: @(MixaFmAllocVTable av)) int
sub: mixa_fm_release (@: MixaFm fm)
fn: mixa_fm_refresh (@: MixaFm fm) int
fn: mixa_fm_enter (@: MixaFm fm; size_t: index) int
fn: mixa_fm_parent (@: MixaFm fm) int
fn: mixa_fm_goto_root (@: MixaFm fm) int
fn: mixa_fm_select (@: MixaFm fm; size_t: index; int: on) int
fn: mixa_fm_count (@: MixaFm fm) size_t
fn: mixa_fm_name (@: MixaFm fm; size_t: index) const: @(char)
fn: mixa_fm_path (@: MixaFm fm; size_t: index) const: @(char)
fn: mixa_fm_is_dir (@: MixaFm fm; size_t: index) int
fn: mixa_fm_is_selected (@: MixaFm fm; size_t: index) int
fn: mixa_fm_cur_dir (@: MixaFm fm) const: @(char)
fn: mixa_fm_root_dir (@: MixaFm fm) const: @(char)
fn: mixa_fm_last_dir_status (@: MixaFm fm) int
fn: mixa_fm_at_root (@: MixaFm fm) int
fn: mixa_fm_normalize (const: @(char path_utf8); @: char out; size_t: out_cap) int
fn: mixa_fm_parent_of (const: @(char dir_utf8); @: char out; size_t: out_cap) int
fn: mixa_fm_map_dir_status (int: st) int

int: g_alloc_fail_at
int: g_alloc_seq
int: g_alloc_live

fn: t_alloc (size_t: n) @: void
    @: void p
    g_alloc_seq: g_alloc_seq + 1
    if: g_alloc_fail_at != 0 && g_alloc_seq = g_alloc_fail_at
        return: 0
    ---
    p: c.malloc(n)
    if: p != 0
        g_alloc_live: g_alloc_live + 1
    ---
return: p

sub: t_free (@: void p)
    if: p = 0
        return
    ---
    g_alloc_live: g_alloc_live - 1
    c.free(p)
end: t_free

@: MixaFmAllocVTable g_av
int: g_av_ready

fn: t_table () const: @(MixaFmAllocVTable)
    if: g_av_ready = 0
        g_av: (cast: (@: MixaFmAllocVTable) c.calloc(1U, c.sizeof(c.MixaFmAllocVTable)))
        g_av\alloc: t_alloc
        g_av\free: t_free
        g_av_ready: 1
    ---
return: g_av

fn: t_index_of (@: MixaFm fm; const: @(char name)) int
    size_t: i
    const: @(char nm)
    i: 0U
    while: i < mixa_fm_count(fm)
        nm: mixa_fm_name(fm, i)
        if: nm != 0
            if: c.strcmp(nm, name) = 0
                return: (cast: (int) i)
            ---
        ---
        i: i + 1U
    ---
return: -1

fn: t_selected_count (@: MixaFm fm) int
    size_t: i
    int: n
    n: 0
    i: 0U
    while: i < mixa_fm_count(fm)
        if: mixa_fm_is_selected(fm, i) != 0
            n: n + 1
        ---
        i: i + 1U
    ---
return: n

sub: t_touch (const: @(char path))
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "wb")
    if: fh[0] != 0
        c.fputs("x", fh[0])
        c.fclose(fh[0])
    ---
end: t_touch

[]: int g_failures 1

sub: t_check_int (const: @(char label); int: got; int: want)
    if: got != want
        c.printf("CHK %s got=%d want=%d FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%d want=%d PASS\n", label, got, want)
end: t_check_int

sub: t_check_str (const: @(char label); const: @(char got); const: @(char want))
    int: eq
    eq: 0
    if: got != 0 && want != 0
        if: c.strcmp(got, want) = 0
            eq: 1
        ---
    ---
    if: eq = 0
        c.printf("CHK %s got=%s want=%s FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%s want=%s PASS\n", label, got, want)
end: t_check_str

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char root 1040
    []: char sub_a 1040
    []: char sub_b 1040
    []: char empty_dir 1040
    []: char gone_dir 1040
    []: char p1 1200
    []: char cmd 2400
    []: char nm_uni 24
    []: char norm 1200
    []: char up 1200
    @: MixaFm fm
    @: MixaSelection sel
    @: MixaDir d
    @: MixaDirEntry e
    const: @(char nm)
    size_t: oracle_count
    int: st
    int: idx
    int: idx_uni
    int: live_before
    int: saved_count
    int: k
    c.setbuf((cast: (@: void) c.stdout), 0)
    g_alloc_fail_at: 0
    g_alloc_seq: 0
    g_alloc_live: 0

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    else:
        c.snprintf(base, 520U, "build/mixa/claude/file_manager_l2_parity/tmp")
    ---
    c.snprintf(root, 1040U, "%s\\root", base)
    c.snprintf(sub_a, 1040U, "%s\\sub_a", root)
    c.snprintf(sub_b, 1040U, "%s\\sub_b", root)
    c.snprintf(empty_dir, 1040U, "%s\\empty_dir", root)
    c.snprintf(gone_dir, 1040U, "%s\\gone_dir", root)

    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", sub_a)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", sub_b)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", empty_dir)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", gone_dir)
    c.system(cmd)

    nm_uni[0]: (cast: (char) 0xD1)
    nm_uni[1]: (cast: (char) 0x84)
    nm_uni[2]: (cast: (char) 0xD0)
    nm_uni[3]: (cast: (char) 0xB0)
    nm_uni[4]: (cast: (char) 0xD0)
    nm_uni[5]: (cast: (char) 0xB9)
    nm_uni[6]: (cast: (char) 0xD0)
    nm_uni[7]: (cast: (char) 0xBB)
    nm_uni[8]: 0

    c.snprintf(p1, 1200U, "%s\\readme.txt", root)
    t_touch(p1)
    c.snprintf(p1, 1200U, "%s\\%s.txt", root, nm_uni)
    t_touch(p1)
    c.snprintf(p1, 1200U, "%s\\inner.txt", sub_a)
    t_touch(p1)

    # --- Path-helper unit checks, before any navigation.
    st: mixa_fm_normalize("C:\\foo\\", norm, 1200U)
    t_check_int("H1 normalize trailing sep rc", st, MIXA_FM_OK)
    t_check_str("H1 normalize trailing sep", norm, "C:\\foo")
    st: mixa_fm_normalize("C:\\", norm, 1200U)
    t_check_int("H2 normalize drive root rc", st, MIXA_FM_OK)
    t_check_str("H2 normalize drive root", norm, "C:\\")
    t_check_int("H3 normalize exact fit", mixa_fm_normalize("ab", norm, 3U), MIXA_FM_OK)
    t_check_int("H4 normalize overflow", mixa_fm_normalize("abc", norm, 3U), MIXA_FM_ERR_PATH)
    st: mixa_fm_parent_of("C:\\foo\\bar", up, 1200U)
    t_check_int("H5 parent_of nested rc", st, MIXA_FM_OK)
    t_check_str("H5 parent_of nested", up, "C:\\foo")
    st: mixa_fm_parent_of("C:\\foo", up, 1200U)
    t_check_int("H6 parent_of depth1 rc", st, MIXA_FM_OK)
    t_check_str("H6 parent_of depth1", up, "C:\\")
    t_check_int("H7 parent_of drive root", mixa_fm_parent_of("C:\\", up, 1200U), MIXA_FM_ERR_ROOT)
    t_check_int("H8 parent_of separatorless", mixa_fm_parent_of("lonely", up, 1200U), MIXA_FM_ERR_ROOT)

    t_check_int("H9 map OK", mixa_fm_map_dir_status(MIXA_DIR_OK), MIXA_FM_OK)
    t_check_int("H10 map MISSING", mixa_fm_map_dir_status(MIXA_DIR_ERR_MISSING), MIXA_FM_ERR_MISSING)
    t_check_int("H11 map IO->ACCESS", mixa_fm_map_dir_status(MIXA_DIR_ERR_IO), MIXA_FM_ERR_ACCESS)
    t_check_int("H12 map NOMEM", mixa_fm_map_dir_status(MIXA_DIR_ERR_NOMEM), MIXA_FM_ERR_NOMEM)
    t_check_int("H13 map ARG", mixa_fm_map_dir_status(MIXA_DIR_ERR_ARG), MIXA_FM_ERR_ARG)

    fm: (cast: (@: MixaFm) c.calloc(1U, c.sizeof(c.MixaFm)))
    e: (cast: (@: MixaDirEntry) c.calloc(1U, c.sizeof(c.MixaDirEntry)))
    sel: (cast: (@: MixaSelection) c.calloc(1U, c.sizeof(c.MixaSelection)))
    if: fm = 0 || e = 0 || sel = 0
        c.printf("fm parity: alloc failed\n")
        return: 1
    ---
    t_check_int("S0 selection init", mixa_selection_init(sel), MIXA_SEL_OK)

    # --- Scenario 1: open at the root.
    st: mixa_fm_init(fm, root, sel, t_table())
    t_check_int("S1 init rc", st, MIXA_FM_OK)
    if: st != MIXA_FM_OK
        c.printf("fm parity: init failed, aborting\n")
        return: 1
    ---
    t_check_str("S1 cur_dir", mixa_fm_cur_dir(fm), root)
    t_check_int("S1 at_root", mixa_fm_at_root(fm), 1)

    # --- Scenario 2: the snapshot matches an INDEPENDENT mixa_dir walk,
    # entry for entry, in the seam's own observed order.
    st: mixa_dir_list_open(@ d, root)
    t_check_int("S2 oracle open rc", st, MIXA_DIR_OK)
    oracle_count: 0U
    while: 1
        st: mixa_dir_list_next(d, e)
        if: st = MIXA_DIR_END
            break
        ---
        if: st != MIXA_DIR_OK
            t_check_int("S2 oracle next rc", st, MIXA_DIR_OK)
            break
        ---
        nm: mixa_fm_name(fm, oracle_count)
        if: nm = 0
            t_check_int("S2 snapshot has entry", 0, 1)
        else:
            t_check_str("S2 order match", nm, mixa_dir_entry_name(e))
            t_check_int("S2 is_dir match", mixa_fm_is_dir(fm, oracle_count), mixa_dir_entry_is_dir(e))
            c.snprintf(p1, 1200U, "%s\\%s", root, mixa_dir_entry_name(e))
            t_check_str("S2 path match", mixa_fm_path(fm, oracle_count), p1)
        ---
        oracle_count: oracle_count + 1U
    ---
    mixa_dir_list_close(d)
    t_check_int("S2 count match", (cast: (int) mixa_fm_count(fm)), (cast: (int) oracle_count))
    t_check_int("S2 fixture count", (cast: (int) oracle_count), 6)
    c.snprintf(p1, 1200U, "%s.txt", nm_uni)
    idx_uni: t_index_of(fm, p1)
    t_check_int("S2 utf8 entry found", (cast: (int) (idx_uni >= 0)), 1)

    # --- Scenario 3: parent navigation refuses at the root and changes
    # nothing.
    saved_count: (cast: (int) mixa_fm_count(fm))
    t_check_int("S3 parent at root", mixa_fm_parent(fm), MIXA_FM_ERR_ROOT)
    t_check_str("S3 cur_dir unchanged", mixa_fm_cur_dir(fm), root)
    t_check_int("S3 count unchanged", (cast: (int) mixa_fm_count(fm)), saved_count)

    # --- Scenario 4: entering a file is refused; an out-of-range index
    # is refused; neither disturbs the list.
    idx: t_index_of(fm, "readme.txt")
    t_check_int("S4 readme.txt found", (cast: (int) (idx >= 0)), 1)
    t_check_int("S4 enter file", mixa_fm_enter(fm, (cast: (size_t) idx)), MIXA_FM_ERR_NOTDIR)
    t_check_int("S4 enter oob", mixa_fm_enter(fm, 9999U), MIXA_FM_ERR_RANGE)
    t_check_int("S4 count unchanged", (cast: (int) mixa_fm_count(fm)), saved_count)

    # --- Scenario 5: selection survives a refresh for a still-present
    # entry, and is dropped for one that disappeared.
    t_check_int("S5 select rc", mixa_fm_select(fm, (cast: (size_t) idx), 1), MIXA_FM_OK)
    t_check_int("S5 selected count", t_selected_count(fm), 1)
    t_check_int("S5 refresh rc", mixa_fm_refresh(fm), MIXA_FM_OK)
    idx: t_index_of(fm, "readme.txt")
    t_check_int("S5 selection survives refresh", (cast: (int) (idx >= 0 && mixa_fm_is_selected(fm, (cast: (size_t) idx)) = 1)), 1)
    c.snprintf(p1, 1200U, "%s\\added.txt", root)
    t_touch(p1)
    t_check_int("S5 refresh after add", mixa_fm_refresh(fm), MIXA_FM_OK)
    t_check_int("S5 count after add", (cast: (int) mixa_fm_count(fm)), saved_count + 1)
    idx: t_index_of(fm, "added.txt")
    t_check_int("S5 new entry unselected", (cast: (int) (idx >= 0 && mixa_fm_is_selected(fm, (cast: (size_t) idx)) = 0)), 1)
    t_check_int("S5 selection unaffected by add", t_selected_count(fm), 1)
    c.snprintf(cmd, 2400U, "cmd /c del /q \"%s\\readme.txt\" 2>nul", root)
    c.system(cmd)
    t_check_int("S5 refresh after remove", mixa_fm_refresh(fm), MIXA_FM_OK)
    t_check_int("S5 removed entry gone", (cast: (int) (t_index_of(fm, "readme.txt") < 0)), 1)
    t_check_int("S5 selection dropped with entry", t_selected_count(fm), 0)

    # --- Scenario 6: entering a child directory, and coming back up.
    idx: t_index_of(fm, "added.txt")
    mixa_fm_select(fm, (cast: (size_t) idx), 1)
    idx: t_index_of(fm, "sub_a")
    t_check_int("S6 sub_a is dir", (cast: (int) (idx >= 0 && mixa_fm_is_dir(fm, (cast: (size_t) idx)) = 1)), 1)
    t_check_int("S6 enter sub_a rc", mixa_fm_enter(fm, (cast: (size_t) idx)), MIXA_FM_OK)
    t_check_str("S6 cur_dir after enter", mixa_fm_cur_dir(fm), sub_a)
    t_check_int("S6 sub_a count", (cast: (int) (mixa_fm_count(fm) = 1U && t_index_of(fm, "inner.txt") >= 0)), 1)
    t_check_int("S6 not at_root inside sub_a", mixa_fm_at_root(fm), 0)
    t_check_int("S6 unrelated dir unselected", t_selected_count(fm), 0)
    t_check_int("S6 parent from sub_a rc", mixa_fm_parent(fm), MIXA_FM_OK)
    t_check_int("S6 back at root", (cast: (int) (c.strcmp(mixa_fm_cur_dir(fm), root) = 0 && mixa_fm_at_root(fm) = 1)), 1)
    idx: t_index_of(fm, "added.txt")
    t_check_int("S6 selection survives roundtrip", (cast: (int) (idx >= 0 && mixa_fm_is_selected(fm, (cast: (size_t) idx)) = 1)), 1)
    t_check_int("S6 selected count after return", t_selected_count(fm), 1)

    # --- Selecting a DIRECTORY then entering it: everything inside is
    # selected by inheritance, with nothing inside ever touched.
    idx: t_index_of(fm, "sub_a")
    t_check_int("S6b select sub_a rc", mixa_fm_select(fm, (cast: (size_t) idx), 1), MIXA_FM_OK)
    t_check_int("S6b sub_a selected", mixa_fm_is_selected(fm, (cast: (size_t) idx)), 1)
    t_check_int("S6b enter selected sub_a rc", mixa_fm_enter(fm, (cast: (size_t) idx)), MIXA_FM_OK)
    idx: t_index_of(fm, "inner.txt")
    t_check_int("S6b inherited selection shown", (cast: (int) (idx >= 0 && mixa_fm_is_selected(fm, (cast: (size_t) idx)) = 1)), 1)
    t_check_int("S6b deselect inherited child rc", mixa_fm_select(fm, (cast: (size_t) idx), 0), MIXA_FM_OK)
    t_check_int("S6b child exception reads unselected", mixa_fm_is_selected(fm, (cast: (size_t) idx)), 0)
    t_check_int("S6b ancestor still selected", mixa_selection_query(sel, sub_a), 1)
    t_check_int("S6b parent out of sub_a rc", mixa_fm_parent(fm), MIXA_FM_OK)
    idx: t_index_of(fm, "sub_a")
    t_check_int("S6b sub_a still selected", mixa_fm_is_selected(fm, (cast: (size_t) idx)), 1)
    mixa_fm_enter(fm, (cast: (size_t) idx))
    idx: t_index_of(fm, "inner.txt")
    t_check_int("S6b exception survives nav", (cast: (int) (idx >= 0 && mixa_fm_is_selected(fm, (cast: (size_t) idx)) = 0)), 1)
    mixa_fm_select(fm, (cast: (size_t) idx), 1)
    mixa_fm_parent(fm)
    idx: t_index_of(fm, "sub_a")
    mixa_fm_select(fm, (cast: (size_t) idx), 0)
    t_check_int("S6b sub_a deselected", mixa_fm_is_selected(fm, (cast: (size_t) idx)), 0)

    # --- Scenario 7: an empty directory lists cleanly as empty.
    idx: t_index_of(fm, "empty_dir")
    t_check_int("S7 enter empty_dir rc", (cast: (int) (idx >= 0 && mixa_fm_enter(fm, (cast: (size_t) idx)) = MIXA_FM_OK)), 1)
    t_check_int("S7 empty dir count", (cast: (int) mixa_fm_count(fm)), 0)
    t_check_int("S7 goto_root rc", (cast: (int) (mixa_fm_goto_root(fm) = MIXA_FM_OK && mixa_fm_at_root(fm) = 1)), 1)

    # --- Scenario 8: a failed navigation preserves the prior visible
    # state exactly (the module's own deliberate divergence from the
    # reference, which instead walks up to the nearest surviving
    # ancestor).
    idx: t_index_of(fm, "gone_dir")
    t_check_int("S8 enter gone_dir rc", (cast: (int) (idx >= 0 && mixa_fm_enter(fm, (cast: (size_t) idx)) = MIXA_FM_OK)), 1)
    c.snprintf(p1, 1200U, "%s\\keep.txt", gone_dir)
    t_touch(p1)
    mixa_fm_refresh(fm)
    mixa_fm_select(fm, 0U, 1)
    saved_count: (cast: (int) mixa_fm_count(fm))
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul", gone_dir)
    c.system(cmd)
    st: mixa_fm_refresh(fm)
    t_check_int("S8 refresh of removed dir rc", st, MIXA_FM_ERR_MISSING)
    t_check_int("S8 last_dir_status", mixa_fm_last_dir_status(fm), MIXA_DIR_ERR_MISSING)
    t_check_str("S8 cur_dir unmoved", mixa_fm_cur_dir(fm), gone_dir)
    t_check_int("S8 list/selection preserved", (cast: (int) ((cast: (int) mixa_fm_count(fm)) = saved_count && t_selected_count(fm) = 1)), 1)
    t_check_int("S8 goto_root after failure rc", mixa_fm_goto_root(fm), MIXA_FM_OK)

    # --- Scenario 9: out-of-memory at EVERY owned allocation step of a
    # refresh.
    idx: t_index_of(fm, "added.txt")
    mixa_fm_select(fm, (cast: (size_t) idx), 1)
    saved_count: (cast: (int) mixa_fm_count(fm))
    k: 1
    while: k <= 24
        live_before: g_alloc_live
        g_alloc_seq: 0
        g_alloc_fail_at: k
        st: mixa_fm_refresh(fm)
        g_alloc_fail_at: 0
        if: g_alloc_seq >= k
            t_check_int("S9 OOM refusal", st, MIXA_FM_ERR_NOMEM)
            t_check_int("S9 OOM no leak", g_alloc_live, live_before)
            t_check_str("S9 OOM cur_dir unmoved", mixa_fm_cur_dir(fm), root)
            t_check_int("S9 OOM list/selection preserved", (cast: (int) ((cast: (int) mixa_fm_count(fm)) = saved_count && t_selected_count(fm) = 1)), 1)
        ---
        k: k + 1
    ---
    t_check_int("S9 refresh healthy after sweep", mixa_fm_refresh(fm), MIXA_FM_OK)
    t_check_int("S9 post-sweep view unchanged", (cast: (int) ((cast: (int) mixa_fm_count(fm)) = saved_count && t_selected_count(fm) = 1)), 1)

    # --- Scenario 10: OOM during init leaves nothing behind.
    live_before: g_alloc_live
    g_alloc_seq: 0
    g_alloc_fail_at: 1
    st: mixa_fm_init((cast: (@: MixaFm) c.calloc(1U, c.sizeof(c.MixaFm))), root, sel, t_table())
    g_alloc_fail_at: 0
    t_check_int("S10 init under OOM rc", st, MIXA_FM_ERR_NOMEM)
    t_check_int("S10 init under OOM no leak", g_alloc_live, live_before)

    # --- Scenario 11: a missing root is refused by init with the exact
    # status and allocates nothing.
    live_before: g_alloc_live
    c.snprintf(p1, 1200U, "%s\\no_such_root", base)
    st: mixa_fm_init((cast: (@: MixaFm) c.calloc(1U, c.sizeof(c.MixaFm))), p1, sel, t_table())
    t_check_int("S11 init on missing root rc", st, MIXA_FM_ERR_MISSING)
    t_check_int("S11 init on missing root no leak", g_alloc_live, live_before)

    # --- Scenario 12: argument negatives.
    t_check_int("S12 null fm init", mixa_fm_init(0, root, sel, t_table()), MIXA_FM_ERR_ARG)
    t_check_int("S12 null fm refresh", mixa_fm_refresh(0), MIXA_FM_ERR_ARG)
    t_check_int("S12 null fm enter", mixa_fm_enter(0, 0U), MIXA_FM_ERR_ARG)
    t_check_int("S12 null fm parent", mixa_fm_parent(0), MIXA_FM_ERR_ARG)
    t_check_int("S12 null fm select", mixa_fm_select(0, 0U, 1), MIXA_FM_ERR_ARG)
    t_check_int("S12 oob select", mixa_fm_select(fm, 9999U, 1), MIXA_FM_ERR_RANGE)
    t_check_int("S12 null accessors neutral", (cast: (int) (mixa_fm_count(0) = 0U && mixa_fm_name(0, 0U) = 0 && mixa_fm_cur_dir(0) = 0)), 1)
    t_check_int("S12 oob accessors null", (cast: (int) (mixa_fm_name(fm, 9999U) = 0 && mixa_fm_path(fm, 9999U) = 0)), 1)

    # --- Scenario 13: release disposes of everything this instance owns.
    mixa_fm_release(fm)
    t_check_int("S13 release cleared state", (cast: (int) (mixa_fm_count(fm) = 0U && mixa_fm_cur_dir(fm) = 0 && mixa_fm_root_dir(fm) = 0)), 1)
    t_check_int("S13 release no leak", g_alloc_live, 0)
    mixa_fm_release(fm)
    mixa_fm_release(0)
    c.printf("CHK S13 double release no-crash PASS\n")
    t_check_int("S13 borrowed selection untouched", mixa_selection_query(sel, "added.txt"), 0)
    mixa_selection_release(sel)
    c.free(sel)
    c.free(fm)
    c.free(e)

    if: g_failures[0] != 0
        c.printf("mixa file manager parity harness FAILED checks=%d\n", g_failures[0])
        return: 1
    c.printf("mixa file manager parity harness ok\n")
return: 0
