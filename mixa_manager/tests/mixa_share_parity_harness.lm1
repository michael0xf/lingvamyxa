predef: "mixa_manager/mixa_share_l2.h.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# Real L1-vs-L2 parity harness for mixa_share (share chain ticket
# 20260913-192700, module 1 of 6). ONE harness source, compiled/linked
# twice (oracle/L2) -- self-contained, no real win32 backend dependency
# needed since this harness drives its own deterministic fake backend,
# exactly like the existing accepted mixa_share_selftest.lm1 does. Real
# bodies come from either the unchanged mixa_share.lm1 (oracle side) or
# the generated mixa_share.lm2 (L2 side). Scenario coverage is drawn
# directly from that existing selftest: ClearShell-parity title
# derivation (first two non-blank words leading-space-joined, a single
# long word never hits the fallback, only zero qualifying words does,
# and the fallback truncates UTF-8-safely at exactly 32 bytes) plus an
# explicit title override; a single-file share driven through begin/
# poll to HANDED_OFF; multiple files including a real Unicode+space+
# quote path, cancellation not itself mutating the portable event, and
# destroy after cancel leaving no stale pending registration; a text-
# only share; a restricted (TEXT_ONLY-only) backend accepting text-only
# but refusing multi-file as ERR_UNSUPPORTED; an incomplete vtable
# rejected at create; a missing file as a hard ERR_MISSING with no
# partial commit, a directory soft-skipped and counted; a backend that
# refuses begin() for a missing required context, reaching FAILED; a
# destroy before completion freeing the pending registration so a
# later independent request is unblocked (no leak); a second begin() on
# an already-PENDING request rejected as ERR_STATE, and the same
# rejection for every TERMINAL event (HANDED_OFF/CANCELLED/FAILED), not
# just PENDING, while a fresh NONE request still allows its first
# begin(); and null-argument negatives.

fn: mixa_share_create (@@: MixaShareRequest out; const: @(MixaShareVTable vt)) int
fn: mixa_share_set_text (@: MixaShareRequest r; const: @(char text_utf8)) int
fn: mixa_share_set_title (@: MixaShareRequest r; const: @(char title_utf8)) int
fn: mixa_share_set_files (@: MixaShareRequest r; @@: char paths_utf8; size_t: count; @: size_t out_skipped) int
fn: mixa_share_set_context (@: MixaShareRequest r; @: void platform_ctx) int
fn: mixa_share_begin (@: MixaShareRequest r) int
fn: mixa_share_poll (@: MixaShareRequest r; @: int out_event; @: int out_status) int
fn: mixa_share_cancel (@: MixaShareRequest r) int
sub: mixa_share_destroy (@: MixaShareRequest r)
fn: mixa_share_text (const: @(MixaShareRequest r)) const: @(char)
fn: mixa_share_title (const: @(MixaShareRequest r)) const: @(char)
fn: mixa_share_file_count (const: @(MixaShareRequest r)) size_t
fn: mixa_share_file_at (const: @(MixaShareRequest r); size_t: idx) const: @(char)
fn: mixa_share_event (const: @(MixaShareRequest r)) int
fn: mixa_share_status (const: @(MixaShareRequest r)) int

@: MixaShareRequest g_fake_pending
@: MixaShareRequest g_fake_cancelled_request
int: g_fake_require_ctx
int: g_fake_countdown
int: g_fake_n_begins
int: g_fake_n_polls
int: g_fake_n_destroys
int: g_fake_n_cancels
int: g_fake_cancel_result

fn: fake_probe_file (const: @(char path_utf8)) int
    @: void f
    if: path_utf8 = 0
        return: MIXA_SHARE_ERR_ARG
    if: c.strstr(path_utf8, "\\dir\\") != 0
        return: MIXA_SHARE_ERR_UNSUPPORTED
    f: c.fopen(path_utf8, "rb")
    if: f = 0
        return: MIXA_SHARE_ERR_MISSING
    c.fclose(f)
return: MIXA_SHARE_OK

fn: fake_begin (@: MixaShareRequest r) int
    g_fake_n_begins: g_fake_n_begins + 1
    if: g_fake_require_ctx != 0
        if: r\platform_ctx = 0
            return: MIXA_SHARE_ERR_ARG
        ---
    ---
    if: g_fake_pending != 0
        return: MIXA_SHARE_ERR_STATE
    g_fake_pending: r
    g_fake_countdown: 2
return: MIXA_SHARE_OK

fn: fake_poll (@: MixaShareRequest r; @: int out_event; @: int out_status) int
    g_fake_n_polls: g_fake_n_polls + 1
    if: g_fake_cancelled_request = r
        g_fake_cancelled_request: 0
        out_event[0]: MIXA_SHARE_EVENT_CANCELLED
        out_status[0]: MIXA_SHARE_OK
        return: MIXA_SHARE_OK
    if: g_fake_pending != r
        return: MIXA_SHARE_ERR_STATE
    g_fake_countdown: g_fake_countdown - 1
    if: g_fake_countdown > 0
        out_event[0]: MIXA_SHARE_EVENT_PENDING
        out_status[0]: MIXA_SHARE_OK
    else:
        out_event[0]: MIXA_SHARE_EVENT_HANDED_OFF
        out_status[0]: MIXA_SHARE_OK
        g_fake_pending: 0
    ---
return: MIXA_SHARE_OK

fn: fake_cancel (@: MixaShareRequest r) int
    g_fake_n_cancels: g_fake_n_cancels + 1
    if: g_fake_pending = r
        g_fake_pending: 0
        g_fake_cancelled_request: r
    ---
return: g_fake_cancel_result

fn: fake_destroy (@: MixaShareRequest r) int
    g_fake_n_destroys: g_fake_n_destroys + 1
    if: g_fake_pending = r
        g_fake_pending: 0
    ---
    if: g_fake_cancelled_request = r
        g_fake_cancelled_request: 0
    ---
return: MIXA_SHARE_OK

@: MixaShareVTable g_fake_vtable_full
@: MixaShareVTable g_fake_vtable_no_multi
@: MixaShareVTable g_fake_vtable_incomplete
int: g_fake_vtables_ready

fn: fake_table_full () const: @(MixaShareVTable)
    if: g_fake_vtables_ready = 0
        g_fake_vtable_full: (cast: (@: MixaShareVTable) c.calloc(1U, c.sizeof(c.MixaShareVTable)))
        g_fake_vtable_no_multi: (cast: (@: MixaShareVTable) c.calloc(1U, c.sizeof(c.MixaShareVTable)))
        g_fake_vtable_incomplete: (cast: (@: MixaShareVTable) c.calloc(1U, c.sizeof(c.MixaShareVTable)))
        g_fake_vtable_full\name: "fake"
        g_fake_vtable_full\caps: MIXA_SHARE_CAP_MULTIPLE | MIXA_SHARE_CAP_TEXT_ONLY | MIXA_SHARE_CAP_CANCEL
        g_fake_vtable_full\probe_file: fake_probe_file
        g_fake_vtable_full\begin: fake_begin
        g_fake_vtable_full\poll: fake_poll
        g_fake_vtable_full\cancel: fake_cancel
        g_fake_vtable_full\destroy: fake_destroy
        g_fake_vtable_no_multi\name: "fake-no-multi"
        g_fake_vtable_no_multi\caps: MIXA_SHARE_CAP_TEXT_ONLY
        g_fake_vtable_no_multi\probe_file: fake_probe_file
        g_fake_vtable_no_multi\begin: fake_begin
        g_fake_vtable_no_multi\poll: fake_poll
        g_fake_vtable_no_multi\destroy: fake_destroy
        g_fake_vtable_incomplete\name: "fake-incomplete"
        g_fake_vtable_incomplete\probe_file: fake_probe_file
        g_fake_vtables_ready: 1
    ---
return: g_fake_vtable_full

[]: int g_failures 1

sub: t_check_int (const: @(char label); int: got; int: want)
    if: got != want
        c.printf("CHK %s got=%d want=%d FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%d want=%d PASS\n", label, got, want)
end: t_check_int

sub: t_check_str (const: @(char label); const: @(char got); const: @(char want))
    int: eq
    eq: 0
    if: got != 0 && want != 0
        if: c.strcmp(got, want) = 0
            eq: 1
        ---
    ---
    if: eq = 0
        c.printf("CHK %s got=%s want=%s FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%s want=%s PASS\n", label, got, want)
end: t_check_str

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char p_a 1040
    []: char p_b 1040
    []: char p_missing 1040
    []: char p_space 1040
    []: char nm_sp 16
    []: (@: char) two_files 2
    []: (@: char) one_file 1
    []: char mkcmd 2200
    []: char p_dir_entry 1040
    @: MixaShareRequest r
    @: MixaShareRequest r2
    size_t: skipped
    int: st
    int: ev
    int: status
    c.setbuf((cast: (@: void) c.stdout), 0)

    nm_sp[0]: (cast: (char) 0x73)
    nm_sp[1]: (cast: (char) 0x70)
    nm_sp[2]: (cast: (char) 0x20)
    nm_sp[3]: (cast: (char) 0x61)
    nm_sp[4]: (cast: (char) 0x63)
    nm_sp[5]: (cast: (char) 0x65)
    nm_sp[6]: (cast: (char) 0x2D)
    nm_sp[7]: (cast: (char) 0xD1)
    nm_sp[8]: (cast: (char) 0x84)
    nm_sp[9]: (cast: (char) 0xD0)
    nm_sp[10]: (cast: (char) 0xB0)
    nm_sp[11]: (cast: (char) 0xD0)
    nm_sp[12]: (cast: (char) 0xB9)
    nm_sp[13]: (cast: (char) 0xD0)
    nm_sp[14]: (cast: (char) 0xBB)
    nm_sp[15]: 0

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    else:
        c.snprintf(base, 520U, "build/mixa/claude/share_l2_parity/tmp")
    ---
    c.snprintf(p_a, 1040U, "%s\\a.txt", base)
    c.snprintf(p_b, 1040U, "%s\\b.txt", base)
    c.snprintf(p_missing, 1040U, "%s\\no_such.txt", base)
    c.snprintf(p_space, 1040U, "%s\\%s'quote.txt", base, nm_sp)

    # --- Title derivation.
    st: mixa_share_create(@ r, fake_table_full())
    t_check_int("T1 create rc", st, MIXA_SHARE_OK)
    mixa_share_set_text(r, "hello world this is extra")
    t_check_str("T1 title(2 words)", mixa_share_title(r), " hello world")
    mixa_share_set_text(r, "   ")
    t_check_str("T1 title(blank fallback)", mixa_share_title(r), "   ")
    mixa_share_set_text(r, "onlyoneword")
    t_check_str("T1 title(one word)", mixa_share_title(r), " onlyoneword")
    mixa_share_set_text(r, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    t_check_int("T1 title(long single word) len", (cast: (int) c.strlen(mixa_share_title(r))), 70)
    mixa_share_set_text(r, "word1 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    t_check_int("T1 title(word1+long word2) len", (cast: (int) c.strlen(mixa_share_title(r))), 76)
    mixa_share_set_text(r, "                                                                 ")
    t_check_int("T1 title(all-blank fallback) len", (cast: (int) c.strlen(mixa_share_title(r))), 32)
    mixa_share_set_title(r, "explicit override")
    t_check_str("T1 explicit title override", mixa_share_title(r), "explicit override")
    mixa_share_destroy(r)

    # --- Fixture files on disk.
    c.snprintf(mkcmd, 2200U, "cmd /c mkdir \"%s\" 2>nul", base)
    c.system(mkcmd)
    if: 1
        []: (@: void) fh 1
        fh[0]: c.fopen(p_a, "wb")
        if: fh[0] != 0
            c.fputs("A", fh[0])
            c.fclose(fh[0])
        ---
        fh[0]: c.fopen(p_b, "wb")
        if: fh[0] != 0
            c.fputs("B", fh[0])
            c.fclose(fh[0])
        ---
        fh[0]: c.fopen(p_space, "wb")
        if: fh[0] != 0
            c.fputs("S", fh[0])
            c.fclose(fh[0])
        ---
    ---

    # --- T: single file, begin/poll to completion.
    mixa_share_create(@ r, fake_table_full())
    mixa_share_set_text(r, "single file share")
    one_file[0]: p_a
    st: mixa_share_set_files(r, one_file, 1U, @ skipped)
    t_check_int("T2 set_files(1) rc", st, MIXA_SHARE_OK)
    t_check_int("T2 set_files(1) skipped", (cast: (int) skipped), 0)
    t_check_int("T2 set_files(1) count", (cast: (int) mixa_share_file_count(r)), 1)
    t_check_str("T2 file_at(0)", mixa_share_file_at(r, 0U), p_a)
    mixa_share_set_context(r, (cast: (@: void) r))
    st: mixa_share_begin(r)
    t_check_int("T2 begin rc", st, MIXA_SHARE_OK)
    t_check_int("T2 begin event", mixa_share_event(r), MIXA_SHARE_EVENT_PENDING)
    mixa_share_poll(r, @ ev, @ status)
    t_check_int("T2 poll#1 event", ev, MIXA_SHARE_EVENT_PENDING)
    mixa_share_poll(r, @ ev, @ status)
    t_check_int("T2 poll#2 event", ev, MIXA_SHARE_EVENT_HANDED_OFF)
    t_check_int("T2 poll#2 status", status, MIXA_SHARE_OK)
    mixa_share_destroy(r)

    # --- T: multiple files (Unicode + space + quote path).
    mixa_share_create(@ r, fake_table_full())
    mixa_share_set_text(r, "two files")
    two_files[0]: p_a
    two_files[1]: p_space
    st: mixa_share_set_files(r, two_files, 2U, @ skipped)
    t_check_int("T3 set_files(2) rc", st, MIXA_SHARE_OK)
    t_check_int("T3 set_files(2) count", (cast: (int) mixa_share_file_count(r)), 2)
    t_check_str("T3 unicode/space/quote path", mixa_share_file_at(r, 1U), p_space)
    mixa_share_set_context(r, (cast: (@: void) r))
    st: mixa_share_begin(r)
    t_check_int("T3 begin rc", st, MIXA_SHARE_OK)
    mixa_share_cancel(r)
    t_check_int("T3 cancel does not mutate event", mixa_share_event(r), MIXA_SHARE_EVENT_PENDING)
    t_check_int("T3 fake cancel invoked", g_fake_n_cancels, 1)
    mixa_share_destroy(r)
    t_check_int("T3 destroy after cancel no stale pending", (cast: (int) (g_fake_pending = 0)), 1)

    # --- T: no-selection, text-only share.
    mixa_share_create(@ r, fake_table_full())
    mixa_share_set_text(r, "just text, no files")
    mixa_share_set_context(r, (cast: (@: void) r))
    st: mixa_share_begin(r)
    t_check_int("T4 begin(text-only) rc", st, MIXA_SHARE_OK)
    mixa_share_poll(r, @ ev, @ status)
    mixa_share_poll(r, @ ev, @ status)
    t_check_int("T4 text-only completed", ev, MIXA_SHARE_EVENT_HANDED_OFF)
    mixa_share_destroy(r)

    # --- T: text-only against a restricted backend; multi-file refused.
    mixa_share_create(@ r, fake_table_full())
    mixa_share_destroy(r)
    r: 0
    st: mixa_share_create(@ r, g_fake_vtable_no_multi)
    mixa_share_set_text(r, "text only, restricted backend")
    st: mixa_share_begin(r)
    t_check_int("T5 text-only on TEXT_ONLY backend rc", st, MIXA_SHARE_OK)
    mixa_share_destroy(r)
    st: mixa_share_create(@ r, g_fake_vtable_no_multi)
    two_files[0]: p_a
    two_files[1]: p_b
    mixa_share_set_files(r, two_files, 2U, @ skipped)
    st: mixa_share_begin(r)
    t_check_int("T5 multi-file on non-MULTIPLE backend rc", st, MIXA_SHARE_ERR_UNSUPPORTED)
    mixa_share_destroy(r)

    # --- T: incomplete vtable rejected at create.
    r: 0
    st: mixa_share_create(@ r, g_fake_vtable_incomplete)
    t_check_int("T6 incomplete vtable rc", st, MIXA_SHARE_ERR_ARG)
    t_check_int("T6 incomplete vtable out nulled", (cast: (int) (r = 0)), 1)

    # --- T: missing file hard error; directory soft-skipped.
    st: mixa_share_create(@ r, fake_table_full())
    one_file[0]: p_missing
    st: mixa_share_set_files(r, one_file, 1U, @ skipped)
    t_check_int("T7 missing file rc", st, MIXA_SHARE_ERR_MISSING)
    t_check_int("T7 missing file no partial commit", (cast: (int) mixa_share_file_count(r)), 0)
    c.snprintf(p_dir_entry, 1040U, "%s\\dir\\ignored.txt", base)
    two_files[0]: p_a
    two_files[1]: p_dir_entry
    st: mixa_share_set_files(r, two_files, 2U, @ skipped)
    t_check_int("T7 dir-in-selection rc", st, MIXA_SHARE_OK)
    t_check_int("T7 dir-in-selection skipped", (cast: (int) skipped), 1)
    t_check_int("T7 dir-in-selection count", (cast: (int) mixa_share_file_count(r)), 1)
    mixa_share_destroy(r)

    # --- T: invalid platform context rejected by backend at begin().
    st: mixa_share_create(@ r, fake_table_full())
    mixa_share_set_text(r, "needs context")
    g_fake_require_ctx: 1
    st: mixa_share_begin(r)
    t_check_int("T8 begin without required context rc", st, MIXA_SHARE_ERR_ARG)
    t_check_int("T8 begin without required context event", mixa_share_event(r), MIXA_SHARE_EVENT_FAILED)
    g_fake_require_ctx: 0
    mixa_share_destroy(r)

    # --- T: destroy before completion frees the pending registration.
    st: mixa_share_create(@ r, fake_table_full())
    mixa_share_set_text(r, "abandoned mid-flight")
    mixa_share_set_context(r, (cast: (@: void) r))
    mixa_share_begin(r)
    t_check_int("T9 fake_begin registered pending", (cast: (int) (g_fake_pending != 0)), 1)
    mixa_share_destroy(r)
    t_check_int("T9 destroy no dangling pending", (cast: (int) (g_fake_pending = 0)), 1)
    st: mixa_share_create(@ r2, fake_table_full())
    mixa_share_set_text(r2, "second request after abandonment")
    mixa_share_set_context(r2, (cast: (@: void) r2))
    st: mixa_share_begin(r2)
    t_check_int("T9 second request begin rc (no leak)", st, MIXA_SHARE_OK)
    mixa_share_poll(r2, @ ev, @ status)
    mixa_share_poll(r2, @ ev, @ status)
    t_check_int("T9 second request completed", ev, MIXA_SHARE_EVENT_HANDED_OFF)
    mixa_share_destroy(r2)

    # --- T: a second begin() on an already-PENDING request is rejected.
    st: mixa_share_create(@ r, fake_table_full())
    mixa_share_set_text(r, "double begin")
    mixa_share_set_context(r, (cast: (@: void) r))
    mixa_share_begin(r)
    st: mixa_share_begin(r)
    t_check_int("T10 second begin on pending rc", st, MIXA_SHARE_ERR_STATE)
    mixa_share_destroy(r)

    # --- T: begin() rejected on every TERMINAL event.
    st: mixa_share_create(@ r, fake_table_full())
    mixa_share_set_text(r, "terminal after HANDED_OFF")
    mixa_share_set_context(r, (cast: (@: void) r))
    mixa_share_begin(r)
    mixa_share_poll(r, @ ev, @ status)
    mixa_share_poll(r, @ ev, @ status)
    t_check_int("T11 setup reaches HANDED_OFF", ev, MIXA_SHARE_EVENT_HANDED_OFF)
    st: mixa_share_begin(r)
    t_check_int("T11 begin after HANDED_OFF rc", st, MIXA_SHARE_ERR_STATE)
    mixa_share_destroy(r)

    st: mixa_share_create(@ r, fake_table_full())
    mixa_share_set_text(r, "terminal after CANCELLED")
    mixa_share_set_context(r, (cast: (@: void) r))
    mixa_share_begin(r)
    mixa_share_cancel(r)
    mixa_share_poll(r, @ ev, @ status)
    t_check_int("T11 setup reaches CANCELLED", ev, MIXA_SHARE_EVENT_CANCELLED)
    st: mixa_share_begin(r)
    t_check_int("T11 begin after CANCELLED rc", st, MIXA_SHARE_ERR_STATE)
    mixa_share_destroy(r)

    st: mixa_share_create(@ r, fake_table_full())
    mixa_share_set_text(r, "terminal after FAILED")
    g_fake_require_ctx: 1
    st: mixa_share_begin(r)
    t_check_int("T11 setup FAILED rc", st, MIXA_SHARE_ERR_ARG)
    t_check_int("T11 setup FAILED event", mixa_share_event(r), MIXA_SHARE_EVENT_FAILED)
    g_fake_require_ctx: 0
    st: mixa_share_begin(r)
    t_check_int("T11 begin after FAILED rc", st, MIXA_SHARE_ERR_STATE)
    mixa_share_destroy(r)

    st: mixa_share_create(@ r, fake_table_full())
    mixa_share_set_text(r, "first begin from NONE")
    mixa_share_set_context(r, (cast: (@: void) r))
    t_check_int("T11 fresh request event NONE", mixa_share_event(r), MIXA_SHARE_EVENT_NONE)
    st: mixa_share_begin(r)
    t_check_int("T11 first begin from NONE rc", st, MIXA_SHARE_OK)
    mixa_share_destroy(r)

    # --- T: null-argument negatives.
    t_check_int("T12 create(out=NULL)", mixa_share_create(0, fake_table_full()), MIXA_SHARE_ERR_ARG)
    t_check_int("T12 set_text(NULL req)", mixa_share_set_text(0, "x"), MIXA_SHARE_ERR_ARG)
    t_check_int("T12 begin(NULL)", mixa_share_begin(0), MIXA_SHARE_ERR_ARG)
    t_check_int("T12 file_at(NULL)", (cast: (int) (mixa_share_file_at(0, 0U) = 0)), 1)
    mixa_share_destroy(0)
    c.printf("CHK T12 destroy(0) no-crash PASS\n")

    if: g_failures[0] != 0
        c.printf("mixa share parity harness FAILED checks=%d\n", g_failures[0])
        return: 1
    c.printf("mixa share parity harness ok\n")
return: 0
