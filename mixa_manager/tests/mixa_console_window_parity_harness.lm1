predef: "mixa_manager/mixa_console_window_l2.h.lm1"
include: "mixa_manager/mixa_file.h" "mixa_manager/mixa_backend.h" "mixa_manager/mixa_core.h" "<stdio.h>" "<string.h>" "<stdlib.h>"

# Real L1-vs-L2 parity harness for mixa_console_window (ticket
# 20260913-121500). ONE harness source, compiled/linked twice (oracle/
# L2), "declare then link" convention -- mixa_console_*'s own real
# bodies come from either the unchanged mixa_console_window.lm1
# (oracle side) or the generated mixa_console_window.lm2 (L2 side).
# mixa_file_open/close/append/seek/read/size come from the REAL,
# unmodified mixa_file_win32.o, linked separately by the runner (real
# test-owned files under this run's own directory, mirroring the
# accepted mixa_console_window_selftest.lm1's own approach). mixa_
# backend_present is supplied by THIS HARNESS's own trivial test-double
# body below (not the real backend dispatch chain, which would pull in
# event_fifo/console_window's own real Win32 window machinery this
# harness has no business depending on) -- it just records the call and
# returns success, exactly the same "smallest real double, not an
# approximation of unrelated machinery" technique mixa_composite_
# glyphs_ctors_stub.lm1 already established.
#
# Coverage mirrors the accepted mixa_console_window_selftest.lm1's own
# real-behavior scenarios: argument validation, empty file, a short
# single line, a line with no trailing newline, character-wrap (not
# word-wrap) at the column boundary, UTF-8 multi-byte sequences spanning
# the internal chunk-read boundary, a file bigger than the viewport
# (ring-buffer "always show the last N rows" follow-cursor behavior),
# resize recomputation, and the pending-line overlay (empty/mid-line/
# wrap/history-scrolled/off-screen-at-bottom) -- plus the single
# render+composite+present hook end to end via the harness's own
# present() test double.

fn: mixa_console_view_init (@: MixaConsoleView view; @: MixaFile file; size_t: rows; size_t: cols) int
fn: mixa_console_view_resize (@: MixaConsoleView view; size_t: rows; size_t: cols) int
fn: mixa_console_view_recompute (@: MixaConsoleView view) int
fn: mixa_console_view_render (const: @(MixaConsoleView view); @: MixaTextRect rect; size_t: dest_row; size_t: dest_col; unsigned: fg; unsigned: bg; unsigned: flags; unsigned: alpha; const: @(MixaConsolePending pending)) int
fn: mixa_console_window_present (@: MixaConsoleView view; @: MixaTextRect text_rect; size_t: dest_row; size_t: dest_col; unsigned: fg; unsigned: bg; unsigned: flags; unsigned: alpha; const: @(MixaTextRect upper_rect); size_t: text_cw; size_t: text_ch; size_t: upper_cw; size_t: upper_ch; @: MixaBackend backend; @: MixaU8 rgba; size_t: rgba_size; size_t: width_px; size_t: height_px; const: @(MixaConsolePending pending)) int
fn: mixa_file_open (@@: MixaFile out; const: @(char path_utf8); int: mode) int
sub: mixa_file_close (@: MixaFile f)
fn: mixa_file_append (@: MixaFile f; const: @(void buf); size_t: n; @: size_t wrote) int
fn: mixa_rect_open (@: MixaTextRect rect; size_t: rows; size_t: cols) int
fn: mixa_cell_at (@: MixaTextRect rect; size_t: row; size_t: col) @: MixaCell

[]: int g_failures 1
int: g_present_calls
size_t: g_present_bytes

fn: mixa_backend_present (@: MixaBackend backend; const: @(MixaU8 rgba); size_t: bytes) int
    g_present_calls: g_present_calls + 1
    g_present_bytes: bytes
return: 0

sub: t_check_int (const: @(char label); int: got; int: want)
    if: got != want
        c.printf("CHK %s got=%d want=%d FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%d want=%d PASS\n", label, got, want)
end: t_check_int

sub: t_check_sz (const: @(char label); size_t: got; size_t: want)
    if: got != want
        c.printf("CHK %s got=%u want=%u FAIL\n", label, (cast: (unsigned) got), (cast: (unsigned) want))
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%u want=%u PASS\n", label, (cast: (unsigned) got), (cast: (unsigned) want))
end: t_check_sz

fn: t_write_new (const: @(char path); const: @(char content); size_t: len) int
    @: MixaFile f
    size_t: wrote
    int: rc
    rc: mixa_file_open(@ f, path, MIXA_FILE_MODE_APPEND)
    if: rc != MIXA_FILE_OK
        return: rc
    ---
    wrote: 0U
    rc: mixa_file_append(f, content, len, @ wrote)
    mixa_file_close(f)
    if: rc != MIXA_FILE_OK
        return: rc
    ---
    if: wrote != len
        return: MIXA_FILE_ERR_IO
return: MIXA_FILE_OK

fn: t_open_read (const: @(char path)) @: MixaFile
    @: MixaFile f
    if: mixa_file_open(@ f, path, MIXA_FILE_MODE_READ) != MIXA_FILE_OK
        return: 0
return: f

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char cmd 800
    []: char path 700
    @: MixaConsoleView view
    @: MixaTextRect rect
    @: MixaFile f
    @: MixaCell cell
    int: rc
    c.setbuf((cast: (@: void) c.stdout), 0)

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    ---
    if: argc < 2
        c.snprintf(base, 520U, "build/mixa/claude/console_window_parity/tmp")
    ---
    c.snprintf(cmd, 800U, "cmd /c mkdir \"%s\" 2>nul", base)
    c.system(cmd)

    view: (cast: (@: MixaConsoleView) c.calloc(1U, c.sizeof(c.MixaConsoleView)))
    rect: (cast: (@: MixaTextRect) c.calloc(1U, c.sizeof(c.MixaTextRect)))
    if: view = 0 || rect = 0
        c.printf("console_window parity: alloc failed\n")
        return: 1
    ---
    if: mixa_rect_open(rect, 5U, 10U) != 0
        c.printf("console_window parity: rect_open failed\n")
        return: 1

    # --- argument validation ---
    t_check_int("init null view", mixa_console_view_init(0, (cast: (@: MixaFile) 1), 5U, 10U), MIXA_CONSOLE_ERR_ARG)
    t_check_int("init null file", mixa_console_view_init(view, 0, 5U, 10U), MIXA_CONSOLE_ERR_ARG)

    c.snprintf(path, 700U, "%s\\empty.log", base)
    t_write_new(path, "", 0U)
    f: t_open_read(path)
    if: f = 0
        c.printf("console_window parity: opening empty fixture failed\n")
        return: 1
    ---
    t_check_int("init rows=0", mixa_console_view_init(view, f, 0U, 10U), MIXA_CONSOLE_ERR_ARG)
    t_check_int("init cols=0", mixa_console_view_init(view, f, 5U, 0U), MIXA_CONSOLE_ERR_ARG)

    # --- empty file: cursor at 0,0, one visible (empty) row ---
    t_check_int("init empty ok", mixa_console_view_init(view, f, 5U, 10U), MIXA_CONSOLE_OK)
    t_check_sz("empty top_offset", view\top_offset, 0U)
    t_check_sz("empty cursor_row", view\cursor_row, 0U)
    t_check_sz("empty cursor_col", view\cursor_col, 0U)
    mixa_file_close(f)

    # --- short single line, no trailing newline: cursor after it ---
    c.snprintf(path, 700U, "%s\\short.log", base)
    t_write_new(path, "hi", 2U)
    f: t_open_read(path)
    t_check_int("init short ok", mixa_console_view_init(view, f, 5U, 10U), MIXA_CONSOLE_OK)
    t_check_sz("short cursor_row", view\cursor_row, 0U)
    t_check_sz("short cursor_col", view\cursor_col, 2U)
    t_check_sz("short top_offset", view\top_offset, 0U)
    mixa_file_close(f)

    # --- character wrap at the column boundary (cols=10): 25 'a's wrap
    # into 3 rows (10+10+5), never breaking mid-word by intent since
    # there IS no word-boundary logic at all -- pure by-character wrap ---
    if: 1
        []: char wrap25 26
        int: wi
        wi: 0
        while: wi < 25
            wrap25[wi]: (cast: (char) 97)
            wi: wi + 1
        ---
        c.snprintf(path, 700U, "%s\\wrap.log", base)
        t_write_new(path, wrap25, 25U)
        f: t_open_read(path)
        t_check_int("init wrap ok", mixa_console_view_init(view, f, 5U, 10U), MIXA_CONSOLE_OK)
        t_check_sz("wrap cursor_row", view\cursor_row, 2U)
        t_check_sz("wrap cursor_col", view\cursor_col, 5U)
        mixa_file_close(f)
    ---

    # --- UTF-8 sequence spanning the internal 256-byte chunk boundary:
    # 254 ASCII 'x' bytes then a 2-byte UTF-8 codepoint (0xC3 0xA9 = 'e
    # with acute') straddling the chunk edge at byte 256 -- proves the
    # chunk_trim dangling-lead-byte rule decodes it correctly rather
    # than splitting it into two garbage codepoints ---
    if: 1
        []: char utf8buf 260
        int: ui
        ui: 0
        while: ui < 254
            utf8buf[ui]: (cast: (char) 120)
            ui: ui + 1
        ---
        utf8buf[254]: (cast: (char) 0xC3)
        utf8buf[255]: (cast: (char) 0xA9)
        c.snprintf(path, 700U, "%s\\utf8.log", base)
        t_write_new(path, utf8buf, 256U)
        f: t_open_read(path)
        # cols=300 so no wrapping happens -- all 255 codepoints (254
        # ASCII + 1 multi-byte) land on row 0, proving the 2-byte
        # sequence decoded as ONE codepoint, not two.
        t_check_int("init utf8-boundary ok", mixa_console_view_init(view, f, 5U, 300U), MIXA_CONSOLE_OK)
        t_check_sz("utf8-boundary cursor_row", view\cursor_row, 0U)
        t_check_sz("utf8-boundary cursor_col", view\cursor_col, 255U)
        mixa_file_close(f)
    ---

    # --- file bigger than the viewport: ring-buffer keeps only the LAST
    # `rows` rows, top_offset anchored to the oldest SURVIVING row, not
    # the file's own start (the "always show the last rows wrapped rows"
    # / follow-cursor requirement) ---
    if: 1
        []: char tenlines 30
        int: li
        li: 0
        while: li < 10
            tenlines[li * 3]: (cast: (char) (49 + li))
            tenlines[li * 3 + 1]: (cast: (char) 10)
            li: li + 1
        ---
        c.snprintf(path, 700U, "%s\\long.log", base)
        t_write_new(path, tenlines, 20U)
        f: t_open_read(path)
        t_check_int("init long ok", mixa_console_view_init(view, f, 3U, 10U), MIXA_CONSOLE_OK)
        # 10 lines "1\n".."9\n" then a trailing empty 10th row after the
        # final \n -- with rows=3 only the last 3 rows survive: "9\n"'s
        # own row plus the trailing empty row plus one more before it.
        t_check_sz("long cursor_row", view\cursor_row, 2U)
        t_check_sz("long cursor_col", view\cursor_col, 0U)
        # top_offset must NOT be 0 (the file's own start) -- it must be
        # anchored to the oldest surviving ring entry instead.
        t_check_int("long top_offset not file start", (cast: (int) (view\top_offset != 0U)), 1)

        # --- resize recomputation: growing rows changes cursor_row
        # (more history becomes visible) without touching the file ---
        t_check_int("resize ok", mixa_console_view_resize(view, 5U, 10U), MIXA_CONSOLE_OK)
        t_check_sz("resize cursor_row", view\cursor_row, 4U)
        mixa_file_close(f)
    ---

    # --- render(): real fill, real cell placement, real REVERSE cursor
    # marking, KEEP_BG preserving prior bg ---
    if: 1
        size_t: prow
        size_t: pcol
        c.snprintf(path, 700U, "%s\\render.log", base)
        t_write_new(path, "ab", 2U)
        f: t_open_read(path)
        mixa_console_view_init(view, f, 5U, 10U)
        rc: mixa_console_view_render(view, rect, 0U, 0U, 7U, 2U, 0U, 255U, 0)
        t_check_int("render ok", rc, MIXA_CONSOLE_OK)
        cell: mixa_cell_at(rect, 0U, 0U)
        t_check_int("render cell0 codepoint", (cast: (int) cell\codepoint), 97)
        t_check_int("render cell0 fg", (cast: (int) cell\fg), 7)
        cell: mixa_cell_at(rect, 0U, 1U)
        t_check_int("render cell1 codepoint", (cast: (int) cell\codepoint), 98)
        # cursor at (0,2): codepoint was 0 (untouched) -> given a space
        # glyph first, then REVERSE flag set
        cell: mixa_cell_at(rect, 0U, 2U)
        t_check_int("render cursor cell codepoint", (cast: (int) cell\codepoint), 32)
        t_check_int("render cursor cell reverse flag", (cast: (int) (cell\flags & MIXA_STYLE_REVERSE)), (cast: (int) MIXA_STYLE_REVERSE))
        prow: 0U
        pcol: 0U
        mixa_file_close(f)
    ---

    # --- pending overlay: continues from committed content's own
    # row/col, marks ITS OWN cursor position instead of the file's end,
    # by-character wrap identical to committed content ---
    if: 1
        []: unsigned pend_cps 5
        @: MixaConsolePending pend
        pend_cps[0]: 88U
        pend_cps[1]: 89U
        pend_cps[2]: 90U
        pend: (cast: (@: MixaConsolePending) c.calloc(1U, c.sizeof(c.MixaConsolePending)))
        pend\cps: pend_cps
        pend\len: 3U
        pend\cursor: 1U
        c.snprintf(path, 700U, "%s\\pending.log", base)
        t_write_new(path, "z", 1U)
        f: t_open_read(path)
        c.memset(rect\cells, 0, rect\rows * rect\cols * c.sizeof(c.MixaCell))
        mixa_console_view_init(view, f, 5U, 10U)
        rc: mixa_console_view_render(view, rect, 0U, 0U, 1U, 0U, 0U, 255U, pend)
        t_check_int("pending render ok", rc, MIXA_CONSOLE_OK)
        # committed "z" at col0, pending X,Y,Z at col1,2,3 -- cursor
        # (pend\cursor=1) lands on the pending 'Y' cell (col2), reverse-marked.
        cell: mixa_cell_at(rect, 0U, 0U)
        t_check_int("pending committed cell", (cast: (int) cell\codepoint), 122)
        cell: mixa_cell_at(rect, 0U, 1U)
        t_check_int("pending cell X", (cast: (int) cell\codepoint), 88)
        cell: mixa_cell_at(rect, 0U, 2U)
        t_check_int("pending cursor cell Y", (cast: (int) cell\codepoint), 89)
        t_check_int("pending cursor cell reverse", (cast: (int) (cell\flags & MIXA_STYLE_REVERSE)), (cast: (int) MIXA_STYLE_REVERSE))
        cell: mixa_cell_at(rect, 0U, 3U)
        t_check_int("pending cell Z (no reverse)", (cast: (int) (cell\flags & MIXA_STYLE_REVERSE)), 0)
        mixa_file_close(f)
        c.free(pend)
    ---

    # --- full present() pipeline: render + composite + the harness's
    # own mixa_backend_present test double, called exactly once with
    # the real, nonzero rgba_size ---
    if: 1
        @: MixaTextRect upper
        []: MixaU8 rgba 12800
        size_t: rgba_size
        rgba_size: 12800U
        upper: (cast: (@: MixaTextRect) c.calloc(1U, c.sizeof(c.MixaTextRect)))
        upper\rows: 5U
        upper\cols: 10U
        upper\cells: (cast: (@: MixaCell) c.calloc(50U, c.sizeof(c.MixaCell)))
        c.snprintf(path, 700U, "%s\\present.log", base)
        t_write_new(path, "present-test", 12U)
        f: t_open_read(path)
        c.memset(rect\cells, 0, rect\rows * rect\cols * c.sizeof(c.MixaCell))
        mixa_console_view_init(view, f, 5U, 10U)
        g_present_calls: 0
        g_present_bytes: 0U
        rc: mixa_console_window_present(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, upper, 8U, 8U, 8U, 8U, (cast: (@: MixaBackend) 1), rgba, rgba_size, 80U, 40U, 0)
        t_check_int("present ok", rc, MIXA_CONSOLE_OK)
        t_check_int("present backend called once", g_present_calls, 1)
        t_check_sz("present backend bytes", g_present_bytes, rgba_size)
        t_check_int("present null backend refused", mixa_console_window_present(view, rect, 0U, 0U, 7U, 0U, 0U, 255U, upper, 8U, 8U, 8U, 8U, 0, rgba, rgba_size, 80U, 40U, 0), MIXA_CONSOLE_ERR_ARG)
        mixa_file_close(f)
        c.free(upper\cells)
        c.free(upper)
    ---

    if: g_failures[0] != 0
        c.printf("mixa console window parity harness FAILED checks=%d\n", g_failures[0])
        return: 1
    c.printf("mixa console window parity harness ok\n")
return: 0
