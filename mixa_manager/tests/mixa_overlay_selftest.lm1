predef: "mixa_manager/mixa_composite.lm1"
include: "<stdio.h>" "<string.h>"

# OverlayRect + composite pixel contract. No window.

fn: main () int
    @: MixaOverlayRect overlay
    @: MixaTextRect rect
    @: MixaU8 px
    @: MixaU8 out
    @: MixaU8 edge
    []: size_t ox 1
    []: size_t oy 1
    []: MixaU8 tiny 4
    size_t: need
    size_t: i
    size_t: n
    int: failures
    int: rc
    unsigned: v
    failures: 0

    overlay: (cast: (@: MixaOverlayRect) c.calloc(1U, c.sizeof(c.MixaOverlayRect)))
    rect: (cast: (@: MixaTextRect) c.calloc(1U, c.sizeof(c.MixaTextRect)))
    if: overlay = 0 || rect = 0
        c.printf("mixa overlay: header allocation failed\n")
        return: 1

    if: mixa_overlay_open(overlay, 3U, 2U, 4U, 5U) != 0
        c.printf("mixa overlay: open 3x2 cell 4x5 failed\n")
        return: 1
    if: overlay\width != 12U || overlay\height != 10U
        c.printf("mixa overlay: open pixel size mismatch\n")
        failures: failures + 1
    if: overlay\cols != 3U || overlay\rows != 2U
        c.printf("mixa overlay: open cell grid mismatch\n")
        failures: failures + 1

    # Fresh overlay: all alpha 0
    i: 0U
    n: overlay\width * overlay\height
    while: i < n
        px: overlay\pixels + (i * 4U)
        if: px[3] != 0
            c.printf("mixa overlay: fresh pixel alpha not 0\n")
            failures: failures + 1
            i: n
        ---
        i: i + 1U
    ---

    # pixel_at OOB by x and by y separately
    if: mixa_overlay_pixel_at(overlay, 12U, 0U) != 0
        c.printf("mixa overlay: pixel_at x OOB not 0\n")
        failures: failures + 1
    if: mixa_overlay_pixel_at(overlay, 0U, 10U) != 0
        c.printf("mixa overlay: pixel_at y OOB not 0\n")
        failures: failures + 1
    px: mixa_overlay_pixel_at(overlay, 0U, 0U)
    if: px = 0
        c.printf("mixa overlay: pixel_at in bounds returned 0\n")
        failures: failures + 1

    # cell_origin matches section 1: x=col*cw, y=row*ch
    if: mixa_overlay_cell_origin(overlay, 1U, 2U, ox, oy) != 0
        c.printf("mixa overlay: cell_origin failed\n")
        failures: failures + 1
    if: ox[0] != 8U || oy[0] != 5U
        c.printf("mixa overlay: cell_origin values wrong\n")
        failures: failures + 1

    # fill_cell_block paints exactly its rect
    if: mixa_overlay_fill_cell_block(overlay, 0U, 1U, 1U, 1U, 10U, 20U, 30U, 255U) != 0
        c.printf("mixa overlay: fill_cell_block failed\n")
        failures: failures + 1
    px: mixa_overlay_pixel_at(overlay, 4U, 0U)
    if: px = 0 || px[0] != 10 || px[1] != 20 || px[2] != 30 || px[3] != 255
        c.printf("mixa overlay: fill_cell_block inside not painted\n")
        failures: failures + 1
    edge: mixa_overlay_pixel_at(overlay, 8U, 0U)
    if: edge = 0 || edge[0] != 0 || edge[1] != 0 || edge[2] != 0 || edge[3] != 0
        c.printf("mixa overlay: fill_cell_block spilled one column right\n")
        failures: failures + 1
    edge: mixa_overlay_pixel_at(overlay, 3U, 0U)
    if: edge = 0 || edge[3] != 0
        c.printf("mixa overlay: fill_cell_block spilled one column left\n")
        failures: failures + 1

    # reopen refuse
    if: mixa_overlay_open(overlay, 3U, 2U, 4U, 5U) = 0
        c.printf("mixa overlay: re-open accepted\n")
        failures: failures + 1

    mixa_overlay_clear(overlay)
    i: 0U
    n: overlay\width * overlay\height
    while: i < n
        px: overlay\pixels + (i * 4U)
        if: px[3] != 0
            c.printf("mixa overlay: clear left non-zero alpha\n")
            failures: failures + 1
            i: n
        ---
        i: i + 1U
    ---

    if: mixa_rect_open(rect, 2U, 3U) != 0
        c.printf("mixa overlay: text rect open failed\n")
        return: 1
    mixa_rect_fill(rect, 0U, 15U, 1U, 0U)
    # cell (0,0) empty bg=1 (red 170,0,0); cell (0,1) glyph 'A' fg=15 bg=1
    mixa_rect_put_text(rect, 0U, 1U, "A", 15U, 1U, 0U)

    need: overlay\width * overlay\height * 4U
    out: (cast: (@: MixaU8) c.malloc(need))
    if: out = 0
        c.printf("mixa overlay: out buffer alloc failed\n")
        return: 1

    # composite with clear overlay -> cell backgrounds (and stub glyph)
    mixa_overlay_clear(overlay)
    if: mixa_composite(rect, overlay, out, need) != 0
        c.printf("mixa overlay: composite clear failed\n")
        failures: failures + 1
    # cell (0,0) empty: bg palette[1] = 170,0,0 at pixel (0,0)
    if: out[0] != 170 || out[1] != 0 || out[2] != 0 || out[3] != 255
        c.printf("mixa overlay: composite bg not palette[1]\n")
        failures: failures + 1
    # cell (0,1) has glyph: stub fills with fg palette[15] = 255,255,255 at (4,0)
    px: out + ((0U * overlay\width + 4U) * 4U)
    if: px[0] != 255 || px[1] != 255 || px[2] != 255 || px[3] != 255
        c.printf("mixa overlay: composite glyph stub not palette[fg]\n")
        failures: failures + 1

    # opaque overlay covers text underneath
    mixa_overlay_clear(overlay)
    if: mixa_overlay_fill_cell_block(overlay, 0U, 1U, 1U, 1U, 0U, 0U, 255U, 255U) != 0
        c.printf("mixa overlay: opaque fill failed\n")
        failures: failures + 1
    if: mixa_composite(rect, overlay, out, need) != 0
        c.printf("mixa overlay: composite opaque failed\n")
        failures: failures + 1
    px: out + ((0U * overlay\width + 4U) * 4U)
    if: px[0] != 0 || px[1] != 0 || px[2] != 255 || px[3] != 255
        c.printf("mixa overlay: opaque overlay did not cover glyph\n")
        failures: failures + 1

    # a=128 blend: dst R=0 (from bg after clear glyph cell? use empty cell)
    # Prepare: fill text all empty bg=0 (black), overlay half-red a=128 over cell 0,0
    mixa_rect_fill(rect, 0U, 0U, 0U, 0U)
    mixa_overlay_clear(overlay)
    if: mixa_overlay_fill_cell_block(overlay, 0U, 0U, 1U, 1U, 255U, 0U, 0U, 128U) != 0
        c.printf("mixa overlay: blend fill failed\n")
        failures: failures + 1
    if: mixa_composite(rect, overlay, out, need) != 0
        c.printf("mixa overlay: composite blend failed\n")
        failures: failures + 1
    # dst R=0 (palette[0]), src R=255, sa=128 -> (255*128 + 0*127)/255 = 128
    v: out[0]
    if: v != 128U
        c.printf("mixa overlay: blend R expected 128 got %u\n", v)
        failures: failures + 1
    if: out[1] != 0 || out[2] != 0 || out[3] != 255
        c.printf("mixa overlay: blend G/B/A wrong\n")
        failures: failures + 1

    # out_size too small -> refuse
    tiny[0]: (cast: (MixaU8) 9)
    tiny[1]: (cast: (MixaU8) 9)
    tiny[2]: (cast: (MixaU8) 9)
    tiny[3]: (cast: (MixaU8) 9)
    rc: mixa_composite(rect, overlay, tiny, 4U)
    if: rc = 0
        c.printf("mixa overlay: composite accepted tiny out_size\n")
        failures: failures + 1
    if: tiny[0] != 9 || tiny[1] != 9 || tiny[2] != 9 || tiny[3] != 9
        c.printf("mixa overlay: composite tiny wrote past end\n")
        failures: failures + 1

    c.free(out)
    mixa_overlay_release(overlay)
    mixa_rect_release(rect)
    c.free(overlay)
    c.free(rect)

    if: failures != 0
        c.printf("mixa overlay selftest FAILED checks=%d\n", failures)
        return: 1
    c.printf("mixa overlay selftest ok\n")
    return: 0