predef: "mixa_manager/mixa_copy_l2.h.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# Real L1-vs-L2 parity harness for mixa_copy (copy-chain ticket
# 20260913-185600, module 1 of 4: mixa_copy, mixa_fm_copy, mixa_pump,
# mixa_process_win32). ONE harness source, compiled/linked twice
# (oracle/L2), "declare then link" -- mixa_copy_run's own real body
# comes from either the unchanged mixa_copy.lm1 (oracle side) or the
# generated mixa_copy.lm2 (L2 side). Scenario coverage is drawn
# directly from the existing, already-accepted mixa_copy_selftest.lm1:
# content equality copying a whole real tree (structure rebuilt, every
# byte round-tripped, directory event coverage exactly once per
# directory, a fully-copied root deselected); re-copying the same tree
# refuses EVERY file with a real CREATE_NEW conflict (no overwrite) yet
# the overall run reports OK because the sink chooses to continue, and
# a root where every file conflicted stays selected for retry; an
# EXISTING destination directory is merged into silently (only files
# respect no-overwrite), proven by a pre-seeded conflicting file
# alongside a genuinely new one landing correctly, and a partially-
# conflicted root stays selected; cancellation on the 2nd sink event
# reports CANCELLED, leaves the root selected, and a retry with no cap
# completes the remainder and then deselects the root; a real mid-file
# I/O fault (via the deterministic fault hook) leaves the exact partial
# bytes cleaned up (not partially on disk), reports the file event with
# the real IO status, keeps the source selected, and a retry with the
# fault lifted completes it with correct content; a destination INSIDE
# the source (and a destination EQUAL to the source) is refused up
# front as NESTED with no descent and no directory created; an
# unrelated destination that merely shares a string prefix (not a real
# descendant) is unaffected by the nested check; and argument
# negatives plus a trivially successful empty-selection run.

fn: mixa_copy_run (@: MixaSelection sel; const: @(char dest_root_utf8); const: @(MixaCopySink sink); const: @(MixaFioFaultVTable fv)) int

int: g_calls
[]: char g_trace 4000
size_t: g_trace_len
int: g_fail_at_call
int: g_fail_status

fn: t_base (const: @(char path)) const: @(char)
    size_t: n
    size_t: i
    size_t: last
    int: found
    n: c.strlen(path)
    last: 0U
    found: 0
    i: 0U
    while: i < n
        if: path[i] = (cast: (char) 92) || path[i] = (cast: (char) 47)
            last: i + 1U
            found: 1
        ---
        i: i + 1U
    ---
    if: found = 0
        return: path
return: path + last

sub: t_record (const: @(char kind); const: @(char path); int: status)
    size_t: room
    if: g_trace_len + 80U >= 4000U
        return
    ---
    room: 4000U - g_trace_len
    c.snprintf(g_trace + g_trace_len, room, "%s:%s:%d|", kind, t_base(path), status)
    g_trace_len: c.strlen(g_trace)
end: t_record

fn: t_note (const: @(char kind); const: @(char path); int: status) int
    g_calls: g_calls + 1
    t_record(kind, path, status)
    if: g_fail_at_call != 0 && g_calls = g_fail_at_call
        return: g_fail_status
    ---
return: MIXA_SEL_WALK_GO

fn: cb_dir_enter (@: void ctx; const: @(char src); const: @(char dst); int: is_dir; int: status) int
return: t_note("D", src, status)

fn: cb_file (@: void ctx; const: @(char src); const: @(char dst); int: is_dir; int: status) int
return: t_note("F", src, status)

fn: cb_dir_done (@: void ctx; const: @(char src); const: @(char dst); int: is_dir; int: status) int
return: t_note("E", src, status)

@: MixaCopySink g_sink
int: g_sink_ready

fn: t_sink () const: @(MixaCopySink)
    if: g_sink_ready = 0
        g_sink: (cast: (@: MixaCopySink) c.calloc(1U, c.sizeof(c.MixaCopySink)))
        g_sink\on_dir_enter: cb_dir_enter
        g_sink\on_file: cb_file
        g_sink\on_dir_done: cb_dir_done
        g_sink_ready: 1
    ---
return: g_sink

sub: t_reset ()
    g_calls: 0
    g_trace[0]: 0
    g_trace_len: 0U
    g_fail_at_call: 0
    g_fail_status: 0
end: t_reset

fn: t_count (const: @(char needle)) int
    const: @(char p)
    int: n
    n: 0
    p: c.strstr(g_trace, needle)
    while: p != 0
        n: n + 1
        p: c.strstr(p + 1U, needle)
    ---
return: n

sub: t_touch (const: @(char path); const: @(char content))
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "wb")
    if: fh[0] != 0
        c.fputs(content, fh[0])
        c.fclose(fh[0])
    ---
end: t_touch

fn: t_read_all (const: @(char path); @: char out_buf; size_t: cap) int
    []: (@: void) fh 1
    size_t: n
    fh[0]: c.fopen(path, "rb")
    if: fh[0] = 0
        return: -1
    ---
    n: c.fread(out_buf, 1U, cap - 1U, fh[0])
    out_buf[n]: 0
    c.fclose(fh[0])
return: (cast: (int) n)

fn: t_exists (const: @(char path)) int
    []: (@: void) fh 1
    fh[0]: c.fopen(path, "rb")
    if: fh[0] = 0
        return: 0
    ---
    c.fclose(fh[0])
return: 1

int: g_fault_at
int: g_fault_calls

fn: fault_hook (@: void ctx; size_t: bytes_done) int
    g_fault_calls: g_fault_calls + 1
    if: g_fault_at >= 0
        if: (cast: (int) bytes_done) >= g_fault_at
            return: MIXA_FIO_ERR_IO
        ---
    ---
return: MIXA_FIO_OK

@: MixaFioFaultVTable g_fv
int: g_fv_ready

fn: t_fv () const: @(MixaFioFaultVTable)
    if: g_fv_ready = 0
        g_fv: (cast: (@: MixaFioFaultVTable) c.calloc(1U, c.sizeof(c.MixaFioFaultVTable)))
        g_fv\on_read: fault_hook
        g_fv\on_write: fault_hook
        g_fv_ready: 1
    ---
return: g_fv

[]: int g_failures 1

sub: t_check_int (const: @(char label); int: got; int: want)
    if: got != want
        c.printf("CHK %s got=%d want=%d FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%d want=%d PASS\n", label, got, want)
end: t_check_int

sub: t_check_str (const: @(char label); const: @(char got); const: @(char want))
    int: eq
    eq: 0
    if: got != 0 && want != 0
        if: c.strcmp(got, want) = 0
            eq: 1
        ---
    ---
    if: eq = 0
        c.printf("CHK %s got=%s want=%s FAIL\n", label, got, want)
        g_failures[0]: g_failures[0] + 1
        return
    ---
    c.printf("CHK %s got=%s want=%s PASS\n", label, got, want)
end: t_check_str

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char src_root 1040
    []: char dira 1040
    []: char dirb 1040
    []: char dest1 1040
    []: char dest2 1040
    []: char dest3 1040
    []: char single_file 1040
    []: char nested_dest 1040
    []: char dest1x 1040
    []: char p1 1200
    []: char cmd 2400
    []: char readbuf 4100
    @: MixaSelection sel
    const: @(MixaCopySink sink)
    int: rc
    int: st
    c.setbuf((cast: (@: void) c.stdout), 0)
    g_fault_at: -1

    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    else:
        c.snprintf(base, 520U, "build/mixa/claude/copy_l2_parity/tmp")
    ---
    c.snprintf(src_root, 1040U, "%s\\src", base)
    c.snprintf(dira, 1040U, "%s\\a", src_root)
    c.snprintf(dirb, 1040U, "%s\\b", src_root)
    c.snprintf(single_file, 1040U, "%s\\top.txt", src_root)
    c.snprintf(dest1, 1040U, "%s\\dest1", base)
    c.snprintf(dest2, 1040U, "%s\\dest2", base)
    c.snprintf(dest3, 1040U, "%s\\dest3", base)

    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", src_root)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dira)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dirb)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest1)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest2)
    c.system(cmd)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest3)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\a1.txt", dira)
    t_touch(p1, "content-a1")
    c.snprintf(p1, 1200U, "%s\\a2.txt", dira)
    t_touch(p1, "content-a2")
    c.snprintf(p1, 1200U, "%s\\b1.txt", dirb)
    t_touch(p1, "content-b1")
    t_touch(single_file, "top-level-content")

    sel: (cast: (@: MixaSelection) c.calloc(1U, c.sizeof(c.MixaSelection)))
    if: sel = 0
        c.printf("copy parity: alloc failed\n")
        return: 1
    ---
    t_check_int("S0 selection init", mixa_selection_init(sel), MIXA_SEL_OK)
    sink: t_sink()

    # --- Scenario 1: content equality.
    mixa_selection_select(sel, src_root)
    t_reset()
    rc: mixa_copy_run(sel, dest1, sink, 0)
    t_check_int("S1 run rc", rc, MIXA_COPY_OK)
    c.snprintf(p1, 1200U, "%s\\src\\a\\a1.txt", dest1)
    st: t_read_all(p1, readbuf, 4100U)
    t_check_int("S1 a1 read ok", (cast: (int) (st >= 0)), 1)
    t_check_str("S1 a1 content", readbuf, "content-a1")
    c.snprintf(p1, 1200U, "%s\\src\\a\\a2.txt", dest1)
    st: t_read_all(p1, readbuf, 4100U)
    t_check_str("S1 a2 content", readbuf, "content-a2")
    c.snprintf(p1, 1200U, "%s\\src\\b\\b1.txt", dest1)
    st: t_read_all(p1, readbuf, 4100U)
    t_check_str("S1 b1 content", readbuf, "content-b1")
    t_check_int("S1 dir event coverage", (cast: (int) (t_count("D:a:0|") = 1 && t_count("D:b:0|") = 1 && t_count("E:a:0|") = 1 && t_count("E:b:0|") = 1)), 1)
    t_check_int("S1 root deselected", mixa_selection_query(sel, src_root), 0)

    # --- Scenario 2: existing-destination preservation.
    mixa_selection_select(sel, src_root)
    t_reset()
    rc: mixa_copy_run(sel, dest1, sink, 0)
    t_check_int("S2 re-copy rc", rc, MIXA_COPY_OK)
    t_check_int("S2 every file EXISTS", (cast: (int) (t_count("F:a1.txt:104|") = 1 && t_count("F:a2.txt:104|") = 1 && t_count("F:b1.txt:104|") = 1 && t_count("F:top.txt:104|") = 1)), 1)
    c.snprintf(p1, 1200U, "%s\\src\\a\\a1.txt", dest1)
    st: t_read_all(p1, readbuf, 4100U)
    t_check_str("S2 existing content undisturbed", readbuf, "content-a1")
    t_check_int("S2 root stays selected", mixa_selection_query(sel, src_root), 1)
    mixa_selection_deselect(sel, src_root)

    # --- Scenario 3: merge into an existing destination directory.
    c.snprintf(p1, 1200U, "%s\\b", dest1)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", p1)
    c.system(cmd)
    c.snprintf(p1, 1200U, "%s\\b\\b1.txt", dest1)
    t_touch(p1, "pre-existing-conflict")
    c.snprintf(p1, 1200U, "%s\\b2.txt", dirb)
    t_touch(p1, "content-b2")
    t_check_int("S3 select dirb", mixa_selection_select(sel, dirb), MIXA_SEL_OK)
    t_reset()
    rc: mixa_copy_run(sel, dest1, sink, 0)
    t_check_int("S3 merge run rc", rc, MIXA_COPY_OK)
    t_check_int("S3 pre-existing b1 refused", t_count("F:b1.txt:104|"), 1)
    c.snprintf(p1, 1200U, "%s\\b\\b2.txt", dest1)
    t_check_int("S3 new file in merged dir", t_exists(p1), 1)
    t_check_int("S3 merge event once", t_count("D:b:0|"), 1)
    t_check_int("S3 dirb stays selected", mixa_selection_query(sel, dirb), 1)
    mixa_selection_deselect(sel, dirb)

    # --- Scenario 4: cancellation and retry.
    t_check_int("S4 reselect src_root", mixa_selection_select(sel, src_root), MIXA_SEL_OK)
    t_reset()
    g_fail_at_call: 2
    g_fail_status: MIXA_SEL_WALK_STOP
    rc: mixa_copy_run(sel, dest2, sink, 0)
    t_check_int("S4 cancel rc", rc, MIXA_COPY_CANCELLED)
    t_check_int("S4 cancelled root still selected", mixa_selection_query(sel, src_root), 1)
    t_reset()
    rc: mixa_copy_run(sel, dest2, sink, 0)
    t_check_int("S4 retry rc", rc, MIXA_COPY_OK)
    c.snprintf(p1, 1200U, "%s\\src\\a\\a1.txt", dest2)
    t_check_int("S4 retry completed a1", t_exists(p1), 1)
    c.snprintf(p1, 1200U, "%s\\src\\b\\b1.txt", dest2)
    t_check_int("S4 retry completed b1", t_exists(p1), 1)
    t_check_int("S4 root deselected after finish", mixa_selection_query(sel, src_root), 0)

    # --- Scenario 5: a real mid-file I/O fault.
    mixa_selection_select(sel, single_file)
    t_reset()
    g_fault_at: 4
    g_fault_calls: 0
    rc: mixa_copy_run(sel, dest3, sink, t_fv())
    t_check_int("S5 io-failure run rc", rc, MIXA_COPY_OK)
    t_check_int("S5 fault hook called", (cast: (int) (g_fault_calls != 0)), 1)
    c.snprintf(p1, 1200U, "%s\\top.txt", dest3)
    t_check_int("S5 partial file cleaned up", t_exists(p1), 0)
    t_check_int("S5 source stays selected", mixa_selection_query(sel, single_file), 1)
    t_check_int("S5 file event exact IO status", t_count("F:top.txt:105|"), 1)
    g_fault_at: -1
    t_reset()
    rc: mixa_copy_run(sel, dest3, sink, t_fv())
    t_check_int("S5 retry after IO rc", rc, MIXA_COPY_OK)
    st: t_read_all(p1, readbuf, 4100U)
    t_check_str("S5 retried content", readbuf, "top-level-content")

    # --- Scenario 6: nested-destination termination.
    c.snprintf(nested_dest, 1040U, "%s\\nested_inside", dira)
    mixa_selection_select(sel, dira)
    t_reset()
    rc: mixa_copy_run(sel, nested_dest, sink, 0)
    t_check_int("S6 nested-dest rc", rc, MIXA_COPY_ERR_NESTED)
    t_check_int("S6 nested dir not created", t_exists(nested_dest), 0)
    t_check_int("S6 no files copied", t_count("F:"), 0)
    t_reset()
    rc: mixa_copy_run(sel, dira, sink, 0)
    t_check_int("S6 dest==source rc", rc, MIXA_COPY_ERR_NESTED)
    mixa_selection_deselect(sel, dira)

    # --- Scenario 7: a sibling destination sharing a string prefix.
    c.snprintf(dest1x, 1040U, "%sx", dest1)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", dest1x)
    c.system(cmd)
    mixa_selection_select(sel, single_file)
    t_reset()
    rc: mixa_copy_run(sel, dest1x, sink, 0)
    t_check_int("S7 prefix-sharing sibling rc", rc, MIXA_COPY_OK)

    # --- Scenario 8: argument negatives; empty selection is a trivial
    # success.
    t_check_int("S8 null sel", mixa_copy_run(0, dest1, sink, 0), MIXA_COPY_ERR_ARG)
    t_check_int("S8 null dest", mixa_copy_run(sel, 0, sink, 0), MIXA_COPY_ERR_ARG)
    t_check_int("S8 null sink", mixa_copy_run(sel, dest1, 0, 0), MIXA_COPY_ERR_ARG)
    mixa_selection_release(sel)
    mixa_selection_init(sel)
    t_reset()
    rc: mixa_copy_run(sel, dest1, sink, 0)
    t_check_int("S8 empty selection rc", rc, MIXA_COPY_OK)
    t_check_int("S8 empty selection no calls", g_calls, 0)

    mixa_selection_release(sel)
    c.free(sel)

    if: g_failures[0] != 0
        c.printf("mixa copy parity harness FAILED checks=%d\n", g_failures[0])
        return: 1
    c.printf("mixa copy parity harness ok\n")
return: 0
