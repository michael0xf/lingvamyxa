predef: "mixa_manager/mixa_process_marker.h.lm1"
predef: "mixa_manager/mixa_process_marker.lm1"
include: "<stdio.h>"

fn: main () int
    MixaProcessMarkerResult: result_storage
    @: MixaProcessMarkerResult result
    MixaProcessMarkerResult: initial_storage
    @: MixaProcessMarkerResult initial
    int: rc
    int: failures
    int: checks
    
    result: @ result_storage
    initial: @ initial_storage
    failures: 0
    checks: 0
    
    const: @(char marker) "MARKER_1"
    
    # Test 1: zero exit - ORIGINAL BASELINE CASE
    # "MARKER_1\t0\t/home/user" = 21 bytes, offset=11, cwd_len=10
    result\exit_code: 0
    result\cwd_offset: 0
    result\cwd_length: 0
    const: @(char p1) "MARKER_1\t0\t/home/user"
    rc: mixa_process_marker_parse(marker, 8, p1, 21, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        c.printf("t1-rc: got %d want %d\n", rc, MIXA_PROCESS_MARKER_OK)
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != 0
        c.printf("t1-exit_code: got %d want 0\n", result\exit_code)
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != 11
        c.printf("t1-cwd_offset: got %zu want 11\n", result\cwd_offset)
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != 10
        c.printf("t1-cwd_length: got %zu want 10\n", result\cwd_length)
        failures: failures + 1
    
    # Test 2: +5 exit - 14 bytes, offset=12, cwd_len=2
    result\exit_code: 0
    result\cwd_offset: 0
    result\cwd_length: 0
    const: @(char p2) "MARKER_1\t+5\t/x"
    rc: mixa_process_marker_parse(marker, 8, p2, 14, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        c.printf("t2-rc: got %d want %d\n", rc, MIXA_PROCESS_MARKER_OK)
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != 5
        c.printf("t2-exit_code: got %d want 5\n", result\exit_code)
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != 12
        c.printf("t2-cwd_offset: got %zu want 12\n", result\cwd_offset)
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != 2
        c.printf("t2-cwd_length: got %zu want 2\n", result\cwd_length)
        failures: failures + 1
    
    # Test 3: -5 exit - 14 bytes, offset=12, cwd_len=2
    result\exit_code: 0
    result\cwd_offset: 0
    result\cwd_length: 0
    const: @(char p3) "MARKER_1\t-5\t/x"
    rc: mixa_process_marker_parse(marker, 8, p3, 14, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        c.printf("t3-rc: got %d want %d\n", rc, MIXA_PROCESS_MARKER_OK)
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != -5
        c.printf("t3-exit_code: got %d want -5\n", result\exit_code)
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != 12
        c.printf("t3-cwd_offset: got %zu want 12\n", result\cwd_offset)
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != 2
        c.printf("t3-cwd_length: got %zu want 2\n", result\cwd_length)
        failures: failures + 1
    
    # Test 4: INT32_MAX (2147483647) - 22 bytes, offset=20, cwd_len=2
    result\exit_code: 0
    result\cwd_offset: 0
    result\cwd_length: 0
    const: @(char p4) "MARKER_1\t2147483647\t/x"
    rc: mixa_process_marker_parse(marker, 8, p4, 22, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != 2147483647
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != 20
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != 2
        failures: failures + 1
    
    # Test 5: INT32_MIN (-2147483648) - 23 bytes, offset=21, cwd_len=2
    result\exit_code: 0
    result\cwd_offset: 0
    result\cwd_length: 0
    const: @(char p5) "MARKER_1\t-2147483648\t/x"
    rc: mixa_process_marker_parse(marker, 8, p5, 23, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != -2147483648
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != 21
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != 2
        failures: failures + 1
    
    # Test 6: overflow 2147483648 - independent sentinels
    result\exit_code: -999
    result\cwd_offset: 123
    result\cwd_length: 456
    initial\exit_code: -999
    initial\cwd_offset: 123
    initial\cwd_length: 456
    const: @(char p6) "MARKER_1\t2147483648\t/x"
    rc: mixa_process_marker_parse(marker, 8, p6, 22, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_MALFORMED
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != initial\exit_code
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != initial\cwd_offset
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != initial\cwd_length
        failures: failures + 1
    
    # Test 7: underflow -2147483649 - independent sentinels
    result\exit_code: -999
    result\cwd_offset: 123
    result\cwd_length: 456
    initial\exit_code: -999
    initial\cwd_offset: 123
    initial\cwd_length: 456
    const: @(char p7) "MARKER_1\t-2147483649\t/x"
    rc: mixa_process_marker_parse(marker, 8, p7, 23, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_MALFORMED
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != initial\exit_code
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != initial\cwd_offset
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != initial\cwd_length
        failures: failures + 1
    
    # Test 8: empty exit (malformed) - independent sentinels
    result\exit_code: -999
    result\cwd_offset: 123
    result\cwd_length: 456
    initial\exit_code: -999
    initial\cwd_offset: 123
    initial\cwd_length: 456
    const: @(char p8) "MARKER_1\t\t/x"
    rc: mixa_process_marker_parse(marker, 8, p8, 12, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_MALFORMED
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != initial\exit_code
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != initial\cwd_offset
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != initial\cwd_length
        failures: failures + 1
    
    # Report actual counters
    if: failures = 0
        c.printf("%d cases %d checks %d failures\n", 8, checks, failures)
        return: 0
    else:
        c.printf("FAILED: %d failures out of %d checks\n", failures, checks)
        return: 1
