predef: "mixa_manager/mixa_process_marker.h.lm1"
include: "<ctype.h>"

# Parse in-band process marker: expected_marker TAB exit_code TAB cwd
# Returns OK, NO_MATCH, or MALFORMED; leaves result unchanged on error

fn: parse_int32 (const: @(char buf); size_t: len; @: i32 out) int
    # Parse signed decimal int32 from buf (up to len bytes)
    # Returns: 0 on success, 1 on malformed (invalid digit, sign-only, overflow)
    # Caller guarantees buf is non-NULL
    
    if: len = 0
        return: 1
    
    i32: value
    i32: sign
    i32: digit
    size_t: pos
    
    value: 0
    sign: 1
    pos: 0
    
    # Optional +/- sign
    if: buf[0] = '+'
        pos: pos + 1
    else: if: buf[0] = '-'
        sign: -1
        pos: pos + 1
    
    # Must have at least one digit
    if: pos = len
        return: 1
    
    # Parse digits with overflow check
    while: pos < len
        if: (cast: (i32 buf[pos])) < (cast: (i32 '0')) | (cast: (i32 buf[pos])) > (cast: (i32 '9'))
            return: 1
        
        digit: (cast: (i32 buf[pos])) - (cast: (i32 '0'))
        
        # Check overflow: |value| > 214748364 or (|value|==214748364 and digit>7)
        # INT32_MAX = 2147483647, INT32_MIN = -2147483648
        if: value > 214748364
            return: 1
        if: value = 214748364
            if: digit > 7
                return: 1
            if: sign < 0
                if: digit > 8
                    return: 1
        
        value: value * 10 + digit
        pos: pos + 1
    
    out[0]: value * sign
    return: 0

fn: mixa_process_marker_parse (const: @(char expected_marker); size_t: marker_len; const: @(char payload); size_t: payload_len; @: MixaProcessMarkerResult result) int
    # Parse process marker payload
    # Format: expected_marker TAB exit_code TAB cwd
    
    # Input validation
    if: expected_marker = 0
        return: MIXA_PROCESS_MARKER_MALFORMED
    if: marker_len = 0
        return: MIXA_PROCESS_MARKER_MALFORMED
    if: payload = 0
        if: payload_len > 0
            return: MIXA_PROCESS_MARKER_MALFORMED
        return: MIXA_PROCESS_MARKER_NO_MATCH
    
     size_t: i
     i32: exit_code
     int: rc
    
    # Check for embedded NUL in payload
    i: 0
    while: i < payload_len
        if: payload[i] = 0
            return: MIXA_PROCESS_MARKER_MALFORMED
        i: i + 1
    
    # Check expected marker at start
    if: payload_len < marker_len
        return: MIXA_PROCESS_MARKER_NO_MATCH
    
    i: 0
    while: i < marker_len
        if: payload[i] != expected_marker[i]
            return: MIXA_PROCESS_MARKER_NO_MATCH
        i: i + 1
    
    # Expect TAB after marker
    if: payload_len <= marker_len
        return: MIXA_PROCESS_MARKER_MALFORMED
    if: payload[marker_len] != 9  # TAB is ASCII 9
        return: MIXA_PROCESS_MARKER_MALFORMED
    
    # Find next TAB for cwd boundary
    size_t: exit_start
    size_t: exit_end
    size_t: cwd_start
    
    exit_start: marker_len + 1
    exit_end: exit_start
    while: exit_end < payload_len
        if: payload[exit_end] = 9
            break
        exit_end: exit_end + 1
    
    # exit_end now at TAB or end of payload
    if: exit_end >= payload_len
        return: MIXA_PROCESS_MARKER_MALFORMED
    if: exit_end = exit_start
        return: MIXA_PROCESS_MARKER_MALFORMED  # Empty exit code
    
    # Parse exit code
    rc: parse_int32((cast: (const: @(char) (payload + exit_start))), exit_end - exit_start, @ exit_code)
    if: rc != 0
        return: MIXA_PROCESS_MARKER_MALFORMED
    
    # cwd starts after second TAB
    cwd_start: exit_end + 1
    if: cwd_start >= payload_len
        return: MIXA_PROCESS_MARKER_MALFORMED  # Empty cwd
    
    # Store result
    result\exit_code: exit_code
    result\cwd_offset: cwd_start
    result\cwd_length: payload_len - cwd_start
    
    return: MIXA_PROCESS_MARKER_OK
