predef: "mixa_manager/mixa_process_marker.h.lm1"
predef: "mixa_manager/mixa_process_marker.lm1"
include: "<stdio.h>"

fn: test_valid (const: @(char marker); int: exit_val; const: @(char exit_str); @: MixaProcessMarkerResult result; @: int failures; @: int checks) int
    int: rc
    size_t: plen
    size_t: elen
    const: @(char payload) "MARKER_1\t"
    
    # For each exit value, construct payload and check results
    # Payload format: "MARKER_1\t{exit_str}\t/x" (12 + exit_str_len bytes)
    c.printf("test case: exit=%s\n", exit_str)
    return: 0

fn: main () int
    MixaProcessMarkerResult: result_storage
    @: MixaProcessMarkerResult result
    MixaProcessMarkerResult: initial_storage
    @: MixaProcessMarkerResult initial
    int: rc
    int: failures
    int: checks
    int: i
    
    result: @ result_storage
    initial: @ initial_storage
    failures: 0
    checks: 0
    
    const: @(char marker) "MARKER_1"
    
    # Test 1: zero exit ("MARKER_1\t0\t/x" = 12 bytes, offset=10, length=2)
    result\exit_code: 0
    result\cwd_offset: 0
    result\cwd_length: 0
    const: @(char p1) "MARKER_1\t0\t/x"
    rc: mixa_process_marker_parse(marker, 8, p1, 12, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != 0
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != 10
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != 2
        failures: failures + 1
    
    # Test 2: +5 (+5 = 2 chars, offset=10+1+1=12-1=11)
    result\exit_code: 0
    const: @(char p2) "MARKER_1\t+5\t/x"
    rc: mixa_process_marker_parse(marker, 8, p2, 13, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != 5
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != 11
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != 2
        failures: failures + 1
    
    # Test 3: -5
    result\exit_code: 0
    const: @(char p3) "MARKER_1\t-5\t/x"
    rc: mixa_process_marker_parse(marker, 8, p3, 13, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != -5
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != 11
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != 2
        failures: failures + 1
    
    # Test 4: INT32_MAX (2147483647 = 10 chars)
    result\exit_code: 0
    const: @(char p4) "MARKER_1\t2147483647\t/x"
    rc: mixa_process_marker_parse(marker, 8, p4, 22, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != 2147483647
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != 20
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != 2
        failures: failures + 1
    
    # Test 5: INT32_MIN (-2147483648 = 11 chars)
    result\exit_code: 0
    const: @(char p5) "MARKER_1\t-2147483648\t/x"
    rc: mixa_process_marker_parse(marker, 8, p5, 23, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_OK
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != -2147483648
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != 21
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != 2
        failures: failures + 1
    
    # Test 6: overflow 2147483648
    result\exit_code: -999
    initial\exit_code: -999
    initial\cwd_offset: 123
    initial\cwd_length: 456
    result\cwd_offset: 123
    result\cwd_length: 456
    const: @(char p6) "MARKER_1\t2147483648\t/x"
    rc: mixa_process_marker_parse(marker, 8, p6, 22, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_MALFORMED
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != initial\exit_code
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != initial\cwd_offset
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != initial\cwd_length
        failures: failures + 1
    
    # Test 7: underflow -2147483649
    result\exit_code: -999
    initial\exit_code: -999
    const: @(char p7) "MARKER_1\t-2147483649\t/x"
    rc: mixa_process_marker_parse(marker, 8, p7, 23, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_MALFORMED
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != initial\exit_code
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != initial\cwd_offset
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != initial\cwd_length
        failures: failures + 1
    
    # Test 8: empty exit (malformed)
    result\exit_code: -999
    initial\exit_code: -999
    const: @(char p8) "MARKER_1\t\t/x"
    rc: mixa_process_marker_parse(marker, 8, p8, 12, result)
    checks: checks + 1
    if: rc != MIXA_PROCESS_MARKER_MALFORMED
        failures: failures + 1
    checks: checks + 1
    if: result\exit_code != initial\exit_code
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_offset != initial\cwd_offset
        failures: failures + 1
    checks: checks + 1
    if: result\cwd_length != initial\cwd_length
        failures: failures + 1
    
    # Report actual counters
    if: failures = 0
        c.printf("%d cases %d checks %d failures\n", 8, checks, failures)
        return: 0
    else:
        c.printf("FAILED: %d failures out of %d checks\n", failures, checks)
        return: 1
