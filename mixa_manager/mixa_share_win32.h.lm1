# Windows concrete unit for the file-share seam. Portable header predefs this
# one (mirrors mixa_audio_win32.h.lm1's relationship to mixa_audio.h.lm1):
# MixaShareRequest itself only ever touches this backend through the opaque
# `impl: @: void` field, so nothing here is part of the portable ABI.
#
# RESOLUTION of the portable->concrete include-leak (raised in ticket
# 20260911-221400 review): every field here is kept opaque (`@: void`),
# never a real WinRT/COM type name. That means THIS header never needs
# `include: "<windows.h>"` or any WinRT header at all -- not now, not once
# the adapter is implemented. The real COM/WinRT types and includes live
# only in mixa_share_win32.lm1 (the implementation, which casts these
# opaque fields to their real pointer types internally), which nothing
# except the final application predefs. That is a stronger fix than
# "don't include it yet" -- it structurally cannot leak, regardless of
# what the implementation later needs. mixa_audio_win32.h.lm1's own
# `@: wchar_t wpath` field is why ITS header needs windows.h/wchar.h; if
# it used an opaque `@: void` there too, it could drop that include the
# same way. Not fixed here (out of this ticket's scope), but the same
# pattern would apply.
#
# Field meaning (all opaque, cast to the real type only inside the .lm1):
#   hwnd     - HWND owning the share request (real window handle)
#   req      - back-pointer to the owning MixaShareRequest, so our
#              DataRequested handler's Invoke() can read its text/title
#              (the request outlives the async Invoke call by contract:
#              mixa_share_destroy() unregisters the handler before this
#              ctx is freed, see mixa_share_win32_destroy)
#   mgr      - IDataTransferManager* (obtained via GetForWindow), an OWNED
#              reference held for the lifetime of the request (needed again
#              by remove_DataRequested on cleanup/cancel) and Released
#              exactly once in mixa_share_win32_destroy
#   handler  - our own DataRequested callback object (see mixa_share_win32.lm1
#              for its vtable); embeds a back-pointer to this ctx
#   token    - malloc'd 8-byte buffer holding the opaque
#              EventRegistrationToken from add_DataRequested, needed
#              unchanged by remove_DataRequested on cleanup/cancel
#   invoke_status - set by the DataRequested handler's Invoke() on the SDK
#              call that actually failed (get_Request/get_Data/SetText/
#              get_Properties/put_Title); MIXA_SHARE_OK until then. poll()
#              reports this as the terminal status instead of always
#              claiming success once pending clears -- a callback firing is
#              not proof the data was actually populated.
#   owner_tid - the OS thread ID (GetCurrentThreadId()) that called begin(),
#              i.e. the STA thread that owns this request and its live COM
#              references. poll/cancel/destroy check the calling thread
#              against this before touching any real WinRT object -- our
#              own plain C functions are not COM interface calls, so
#              nothing marshals a wrong-thread call onto the right
#              apartment for us the way a real COM proxy would. Stored as
#              `ulong` (DWORD's actual underlying type on this platform),
#              not `DWORD`, so this stays a portable/leak-free opaque-
#              shaped header field per this file's own predef-leak
#              resolution above.

struct: MixaShareWin32Ctx
    @: void hwnd
    @: void req
    @: void mgr
    @: void handler
    @: void token
    int: registered
    int: pending
    int: invoke_status
    ulong: owner_tid
end: MixaShareWin32Ctx

# Our own DataRequested handler: a plain-C COM object whose first field is
# a pointer to OUR OWN populated vtable, matching the "first field is a
# vtable pointer" shape every WinRT/COM interface already has. WinRT calls
# through this vtable using only the pointer's memory layout and calling
# convention -- it never inspects the C-source-level struct/type name, so
# our own short-named struct here (matching field order/count/signatures
# exactly: QueryInterface, AddRef, Release, Invoke) is ABI-compatible with
# the SDK's giant-named __FITypedEventHandler_2_...Vtbl without ever
# spelling that name for this struct. The one place that DOES need the
# exact SDK type is casting a handler pointer when passing it to
# add_DataRequested, in mixa_share_win32.lm1. lpVtbl is typed as our own
# MixaShareHandlerVtbl* (not opaque @: void) so the .lm1 can populate its
# fields directly (`vtbl\QueryInterface: fn`) without the cast-then-
# assign-through-cast pattern that l1trans does not translate correctly
# (see mixa_share.txt's L1 findings) -- neither type here is a Windows/COM
# declaration, so this does not reintroduce the portable-header leak.
fnptr: MixaShareHandlerQIFn (@: void this_raw; @: void riid; @@: void ppv) long
fnptr: MixaShareHandlerAddRefFn (@: void this_raw) ulong
fnptr: MixaShareHandlerReleaseFn (@: void this_raw) ulong
fnptr: MixaShareHandlerInvokeFn (@: void this_raw; @: void sender; @: void args) long

struct: MixaShareHandlerVtbl
    MixaShareHandlerQIFn: QueryInterface
    MixaShareHandlerAddRefFn: AddRef
    MixaShareHandlerReleaseFn: Release
    MixaShareHandlerInvokeFn: Invoke
end: MixaShareHandlerVtbl

# refcount is a plain int, not an interlocked/atomic counter: this handler
# is only ever touched under RO_INIT_SINGLETHREADED (STA). Every call into
# it (QueryInterface/AddRef/Release/Invoke) is marshaled by COM onto the
# apartment's own thread -- the same thread that creates and owns it --
# so there is no concurrent access to serialize against. Adding atomics
# here would be exactly the "application-private ... atomic workaround"
# the ticket's own constraints rule out, for a race that the apartment
# model already prevents by construction.
struct: MixaShareHandlerObj
    @: MixaShareHandlerVtbl lpVtbl
    int: refcount
    @: void owner_ctx
end: MixaShareHandlerObj
