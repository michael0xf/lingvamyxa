# Windows concrete unit for the file-share seam. Portable header predefs this
# one (mirrors mixa_audio_win32.h.lm1's relationship to mixa_audio.h.lm1):
# MixaShareRequest itself only ever touches this backend through the opaque
# `impl: @: void` field, so nothing here is part of the portable ABI.
#
# Deliberately no `include: "<windows.h>"` (or any WinRT/COM header) here:
# nothing in this stub needs a real Windows type yet (hwnd is opaque @: void,
# not HWND), and predef'ing this header from the portable contract means any
# include here would leak Windows declarations into every file that only
# wants the portable seam. Add the real includes here, not to mixa_share.h.lm1,
# when the Windows-adapter stage populates this struct with actual COM/WinRT
# state (IDataTransferManagerInterop / DataTransferManager /
# ShowShareUIForWindow; see mixa_share.txt for the route and any
# L1-expressibility findings from that stage).

struct: MixaShareWin32Ctx
    @: void hwnd
    int: registered
    int: pending
end: MixaShareWin32Ctx
