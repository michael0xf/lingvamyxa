predef: "mixa_manager/mixa_process_marker.h.lm1"
include: "<stdlib.h>" "<string.h>" "<stdio.h>"
include: "<windows.h>"

# See this header's own comment for the design (identity generation,
# shell wrapper, incremental streaming parser). PROCESS_SEAM 4.1's own
# marker line stays a pure, owner-local module: no Message/thread/mutex/
# queue integration lives here.

fn: mixa_process_marker_generate (@: MixaProcessMarkerGen gen; @@: char out_marker) int
    @: LARGE_INTEGER pc
    unsigned: c1
    @: char s
    size_t: need
    if: gen = 0 || out_marker = 0
        return: MIXA_PROCESS_MARKER_ERR_ARG
    out_marker[0]: 0
    pc: (cast: (@: LARGE_INTEGER) c.calloc(1U, c.sizeof(c.LARGE_INTEGER)))
    if: pc = 0
        return: MIXA_PROCESS_MARKER_ERR_NOMEM
    c.QueryPerformanceCounter(pc)
    c1: gen\counter
    gen\counter: gen\counter + 1U
    # "MIXA_MARK_" + counter(hex, up to 8) + "_" + HighPart(hex,8) +
    # LowPart(hex,8) + NUL -- a small fixed-shape encoding of two
    # unsigned values, never a caller-controlled length, so a generous
    # fixed probe size for snprintf's own needed-length report is safe
    # here (unlike command/output/path text, which are never bounded).
    need: (cast: (size_t) c.snprintf(0, 0U, "MIXA_MARK_%08x_%08lx%08lx", c1, pc\HighPart, pc\LowPart)) + 1U
    s: (cast: (@: char) c.malloc(need))
    if: s = 0
        c.free(pc)
        return: MIXA_PROCESS_MARKER_ERR_NOMEM
    c.snprintf(s, need, "MIXA_MARK_%08x_%08lx%08lx", c1, pc\HighPart, pc\LowPart)
    c.free(pc)
    out_marker[0]: s
return: MIXA_PROCESS_MARKER_OK

# NOT a one-liner delayed-expansion trick (measured, not assumed: a
# direct probe of `cmd /c "cmd /c exit /b 5 & echo %errorlevel%"` prints
# the STALE pre-command value, confirmed live before choosing this
# design -- cmd.exe substitutes %VAR% at PARSE TIME of the whole `/c`
# line, before any part of it runs; `setlocal enabledelayedexpansion`
# issued LATER on that SAME line does not retroactively fix the earlier
# tokenization either, also confirmed live: `!errorlevel!` came back
# through completely literal). The only mechanism the same probing
# confirmed WORKING is a real batch FILE, where cmd.exe parses and
# executes one line at a time, so %errorlevel% after the user's own
# command line is genuinely the value from that line, no delayed
# expansion or nested shell quoting needed at all -- and nested `cmd /c
# "..."` quoting was independently confirmed fragile/broken too. A
# unique temp .bat is written (GetTempFileNameW -- collision-proof by
# construction, not a guessed name) with a UTF-8 BOM so a non-ASCII user
# command is read correctly by modern cmd.exe; its own last line deletes
# itself, so nothing is left behind once the child has read it (it only
# needs to be read once, at cmd.exe's own startup, well before that
# delete line runs).
fn: mixa_process_marker_build_wrapper (const: @(char user_command_utf8); const: @(char marker_utf8); @@: char out_wrapper) int
    size_t: ulen
    size_t: mlen
    []: wchar_t tmp_dir 1024
    []: wchar_t tmp_path 1024
    []: wchar_t prefix 4
    @: void h
    @: char body
    size_t: body_total
    []: unsigned long wrote_slot 1
    @: char tmp_path_utf8
    int: n8
    @: char s
    if: user_command_utf8 = 0 || marker_utf8 = 0 || out_wrapper = 0
        return: MIXA_PROCESS_MARKER_ERR_ARG
    out_wrapper[0]: 0
    ulen: c.strlen(user_command_utf8)
    mlen: c.strlen(marker_utf8)
    if: ulen = 0U || mlen = 0U
        return: MIXA_PROCESS_MARKER_ERR_ARG
    ---
    if: c.GetTempPathW(1024U, tmp_dir) = 0U
        return: MIXA_PROCESS_MARKER_ERR_ARG
    ---
    prefix[0]: (cast: (wchar_t) 109)
    prefix[1]: (cast: (wchar_t) 109)
    prefix[2]: (cast: (wchar_t) 107)
    prefix[3]: (cast: (wchar_t) 0)
    if: c.GetTempFileNameW(tmp_dir, prefix, 0U, tmp_path) = 0U
        return: MIXA_PROCESS_MARKER_ERR_ARG
    ---
    # GetTempFileNameW always creates a real, uniquely-named ".tmp" file
    # (that's what makes the name collision-proof) -- but cmd.exe only
    # recognizes .bat/.cmd (via its own extension association) as a
    # script to RUN when given a bare path, never .tmp. Confirmed live:
    # `cmd /c "<...>.tmp"` did not execute the batch content at all. So
    # the reserved name is reused with its own last 4 characters
    # (".tmp") overwritten to ".bat" in place -- same unique base name,
    # a real extension cmd.exe knows how to run -- and the original
    # empty .tmp reservation is deleted since nothing further is written
    # there.
    if: 1
        size_t: wlen
        []: wchar_t orig_path 1024
        wlen: c.wcslen(tmp_path)
        if: wlen < 4U || wlen >= 1024U
            return: MIXA_PROCESS_MARKER_ERR_ARG
        ---
        c.wcscpy(orig_path, tmp_path)
        tmp_path[wlen - 4U]: (cast: (wchar_t) 46)
        tmp_path[wlen - 3U]: (cast: (wchar_t) 98)
        tmp_path[wlen - 2U]: (cast: (wchar_t) 97)
        tmp_path[wlen - 1U]: (cast: (wchar_t) 116)
        c.DeleteFileW(orig_path)
    ---
    # Body: UTF-8 BOM, the user's own command line verbatim, one line
    # printing "<marker><TAB><exit code><TAB><final cwd>", then a
    # self-delete. Sized from the caller's own command length via
    # checked arithmetic (no fixed command cap); the BOM/echo/del
    # scaffolding is a small fixed-shape addition, not user-controlled.
    if: ulen > ((cast: (size_t) -1) - mlen - 128U)
        return: MIXA_PROCESS_MARKER_ERR_ARG
    ---
    body_total: ulen + mlen + 128U
    body: (cast: (@: char) c.malloc(body_total))
    if: body = 0
        return: MIXA_PROCESS_MARKER_ERR_NOMEM
    body[0]: (cast: (char) 0xEF)
    body[1]: (cast: (char) 0xBB)
    body[2]: (cast: (char) 0xBF)
    n8: c.snprintf(body + 3, body_total - 3U, "@echo off\r\n%s\r\necho %s\t%%errorlevel%%\t%%cd%%\r\ndel \"%%~f0\" >nul 2>&1\r\n", user_command_utf8, marker_utf8)
    if: n8 < 0
        c.free(body)
        return: MIXA_PROCESS_MARKER_ERR_ARG
    ---
    h: c.CreateFileW(tmp_path, 1073741824U, 0U, 0, 2U, 128U, 0)
    if: h = (cast: (@: void) (cast: (size_t) -1))
        c.free(body)
        return: MIXA_PROCESS_MARKER_ERR_ARG
    ---
    wrote_slot[0]: 0U
    c.WriteFile(h, body, (cast: (unsigned long) (3U + (cast: (size_t) n8))), wrote_slot, 0)
    c.CloseHandle(h)
    c.free(body)

    # Wrapper command spawn() will run: the temp .bat path, quoted (temp
    # paths may contain spaces).
    n8: c.WideCharToMultiByte(65001, 0U, tmp_path, -1, 0, 0, 0, 0)
    if: n8 <= 0
        return: MIXA_PROCESS_MARKER_ERR_ARG
    ---
    tmp_path_utf8: (cast: (@: char) c.calloc((cast: (size_t) n8), 1U))
    if: tmp_path_utf8 = 0
        return: MIXA_PROCESS_MARKER_ERR_NOMEM
    ---
    c.WideCharToMultiByte(65001, 0U, tmp_path, -1, tmp_path_utf8, n8, 0, 0)
    s: (cast: (@: char) c.malloc((cast: (size_t) n8) + 2U))
    if: s = 0
        c.free(tmp_path_utf8)
        return: MIXA_PROCESS_MARKER_ERR_NOMEM
    ---
    c.snprintf(s, (cast: (size_t) n8) + 2U, "\"%s\"", tmp_path_utf8)
    c.free(tmp_path_utf8)
    out_wrapper[0]: s
return: MIXA_PROCESS_MARKER_OK

# ---- growable byte buffer, checked doubling (mixa_selection.lm1's own
# established pattern: "Overflow guards: addition, doubling, sizeof
# product"). ptr_sz is always 1 here (bytes), kept explicit for clarity.
fn: mixa_marker_buf_ensure (@@: char buf; @: size_t cap; size_t: need) int
    @: char fresh
    size_t: new_cap
    if: need <= cap[0]
        return: MIXA_PROCESS_MARKER_OK
    ---
    new_cap: cap[0]
    if: new_cap = 0U
        new_cap: 64U
    ---
    while: new_cap < need
        if: new_cap > ((cast: (size_t) -1) / 2U)
            return: MIXA_PROCESS_MARKER_ERR_NOMEM
        ---
        new_cap: new_cap * 2U
    ---
    fresh: (cast: (@: char) c.realloc(buf[0], new_cap))
    if: fresh = 0
        return: MIXA_PROCESS_MARKER_ERR_NOMEM
    buf[0]: fresh
    cap[0]: new_cap
return: MIXA_PROCESS_MARKER_OK

fn: mixa_process_marker_scanner_open (@: MixaProcessMarkerScanner sc; const: @(char expected_marker); size_t: marker_len) int
    if: sc = 0 || expected_marker = 0 || marker_len = 0U
        return: MIXA_PROCESS_MARKER_ERR_ARG
    sc\marker: (cast: (@: char) c.malloc(marker_len))
    if: sc\marker = 0
        return: MIXA_PROCESS_MARKER_ERR_NOMEM
    c.memcpy(sc\marker, expected_marker, marker_len)
    sc\marker_len: marker_len
    sc\state: MIXA_MARKER_STATE_SCAN
    sc\pending: 0
    sc\pending_len: 0U
    sc\pending_cap: 0U
    sc\status_start: 0U
    sc\tab2_pos: 0U
    sc\exit_code: 0
    sc\cwd: 0
    sc\cwd_len: 0U
return: MIXA_PROCESS_MARKER_OK

fn: mixa_process_marker_scanner_done (const: @(MixaProcessMarkerScanner sc)) int
    if: sc = 0
        return: 0
    if: sc\state = MIXA_MARKER_STATE_DONE
        return: 1
return: 0

sub: mixa_marker_emit (const: @(MixaProcessMarkerSink sink); const: @(char bytes); size_t: len)
    if: len = 0U
        return
    ---
    if: sink = 0
        return
    ---
    if: sink\on_ordinary = 0
        return
    ---
    sink\on_ordinary(sink\ctx, bytes, len)
end: mixa_marker_emit

# Flushes the WHOLE pending buffer as ordinary output and resets the
# scanner back to a fresh SCAN state -- used both for a disproven
# tentative match (item 4: "not silently consumed") and for EOF with no
# complete record (item 5: "flushes every buffered byte").
sub: mixa_marker_flush_pending (@: MixaProcessMarkerScanner sc; const: @(MixaProcessMarkerSink sink))
    mixa_marker_emit(sink, sc\pending, sc\pending_len)
    sc\pending_len: 0U
    sc\state: MIXA_MARKER_STATE_SCAN
end: mixa_marker_flush_pending

# Parses a decimal (optionally '-'-signed) i32 from digits[0..len).
# Checked per-digit against the i32 bounds, matching the accumulation
# style already used elsewhere in this codebase's own numeric parsers.
fn: mixa_marker_parse_i32 (const: @(char digits); size_t: len; @: int out) int
    size_t: pos
    size_t: magnitude
    int: sign
    int: digit
    if: len = 0U
        return: 1
    pos: 0U
    sign: 1
    if: digits[0] = (cast: (char) 45)
        sign: -1
        pos: 1U
    ---
    if: pos >= len
        return: 1
    ---
    magnitude: 0U
    while: pos < len
        if: (cast: (int) digits[pos]) < 48 || (cast: (int) digits[pos]) > 57
            return: 1
        ---
        digit: (cast: (int) digits[pos]) - 48
        if: magnitude > 214748364U
            return: 1
        ---
        if: magnitude = 214748364U
            if: sign > 0 && digit > 7
                return: 1
            ---
            if: sign < 0 && digit > 8
                return: 1
            ---
        ---
        magnitude: magnitude * 10U + (cast: (size_t) digit)
        pos: pos + 1U
    ---
    if: sign < 0
        out[0]: (cast: (int) (0U - magnitude))
    else:
        out[0]: (cast: (int) magnitude)
    ---
return: 0

fn: mixa_process_marker_scanner_feed (@: MixaProcessMarkerScanner sc; const: @(MixaProcessMarkerSink sink); const: @(char bytes); size_t: len) int
    size_t: i
    unsigned: b
    size_t: start
    size_t: try_len
    int: is_prefix
    size_t: k
    int: rc
    if: sc = 0 || bytes = 0
        return: MIXA_PROCESS_MARKER_ERR_ARG
    if: sc\state = MIXA_MARKER_STATE_DONE
        return: MIXA_PROCESS_MARKER_OK
    ---
    i: 0U
    while: i < len
        b: (cast: (unsigned) ((cast: (int) bytes[i]) & 255))

        if: sc\state = MIXA_MARKER_STATE_SCAN
            if: sc\pending_len = 0U && (cast: (int) b) != (cast: (int) sc\marker[0])
                mixa_marker_emit(sink, (cast: (const: @(char)) (@ b)), 1U)
            else:
                rc: mixa_marker_buf_ensure(@ sc\pending, @ sc\pending_cap, sc\pending_len + 1U)
                if: rc != MIXA_PROCESS_MARKER_OK
                    mixa_marker_flush_pending(sc, sink)
                    return: rc
                ---
                sc\pending[sc\pending_len]: (cast: (char) b)
                sc\pending_len: sc\pending_len + 1U
                # Is pending a valid prefix (or full match) of marker?
                is_prefix: 1
                if: sc\pending_len > sc\marker_len
                    is_prefix: 0
                else:
                    k: 0U
                    while: k < sc\pending_len
                        if: sc\pending[k] != sc\marker[k]
                            is_prefix: 0
                        ---
                        k: k + 1U
                    ---
                ---
                if: is_prefix != 0 && sc\pending_len = sc\marker_len
                    sc\status_start: sc\pending_len
                    sc\state: MIXA_MARKER_STATE_STATUS_SEP
                else:
                    if: is_prefix = 0
                        # Restart: find the smallest start>=1 such that
                        # pending[start:] is itself a valid marker
                        # prefix (possibly empty at start=pending_len).
                        start: sc\pending_len
                        k: 1U
                        while: k < sc\pending_len
                            try_len: sc\pending_len - k
                            is_prefix: 1
                            if: try_len > sc\marker_len
                                is_prefix: 0
                            else:
                                []: size_t j 1
                                j[0]: 0U
                                while: j[0] < try_len
                                    if: sc\pending[k + j[0]] != sc\marker[j[0]]
                                        is_prefix: 0
                                    ---
                                    j[0]: j[0] + 1U
                                ---
                            ---
                            if: is_prefix != 0
                                start: k
                                k: sc\pending_len
                            ---
                            k: k + 1U
                        ---
                        mixa_marker_emit(sink, sc\pending, start)
                        if: start < sc\pending_len
                            c.memmove(sc\pending, sc\pending + start, sc\pending_len - start)
                        ---
                        sc\pending_len: sc\pending_len - start
                    ---
                ---
            ---
        else:
            if: sc\state = MIXA_MARKER_STATE_STATUS_SEP
                # The FIRST byte after a full marker match must be the
                # marker/status separator TAB itself -- a genuinely
                # SEPARATE one-shot state, not merely "pending_len ==
                # status_start" checked inline within STATUS, since that
                # numeric coincidence recurs again once the digit field
                # itself happens to be empty so far, wrongly re-entering
                # this branch (caught live: every real record was
                # rejected as malformed on its very first digit byte,
                # because the marker's own trailing tab was being
                # mistaken for the STATUS/CWD terminator with zero
                # digits collected in between).
                if: b != 9U
                    mixa_marker_flush_pending(sc, sink)
                    mixa_marker_emit(sink, (cast: (const: @(char)) (@ b)), 1U)
                else:
                    rc: mixa_marker_buf_ensure(@ sc\pending, @ sc\pending_cap, sc\pending_len + 1U)
                    if: rc != MIXA_PROCESS_MARKER_OK
                        mixa_marker_flush_pending(sc, sink)
                        return: rc
                    ---
                    sc\pending[sc\pending_len]: (cast: (char) b)
                    sc\pending_len: sc\pending_len + 1U
                    sc\status_start: sc\pending_len
                    sc\state: MIXA_MARKER_STATE_STATUS
                ---
            else:
             if: sc\state = MIXA_MARKER_STATE_STATUS
                if: b = 9U
                    rc: mixa_marker_buf_ensure(@ sc\pending, @ sc\pending_cap, sc\pending_len + 1U)
                    if: rc != MIXA_PROCESS_MARKER_OK
                        mixa_marker_flush_pending(sc, sink)
                        return: rc
                    ---
                    sc\pending[sc\pending_len]: (cast: (char) b)
                    sc\pending_len: sc\pending_len + 1U
                    sc\tab2_pos: sc\pending_len
                    sc\state: MIXA_MARKER_STATE_CWD
                else:
                    if: (b = 45U && sc\pending_len = sc\status_start) || ((cast: (int) b) >= 48 && (cast: (int) b) <= 57)
                        rc: mixa_marker_buf_ensure(@ sc\pending, @ sc\pending_cap, sc\pending_len + 1U)
                        if: rc != MIXA_PROCESS_MARKER_OK
                            mixa_marker_flush_pending(sc, sink)
                            return: rc
                        ---
                        sc\pending[sc\pending_len]: (cast: (char) b)
                        sc\pending_len: sc\pending_len + 1U
                    else:
                        mixa_marker_flush_pending(sc, sink)
                        mixa_marker_emit(sink, (cast: (const: @(char)) (@ b)), 1U)
                    ---
                ---
             else:
                if: sc\state = MIXA_MARKER_STATE_CWD
                    if: b = 0U
                        mixa_marker_flush_pending(sc, sink)
                        mixa_marker_emit(sink, (cast: (const: @(char)) (@ b)), 1U)
                    else:
                        if: b = 10U
                            []: int excode 1
                            size_t: cwd_start
                            size_t: cwd_end
                            excode[0]: 0
                            cwd_start: sc\tab2_pos
                            cwd_end: sc\pending_len
                            if: cwd_end > cwd_start && sc\pending[cwd_end - 1U] = (cast: (char) 13)
                                cwd_end: cwd_end - 1U
                            ---
                            if: mixa_marker_parse_i32(sc\pending + sc\status_start, sc\tab2_pos - 1U - sc\status_start, excode) != 0
                                mixa_marker_flush_pending(sc, sink)
                                mixa_marker_emit(sink, (cast: (const: @(char)) (@ b)), 1U)
                            else:
                                if: cwd_end <= cwd_start
                                    mixa_marker_flush_pending(sc, sink)
                                    mixa_marker_emit(sink, (cast: (const: @(char)) (@ b)), 1U)
                                else:
                                    sc\cwd: (cast: (@: char) c.malloc(cwd_end - cwd_start))
                                    if: sc\cwd = 0
                                        mixa_marker_flush_pending(sc, sink)
                                        return: MIXA_PROCESS_MARKER_ERR_NOMEM
                                    ---
                                    c.memcpy(sc\cwd, sc\pending + cwd_start, cwd_end - cwd_start)
                                    sc\cwd_len: cwd_end - cwd_start
                                    sc\exit_code: excode[0]
                                    sc\pending_len: 0U
                                    sc\state: MIXA_MARKER_STATE_DONE
                                ---
                            ---
                        else:
                            rc: mixa_marker_buf_ensure(@ sc\pending, @ sc\pending_cap, sc\pending_len + 1U)
                            if: rc != MIXA_PROCESS_MARKER_OK
                                mixa_marker_flush_pending(sc, sink)
                                return: rc
                            ---
                            sc\pending[sc\pending_len]: (cast: (char) b)
                            sc\pending_len: sc\pending_len + 1U
                        ---
                    ---
                ---
            ---
        ---
        if: sc\state = MIXA_MARKER_STATE_DONE
            i: len
        else:
            i: i + 1U
        ---
    ---
return: MIXA_PROCESS_MARKER_OK

fn: mixa_process_marker_scanner_eof (@: MixaProcessMarkerScanner sc; const: @(MixaProcessMarkerSink sink)) int
    if: sc = 0
        return: MIXA_PROCESS_MARKER_ERR_ARG
    if: sc\state != MIXA_MARKER_STATE_DONE
        mixa_marker_flush_pending(sc, sink)
    ---
return: MIXA_PROCESS_MARKER_OK

fn: mixa_process_marker_scanner_release (@: MixaProcessMarkerScanner sc) int
    if: sc = 0
        return: MIXA_PROCESS_MARKER_OK
    if: sc\marker != 0
        c.free(sc\marker)
        sc\marker: 0
    ---
    if: sc\pending != 0
        c.free(sc\pending)
        sc\pending: 0
    ---
    if: sc\cwd != 0
        c.free(sc\cwd)
        sc\cwd: 0
    ---
    sc\pending_cap: 0U
    sc\pending_len: 0U
    sc\marker_len: 0U
return: MIXA_PROCESS_MARKER_OK
