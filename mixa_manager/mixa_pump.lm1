
include: "mixa_manager/mixa_pump.h" "<stdlib.h>" "<string.h>"

# Pump: drain poll into an inbox FIFO, then yield via next. One turn boundary.

fn: mixa_pump_open (@: MixaPump pump) int
    if: pump = 0
        return: 1
    if: pump\is_open != 0
        return: 1
    if: mixa_event_fifo_init(@ pump\inbox) != 0
        return: 1
    pump\is_open: 1
return: 0

sub: mixa_pump_release (@: MixaPump pump)
    if: pump != 0
        mixa_event_fifo_release(@ pump\inbox)
        pump\is_open: 0
    ---
end: mixa_pump_release

fn: mixa_pump_drain (@: MixaPump pump; @: MixaBackend backend) int
    @: MixaEvent ev
    int: rc
    int: failed
    int: done
    if: pump = 0
        return: 1
    if: backend = 0
        return: 1
    if: pump\is_open = 0
        return: 1
    ev: (cast: (@: MixaEvent) c.malloc(c.sizeof(c.MixaEvent)))
    if: ev = 0
        return: 1
    failed: 0
    done: 0
    while: done = 0
        c.memset(ev, 0, c.sizeof(c.MixaEvent))
        rc: mixa_backend_poll(backend, ev)
        if: ev\kind = MIXA_EVENT_NONE
            if: rc != 0
                failed: 1
            ---
            done: 1
        else:
            # Non-NONE: push even when poll reported adoption failure.
            if: mixa_event_fifo_push(@ pump\inbox, ev) != 0
                c.free(ev)
                return: 1
            ---
            if: rc != 0
                failed: 1
            ---
        ---
    ---
    c.free(ev)
    if: failed != 0
        return: 1
return: 0

fn: mixa_pump_next (@: MixaPump pump; @: MixaEvent out) int
    if: pump = 0
        return: 1
    if: out = 0
        return: 1
    if: pump\is_open = 0
        return: 1
    if: mixa_event_fifo_pop(@ pump\inbox, out) != 0
        return: 1
return: 0

fn: mixa_pump_pending (const: @(MixaPump pump)) size_t
    if: pump = 0
        return: 0U
    if: pump\is_open = 0
        return: 0U
return: mixa_event_fifo_count(@ pump\inbox)
