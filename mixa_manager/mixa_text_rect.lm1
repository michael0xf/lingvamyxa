include: "mixa_manager/mixa_core.h" "<stdlib.h>"

# TextRect allocate / address / fill / put / dump. Milestone 1 core over the
# contiguous row-major cell block described in mixa_manager/README.txt.

fn: mixa_rect_open (@: MixaTextRect rect; size_t: rows; size_t: cols) int
    size_t: n
    @: MixaCell block
    if: rect = 0
        return: 1
    if: rows = 0U
        return: 1
    if: cols = 0U
        return: 1
    if: rect\cells != 0
        return: 1
    if: rows > ((cast: (size_t) -1) / cols)
        return: 1
    n: rows * cols
    block: (cast: (@: MixaCell) c.calloc(n, c.sizeof(c.MixaCell)))
    if: block = 0
        return: 1
    rect\rows: rows
    rect\cols: cols
    rect\cells: block
return: 0

sub: mixa_rect_release (@: MixaTextRect rect)
    if: rect != 0
        if: rect\cells != 0
            c.free(rect\cells)
        ---
        rect\cells: 0
        rect\rows: 0U
        rect\cols: 0U
    ---
end: mixa_rect_release

fn: mixa_cell_at (@: MixaTextRect rect; size_t: row; size_t: col) @: MixaCell
    if: rect = 0
        return: 0
    if: rect\cells = 0
        return: 0
    if: row >= rect\rows
        return: 0
    if: col >= rect\cols
        return: 0
return: rect\cells + (row * rect\cols + col)

# Const reader: same bounds checks, for callers that only read. Keeps
# mixa_cell_at mutable for writers so const need not be cast away to peek.
fn: mixa_cell_at_const (const: @(MixaTextRect rect); size_t: row; size_t: col) const: @(MixaCell)
    if: rect = 0
        return: 0
    if: rect\cells = 0
        return: 0
    if: row >= rect\rows
        return: 0
    if: col >= rect\cols
        return: 0
return: rect\cells + (row * rect\cols + col)

sub: mixa_rect_fill (@: MixaTextRect rect; unsigned: codepoint; unsigned: fg; unsigned: bg; unsigned: flags)
    size_t: i
    size_t: n
    @: MixaCell p
    if: rect != 0
        if: rect\cells != 0
            n: rect\rows * rect\cols
            i: 0U
            while: i < n
                p: rect\cells + i
                p\codepoint: codepoint
                p\fg: fg
                p\bg: bg
                p\flags: flags
                p\width: 1U
                p\alpha: 255U
                i: i + 1U
            ---
        ---
    ---
end: mixa_rect_fill

fn: mixa_rect_put_text (@: MixaTextRect rect; size_t: row; size_t: col; const: @(char text); unsigned: fg; unsigned: bg; unsigned: flags) size_t
    size_t: written
    size_t: ccol
    @: MixaCell p
    const: @(char s)
    int: ch
    written: 0U
    if: rect = 0
        return: 0U
    if: text = 0
        return: 0U
    if: rect\cells = 0
        return: 0U
    if: row >= rect\rows
        return: 0U
    if: col >= rect\cols
        return: 0U
    s: text
    ccol: col
    while: s[0] != 0 && ccol < rect\cols
        ch: ((cast: (int) s[0]) & 255)
        if: ch >= 32 && ch <= 126
            p: rect\cells + (row * rect\cols + ccol)
            p\codepoint: (cast: (unsigned) ch)
            p\fg: fg
            p\bg: bg
            p\flags: flags
            p\width: 1U
            p\alpha: 255U
            written: written + 1U
        ---
        ccol: ccol + 1U
        s: s + 1
    ---
return: written

fn: mixa_rect_dump (const: @(MixaTextRect rect); @: char out; size_t: out_size) size_t
    size_t: need
    size_t: r
    size_t: ccol
    size_t: o
    const: @(MixaCell p)
    unsigned: cp
    if: rect = 0
        return: 0U
    if: out = 0
        return: 0U
    if: rect\cells = 0
        return: 0U
    need: rect\rows * (rect\cols + 1U) + 1U
    if: out_size < need
        return: 0U
    o: 0U
    r: 0U
    while: r < rect\rows
        ccol: 0U
        while: ccol < rect\cols
            p: mixa_cell_at_const(rect, r, ccol)
            cp: p\codepoint
            if: cp = 0U
                out[o]: (cast: (char) 32)
            else:
                if: cp >= 32U && cp <= 126U
                    out[o]: (cast: (char) cp)
                else:
                    out[o]: (cast: (char) 63)
                ---
            ---
            o: o + 1U
            ccol: ccol + 1U
        ---
        out[o]: (cast: (char) 10)
        o: o + 1U
        r: r + 1U
    ---
    out[o]: (cast: (char) 0)
return: o
