predef: "mixa_manager/mixa_remove_l2.h.lm1"
include: "<stdlib.h>"

fn: mixa_remove_map_dir_status (int: st) int
    if: st = MIXA_DIR_OK
        return: MIXA_REMOVE_OK
    if: st = MIXA_DIR_ERR_ARG
        return: MIXA_REMOVE_ERR_ARG
    if: st = MIXA_DIR_ERR_MISSING
        return: MIXA_REMOVE_ERR_MISSING
    if: st = MIXA_DIR_ERR_NOMEM
        return: MIXA_REMOVE_ERR_NOMEM
return: MIXA_REMOVE_ERR_IO

fn: mixa_remove_invoke (MixaRemoveNodeFn: f; @: void ctx; const: @(char path); int: is_dir; int: status) int
    if: f = 0
        if: status != MIXA_REMOVE_OK
            return: status
        ---
        return: MIXA_SEL_WALK_GO
    ---
return: f(ctx, path, is_dir, status)

# Depth-only bookkeeping -- see mixa_remove.h.lm1's own comment for why
# nothing here is a stacked/bounded resource. Always returns GO: entering
# a directory has nothing that can fail in a delete (no destination to
# create), so there is nothing for a caller's own sink to be told here.
fn: mixa_remove_on_dir_enter (@: void ctx_raw; const: @(char path); int: is_dir) int
    @: MixaRemoveState st
    st: (cast: (@: MixaRemoveState) ctx_raw)
    st\depth: st\depth + 1U
    if: st\depth = 1U
        st\root_had_failure: 0
    ---
return: MIXA_SEL_WALK_GO

fn: mixa_remove_on_file (@: void ctx_raw; const: @(char path); int: is_dir) int
    @: MixaRemoveState st
    int: del_status
    int: rc
    st: (cast: (@: MixaRemoveState) ctx_raw)
    if: st\depth = 0U
        st\root_had_failure: 0
    ---
    del_status: mixa_remove_map_dir_status(mixa_dir_remove(path))
    if: del_status != MIXA_REMOVE_OK
        st\root_had_failure: 1
    ---
    rc: mixa_remove_invoke(st\sink\on_file, st\sink\ctx, path, 0, del_status)
    # A file IS itself an effective root exactly when depth is 0 (a
    # selected single file with no parent directory of its own in this
    # walk) -- deselect it immediately on success, matching mixa_copy's
    # own on_file root-completion rule.
    if: st\depth = 0U
        if: del_status = MIXA_REMOVE_OK && st\root_had_failure = 0
            mixa_selection_deselect(st\sel, path)
        ---
    ---
return: rc

fn: mixa_remove_on_dir_done (@: void ctx_raw; const: @(char path); int: is_dir) int
    @: MixaRemoveState st
    int: del_status
    int: rc
    int: was_root
    st: (cast: (@: MixaRemoveState) ctx_raw)
    was_root: 0
    if: st\depth > 0U
        st\depth: st\depth - 1U
        if: st\depth = 0U
            was_root: 1
        ---
    ---
    # Every child of this directory is already gone or accounted for by
    # the time on_dir_done fires (mixa_selection_walk's own contract) --
    # this rmdir attempt is therefore the postorder step, not a guess.
    # Unlike mixa_copy_on_dir_done (whose own mkdir already happened at
    # dir_enter and never fails again here), this module's own real work
    # happens HERE, so del_status genuinely can be non-OK and must gate
    # the deselect exactly like on_file's own check does.
    del_status: mixa_remove_map_dir_status(mixa_dir_remove(path))
    if: del_status != MIXA_REMOVE_OK
        st\root_had_failure: 1
    ---
    rc: mixa_remove_invoke(st\sink\on_dir_done, st\sink\ctx, path, 1, del_status)
    if: was_root != 0
        if: del_status = MIXA_REMOVE_OK && st\root_had_failure = 0
            mixa_selection_deselect(st\sel, path)
        ---
    ---
return: rc

fn: mixa_remove_selected_run (@: MixaSelection sel; const: @(MixaRemoveSink sink); const: @(MixaSelWalkAllocVTable av)) int
    @: MixaRemoveState st
    @: MixaSelWalkSink wsink
    int: rc
    if: sel = 0 || sink = 0
        return: MIXA_REMOVE_ERR_ARG
    st: (cast: (@: MixaRemoveState) c.calloc(1U, c.sizeof(c.MixaRemoveState)))
    if: st = 0
        return: MIXA_REMOVE_ERR_NOMEM
    ---
    st\sink: sink
    st\sel: sel
    st\depth: 0U
    st\root_had_failure: 0
    wsink: (cast: (@: MixaSelWalkSink) c.calloc(1U, c.sizeof(c.MixaSelWalkSink)))
    if: wsink = 0
        c.free(st)
        return: MIXA_REMOVE_ERR_NOMEM
    ---
    wsink\on_dir_enter: mixa_remove_on_dir_enter
    wsink\on_file: mixa_remove_on_file
    wsink\on_dir_done: mixa_remove_on_dir_done
    wsink\ctx: (cast: (@: void) st)
    rc: mixa_selection_walk(sel, wsink, av)
    c.free(wsink)
    c.free(st)
    # OK and CANCELLED already share the same meaning and value across
    # domains; anything else is propagated exactly as returned, whether a
    # rare walk-internal failure (MIXA_SEL_WALK_ERR_*, 0-7) or one of this
    # module's own MIXA_REMOVE_ERR_* codes (>=201) from a callback -- the
    # two ranges cannot collide, so no guessing is needed here.
return: rc
