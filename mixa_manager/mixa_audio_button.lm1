predef: "mixa_manager/mixa_audio_button.h.lm1"
predef: "mixa_manager/mixa_audio.lm1"

fn: mixa_audio_action_prev_file (@: void ctx_raw) int
    @: MixaAudioButtonCtx ctx
    if: ctx_raw = 0
        return: MIXA_AUDIO_ERR_ARG
    ctx: (cast: (@: MixaAudioButtonCtx) ctx_raw)
    ctx\last_status: mixa_audio_prev_file(ctx\a)
return: ctx\last_status

fn: mixa_audio_action_prev (@: void ctx_raw) int
    @: MixaAudioButtonCtx ctx
    if: ctx_raw = 0
        return: MIXA_AUDIO_ERR_ARG
    ctx: (cast: (@: MixaAudioButtonCtx) ctx_raw)
    ctx\last_status: mixa_audio_prev(ctx\a)
return: ctx\last_status

fn: mixa_audio_action_toggle_play (@: void ctx_raw) int
    @: MixaAudioButtonCtx ctx
    if: ctx_raw = 0
        return: MIXA_AUDIO_ERR_ARG
    ctx: (cast: (@: MixaAudioButtonCtx) ctx_raw)
    if: mixa_audio_is_playing(ctx\a) != 0
        ctx\last_status: mixa_audio_stop(ctx\a)
    else:
        ctx\last_status: mixa_audio_play(ctx\a)
    ---
return: ctx\last_status

fn: mixa_audio_action_next (@: void ctx_raw) int
    @: MixaAudioButtonCtx ctx
    if: ctx_raw = 0
        return: MIXA_AUDIO_ERR_ARG
    ctx: (cast: (@: MixaAudioButtonCtx) ctx_raw)
    ctx\last_status: mixa_audio_next(ctx\a)
return: ctx\last_status

fn: mixa_audio_action_next_file (@: void ctx_raw) int
    @: MixaAudioButtonCtx ctx
    if: ctx_raw = 0
        return: MIXA_AUDIO_ERR_ARG
    ctx: (cast: (@: MixaAudioButtonCtx) ctx_raw)
    ctx\last_status: mixa_audio_next_file(ctx\a)
return: ctx\last_status

fn: mixa_audio_action_toggle_random (@: void ctx_raw) int
    @: MixaAudioButtonCtx ctx
    if: ctx_raw = 0
        return: MIXA_AUDIO_ERR_ARG
    ctx: (cast: (@: MixaAudioButtonCtx) ctx_raw)
    if: mixa_audio_is_random(ctx\a) != 0
        mixa_audio_set_random(ctx\a, 0)
    else:
        mixa_audio_set_random(ctx\a, 1)
    ---
    ctx\last_status: MIXA_AUDIO_OK
return: ctx\last_status

fn: mixa_audio_action_toggle_loop (@: void ctx_raw) int
    @: MixaAudioButtonCtx ctx
    if: ctx_raw = 0
        return: MIXA_AUDIO_ERR_ARG
    ctx: (cast: (@: MixaAudioButtonCtx) ctx_raw)
    if: mixa_audio_is_loop(ctx\a) != 0
        mixa_audio_set_loop(ctx\a, 0)
    else:
        mixa_audio_set_loop(ctx\a, 1)
    ---
    ctx\last_status: MIXA_AUDIO_OK
return: ctx\last_status
