# --- backend vtable lifecycle --------------------------------------------

fn: mixa_share_win32_unregister (@: MixaShareWin32Ctx ctx) void
    []: EventRegistrationToken tok 1
    if: ctx = 0
        return
    if: ctx\registered = 0
        return
    if: ctx\mgr = 0 || ctx\token = 0
        ctx\registered: 0
        return
    c.memcpy((cast: (@: void) @ tok[0]), ctx\token, c.sizeof(c.EventRegistrationToken))
    c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataTransferManager_remove_DataRequested((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataTransferManager) ctx\mgr), tok[0])
    ctx\registered: 0
end: mixa_share_win32_unregister

# Real apartment-type check (ticket 20260912-001200 item 2): recording
# GetCurrentThreadId() at begin() and comparing it later (see
# mixa_share_win32_check_thread) only enforces "the same thread called
# every boundary function" -- it says nothing about whether that thread is
# actually an STA thread, which is the assumption MixaShareHandlerObj's
# non-atomic refcount depends on. begin() on an MTA thread would happily
# record that MTA thread as owner_tid and every later same-thread call
# would still "pass". This queries the REAL apartment CoGetApartmentType
# reports for the calling thread and only accepts STA/MAINSTA (values the
# SDK's own objidlbase.h defines as APTTYPE_STA=0 and APTTYPE_MAINSTA=3);
# MTA(1), NA(2), or a failed query (thread never initialized COM/WinRT at
# all) are rejected. Called once, at begin(), before anything is
# allocated -- the actual API boundary, not merely documented.
fn: mixa_share_win32_check_apartment () int
    int: apt_type
    int: apt_qualifier
    long: hr
    apt_type: -1
    apt_qualifier: -1
    hr: c.CoGetApartmentType((cast: (@: APTTYPE) @ apt_type), (cast: (@: APTTYPEQUALIFIER) @ apt_qualifier))
    if: hr != 0
        return: 0
    if: apt_type = 0 || apt_type = 3
        return: 1
return: 0

fn: mixa_share_win32_begin (@: MixaShareRequest r) int
    @: MixaShareWin32Ctx ctx
    @: void hstr_class
    @: void interop
    @: void mgr
    @: MixaShareHandlerObj handler
    @: MixaShareHandlerVtbl vtbl
    []: EventRegistrationToken tok 1
    []: GUID mgr_iid 1
    @: GUID pmgr_iid
