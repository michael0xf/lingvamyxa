predef: "mixa_manager/mixa_share_win32.h.lm1"
predef: "mixa_manager/mixa_share.h.lm1"
define: COBJMACROS 1
define: INITGUID 1
include: "<stdlib.h>" "<string.h>" "<windows.h>" "<roapi.h>" "<winstring.h>" "<shobjidl.h>" "<asyncinfo.h>" "<windows.applicationmodel.datatransfer.h>"
# windows.applicationmodel.datatransfer.h (the SDK's, resolved via
# -idirafter) already transitively includes the SDK's own complete
# Windows.Storage.h (via Windows.Storage.Streams.h -> Networking ->
# EnterpriseData -> here) -- do NOT also explicitly
# include: "<windows.storage.h>": that resolves to MinGW's OWN, much
# smaller windows.storage.h (found first via the normal, non-idirafter
# search path), which redeclares the same enums/structs the SDK's
# already-included version defines, with incompatible include guards.
# Confirmed by direct reproduction: adding that include produced dozens
# of "redeclaration of enum/struct" errors between the two versions.
# IStorageFileStatics/IStorageFile below are visible from the transitive
# include alone.

# Windows adapter for the file-share seam (ClearShell "Send e-mail" ->
# native Share, ticket 20260911-210200). Text-only slice: shares the
# request's text (+ title) through the real Windows share UI. File
# attachment needs Storage.StorageFile.GetFileFromPathAsync, itself another
# async WinRT call requiring a deferral inside Invoke; documented as the
# next increment in mixa_share.txt, not implemented here.
#
# COM/WinRT route (see mixa_share.txt for the researched feasibility and
# the exact -idirafter compiler flag this needs):
#   RoGetActivationFactory(HSTRING "...DataTransferManager", IID_IDataTransferManagerInterop, &interop)
#   interop->GetForWindow(hwnd, IID_IDataTransferManager, &mgr)
#   mgr->add_DataRequested(&our_handler, &token)
#   interop->ShowShareUIForWindow(hwnd)
#   -- OS calls our_handler->Invoke(mgr, args) asynchronously --
#     args->get_Request(&request); request->get_Data(&package);
#     package->SetText(hstring); package->get_Properties(&props); props->put_Title(hstring)
#
# Our handler is a plain-C COM object: a struct whose FIRST field is a
# pointer to OUR OWN populated vtable (QueryInterface/AddRef/Release/
# Invoke), matching the "first field is a vtable pointer" shape every
# WinRT/COM interface already has. This is the same calloc + sequential
# `\field: fn` vtable-construction pattern already used throughout this
# codebase (mixa_audio_win32_table, mixa_app's table) -- building a vtable
# to HAND OUT instead of only ever consuming one.

# --- small helpers -----------------------------------------------------

fn: mixa_share_win32_utf8_to_wide (const: @(char s_utf8)) @: wchar_t
    int: nwide
    @: wchar_t wbuf
    if: s_utf8 = 0
        return: 0
    nwide: c.MultiByteToWideChar(65001, 0U, s_utf8, -1, 0, 0)
    if: nwide <= 0
        return: 0
    wbuf: (cast: (@: wchar_t) c.calloc((cast: (size_t) nwide), c.sizeof(c.wchar_t)))
    if: wbuf = 0
        return: 0
    if: c.MultiByteToWideChar(65001, 0U, s_utf8, -1, wbuf, nwide) = 0
        c.free(wbuf)
        return: 0
return: wbuf

# UTF-8 -> HSTRING. Caller must WindowsDeleteString the result.
fn: mixa_share_win32_hstring_from_utf8 (const: @(char s_utf8); @@: void out_hstr) int
    @: wchar_t wbuf
    int: wlen
    int: hr
    if: s_utf8 = 0 || out_hstr = 0
        return: MIXA_SHARE_ERR_ARG
    out_hstr[0]: 0
    wbuf: mixa_share_win32_utf8_to_wide(s_utf8)
    if: wbuf = 0
        return: MIXA_SHARE_ERR_BACKEND
    wlen: (cast: (int) c.wcslen(wbuf))
    hr: c.WindowsCreateString(wbuf, (cast: (UINT32) wlen), (cast: (@: void) out_hstr))
    c.free(wbuf)
    if: hr != 0
        return: MIXA_SHARE_ERR_BACKEND
return: MIXA_SHARE_OK

# Exists + is a file (not a directory). Corresponds to the reference's
# directory-in-selection soft-skip / missing-file hard-error split, which
# the portable controller (mixa_share.lm1) already implements against
# whatever this returns.
fn: mixa_share_win32_probe_file (const: @(char path_utf8)) int
    @: wchar_t wpath
    ulong: attrs
    if: path_utf8 = 0
        return: MIXA_SHARE_ERR_ARG
    wpath: mixa_share_win32_utf8_to_wide(path_utf8)
    if: wpath = 0
        return: MIXA_SHARE_ERR_BACKEND
    attrs: c.GetFileAttributesW(wpath)
    c.free(wpath)
    if: attrs = 4294967295U
        return: MIXA_SHARE_ERR_MISSING
    if: (attrs & 16U) != 0U
        return: MIXA_SHARE_ERR_UNSUPPORTED
return: MIXA_SHARE_OK

# --- our own DataRequested handler object (a plain-C COM object) -------
# (struct declared in the header -- L1 requires struct: in .h.lm1 files)

# Our handler implements exactly two interfaces: IUnknown (every COM object
# must) and the specific parameterized event-handler interface WinRT
# actually invokes through (ITypedEventHandler<DataTransferManager*,
# DataRequestedEventArgs*>, IID ec6f9cc8-46d0-5e0e-b4d2-7d7773ae37a0 per
# that interface's own __declspec(uuid(...)) in the SDK header -- same
# "construct inline, no linkable SDK symbol" situation as
# IDataTransferManager's IID, documented in mixa_share.txt). Any other
# riid (IAgileObject, IMarshal, etc., which WinRT's marshaling layer may
# probe for) must be refused with E_NOINTERFACE and a null ppv, not
# silently satisfied with the wrong object.
fn: mixa_share_handler_iid_matches (@: void riid) int
    []: GUID g 1
    @: GUID pg
    if: riid = 0
        return: 0
    pg: @ g[0]
    pg\Data1: (cast: (unsigned long) 0x00000000U)
    pg\Data2: (cast: (unsigned short) 0x0000U)
    pg\Data3: (cast: (unsigned short) 0x0000U)
    pg\Data4[0]: (cast: (char) 0xc0)
    pg\Data4[1]: (cast: (char) 0x00)
    pg\Data4[2]: (cast: (char) 0x00)
    pg\Data4[3]: (cast: (char) 0x00)
    pg\Data4[4]: (cast: (char) 0x00)
    pg\Data4[5]: (cast: (char) 0x00)
    pg\Data4[6]: (cast: (char) 0x00)
    pg\Data4[7]: (cast: (char) 0x46)
    if: c.memcmp(riid, pg, c.sizeof(c.GUID)) = 0
        return: 1
    pg\Data1: (cast: (unsigned long) 0xec6f9cc8U)
    pg\Data2: (cast: (unsigned short) 0x46d0U)
    pg\Data3: (cast: (unsigned short) 0x5e0eU)
    pg\Data4[0]: (cast: (char) 0xb4)
    pg\Data4[1]: (cast: (char) 0xd2)
    pg\Data4[2]: (cast: (char) 0x7d)
    pg\Data4[3]: (cast: (char) 0x77)
    pg\Data4[4]: (cast: (char) 0x73)
    pg\Data4[5]: (cast: (char) 0xae)
    pg\Data4[6]: (cast: (char) 0x37)
    pg\Data4[7]: (cast: (char) 0xa0)
    if: c.memcmp(riid, pg, c.sizeof(c.GUID)) = 0
        return: 1
return: 0

fn: mixa_share_handler_query_interface (@: void this_raw; @: void riid; @@: void ppv) long
    @: MixaShareHandlerObj self
    if: this_raw = 0 || ppv = 0
