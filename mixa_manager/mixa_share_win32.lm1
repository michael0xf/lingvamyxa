    st: mixa_share_win32_hstring_from_utf8("Windows.Storage.StorageFile", @ hstr_class)
    if: st != MIXA_SHARE_OK
        return: MIXA_SHARE_ERR_BACKEND
    statics: 0
    # IID_IStorageFileStatics: 5984c710-daf2-43c8-8bb4-a4d3eacfd03f, from
    # windows.storage.h's own MIDL_INTERFACE annotation on
    # IStorageFileStatics -- same "no linkable DEFINE_GUID in this MinGW
    # toolchain" situation as IDataTransferManager elsewhere in this file.
    pstatics_iid: @ statics_iid[0]
    pstatics_iid\Data1: (cast: (unsigned long) 0x5984c710U)
    pstatics_iid\Data2: (cast: (unsigned short) 0xdaf2U)
    pstatics_iid\Data3: (cast: (unsigned short) 0x43c8U)
    pstatics_iid\Data4[0]: (cast: (char) 0x8b)
    pstatics_iid\Data4[1]: (cast: (char) 0xb4)
    pstatics_iid\Data4[2]: (cast: (char) 0xa4)
    pstatics_iid\Data4[3]: (cast: (char) 0xd3)
    pstatics_iid\Data4[4]: (cast: (char) 0xea)
    pstatics_iid\Data4[5]: (cast: (char) 0xcf)
    pstatics_iid\Data4[6]: (cast: (char) 0xd0)
    pstatics_iid\Data4[7]: (cast: (char) 0x3f)
    hr: c.RoGetActivationFactory((cast: (HSTRING) hstr_class), (cast: (const: @(IID)) pstatics_iid), @ statics)
    c.WindowsDeleteString(hstr_class)
    if: hr != 0 || statics = 0
        return: MIXA_SHARE_ERR_BACKEND
    hpath: 0
    st: mixa_share_win32_hstring_from_utf8(path_utf8, @ hpath)
    if: st != MIXA_SHARE_OK
        c.__x_ABI_CWindows_CStorage_CIStorageFileStatics_Release((cast: (@: __x_ABI_CWindows_CStorage_CIStorageFileStatics) statics))
        return: MIXA_SHARE_ERR_BACKEND
    file_op: 0
    hr: c.__x_ABI_CWindows_CStorage_CIStorageFileStatics_GetFileFromPathAsync((cast: (@: __x_ABI_CWindows_CStorage_CIStorageFileStatics) statics), (cast: (HSTRING) hpath), (cast: (@@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) @ file_op))
    c.WindowsDeleteString((cast: (HSTRING) hpath))
    c.__x_ABI_CWindows_CStorage_CIStorageFileStatics_Release((cast: (@: __x_ABI_CWindows_CStorage_CIStorageFileStatics) statics))
    if: hr != 0 || file_op = 0
        return: MIXA_SHARE_ERR_BACKEND
    handler: (cast: (@: MixaFileOpHandlerObj) c.calloc(1U, c.sizeof(c.MixaFileOpHandlerObj)))
    if: handler = 0
        c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_Release((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) file_op))
        return: MIXA_SHARE_ERR_NOMEM
    vtbl: (cast: (@: MixaFileOpHandlerVtbl) c.calloc(1U, c.sizeof(c.MixaFileOpHandlerVtbl)))
    if: vtbl = 0
        c.free(handler)
        c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_Release((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) file_op))
        return: MIXA_SHARE_ERR_NOMEM
    vtbl\QueryInterface: mixa_file_op_handler_query_interface
    vtbl\AddRef: mixa_file_op_handler_add_ref
    vtbl\Release: mixa_file_op_handler_release
    vtbl\Invoke: mixa_file_op_handler_invoke
    handler\lpVtbl: vtbl
    handler\refcount: 1
    handler\owner_ctx: (cast: (@: void) ctx)
    # Set ctx's fields BEFORE calling put_Completed, not after (ticket
    # 20260912-020800): if the operation has already finished by the time
    # we register -- a real, documented WinRT possibility, not just a
    # defensive guess -- the completion can fire SYNCHRONOUSLY/reentrantly
    # from inside this very put_Completed call, before it returns to us.
    # mixa_file_op_handler_invoke needs to find these already populated in
    # that case, not still zeroed from an ordering that assumed completion
    # always happens strictly later, on a later turn of the message loop.
    ctx\pending_package: package
    ctx\file_op: file_op
    ctx\file_handler: (cast: (@: void) handler)
    hr: c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_put_Completed((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) file_op), (cast: (@: __FIAsyncOperationCompletedHandler_1_Windows__CStorage__CStorageFile) handler))
    if: hr != 0
