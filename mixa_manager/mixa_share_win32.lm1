# Populates the real DataPackage from the owning MixaShareRequest's text
# and title. Synchronous: no deferral needed since neither SetText nor
# put_Title does async work. File attachment (a future increment) WOULD
# need IDataRequestedEventArgs's GetDeferral()/Deferral::Complete() around
# the async StorageFile.GetFileFromPathAsync chain; not needed for text.
#
# sender/args are BORROWED (caller-owned) per COM convention for an event
# callback's own parameters -- never Released here. request_obj/package/
# props are each OWNED references from their respective get_* out
# parameters and are Released exactly once each, on every path (success
# or failure), before returning.
#
# Every SDK call's HRESULT is checked; a failure sets ctx->invoke_status to
# a terminal MIXA_SHARE_ERR_* so poll() can report it truthfully instead of
# always claiming HANDED_OFF once pending clears -- Invoke() firing at all
# is not proof the DataPackage was actually populated.

# Owner-thread contract enforcement (ticket 20260911-234500): our public
# functions (begin/poll/cancel/destroy) are plain C calls, not COM
# interface calls, so nothing marshals a wrong-thread invocation onto the
# STA thread that actually owns ctx's live WinRT references the way a real
# COM proxy would for an interface call. begin() records the calling
# thread; every later boundary (including this Invoke callback, as a self-
# check that the apartment model actually behaved as documented) checks
# against it before touching any real WinRT object. Returns 1 if the
# calling thread matches (or ctx has not recorded an owner yet), 0 on a
# genuine mismatch. Declared before Invoke() (defined below) since this is
# a single-pass translation unit with no forward declarations.
fn: mixa_share_win32_check_thread (@: MixaShareWin32Ctx ctx) int
    ulong: tid
    if: ctx = 0
        return: 1
    if: ctx\owner_tid = 0U
        return: 1
    tid: c.GetCurrentThreadId()
    if: tid != ctx\owner_tid
        return: 0
return: 1

# File attachment, stage 1: async StorageFile resolution + deferral
# completion. IAsyncOperationCompletedHandler<StorageFile*> IS a real,
# literal, verifiable GUID after all -- ticket 20260912-020800 found it
# via __declspec(uuid("...")) at windows.storage.h line ~2260 (a C++
# template specialization annotation, a different spelling than the
# MIDL_INTERFACE("...") pattern this file's earlier search looked for,
# which is why an earlier version of this comment wrongly claimed no
# literal GUID exists anywhere for this interface -- corrected here, not
# silently). e521c894-2c26-5946-9e61-2b5e188d01ed.
#
# QueryInterface accepts ONLY IUnknown and this exact IID, matching
# mixa_share_handler_query_interface's own strict pattern for the
# non-generic DataRequested handler -- an earlier version of this
# function accepted ANY non-null riid as a "layout-compatible" shortcut,
# reasoning that a 4-slot IUnknown-derived vtable is safe to claim for
# any IUnknown-derived query. That reasoning was wrong: falsely answering
# yes to probes for IMarshal/IAgileObject/IWeakReferenceSource (which COM
# and WinRT's own marshaling infrastructure use to DECIDE how to deliver
# calls to this object) misdirects that infrastructure into a path this
# object cannot actually support, which is the likely reason
# put_Completed failed with CO_E_NOT_SUPPORTED even after a
# free-threaded-marshaler aggregation was added to try to fix it (removed
# again here -- see the callback-safety comment on
# mixa_file_op_handler_invoke for why FTM was also the wrong tool
# regardless: it does not marshal calls onto the owner STA thread, it
# grants OTHER apartments direct, unsynchronized access to this object).
fn: mixa_file_op_handler_iid_matches (@: void riid) int
    []: GUID g 1
    @: GUID pg
    if: riid = 0
        return: 0
    pg: @ g[0]
    pg\Data1: (cast: (unsigned long) 0x00000000U)
    pg\Data2: (cast: (unsigned short) 0x0000U)
    pg\Data3: (cast: (unsigned short) 0x0000U)
    pg\Data4[0]: (cast: (char) 0xc0)
    pg\Data4[1]: (cast: (char) 0x00)
    pg\Data4[2]: (cast: (char) 0x00)
    pg\Data4[3]: (cast: (char) 0x00)
    pg\Data4[4]: (cast: (char) 0x00)
    pg\Data4[5]: (cast: (char) 0x00)
    pg\Data4[6]: (cast: (char) 0x00)
    pg\Data4[7]: (cast: (char) 0x46)
    if: c.memcmp(riid, pg, c.sizeof(c.GUID)) = 0
        return: 1
    pg\Data1: (cast: (unsigned long) 0xe521c894U)
    pg\Data2: (cast: (unsigned short) 0x2c26U)
    pg\Data3: (cast: (unsigned short) 0x5946U)
    pg\Data4[0]: (cast: (char) 0x9e)
    pg\Data4[1]: (cast: (char) 0x61)
    pg\Data4[2]: (cast: (char) 0x2b)
    pg\Data4[3]: (cast: (char) 0x5e)
    pg\Data4[4]: (cast: (char) 0x18)
    pg\Data4[5]: (cast: (char) 0x8d)
    pg\Data4[6]: (cast: (char) 0x01)
    pg\Data4[7]: (cast: (char) 0xed)
    if: c.memcmp(riid, pg, c.sizeof(c.GUID)) = 0
        return: 1
return: 0

