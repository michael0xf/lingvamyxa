# Runs when GetFileFromPathAsync's operation completes (successfully,
# with an error, or canceled). Tears down every piece of ctx's async-file
# state exactly once here, regardless of outcome: GetResults' file (if
# any -- stage 1 does not attach it to the DataPackage yet, so it is
# released immediately after logging/checking status), the DataPackage
# reference kept alive for stage 2's future SetStorageItems call, the
# async operation object itself, and finally the deferral -- Complete()
# is called on every path (success or failure) since the OS is waiting
# on it regardless of whether OUR attachment succeeded; a failure here
# must still let the share flow finish, not hang the OS's own broker
# waiting for a deferral that never completes. ctx->pending is cleared
# here, not in the DataRequested Invoke() above, since that is the point
# this async chain actually finishes -- doing it in Invoke() itself would
# be premature (per the ticket's own explicit "explicit ownership/
# lifetime of request data and platform resources until the OS has
# finished using them" requirement).
fn: mixa_file_op_handler_invoke (@: void this_raw; @: void async_info; int: async_status) long
    @: MixaFileOpHandlerObj self
    @: MixaShareWin32Ctx ctx
    @: void file
    long: hr
    if: this_raw = 0
        return: -2147024809
    self: (cast: (@: MixaFileOpHandlerObj) this_raw)
    ctx: (cast: (@: MixaShareWin32Ctx) self\owner_ctx)
    if: ctx = 0
        return: -2147467259
    if: mixa_share_win32_check_thread(ctx) = 0
        return: -2147467259
    file: 0
    hr: c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_GetResults((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) async_info), (cast: (@@: __x_ABI_CWindows_CStorage_CIStorageFile) @ file))
    if: hr != 0 || async_status != 1 || file = 0
        ctx\invoke_status: MIXA_SHARE_ERR_BACKEND
    else:
        # Resolving the file is NOT the same as sharing it (ticket
        # 20260912-020800: "HANDED_OFF must require actual data
        # population, not just resolving a file and discarding it").
        # Stage 2 (IDataPackage::SetStorageItems, needing a custom
        # IIterable<IStorageItem*>/IIterator pair) is not implemented yet,
        # so `file` is released unused below and this is honestly reported
        # as unsupported rather than claiming the request was actually
        # fulfilled -- poll() must not report HANDED_OFF/OK for a share
        # that silently dropped the file the caller asked to attach.
        ctx\invoke_status: MIXA_SHARE_ERR_UNSUPPORTED
    ---
    if: file != 0
        c.__x_ABI_CWindows_CStorage_CIStorageFile_Release((cast: (@: __x_ABI_CWindows_CStorage_CIStorageFile) file))
    ---
    if: ctx\pending_package != 0
        c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackage_Release((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackage) ctx\pending_package))
        ctx\pending_package: 0
    ---
    if: ctx\file_op != 0
        c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_Release((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) ctx\file_op))
        ctx\file_op: 0
    ---
    if: ctx\file_deferral != 0
        c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataRequestDeferral_Complete((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataRequestDeferral) ctx\file_deferral))
        c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataRequestDeferral_Release((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataRequestDeferral) ctx\file_deferral))
        ctx\file_deferral: 0
    ---
    ctx\pending: 0
    if: ctx\file_handler != 0
        ctx\file_handler: 0
        mixa_file_op_handler_release(this_raw)
    ---
return: 0

# Kicks off async resolution of ONE file path (stage 1: only the first
# file -- multi-file attachment needs stage 2's custom IIterable and is a
# later increment). On success, ctx\pending_package/file_op/file_handler
# are all populated and OWNED by ctx from this point on; the caller
# (Invoke) must NOT release `package` itself afterward -- ownership
# transfers here. On failure, none of ctx's three fields are touched and
# the caller remains responsible for releasing `package`.
fn: mixa_share_win32_begin_file_resolution (@: MixaShareWin32Ctx ctx; @: void package; const: @(char path_utf8)) int
    @: void statics
    @: void hstr_class
    []: GUID statics_iid 1
    @: GUID pstatics_iid
    @: void hpath
    @: void file_op
    @: MixaFileOpHandlerObj handler
    @: MixaFileOpHandlerVtbl vtbl
