    self\refcount: self\refcount + 1
    ppv[0]: this_raw
return: 0

fn: mixa_share_handler_add_ref (@: void this_raw) ulong
    @: MixaShareHandlerObj self
    if: this_raw = 0
        return: 0U
    self: (cast: (@: MixaShareHandlerObj) this_raw)
    self\refcount: self\refcount + 1
return: (cast: (ulong) self\refcount)

fn: mixa_share_handler_release (@: void this_raw) ulong
    @: MixaShareHandlerObj self
    int: n
