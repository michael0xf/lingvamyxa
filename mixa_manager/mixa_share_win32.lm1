    []: GUID g 1
    @: GUID pg
    if: riid = 0
        return: 0
    pg: @ g[0]
    pg\Data1: (cast: (unsigned long) 0x00000000U)
    pg\Data2: (cast: (unsigned short) 0x0000U)
    pg\Data3: (cast: (unsigned short) 0x0000U)
    pg\Data4[0]: (cast: (char) 0xc0)
    pg\Data4[1]: (cast: (char) 0x00)
    pg\Data4[2]: (cast: (char) 0x00)
    pg\Data4[3]: (cast: (char) 0x00)
    pg\Data4[4]: (cast: (char) 0x00)
    pg\Data4[5]: (cast: (char) 0x00)
    pg\Data4[6]: (cast: (char) 0x00)
    pg\Data4[7]: (cast: (char) 0x46)
    if: c.memcmp(riid, pg, c.sizeof(c.GUID)) = 0
        return: 1
    pg\Data1: (cast: (unsigned long) 0xe521c894U)
    pg\Data2: (cast: (unsigned short) 0x2c26U)
    pg\Data3: (cast: (unsigned short) 0x5946U)
    pg\Data4[0]: (cast: (char) 0x9e)
    pg\Data4[1]: (cast: (char) 0x61)
    pg\Data4[2]: (cast: (char) 0x2b)
    pg\Data4[3]: (cast: (char) 0x5e)
    pg\Data4[4]: (cast: (char) 0x18)
    pg\Data4[5]: (cast: (char) 0x8d)
    pg\Data4[6]: (cast: (char) 0x01)
    pg\Data4[7]: (cast: (char) 0xed)
    if: c.memcmp(riid, pg, c.sizeof(c.GUID)) = 0
        return: 1
return: 0

