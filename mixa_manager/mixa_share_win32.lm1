        return: MIXA_SHARE_ERR_BACKEND
    ctx\mgr: mgr
    handler: (cast: (@: MixaShareHandlerObj) c.calloc(1U, c.sizeof(c.MixaShareHandlerObj)))
    if: handler = 0
        c.IDataTransferManagerInterop_Release((cast: (@: IDataTransferManagerInterop) interop))
        return: MIXA_SHARE_ERR_NOMEM
    vtbl: (cast: (@: MixaShareHandlerVtbl) c.calloc(1U, c.sizeof(c.MixaShareHandlerVtbl)))
    if: vtbl = 0
        c.free(handler)
        c.IDataTransferManagerInterop_Release((cast: (@: IDataTransferManagerInterop) interop))
        return: MIXA_SHARE_ERR_NOMEM
    vtbl\QueryInterface: mixa_share_handler_query_interface
    vtbl\AddRef: mixa_share_handler_add_ref
    vtbl\Release: mixa_share_handler_release
    vtbl\Invoke: mixa_share_handler_invoke
    handler\lpVtbl: vtbl
    handler\refcount: 1
    handler\owner_ctx: (cast: (@: void) ctx)
    ctx\handler: (cast: (@: void) handler)
    # Allocate the token bookkeeping BEFORE registering: if this calloc
    # failed AFTER a successful add_DataRequested, ctx->registered would
    # have no way to hold the token remove_DataRequested needs, leaving a
    # live handler that cleanup could never unregister. Allocating first
    # means a failure here simply aborts before any registration exists.
    if: (r\test_force_fail & MIXA_SHARE_TEST_FAIL_TOKEN_ALLOC) != 0
        ctx\token: 0
    else:
        ctx\token: c.calloc(1U, c.sizeof(c.EventRegistrationToken))
    ---
    if: ctx\token = 0
        # Not freeing handler manually here: ctx->handler already holds it
        # (assigned just above), and mixa_share_win32_destroy() -- which
        # the caller calls regardless of begin()'s outcome, per the
        # portable layer's contract -- releases it via that field. Freeing
        # it here too would leave ctx->handler dangling for destroy() to
        # double-free/use-after-free.
        c.IDataTransferManagerInterop_Release((cast: (@: IDataTransferManagerInterop) interop))
        return: MIXA_SHARE_ERR_NOMEM
    hr: c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataTransferManager_add_DataRequested((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataTransferManager) mgr), (cast: (@: __FITypedEventHandler_2_Windows__CApplicationModel__CDataTransfer__CDataTransferManager_Windows__CApplicationModel__CDataTransfer__CDataRequestedEventArgs) handler), @ tok[0])
    if: hr != 0
        c.IDataTransferManagerInterop_Release((cast: (@: IDataTransferManagerInterop) interop))
        return: MIXA_SHARE_ERR_BACKEND
    c.memcpy(ctx\token, (cast: (const: @(void)) @ tok[0]), c.sizeof(c.EventRegistrationToken))
    ctx\registered: 1
    ctx\pending: 1
    # Found via a controlled diagnostic (mixa_share_baseline_diag.lm1,
    # ticket 20260912-004800): ShowShareUIForWindow silently never
    # delivers DataRequested when its target window is not actually the
    # OS foreground window at the moment of the call -- confirmed
    # deterministic (only the first one or two real calls in a process
    # ever succeeded without this; 10/10 succeeded with it, across both
    # fresh windows and reuse of the same window). A real application's
    # own "Share" trigger almost always fires from its already-foreground
    # window, so this is normally a no-op reassertion, not a focus steal
    # against user intent; harmless if the OS declines it (foreground
    # changes are always subject to Windows' own foreground-lock rules).
    c.SetForegroundWindow((cast: (HWND) hwnd))
    hr: c.IDataTransferManagerInterop_ShowShareUIForWindow((cast: (@: IDataTransferManagerInterop) interop), (cast: (HWND) hwnd))
    # interop is only needed for GetForWindow + this call; release it
    # either way now. mgr stays owned by ctx (released in destroy(), since
    # remove_DataRequested needs it again on cancel/cleanup).
    c.IDataTransferManagerInterop_Release((cast: (@: IDataTransferManagerInterop) interop))
    if: hr != 0
        mixa_share_win32_unregister(ctx)
        ctx\pending: 0
        return: MIXA_SHARE_ERR_BACKEND
return: MIXA_SHARE_OK

# poll() reports the terminal status Invoke() actually observed, not an
# assumed success -- a callback firing at all is not proof the DataPackage
# was correctly populated (SetText/put_Title HRESULTs are checked inside
# Invoke and recorded in ctx->invoke_status).
fn: mixa_share_win32_poll (@: MixaShareRequest r; @: int out_event; @: int out_status) int
    @: MixaShareWin32Ctx ctx
    if: r = 0 || out_event = 0 || out_status = 0
        return: MIXA_SHARE_ERR_ARG
    ctx: (cast: (@: MixaShareWin32Ctx) r\impl)
    if: ctx = 0
        return: MIXA_SHARE_ERR_STATE
    if: mixa_share_win32_check_thread(ctx) = 0
        return: MIXA_SHARE_ERR_THREAD
    if: ctx\pending != 0
        out_event[0]: MIXA_SHARE_EVENT_PENDING
        out_status[0]: MIXA_SHARE_OK
    else:
        if: ctx\invoke_status = MIXA_SHARE_OK
            out_event[0]: MIXA_SHARE_EVENT_HANDED_OFF
        else:
            out_event[0]: MIXA_SHARE_EVENT_FAILED
        ---
        out_status[0]: ctx\invoke_status
    ---
return: MIXA_SHARE_OK

# NOTE: does not tear down file_op/file_handler/pending_package/
# file_deferral/pending_items the way mixa_share_win32_destroy() does. Currently safe
# because this function is unreachable via the public API on this
# backend -- the win32 vtable never sets MIXA_SHARE_CAP_CANCEL, so the
# portable mixa_share_cancel() always refuses via its capability gate
# before ever calling here (confirmed by the native smoke test's
# cross-thread cancel regression). If CAP_CANCEL is ever added, this
# function will need the same file-teardown mixa_share_win32_destroy()
# has, including the IAsyncInfo::Cancel best-effort call and nulling
# file_handler->owner_ctx before any further cleanup.
fn: mixa_share_win32_cancel (@: MixaShareRequest r) int
    @: MixaShareWin32Ctx ctx
    if: r = 0
        return: MIXA_SHARE_ERR_ARG
    ctx: (cast: (@: MixaShareWin32Ctx) r\impl)
    if: ctx = 0
        return: MIXA_SHARE_ERR_STATE
    if: mixa_share_win32_check_thread(ctx) = 0
        return: MIXA_SHARE_ERR_THREAD
    mixa_share_win32_unregister(ctx)
    ctx\pending: 0
return: MIXA_SHARE_OK

# Wrong-thread destroy() is refused (returns MIXA_SHARE_ERR_THREAD instead
# of MIXA_SHARE_OK): freeing ctx or releasing its real WinRT references
# from a thread other than the STA thread that owns them would risk
# corrupting apartment-affine COM state rather than merely failing cleanly.
# This return value is load-bearing, not advisory -- the PORTABLE
# mixa_share_destroy() (mixa_share.lm1) checks it and refuses to free r/
# its owned fields on anything but MIXA_SHARE_OK, specifically because a
# refused destroy here leaves ctx alive with ctx->req still == r for a
# callback that can legitimately still fire later on the real owning
# thread (ticket 20260912-001200 caught this as a genuine use-after-free
# when this function was still void and the portable layer freed r
# unconditionally regardless of what happened here).
fn: mixa_share_win32_destroy (@: MixaShareRequest r) int
    @: MixaShareWin32Ctx ctx
    @: MixaShareHandlerObj handler
    @: MixaFileOpHandlerObj file_handler
    @: void async_info
    @@: void items
    int: i
    long: hr
    if: r = 0
        return: MIXA_SHARE_ERR_ARG
    ctx: (cast: (@: MixaShareWin32Ctx) r\impl)
    if: ctx = 0
        return: MIXA_SHARE_OK
    if: mixa_share_win32_check_thread(ctx) = 0
        return: MIXA_SHARE_ERR_THREAD
    mixa_share_win32_unregister(ctx)
    if: ctx\token != 0
        c.free(ctx\token)
    ---
    if: ctx\handler != 0
        handler: (cast: (@: MixaShareHandlerObj) ctx\handler)
        handler\owner_ctx: 0
        mixa_share_handler_release(ctx\handler)
    ---
    # File attachment torn down early (request destroyed/canceled while
    # GetFileFromPathAsync is still in flight -- ticket 20260911-210200's
    # acceptance test 4: cancellation cannot use freed request state, and
    # a repeated action must not leak old handlers).
    #
    # Ordering fix (ticket 20260912-020800): the handler's owner_ctx MUST
    # be nulled BEFORE calling IAsyncInfo::Cancel, not after. Cancel can
    # trigger the completion callback SYNCHRONOUSLY/reentrantly from
    # inside the Cancel() call itself (a real WinRT possibility, not a
    # defensive guess) -- an earlier version of this function nulled
    # owner_ctx only after Cancel() returned, so a reentrant
    # mixa_file_op_handler_invoke would have found owner_ctx still
    # pointing at this live ctx and run its FULL cleanup (releasing
    # pending_package, file_op, and the deferral, then releasing itself)
    # while THIS function was still in the middle of the same cleanup --
    # by the time control returned here, ctx\file_op could already be
    # null, and releasing a null COM pointer through its vtable crashes.
    # Nulling owner_ctx first makes any reentrant call from inside Cancel
    # a guaranteed no-op (same check mixa_file_op_handler_invoke already
    # does), leaving this function the sole owner of the cleanup below.
    if: ctx\file_handler != 0
        file_handler: (cast: (@: MixaFileOpHandlerObj) ctx\file_handler)
        file_handler\owner_ctx: 0
    ---
    if: ctx\file_op != 0
        async_info: 0
        hr: c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_QueryInterface((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) ctx\file_op), (cast: (const: @(IID)) @ c.IID_IAsyncInfo), @ async_info)
        if: hr = 0 && async_info != 0
            c.IAsyncInfo_Cancel((cast: (@: IAsyncInfo) async_info))
            c.IAsyncInfo_Release((cast: (@: IAsyncInfo) async_info))
        ---
        c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_Release((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) ctx\file_op))
        ctx\file_op: 0
    ---
    if: ctx\file_handler != 0
        mixa_file_op_handler_release(ctx\file_handler)
        ctx\file_handler: 0
    ---
    # Stage 2: release every IStorageItem* already resolved for a
    # multi-file chain torn down mid-flight (the file currently in flight,
    # if any, was just canceled above and never gets a slot filled in --
    # only indices [0, pending_item_next) hold real, AddRef'd references).
    if: ctx\pending_items != 0
        items: (cast: (@@: void) ctx\pending_items)
        i: 0
        while: i < ctx\pending_item_next
            c.__x_ABI_CWindows_CStorage_CIStorageItem_Release((cast: (@: __x_ABI_CWindows_CStorage_CIStorageItem) items[i]))
            i: i + 1
        ---
        c.free(ctx\pending_items)
        ctx\pending_items: 0
    ---
    ctx\pending_item_total: 0
    ctx\pending_item_next: 0
    if: ctx\pending_package != 0
        c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackage_Release((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataPackage) ctx\pending_package))
        ctx\pending_package: 0
    ---
    if: ctx\file_deferral != 0
        c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataRequestDeferral_Complete((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataRequestDeferral) ctx\file_deferral))
        c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataRequestDeferral_Release((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataRequestDeferral) ctx\file_deferral))
        ctx\file_deferral: 0
    ---
    if: ctx\mgr != 0
        c.__x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataTransferManager_Release((cast: (@: __x_ABI_CWindows_CApplicationModel_CDataTransfer_CIDataTransferManager) ctx\mgr))
    ---
    c.free(ctx)
    r\impl: 0
return: MIXA_SHARE_OK

@: MixaShareVTable g_mixa_share_win32_vtable
int: g_mixa_share_win32_vtable_valid

fn: mixa_share_win32_table () const: @(MixaShareVTable)
    if: g_mixa_share_win32_vtable_valid = 0
        g_mixa_share_win32_vtable: (cast: (@: MixaShareVTable) c.calloc(1U, c.sizeof(c.MixaShareVTable)))
        if: g_mixa_share_win32_vtable = 0
            return: 0
        g_mixa_share_win32_vtable\name: "win32"
        # CAP_MULTIPLE added with stage 2 (ticket 20260912-022300):
        # mixa_file_op_handler_invoke now genuinely resolves and attaches
        # every requested file, not just the first -- the portable
        # mixa_share_begin() gate (r\file_count > 1 needs CAP_MULTIPLE)
        # would otherwise refuse a real multi-file request before this
        # backend's begin() is ever called, regardless of what the chain
        # itself can do.
        g_mixa_share_win32_vtable\caps: MIXA_SHARE_CAP_TEXT_ONLY | MIXA_SHARE_CAP_MULTIPLE
        g_mixa_share_win32_vtable\probe_file: mixa_share_win32_probe_file
        g_mixa_share_win32_vtable\begin: mixa_share_win32_begin
        g_mixa_share_win32_vtable\poll: mixa_share_win32_poll
        g_mixa_share_win32_vtable\cancel: mixa_share_win32_cancel
        g_mixa_share_win32_vtable\destroy: mixa_share_win32_destroy
        g_mixa_share_win32_vtable_valid: 1
    ---
return: g_mixa_share_win32_vtable
