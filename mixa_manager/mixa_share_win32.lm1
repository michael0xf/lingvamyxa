        # otherwise) is coming, so roll back the optimistic assignment
        # above before the caller (mixa_share_handler_invoke) releases
        # package/file_op/handler itself on this failure path; ctx must
        # not be left pointing at objects it no longer owns.
        ctx\pending_package: 0
        ctx\file_op: 0
        ctx\file_handler: 0
        mixa_file_op_handler_release((cast: (@: void) handler))
        c.__FIAsyncOperation_1_Windows__CStorage__CStorageFile_Release((cast: (@: __FIAsyncOperation_1_Windows__CStorage__CStorageFile) file_op))
        return: MIXA_SHARE_ERR_BACKEND
    # hr = 0 here does NOT mean ctx's three fields above are still
    # populated -- if the completion fired synchronously during
