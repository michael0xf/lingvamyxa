# --- stage 2: IIterator<IStorageItem*> plain-C COM object ---------------

# Test-only: counts every IStorageItem* reference actually vended out of
# our iterator (get_Current success + GetMany's copied count), reset at
# the start of each mixa_share_win32_make_storage_item_iterable call.
# Production code never reads this; it exists so the native smoke test
# can assert the OS's real DataPackage/SetStorageItems machinery actually
# walked our iterable (ticket 20260912-022300: "inspect actual DataPackage
# storage items"), not merely that SetStorageItems returned a success
# HRESULT while silently ignoring it -- a real risk this stage's own
# strict-QueryInterface history (see mixa_file_op_handler_query_interface)
# already showed is not something to take on faith. Covers BOTH ways a
# real consumer may walk the collection (the classic get_Current/
# HasCurrent/MoveNext loop, or a single bulk GetMany call) since WinRT
# does not guarantee which one DataPackage's own implementation uses.
int: g_mixa_storage_item_vend_count

# Test-only: an extra, test-owned AddRef'd reference to the most recent
# DataPackage a SetStorageItems call succeeded on, captured ONLY when the
# request has MIXA_SHARE_TEST_CAPTURE_PACKAGE set (see that define's own
# comment) -- never touched otherwise, so a real share pays nothing for
# this. Ownership transfers out (and this is cleared) via
# mixa_share_win32_test_take_last_package; if nothing ever takes it, the
# next captured request's own cleanup releases whatever was left here
# first, so this never accumulates leaked references across test runs.
@: void g_mixa_storage_item_last_package

# Forward declaration: mixa_storage_item_iter_release (below) needs to
# release its AddRef on the owning iterable (ticket 20260912-025800), but
# mixa_storage_item_iterable_release is defined further down still --
# same single-pass-translation-unit situation as mixa_file_op_handler_invoke's
# own forward declaration elsewhere in this file, just one-directional
# here rather than mutual.
prototype:
    fn: mixa_storage_item_iterable_release (@: void this_raw) ulong
end: prototype

