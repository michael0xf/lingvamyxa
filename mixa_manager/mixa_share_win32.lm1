    if: vtbl = 0
        c.free(handler)
        c.IDataTransferManagerInterop_Release((cast: (@: IDataTransferManagerInterop) interop))
        return: MIXA_SHARE_ERR_NOMEM
    vtbl\QueryInterface: mixa_share_handler_query_interface
    vtbl\AddRef: mixa_share_handler_add_ref
    vtbl\Release: mixa_share_handler_release
    vtbl\Invoke: mixa_share_handler_invoke
    handler\lpVtbl: vtbl
    handler\refcount: 1
    handler\owner_ctx: (cast: (@: void) ctx)
    ctx\handler: (cast: (@: void) handler)
    # Allocate the token bookkeeping BEFORE registering: if this calloc
    # failed AFTER a successful add_DataRequested, ctx->registered would
    # have no way to hold the token remove_DataRequested needs, leaving a
    # live handler that cleanup could never unregister. Allocating first
