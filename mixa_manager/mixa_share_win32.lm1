    # against shobjidl.h's DEFINE_GUID; the SDK's own
    # IID___x_ABI_..._CIDataTransferManager is only EXTERN_C-declared in
    # windows.applicationmodel.datatransfer.h, with no linkable storage in
    # this MinGW toolchain (confirmed: a plain -idirafter include leaves it
    # undefined at link time even with INITGUID, since it's not a
    # DEFINE_GUID invocation there). Constructed inline instead, from the
    # exact value in that header's own MIDL_INTERFACE("a5caee9b-8708-49d1-
    # 8d36-67d25a8da00c") annotation on IDataTransferManager.
    pmgr_iid: @ mgr_iid[0]
    pmgr_iid\Data1: (cast: (unsigned long) 0xa5caee9bU)
    pmgr_iid\Data2: (cast: (unsigned short) 0x8708U)
    pmgr_iid\Data3: (cast: (unsigned short) 0x49d1U)
    pmgr_iid\Data4[0]: (cast: (char) 0x8d)
    pmgr_iid\Data4[1]: (cast: (char) 0x36)
    pmgr_iid\Data4[2]: (cast: (char) 0x67)
    pmgr_iid\Data4[3]: (cast: (char) 0xd2)
    pmgr_iid\Data4[4]: (cast: (char) 0x5a)
    pmgr_iid\Data4[5]: (cast: (char) 0x8d)
    pmgr_iid\Data4[6]: (cast: (char) 0xa0)
    pmgr_iid\Data4[7]: (cast: (char) 0x0c)
    hr: c.IDataTransferManagerInterop_GetForWindow((cast: (@: IDataTransferManagerInterop) interop), (cast: (HWND) hwnd), (cast: (const: @(IID)) pmgr_iid), @ mgr)
