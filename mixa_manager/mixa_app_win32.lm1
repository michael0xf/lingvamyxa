predef: "mixa_manager/mixa_app_win32.h.lm1"
predef: "mixa_manager/mixa_app.h.lm1"
include: "<stdlib.h>" "<string.h>" "<wchar.h>" "<shellapi.h>" "<stdio.h>"

# Windows app/shortcut seam (ClearShell "App" button, desktop port).
#
# Design: real launch .lnk files and URL .url files are treated as OPAQUE
# launchers. The launch reference is the original file itself; invocation goes
# through the native launcher contract (ShellExecuteExW, "open" verb), so the
# original target/args/working-dir/verb semantics are preserved without ever
# flattening a shortcut into target+arguments. Inspection only reads metadata
# (SHGetFileInfoW icon tag) and never executes a target.
#
# Filesystem links (reparse points) are recognized but are NOT interchanged
# with launcher shortcuts. Registered/packaged app identities are reserved as
# MIXA_APP_KIND_REGISTERED and are a documented, unimplemented Windows gap in
# this slice.

# UTF-8 path -> allocated wide string. Caller frees the out pointer.
fn: mixa_app_utf8_to_wide (const: @(char path_utf8); @@: wchar_t out_w) int
    int: nwide
    @: wchar_t wbuf
    if: path_utf8 = 0
        return: MIXA_APP_ERR_ARG
    if: out_w = 0
        return: MIXA_APP_ERR_ARG
    out_w[0]: 0
    nwide: c.MultiByteToWideChar(65001, 0U, path_utf8, -1, 0, 0)
    if: nwide <= 0
        return: MIXA_APP_ERR_IO
    wbuf: (cast: (@: wchar_t) c.calloc((cast: (size_t) nwide), c.sizeof(c.wchar_t)))
    if: wbuf = 0
        return: MIXA_APP_ERR_NOMEM
    if: c.MultiByteToWideChar(65001, 0U, path_utf8, -1, wbuf, nwide) = 0
        c.free(wbuf)
        return: MIXA_APP_ERR_IO
    out_w[0]: wbuf
return: MIXA_APP_OK

# Bounded copy helper: never truncates silently.
fn: mixa_app_copy_utf8 (@: char dst; size_t: cap; const: @(char src)) int
    size_t: i
    if: dst = 0 || src = 0
        return: MIXA_APP_ERR_ARG
    if: cap = 0U
        return: MIXA_APP_ERR_IO
    i: 0
    while: src[i] != 0
        if: i + 1 >= cap
            return: MIXA_APP_ERR_IO
        dst[i]: src[i]
        i: i + 1
    dst[i]: 0
return: MIXA_APP_OK

# Case-insensitive ASCII extension match: path ends with ".lnk"/".url".
fn: mixa_app_ext_eq (const: @(char path_utf8); const: @(char ext)) int
    size_t: plen
    size_t: elen
    size_t: p0
    size_t: i
    int: c1
    int: c2
    plen: 0
    while: path_utf8[plen] != 0
        plen: plen + 1
    elen: 0
    while: ext[elen] != 0
        elen: elen + 1
    if: elen > plen
        return: 0
    p0: plen - elen
    i: 0
    while: i < elen
        c1: (cast: (int) (cast: (unsigned char) path_utf8[p0 + i]))
        c2: (cast: (int) (cast: (unsigned char) ext[i]))
        if: c1 >= 65 && c1 <= 90
            c1: c1 + 32
        if: c2 >= 65 && c2 <= 90
            c2: c2 + 32
        if: c1 != c2
            return: 0
        i: i + 1
return: 1

# Label = file basename; the extension is dropped only for real launcher forms.
fn: mixa_app_copy_label (const: @(char path_utf8); @: MixaAppEntry out) int
    size_t: last
    size_t: i
    size_t: n
    if: path_utf8 = 0 || out = 0
        return: MIXA_APP_ERR_ARG
    i: 0
    last: 0
    while: path_utf8[i] != 0
        if: path_utf8[i] = 47 || path_utf8[i] = 92
            last: i + 1
        i: i + 1
    n: i - last
    if: mixa_app_ext_eq(path_utf8, ".lnk") = 1
        n: n - 4
    if: mixa_app_ext_eq(path_utf8, ".url") = 1
        n: n - 4
    if: n = 0U || n >= MIXA_APP_LABEL_LEN
        return: MIXA_APP_ERR_IO
    c.memcpy(out\label, path_utf8 + last, n)
    out\label[n]: 0
return: MIXA_APP_OK

# Classify an existing filesystem object into a launcher kind.
fn: mixa_app_kind_from_attrs (ulong: attrs; const: @(char path_utf8)) int
    if: (attrs & 1024U) != 0U
        return: MIXA_APP_KIND_FS_LINK
    if: (attrs & 16U) != 0U
        return: MIXA_APP_KIND_UNSUPPORTED
    if: mixa_app_ext_eq(path_utf8, ".lnk") = 1
        return: MIXA_APP_KIND_SHELL_LINK
    if: mixa_app_ext_eq(path_utf8, ".url") = 1
        return: MIXA_APP_KIND_URL_LINK
return: MIXA_APP_KIND_UNSUPPORTED

# Attrs for a path; MISSING when the path does not resolve.
fn: mixa_app_attrs_of (const: @(char path_utf8); @: ulong attrs) int
    @: wchar_t wpath
    []: (@: wchar_t) wslot 1
    int: st
    if: path_utf8 = 0 || attrs = 0
        return: MIXA_APP_ERR_ARG
    wslot[0]: 0
    st: mixa_app_utf8_to_wide(path_utf8, wslot)
    if: st != MIXA_APP_OK
        return: st
    wpath: wslot[0]
    attrs[0]: c.GetFileAttributesW(wpath)
    c.free(wpath)
    if: attrs[0] = 4294967295U
        return: MIXA_APP_ERR_MISSING
return: MIXA_APP_OK

# Icon acquisition: resolve the shell icon tag ("path,index") for the
# launcher through SHGetFileInfoW. Never loads or executes the target.
sub: mixa_app_icon_fill (const: @(char path_utf8); @: MixaAppEntry out)
    @: wchar_t wpath
    []: (@: wchar_t) wslot 1
    @: SHFILEINFOW sfi
    size_t: rc
    int: st
    if: out = 0
        return
    wslot[0]: 0
    st: mixa_app_utf8_to_wide(path_utf8, wslot)
    if: st != MIXA_APP_OK
        return
    wpath: wslot[0]
    sfi: (cast: (@: SHFILEINFOW) c.calloc(1U, c.sizeof(c.SHFILEINFOW)))
    if: sfi != 0
        rc: c.SHGetFileInfoW(wpath, 0U, sfi, (cast: (ulong) c.sizeof(c.SHFILEINFOW)), 4096U)
        if: rc != 0
            if: sfi\szDisplayName[0] != 0
                if: c.WideCharToMultiByte(65001, 0U, sfi\szDisplayName, -1, out\icon_ref, MIXA_APP_ICON_LEN, 0, 0) != 0
                    out\has_icon: 1
                ---
            ---
        ---
        c.free(sfi)
    ---
    c.free(wpath)
end: mixa_app_icon_fill

# Read-only inspection of any existing path: unreported kinds still return
# OK with a kind, so the UI can label unsupported entries. Never executes.
fn: mixa_app_inspect (const: @(char src_utf8); @: MixaAppEntry out) int
    ulong: a
    int: st
    int: kind
    if: src_utf8 = 0 || out = 0
        return: MIXA_APP_ERR_ARG
    c.memset(out, 0, c.sizeof(c.MixaAppEntry))
    st: mixa_app_attrs_of(src_utf8, @ a)
    if: st != MIXA_APP_OK
        return: st
    kind: mixa_app_kind_from_attrs(a, src_utf8)
    out\kind: kind
    st: mixa_app_copy_label(src_utf8, out)
    if: st != MIXA_APP_OK
        return: st
    st: mixa_app_copy_utf8(out\launch_ref, MIXA_APP_REF_LEN, src_utf8)
    if: st != MIXA_APP_OK
        return: st
    if: kind = MIXA_APP_KIND_SHELL_LINK
        mixa_app_icon_fill(src_utf8, out)
    if: kind = MIXA_APP_KIND_URL_LINK
        mixa_app_icon_fill(src_utf8, out)
return: MIXA_APP_OK

# --- serialization of our own minimal entries -----------------------------

sub: mixa_app_append_bytes (@: char buf; size_t: cap; @: size_t off; const: @(char src); size_t: n)
    if: buf = 0 || src = 0 || off = 0
        return
    if: off[0] + n > cap
        return
    c.memcpy(buf + off[0], src, n)
    off[0]: off[0] + n
end: mixa_app_append_bytes

sub: mixa_app_append_char (@: char buf; size_t: cap; @: size_t off; char: ch)
    if: buf = 0 || off = 0
        return
    if: off[0] + 1 > cap
        return
    buf[off[0]]: ch
    off[0]: off[0] + 1
end: mixa_app_append_char

# Reject values that would break the one-value-per-line entry format.
fn: mixa_app_needs_escape (const: @(MixaAppEntry e)) int
    size_t: i
    i: 0
    while: e\label[i] != 0
        if: e\label[i] = 10
            return: MIXA_APP_ERR_ARG
        i: i + 1
    i: 0
    while: e\icon_ref[i] != 0
        if: e\icon_ref[i] = 10
            return: MIXA_APP_ERR_ARG
        i: i + 1
    i: 0
    while: e\launch_ref[i] != 0
        if: e\launch_ref[i] = 10
            return: MIXA_APP_ERR_ARG
        i: i + 1
return: MIXA_APP_OK

# Serialize our own minimal entry (label + icon tag + opaque launch ref).
fn: mixa_app_entry_to_text (const: @(MixaAppEntry e); @@: char text_out) int
    size_t: labl
    size_t: icol
    size_t: lref
    size_t: need
    []: size_t off 1
    @: char buf
    []: char line 128
    int: st
    if: e = 0 || text_out = 0
        return: MIXA_APP_ERR_ARG
    text_out[0]: 0
    st: mixa_app_needs_escape(e)
    if: st != MIXA_APP_OK
        return: st
    labl: c.strlen(e\label)
    icol: c.strlen(e\icon_ref)
    lref: c.strlen(e\launch_ref)
    need: labl + icol + lref + 128U
    buf: (cast: (@: char) c.calloc(need, 1U))
    if: buf = 0
        return: MIXA_APP_ERR_NOMEM
    off[0]: 0
    c.snprintf(line, 128U, "mixa-app-link-v1")
    mixa_app_append_bytes(buf, need, off, line, c.strlen(line))
    mixa_app_append_char(buf, need, off, (cast: (char) 10))
    c.snprintf(line, 128U, "kind=%d", e\kind)
    mixa_app_append_bytes(buf, need, off, line, c.strlen(line))
    mixa_app_append_char(buf, need, off, (cast: (char) 10))
    c.snprintf(line, 128U, "label=%s", e\label)
    mixa_app_append_bytes(buf, need, off, line, c.strlen(line))
    mixa_app_append_char(buf, need, off, (cast: (char) 10))
    c.snprintf(line, 128U, "has_icon=%d", e\has_icon)
    mixa_app_append_bytes(buf, need, off, line, c.strlen(line))
    mixa_app_append_char(buf, need, off, (cast: (char) 10))
    c.snprintf(line, 128U, "icon=%s", e\icon_ref)
    mixa_app_append_bytes(buf, need, off, line, c.strlen(line))
    mixa_app_append_char(buf, need, off, (cast: (char) 10))
    c.snprintf(line, 128U, "launch=%s", e\launch_ref)
    mixa_app_append_bytes(buf, need, off, line, c.strlen(line))
    mixa_app_append_char(buf, need, off, (cast: (char) 10))
    buf[off[0]]: 0
    text_out[0]: buf
return: MIXA_APP_OK

# Write UTF-8 text to a file (CREATE_ALWAYS).
fn: mixa_app_write_text_utf8 (const: @(char path_utf8); const: @(char text)) int
    @: wchar_t wpath
    []: (@: wchar_t) wslot 1
    @: void hfile
    []: ulong wrote 1
    int: st
    size_t: n
    if: path_utf8 = 0 || text = 0
        return: MIXA_APP_ERR_ARG
    wslot[0]: 0
    st: mixa_app_utf8_to_wide(path_utf8, wslot)
    if: st != MIXA_APP_OK
        return: st
    wpath: wslot[0]
    hfile: c.CreateFileW(wpath, 1073741824U, 1U, 0, 2U, 128U, 0)
    c.free(wpath)
    if: hfile = (cast: (@: void) (cast: (size_t) -1))
        return: MIXA_APP_ERR_IO
    n: c.strlen(text)
    wrote[0]: 0U
    if: c.WriteFile(hfile, text, (cast: (ulong) n), wrote, 0) = 0
        c.CloseHandle(hfile)
        return: MIXA_APP_ERR_IO
    c.CloseHandle(hfile)
return: MIXA_APP_OK

# Read a whole file into an owned NUL-terminated buffer.
fn: mixa_app_read_file_utf8 (const: @(char path_utf8); @@: char data_out; @: size_t len_out) int
    @: wchar_t wpath
    []: (@: wchar_t) wslot 1
    @: void hfile
    []: ulong nread 1
    []: ulong fsz_hi 1
    ulong: fsz_lo
    @: char data
    int: st
    if: path_utf8 = 0 || data_out = 0 || len_out = 0
        return: MIXA_APP_ERR_ARG
    data_out[0]: 0
    len_out[0]: 0U
    wslot[0]: 0
    st: mixa_app_utf8_to_wide(path_utf8, wslot)
    if: st != MIXA_APP_OK
        return: st
    wpath: wslot[0]
    hfile: c.CreateFileW(wpath, 2147483648U, 3U, 0, 3U, 128U, 0)
    c.free(wpath)
    if: hfile = (cast: (@: void) (cast: (size_t) -1))
        if: c.GetLastError() = 2U || c.GetLastError() = 3U
            return: MIXA_APP_ERR_MISSING
        return: MIXA_APP_ERR_IO
    fsz_hi[0]: 0U
    c.SetLastError(0U)
    fsz_lo: c.GetFileSize(hfile, fsz_hi)
    if: fsz_lo = 4294967295U
        if: c.GetLastError() != 0U
            c.CloseHandle(hfile)
            return: MIXA_APP_ERR_IO
        ---
    ---
    if: fsz_hi[0] != 0U
        c.CloseHandle(hfile)
        return: MIXA_APP_ERR_IO
    data: (cast: (@: char) c.calloc((cast: (size_t) fsz_lo) + 1U, 1U))
    if: data = 0
        c.CloseHandle(hfile)
        return: MIXA_APP_ERR_NOMEM
    nread[0]: 0U
    if: c.ReadFile(hfile, data, fsz_lo, nread, 0) = 0
        c.free(data)
        c.CloseHandle(hfile)
        return: MIXA_APP_ERR_IO
    c.CloseHandle(hfile)
    data[fsz_lo]: 0
    len_out[0]: (cast: (size_t) nread[0])
    data_out[0]: data
return: MIXA_APP_OK

# Find "key=<value>" line in a NUL-terminated entry text. 1 found, 0 absent.
fn: mixa_app_line_get (const: @(char data); const: @(char key); @: char dst; size_t: cap) int
    size_t: klen
    size_t: i
    size_t: start
    size_t: eol
    size_t: vlen
    if: data = 0 || key = 0 || dst = 0
        return: 0
    if: cap = 0U
        return: 0
    klen: 0
    while: key[klen] != 0
        klen: klen + 1
    i: 0
    while: data[i] != 0
        start: i
        while: data[i] != 0
            if: data[i] = 10
                break
            i: i + 1
        eol: i
        if: eol - start > klen
            if: c.memcmp(data + start, key, klen) = 0
                if: data[start + klen] = 61
                    vlen: eol - (start + klen + 1)
                    if: vlen < cap
                        c.memcpy(dst, data + start + klen + 1, vlen)
                        dst[vlen]: 0
                        return: 1
                    ---
                ---
            ---
        ---
        if: data[i] = 0
            return: 0
        i: i + 1
return: 0

# Parse our own entry file text into an entry (already zeroed by caller).
fn: mixa_app_entry_parse (const: @(char data); const: @(char entry_path_utf8); @: MixaAppEntry out) int
    []: char vbuf MIXA_APP_REF_LEN
    []: char chdr 18
    []: char kindbuf 48
    int: st
    if: data = 0 || out = 0
        return: MIXA_APP_ERR_ARG
    chdr[0]: 109
    chdr[1]: 105
    chdr[2]: 120
    chdr[3]: 97
    chdr[4]: 45
    chdr[5]: 97
    chdr[6]: 112
    chdr[7]: 112
    chdr[8]: 45
    chdr[9]: 108
    chdr[10]: 105
    chdr[11]: 110
    chdr[12]: 107
    chdr[13]: 45
    chdr[14]: 118
    chdr[15]: 49
    chdr[16]: 10
    chdr[17]: 0
    if: c.memcmp(data, chdr, 17U) != 0
        return: MIXA_APP_ERR_IO
    if: mixa_app_line_get(data, "kind", kindbuf, 48U) = 0
        return: MIXA_APP_ERR_IO
    out\kind: c.atoi(kindbuf)
    if: mixa_app_line_get(data, "launch", out\launch_ref, MIXA_APP_REF_LEN) = 0
        return: MIXA_APP_ERR_IO
    out\label[0]: 0
    if: mixa_app_line_get(data, "label", vbuf, MIXA_APP_REF_LEN) = 1
        st: mixa_app_copy_utf8(out\label, MIXA_APP_LABEL_LEN, vbuf)
        if: st != MIXA_APP_OK
            return: st
        ---
    else:
        st: mixa_app_copy_label(entry_path_utf8, out)
        if: st != MIXA_APP_OK
            return: st
    ---
    out\has_icon: 0
    if: mixa_app_line_get(data, "has_icon", vbuf, 48U) = 1
        out\has_icon: c.atoi(vbuf)
    out\icon_ref[0]: 0
    mixa_app_line_get(data, "icon", out\icon_ref, MIXA_APP_ICON_LEN)
return: MIXA_APP_OK

# Read our own minimal entry back from disk.
fn: mixa_app_entry_read (const: @(char entry_path_utf8); @: MixaAppEntry out) int
    []: (@: char) dslot 1
    []: size_t lslot 1
    @: char data
    int: st
    if: entry_path_utf8 = 0 || out = 0
        return: MIXA_APP_ERR_ARG
    c.memset(out, 0, c.sizeof(c.MixaAppEntry))
    dslot[0]: 0
    lslot[0]: 0U
    st: mixa_app_read_file_utf8(entry_path_utf8, @ dslot[0], @ lslot[0])
    if: st != MIXA_APP_OK
        return: st
    data: dslot[0]
    st: mixa_app_entry_parse(data, entry_path_utf8, out)
    c.free(data)
return: st

# Remove our own entry file. Never touches the original launcher.
fn: mixa_app_entry_remove (const: @(char entry_path_utf8)) int
    @: wchar_t wpath
    []: (@: wchar_t) wslot 1
    int: st
    if: entry_path_utf8 = 0
        return: MIXA_APP_ERR_ARG
    wslot[0]: 0
    st: mixa_app_utf8_to_wide(entry_path_utf8, wslot)
    if: st != MIXA_APP_OK
        return: st
    wpath: wslot[0]
    if: c.DeleteFileW(wpath) = 0
        c.free(wpath)
        if: c.GetLastError() = 2U || c.GetLastError() = 3U
            return: MIXA_APP_ERR_MISSING
        return: MIXA_APP_ERR_IO
    c.free(wpath)
return: MIXA_APP_OK

# Create our own minimal entry from an existing launcher (shell link or URL
# link only). Records label + icon tag + the opaque launch reference, then
# verifies the round trip by reading it back.
fn: mixa_app_entry_create (const: @(char src_utf8); const: @(char entry_path_utf8); @: MixaAppEntry out) int
    []: (@: char) tslot 1
    @: char text
    int: st
    if: src_utf8 = 0 || entry_path_utf8 = 0 || out = 0
        return: MIXA_APP_ERR_ARG
    c.memset(out, 0, c.sizeof(c.MixaAppEntry))
    st: mixa_app_inspect(src_utf8, out)
    if: st != MIXA_APP_OK
        return: st
    if: out\kind != MIXA_APP_KIND_SHELL_LINK
        if: out\kind != MIXA_APP_KIND_URL_LINK
            return: MIXA_APP_ERR_UNSUPPORTED
        ---
    ---
    tslot[0]: 0
    st: mixa_app_entry_to_text(out, @ tslot[0])
    if: st != MIXA_APP_OK
        return: st
    text: tslot[0]
    st: mixa_app_write_text_utf8(entry_path_utf8, text)
    c.free(text)
    if: st != MIXA_APP_OK
        return: st
    st: mixa_app_entry_read(entry_path_utf8, out)
    if: st != MIXA_APP_OK
        mixa_app_entry_remove(entry_path_utf8)
        return: st
return: MIXA_APP_OK

# Invoke our own entry through the native launcher contract, using the stored
# opaque reference (the original .lnk/.url). Does not wait for the process.
fn: mixa_app_invoke (const: @(char entry_path_utf8)) int
    @: MixaAppEntry pent
    @: wchar_t wref
    []: (@: wchar_t) wslot 1
    @: SHELLEXECUTEINFOW sei
    int: st
    int: rc
    if: entry_path_utf8 = 0
        return: MIXA_APP_ERR_ARG
    pent: (cast: (@: MixaAppEntry) c.calloc(1U, c.sizeof(c.MixaAppEntry)))
    if: pent = 0
        return: MIXA_APP_ERR_NOMEM
    st: mixa_app_entry_read(entry_path_utf8, pent)
    if: st != MIXA_APP_OK
        c.free(pent)
        return: st
    if: pent\kind != MIXA_APP_KIND_SHELL_LINK
        if: pent\kind != MIXA_APP_KIND_URL_LINK
            c.free(pent)
            return: MIXA_APP_ERR_UNSUPPORTED
        ---
    ---
    wslot[0]: 0
    st: mixa_app_utf8_to_wide(pent\launch_ref, wslot)
    if: st != MIXA_APP_OK
        c.free(pent)
        return: st
    wref: wslot[0]
    sei: (cast: (@: SHELLEXECUTEINFOW) c.calloc(1U, c.sizeof(c.SHELLEXECUTEINFOW)))
    if: sei = 0
        c.free(wref)
        c.free(pent)
        return: MIXA_APP_ERR_NOMEM
    sei\cbSize: (cast: (ulong) c.sizeof(c.SHELLEXECUTEINFOW))
    sei\fMask: 1024U
    sei\nShow: 1
    sei\lpFile: wref
    rc: c.ShellExecuteExW(sei)
    c.free(sei)
    c.free(wref)
    c.free(pent)
    if: rc = 0
        return: MIXA_APP_ERR_LAUNCH
return: MIXA_APP_OK

# Open enumeration over our own *.link entries in a directory.
fn: mixa_app_list_open (@@: MixaAppList out; const: @(char dir_utf8)) int
    @: MixaAppList d
    @: WIN32_FIND_DATAW ffd
    @: wchar_t wdir
    []: (@: wchar_t) wslot 1
    @: wchar_t wpat
    size_t: dlen
    ulong: attrs
    int: st
    if: out = 0
        return: MIXA_APP_ERR_ARG
    out[0]: 0
    if: dir_utf8 = 0
        return: MIXA_APP_ERR_ARG
    wslot[0]: 0
    st: mixa_app_utf8_to_wide(dir_utf8, wslot)
    if: st != MIXA_APP_OK
        return: st
    wdir: wslot[0]
    attrs: c.GetFileAttributesW(wdir)
    if: attrs = 4294967295U
        c.free(wdir)
        return: MIXA_APP_ERR_MISSING
    d: (cast: (@: MixaAppList) c.calloc(1U, c.sizeof(c.MixaAppList)))
    if: d = 0
        c.free(wdir)
        return: MIXA_APP_ERR_NOMEM
    ffd: (cast: (@: WIN32_FIND_DATAW) c.calloc(1U, c.sizeof(c.WIN32_FIND_DATAW)))
    if: ffd = 0
        c.free(d)
        c.free(wdir)
        return: MIXA_APP_ERR_NOMEM
    d\ffd: ffd
    d\wdir: wdir
    if: c.WideCharToMultiByte(65001, 0U, wdir, -1, d\utf8_dir, MIXA_APP_DIR_LEN, 0, 0) = 0
        c.free(ffd)
        c.free(d)
        c.free(wdir)
        return: MIXA_APP_ERR_IO
    wpat: (cast: (@: wchar_t) c.calloc((cast: (size_t) (c.wcslen(wdir) + 8U)), c.sizeof(c.wchar_t)))
    if: wpat = 0
        c.free(ffd)
        c.free(d)
        c.free(wdir)
        return: MIXA_APP_ERR_NOMEM
    dlen: c.wcslen(wdir)
    c.memcpy(wpat, wdir, (dlen + 1U) * c.sizeof(c.wchar_t))
    wpat[dlen]: (cast: (wchar_t) 92)
    wpat[dlen + 1]: (cast: (wchar_t) 42)
    wpat[dlen + 2]: (cast: (wchar_t) 46)
    wpat[dlen + 3]: (cast: (wchar_t) 108)
    wpat[dlen + 4]: (cast: (wchar_t) 105)
    wpat[dlen + 5]: (cast: (wchar_t) 110)
    wpat[dlen + 6]: (cast: (wchar_t) 107)
    wpat[dlen + 7]: (cast: (wchar_t) 0)
    d\hfind: c.FindFirstFileW(wpat, ffd)
    c.free(wpat)
    if: d\hfind = (cast: (@: void) (cast: (size_t) -1))
        if: c.GetLastError() = 2U
            d\is_empty: 1
            d\is_open: 1
            out[0]: d
            return: MIXA_APP_OK
        c.free(ffd)
        c.free(d)
        c.free(wdir)
        return: MIXA_APP_ERR_IO
    d\is_open: 1
    out[0]: d
return: MIXA_APP_OK

# Internal: 1 when the current ffd is a directory (skipped in listings).
fn: mixa_app_ffd_is_dir (const: @(WIN32_FIND_DATAW ffd)) int
    if: ffd = 0
        return: 1
    if: (ffd\dwFileAttributes & 16U) != 0U
        return: 1
return: 0

# Build the full UTF-8 path of the current enumerator entry.
fn: mixa_app_list_build_path (@: MixaAppList l; const: @(WIN32_FIND_DATAW ffd)) int
    size_t: dlen
    int: rc
    if: l = 0 || ffd = 0
        return: MIXA_APP_ERR_IO
    dlen: 0
    while: l\utf8_dir[dlen] != 0
        dlen: dlen + 1
    if: dlen = 0U
        return: MIXA_APP_ERR_IO
    if: dlen + 2 >= MIXA_APP_PATH_LEN
        return: MIXA_APP_ERR_IO
    c.memcpy(l\utf8_path, l\utf8_dir, dlen)
    l\utf8_path[dlen]: (cast: (char) 92)
    l\utf8_path[dlen + 1]: 0
    rc: c.WideCharToMultiByte(65001, 0U, ffd\cFileName, -1, l\utf8_path + dlen + 1, MIXA_APP_PATH_LEN - dlen - 2, 0, 0)
    if: rc = 0
        return: MIXA_APP_ERR_IO
return: MIXA_APP_OK

# Next entry: fills the full entry by reading the *.link file. Directories
# named *.link are skipped; a readable-but-corrupt entry is an error.
fn: mixa_app_list_next (@: MixaAppList l; @: MixaAppEntry out) int
    int: st
    if: l = 0 || out = 0
        return: MIXA_APP_ERR_ARG
    if: l\is_open = 0
        return: MIXA_APP_ERR_ARG
    c.memset(out, 0, c.sizeof(c.MixaAppEntry))
    if: l\is_empty != 0
        return: MIXA_APP_END
    while: 1
        if: l\first_done != 0
            if: c.FindNextFileW(l\hfind, l\ffd) = 0
                return: MIXA_APP_END
            ---
        ---
        l\first_done: 1
        if: mixa_app_ffd_is_dir(l\ffd) = 0
            break
        ---
    st: mixa_app_list_build_path(l, l\ffd)
    if: st != MIXA_APP_OK
        return: st
    st: mixa_app_entry_read(l\utf8_path, out)
return: st

sub: mixa_app_list_close (@: MixaAppList l)
    if: l != 0
        if: l\is_open != 0
            if: l\hfind != (cast: (@: void) (cast: (size_t) -1))
                if: l\is_empty = 0
                    c.FindClose(l\hfind)
                ---
            ---
        ---
        if: l\ffd != 0
            c.free(l\ffd)
        if: l\wdir != 0
            c.free(l\wdir)
        c.free(l)
    ---
end: mixa_app_list_close

# Entry accessors (L1-safe: pointer arg, no indexed-struct VALUE access).

fn: mixa_app_entry_kind (const: @(MixaAppEntry e)) int
    if: e = 0
        return: MIXA_APP_KIND_UNSUPPORTED
    return: e\kind

fn: mixa_app_entry_has_icon (const: @(MixaAppEntry e)) int
    if: e = 0
        return: 0
    return: e\has_icon

fn: mixa_app_entry_label (const: @(MixaAppEntry e)) const: @(char)
    if: e = 0
        return: 0
    return: e\label

fn: mixa_app_entry_icon_ref (const: @(MixaAppEntry e)) const: @(char)
    if: e = 0
        return: 0
    return: e\icon_ref

fn: mixa_app_entry_launch_ref (const: @(MixaAppEntry e)) const: @(char)
    if: e = 0
        return: 0
    return: e\launch_ref