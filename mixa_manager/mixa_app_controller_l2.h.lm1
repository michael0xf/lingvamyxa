predef: "mixa_manager/mixa_fm_copy.h.lm1"
predef: "mixa_manager/mixa_console_window.h.lm1"
include: "<stddef.h>" "mixa_manager/mixa_app_path.h" "mixa_manager/mixa_help.h" "mixa_manager/mixa_cmdline.h" "mixa_manager/mixa_cmdline_dispatch.h" "mixa_manager/mixa_app_fmpanel.h"

# Header unit for the clean L2 port of mixa_app_controller (ticket
# 20260913-151000). Mirrors the REAL oracle's own predef/include split
# EXACTLY (mixa_app_controller.lm1's own top lines): predef ONLY the two
# L1-native units it already predefs (mixa_fm_copy.h.lm1 -- real,
# unmodified, giving MixaAppLoop/MixaFmCopyHereCtx/MixaCopySink/
# MixaFioFaultVTable/MixaFm/MixaFmAllocVTable plus real `include:`s for
# MixaCellMetrics/MixaEvent/MixaU8/MixaBackend/MixaPump transitively --
# and mixa_console_window.h.lm1 -- also real, unmodified, giving
# MixaConsoleView/MixaConsolePending plus MixaCell/MixaTextRect
# transitively via its own real `include: mixa_core.h`), reaching
# exactly the measured 16-file import-table cap this whole codebase's
# own comments already document as a hard, load-bearing property of the
# PINNED stable65D5 l1trans baseline (mixa_console_window.h.lm1's own
# comment: "the current tracked l1src/l1trans.lm1 already removes this
# as a fixed cap; it was only stable65D5's own initial realloc
# capacity, not an active source-language design limit").
#
# An EARLIER draft of this header instead predef'd this segment's own
# L2-declared replacement chains for MixaHelpCtx/MixaCmdLine (mixa_
# help_l2.h.lm1/mixa_cmdline_l2.h.lm1) reasoning that a DEREFERENCED
# struct field needs L1-known layout -- true for the by-value-embedding
# case (mixa_app_fmpanel's own MixaHighlight focus field this segment),
# but NOT true for plain pointer-field dereference: this file's own
# real oracle ALREADY dereferences c\cmdline\cps and c\help_ctx\
# console_file today with MixaCmdLine/MixaHelpCtx reached ONLY via a
# plain #include (mixa_app_controller_impl.h's own `#include "mixa_
# manager/mixa_cmdline.h"` / `"mixa_manager/mixa_help.h"`, no predef
# anywhere) -- proof that l1trans's own `\` dereference operator emits
# a plain C `->` and defers ALL structural resolution to gcc, never
# needing L1-level field knowledge for a POINTER field. That earlier
# draft's own combined predef chain (fm_copy + console_window_l2 +
# help_l2 + cmdline_l2 + cmdline_dispatch_l2 + app_path_l2 + app_
# fmpanel_l2, several with their OWN further transitive predefs) hit
# `l1trans error: mixa_manager/mixa_app_fmpanel_l2.h.lm1:0:0: import
# path table full` when translated standalone -- reproduced directly,
# not guessed -- confirming the combined footprint overflows the cap by
# a wide margin, not by one file the way Copy Here's own button-trigger
# ticket found. This header now mirrors the oracle exactly instead:
# MixaHelpCtx/MixaCmdLine/MixaCmdDispatch/MixaAppFmPanel/MixaAppPath
# FaultVTable/MixaCmdLineFaultVTable all stay genuinely opaque (name
# only, real prototypes arriving for free via each real plain-C
# header's own `include:`), costing ZERO extra import-table weight,
# exactly matching how the accepted oracle itself reaches them.
#
# MixaAppController itself has NO plain-C public exposure at all -- the
# real mixa_app_controller.h keeps it fully opaque (mixa_app_
# controller_impl.h, included ONLY by the real .lm1 itself, holds every
# field). This header is therefore the first and only place this
# struct's real layout is declared for the L2 side too, field-for-field
# identical to mixa_app_controller_impl.h (verified via a dedicated
# sizeof/offsetof probe before writing the .lm2 source) -- every field
# is a pointer or scalar (size_t/int/const char*), no by-value
# embedding anywhere, and every custom-struct field is referenced by
# NAME only here, exactly like mixa_app_controller_impl.h's own real
# `struct MixaConsoleView *view;`/`MixaCmdLine *cmdline;` fields do.

# MixaAppFmPanel stays a plain opaque name (no predef, no struct here
# at all -- the real `include:` above still supplies the C forward
# declaration `typedef struct MixaAppFmPanel MixaAppFmPanel;`, l1trans/
# gcc's own requirement for using the name as a pointer type, unrelated
# to l2trans's own separate need below): mixa_app_controller.lm2 only
# ever passes c\fmpanel as a function argument or returns it bare
# (verified directly, cited in L2_RUNTIME_MODULE_LIST_AUDIT.txt's own
# 2026-09-16 design note -- grep finds no `c\fmpanel\<field>` anywhere),
# so it never needs MixaAppFmPanel's own field layout. What it DOES need,
# that the plain #include above does not give it, is an L2-visible
# callable declaration for each of the eight functions it calls --
# l2trans's own frame-recognition does not consult plain C prototypes
# the way l1trans's `\` dereference lowering does, confirmed directly
# (removing the #include entirely broke the C side too: MixaAppFmPanel
# had no forward declaration at all without it). The eight blocks below
# supply that, the same "declare then link" convention already
# established for mixa_cell_at (mixa_tiles_l2.h.lm1) and mixa_tile_
# fill_button (mixa_buttons_l2.h.lm1) -- reaching neither the real
# mixa_core.h nor the L2 mixa_tiles_l2.h.lm1 chain, sidestepping the
# MixaCell/MixaTextRect redefinition conflict that same design note
# found when the FULL mixa_app_fmpanel_l2.h.lm1 chain was tried instead
# (reverted, commit 56fbf75e).
prototype:
    fn: mixa_app_fmpanel_close (@: MixaAppFmPanel p) void
end: prototype
prototype:
    fn: mixa_app_fmpanel_open (@@: MixaAppFmPanel out; @: MixaFm fm; size_t: list_row; size_t: list_col; size_t: list_rows; size_t: list_cols; size_t: action_row; size_t: action_col) int
end: prototype
prototype:
    fn: mixa_app_fmpanel_render (@: MixaAppFmPanel p; @: MixaTextRect rect) int
end: prototype
prototype:
    fn: mixa_app_fmpanel_report_copy_result (@: MixaAppFmPanel p; int: status) void
end: prototype
prototype:
    fn: mixa_app_fmpanel_hit (@: MixaAppFmPanel p; @: MixaTextRect rect; size_t: cell_row; size_t: cell_col) int
end: prototype
prototype:
    fn: mixa_app_fmpanel_wheel (@: MixaAppFmPanel p; size_t: cell_row; size_t: cell_col; int: notches) int
end: prototype
prototype:
    fn: mixa_app_fmpanel_release (@: MixaAppFmPanel p) int
end: prototype
prototype:
    fn: mixa_app_fmpanel_key (@: MixaAppFmPanel p; int: keycode) int
end: prototype

# The same "declare then link" shape as the eight fmpanel blocks above,
# for every remaining call in this file with only a real-header
# prototype and no L2-visible declaration -- the full inventory (call
# site, source header, and why each type stays a plain opaque pointer
# name) is in L2_RUNTIME_MODULE_LIST_AUDIT.txt's own 2026-09-16 class-
# of-gap note, traced empirically before landing here, not guessed.
prototype:
    fn: mixa_file_close (@: MixaFile f) void
end: prototype
prototype:
    fn: mixa_file_open (@@: MixaFile out; const: @(char path_utf8); int: mode) int
end: prototype
prototype:
    fn: mixa_app_path_join (const: @(char a); const: @(char b); const: @(MixaAppPathFaultVTable fault); @@: char out) int
end: prototype
prototype:
    fn: mixa_cmd_dispatch_start (const: @(char command_utf8); const: @(char cwd_utf8); @: MixaFile console_file; @@: MixaCmdDispatch out) int
end: prototype
prototype:
    fn: mixa_cmd_dispatch_poll (@: MixaCmdDispatch d; @: int out_exit_code; @@: char out_new_cwd) int
end: prototype
prototype:
    fn: mixa_cmd_dispatch_running (const: @(MixaCmdDispatch d)) int
end: prototype
prototype:
    fn: mixa_cmd_dispatch_release (@: MixaCmdDispatch d) void
end: prototype
prototype:
    fn: mixa_cmdline_init (@: MixaCmdLine cl) void
end: prototype
prototype:
    fn: mixa_cmdline_release (@: MixaCmdLine cl) void
end: prototype
prototype:
    fn: mixa_cmdline_insert (@: MixaCmdLine cl; const: @(MixaCmdLineFaultVTable fault); unsigned: codepoint) int
end: prototype
prototype:
    fn: mixa_cmdline_backspace (@: MixaCmdLine cl) void
end: prototype
prototype:
    fn: mixa_cmdline_delete_forward (@: MixaCmdLine cl) void
end: prototype
prototype:
    fn: mixa_cmdline_move_left (@: MixaCmdLine cl) void
end: prototype
prototype:
    fn: mixa_cmdline_move_right (@: MixaCmdLine cl) void
end: prototype
prototype:
    fn: mixa_cmdline_move_home (@: MixaCmdLine cl) void
end: prototype
prototype:
    fn: mixa_cmdline_move_end (@: MixaCmdLine cl) void
end: prototype
prototype:
    fn: mixa_cmdline_extract_to_cursor_utf8 (const: @(MixaCmdLine cl); const: @(MixaCmdLineFaultVTable fault); @@: char out) int
end: prototype
prototype:
    fn: mixa_cmdline_clear (@: MixaCmdLine cl) void
end: prototype
prototype:
    fn: mixa_help_key_event (@: MixaHelpCtx ctx; const: @(MixaEvent ev)) int
end: prototype
prototype:
    fn: mixa_help_hit (@: MixaHelpCtx ctx; size_t: cell_row; size_t: cell_col; size_t: btn_row; size_t: btn_col; size_t: btn_nrows; size_t: btn_ncols) int
end: prototype

define: MIXA_APP_CONTROLLER_OK 0
define: MIXA_APP_CONTROLLER_ERR_ARG 1
define: MIXA_APP_CONTROLLER_ERR_OPEN 2

struct: MixaAppController
    @: char root
    @: MixaAppLoop loop
    @: MixaCellMetrics m
    @: MixaEvent ev
    @: MixaFmAllocVTable av
    const: @: MixaBackendVTable vt
    @: char console_path
    @: MixaFile console_file
    @: MixaFile console_file_append
    @: MixaConsoleView view
    @: MixaTextRect text_rect
    @: MixaTextRect upper_rect
    @: MixaU8 rgba
    size_t: width_px
    size_t: height_px
    size_t: rgba_size
    @: MixaHelpCtx help_ctx
    size_t: help_btn_row
    size_t: help_btn_col
    size_t: help_btn_nrows
    size_t: help_btn_ncols
    @: MixaCmdLine cmdline
    @: MixaCmdDispatch dispatch
    @: char cwd_owned
    const: @: char cwd_cur
    @: MixaConsolePending pending_view
    int: last_exit_code
    @: MixaAppFmPanel fmpanel
    @: MixaCopySink copy_sink
end: MixaAppController
