predef: "mixa_manager/mixa_file_manager.h.lm1"
include: "<stddef.h>"

# Header unit for the clean L2 port of mixa_file_manager (dependency-
# order continuation after mixa_fileio_win32, the last module in the
# standing dependency-order list). Predefs the REAL, unmodified mixa_
# file_manager.h.lm1 directly -- mirrors the real oracle's own single
# predef line exactly. Gives real MixaFm/MixaFmEntry/MixaFmAllocVTable/
# MixaFmAllocFn/MixaFmFreeFn plus every mixa_fm_*'s own real prototype,
# and, transitively via its own predef of mixa_dir.h.lm1, real MixaDir/
# MixaDirEntry plus mixa_dir_list_open/_next/_close/_stat's own real
# prototypes. MixaSelection itself is real plain C (mixa_selection.h,
# included directly by the real header, not predef'd) -- this module's
# own real body dereferences sel via mixa_selection_select/deselect/
# query calls only (never a direct field access of its own), so no
# structural knowledge of MixaSelection is needed here at all. Total
# distinct predef'd files: mixa_file_manager.h.lm1, mixa_dir.h.lm1 --
# 2, nowhere near the pinned baseline's measured 16-file import-table
# cap.
#
# Stage A (bare-name resolution, lingvamyxa-d6's own candidate): a bare
# call resolves only against this unit's own methods or a prototype:
# declaration in a predef'd .h.lm1. mixa_dir_list_*/mixa_dir_entry_*
# already resolve via mixa_dir.h.lm1's own prototype: block (predef'd
# transitively, see above). mixa_selection_select/_deselect/_query are
# real LMX functions (mixa_selection.lm1), not C -- no .h.lm1
# counterpart exists for mixa_selection (mixa_selection.h is real,
# plain, hand-written C, included directly by the real header), so
# their signatures are declared here instead.

prototype:
    fn: mixa_selection_select (@: MixaSelection sel; const: @(char path)) int
    fn: mixa_selection_deselect (@: MixaSelection sel; const: @(char path)) int
    fn: mixa_selection_query (@: MixaSelection sel; const: @(char path)) int
end: prototype
