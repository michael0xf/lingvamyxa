							dir=
							<dirBody>
								<dirs>
									C:\
									D:\
									E:\
									I:\
								</dirs>
							</dirBody>
						</dir2>
					</mirror>
					<sort dir_D:\="" abcComparator="" dir_C:\="" dir_I:\="" method="defSort" src="@dirBody" 0="C:\" size="" dir_E:\="" 2="E:\" 1="D:\" 3="I:\">
						<items lastIndex="" firstIndex="" font="@bigFont" scrollerW="" startY="" itemsHeight="" selBar="" w="" defBar="" selectedIndex="" size="">
							<item.0 itemHeight="" color="" backColor="" space="" font="" number="0" text="$0" method="item" itemDY="" d="" itemWidth=""/>
							<item.1 itemHeight="" space="" font="" number="1" text="$1" method="item" itemDY="" d="" itemWidth=""/>
							<item.2 itemHeight="" space="" font="" number="2" text="$2" method="item" itemDY="" d="" itemWidth=""/>
							<item.3 itemHeight="" space="" font="" number="3" text="$3" method="item" itemDY="" d="" itemWidth=""/>
						</items>
					</sort>
					@items
					<call target="@items" name="showPlayer"/>
					<call target="@items" name="calcMenu"/>
					<lighter target="@selectedItem" switch="$selected" method="If">
						<true method="run">
							<add name="color" value="@activeSelColor"/>
							<add name="backColor" value="@activeSelBackColor"/>
						</true>
						<false method="run">
							<add name="color" value="@selColor"/>
							<add name="backColor" value="@selBackColor"/>
						</false>
					</lighter>
					<paint target="@items" method="run">
						bar
						paintMenu
						paintScroller
					</paint>
					<set target="$template" name="oftenRepaint" value="false"/>
					<select target="$template" method="run">
						<add name="selected" value="true"/>
						<add name="color" value="@activeColor"/>
						<add name="backColor" value="@activeBackColor"/>
						@lighter
						<keys4 method="addKeyListener" keys="Left">
							@unselect
							$prevPanel#select
						</keys4>
						<keys0 method="addKeyListener" keys="Right">
							@unselect
							$nextPanel#select
						</keys0>
						<keys1 target="@selectedItem" method="addKeyListener" keys="Down">
							<remove name="color"/>
							<remove name="backColor"/>
							<increase var="@selectedIndex"/>
							<run target="@items">
								<clearChildren>
									itemHeight
									font
								</clearChildren>
								calcMenu
							</run>
							<add name="color" value="@activeSelColor"/>
							<add name="backColor" value="@activeSelBackColor"/>
							@paint
						</keys1>
						<keys2 target="@selectedItem" method="addKeyListener" keys="Up">
							<remove name="color"/>
							<remove name="backColor"/>
							<decrease var="@selectedIndex"/>
							<run target="@items">
								<clearChildren>
									itemHeight
									font
								</clearChildren>
								calcMenu
							</run>
							<add name="color" value="@activeSelColor"/>
							<add name="backColor" value="@activeSelBackColor"/>
							@paint
						</keys2>
						<keys3 target="@selectedItem" method="addKeyListener" keys="Enter,Space">
							enter
						</keys3>
						<keys4 method="addKeyListener" keys="Escape">
							escape
						</keys4>
						@paint
					</select>
					<repaint method="run">
						<run target="@items">
							<clearChildren>
								itemHeight
								font
							</clearChildren>
							calcMenu
						</run>
						@paint
					</repaint>
					<unselect target="$template" method="run">
						<add name="selected" value="false"/>
						<add name="color" value="@defColor"/>
						<add name="backColor" value="@defBackColor"/>
						@lighter
						<removeKeyListener listener="@keys0"/>
						<removeKeyListener listener="@keys1"/>
						<removeKeyListener listener="@keys2"/>
						@paint
					</unselect>
				</template>
			</init>
		</thirdPanel>
	</mainScreen>
	<mp3 playing="true">
		<init method="run">
			@select
			@read
			<addKeyListener eventListener="" target="@items" keys="nextSong">
				nextSong
			</addKeyListener>
		</init>
