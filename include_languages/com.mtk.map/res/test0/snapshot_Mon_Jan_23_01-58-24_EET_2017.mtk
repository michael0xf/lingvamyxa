<root panelHeight="" blue="" darkGray="" panelWidth="" thirdX="" screenHeight="" bigFont="" darkBlue="" nodeName="ScreenThread" cyan="" rightX="" screenWidth="">
	<autoRun method="run">
		@mainScreen#run
		@mp3#init
	</autoRun>
	<mainScreen activeSelBackColor="@cyan" activeBackColor="@blue" selColor="@cyan" defColor="@cyan" defBackColor="@darkGray" activeColor="@cyan" selBackColor="@darkBlue" activeSelColor="@blue">
		<run>
			@leftPanel#init
			@leftPanel#select
			@rightPanel#init
			@rightPanel#unselect
			@thirdPanel#init
			@thirdPanel#unselect
			<addKeyListener eventListener="" target="@mainScreen" keys="nextSong">
				nextSong
			</addKeyListener>
			<addKeyListener eventListener="" target="@items" keys="Repaint">
				@rightPanel@repaint
				@leftPanel@repaint
				@thirdPanel@repaint
			</addKeyListener>
			<addKeyListener eventListener="" keys="Resize">
				<clearAllChildren>
					screenWidth
					screenHeight
					borderWide
					font
					w
					h
					x
					y
					rightX
					panelHeight
					panelWidth
					itemHeight
					painter
				</clearAllChildren>
				<run target="@leftPanel@items">
					insertScroller
					calcMenu
					@leftPanel@paint
				</run>
				<run target="@rightPanel@items">
					insertScroller
					calcMenu
					@rightPanel@paint
				</run>
				<run target="@thirdPanel@items">
					insertScroller
					calcMenu
					@thirdPanel@paint
				</run>
			</addKeyListener>
			<call target="@leftPanel#items" name="enter"/>
			<call target="@rightPanel#items" name="enter"/>
			<call target="@thirdPanel#items" name="enter"/>
		</run>
		x=
		y=
		w=@panelWidth
		h=@panelHeight
		<leftPanel>
			parentDir=E:\music/aria
			nextPanel=@rightPanel
			prevPanel=@thirdPanel
			<template color="" backColor="" selected="true">
				borderWide=
				font=
				graphics=
				<init target="@items" method="run">
					insertScroller
					@items
					calcMenu
				</init>
				<reRead method="run">
					<step0 method="run">
						@clearBody
						@linkToDir
						@mirror
						@sort
						@items
					</step0>
					<step1 target="@items" method="run">
						showPlayer
						calcMenu
						@lighter
						@paint
					</step1>
				</reRead>
				<add target="$template" name="oftenRepaint" value="true"/>
				<clearBody>
					@items
				</clearBody>
				<linkToDirlinkToDir=dir3 dir="$parentDir"/>
				<mirror src="@linkToDir" sourceThread="FileThread">
