								@rightPanel#unselect
							</test>
							@thirdPanel#init
						</test:0>
					</second>
					@thirdPanel#unselect
				</test>
				<addKeyListener eventListener="" keys="nextSong" target="@mainScreen">
					nextSong
				</addKeyListener>
				<addKeyListener eventListener="" keys="Repaint" target="@items">
					@rightPanel@repaint
					@leftPanel@repaint
					@thirdPanel@repaint
