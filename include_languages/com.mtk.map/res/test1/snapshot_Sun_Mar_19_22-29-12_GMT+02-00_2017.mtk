<root bigFont="" rightX="" darkBlue="" screenHeight="" darkGray="" panelWidth="" panelHeight="" nodeName="ScreenThread" screenWidth="" blue="" cyan="" thirdX="" endOfSong="E:\music/aria/01-Aria (Duetto- Soprano, Tenore)- Ich lebe, mein Herze.mp3" currentSongPlayPath="E:\music/aria/01-Aria (Soprano)- Bereit die Wege, bereit die Bahn!.mp3">
	<root thread="ScreenThread">
