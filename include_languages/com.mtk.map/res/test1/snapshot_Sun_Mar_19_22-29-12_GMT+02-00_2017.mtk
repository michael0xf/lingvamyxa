						insertScroller
						@rightPanel@repaint
					</run>
					<run target="@thirdPanel@items">
						insertScroller
						@thirdPanel@repaint
					</run>
				</addKeyListener>
				<call name="enter" target="@leftPanel#items"/>
				<call name="enter" target="@rightPanel#items"/>
				<call name="enter" target="@thirdPanel#items"/>
			</run>
