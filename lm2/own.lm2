        size_t: index
        size_t: keep

        if: arena = 0 || c.lm_lmx_message_thread = 0 || arena\owner_thread != c.lm_lmx_message_thread || arena\frozen
            return: 1
        if: arena\allocations = 0 || arena\allocation_descriptors = 0
            return: 1
        if: lm_own_arena_promote_lazy_edges(arena) != 0
            return: 1

