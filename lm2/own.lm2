    fn: lm_message_thread_arena_count (const: (LmMessageThread: thread)) size_t
        size_t: result

        if: thread = 0 || c.lm_native_message_thread_state_lock(thread) != 0
            return: 0U
        result: thread\arena_count
        c.lm_native_message_thread_state_unlock(thread)
    return: result
end: external

external:
    sub: lm_message_thread_request_stop (LmMessageThread: thread; int: status)
        LmMessageThreadPool: pool

        if: thread = 0
            return
        pool: thread\pool
        if: pool != 0
            if: lm_mutex_lock(pool\mutex) != 0
                return
            if: pool\deleting || c.lm_native_message_thread_control_allowed_locked(pool, thread) = 0
                lm_mutex_unlock(pool\mutex)
                return
        ---
        if: pool = 0 && thread\runtime != 0
            if: thread\runtime\root_thread != thread || c.lm_native_thread_identity_is_current(thread\runtime\identity) = 0
                return
        ---
        if: c.lm_native_message_thread_state_lock(thread) = 0
            if: thread\state = c.LM_MESSAGE_THREAD_RUNNING
                thread\stop_status: status
                thread\state: c.LM_MESSAGE_THREAD_STOPPING
                if: pool != 0
                    c.lm_native_message_thread_schedule_stop_locked(pool, thread)
                ---
            if: thread\state = c.LM_MESSAGE_THREAD_NEW
                thread\stop_status: status
                thread\state: c.LM_MESSAGE_THREAD_STOPPED
                if: thread\stopped_condition != 0
                    lm_condition_broadcast(thread\stopped_condition)
            ---
            c.lm_native_message_thread_state_unlock(thread)
        if: pool != 0
            lm_mutex_unlock(pool\mutex)
    end: lm_message_thread_request_stop
end: external

external:
    sub: lm_message_thread_request_failure (LmMessageThread: thread; int: status)
        LmMessageThreadPool: pool

        if: status = 0
            status: 1
        if: thread = 0
            return
        pool: thread\pool
        if: pool != 0
            if: lm_mutex_lock(pool\mutex) != 0
                return
            if: pool\deleting || c.lm_native_message_thread_control_allowed_locked(pool, thread) = 0
                lm_mutex_unlock(pool\mutex)
                return
        ---
        if: pool = 0 && thread\runtime != 0
            if: thread\runtime\root_thread != thread || c.lm_native_thread_identity_is_current(thread\runtime\identity) = 0
                return
        ---
        if: c.lm_native_message_thread_state_lock(thread) = 0
            thread\turn_failed: 1
            if: thread\state = c.LM_MESSAGE_THREAD_RUNNING || thread\state = c.LM_MESSAGE_THREAD_STOPPING
                thread\stop_status: status
                thread\state: c.LM_MESSAGE_THREAD_STOPPING
                if: pool != 0
                    c.lm_native_message_thread_schedule_stop_locked(pool, thread)
                ---
            c.lm_native_message_thread_state_unlock(thread)
        if: pool != 0
            lm_mutex_unlock(pool\mutex)
    end: lm_message_thread_request_failure
end: external

external:
    fn: lm_message_thread_collect (LmMessageThread: thread) int
        if: thread = 0 || thread\pool != 0
            return: 1

        if: c.lm_native_message_thread_state_lock(thread) != 0
            return: 1
        thread\collection_count: thread\collection_count + 1U
        c.lm_native_message_thread_state_unlock(thread)
        if: thread\root_owner = 0 || thread\root_owner\owner_thread != thread || thread\arena_head != thread\root_owner || thread\root_owner\registry_previous != 0 || thread\arena_tail = 0 || thread\arena_tail\registry_next != 0 || thread\arena_count = 0U
            if: c.lm_native_message_thread_state_lock(thread) = 0
                thread\collector_failed: 1
                c.lm_native_message_thread_state_unlock(thread)
            lm_message_thread_request_failure(thread, 1)
            return: 1
        if: c.lm_own_tree_cut(thread, thread\root_owner) != 0
            if: c.lm_native_message_thread_state_lock(thread) = 0
                thread\collector_failed: 1
                c.lm_native_message_thread_state_unlock(thread)
            lm_message_thread_request_failure(thread, 1)
            return: 1
    return: 0
end: external

external:
    fn: lm_message_thread_begin_turn (LmMessageThread: thread) int
        if: thread = 0 || thread\pool != 0
            return: 0
        if: thread\runtime != 0 && (thread\runtime\root_thread != thread || c.lm_native_thread_identity_is_current(thread\runtime\identity) = 0)
            return: 0
        if: c.lm_native_message_thread_state_lock(thread) != 0
            return: 0
        if: thread\state != c.LM_MESSAGE_THREAD_RUNNING || thread\turn_active
            c.lm_native_message_thread_state_unlock(thread)
            return: 0
        thread\turn_active: 1
        thread\turn_failed: 0
        thread\turn_count: thread\turn_count + 1U
        c.lm_native_message_thread_state_unlock(thread)
    return: 1
end: external

external:
    fn: lm_message_thread_end_turn (LmMessageThread: thread) int
        int: status
        int: collect_status
        int: failed_status

        if: thread = 0 || thread\pool != 0
            return: 1
        if: thread\runtime != 0 && (thread\runtime\root_thread != thread || c.lm_native_thread_identity_is_current(thread\runtime\identity) = 0)
            return: 1
        if: c.lm_native_message_thread_state_lock(thread) != 0
            return: 1
        if: thread\turn_active = 0
            c.lm_native_message_thread_state_unlock(thread)
            return: 1
        failed_status: 0
        if: thread\turn_failed
            failed_status: thread\stop_status
            if: failed_status = 0
                failed_status: 1
        ---
        c.lm_native_message_thread_state_unlock(thread)

        status: c.lm_native_message_thread_outbox_finish(thread, failed_status = 0)
        collect_status: lm_message_thread_collect(thread)
        if: status = 0 && collect_status != 0
            status: collect_status
        if: status = 0 && failed_status != 0
            status: failed_status
        if: c.lm_native_message_thread_state_lock(thread) != 0
            return: 1
        thread\turn_active: 0
        if: thread\state = c.LM_MESSAGE_THREAD_STOPPING
            thread\state: c.LM_MESSAGE_THREAD_STOPPED
        if: thread\state = c.LM_MESSAGE_THREAD_STOPPED && thread\stopped_condition != 0
            lm_condition_broadcast(thread\stopped_condition)
        c.lm_native_message_thread_state_unlock(thread)
    return: status
end: external
