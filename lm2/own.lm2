            target\lazy_edges\items: items
            target\lazy_edges\capacity: capacity
            c.memcpy(target\lazy_edges\items + lazy_base, source\lazy_edges\items, source\lazy_edges\count * c.sizeof(source\lazy_edges\items[0]))
            target\lazy_edges\count: lazy_new_count
