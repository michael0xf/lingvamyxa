            items: c.realloc(target\allocations\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            target\allocations\items: items
            target\allocations\capacity: capacity
            c.memcpy(target\allocations\items + target\allocations\count, source\allocations\items, source\allocations\count * c.sizeof(source\allocations\items[0]))
            target\allocations\count: new_count

            c.free(source\allocations\items)
