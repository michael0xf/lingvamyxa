            return: 0
        result: thread\execution_context
        c.lm_native_message_thread_state_unlock(thread)
    return: result
end: external

external:
    fn: lm_message_thread_set_execution_context (LmMessageThread: thread; @: void context) @: void
        @: void previous

        if: thread = 0 || c.lm_native_message_thread_state_lock(thread) != 0
            return: 0
        previous: thread\execution_context
        thread\execution_context: context
        c.lm_native_message_thread_state_unlock(thread)
    return: previous
end: external

external:
    fn: lm_message_thread_turn_count (const: (LmMessageThread: thread)) size_t
        size_t: result

        if: thread = 0 || c.lm_native_message_thread_state_lock(thread) != 0
            return: 0U
        result: thread\turn_count
        c.lm_native_message_thread_state_unlock(thread)
    return: result
end: external

external:
    fn: lm_message_thread_collection_count (const: (LmMessageThread: thread)) size_t
        size_t: result

        if: thread = 0 || c.lm_native_message_thread_state_lock(thread) != 0
            return: 0U
        result: thread\collection_count
        c.lm_native_message_thread_state_unlock(thread)
