external:
    fn: lm_own_value_stack_push (LmOwnValueStack: stack; const: @(void item)) int
        @: uchar items
        @: uchar target
        size_t: capacity

        if: stack = 0 || item = 0 || stack\item_size = 0U
            return: 1

        if: stack\count = stack\capacity
            if: stack\capacity = 0U
                capacity: 8U
            if: stack\capacity != 0U
                capacity: stack\capacity * 2U
            ---
            items: cast: (@: uchar) c.realloc(stack\items, capacity * stack\item_size)
            if: items = 0
                return: 1
            stack\items: cast: (@: void) items
            stack\capacity: capacity

        target: (cast: (@: uchar) stack\items) + stack\count * stack\item_size
        c.memcpy(target, item, stack\item_size)
        stack\count: stack\count + 1U
    return: 0
end: external

external:
    fn: lm_own_value_stack_resize_zero (LmOwnValueStack: stack; size_t: count) int
        @: uchar items
        @: uchar target
        size_t: capacity
        size_t: previous_count

