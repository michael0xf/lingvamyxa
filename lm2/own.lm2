external:
    fn: lm_own_arena_is_frozen (const: (LmOwnArena: arena)) int
    return: arena != 0 && c.lm_lmx_message_thread != 0 && arena\owner_thread = c.lm_lmx_message_thread && arena\frozen
end: external

external:
    fn: lm_own_arena_owner_thread (const: (LmOwnArena: arena)) LmMessageThread
        if: arena = 0 || c.lm_lmx_message_thread = 0 || arena\owner_thread != c.lm_lmx_message_thread
