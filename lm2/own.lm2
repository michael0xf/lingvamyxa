external:
    fn: lm_own_value_stack_push (LmOwnValueStack: stack; const: @(void item)) int
        @: uchar items
        @: uchar target
        size_t: capacity

        if: stack = 0 || item = 0 || stack\item_size = 0U
            return: 1

        if: stack\count = stack\capacity
            if: stack\capacity = 0U
                capacity: 8U
            if: stack\capacity != 0U
                capacity: stack\capacity * 2U
            ---
            items: cast: (@: uchar) c.realloc(stack\items, capacity * stack\item_size)
            if: items = 0
                return: 1
            stack\items: cast: (@: void) items
            stack\capacity: capacity

        target: (cast: (@: uchar) stack\items) + stack\count * stack\item_size
        c.memcpy(target, item, stack\item_size)
        stack\count: stack\count + 1U
    return: 0
end: external

external:
    fn: lm_own_value_stack_resize_zero (LmOwnValueStack: stack; size_t: count) int
        @: uchar items
        @: uchar target
        size_t: capacity
        size_t: previous_count

        if: stack = 0 || stack\item_size = 0U
            return: 1

        if: count > stack\capacity
            if: stack\capacity = 0U
                capacity: 8U
            if: stack\capacity != 0U
                capacity: stack\capacity
            ---
            while: capacity < count
                capacity: capacity * 2U
            ---
            items: cast: (@: uchar) c.realloc(stack\items, capacity * stack\item_size)
            if: items = 0
                return: 1
            stack\items: cast: (@: void) items
            stack\capacity: capacity

        previous_count: stack\count
        if: count > previous_count
            target: (cast: (@: uchar) stack\items) + previous_count * stack\item_size
            c.memset(target, 0, (count - previous_count) * stack\item_size)
        stack\count: count
    return: 0
end: external

external:
    fn: lm_own_value_stack_pop (LmOwnValueStack: stack; @: void out_item) int
        @: uchar source

        if: stack = 0 || stack\count = 0U || stack\item_size = 0U
            return: 1

        stack\count: stack\count - 1U
        source: (cast: (@: uchar) stack\items) + stack\count * stack\item_size
        if: out_item != 0
            c.memcpy(out_item, source, stack\item_size)
    return: 0
end: external

external:
    fn: lm_own_value_stack_at (const: (LmOwnValueStack: stack); size_t: index) @: void
        @: uchar item

        if: stack = 0 || index >= stack\count || stack\item_size = 0U
            return: 0

        item: (cast: (@: uchar) stack\items) + index * stack\item_size
    return: item
end: external

external:
    fn: lm_own_value_stack_top (const: (LmOwnValueStack: stack)) @: void
        @: uchar item

        if: stack = 0 || stack\count = 0U || stack\item_size = 0U
            return: 0

        item: (cast: (@: uchar) stack\items) + (stack\count - 1U) * stack\item_size
    return: item
end: external

fn: lm_own_size_multiply (size_t: left; size_t: right; @: size_t out) int
    if: out = 0
        return: 1
    if: left != 0U && right > (cast: size_t -1) / left
        return: 1
    out[0]: left * right
return: 0

fn: lm_own_allocation_descriptor_find (const: (LmOwnPtrStack: descriptors); const: @(void address)) const: LmOwnAllocationDescriptor
    const: LmOwnAllocationDescriptor: descriptor
    size_t: index

    if: descriptors = 0 || address = 0
        return: 0

    index: descriptors\count
    while: index > 0U
        index: index - 1U
        descriptor: lm_own_ptr_stack_at(descriptors, index)
        if: descriptor != 0 && descriptor\address = address
            return: descriptor
    ---

return: 0

fn: lm_own_allocation_descriptor_push (LmOwnPtrStack: descriptors; @: void address; LmOwnArena: owner; size_t: bytes; size_t: element_size; size_t: count; size_t: rank; size_t: level) int
    LmOwnAllocationDescriptor: descriptor
    int: status

    if: descriptors = 0 || address = 0
        return: 1

    descriptor: lm_own_new_zero(c.sizeof(c.LmOwnAllocationDescriptor))
    if: descriptor = 0
        return: 1
    descriptor\address: address
    descriptor\owner: owner
    descriptor\bytes: bytes
    descriptor\element_size: element_size
    descriptor\count: count
    descriptor\rank: rank
    descriptor\level: level
    status: lm_own_ptr_stack_push(descriptors, descriptor)
    if: status != 0
        lm_own_delete(descriptor, 0)
return: status

external:
    fn: lm_own_arena_new_zero (LmOwnArena: arena; size_t: size) @: void
        @: void object

        if: arena = 0 || c.lm_lmx_message_thread = 0 || arena\owner_thread != c.lm_lmx_message_thread || arena\frozen || arena\allocations = 0 || arena\allocation_descriptors = 0
            return: 0

        object: c.calloc(1U, size)
        if: object = 0
            return: 0
        if: lm_own_ptr_stack_push(arena\allocations, object) != 0
            c.free(object)
            return: 0
        if: lm_own_allocation_descriptor_push(arena\allocation_descriptors, object, arena, size, size, 1U, 0U, 0U) != 0
            lm_own_ptr_stack_pop(arena\allocations)
            c.free(object)
            return: 0
    return: object
end: external

external:
    fn: lm_own_arena_array_new_zero (LmOwnArena: arena; size_t: element_size; size_t: count; size_t: rank; size_t: level) @: void
        @: void object
        size_t: bytes

        if: arena = 0 || c.lm_lmx_message_thread = 0 || arena\owner_thread != c.lm_lmx_message_thread || arena\frozen || arena\allocations = 0 || arena\allocation_descriptors = 0
            return: 0
        if: lm_own_size_multiply(element_size, count, @ bytes) != 0
