        if: stack = 0 || stack\count = 0U || stack\item_size = 0U
            return: 1

        stack\count: stack\count - 1U
        source: (cast: (@: uchar) stack\items) + stack\count * stack\item_size
        if: out_item != 0
            c.memcpy(out_item, source, stack\item_size)
    return: 0
end: external

external:
    fn: lm_own_value_stack_at (const: (LmOwnValueStack: stack); size_t: index) @: void
        @: uchar item

        if: stack = 0 || index >= stack\count || stack\item_size = 0U
            return: 0

        item: (cast: (@: uchar) stack\items) + index * stack\item_size
    return: item
end: external

external:
    fn: lm_own_value_stack_top (const: (LmOwnValueStack: stack)) @: void
        @: uchar item

        if: stack = 0 || stack\count = 0U || stack\item_size = 0U
            return: 0

        item: (cast: (@: uchar) stack\items) + (stack\count - 1U) * stack\item_size
    return: item
end: external

fn: lm_own_size_multiply (size_t: left; size_t: right; @: size_t out) int
