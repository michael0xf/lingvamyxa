            return: 1

        if: count > stack\capacity
            if: stack\capacity = 0U
                capacity: 8U
            if: stack\capacity != 0U
                capacity: stack\capacity
            ---
            while: capacity < count
                capacity: capacity * 2U
            ---
            items: cast: (@: uchar) c.realloc(stack\items, capacity * stack\item_size)
            if: items = 0
                return: 1
            stack\items: cast: (@: void) items
            stack\capacity: capacity

        previous_count: stack\count
        if: count > previous_count
            target: (cast: (@: uchar) stack\items) + previous_count * stack\item_size
            c.memset(target, 0, (count - previous_count) * stack\item_size)
        stack\count: count
    return: 0
end: external

external:
    fn: lm_own_value_stack_pop (LmOwnValueStack: stack; @: void out_item) int
