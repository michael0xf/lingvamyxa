import: "lm4/own_abi.lm4"

L4: loadHeaders

include: "<stdlib.h>" "<string.h>"

external:
    fn: lm_own_new_zero (size_t: size) @: void
        return: c.calloc(1U, size)
    end: lm_own_new_zero
end: external

external:
    sub: lm_own_delete (@: void object; LmOwnDestroyFields: destroy_fields)
        if: object != 0
            if: destroy_fields != 0
                c.destroy_fields(object)
            c.free(object)
    end: lm_own_delete
end: external

external:
    sub: lm_own_pointer_array_delete (@@: void items; size_t: count; LmOwnDelete: delete_item)
        size_t: index

        if: items != 0
            if: delete_item != 0
                index: 0U
                while: index < count
                    if: items[index] != 0
                        c.delete_item(items[index])
                        items[index]: 0
                    ---
                    index: index + 1U
                ---
            c.free(items)
    end: lm_own_pointer_array_delete
end: external

external:
    sub: lm_own_ptr_stack_init (@: LmOwnPtrStack stack; LmOwnDelete: delete_item)
        if: stack != 0
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\delete_item: delete_item
    end: lm_own_ptr_stack_init
end: external

external:
    sub: lm_own_ptr_stack_destroy (@: LmOwnPtrStack stack)
        if: stack != 0
            lm_own_pointer_array_delete(stack\items, stack\count, stack\delete_item)
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\delete_item: 0
    end: lm_own_ptr_stack_destroy
end: external

external:
    fn: lm_own_ptr_stack_push (@: LmOwnPtrStack stack; @: void item) int
        @@: void items
        size_t: capacity

        if: stack = 0
            return: 1

        if: stack\count = stack\capacity
            if: stack\capacity = 0U
                capacity: 8U
            if: stack\capacity != 0U
                capacity: stack\capacity * 2U
            ---
            items: c.realloc(stack\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            stack\items: items
            stack\capacity: capacity

        stack\items[stack\count]: item
        stack\count: stack\count + 1U
        return: 0
    end: lm_own_ptr_stack_push
end: external

external:
    fn: lm_own_ptr_stack_pop (@: LmOwnPtrStack stack) @: void
        @: void item

        if: stack = 0 || stack\count = 0U
            return: 0

        stack\count: stack\count - 1U
        item: stack\items[stack\count]
        stack\items[stack\count]: 0
        return: item
    end: lm_own_ptr_stack_pop
end: external

external:
    fn: lm_own_ptr_stack_at (const: @(LmOwnPtrStack stack); size_t: index) @: void
        if: stack = 0 || index >= stack\count
            return: 0

        return: stack\items[index]
    end: lm_own_ptr_stack_at
end: external

external:
    fn: lm_own_ptr_stack_top (const: @(LmOwnPtrStack stack)) @: void
        if: stack = 0 || stack\count = 0U
            return: 0

        return: stack\items[stack\count - 1U]
    end: lm_own_ptr_stack_top
end: external

external:
    sub: lm_own_ptr_stack_truncate (@: LmOwnPtrStack stack; size_t: count)
        @: void item

        if: stack = 0
            return

        while: stack\count > count
            item: lm_own_ptr_stack_pop(stack)
            if: item != 0 && stack\delete_item != 0
                c.stack->delete_item(item)
    end: lm_own_ptr_stack_truncate
end: external

external:
    sub: lm_own_value_stack_init (@: LmOwnValueStack stack; size_t: item_size)
        if: stack != 0
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\item_size: item_size
    end: lm_own_value_stack_init
end: external

external:
    sub: lm_own_value_stack_destroy (@: LmOwnValueStack stack)
        if: stack != 0
            c.free(stack\items)
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\item_size: 0U
    end: lm_own_value_stack_destroy
end: external

external:
    sub: lm_own_value_stack_truncate (@: LmOwnValueStack stack; size_t: count)
        if: stack != 0 && count < stack\count
            stack\count: count
    end: lm_own_value_stack_truncate
end: external

external:
    sub: lm_own_arena_init (@: LmOwnArena arena)
        if: arena != 0
            lm_own_ptr_stack_init(c.&arena->allocations, c.free)
            lm_own_value_stack_init(c.&arena->allocation_descriptors, c.sizeof(c.LmOwnAllocationDescriptor))
            lm_own_value_stack_init(c.&arena->lazy_edges, c.sizeof(c.LmOwnLazyEdge))
            arena\frozen: 0
    end: lm_own_arena_init
end: external

external:
    sub: lm_own_arena_destroy (@: LmOwnArena arena)
        if: arena != 0
            lm_own_value_stack_destroy(c.&arena->lazy_edges)
            lm_own_value_stack_destroy(c.&arena->allocation_descriptors)
            lm_own_ptr_stack_destroy(c.&arena->allocations)
            arena\frozen: 0
    end: lm_own_arena_destroy
end: external

external:
    sub: lm_own_arena_freeze (@: LmOwnArena arena)
        if: arena != 0
            arena\frozen: 1
    end: lm_own_arena_freeze
end: external

external:
    fn: lm_own_arena_is_frozen (const: @(LmOwnArena arena)) int
        return: arena != 0 && arena\frozen
    end: lm_own_arena_is_frozen
end: external

external:
    fn: lm_own_tree_cut (@: LmOwnArena arena) int
        return: lm_own_tree_cut_promote_lazy_edges(arena)
    end: lm_own_tree_cut
end: external

external:
    fn: lm_own_tree_cut_promote_lazy_edges (@: LmOwnArena arena) int
        return: c.lm_own_arena_promote_lazy_edges(arena)
    end: lm_own_tree_cut_promote_lazy_edges
end: external

fn: lm_own_allocation_descriptor_push (@: LmOwnValueStack descriptors; @: void address; @: LmOwnArena owner; size_t: bytes; size_t: element_size; size_t: count; size_t: rank; size_t: level) int
    LmOwnAllocationDescriptor: descriptor

    if: descriptors = 0 || address = 0
        return: 1

    c.descriptor.address: address
    c.descriptor.owner: owner
    c.descriptor.bytes: bytes
    c.descriptor.element_size: element_size
    c.descriptor.count: count
    c.descriptor.rank: rank
    c.descriptor.level: level
    return: c.lm_own_value_stack_push(descriptors, @ descriptor)
end: lm_own_allocation_descriptor_push

external:
    fn: lm_own_array_new_zero (size_t: element_size; size_t: count; size_t: rank; size_t: level) @: void
        @: void object
        size_t: bytes

        if: c.lm_own_size_multiply(element_size, count, @ bytes) != 0
            return: 0
        if: bytes = 0U
            return: 0
        if: c.lm_own_global_allocation_descriptors_init() != 0
            return: 0

        object: c.calloc(1U, bytes)
        if: object = 0
            return: 0
        if: c.lm_own_allocation_descriptor_push(c.&lm_own_global_allocation_descriptors, object, 0, bytes, element_size, count, rank, level) != 0
            c.free(object)
            return: 0

        return: object
    end: lm_own_array_new_zero
end: external

external:
    fn: lm_own_allocation_descriptor (const: @(void address)) const: @: LmOwnAllocationDescriptor
        if: c.lm_own_global_allocation_descriptors_ready = 0
            return: 0
        return: c.lm_own_allocation_descriptor_find(c.&lm_own_global_allocation_descriptors, address)
    end: lm_own_allocation_descriptor
end: external

external:
    fn: lm_own_arena_new_zero (@: LmOwnArena arena; size_t: size) @: void
        @: void object

        if: arena = 0 || arena\frozen
            return: 0

        object: c.calloc(1U, size)
        if: object = 0
            return: 0
        if: c.lm_own_ptr_stack_push(c.&arena->allocations, object) != 0
            c.free(object)
            return: 0
        if: c.lm_own_allocation_descriptor_push(c.&arena->allocation_descriptors, object, arena, size, size, 1U, 0U, 0U) != 0
            c.lm_own_ptr_stack_pop(c.&arena->allocations)
            c.free(object)
            return: 0
        return: object
    end: lm_own_arena_new_zero
end: external

external:
    fn: lm_own_arena_array_new_zero (@: LmOwnArena arena; size_t: element_size; size_t: count; size_t: rank; size_t: level) @: void
        @: void object
        size_t: bytes

        if: arena = 0 || arena\frozen
            return: 0
        if: c.lm_own_size_multiply(element_size, count, @ bytes) != 0
            return: 0
        if: bytes = 0U
            return: 0

        object: c.calloc(1U, bytes)
        if: object = 0
            return: 0
        if: c.lm_own_ptr_stack_push(c.&arena->allocations, object) != 0
            c.free(object)
            return: 0
        if: c.lm_own_allocation_descriptor_push(c.&arena->allocation_descriptors, object, arena, bytes, element_size, count, rank, level) != 0
            c.lm_own_ptr_stack_pop(c.&arena->allocations)
            c.free(object)
            return: 0

        return: object
    end: lm_own_arena_array_new_zero
end: external

external:
    fn: lm_own_arena_allocation_descriptor (const: @(LmOwnArena arena); const: @(void address)) const: @: LmOwnAllocationDescriptor
        if: arena = 0
            return: 0
        return: c.lm_own_allocation_descriptor_find(c.&arena->allocation_descriptors, address)
    end: lm_own_arena_allocation_descriptor
end: external

external:
    fn: lm_own_arena_copy_bytes (@: LmOwnArena arena; const: @(char source); size_t: length) @: char
        @: char copy

        copy: c.lm_own_arena_new_zero(arena, length + 1U)
        if: copy = 0
            return: 0
        if: source != 0 && length > 0U
            c.memcpy(copy, source, length)
        copy[length]: '\0'
        return: copy
    end: lm_own_arena_copy_bytes
end: external

external:
    fn: lm_own_arena_add_lazy_edge (@: LmOwnArena target; @: LmOwnArena source; const: @(void source_ptr); size_t: size; const: @@(void patch_slot)) int
        LmOwnLazyEdge: edge

        if: target = 0 || source = 0 || patch_slot = 0 || target\frozen
            return: 1
        if: size = 0U
            return: 0
        if: source_ptr = 0
            return: 1

        c.edge.kind: c.LM_OWN_EDGE_LAZY_OWNED
        c.edge.source_owner: source
        c.edge.target_owner: target
        c.edge.source: source_ptr
        c.edge.size: size
        c.edge.patch_slot: patch_slot
        return: c.lm_own_value_stack_push(c.&target->lazy_edges, @ edge)
    end: lm_own_arena_add_lazy_edge
end: external

external:
    fn: lm_own_arena_promote_lazy_edges (@: LmOwnArena arena) int
        @: LmOwnLazyEdge edge
        @: void copy
        size_t: i

        if: arena = 0 || arena\frozen
            return: 1

        i: 0U
        while: i < c.arena->lazy_edges.count
            edge: c.lm_own_value_stack_at(c.&arena->lazy_edges, i)
            if: edge = 0 || edge\kind != c.LM_OWN_EDGE_LAZY_OWNED
                i: i + 1U
                continue
            if: edge\patch_slot = 0 || edge\source = 0 || edge\size = 0U
                return: 1

            copy: c.lm_own_arena_new_zero(arena, edge\size + 1U)
            if: copy = 0
                return: 1
            c.memcpy(copy, edge\source, edge\size)
            edge\patch_slot[0]: copy
            edge\source: copy
            edge\source_owner: arena
            edge\target_owner: arena
            edge\kind: c.LM_OWN_EDGE_OWNED
            i: i + 1U

        return: 0
    end: lm_own_arena_promote_lazy_edges
end: external

external:
    fn: lm_own_arena_absorb (@: LmOwnArena target; @: LmOwnArena source) int
        @@: void items
        @: LmOwnAllocationDescriptor source_descriptors
        @: LmOwnAllocationDescriptor target_descriptors
        size_t: descriptor_base
        size_t: descriptor_new_count
        size_t: new_count
        size_t: capacity
        size_t: lazy_base
        size_t: lazy_new_count
        size_t: i
        @: LmOwnLazyEdge edge
        @: LmOwnLazyEdge target_edges

        if: target = 0 || source = 0 || target\frozen
            return: 1
        if: source = target
            return: 0

        lazy_base: c.target->lazy_edges.count
        lazy_new_count: lazy_base + c.source->lazy_edges.count
        if: c.source->lazy_edges.count > 0U
            if: c.lm_own_value_stack_resize_zero(c.&target->lazy_edges, lazy_new_count) != 0
                return: 1
            c.target->lazy_edges.count: lazy_base

        if: c.source->allocations.count > 0U
            new_count: c.target->allocations.count + c.source->allocations.count
            if: c.target->allocations.capacity = 0U
                capacity: 8U
            if: c.target->allocations.capacity != 0U
                capacity: c.target->allocations.capacity
            while: capacity < new_count
                capacity: capacity * 2U
            items: c.realloc(c.target->allocations.items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            c.target->allocations.items: items
            c.target->allocations.capacity: capacity
            c.memcpy(c.target->allocations.items + c.target->allocations.count, c.source->allocations.items, c.source->allocations.count * c.sizeof(c.source->allocations.items[0]))
            c.target->allocations.count: new_count

            c.free(c.source->allocations.items)
            c.source->allocations.items: 0
            c.source->allocations.count: 0U
            c.source->allocations.capacity: 0U

        descriptor_base: c.target->allocation_descriptors.count
        descriptor_new_count: descriptor_base + c.source->allocation_descriptors.count
        if: c.source->allocation_descriptors.count > 0U
            if: c.lm_own_value_stack_resize_zero(c.&target->allocation_descriptors, descriptor_new_count) != 0
                return: 1
            target_descriptors: c.target->allocation_descriptors.items
            source_descriptors: c.source->allocation_descriptors.items
            c.memcpy(target_descriptors + descriptor_base, source_descriptors, c.source->allocation_descriptors.count * c.sizeof(target_descriptors[0]))
            c.target->allocation_descriptors.count: descriptor_new_count
            i: descriptor_base
            while: i < c.target->allocation_descriptors.count
                if: c.target_descriptors[i].owner = source
                    c.target_descriptors[i].owner: target
                i: i + 1U
            c.source->allocation_descriptors.count: 0U

        if: c.source->lazy_edges.count > 0U
            target_edges: c.target->lazy_edges.items
            c.memcpy(target_edges + lazy_base, c.source->lazy_edges.items, c.source->lazy_edges.count * c.sizeof(target_edges[0]))
            c.target->lazy_edges.count: lazy_new_count
            i: lazy_base
            while: i < c.target->lazy_edges.count
                edge: c.lm_own_value_stack_at(c.&target->lazy_edges, i)
                if: edge != 0 && edge\target_owner = source
                    edge\target_owner: target
                i: i + 1U
            c.source->lazy_edges.count: 0U

        return: 0
    end: lm_own_arena_absorb
end: external

L1:
===
int lm_own_value_stack_push(LmOwnValueStack *stack, const void *item) {
    unsigned char *items;
    size_t capacity;

    if (stack == 0 || item == 0 || stack->item_size == 0U) {
        return 1;
    }

    if (stack->count == stack->capacity) {
        capacity = stack->capacity == 0U ? 8U : stack->capacity * 2U;
        items = (unsigned char *)realloc(stack->items, capacity * stack->item_size);
        if (items == 0) {
            return 1;
        }
        stack->items = items;
        stack->capacity = capacity;
    }

    memcpy((unsigned char *)stack->items + stack->count * stack->item_size, item, stack->item_size);
    ++stack->count;
    return 0;
}

int lm_own_value_stack_resize_zero(LmOwnValueStack *stack, size_t count) {
    unsigned char *items;
    size_t capacity;
    size_t previous_count;

    if (stack == 0 || stack->item_size == 0U) {
        return 1;
    }

    if (count > stack->capacity) {
        capacity = stack->capacity == 0U ? 8U : stack->capacity;
        while (capacity < count) {
            capacity *= 2U;
        }
        items = (unsigned char *)realloc(stack->items, capacity * stack->item_size);
        if (items == 0) {
            return 1;
        }
        stack->items = items;
        stack->capacity = capacity;
    }

    previous_count = stack->count;
    if (count > previous_count) {
        memset(
            (unsigned char *)stack->items + previous_count * stack->item_size,
            0,
            (count - previous_count) * stack->item_size
        );
    }
    stack->count = count;
    return 0;
}

int lm_own_value_stack_pop(LmOwnValueStack *stack, void *out_item) {
    unsigned char *source;

    if (stack == 0 || stack->count == 0U || stack->item_size == 0U) {
        return 1;
    }

    --stack->count;
    source = (unsigned char *)stack->items + stack->count * stack->item_size;
    if (out_item != 0) {
        memcpy(out_item, source, stack->item_size);
    }
    return 0;
}

void *lm_own_value_stack_at(const LmOwnValueStack *stack, size_t index) {
    if (stack == 0 || index >= stack->count || stack->item_size == 0U) {
        return 0;
    }

    return (unsigned char *)stack->items + index * stack->item_size;
}

void *lm_own_value_stack_top(const LmOwnValueStack *stack) {
    if (stack == 0 || stack->count == 0U || stack->item_size == 0U) {
        return 0;
    }

    return (unsigned char *)stack->items + (stack->count - 1U) * stack->item_size;
}

static LmOwnValueStack lm_own_global_allocation_descriptors;
static int lm_own_global_allocation_descriptors_ready;

static int lm_own_size_multiply(size_t left, size_t right, size_t *out) {
    if (out == 0) {
        return 1;
    }
    if (left != 0U && right > ((size_t)-1) / left) {
        return 1;
    }
    *out = left * right;
    return 0;
}

static int lm_own_global_allocation_descriptors_init(void) {
    if (!lm_own_global_allocation_descriptors_ready) {
        lm_own_value_stack_init(
            &lm_own_global_allocation_descriptors,
            sizeof(LmOwnAllocationDescriptor)
        );
        lm_own_global_allocation_descriptors_ready = 1;
    }
    return 0;
}

static const LmOwnAllocationDescriptor *lm_own_allocation_descriptor_find(
    const LmOwnValueStack *descriptors,
    const void *address
) {
    const LmOwnAllocationDescriptor *descriptor;
    size_t index;

    if (descriptors == 0 || address == 0) {
        return 0;
    }

    index = descriptors->count;
    while (index > 0U) {
        --index;
        descriptor = (const LmOwnAllocationDescriptor *)lm_own_value_stack_at(descriptors, index);
        if (descriptor != 0 && descriptor->address == address) {
            return descriptor;
        }
    }

    return 0;
}

