end: external

external:
    fn: lm_own_arena_promote_lazy_edges (LmOwnArena: arena) int
        LmOwnLazyEdge: edge
        @: void copy
        size_t: i

        if: arena = 0 || c.lm_lmx_message_thread = 0 || arena\owner_thread != c.lm_lmx_message_thread || arena\frozen || arena\lazy_edges = 0
            return: 1

        i: 0U
        while: i < arena\lazy_edges\count
            edge: lm_own_ptr_stack_at(arena\lazy_edges, i)
            if: edge = 0 || edge\kind != c.LM_OWN_EDGE_LAZY_OWNED
                i: i + 1U
                continue
            if: edge\patch_slot = 0 || edge\source = 0 || edge\size = 0U
                return: 1

            copy: lm_own_arena_new_zero(arena, edge\size + 1U)
            if: copy = 0
                return: 1
            c.memcpy(copy, edge\source, edge\size)
            edge\patch_slot[0]: copy
            edge\source: copy
            edge\source_owner: arena
            edge\target_owner: arena
            edge\kind: c.LM_OWN_EDGE_OWNED
            i: i + 1U

    return: 0
end: external

external:
    fn: lm_own_arena_absorb (LmOwnArena: target; LmOwnArena: source) int
        @@: void items
        size_t: descriptor_base
        size_t: descriptor_new_count
        size_t: new_count
        size_t: capacity
        size_t: lazy_base
        size_t: lazy_new_count
        size_t: i
        LmOwnAllocationDescriptor: descriptor
        LmOwnLazyEdge: edge

        if: target = 0 || source = 0 || c.lm_lmx_message_thread = 0 || target\owner_thread != c.lm_lmx_message_thread || source\owner_thread != c.lm_lmx_message_thread || target\frozen
            return: 1
        if: target\allocations = 0 || target\allocation_descriptors = 0 || target\lazy_edges = 0
            return: 1
        if: source\allocations = 0 || source\allocation_descriptors = 0 || source\lazy_edges = 0
            return: 1
        if: source = target
            return: 0

        if: source\allocations\count > 0U
            new_count: target\allocations\count + source\allocations\count
            if: target\allocations\capacity = 0U
                capacity: 8U
            if: target\allocations\capacity != 0U
                capacity: target\allocations\capacity
            while: capacity < new_count
                capacity: capacity * 2U
            items: c.realloc(target\allocations\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            target\allocations\items: items
            target\allocations\capacity: capacity
            c.memcpy(target\allocations\items + target\allocations\count, source\allocations\items, source\allocations\count * c.sizeof(source\allocations\items[0]))
            target\allocations\count: new_count

            c.free(source\allocations\items)
            source\allocations\items: 0
            source\allocations\count: 0U
            source\allocations\capacity: 0U

        descriptor_base: target\allocation_descriptors\count
        descriptor_new_count: descriptor_base + source\allocation_descriptors\count
        if: source\allocation_descriptors\count > 0U
            if: target\allocation_descriptors\capacity = 0U
                capacity: 8U
            if: target\allocation_descriptors\capacity != 0U
                capacity: target\allocation_descriptors\capacity
            while: capacity < descriptor_new_count
                capacity: capacity * 2U
            items: c.realloc(target\allocation_descriptors\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            target\allocation_descriptors\items: items
            target\allocation_descriptors\capacity: capacity
            c.memcpy(target\allocation_descriptors\items + descriptor_base, source\allocation_descriptors\items, source\allocation_descriptors\count * c.sizeof(source\allocation_descriptors\items[0]))
            target\allocation_descriptors\count: descriptor_new_count
            i: descriptor_base
            while: i < target\allocation_descriptors\count
                descriptor: lm_own_ptr_stack_at(target\allocation_descriptors, i)
                if: descriptor != 0 && descriptor\owner = source
                    descriptor\owner: target
                i: i + 1U
            c.free(source\allocation_descriptors\items)
            source\allocation_descriptors\items: 0
            source\allocation_descriptors\count: 0U
            source\allocation_descriptors\capacity: 0U

        lazy_base: target\lazy_edges\count
        lazy_new_count: lazy_base + source\lazy_edges\count
        if: source\lazy_edges\count > 0U
            if: target\lazy_edges\capacity = 0U
                capacity: 8U
            if: target\lazy_edges\capacity != 0U
                capacity: target\lazy_edges\capacity
            while: capacity < lazy_new_count
                capacity: capacity * 2U
            items: c.realloc(target\lazy_edges\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            target\lazy_edges\items: items
            target\lazy_edges\capacity: capacity
            c.memcpy(target\lazy_edges\items + lazy_base, source\lazy_edges\items, source\lazy_edges\count * c.sizeof(source\lazy_edges\items[0]))
            target\lazy_edges\count: lazy_new_count
            i: lazy_base
            while: i < target\lazy_edges\count
                edge: lm_own_ptr_stack_at(target\lazy_edges, i)
                if: edge != 0 && edge\target_owner = source
                    edge\target_owner: target
                i: i + 1U
            c.free(source\lazy_edges\items)
            source\lazy_edges\items: 0
            source\lazy_edges\count: 0U
            source\lazy_edges\capacity: 0U

    return: 0
end: external

external:
    fn: lm_message_thread_init (LmMessageThread: thread) int
        if: thread = 0
            return: 1
        if: thread\state = c.LM_MESSAGE_THREAD_RUNNING || thread\state = c.LM_MESSAGE_THREAD_STOPPING || thread\root_owner != 0 || thread\arena_head != 0 || thread\arena_tail != 0 || thread\arena_count != 0U || thread\arena_destroying || thread\component_head != 0 || thread\component_count != 0U || thread\component_destroying
            return: 1

        c.memset(thread, 0, c.sizeof(thread[0]))
        thread\root_owner: c.lm_own_arena_new(thread, thread)
        if: thread\root_owner = 0
            thread\state: c.LM_MESSAGE_THREAD_STOPPED
            thread\collector_failed: 1
            thread\stop_status: 1
            return: 1

        thread\state: c.LM_MESSAGE_THREAD_RUNNING
    return: 0
end: external

external:
    sub: lm_message_thread_destroy (LmMessageThread: thread)
        LmOwnArena: arena
        LmMessageThreadComponent: component
        int: components_released

        if: thread != 0
            components_released: 1
            thread\component_destroying: 1
            while: thread\component_head != 0
                component: thread\component_head
                if: c.lm_message_thread_component_release(thread, thread, component) != 0
                    thread\collector_failed: 1
                    if: thread\stop_status = 0
                        thread\stop_status: 1
                    components_released: 0
                    break
            ---
            if: thread\component_count = 0U
                thread\component_head: 0
            ---
            thread\component_destroying: 0
            if: components_released
                thread\arena_destroying: 1
                while: thread\arena_tail != 0
                    arena: thread\arena_tail
                    if: c.lm_own_arena_release(thread, thread, arena, arena\runtime_owned_shell, 1) != 0
                        thread\collector_failed: 1
                        if: thread\stop_status = 0
                            thread\stop_status: 1
                        break
                ---
                if: thread\arena_count = 0U
                    thread\root_owner: 0
                    thread\arena_head: 0
                    thread\arena_tail: 0
                ---
                thread\arena_destroying: 0
            ---
            thread\execution_context: 0
            thread\state: c.LM_MESSAGE_THREAD_STOPPED
    end: lm_message_thread_destroy
end: external

external:
    fn: lm_message_thread_new () LmMessageThread
        LmMessageThread: thread

        thread: lm_own_new_zero(c.sizeof(c.LmMessageThread))
        if: thread = 0
            return: 0
        if: lm_message_thread_init(thread) != 0
            lm_own_delete(thread, 0)
            return: 0
    return: thread
end: external

external:
    sub: lm_message_thread_delete (LmMessageThread: thread)
        if: thread != 0
            lm_message_thread_destroy(thread)
            if: thread\arena_count = 0U && thread\arena_head = 0 && thread\arena_tail = 0 && thread\component_count = 0U && thread\component_head = 0
                lm_own_delete(thread, 0)
    end: lm_message_thread_delete
end: external

external:
    fn: lm_message_thread_is_running (const: (LmMessageThread: thread)) int
    return: thread != 0 && thread\state = c.LM_MESSAGE_THREAD_RUNNING
end: external

external:
    fn: lm_message_thread_status (const: (LmMessageThread: thread)) int
        if: thread = 0
            return: 1
    return: thread\stop_status
end: external

external:
    fn: lm_message_thread_owner (LmMessageThread: thread) LmOwnArena
        if: thread = 0 || thread\root_owner = 0 || thread\root_owner\owner_thread != thread || thread\arena_head != thread\root_owner || thread\root_owner\registry_previous != 0 || thread\arena_count = 0U
            return: 0
