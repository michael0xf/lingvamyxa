            while: i < target\allocation_descriptors\count
                descriptor: lm_own_ptr_stack_at(target\allocation_descriptors, i)
                if: descriptor != 0 && descriptor\owner = source
                    descriptor\owner: target
                i: i + 1U
            c.free(source\allocation_descriptors\items)
            source\allocation_descriptors\items: 0
            source\allocation_descriptors\count: 0U
            source\allocation_descriptors\capacity: 0U

        lazy_base: target\lazy_edges\count
        lazy_new_count: lazy_base + source\lazy_edges\count
        if: source\lazy_edges\count > 0U
            if: target\lazy_edges\capacity = 0U
                capacity: 8U
            if: target\lazy_edges\capacity != 0U
                capacity: target\lazy_edges\capacity
            while: capacity < lazy_new_count
                capacity: capacity * 2U
            items: c.realloc(target\lazy_edges\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            target\lazy_edges\items: items
            target\lazy_edges\capacity: capacity
            c.memcpy(target\lazy_edges\items + lazy_base, source\lazy_edges\items, source\lazy_edges\count * c.sizeof(source\lazy_edges\items[0]))
            target\lazy_edges\count: lazy_new_count
            i: lazy_base
            while: i < target\lazy_edges\count
                edge: lm_own_ptr_stack_at(target\lazy_edges, i)
                if: edge != 0 && edge\target_owner = source
                    edge\target_owner: target
                i: i + 1U
            c.free(source\lazy_edges\items)
            source\lazy_edges\items: 0
            source\lazy_edges\count: 0U
            source\lazy_edges\capacity: 0U

    return: 0
end: external

external:
    fn: lm_message_thread_init (LmMessageThread: thread) int
        if: thread = 0 || thread\pool != 0 || thread\runtime != 0
            return: 1
        if: thread\state = c.LM_MESSAGE_THREAD_RUNNING || thread\state = c.LM_MESSAGE_THREAD_STOPPING || thread\root_owner != 0 || thread\arena_head != 0 || thread\arena_tail != 0 || thread\arena_count != 0U || thread\arena_destroying || thread\component_head != 0 || thread\component_count != 0U || thread\component_destroying || thread\inbox_head != 0 || thread\outbox_head != 0 || thread\current_message != 0 || thread\turn_active
            return: 1

        c.memset(thread, 0, c.sizeof(thread[0]))
        thread\root_owner: c.lm_own_arena_new(thread, thread)
        if: thread\root_owner = 0
            thread\state: c.LM_MESSAGE_THREAD_STOPPED
            thread\collector_failed: 1
            thread\stop_status: 1
            return: 1

        thread\state: c.LM_MESSAGE_THREAD_RUNNING
    return: 0
end: external

external:
    sub: lm_message_thread_destroy (LmMessageThread: thread)
        LmOwnArena: arena
