        arena: lm_own_new_zero(c.sizeof(arena[0]))
        if: arena = 0
            return: 0
        if: lm_own_arena_init_registered(arena, owner_thread, 1) != 0
            lm_own_delete(arena, 0)
            return: 0
    return: arena
end: external

external:
    sub: lm_own_arena_delete (LmOwnArena: arena)
        if: arena != 0 && c.lm_lmx_message_thread != 0
            lm_own_arena_release(c.lm_lmx_message_thread, arena, 1, 0)
    end: lm_own_arena_delete
end: external

external:
