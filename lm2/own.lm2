        if: lm_own_allocation_descriptor_push(arena\allocation_descriptors, object, arena, bytes, element_size, count, rank, level) != 0
            lm_own_ptr_stack_pop(arena\allocations)
            c.free(object)
            return: 0

    return: object
end: external

external:
    fn: lm_own_arena_allocation_descriptor (const: (LmOwnArena: arena); const: @(void address)) const: LmOwnAllocationDescriptor
        if: arena = 0 || c.lm_lmx_message_thread = 0 || arena\owner_thread != c.lm_lmx_message_thread || arena\allocation_descriptors = 0
