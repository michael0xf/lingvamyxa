external:
    sub: lm_message_thread_request_stop (LmMessageThread: thread; int: status)
        if: thread != 0 && thread\state = c.LM_MESSAGE_THREAD_RUNNING
            thread\stop_status: status
            thread\state: c.LM_MESSAGE_THREAD_STOPPING
    end: lm_message_thread_request_stop
end: external

external:
    sub: lm_message_thread_request_failure (LmMessageThread: thread; int: status)
        if: status = 0
            status: 1
        if: thread != 0 && (thread\state = c.LM_MESSAGE_THREAD_RUNNING || thread\state = c.LM_MESSAGE_THREAD_STOPPING)
            thread\stop_status: status
            thread\state: c.LM_MESSAGE_THREAD_STOPPING
    end: lm_message_thread_request_failure
end: external

external:
    fn: lm_message_thread_collect (LmMessageThread: thread) int
        if: thread = 0
            return: 1

        thread\collection_count: thread\collection_count + 1U
        if: thread\root_owner = 0 || thread\root_owner\owner_thread != thread || thread\arena_head != thread\root_owner || thread\root_owner\registry_previous != 0 || thread\arena_tail = 0 || thread\arena_tail\registry_next != 0 || thread\arena_count = 0U
            thread\collector_failed: 1
            lm_message_thread_request_failure(thread, 1)
            return: 1
        if: c.lm_own_tree_cut(thread, thread\root_owner) != 0
            thread\collector_failed: 1
            lm_message_thread_request_failure(thread, 1)
            return: 1
    return: 0
end: external

external:
    fn: lm_message_thread_begin_turn (LmMessageThread: thread) int
        if: lm_message_thread_is_running(thread) = 0
            return: 0
        thread\turn_count: thread\turn_count + 1U
    return: 1
end: external

external:
    fn: lm_message_thread_end_turn (LmMessageThread: thread) int
        int: status

        if: thread = 0
            return: 1
        status: lm_message_thread_collect(thread)
        if: thread\state = c.LM_MESSAGE_THREAD_STOPPING
            thread\state: c.LM_MESSAGE_THREAD_STOPPED
    return: status
end: external
