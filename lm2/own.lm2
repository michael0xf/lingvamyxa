predef: "lm2/own_abi.lm2"

include: "<stdlib.h>" "<string.h>"

external:
    fn: lm_own_new_zero (size_t: size) @: void
    return: c.calloc(1U, size)
end: external

external:
    fn: lm_own_resize (@: void object; size_t: size) @: void
        if: size = 0U
            c.free(object)
            return: 0
    return: c.realloc(object, size)
end: external

external:
    fn: lm_own_copy_bytes (const: @(char source); size_t: length) @: char
        @: char copy

        if: length = (cast: size_t -1)
            return: 0
        copy: lm_own_new_zero(length + 1U)
        if: copy = 0
            return: 0
        if: source != 0 && length > 0U
            c.memcpy(copy, source, length)
        copy[length]: '\0'
    return: copy
end: external

external:
    sub: lm_own_delete (@: void object; LmOwnDestroyFields: destroy_fields)
        if: object != 0
            if: destroy_fields != 0
                c.destroy_fields(object)
            c.free(object)
    end: lm_own_delete
end: external

external:
    sub: lm_own_delete_plain (@: void object)
        lm_own_delete(object, 0)
    end: lm_own_delete_plain
end: external

external:
    sub: lm_own_pointer_array_delete (@@: void items; size_t: count; LmOwnDelete: delete_item)
        size_t: index

        if: items != 0
            if: delete_item != 0
                index: 0U
                while: index < count
                    if: items[index] != 0
                        c.delete_item(items[index])
                        items[index]: 0
                    ---
                    index: index + 1U
                ---
            c.free(items)
    end: lm_own_pointer_array_delete
end: external

external:
    sub: lm_own_ptr_stack_init (LmOwnPtrStack: stack; LmOwnDelete: delete_item)
        if: stack != 0
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\delete_item: delete_item
    end: lm_own_ptr_stack_init
end: external

external:
    sub: lm_own_ptr_stack_destroy (LmOwnPtrStack: stack)
        if: stack != 0
            lm_own_pointer_array_delete(stack\items, stack\count, stack\delete_item)
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\delete_item: 0
    end: lm_own_ptr_stack_destroy
end: external

external:
    fn: lm_own_ptr_stack_push (LmOwnPtrStack: stack; @: void item) int
        @@: void items
        size_t: capacity

        if: stack = 0
            return: 1

        if: stack\count = stack\capacity
            if: stack\capacity = 0U
                capacity: 8U
            if: stack\capacity != 0U
                capacity: stack\capacity * 2U
            ---
            items: c.realloc(stack\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            stack\items: items
            stack\capacity: capacity

        stack\items[stack\count]: item
        stack\count: stack\count + 1U
    return: 0
end: external

external:
    fn: lm_own_ptr_stack_pop (LmOwnPtrStack: stack) @: void
        @: void item

        if: stack = 0 || stack\count = 0U
            return: 0

        stack\count: stack\count - 1U
        item: stack\items[stack\count]
        stack\items[stack\count]: 0
    return: item
end: external

external:
    fn: lm_own_ptr_stack_at (const: (LmOwnPtrStack: stack); size_t: index) @: void
        if: stack = 0 || index >= stack\count
            return: 0

    return: stack\items[index]
end: external

external:
    fn: lm_own_ptr_stack_top (const: (LmOwnPtrStack: stack)) @: void
        if: stack = 0 || stack\count = 0U
            return: 0

    return: stack\items[stack\count - 1U]
end: external

external:
    sub: lm_own_ptr_stack_truncate (LmOwnPtrStack: stack; size_t: count)
        @: void item

        if: stack = 0
            return

        while: stack\count > count
            item: lm_own_ptr_stack_pop(stack)
            if: item != 0 && stack\delete_item != 0
                c.stack->delete_item(item)
    end: lm_own_ptr_stack_truncate
end: external

external:
    sub: lm_own_value_stack_init (LmOwnValueStack: stack; size_t: item_size)
        if: stack != 0
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\item_size: item_size
    end: lm_own_value_stack_init
end: external

external:
    sub: lm_own_value_stack_destroy (LmOwnValueStack: stack)
        if: stack != 0
            c.free(stack\items)
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\item_size: 0U
    end: lm_own_value_stack_destroy
end: external

external:
    sub: lm_own_value_stack_truncate (LmOwnValueStack: stack; size_t: count)
        if: stack != 0 && count < stack\count
            stack\count: count
    end: lm_own_value_stack_truncate
end: external

fn: lm_message_thread_component_find (LmMessageThread: owner_thread; LmMessageThreadComponentDestroy: destroy; @: int out_valid) LmMessageThreadComponent
    LmMessageThreadComponent: component
    LmMessageThreadComponent: match
    size_t: visited

    if: out_valid != 0
        out_valid[0]: 0
    if: owner_thread = 0 || destroy = 0 || out_valid = 0 || c.lm_lmx_message_thread = 0 || owner_thread != c.lm_lmx_message_thread
        return: 0
    if: owner_thread\component_count = 0U
        if: owner_thread\component_head != 0
            return: 0
        out_valid[0]: 1
        return: 0
    if: owner_thread\component_head = 0
        return: 0

    component: owner_thread\component_head
    match: 0
    visited: 0U
    while: component != 0
        if: visited >= owner_thread\component_count || component\owner_thread != owner_thread || component\destroy = 0
            return: 0
        if: component\destroy = destroy
            if: match != 0
                return: 0
            match: component
        component: component\next
        visited: visited + 1U
    ---
    if: visited != owner_thread\component_count
        return: 0
    out_valid[0]: 1
return: match

fn: lm_message_thread_component_detach (LmMessageThread: owner_thread; LmMessageThreadComponent: component) int
    LmMessageThreadComponent: current
    LmMessageThreadComponent: previous
    LmMessageThreadComponent: found_previous
    size_t: visited

    if: owner_thread = 0 || component = 0 || c.lm_lmx_message_thread = 0 || owner_thread != c.lm_lmx_message_thread || component\owner_thread != owner_thread || owner_thread\component_count = 0U
        return: 1
    current: owner_thread\component_head
    previous: 0
    found_previous: 0
    visited: 0U
    while: current != 0
        if: visited >= owner_thread\component_count || current\owner_thread != owner_thread || current\destroy = 0
            return: 1
        if: current = component
            found_previous: previous
        previous: current
        current: current\next
        visited: visited + 1U
    ---
    if: visited != owner_thread\component_count || (component != owner_thread\component_head && found_previous = 0)
        return: 1

    if: found_previous != 0
        found_previous\next: component\next
    else:
        owner_thread\component_head: component\next
    ---
    owner_thread\component_count: owner_thread\component_count - 1U
    component\owner_thread: 0
    component\next: 0
return: 0

fn: lm_message_thread_component_release (LmMessageThread: owner_thread; LmMessageThreadComponent: component) int
    @: void value

    if: owner_thread = 0 || component = 0 || c.lm_lmx_message_thread = 0 || owner_thread != c.lm_lmx_message_thread || component\owner_thread != owner_thread || component\destroy = 0
        return: 1
    value: component\value
    if: lm_message_thread_component_detach(owner_thread, component) != 0
        return: 1
    component\value: 0
    if: component\destroy != 0
        c.component->destroy(owner_thread, value)
    component\destroy: 0
    lm_own_delete(component, 0)
return: 0

external:
    fn: lm_message_thread_component_attach (LmMessageThreadComponentDestroy: destroy; @: void component) int
        LmMessageThreadComponent: entry
        LmMessageThread: thread
        int: valid

        thread: c.lm_lmx_message_thread
        if: thread = 0 || destroy = 0 || component = 0 || thread\state != c.LM_MESSAGE_THREAD_RUNNING || thread\component_destroying || thread\component_count = (cast: size_t -1)
            return: 1
        valid: 0
        if: lm_message_thread_component_find(thread, destroy, @ valid) != 0 || valid = 0
            return: 1

        entry: lm_own_new_zero(c.sizeof(entry[0]))
        if: entry = 0
            return: 1
        entry\owner_thread: thread
        entry\value: component
        entry\destroy: destroy
        entry\next: thread\component_head
        thread\component_head: entry
        thread\component_count: thread\component_count + 1U
    return: 0
end: external

external:
    fn: lm_message_thread_component_get (LmMessageThreadComponentDestroy: destroy) @: void
        LmMessageThreadComponent: component
        LmMessageThread: thread
        int: valid

        thread: c.lm_lmx_message_thread
        valid: 0
        component: lm_message_thread_component_find(thread, destroy, @ valid)
        if: valid = 0 || component = 0
            return: 0
    return: component\value
end: external

external:
    fn: lm_message_thread_component_remove (LmMessageThreadComponentDestroy: destroy) int
        LmMessageThreadComponent: component
        LmMessageThread: thread
        int: valid

        thread: c.lm_lmx_message_thread
        if: thread = 0 || destroy = 0 || thread\component_destroying
            return: 1
        valid: 0
        component: lm_message_thread_component_find(thread, destroy, @ valid)
        if: valid = 0 || component = 0
            return: 1
    return: lm_message_thread_component_release(thread, component)
end: external

external:
    fn: lm_message_thread_component_count (const: (LmMessageThread: thread)) size_t
        if: thread = 0
            return: 0U
    return: thread\component_count
end: external

fn: lm_own_arena_shell_is_zero (const: (LmOwnArena: arena)) int
    if: arena = 0
        return: 0
return: arena\allocations = 0 && arena\allocation_descriptors = 0 && arena\lazy_edges = 0 && arena\frozen = 0 && arena\owner_thread = 0 && arena\registry_previous = 0 && arena\registry_next = 0 && arena\runtime_owned_shell = 0

fn: lm_own_arena_register (LmMessageThread: owner_thread; LmOwnArena: arena) int
    LmOwnArena: tail

    if: owner_thread = 0 || arena = 0 || c.lm_lmx_message_thread = 0 || owner_thread != c.lm_lmx_message_thread || owner_thread\arena_destroying
        return: 1
    if: arena\owner_thread != 0 || arena\registry_previous != 0 || arena\registry_next != 0
        return: 1
    if: owner_thread\arena_count = (cast: size_t -1)
        return: 1

    tail: owner_thread\arena_tail
    if: owner_thread\arena_count = 0U
        if: owner_thread\arena_head != 0 || tail != 0
            return: 1
        ---
    else:
        if: owner_thread\arena_head = 0 || tail = 0 || owner_thread\arena_head\registry_previous != 0 || tail\registry_next != 0 || owner_thread\arena_head\owner_thread != owner_thread || tail\owner_thread != owner_thread
            return: 1
    ---

    arena\owner_thread: owner_thread
    arena\registry_previous: tail
    arena\registry_next: 0
    if: tail != 0
        tail\registry_next: arena
    else:
        owner_thread\arena_head: arena
    ---
    owner_thread\arena_tail: arena
    owner_thread\arena_count: owner_thread\arena_count + 1U
return: 0

fn: lm_own_arena_detach (LmMessageThread: owner_thread; LmOwnArena: arena) int
    LmOwnArena: previous
    LmOwnArena: next

    if: owner_thread = 0 || arena = 0 || c.lm_lmx_message_thread = 0 || owner_thread != c.lm_lmx_message_thread || arena\owner_thread != owner_thread || owner_thread\arena_count = 0U
        return: 1

    previous: arena\registry_previous
    next: arena\registry_next
    if: previous = 0
        if: owner_thread\arena_head != arena
            return: 1
        ---
    else:
        if: previous\owner_thread != owner_thread || previous\registry_next != arena
            return: 1
    ---
    if: next = 0
        if: owner_thread\arena_tail != arena
            return: 1
        ---
    else:
        if: next\owner_thread != owner_thread || next\registry_previous != arena
            return: 1
    ---

    if: previous != 0
        previous\registry_next: next
    else:
        owner_thread\arena_head: next
    ---
    if: next != 0
        next\registry_previous: previous
    else:
        owner_thread\arena_tail: previous
    ---
    owner_thread\arena_count: owner_thread\arena_count - 1U
    if: owner_thread\root_owner = arena
        owner_thread\root_owner: 0
    arena\registry_previous: 0
    arena\registry_next: 0
    arena\owner_thread: 0
return: 0

fn: lm_own_arena_init_registered (LmOwnArena: arena; LmMessageThread: owner_thread; int: runtime_owned_shell) int
    LmOwnPtrStack: allocations
    LmOwnPtrStack: allocation_descriptors
    LmOwnPtrStack: lazy_edges

    if: arena = 0 || owner_thread = 0 || c.lm_lmx_message_thread = 0 || owner_thread != c.lm_lmx_message_thread || lm_own_arena_shell_is_zero(arena) = 0
        return: 1

    allocations: lm_own_new_zero(c.sizeof(allocations[0]))
    allocation_descriptors: lm_own_new_zero(c.sizeof(allocation_descriptors[0]))
    lazy_edges: lm_own_new_zero(c.sizeof(lazy_edges[0]))
    if: allocations = 0 || allocation_descriptors = 0 || lazy_edges = 0
        lm_own_delete(lazy_edges, 0)
        lm_own_delete(allocation_descriptors, 0)
        lm_own_delete(allocations, 0)
        return: 1

    lm_own_ptr_stack_init(allocations, c.free)
    lm_own_ptr_stack_init(allocation_descriptors, c.lm_own_delete_plain)
    lm_own_ptr_stack_init(lazy_edges, c.lm_own_delete_plain)
    arena\allocations: allocations
    arena\allocation_descriptors: allocation_descriptors
    arena\lazy_edges: lazy_edges
    arena\frozen: 0
    arena\runtime_owned_shell: runtime_owned_shell != 0
    if: lm_own_arena_register(owner_thread, arena) != 0
        lm_own_ptr_stack_destroy(arena\lazy_edges)
        lm_own_delete(arena\lazy_edges, 0)
        lm_own_ptr_stack_destroy(arena\allocation_descriptors)
        lm_own_delete(arena\allocation_descriptors, 0)
        lm_own_ptr_stack_destroy(arena\allocations)
        lm_own_delete(arena\allocations, 0)
        c.memset(arena, 0, c.sizeof(arena[0]))
        return: 1
    ---
return: 0

fn: lm_own_arena_release (LmMessageThread: owner_thread; LmOwnArena: arena; int: delete_shell; int: teardown_mode) int
    int: runtime_owned_shell

    if: owner_thread = 0 || arena = 0 || c.lm_lmx_message_thread = 0 || owner_thread != c.lm_lmx_message_thread || arena\owner_thread != owner_thread
        return: 1
    if: teardown_mode = 0
        if: arena = owner_thread\root_owner
            lm_message_thread_request_failure(owner_thread, 1)
            return: 1
        if: (delete_shell != 0) != (arena\runtime_owned_shell != 0)
            return: 1
    ---

    runtime_owned_shell: arena\runtime_owned_shell
    if: lm_own_arena_detach(owner_thread, arena) != 0
        return: 1

    lm_own_ptr_stack_destroy(arena\lazy_edges)
    lm_own_delete(arena\lazy_edges, 0)
    lm_own_ptr_stack_destroy(arena\allocation_descriptors)
    lm_own_delete(arena\allocation_descriptors, 0)
    lm_own_ptr_stack_destroy(arena\allocations)
    lm_own_delete(arena\allocations, 0)
    c.memset(arena, 0, c.sizeof(arena[0]))
    if: runtime_owned_shell
        lm_own_delete(arena, 0)
return: 0

external:
    fn: lm_own_arena_init (LmOwnArena: arena; LmMessageThread: owner_thread) int
    return: lm_own_arena_init_registered(arena, owner_thread, 0)
end: external

external:
