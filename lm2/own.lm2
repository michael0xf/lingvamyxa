predef: "lm2/own_abi.lm2"

include: "<stdlib.h>" "<string.h>"

external:
    fn: lm_own_new_zero (size_t: size) @: void
    return: c.calloc(1U, size)
end: external

external:
    fn: lm_own_resize (@: void object; size_t: size) @: void
        if: size = 0U
            c.free(object)
            return: 0
    return: c.realloc(object, size)
end: external

external:
    fn: lm_own_copy_bytes (const: @(char source); size_t: length) @: char
        @: char copy

        if: length = (cast: size_t -1)
            return: 0
        copy: lm_own_new_zero(length + 1U)
        if: copy = 0
            return: 0
        if: source != 0 && length > 0U
            c.memcpy(copy, source, length)
        copy[length]: '\0'
    return: copy
end: external

external:
    sub: lm_own_delete (@: void object; LmOwnDestroyFields: destroy_fields)
        if: object != 0
            if: destroy_fields != 0
                c.destroy_fields(object)
            c.free(object)
    end: lm_own_delete
end: external

external:
    sub: lm_own_delete_plain (@: void object)
        lm_own_delete(object, 0)
    end: lm_own_delete_plain
end: external

external:
    sub: lm_own_pointer_array_delete (@@: void items; size_t: count; LmOwnDelete: delete_item)
        size_t: index

        if: items != 0
            if: delete_item != 0
                index: 0U
                while: index < count
                    if: items[index] != 0
                        c.delete_item(items[index])
                        items[index]: 0
                    ---
                    index: index + 1U
                ---
            c.free(items)
    end: lm_own_pointer_array_delete
end: external

external:
    sub: lm_own_ptr_stack_init (LmOwnPtrStack: stack; LmOwnDelete: delete_item)
        if: stack != 0
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\delete_item: delete_item
    end: lm_own_ptr_stack_init
end: external

external:
    sub: lm_own_ptr_stack_destroy (LmOwnPtrStack: stack)
        if: stack != 0
            lm_own_pointer_array_delete(stack\items, stack\count, stack\delete_item)
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\delete_item: 0
    end: lm_own_ptr_stack_destroy
end: external

external:
    fn: lm_own_ptr_stack_push (LmOwnPtrStack: stack; @: void item) int
        @@: void items
        size_t: capacity

        if: stack = 0
            return: 1

        if: stack\count = stack\capacity
            if: stack\capacity = 0U
                capacity: 8U
            if: stack\capacity != 0U
                capacity: stack\capacity * 2U
            ---
            items: c.realloc(stack\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            stack\items: items
            stack\capacity: capacity

        stack\items[stack\count]: item
        stack\count: stack\count + 1U
    return: 0
end: external

external:
    fn: lm_own_ptr_stack_pop (LmOwnPtrStack: stack) @: void
        @: void item

        if: stack = 0 || stack\count = 0U
            return: 0

        stack\count: stack\count - 1U
        item: stack\items[stack\count]
        stack\items[stack\count]: 0
    return: item
end: external

external:
    fn: lm_own_ptr_stack_at (const: (LmOwnPtrStack: stack); size_t: index) @: void
        if: stack = 0 || index >= stack\count
            return: 0

    return: stack\items[index]
end: external

external:
    fn: lm_own_ptr_stack_top (const: (LmOwnPtrStack: stack)) @: void
        if: stack = 0 || stack\count = 0U
            return: 0

    return: stack\items[stack\count - 1U]
end: external

external:
    sub: lm_own_ptr_stack_truncate (LmOwnPtrStack: stack; size_t: count)
        @: void item

        if: stack = 0
            return

        while: stack\count > count
            item: lm_own_ptr_stack_pop(stack)
            if: item != 0 && stack\delete_item != 0
                c.stack->delete_item(item)
    end: lm_own_ptr_stack_truncate
end: external

external:
    sub: lm_own_value_stack_init (LmOwnValueStack: stack; size_t: item_size)
        if: stack != 0
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\item_size: item_size
    end: lm_own_value_stack_init
end: external

external:
    sub: lm_own_value_stack_destroy (LmOwnValueStack: stack)
        if: stack != 0
            c.free(stack\items)
            stack\items: 0
            stack\count: 0U
            stack\capacity: 0U
            stack\item_size: 0U
    end: lm_own_value_stack_destroy
end: external

external:
    sub: lm_own_value_stack_truncate (LmOwnValueStack: stack; size_t: count)
        if: stack != 0 && count < stack\count
            stack\count: count
    end: lm_own_value_stack_truncate
end: external

external:
    fn: lm_own_arena_init (LmOwnArena: arena; LmMessageThread: owner_thread) int
        if: arena = 0 || owner_thread = 0
            return: 1

        arena\allocations: 0
        arena\allocation_descriptors: 0
        arena\lazy_edges: 0
        arena\frozen: 1
        arena\owner_thread: owner_thread

        arena\allocations: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
        arena\allocation_descriptors: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
        arena\lazy_edges: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
        if: arena\allocations = 0 || arena\allocation_descriptors = 0 || arena\lazy_edges = 0
            lm_own_delete(arena\lazy_edges, 0)
            lm_own_delete(arena\allocation_descriptors, 0)
            lm_own_delete(arena\allocations, 0)
            arena\allocations: 0
            arena\allocation_descriptors: 0
            arena\lazy_edges: 0
            arena\owner_thread: 0
            return: 1

        lm_own_ptr_stack_init(arena\allocations, c.free)
        lm_own_ptr_stack_init(arena\allocation_descriptors, c.lm_own_delete_plain)
        lm_own_ptr_stack_init(arena\lazy_edges, c.lm_own_delete_plain)
        arena\frozen: 0
    return: 0
end: external

external:
    sub: lm_own_arena_destroy (LmOwnArena: arena)
        if: arena != 0
            lm_own_ptr_stack_destroy(arena\lazy_edges)
            lm_own_delete(arena\lazy_edges, 0)
            lm_own_ptr_stack_destroy(arena\allocation_descriptors)
            lm_own_delete(arena\allocation_descriptors, 0)
            lm_own_ptr_stack_destroy(arena\allocations)
            lm_own_delete(arena\allocations, 0)
            arena\lazy_edges: 0
            arena\allocation_descriptors: 0
            arena\allocations: 0
            arena\frozen: 0
            arena\owner_thread: 0
    end: lm_own_arena_destroy
end: external

external:
    fn: lm_own_arena_new (LmMessageThread: owner_thread) LmOwnArena
        LmOwnArena: arena

        if: owner_thread = 0
            return: 0
        arena: lm_own_new_zero(c.sizeof(arena[0]))
        if: arena = 0
            return: 0
        if: lm_own_arena_init(arena, owner_thread) != 0
            lm_own_delete(arena, 0)
            return: 0
    return: arena
end: external

external:
    sub: lm_own_arena_delete (LmOwnArena: arena)
        if: arena != 0
            lm_own_arena_destroy(arena)
            lm_own_delete(arena, 0)
    end: lm_own_arena_delete
end: external

external:
    sub: lm_own_arena_freeze (LmOwnArena: arena)
        if: arena != 0 && arena\owner_thread != 0
            arena\frozen: 1
    end: lm_own_arena_freeze
end: external

external:
    fn: lm_own_arena_is_frozen (const: (LmOwnArena: arena)) int
    return: arena != 0 && arena\owner_thread != 0 && arena\frozen
end: external

external:
    fn: lm_own_arena_owner_thread (const: (LmOwnArena: arena)) LmMessageThread
        if: arena = 0
            return: 0
    return: arena\owner_thread
end: external

external:
    fn: lm_own_tree_cut (LmOwnArena: arena) int
    return: lm_own_tree_cut_promote_lazy_edges(arena)
end: external

external:
    fn: lm_own_tree_cut_promote_lazy_edges (LmOwnArena: arena) int
    return: lm_own_arena_promote_lazy_edges(arena)
end: external

external:
    fn: lm_own_value_stack_push (LmOwnValueStack: stack; const: @(void item)) int
        @: uchar items
        @: uchar target
        size_t: capacity

        if: stack = 0 || item = 0 || stack\item_size = 0U
            return: 1

        if: stack\count = stack\capacity
            if: stack\capacity = 0U
                capacity: 8U
            if: stack\capacity != 0U
                capacity: stack\capacity * 2U
            ---
            items: cast: (@: uchar) c.realloc(stack\items, capacity * stack\item_size)
            if: items = 0
                return: 1
            stack\items: cast: (@: void) items
            stack\capacity: capacity

        target: (cast: (@: uchar) stack\items) + stack\count * stack\item_size
        c.memcpy(target, item, stack\item_size)
        stack\count: stack\count + 1U
    return: 0
end: external

external:
    fn: lm_own_value_stack_resize_zero (LmOwnValueStack: stack; size_t: count) int
        @: uchar items
        @: uchar target
        size_t: capacity
        size_t: previous_count

        if: stack = 0 || stack\item_size = 0U
            return: 1

        if: count > stack\capacity
            if: stack\capacity = 0U
                capacity: 8U
            if: stack\capacity != 0U
                capacity: stack\capacity
            ---
            while: capacity < count
                capacity: capacity * 2U
            ---
            items: cast: (@: uchar) c.realloc(stack\items, capacity * stack\item_size)
            if: items = 0
                return: 1
            stack\items: cast: (@: void) items
            stack\capacity: capacity

        previous_count: stack\count
        if: count > previous_count
            target: (cast: (@: uchar) stack\items) + previous_count * stack\item_size
            c.memset(target, 0, (count - previous_count) * stack\item_size)
        stack\count: count
    return: 0
end: external

external:
    fn: lm_own_value_stack_pop (LmOwnValueStack: stack; @: void out_item) int
        @: uchar source

        if: stack = 0 || stack\count = 0U || stack\item_size = 0U
            return: 1

        stack\count: stack\count - 1U
        source: (cast: (@: uchar) stack\items) + stack\count * stack\item_size
        if: out_item != 0
            c.memcpy(out_item, source, stack\item_size)
    return: 0
end: external

external:
    fn: lm_own_value_stack_at (const: (LmOwnValueStack: stack); size_t: index) @: void
        @: uchar item

        if: stack = 0 || index >= stack\count || stack\item_size = 0U
            return: 0

        item: (cast: (@: uchar) stack\items) + index * stack\item_size
    return: item
end: external

external:
    fn: lm_own_value_stack_top (const: (LmOwnValueStack: stack)) @: void
        @: uchar item

        if: stack = 0 || stack\count = 0U || stack\item_size = 0U
            return: 0

        item: (cast: (@: uchar) stack\items) + (stack\count - 1U) * stack\item_size
    return: item
end: external

fn: lm_own_size_multiply (size_t: left; size_t: right; @: size_t out) int
    if: out = 0
        return: 1
    if: left != 0U && right > (cast: size_t -1) / left
        return: 1
    out[0]: left * right
return: 0

fn: lm_own_allocation_descriptor_find (const: (LmOwnPtrStack: descriptors); const: @(void address)) const: LmOwnAllocationDescriptor
    const: LmOwnAllocationDescriptor: descriptor
    size_t: index

    if: descriptors = 0 || address = 0
        return: 0

    index: descriptors\count
    while: index > 0U
        index: index - 1U
        descriptor: lm_own_ptr_stack_at(descriptors, index)
        if: descriptor != 0 && descriptor\address = address
            return: descriptor
    ---

return: 0

fn: lm_own_allocation_descriptor_push (LmOwnPtrStack: descriptors; @: void address; LmOwnArena: owner; size_t: bytes; size_t: element_size; size_t: count; size_t: rank; size_t: level) int
    LmOwnAllocationDescriptor: descriptor
    int: status

    if: descriptors = 0 || address = 0
        return: 1

    descriptor: lm_own_new_zero(c.sizeof(c.LmOwnAllocationDescriptor))
    if: descriptor = 0
        return: 1
    descriptor\address: address
    descriptor\owner: owner
    descriptor\bytes: bytes
    descriptor\element_size: element_size
    descriptor\count: count
    descriptor\rank: rank
    descriptor\level: level
    status: lm_own_ptr_stack_push(descriptors, descriptor)
    if: status != 0
        lm_own_delete(descriptor, 0)
return: status

external:
    fn: lm_own_arena_new_zero (LmOwnArena: arena; size_t: size) @: void
        @: void object

        if: arena = 0 || arena\owner_thread = 0 || arena\frozen || arena\allocations = 0 || arena\allocation_descriptors = 0
            return: 0

        object: c.calloc(1U, size)
        if: object = 0
            return: 0
        if: lm_own_ptr_stack_push(arena\allocations, object) != 0
            c.free(object)
            return: 0
        if: lm_own_allocation_descriptor_push(arena\allocation_descriptors, object, arena, size, size, 1U, 0U, 0U) != 0
            lm_own_ptr_stack_pop(arena\allocations)
            c.free(object)
            return: 0
    return: object
end: external

external:
    fn: lm_own_arena_array_new_zero (LmOwnArena: arena; size_t: element_size; size_t: count; size_t: rank; size_t: level) @: void
        @: void object
        size_t: bytes

        if: arena = 0 || arena\owner_thread = 0 || arena\frozen || arena\allocations = 0 || arena\allocation_descriptors = 0
            return: 0
        if: lm_own_size_multiply(element_size, count, @ bytes) != 0
            return: 0
        if: bytes = 0U
            return: 0

        object: c.calloc(1U, bytes)
        if: object = 0
            return: 0
        if: lm_own_ptr_stack_push(arena\allocations, object) != 0
            c.free(object)
            return: 0
        if: lm_own_allocation_descriptor_push(arena\allocation_descriptors, object, arena, bytes, element_size, count, rank, level) != 0
            lm_own_ptr_stack_pop(arena\allocations)
            c.free(object)
            return: 0

    return: object
end: external

external:
    fn: lm_own_arena_allocation_descriptor (const: (LmOwnArena: arena); const: @(void address)) const: LmOwnAllocationDescriptor
        if: arena = 0 || arena\owner_thread = 0 || arena\allocation_descriptors = 0
            return: 0
    return: lm_own_allocation_descriptor_find(arena\allocation_descriptors, address)
end: external

external:
    fn: lm_own_arena_copy_bytes (LmOwnArena: arena; const: @(char source); size_t: length) @: char
        @: char copy

        copy: lm_own_arena_new_zero(arena, length + 1U)
        if: copy = 0
            return: 0
        if: source != 0 && length > 0U
            c.memcpy(copy, source, length)
        copy[length]: '\0'
    return: copy
end: external

external:
    fn: lm_own_arena_add_lazy_edge (LmOwnArena: target; LmOwnArena: source; const: @(void source_ptr); size_t: size; const: @@(void patch_slot)) int
        LmOwnLazyEdge: edge
        int: status

        if: target = 0 || source = 0 || patch_slot = 0 || target\owner_thread = 0 || source\owner_thread = 0 || target\owner_thread != source\owner_thread || target\frozen || target\lazy_edges = 0
            return: 1
        if: size = 0U
            return: 0
        if: source_ptr = 0
            return: 1

        edge: lm_own_new_zero(c.sizeof(c.LmOwnLazyEdge))
        if: edge = 0
            return: 1
        edge\kind: c.LM_OWN_EDGE_LAZY_OWNED
        edge\source_owner: source
        edge\target_owner: target
        edge\source: source_ptr
        edge\size: size
        edge\patch_slot: patch_slot
        status: lm_own_ptr_stack_push(target\lazy_edges, edge)
        if: status != 0
            lm_own_delete(edge, 0)
    return: status
end: external

external:
    fn: lm_own_arena_promote_lazy_edges (LmOwnArena: arena) int
        LmOwnLazyEdge: edge
        @: void copy
        size_t: i

        if: arena = 0 || arena\owner_thread = 0 || arena\frozen || arena\lazy_edges = 0
            return: 1

        i: 0U
        while: i < arena\lazy_edges\count
            edge: lm_own_ptr_stack_at(arena\lazy_edges, i)
            if: edge = 0 || edge\kind != c.LM_OWN_EDGE_LAZY_OWNED
                i: i + 1U
                continue
            if: edge\patch_slot = 0 || edge\source = 0 || edge\size = 0U
                return: 1

            copy: lm_own_arena_new_zero(arena, edge\size + 1U)
            if: copy = 0
                return: 1
            c.memcpy(copy, edge\source, edge\size)
            edge\patch_slot[0]: copy
            edge\source: copy
            edge\source_owner: arena
            edge\target_owner: arena
            edge\kind: c.LM_OWN_EDGE_OWNED
            i: i + 1U

    return: 0
end: external

external:
    fn: lm_own_arena_absorb (LmOwnArena: target; LmOwnArena: source) int
        @@: void items
        size_t: descriptor_base
        size_t: descriptor_new_count
        size_t: new_count
        size_t: capacity
        size_t: lazy_base
        size_t: lazy_new_count
        size_t: i
        LmOwnAllocationDescriptor: descriptor
        LmOwnLazyEdge: edge

        if: target = 0 || source = 0 || target\owner_thread = 0 || source\owner_thread = 0 || target\owner_thread != source\owner_thread || target\frozen
            return: 1
        if: target\allocations = 0 || target\allocation_descriptors = 0 || target\lazy_edges = 0
            return: 1
        if: source\allocations = 0 || source\allocation_descriptors = 0 || source\lazy_edges = 0
            return: 1
        if: source = target
            return: 0

        if: source\allocations\count > 0U
            new_count: target\allocations\count + source\allocations\count
            if: target\allocations\capacity = 0U
                capacity: 8U
            if: target\allocations\capacity != 0U
                capacity: target\allocations\capacity
            while: capacity < new_count
                capacity: capacity * 2U
            items: c.realloc(target\allocations\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            target\allocations\items: items
            target\allocations\capacity: capacity
            c.memcpy(target\allocations\items + target\allocations\count, source\allocations\items, source\allocations\count * c.sizeof(source\allocations\items[0]))
            target\allocations\count: new_count

            c.free(source\allocations\items)
            source\allocations\items: 0
            source\allocations\count: 0U
            source\allocations\capacity: 0U

        descriptor_base: target\allocation_descriptors\count
        descriptor_new_count: descriptor_base + source\allocation_descriptors\count
        if: source\allocation_descriptors\count > 0U
            if: target\allocation_descriptors\capacity = 0U
                capacity: 8U
            if: target\allocation_descriptors\capacity != 0U
                capacity: target\allocation_descriptors\capacity
            while: capacity < descriptor_new_count
                capacity: capacity * 2U
            items: c.realloc(target\allocation_descriptors\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            target\allocation_descriptors\items: items
            target\allocation_descriptors\capacity: capacity
            c.memcpy(target\allocation_descriptors\items + descriptor_base, source\allocation_descriptors\items, source\allocation_descriptors\count * c.sizeof(source\allocation_descriptors\items[0]))
            target\allocation_descriptors\count: descriptor_new_count
            i: descriptor_base
            while: i < target\allocation_descriptors\count
                descriptor: lm_own_ptr_stack_at(target\allocation_descriptors, i)
                if: descriptor != 0 && descriptor\owner = source
                    descriptor\owner: target
                i: i + 1U
            c.free(source\allocation_descriptors\items)
            source\allocation_descriptors\items: 0
            source\allocation_descriptors\count: 0U
            source\allocation_descriptors\capacity: 0U

        lazy_base: target\lazy_edges\count
        lazy_new_count: lazy_base + source\lazy_edges\count
        if: source\lazy_edges\count > 0U
            if: target\lazy_edges\capacity = 0U
                capacity: 8U
            if: target\lazy_edges\capacity != 0U
                capacity: target\lazy_edges\capacity
            while: capacity < lazy_new_count
                capacity: capacity * 2U
            items: c.realloc(target\lazy_edges\items, capacity * c.sizeof(items[0]))
            if: items = 0
                return: 1
            target\lazy_edges\items: items
            target\lazy_edges\capacity: capacity
            c.memcpy(target\lazy_edges\items + lazy_base, source\lazy_edges\items, source\lazy_edges\count * c.sizeof(source\lazy_edges\items[0]))
            target\lazy_edges\count: lazy_new_count
            i: lazy_base
            while: i < target\lazy_edges\count
                edge: lm_own_ptr_stack_at(target\lazy_edges, i)
                if: edge != 0 && edge\target_owner = source
                    edge\target_owner: target
                i: i + 1U
            c.free(source\lazy_edges\items)
            source\lazy_edges\items: 0
            source\lazy_edges\count: 0U
            source\lazy_edges\capacity: 0U

    return: 0
end: external

external:
    fn: lm_message_thread_init (LmMessageThread: thread) int
        if: thread = 0
            return: 1

        c.memset(thread, 0, c.sizeof(thread[0]))
        thread\root_owner: lm_own_arena_new(thread)
        if: thread\root_owner = 0
            thread\state: c.LM_MESSAGE_THREAD_STOPPED
            thread\collector_failed: 1
            thread\stop_status: 1
            return: 1

        thread\state: c.LM_MESSAGE_THREAD_RUNNING
    return: 0
end: external

external:
    sub: lm_message_thread_destroy (LmMessageThread: thread)
        if: thread != 0
            if: thread\root_owner != 0 && thread\root_owner\owner_thread = thread
                lm_own_arena_delete(thread\root_owner)
            thread\root_owner: 0
            thread\state: c.LM_MESSAGE_THREAD_STOPPED
    end: lm_message_thread_destroy
end: external

external:
    fn: lm_message_thread_new () LmMessageThread
        LmMessageThread: thread

        thread: lm_own_new_zero(c.sizeof(c.LmMessageThread))
        if: thread = 0
            return: 0
        if: lm_message_thread_init(thread) != 0
            lm_own_delete(thread, 0)
            return: 0
    return: thread
end: external

external:
    sub: lm_message_thread_delete (LmMessageThread: thread)
        if: thread != 0
            lm_message_thread_destroy(thread)
            lm_own_delete(thread, 0)
    end: lm_message_thread_delete
end: external

external:
    fn: lm_message_thread_is_running (const: (LmMessageThread: thread)) int
    return: thread != 0 && thread\state = c.LM_MESSAGE_THREAD_RUNNING
end: external

external:
    fn: lm_message_thread_status (const: (LmMessageThread: thread)) int
        if: thread = 0
            return: 1
    return: thread\stop_status
end: external

external:
    fn: lm_message_thread_owner (LmMessageThread: thread) LmOwnArena
        if: thread = 0 || thread\root_owner = 0 || thread\root_owner\owner_thread != thread
            return: 0
    return: thread\root_owner
end: external

external:
    fn: lm_message_thread_execution_context (LmMessageThread: thread) @: void
        if: thread = 0
            return: 0
    return: thread\execution_context
end: external

external:
    fn: lm_message_thread_set_execution_context (LmMessageThread: thread; @: void context) @: void
        @: void previous

        if: thread = 0
            return: 0
        previous: thread\execution_context
        thread\execution_context: context
    return: previous
end: external

external:
    fn: lm_message_thread_turn_count (const: (LmMessageThread: thread)) size_t
        if: thread = 0
            return: 0U
    return: thread\turn_count
end: external

external:
    fn: lm_message_thread_collection_count (const: (LmMessageThread: thread)) size_t
        if: thread = 0
            return: 0U
    return: thread\collection_count
end: external

external:
    sub: lm_message_thread_request_stop (LmMessageThread: thread; int: status)
        if: thread != 0 && thread\state = c.LM_MESSAGE_THREAD_RUNNING
            thread\stop_status: status
            thread\state: c.LM_MESSAGE_THREAD_STOPPING
    end: lm_message_thread_request_stop
end: external

external:
    sub: lm_message_thread_request_failure (LmMessageThread: thread; int: status)
        if: status = 0
            status: 1
        if: thread != 0 && (thread\state = c.LM_MESSAGE_THREAD_RUNNING || thread\state = c.LM_MESSAGE_THREAD_STOPPING)
            thread\stop_status: status
            thread\state: c.LM_MESSAGE_THREAD_STOPPING
    end: lm_message_thread_request_failure
end: external

external:
    fn: lm_message_thread_collect (LmMessageThread: thread) int
        if: thread = 0
            return: 1

        thread\collection_count: thread\collection_count + 1U
        if: thread\root_owner = 0 || thread\root_owner\owner_thread != thread
            thread\collector_failed: 1
            lm_message_thread_request_failure(thread, 1)
            return: 1
        if: lm_own_tree_cut(thread\root_owner) != 0
            thread\collector_failed: 1
            lm_message_thread_request_failure(thread, 1)
            return: 1
    return: 0
end: external

external:
    fn: lm_message_thread_begin_turn (LmMessageThread: thread) int
        if: lm_message_thread_is_running(thread) = 0
            return: 0
        thread\turn_count: thread\turn_count + 1U
    return: 1
end: external

external:
    fn: lm_message_thread_end_turn (LmMessageThread: thread) int
        int: status

        if: thread = 0
            return: 1
        status: lm_message_thread_collect(thread)
        if: thread\state = c.LM_MESSAGE_THREAD_STOPPING
            thread\state: c.LM_MESSAGE_THREAD_STOPPED
    return: status
end: external
