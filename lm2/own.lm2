        return: 1
    if: left != 0U && right > (cast: size_t -1) / left
        return: 1
    out[0]: left * right
return: 0

fn: lm_own_allocation_descriptor_find (const: (LmOwnPtrStack: descriptors); const: @(void address)) const: LmOwnAllocationDescriptor
    const: LmOwnAllocationDescriptor: descriptor
