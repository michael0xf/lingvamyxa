        if: thread = 0 || thread\pool != 0
            return: 1
        if: thread\runtime != 0 && (thread\runtime\root_thread != thread || c.lm_native_thread_identity_is_current(thread\runtime\identity) = 0)
            return: 1
        if: c.lm_native_message_thread_state_lock(thread) != 0
