import: "lm4/own_abi.lm4"
import: "lm4/parser_abi.lm4"
import: "lm4/l4_loader_abi.lm4"
include
forward
alias
constant
layout
fn
prototype
unit

include: "<stdio.h>" "<stdlib.h>" "<string.h>"

L4:
    table:
        name: `forward.backend`
        columns: class                       (backend class)
        rows:
                 LmTransIdentifierRelation   c.struct
                 LmTransIdentifierCard       c.struct
                 LmTransNamespace            c.struct
                 LmTransExprSegment          c.struct
                 LmTransCallLowering         c.struct
                 LmTransExprAtomLowering     c.struct
                 LmTransExprLoweredRange     c.struct
                 LmTransExprPiece            c.struct
                 LmTransExprJob              c.struct
                 LmTransExprStack            c.struct
                 LmTransStatementStack       c.struct
                 LmTransStatementJob         c.struct
                 LmTransFunctionHeader       c.struct
                 LmTransTopLevelItem         c.struct
    end: `forward.backend`

    table:
        name: `alias.backend`
        columns: class                  (backend class)
        rows:
                 LmTransRegistryColumn  c.typedef
    end: `alias.backend`

    table:
        name: `alias.target`
        columns: class                  (target class)
        rows:
                 LmTransRegistryColumn  LmL4Column
    end: `alias.target`

    table:
        name: functionPointerType
        columns: class                                (value serial)
        rows:
                 LmTransExprSegmentMaterializer       1
                 LmTransCallLoweringHandler           1
                 LmTransExprAtomEmitHandler           1
                 LmTransExprAtomStateHandler          1
                 LmTransExprPieceEmitHandler          1
                 LmTransExprJobHandler                1
                 LmTransExprJobDestroyHandler         1
                 LmTransStatementJobHandler           1
                 LmTransStatementFrameHandler         1
                 LmTransAtomStatementHandler          1
                 LmTransFunctionHeaderReceiver        1
                 LmTransTypeEmitReceiver              1
                 LmTransTypeStructureValueAllocReceiver 1
                 LmTransTypeStructureValueFillReceiver 1
                 LmTransTopLevelDeclareHandler        1
                 LmTransTopLevelEmitHandler           1
    end: functionPointerType

    fn: LmTransExprSegmentMaterializer (
        @: LmTransExprStack stack
        const: @: LmTransExprSegment segment
        const: @: LmTransNamespace namespace_
        @: int out_consumed
    ) int

    fn: LmTransCallLoweringHandler (
        LmP0Text: head
        const: @: LmTransSymbol symbol
        @: LmTransCallLowering out
    ) int

    fn: LmTransExprAtomEmitHandler (
        @: FILE file
        const: @: LmTransExprAtomLowering lowering
        const: @: LmTransNamespace namespace_
    ) int

    fn: LmTransExprAtomStateHandler (
        const: @: LmTransExprAtomLowering lowering
        const: @: LmP0Node node
        const: @@: LmP0Node previous_operand
        @: int expect_field_name
        @: int expect_c_field_name
        @: int c_dot_path
    ) int

    fn: LmTransExprPieceEmitHandler (
        @: FILE file
        @: LmTransExprStack stack
        @: LmTransExprLoweredRange lowered
        const: @: LmTransExprPiece piece
        const: @: LmTransNamespace namespace_
        @: int out_suspend
    ) int

    fn: LmTransExprJobHandler (
        @: FILE file
        @: LmTransExprStack stack
        @: LmTransExprJob job
        const: @: LmTransNamespace namespace_
    ) int

    fn: LmTransExprJobDestroyHandler (@: LmTransExprJob job) void

    fn: LmTransStatementJobHandler (
        @: FILE file
        @: LmTransStatementStack stack
        @: LmTransStatementJob job
        @: LmTransNamespace namespace_
    ) int

    fn: LmTransStatementFrameHandler (
        @: FILE file
        @: LmTransStatementStack stack
        const: @: LmP0Frame frame
        unsigned: indent
        @: LmTransNamespace namespace_
    ) int

    fn: LmTransAtomStatementHandler (
        @: FILE file
        const: @: LmP0Node node
        unsigned: indent
        @: LmTransNamespace namespace_
    ) int

    fn: LmTransFunctionHeaderReceiver (
        const: @: LmP0Frame frame
        int: is_external
        @: LmTransFunctionHeader out
    ) int

    fn: LmTransTypeEmitReceiver (
        @: FILE file
        const: @: LmP0Node type_node
    ) int

    fn: LmTransTypeStructureValueAllocReceiver (
        @: FILE file
        unsigned: indent
        const: @: LmP0Node type_node
        LmP0Text: target_name
        const: @: LmP0Structure value
        @: int out_consumed
        @: int out_needs_null_check
    ) int

    fn: LmTransTypeStructureValueFillReceiver (
        @: FILE file
        unsigned: indent
        const: @: LmP0Node type_node
        LmP0Text: target_name
        const: @: LmP0Structure value
        const: @: LmTransNamespace namespace_
        @: int out_consumed
    ) int

    fn: LmTransTopLevelDeclareHandler (
        @: LmTransNamespace namespace_
        const: @: LmTransTopLevelItem item
    ) int

    fn: LmTransTopLevelEmitHandler (
        @: FILE file
        @: LmTransNamespace namespace_
        const: @: LmTransTopLevelItem item
    ) int

    table:
        name: `layout.backend`
        columns: class                          (backend class)
        rows:
                 LmTransIdentifierRelation      c.struct
                 LmTransIdentifierCard          c.struct
                 LmTransIdentifierTable         c.struct
                 LmTransRegistry                c.struct
                 LmTransRegistryFact            c.struct
                 LmTransLayoutField             c.struct
                 LmTransCDeclarator             c.struct
                 LmTransAbiParam                c.struct
                 LmTransL4CallableType          c.struct
                 LmTransSymbol                  c.struct
                 LmTransCleanup                 c.struct
                 LmTransLoop                    c.struct
                 LmTransExprSegment             c.struct
                 LmTransStructReturnFieldValue  c.struct
                 LmTransCallLowering            c.struct
                 LmTransExprLoweredRange        c.named-struct
                 LmTransExprStack               c.named-struct
                 LmTransExprRangeJob            c.struct
                 LmTransExprCallArgsJob         c.struct
                 LmTransExprAtomLowering        c.struct
                 LmTransExprPiece               c.struct
                 LmTransExprJob                 c.named-struct
                 LmTransStatementListJob        c.struct
                 LmTransStatementNodeJob        c.struct
                 LmTransStatementFrameJob       c.struct
                 LmTransStatementTextJob        c.struct
                 LmTransStatementSyncLeaveJob   c.struct
                 LmTransStatementStack          c.named-struct
                 LmTransStatementJob            c.named-struct
                 LmTransStatementLowering       c.struct
                 LmTransFunctionState           c.struct
                 LmTransFunctionHeader          c.struct
                 LmTransCapture                 c.struct
                 LmTransHoistedFunction         c.struct
                 LmTransBinding                 c.struct
                 LmTransHeadBinding             c.struct
                 LmTransTopLevelItem            c.named-struct
                 LmTransNamespace               c.named-struct
                 LmTransL4LoadContext           c.struct
    end: `layout.backend`

    table:
        name: LmTransIdentifierRelation
        columns: class    (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)  (`field.const` serial)
        rows:
                 name     char                   0                       1                                1
                 symbols  LmOwnPtrStack          1                       0                                0
                 next     LmTransIdentifierRelation 2                    1                                0
    end: LmTransIdentifierRelation

    table:
        name: LmTransIdentifierCard
