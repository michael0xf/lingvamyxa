fn: lm_p0_record_mix_mark (LmP0Document: document; LmP0Structure: structure; const: @(char text); size_t: length; size_t: line; size_t: column; size_t: start; size_t: end) int
    LmP0Node: node
    size_t: span_line
    size_t: span_column
    size_t: absolute_offset
    size_t: payload_offset
    size_t: payload_length
    LmP0Document: payload_document
    int: status

    node: lm_p0_new_node(document, c.LM_P0_NODE_STRUCTURE)
    if: node = 0
        return: 0

    node\flags: node\flags | c.LM_P0_NODE_MIX
    lm_p0_position_in_slice(text, length, start, line, column, @ span_line, @ span_column)
    node\span\line: span_line
    node\span\column: span_column
    node\span\length: end - start
