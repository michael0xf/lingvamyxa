fn: lm_p0_text_has_prefix_name (const: @(char text); size_t: length; const: @(char name); int: allow_bare) int
    size_t: name_length

    name_length: c.strlen(name)
    if: length < name_length
        return: 0
    if: c.memcmp(text, name, name_length) != 0
        return: 0
    if: length = name_length
        return: allow_bare
    if: allow_bare != 0 && (lm_p0_is_horizontal_space(text[name_length]) != 0 || text[name_length] = '#')
        return: 1
    return: text[name_length] = ':'
end: lm_p0_text_has_prefix_name

fn: lm_p0_legacy_trailer_role (const: @(char text); size_t: length) LmP0TrailerRole
    if: lm_p0_text_has_prefix_name(text, length, "end", 0) != 0
        return: c.LM_P0_TRAILER_ROLE_END
    if: lm_p0_text_has_prefix_name(text, length, "return", 1) != 0
        return: c.LM_P0_TRAILER_ROLE_RETURN
    if: lm_p0_text_has_prefix_name(text, length, "until", 0) != 0
        return: c.LM_P0_TRAILER_ROLE_UNTIL
    return: c.LM_P0_TRAILER_ROLE_NONE
end: lm_p0_legacy_trailer_role

fn: lm_p0_trailer_role_from_payload (const: @(char payload)) LmP0TrailerRole
    if: payload = 0
        return: c.LM_P0_TRAILER_ROLE_NONE
    if: c.strcmp(payload, "LM_P0_TRAILER_ROLE_END") = 0 || c.strcmp(payload, "trailer.end") = 0
        return: c.LM_P0_TRAILER_ROLE_END
    if: c.strcmp(payload, "LM_P0_TRAILER_ROLE_RETURN") = 0 || c.strcmp(payload, "trailer.return") = 0
        return: c.LM_P0_TRAILER_ROLE_RETURN
    if: c.strcmp(payload, "LM_P0_TRAILER_ROLE_UNTIL") = 0 || c.strcmp(payload, "trailer.until") = 0
        return: c.LM_P0_TRAILER_ROLE_UNTIL
    if: c.strcmp(payload, "LM_P0_TRAILER_ROLE_DASH_CUTTER") = 0 || c.strcmp(payload, "trailer.dash-cutter") = 0
        return: c.LM_P0_TRAILER_ROLE_DASH_CUTTER
    return: c.LM_P0_TRAILER_ROLE_NONE
end: lm_p0_trailer_role_from_payload

fn: lm_p0_trailer_role_payload (LmP0TrailerRole: role) const: @: char
    if: role = c.LM_P0_TRAILER_ROLE_END
        return: "trailer.end"
    if: role = c.LM_P0_TRAILER_ROLE_RETURN
        return: "trailer.return"
    if: role = c.LM_P0_TRAILER_ROLE_UNTIL
        return: "trailer.until"
    if: role = c.LM_P0_TRAILER_ROLE_DASH_CUTTER
        return: "trailer.dash-cutter"
    return: 0
end: lm_p0_trailer_role_payload

fn: lm_p0_registry_trailer_allows_bare (const: @(char class_name)) int
    const: @: char payload

    payload: lm_p0_registry_lookup(lm_p0_text_from_cstr(class_name), "trailer.allow-bare")
    return: payload != 0 && (c.strcmp(payload, "1") = 0 || c.strcmp(payload, "true") = 0)
end: lm_p0_registry_trailer_allows_bare

fn: lm_p0_trailer_role_is_tail_cutter (LmP0TrailerRole: role) int
    return: role != c.LM_P0_TRAILER_ROLE_NONE
end: lm_p0_trailer_role_is_tail_cutter

fn: lm_p0_node_head_is (const: @(LmP0Node node); const: @(char name)) int
    size_t: name_length

    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME
        return: 0

    name_length: c.strlen(name)
    return: node\as\frame\head\length = name_length && c.memcmp(node\as\frame\head\data, name, name_length) = 0
end: lm_p0_node_head_is

fn: lm_p0_trailer_role_accepts_target (LmP0TrailerRole: role; const: @(LmP0Node target)) int
    const: @: char role_payload
    const: @: char target_head

    role_payload: lm_p0_trailer_role_payload(role)
    target_head: 0
    if: role_payload != 0
        target_head: lm_p0_registry_lookup(lm_p0_text_from_cstr(role_payload), "trailer.target")

    if: target_head != 0
        return: lm_p0_node_head_is(target, target_head)

    if: lm_p0_registry_table_has_rows("trailer.target") = 0 && role = c.LM_P0_TRAILER_ROLE_RETURN
        return: lm_p0_node_head_is(target, "fn")
    return: lm_p0_trailer_role_is_tail_cutter(role)
end: lm_p0_trailer_role_accepts_target

