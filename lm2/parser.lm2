        return: length
    return: end
end: lm_p0_skip_python_string_unchecked

sub: lm_p0_scan_layout_prefix (const: @(char source); size_t: length; size_t: start; @: size_t out_offset; @: size_t out_indent_column; @: size_t out_dot_level)
    size_t: p
    size_t: indent_column
    size_t: dot_level

    lm_p0_scan_indent_column(source, start, length, @ p, @ indent_column)
    dot_level: 0U
    while: p < length && source[p] = '.'
        dot_level: dot_level + 1U
        p: p + 1U
        while: p < length && lm_p0_is_horizontal_space(source[p]) != 0
            p: p + 1U
        ---
    ---

    out_offset[0]: p
    out_indent_column[0]: indent_column
    out_dot_level[0]: dot_level
end: lm_p0_scan_layout_prefix

fn: lm_p0_layout_prefix_is_deeper (size_t: indent_column; size_t: dot_level; size_t: base_indent_column; size_t: base_dot_level) int
    if: dot_level > 0U || base_dot_level > 0U
        return: dot_level > base_dot_level
    return: indent_column > base_indent_column
end: lm_p0_layout_prefix_is_deeper

fn: lm_p0_dash_fence_status (const: @(char text); size_t: length; @: size_t out_dash_count) LmP0DashFenceStatus
    size_t: dash_count
    size_t: i
    int: closed
    size_t: brace_end

    dash_count: 0U
    while: dash_count < length && text[dash_count] = '-'
        dash_count: dash_count + 1U
    ---

    if: out_dash_count != 0
        out_dash_count[0]: dash_count
    if: dash_count < 3U
        return: c.LM_P0_DASH_FENCE_NONE
    if: dash_count > c.LM_P0_MAX_FENCE_LENGTH
        return: c.LM_P0_DASH_FENCE_TOO_LONG

    i: dash_count
    while: i < length
        if: lm_p0_is_horizontal_space(text[i]) != 0
            i: i + 1U
            continue
        if: text[i] = '#'
            return: c.LM_P0_DASH_FENCE_VALID
        if: text[i] = '{'
            brace_end: c.lm_p0_scan_brace_mark_unchecked(text, length, i, @ closed)
            if: closed != 0
                i: brace_end
                continue
        ---
        return: c.LM_P0_DASH_FENCE_TRAILING_TEXT
    ---

    return: c.LM_P0_DASH_FENCE_VALID
end: lm_p0_dash_fence_status

fn: lm_p0_validate_dash_fence_line (@: LmP0Document document; const: @(char text); size_t: length; size_t: line; size_t: column) int
    LmP0DashFenceStatus: status

    status: c.lm_p0_dash_fence_status_after_comment_trim(text, length, 0)
    if: status = c.LM_P0_DASH_FENCE_TOO_LONG
        c.lm_p0_set_diagnostic(document, 25, line, column, "dash delimiter fence length exceeds 80 characters")
        return: 0
    if: status = c.LM_P0_DASH_FENCE_TRAILING_TEXT
        c.lm_p0_set_diagnostic(document, 26, line, column, "dash delimiter line must contain only the dash fence, whitespace, or a line comment")
        return: 0
    return: 1
end: lm_p0_validate_dash_fence_line

fn: lm_p0_match_block_string_fence_line (const: @(char source); size_t: line_start; size_t: line_end; size_t: eq_count) int
    size_t: i

    if: eq_count < 3U || eq_count > c.LM_P0_MAX_FENCE_LENGTH || line_start + eq_count > line_end
        return: 0

    i: 0U
    while: i < eq_count
        if: source[line_start + i] != '='
            return: 0
        i: i + 1U
    ---

    if: line_start + eq_count < line_end && source[line_start + eq_count] = '='
        return: 0

    i: line_start + eq_count
    while: i < line_end
        if: lm_p0_is_horizontal_space(source[i]) = 0
            return: 0
        i: i + 1U
    ---

    return: 1
end: lm_p0_match_block_string_fence_line

fn: lm_p0_match_raw_comment_fence_line (const: @(char source); size_t: line_start; size_t: line_end; size_t: star_count) int
    size_t: i

    if: star_count < 3U || star_count > c.LM_P0_MAX_FENCE_LENGTH || line_start + star_count > line_end
        return: 0

    i: 0U
    while: i < star_count
        if: source[line_start + i] != '*'
            return: 0
        i: i + 1U
    ---

    if: line_start + star_count < line_end && source[line_start + star_count] = '*'
        return: 0
    return: lm_p0_line_rest_is_horizontal_space(source, line_start + star_count, line_end)
end: lm_p0_match_raw_comment_fence_line

sub: lm_p0_dump_append_size (@: LmP0Dump dump; size_t: value)
    []: char buffer 32
    size_t: index

    if: value = 0U
        c.lm_p0_dump_append_cstr(dump, "0")
        return
    ---

    index: c.sizeof(buffer)
    while: value > 0U
        index: index - 1U
        buffer[index]: '0' + value % 10U
        value: value / 10U
    ---

    c.lm_p0_dump_append(dump, buffer + index, c.sizeof(buffer) - index)
end: lm_p0_dump_append_size

sub: lm_p0_dump_append_field_count_line (@: LmP0Dump dump; size_t: field_count)
    c.lm_p0_dump_append_cstr(dump, " fields=")
    lm_p0_dump_append_size(dump, field_count)
