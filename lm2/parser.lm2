sub: lm_p0_stack_truncate_deeper (LmP0Stack: stack; size_t: level)
    size_t: i
    if: (stack\capacity <= (level + 1U))
        return
    i: (level + 1U)
    while: (i < stack\capacity)
        stack\parents[i]: 0
        stack\owners[i]: 0
        stack\hard[i]: 0U
        i: i + 1U
    ---
end: lm_p0_stack_truncate_deeper

fn: lm_p0_stack_top_level (const: (LmP0Stack: stack)) size_t
    size_t: i
    i: stack\capacity
    while: (i > 0U)
        i: i - 1U
        if: (stack\parents[i] != 0)
            return: i
        ---
    return: 0U
end: lm_p0_stack_top_level

fn: lm_p0_stack_level_is_trailer_body (const: (LmP0Stack: stack); size_t: level) int
    LmP0Node: owner
    if: ((level >= stack\capacity) || (stack\parents[level] = 0))
        return: 0
    owner: stack\owners[level]
    if: (owner = 0)
        return: 0
    if: (((owner\kind = c.LM_P0_NODE_FRAME) && (owner\as\frame\trailer != 0)) && (stack\parents[level] = owner\as\frame\trailer\body))
        return: 1
    if: (((owner\kind = c.LM_P0_NODE_STRUCTURE) && (owner\as\structure\trailer != 0)) && (stack\parents[level] = owner\as\structure\trailer\body))
        return: 1
    return: 0
end: lm_p0_stack_level_is_trailer_body

fn: lm_p0_stack_collapse_soft_to_event (LmP0Stack: stack; size_t: event_level) size_t
    size_t: top_level
    top_level: lm_p0_stack_top_level(stack)
    while: (((top_level > 0U) && (event_level < top_level)) && (stack\hard[top_level] = 0U))
