fn: lm_p0_find_python_string_end (const: @(char text); size_t: length; size_t: start; @: size_t out_end) int
    char: quote
    size_t: i
    size_t: run_length

    if: lm_p0_starts_python_string(text, length, start) = 0
        out_end[0]: start
        return: 0

    quote: text[start]
    i: start + 3U
    while: i < length
        if: text[i] = quote
            run_length: 1U
            while: i + run_length < length && text[i + run_length] = quote
                run_length: run_length + 1U
            ---

            if: run_length = 3U
                out_end[0]: i + 3U
                return: 1
            i: i + run_length
            continue
        i: i + 1U
    ---

    out_end[0]: length
    return: 0
end: lm_p0_find_python_string_end

fn: lm_p0_skip_python_string_unchecked (const: @(char text); size_t: length; size_t: start) size_t
    size_t: end

