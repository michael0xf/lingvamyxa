    value: (cast: uchar c)
    return: (c.isxdigit(value) != 0)
end: lm_p0_is_hex_digit

fn: lm_p0_scan_number_token (const: @(char text); size_t: end_index; size_t: start; @: size_t out_end) int
    size_t: i
    int: saw_digit
    i: start
    saw_digit: 0
    if: ((((i + 1U) < end_index) && (text[i] = '0')) && ((text[(i + 1U)] = 'x') || (text[(i + 1U)] = 'X')))
        i: i + 2U
        while: ((i < end_index) && lm_p0_is_hex_digit(text[i]))
