fn: lm_p0_offset_from_line_column (const: @(char text); size_t: length; size_t: line; size_t: column) size_t
    size_t: i
    size_t: current_line
    size_t: current_column
    i: 0U
    current_line: 1U
    current_column: 1U
    while: (i < length)
        if: ((current_line = line) && (current_column = column))
            return: i
        if: (text[i] = '\r')
            current_line: current_line + 1U
            current_column: 1U
            if: (((i + 1U) < length) && (text[(i + 1U)] = '\n'))
                i: i + 1U
            ---
        else:
            if: (text[i] = '\n')
                current_line: current_line + 1U
                current_column: 1U
            else:
                current_column: current_column + 1U
            ---
        i: i + 1U
    return: i
end: lm_p0_offset_from_line_column

