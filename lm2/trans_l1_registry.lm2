LmTransRegistry: lm_trans_registry

sub: lm_trans_import_document_delete (@: void document)
    lm_p0_document_destroy(cast: (LmP0Document) document)
end: lm_trans_import_document_delete

fn: lm_trans_registry_new_text () LmP0Text
    LmP0Text: text

    text: lm_own_arena_new_zero(c.lm_trans_registry->value_arena, c.sizeof(text[0]))
    if: text != 0
        text\data: ""
        text\length: 0U
return: text

fn: lm_trans_registry_new_structure () LmP0Structure
    return: lm_own_arena_new_zero(c.lm_trans_registry->value_arena, c.sizeof(c.LmP0Structure))

fn: lm_trans_registry_new_frame () LmP0Frame
    LmP0Frame: frame

    frame: lm_own_arena_new_zero(c.lm_trans_registry->value_arena, c.sizeof(frame[0]))
    if: frame = 0
        return: 0
    frame\head: lm_trans_registry_new_text()
    frame\body: lm_trans_registry_new_structure()
    if: frame\head = 0 || frame\body = 0
        return: 0
return: frame

fn: lm_trans_registry_new_trailer () LmP0Trailer
    LmP0Trailer: trailer

    trailer: lm_own_arena_new_zero(c.lm_trans_registry->value_arena, c.sizeof(trailer[0]))
    if: trailer = 0
        return: 0
    trailer\spelling: lm_trans_registry_new_text()
    trailer\body: lm_trans_registry_new_structure()
    if: trailer\spelling = 0 || trailer\body = 0
        return: 0
return: trailer

fn: lm_trans_registry_clone_frame_new_structure (const: (LmP0Structure: source); LmP0Structure: copy) LmTransRegistryCloneFrame
    LmTransRegistryCloneFrame: frame

    frame: lm_own_new_zero(c.sizeof(frame[0]))
    if: frame = 0
        return: 0
    frame\phase: c.LM_TRANS_REGISTRY_CLONE_STRUCTURE
    frame\source_structure: source
    frame\copy_structure: copy
return: frame

fn: lm_trans_registry_clone_frame_new_trailer (const: (LmP0Trailer: source); @(LmP0Trailer copy_slot)) LmTransRegistryCloneFrame
    LmTransRegistryCloneFrame: frame

    frame: lm_own_new_zero(c.sizeof(frame[0]))
    if: frame = 0
        return: 0
    frame\phase: c.LM_TRANS_REGISTRY_CLONE_TRAILER
    frame\source_trailer: source
    frame\copy_trailer_slot: copy_slot
return: frame

fn: lm_trans_registry_clone_push_frame (LmOwnPtrStack: stack; LmTransRegistryCloneFrame: frame) int
    if: stack = 0 || frame = 0
        lm_own_delete(frame, 0)
        return: 1
    if: lm_own_ptr_stack_push(stack, frame) != 0
        lm_own_delete(frame, 0)
        return: 1
return: 0

fn: lm_trans_registry_clone_push_structure (LmOwnPtrStack: stack; const: (LmP0Structure: source); LmP0Structure: copy) int
return: lm_trans_registry_clone_push_frame(stack, lm_trans_registry_clone_frame_new_structure(source, copy))

fn: lm_trans_registry_clone_push_trailer (LmOwnPtrStack: stack; const: (LmP0Trailer: source); @(LmP0Trailer copy_slot)) int
    if: copy_slot = 0
        return: 1
    \copy_slot: 0
    if: source = 0
        return: 0
return: lm_trans_registry_clone_push_frame(stack, lm_trans_registry_clone_frame_new_trailer(source, copy_slot))

fn: lm_trans_registry_clone_process_structure (const: (LmP0Structure: source); LmP0Structure: copy; LmOwnPtrStack: stack) int
    const: LmP0Field: source_field
    LmP0Field: copy_field
    LmP0Field: previous_field

    if: copy = 0
        return: 1

    c.memset(copy, 0, c.sizeof(copy[0]))
    if: source = 0
        return: 0

    previous_field: 0
    source_field: source\first_field
    while: source_field != 0
        copy_field: lm_own_arena_new_zero(c.lm_trans_registry->value_arena, c.sizeof(copy_field[0]))
        if: copy_field = 0
            return: 1
        copy_field\value: lm_trans_registry_clone_node_shallow(source_field\value, stack)
        if: source_field\value != 0 && copy_field\value = 0
            return: 1

        if: previous_field = 0
            copy\first_field: copy_field
        else:
            previous_field\next: copy_field
        previous_field: copy_field
        copy\last_field: copy_field
        copy\field_count: copy\field_count + 1U

        source_field: source_field\next

    if: lm_trans_registry_clone_push_trailer(stack, source\trailer, @ copy\trailer) != 0
        return: 1
return: 0

fn: lm_trans_registry_clone_process_trailer (const: (LmP0Trailer: source); @(LmP0Trailer copy_slot); LmOwnPtrStack: stack) int
    LmP0Trailer: copy

    if: copy_slot = 0
        return: 1
    \copy_slot: 0
    if: source = 0
        return: 0

    copy: lm_trans_registry_new_trailer()
    if: copy = 0
        return: 1

    \copy_slot: copy
    copy\flags: source\flags
    if: lm_trans_registry_clone_text(source\spelling, copy\spelling) != 0
        return: 1
return: lm_trans_registry_clone_push_structure(stack, source\body, copy\body)

fn: lm_trans_registry_clone_node_shallow (const: (LmP0Node: source); LmOwnPtrStack: stack) LmP0Node
    LmP0Node: copy

    if: source = 0
        return: 0

    copy: lm_own_arena_new_zero(c.lm_trans_registry->value_arena, c.sizeof(copy[0]))
    if: copy = 0
        return: 0

    copy\kind: source\kind
    copy\flags: source\flags
    copy\span: lm_own_arena_new_zero(c.lm_trans_registry->value_arena, c.sizeof(copy\span[0]))
    if: copy\span = 0
        return: 0
    if: source\span != 0
        c.memcpy(copy\span, source\span, c.sizeof(copy\span[0]))
    copy\as: lm_own_arena_new_zero(c.lm_trans_registry->value_arena, c.sizeof(copy\as[0]))
    if: copy\as = 0
        return: 0

    if: source\kind = c.LM_P0_NODE_ATOM || source\kind = c.LM_P0_NODE_DISABLED
        copy\as\atom: lm_trans_registry_new_text()
        if: copy\as\atom = 0 || lm_trans_registry_clone_text(source\as\atom, copy\as\atom) != 0
            return: 0
        return: copy

    if: source\kind = c.LM_P0_NODE_FRAME
        copy\as\frame: lm_trans_registry_new_frame()
        if: copy\as\frame = 0
            return: 0
        copy\as\frame\flags: source\as\frame\flags
        if: lm_trans_registry_clone_text(source\as\frame\head, copy\as\frame\head) != 0 || lm_trans_registry_clone_push_structure(stack, source\as\frame\body, copy\as\frame\body) != 0 || lm_trans_registry_clone_push_trailer(stack, source\as\frame\trailer, @ copy\as\frame\trailer) != 0
            return: 0
        return: copy

    if: source\kind = c.LM_P0_NODE_STRUCTURE
        copy\as\structure: lm_trans_registry_new_structure()
        if: copy\as\structure = 0
            return: 0
        if: lm_trans_registry_clone_push_structure(stack, source\as\structure, copy\as\structure) != 0
            return: 0
        return: copy

return: 0

fn: lm_trans_registry_clone_run (LmOwnPtrStack: stack) int
    LmTransRegistryCloneFrame: frame
    int: status
    int: handled

    status: 0
    while: status = 0 && stack != 0 && stack\count != 0U
        frame: lm_own_ptr_stack_pop(stack)
        if: frame = 0
            status: 1
            break

        handled: 0
        if: frame\phase = c.LM_TRANS_REGISTRY_CLONE_STRUCTURE
            status: lm_trans_registry_clone_process_structure(frame\source_structure, frame\copy_structure, stack)
            handled: 1
        if: handled = 0 && frame\phase = c.LM_TRANS_REGISTRY_CLONE_TRAILER
            status: lm_trans_registry_clone_process_trailer(frame\source_trailer, frame\copy_trailer_slot, stack)
            handled: 1
        if: handled = 0
            status: 1

        lm_own_delete(frame, 0)

return: status

fn: lm_trans_registry_clone_stack_new () LmOwnPtrStack
    LmOwnPtrStack: stack

    stack: lm_own_new_zero(c.sizeof(stack[0]))
    if: stack = 0
        return: 0
    lm_own_ptr_stack_init(stack, c.lm_own_delete_plain)
return: stack

sub: lm_trans_registry_clone_stack_delete (@(LmOwnPtrStack stack))
    if: stack != 0 && \stack != 0
        lm_own_ptr_stack_destroy(\stack)
        lm_own_delete(\stack, 0)
        \stack: 0
end: lm_trans_registry_clone_stack_delete

fn: lm_trans_registry_clone_node (const: (LmP0Node: source)) LmP0Node
    LmOwnPtrStack: stack
    LmP0Node: copy

    if: source = 0
        return: 0

    stack: lm_trans_registry_clone_stack_new()
    if: stack = 0
        return: 0

    copy: lm_trans_registry_clone_node_shallow(source, stack)
    if: copy = 0 || lm_trans_registry_clone_run(stack) != 0
        lm_trans_registry_clone_stack_delete(@ stack)
        return: 0

    lm_trans_registry_clone_stack_delete(@ stack)
return: copy

fn: lm_trans_registry_index_row_relation (const: (LmP0Text: card_name); const: @(char relation_name); LmTransRegistryFact: row) int
    LmTransRegistry: registry
    LmTransIdentifierCard: card
    LmTransIdentifierRelation: relation

    if: row = 0 || relation_name = 0
        return: 1

    registry: c.lm_trans_registry
    card: lm_trans_identifier_table_get_card(registry\identifiers, card_name)
    if: card = 0
        return: 1

    relation: lm_trans_identifier_card_get_relation(card, relation_name)
    if: relation = 0
        return: 1
return: lm_own_ptr_stack_push(relation\symbols, row)

fn: lm_trans_registry_index_row_table_view (LmTransRegistryFact: row) int
    const: @: char dot
    LmP0Text: table_name
    const: @: char relation_name
    int: status

    if: row = 0 || row\table = 0
        return: 1

    table_name: lm_trans_text_ref_new_cstr("")
    if: table_name = 0
        return: 1

    dot: c.strchr(row\table, '.')
    if: dot != 0 && dot != row\table && dot[1] != '\0'
        table_name\data: row\table
        table_name\length: dot - row\table
        relation_name: dot + 1U
    else:
        table_name\data: row\table
        table_name\length: c.strlen(row\table)
        relation_name: "row"

    status: lm_trans_registry_index_row_relation(table_name, relation_name, row)
    lm_trans_text_ref_destroy(@ table_name)
return: status

fn: lm_trans_registry_index_row (LmTransRegistryFact: row) int
    LmTransRegistry: registry
    LmTransIdentifierCard: card
    LmTransIdentifierRelation: relation
    LmP0Text: key_name
    int: status

    if: row = 0 || row\table = 0 || row\key = 0
        return: 1

    key_name: lm_trans_text_from_cstr(row\key)
    if: key_name = 0
        return: 1
    registry: c.lm_trans_registry
    card: lm_trans_identifier_table_get_card(registry\identifiers, key_name)
    if: card = 0
        lm_trans_text_ref_destroy(@ key_name)
        return: 1

    relation: lm_trans_identifier_card_get_relation(card, row\table)
    if: relation = 0
        lm_trans_text_ref_destroy(@ key_name)
        return: 1

    if: lm_own_ptr_stack_push(relation\symbols, row) != 0
        lm_trans_text_ref_destroy(@ key_name)
        return: 1

    status: lm_trans_registry_index_row_table_view(row)
    lm_trans_text_ref_destroy(@ key_name)
return: status

fn: lm_trans_registry_table_declares_class_kind (const: (LmP0Text: table_value)) int
    if: table_value = 0
        return: 0
    if: lm_trans_text_equals(table_value, "class") != 0
        return: 1
return: lm_trans_text_equals(table_value, "class.kind")

fn: lm_trans_registry_class_kind_conflicts_with (const: (LmP0Text: name); const: (LmP0Text: kind); const: @(char table_name)) int
    const: @: char existing_kind

    existing_kind: lm_trans_registry_lookup_exact(name, table_name)
    if: existing_kind != 0 && lm_trans_text_equals(kind, existing_kind) = 0
        c.fprintf(c.stderr, "trans registry class error: class %.*s has conflicting kinds %s and %.*s\n", (cast: int name\length), name\data, existing_kind, (cast: int kind\length), kind\data)
        return: 1
return: 0

fn: lm_trans_registry_check_class_kind_row (const: (LmP0Text: name); const: (LmP0Text: kind)) int
    if: name = 0 || kind = 0 || name\data = 0 || kind\data = 0 || name\length = 0U || kind\length = 0U
        c.fprintf(c.stderr, "trans registry class error: class rows require non-empty class and kind\n")
        return: 1
    if: lm_trans_registry_class_kind_conflicts_with(name, kind, "class") != 0
        return: 1
    if: lm_trans_registry_class_kind_conflicts_with(name, kind, "class.kind") != 0
        return: 1
return: 0

fn: lm_trans_registry_validate_class_kind_row (const: (LmP0Text: name); const: (LmP0Text: kind)) int
    if: lm_trans_registry_check_class_kind_row(name, kind) != 0
        return: 1
    if: lm_trans_registry_note_class_present(name) != 0 || lm_trans_registry_note_class_present(kind) != 0
        return: 1
return: 0

fn: lm_trans_registry_push_row_values_from (
    const: (LmP0Text: table_value)
    const: (LmP0Text: key_value)
    const: (LmP0Text: payload_value)
    const: (LmTransRegistryFact: source)
) int
    LmTransRegistry: registry
    LmTransRegistryFact: row

    if: source != 0 && (source\key = 0 || source\payload = 0 || source\payload_node != 0 || lm_trans_text_equals(key_value, source\key) = 0 || lm_trans_text_equals(payload_value, source\payload) = 0)
        return: -1

    if: lm_trans_registry_table_declares_class_kind(table_value) != 0 && lm_trans_registry_validate_class_kind_row(key_value, payload_value) != 0
        return: -1

    registry: c.lm_trans_registry
    row: lm_own_arena_new_zero(registry\value_arena, c.sizeof(row[0]))
    if: row = 0
        return: -1

    row\table: lm_trans_registry_value_copy_cstr(table_value)
    row\key: lm_trans_registry_value_copy_cstr(key_value)
    row\payload: lm_trans_registry_value_copy_cstr(payload_value)
    row\source: source
    if: row\table = 0 || row\key = 0 || row\payload = 0
        return: -1

    if: lm_trans_registry_index_row(row) != 0
        return: -1

    if: registry\view = 0 || lm_registry_view_push_relation(registry\view, row\table, row\key, row\payload, row\payload_node, row) != 0
        return: -1

    registry\loaded_fact_count: registry\loaded_fact_count + 1U
return: 0

fn: lm_trans_registry_push_row_values (const: (LmP0Text: table_value); const: (LmP0Text: key_value); const: (LmP0Text: payload_value)) int
return: lm_trans_registry_push_row_values_from(table_value, key_value, payload_value, 0)

fn: lm_trans_registry_push_row_node_values_from (
    const: (LmP0Text: table_value)
    const: (LmP0Text: key_value)
    const: (LmP0Node: payload_node)
    const: (LmTransRegistryFact: source)
) int
    LmTransRegistry: registry
    LmTransRegistryFact: row
    LmP0Node: payload_copy

    if: payload_node = 0
        return: -1
    if: source != 0 && (source\key = 0 || source\payload != 0 || source\payload_node != payload_node || lm_trans_text_equals(key_value, source\key) = 0)
        return: -1

    registry: c.lm_trans_registry
    row: lm_own_arena_new_zero(registry\value_arena, c.sizeof(row[0]))
    if: row = 0
        return: -1

    payload_copy: lm_trans_registry_clone_node(payload_node)
    if: payload_copy = 0
        return: -1

    row\table: lm_trans_registry_value_copy_cstr(table_value)
    row\key: lm_trans_registry_value_copy_cstr(key_value)
    row\payload_node: payload_copy
    row\source: source
    if: row\table = 0 || row\key = 0
        return: -1

    if: lm_trans_registry_index_row(row) != 0
        return: -1

    if: registry\view = 0 || lm_registry_view_push_relation(registry\view, row\table, row\key, row\payload, row\payload_node, row) != 0
        return: -1

    registry\loaded_fact_count: registry\loaded_fact_count + 1U
return: 0

fn: lm_trans_registry_push_row_node_values (const: (LmP0Text: table_value); const: (LmP0Text: key_value); const: (LmP0Node: payload_node)) int
return: lm_trans_registry_push_row_node_values_from(table_value, key_value, payload_node, 0)

fn: lm_trans_registry_push_row_values_with_fact (
    const: (LmP0Text: table)
    const: (LmP0Text: key)
    const: (LmP0Text: payload)
    @: LmTransRegistryFact out_fact
) int
    const: LmRegistryViewRow: view_row
    size_t: fact_index

    if: out_fact != 0
        out_fact[0]: 0
    if: table = 0 || key = 0 || payload = 0 || out_fact = 0 || c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0
        return: 1

    fact_index: lm_registry_view_fact_count(c.lm_trans_registry->view)
    if: lm_trans_registry_push_row_values(table, key, payload) != 0
        return: 1
    if: lm_registry_view_fact_count(c.lm_trans_registry->view) <= fact_index
        return: 1
    fact_index: lm_registry_view_fact_count(c.lm_trans_registry->view) - 1U
    view_row: lm_registry_view_fact_at(c.lm_trans_registry->view, fact_index)
    if: view_row = 0 || view_row\source = 0
        return: 1
    out_fact[0]: cast: (LmTransRegistryFact) view_row\source
return: 0

fn: lm_trans_registry_push_row_node_values_with_fact (
    const: (LmP0Text: table)
    const: (LmP0Text: key)
    const: (LmP0Node: payload_node)
    @: LmTransRegistryFact out_fact
) int
    const: LmRegistryViewRow: view_row
    size_t: fact_index

    if: out_fact != 0
        out_fact[0]: 0
    if: table = 0 || key = 0 || payload_node = 0 || out_fact = 0 || c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0
        return: 1

    fact_index: lm_registry_view_fact_count(c.lm_trans_registry->view)
    if: lm_trans_registry_push_row_node_values(table, key, payload_node) != 0
        return: 1
    if: lm_registry_view_fact_count(c.lm_trans_registry->view) <= fact_index
        return: 1
    fact_index: lm_registry_view_fact_count(c.lm_trans_registry->view) - 1U
    view_row: lm_registry_view_fact_at(c.lm_trans_registry->view, fact_index)
    if: view_row = 0 || view_row\source = 0
        return: 1
    out_fact[0]: cast: (LmTransRegistryFact) view_row\source
return: 0

fn: lm_trans_registry_join_relation_matches (const: @(char relation_name); const: (LmP0Text: source_name); const: @@(char out_suffix)) int
    size_t: relation_length

    if: relation_name = 0 || source_name = 0 || source_name\data = 0 || out_suffix = 0
        return: 0
    relation_length: c.strlen(relation_name)
    if: relation_length = source_name\length && c.memcmp(relation_name, source_name\data, source_name\length) = 0
        \out_suffix: ""
        return: 1
    if: relation_length > source_name\length + 1U && c.memcmp(relation_name, source_name\data, source_name\length) = 0 && relation_name[source_name\length] = '.'
        \out_suffix: relation_name + source_name\length
        return: 1
return: 0

fn: lm_trans_registry_join_target_relation_new (const: (LmP0Text: target_name); const: @(char suffix)) @: char
    size_t: suffix_length
    size_t: length
    @: char relation_name

    if: target_name = 0 || target_name\data = 0 || suffix = 0
        return: 0
    suffix_length: c.strlen(suffix)
    length: target_name\length + suffix_length
    relation_name: lm_own_new_zero(length + 1U)
    if: relation_name = 0
        return: 0
    if: target_name\length != 0U
        c.memcpy(relation_name, target_name\data, target_name\length)
    if: suffix_length != 0U
        c.memcpy(relation_name + target_name\length, suffix, suffix_length)
    relation_name[length]: '\0'
return: relation_name

fn: lm_trans_registry_join_copy_row (const: (LmTransRegistryFact: row); const: (LmP0Text: source_name); const: (LmP0Text: target_name); @: size_t copied) int
    const: @: char suffix
    @: char target_relation
    LmP0Text: target_relation_text
    LmP0Text: key_text
    LmP0Text: payload_text
    int: status

    if: row = 0 || row\table = 0 || row\key = 0 || (row\payload_node = 0 && row\payload = 0)
        return: 0
    if: copied = 0 || lm_trans_registry_join_relation_matches(row\table, source_name, @ suffix) = 0
        return: 0

    target_relation: lm_trans_registry_join_target_relation_new(target_name, suffix)
    if: target_relation = 0
        return: 1
    target_relation_text: lm_trans_text_from_cstr(target_relation)
    key_text: lm_trans_text_from_cstr(row\key)
    payload_text: 0
    if: row\payload != 0
        payload_text: lm_trans_text_from_cstr(row\payload)
    status: 1
    if: target_relation_text != 0 && key_text != 0
        if: row\payload_node != 0
            status: lm_trans_registry_push_row_node_values_from(target_relation_text, key_text, row\payload_node, row) != 0
        else:
            if: payload_text != 0
                status: lm_trans_registry_push_row_values_from(target_relation_text, key_text, payload_text, row) != 0
    ---
    lm_trans_text_ref_destroy(@ payload_text)
    lm_trans_text_ref_destroy(@ key_text)
    lm_trans_text_ref_destroy(@ target_relation_text)
    lm_own_delete(target_relation, 0)
    if: status != 0
        return: 1
    copied[0]: copied[0] + 1U
return: 0

fn: lm_trans_registry_join_table (const: (LmP0Text: source_table); const: (LmP0Text: target_table)) int
    LmP0Text: source_name
    LmP0Text: target_name
    const: LmRegistryView: view
    const: LmRegistryViewRow: view_row
    LmTransRegistryFact: row
    size_t: fact_index
    size_t: fact_count
    size_t: copied
    int: status

    if: c.lm_trans_registry = 0 || source_table = 0 || target_table = 0
        return: 1

    source_name: lm_trans_text_ref_new_cstr("")
    target_name: lm_trans_text_ref_new_cstr("")
    if: source_name = 0 || target_name = 0
        lm_trans_text_ref_destroy(@ source_name)
        lm_trans_text_ref_destroy(@ target_name)
        return: 1
    if: lm_trans_registry_identifier_value(source_table, source_name) = 0 || lm_trans_registry_identifier_value(target_table, target_name) = 0
        lm_trans_text_ref_destroy(@ source_name)
        lm_trans_text_ref_destroy(@ target_name)
        return: 1

    view: c.lm_trans_registry->view
    if: view = 0
        lm_trans_text_ref_destroy(@ source_name)
        lm_trans_text_ref_destroy(@ target_name)
        return: 1

    copied: 0U
    status: 0
    fact_count: lm_registry_view_fact_count(view)
    fact_index: 0U
    while: status = 0 && fact_index < fact_count
        view_row: lm_registry_view_fact_at(view, fact_index)
        row: 0
        if: view_row != 0
            row: cast: (LmTransRegistryFact) view_row\source
        status: lm_trans_registry_join_copy_row(row, source_name, target_name, @ copied)
        fact_index: fact_index + 1U

    ---
    lm_trans_text_ref_destroy(@ source_name)
    lm_trans_text_ref_destroy(@ target_name)
return: status

