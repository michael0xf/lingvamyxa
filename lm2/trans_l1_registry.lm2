return: status

fn: lm_trans_registry_note_class_present (const: (LmP0Text: name)) int
    LmP0Text: table
    LmP0Text: payload
    LmP0Text: class_text
    int: status

    payload: lm_trans_text_ref_new_cstr("")
    if: payload = 0
        return: 1
    if: lm_trans_registry_identifier_value(name, payload) = 0
        lm_trans_text_ref_destroy(@ payload)
        return: 0

    table: lm_trans_text_from_cstr("class.present")
    class_text: lm_trans_text_from_cstr("class")
    if: table = 0 || class_text = 0
        lm_trans_text_ref_destroy(@ payload)
        lm_trans_text_ref_destroy(@ table)
        lm_trans_text_ref_destroy(@ class_text)
        return: 1
    status: lm_trans_registry_push_row_values(table, payload, class_text) != 0
    lm_trans_text_ref_destroy(@ payload)
    lm_trans_text_ref_destroy(@ table)
    lm_trans_text_ref_destroy(@ class_text)
return: status

fn: lm_trans_registry_lookup_row_in_identifiers (const: (LmTransIdentifierTable: identifiers); const: (LmP0Text: key); const: @(char table)) LmTransRegistryFact
    LmTransIdentifierCard: card
    LmTransIdentifierRelation: relation

    if: table = 0
        return: 0

    card: lm_trans_identifier_table_find_card(identifiers, key)
    if: card = 0
        return: 0
    relation: lm_trans_identifier_card_find_relation(card, table)
    if: relation = 0
        return: 0
return: lm_own_ptr_stack_top(relation\symbols)

fn: lm_trans_registry_lookup_default_row_in_identifiers (const: (LmTransIdentifierTable: identifiers); const: @(char table)) LmTransRegistryFact
    LmP0Text: default_key
    LmTransRegistryFact: row

    if: table = 0
        return: 0

    default_key: lm_trans_text_from_cstr("default")
    if: default_key = 0
        return: 0
    row: lm_trans_registry_lookup_row_in_identifiers(identifiers, default_key, table)
    lm_trans_text_ref_destroy(@ default_key)
return: row

fn: lm_trans_registry_view_row_same (const: (LmTransRegistryFact: legacy_row); const: (LmRegistryViewRow: view_row)) int
    if: legacy_row = 0 || view_row = 0
        return: legacy_row = 0 && view_row = 0
    if: view_row\source != legacy_row
        return: 0
    if: legacy_row\table = 0 || view_row\table = 0 || c.strcmp(legacy_row\table, view_row\table) != 0
        return: 0
    if: legacy_row\key = 0 || view_row\key = 0 || c.strcmp(legacy_row\key, view_row\key) != 0
        return: 0
    if: (legacy_row\payload = 0) != (view_row\payload = 0)
        return: 0
    if: legacy_row\payload != 0 && c.strcmp(legacy_row\payload, view_row\payload) != 0
        return: 0
return: legacy_row\payload_node = view_row\payload_node

fn: lm_trans_registry_view_parity_enabled () int
return: c.lm_trans_registry != 0 && c.lm_trans_registry->view_mode != 0

fn: lm_trans_registry_view_is_selected () int
return: c.lm_trans_registry != 0 && c.lm_trans_registry->view_mode = 2

fn: lm_trans_registry_source_n2_cell (
    const: (LmTransNamespace: namespace_)
    const: @(char table_name)
    const: @(char key_column_name)
    const: @(char payload_column_name)
    const: (LmTransRegistryFact: facade_row)
    int: expect_node
    const: @(char expected_key_descriptor)
    const: @(char expected_payload_descriptor)
) const: LmTableCell
    const: LmTableDescriptor: source_table
    const: LmTableRow: source_row
    const: LmTableColumnDescriptor: source_key_column
    const: LmTableColumnDescriptor: source_payload_column
    const: LmTableCell: source_key_cell
    const: LmTableCell: source_payload_cell
    const: @: char source_key_descriptor
    const: @: char source_payload_descriptor
    size_t: descriptor_index
    size_t: row_index
    int: source_usable

    if: facade_row = 0 || facade_row\key = 0 || table_name = 0 || key_column_name = 0 || payload_column_name = 0 || lm_trans_registry_view_parity_enabled() = 0
        return: 0
    if: expect_node != 0 && (facade_row\payload != 0 || facade_row\payload_node = 0)
        return: 0
    if: expect_node = 0 && facade_row\payload = 0
        return: 0
    if: namespace_ != 0 && namespace_\registry_identifiers != 0 && namespace_\registry_identifiers != c.lm_trans_registry->identifiers
        return: 0

    descriptor_index: lm_registry_view_source_table_count(c.lm_trans_registry->view)
    while: descriptor_index > 0U
        descriptor_index: descriptor_index - 1U
        source_table: lm_registry_view_source_table_at(c.lm_trans_registry->view, descriptor_index)
        source_usable: source_table != 0 && source_table\name != 0 && c.strcmp(source_table\name, table_name) = 0 && lm_table_descriptor_column_count(source_table) = 2U
        if: source_usable != 0
            source_key_column: lm_table_descriptor_column_at(source_table, 0U)
            source_payload_column: lm_table_descriptor_column_at(source_table, 1U)
            source_usable: source_key_column != 0 && source_key_column\name != 0 && c.strcmp(source_key_column\name, key_column_name) = 0 && source_payload_column != 0 && source_payload_column\name != 0 && c.strcmp(source_payload_column\name, payload_column_name) = 0
            if: source_usable != 0 && expected_key_descriptor != 0
                source_key_descriptor: lm_table_column_descriptor_descriptor_at(source_key_column, 0U)
                source_usable: lm_table_column_descriptor_descriptor_count(source_key_column) = 1U && source_key_descriptor != 0 && c.strcmp(source_key_descriptor, expected_key_descriptor) = 0
            if: source_usable != 0 && expected_payload_descriptor != 0
                source_payload_descriptor: lm_table_column_descriptor_descriptor_at(source_payload_column, 0U)
                source_usable: lm_table_column_descriptor_descriptor_count(source_payload_column) = 1U && source_payload_descriptor != 0 && c.strcmp(source_payload_descriptor, expected_payload_descriptor) = 0
        ---
        if: source_usable != 0
            row_index: lm_table_descriptor_materialized_row_count(source_table)
            while: row_index > 0U
                row_index: row_index - 1U
                source_row: lm_table_descriptor_materialized_row_at(source_table, row_index)
                if: source_row != 0 && lm_table_row_cell_count(source_row) = 2U
                    source_key_cell: lm_table_row_cell_at(source_row, 0U)
                    source_payload_cell: lm_table_row_cell_at(source_row, 1U)
                    source_usable: source_key_cell != 0 && source_key_cell\value != 0 && c.strcmp(source_key_cell\value, facade_row\key) = 0 && source_payload_cell != 0 && source_payload_cell\explicit_none = 0 && source_payload_cell\source = facade_row
                    if: source_usable != 0 && expect_node != 0
                        source_usable: source_payload_cell\value = 0 && source_payload_cell\node != 0 && source_payload_cell\node = facade_row\payload_node
                    if: source_usable != 0 && expect_node = 0
                        source_usable: source_payload_cell\value != 0 && source_payload_cell\node = 0 && c.strcmp(source_payload_cell\value, facade_row\payload) = 0
                    if: source_usable != 0
                        return: source_payload_cell
                ---
            ---
        ---
    ---
return: 0

fn: lm_trans_registry_source_n2_value (
    const: (LmTransNamespace: namespace_)
    const: @(char table_name)
    const: @(char key_column_name)
    const: @(char value_column_name)
    const: (LmTransRegistryFact: facade_row)
) const: @: char
    const: LmTableCell: source_cell

    if: facade_row = 0 || facade_row\key = 0 || facade_row\payload = 0
        return: 0
    source_cell: lm_trans_registry_source_n2_cell(namespace_, table_name, key_column_name, value_column_name, facade_row, 0, 0, 0)
    if: source_cell != 0 && lm_trans_registry_view_is_selected() != 0
        return: source_cell\value
return: facade_row\payload

fn: lm_trans_registry_source_n2_typed_value (
    const: (LmTransNamespace: namespace_)
    const: @(char table_name)
    const: @(char key_column_name)
    const: @(char key_descriptor)
    const: @(char value_column_name)
    const: @(char value_descriptor)
    const: (LmTransRegistryFact: facade_row)
) const: @: char
    const: LmTableCell: source_cell

    if: facade_row = 0 || facade_row\key = 0 || facade_row\payload = 0
        return: 0
    source_cell: lm_trans_registry_source_n2_cell(namespace_, table_name, key_column_name, value_column_name, facade_row, 0, key_descriptor, value_descriptor)
    if: source_cell != 0 && lm_trans_registry_view_is_selected() != 0
        return: source_cell\value
return: facade_row\payload

fn: lm_trans_registry_source_n2_node (
    const: (LmTransNamespace: namespace_)
    const: @(char table_name)
    const: @(char key_column_name)
    const: @(char node_column_name)
    const: (LmTransRegistryFact: facade_row)
) const: LmP0Node
    const: LmTableCell: source_cell

    if: facade_row = 0 || facade_row\key = 0 || facade_row\payload_node = 0
        return: 0
    source_cell: lm_trans_registry_source_n2_cell(namespace_, table_name, key_column_name, node_column_name, facade_row, 1, "class", "node")
    if: source_cell != 0 && lm_trans_registry_view_is_selected() != 0
        return: (cast: (const: LmP0Node) source_cell\node)
return: facade_row\payload_node

sub: lm_trans_registry_view_parity_fail (const: @(char operation); const: @(char table))
    if: operation = 0
        operation: "unknown"
    if: table = 0
        table: "<null>"
    c.fprintf(c.stderr, "trans registry view parity error: %s differs for table %s\n", operation, table)
    c.exit(2)
end: lm_trans_registry_view_parity_fail

fn: lm_trans_registry_view_lookup_exact_text (const: (LmP0Text: key); const: @(char table)) const: LmRegistryViewRow
    LmP0Text: key_payload
    const: LmRegistryViewRow: row

    if: c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0 || key = 0 || table = 0
        return: 0
    key_payload: lm_trans_text_ref_new_cstr("")
    if: key_payload = 0
        return: 0
    if: lm_trans_identifier_payload(key, key_payload) = 0
        lm_trans_text_ref_destroy(@ key_payload)
        return: 0
    row: lm_registry_view_lookup_exact_slice(c.lm_trans_registry->view, key_payload\data, key_payload\length, table, c.strlen(table))
    lm_trans_text_ref_destroy(@ key_payload)
return: row

fn: lm_trans_registry_relation_stack_in_identifiers (const: (LmTransIdentifierTable: identifiers); const: (LmP0Text: key); const: @(char relation_name)) const: LmOwnPtrStack
    LmTransIdentifierCard: card
    LmTransIdentifierRelation: relation

    if: relation_name = 0
        return: 0

    card: lm_trans_identifier_table_find_card(identifiers, key)
    if: card = 0
        return: 0

    relation: lm_trans_identifier_card_find_relation(card, relation_name)
    if: relation != 0
        return: relation\symbols
return: 0

fn: lm_trans_registry_view_relation_stack (const: (LmP0Text: table_owner); const: @(char relation_name)) const: LmOwnPtrStack
    LmP0Text: owner_payload
    @: char table_name
    size_t: relation_length
    size_t: table_length
    int: direct_table
    const: LmOwnPtrStack: stack

    if: c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0 || table_owner = 0 || relation_name = 0
        return: 0
    owner_payload: lm_trans_text_ref_new_cstr("")
    if: owner_payload = 0
        return: 0
    if: lm_trans_identifier_payload(table_owner, owner_payload) = 0
        lm_trans_text_ref_destroy(@ owner_payload)
        return: 0
    if: c.memchr(owner_payload\data, '.', owner_payload\length) != 0
        lm_trans_text_ref_destroy(@ owner_payload)
        return: 0
    direct_table: c.strcmp(relation_name, "row") = 0
    relation_length: c.strlen(relation_name)
    table_length: owner_payload\length
    if: direct_table = 0
        table_length: table_length + 1U + relation_length
    table_name: lm_own_new_zero(table_length + 1U)
    if: table_name = 0
        lm_trans_text_ref_destroy(@ owner_payload)
        return: 0
    if: owner_payload\length != 0U
        c.memcpy(table_name, owner_payload\data, owner_payload\length)
    if: direct_table = 0
        table_name[owner_payload\length]: '.'
        if: relation_length != 0U
            c.memcpy(table_name + owner_payload\length + 1U, relation_name, relation_length)
        ---
    table_name[table_length]: '\0'
    stack: lm_registry_view_local_source_rows_slice(c.lm_trans_registry->view, table_name, table_length)
    lm_own_delete(table_name, 0)
    lm_trans_text_ref_destroy(@ owner_payload)
return: stack

fn: lm_trans_registry_relation_stacks_same (const: (LmOwnPtrStack: legacy_stack); const: (LmOwnPtrStack: view_stack)) int
    size_t: index

    if: legacy_stack = 0 || view_stack = 0
        return: legacy_stack = 0 && view_stack = 0
    if: legacy_stack\count != view_stack\count
        return: 0
    index: 0U
    while: index < legacy_stack\count
        if: lm_own_ptr_stack_at(legacy_stack, index) != lm_own_ptr_stack_at(view_stack, index)
            return: 0
        index: index + 1U
return: 1

fn: lm_trans_registry_relation_stack (const: (LmP0Text: key); const: @(char relation_name)) const: LmOwnPtrStack
    const: LmOwnPtrStack: legacy_stack
    const: LmOwnPtrStack: view_stack
    size_t: legacy_count
    size_t: view_count

    view_stack: 0
    legacy_stack: lm_trans_registry_relation_stack_in_identifiers(c.lm_trans_registry->identifiers, key, relation_name)
    if: lm_trans_registry_view_parity_enabled() != 0
        view_stack: lm_trans_registry_view_relation_stack(key, relation_name)
        if: lm_trans_registry_relation_stacks_same(legacy_stack, view_stack) = 0
            legacy_count: 0U
            view_count: 0U
            if: legacy_stack != 0
                legacy_count: legacy_stack\count
            if: view_stack != 0
                view_count: view_stack\count
            c.fprintf(c.stderr, "trans registry view parity error: relation stack differs for %.*s.%s (legacy=%zu view=%zu)\n", (cast: int key\length), key\data, relation_name, legacy_count, view_count)
            c.exit(2)
    ---
    if: lm_trans_registry_view_is_selected() != 0
        return: view_stack
return: legacy_stack

fn: lm_trans_namespace_registry_relation_stack (const: (LmTransNamespace: namespace_); const: (LmP0Text: key); const: @(char relation_name)) const: LmOwnPtrStack
    const: LmOwnPtrStack: stack

    if: namespace_ != 0 && namespace_\registry_identifiers != 0 && (c.lm_trans_registry = 0 || namespace_\registry_identifiers != c.lm_trans_registry->identifiers)
        stack: lm_trans_registry_relation_stack_in_identifiers(namespace_\registry_identifiers, key, relation_name)
        if: stack != 0
            return: stack

    ---
return: lm_trans_registry_relation_stack(key, relation_name)

fn: lm_trans_registry_relation_stack_for_table (const: @(char table)) const: LmOwnPtrStack
    const: @: char dot
    LmP0Text: table_name
    const: @: char relation_name
    const: LmOwnPtrStack: stack

    if: table = 0
        return: 0

    table_name: lm_trans_text_ref_new_cstr("")
    if: table_name = 0
        return: 0

    dot: c.strchr(table, '.')
    if: dot != 0 && dot != table && dot[1] != '\0'
        table_name\data: table
        table_name\length: (cast: size_t (dot - table))
        relation_name: dot + 1
    else:
        table_name\data: table
        table_name\length: c.strlen(table)
        relation_name: "row"

    ---
    stack: lm_trans_registry_relation_stack(table_name, relation_name)
    lm_trans_text_ref_destroy(@ table_name)
return: stack

fn: lm_trans_registry_relation_stack_latest_row (const: (LmOwnPtrStack: stack); const: (LmP0Text: key)) LmTransRegistryFact
    size_t: i
    LmTransRegistryFact: row
    LmP0Text: key_payload

    key_payload: lm_trans_text_ref_new_cstr("")
    if: stack = 0 || key_payload = 0 || lm_trans_identifier_payload(key, key_payload) = 0
        lm_trans_text_ref_destroy(@ key_payload)
        return: 0

    i: stack\count
    while: i > 0U
        i: i - 1U
        row: lm_own_ptr_stack_at(stack, i)
        if: row != 0 && row\key != 0 && lm_trans_text_equals(key_payload, row\key) != 0
            lm_trans_text_ref_destroy(@ key_payload)
            return: row

    ---
    lm_trans_text_ref_destroy(@ key_payload)
return: 0

fn: lm_trans_registry_source_relation_path_new (const: @(char table); const: @(char relation_name); @: size_t out_length) @: char
    @: char path
    size_t: table_length
    size_t: relation_length
    size_t: path_length
    int: direct_table

    if: out_length != 0
        out_length[0]: 0U
    if: table = 0 || relation_name = 0 || out_length = 0
        return: 0

    table_length: c.strlen(table)
    relation_length: c.strlen(relation_name)
    direct_table: c.strcmp(relation_name, "row") = 0
    path_length: table_length
    if: direct_table = 0
        path_length: path_length + 1U + relation_length
    path: lm_own_new_zero(path_length + 1U)
    if: path = 0
        return: 0
    c.memcpy(path, table, table_length)
    if: direct_table = 0
        path[table_length]: '.'
        c.memcpy(path + table_length + 1U, relation_name, relation_length)
    path[path_length]: '\0'
    out_length[0]: path_length
return: path

fn: lm_trans_registry_source_table_lookup_row (
    const: (LmP0Text: key)
    const: @(char table)
    const: @(LmTableDescriptor out_descriptor)
    @: int out_covered
) const: LmTableRow
    LmP0Text: key_payload
    const: LmTableRow: row

    if: out_descriptor != 0
        out_descriptor[0]: 0
    if: out_covered != 0
        out_covered[0]: 0
    if: key = 0 || table = 0 || out_descriptor = 0 || out_covered = 0 || lm_trans_registry_view_parity_enabled() = 0 || c.lm_trans_registry->view = 0
        return: 0

    key_payload: lm_trans_text_ref_new_cstr("")
    if: key_payload = 0
        return: 0
    if: lm_trans_identifier_payload(key, key_payload) = 0
        lm_trans_text_ref_destroy(@ key_payload)
        return: 0

    row: lm_registry_view_source_table_lookup_row_slice(
        c.lm_trans_registry->view,
        table,
        c.strlen(table),
        key_payload\data,
        key_payload\length,
        out_descriptor,
        out_covered
    )
    lm_trans_text_ref_destroy(@ key_payload)
return: row

fn: lm_trans_namespace_registry_source_relation_has_key (
    const: (LmTransNamespace: namespace_)
    const: (LmP0Text: key)
    const: @(char table)
    const: @(char relation_name)
) int
    const: LmOwnPtrStack: rows
    LmP0Text: table_text
    LmP0Text: key_payload
    @: char source_path
    size_t: source_path_length
    int: facade_has_key
    int: source_has_key
    int: source_covered

    if: key = 0 || table = 0 || relation_name = 0
        return: 0

    table_text: lm_trans_text_from_cstr(table)
    if: table_text = 0
        return: 0
    rows: lm_trans_namespace_registry_relation_stack(namespace_, table_text, relation_name)
    facade_has_key: lm_trans_registry_relation_stack_latest_row(rows, key) != 0
    lm_trans_text_ref_destroy(@ table_text)

    if: lm_trans_registry_view_parity_enabled() = 0
        return: facade_has_key
    if: namespace_ != 0 && namespace_\registry_identifiers != 0 && namespace_\registry_identifiers != c.lm_trans_registry->identifiers
        return: facade_has_key

    source_path: lm_trans_registry_source_relation_path_new(table, relation_name, @ source_path_length)
    if: source_path = 0
        return: facade_has_key

    key_payload: lm_trans_text_ref_new_cstr("")
    if: key_payload = 0 || lm_trans_identifier_payload(key, key_payload) = 0
        lm_trans_text_ref_destroy(@ key_payload)
        lm_own_delete(source_path, 0)
        return: facade_has_key
    source_covered: 0
    source_has_key: lm_registry_view_source_path_has_key_slice(c.lm_trans_registry->view, source_path, source_path_length, key_payload\data, key_payload\length, @ source_covered)
    lm_trans_text_ref_destroy(@ key_payload)
    lm_own_delete(source_path, 0)

    if: source_covered != 0 && source_has_key != 0 && facade_has_key = 0
        lm_trans_registry_view_parity_fail("source relation key membership", table)
    if: lm_trans_registry_view_is_selected() != 0 && source_covered != 0 && (source_has_key != 0 || facade_has_key = 0)
        return: source_has_key
return: facade_has_key

fn: lm_trans_registry_lookup_exact (const: (LmP0Text: key); const: @(char table)) const: @: char
    LmTransRegistryFact: row
    const: LmRegistryViewRow: view_row

    row: lm_trans_registry_lookup_row_in_identifiers(c.lm_trans_registry->identifiers, key, table)
    if: lm_trans_registry_view_parity_enabled() != 0
        view_row: lm_trans_registry_view_lookup_exact_text(key, table)
        if: lm_trans_registry_view_row_same(row, view_row) = 0
            lm_trans_registry_view_parity_fail("exact lookup", table)
    ---
    if: lm_trans_registry_view_is_selected() != 0
        if: view_row != 0
            return: view_row\payload
        return: 0
    if: row != 0
        return: row\payload

return: 0

fn: lm_trans_registry_lookup_default (const: @(char table)) const: @: char
    LmTransRegistryFact: row
    const: LmRegistryViewRow: view_row

    row: lm_trans_registry_lookup_default_row_in_identifiers(c.lm_trans_registry->identifiers, table)
    if: lm_trans_registry_view_parity_enabled() != 0
        view_row: lm_registry_view_lookup_default(c.lm_trans_registry->view, table)
        if: lm_trans_registry_view_row_same(row, view_row) = 0
            lm_trans_registry_view_parity_fail("default lookup", table)
    ---
    if: lm_trans_registry_view_is_selected() != 0
        if: view_row != 0
            return: view_row\payload
        return: 0
    if: row != 0
        return: row\payload

return: 0

fn: lm_trans_registry_lookup (const: (LmP0Text: key); const: @(char table)) const: @: char
    const: @: char payload

    payload: lm_trans_registry_lookup_exact(key, table)
    if: payload != 0
        return: payload
return: lm_trans_registry_lookup_default(table)

fn: lm_trans_registry_has (const: (LmP0Text: key); const: @(char table)) int
return: lm_trans_registry_lookup(key, table) != 0

fn: lm_trans_registry_table_has_rows (const: @(char table)) int
    const: LmOwnPtrStack: stack
    int: legacy_has_rows
    int: view_has_rows
    int: source_has_rows
    int: source_covered

    if: table = 0
        return: 0

    stack: lm_trans_registry_relation_stack_for_table(table)
    legacy_has_rows: stack != 0 && stack\count != 0U
    view_has_rows: 0
    source_covered: 0
    source_has_rows: 0
    if: lm_trans_registry_view_parity_enabled() != 0
        view_has_rows: lm_registry_view_table_has_rows(c.lm_trans_registry->view, table)
        source_has_rows: lm_registry_view_source_path_has_rows(c.lm_trans_registry->view, table, @ source_covered)
        if: legacy_has_rows != view_has_rows
            lm_trans_registry_view_parity_fail("table row presence", table)
        if: source_covered != 0 && source_has_rows != 0 && legacy_has_rows = 0
            lm_trans_registry_view_parity_fail("source table row presence", table)
    ---
    if: lm_trans_registry_view_is_selected() != 0
        if: source_covered != 0 && (source_has_rows != 0 || view_has_rows = 0)
            return: source_has_rows
        return: view_has_rows
return: legacy_has_rows

fn: lm_trans_registry_source_cell_copy_same (const: (LmTableCell: copied); const: (LmTableCell: source)) int
    if: copied = 0 || source = 0 || copied = source
        return: 0
    if: (copied\atom = 0) != (source\atom = 0) || (copied\value = 0) != (source\value = 0)
        return: 0
    if: copied\atom != 0 && (copied\atom = source\atom || c.strcmp(copied\atom, source\atom) != 0)
        return: 0
    if: copied\value != 0 && (copied\value = source\value || c.strcmp(copied\value, source\value) != 0)
        return: 0
return: copied\node = source\node && copied\source = source\source && copied\explicit_none = source\explicit_none

fn: lm_trans_registry_source_row_copy_same (const: (LmTableRow: copied); const: (LmTableRow: source)) int
    size_t: cell_index

    if: copied = 0 || source = 0 || copied = source || lm_table_row_cell_count(copied) != lm_table_row_cell_count(source)
        return: 0
    cell_index: 0U
    while: cell_index < lm_table_row_cell_count(copied)
        if: lm_trans_registry_source_cell_copy_same(lm_table_row_cell_at(copied, cell_index), lm_table_row_cell_at(source, cell_index)) = 0
            return: 0
        cell_index: cell_index + 1U
return: 1

fn: lm_trans_registry_assert_source_table_materialization () int
    size_t: source_table_count
    size_t: descriptor_index
    size_t: column_count
    size_t: column_index
    size_t: descriptor_count
    size_t: row_count
    size_t: row_index
    size_t: cell_index
    const: LmTableDescriptor: descriptor
    const: LmTableColumnDescriptor: column
    const: @: char first_descriptor
    const: LmTableRow: row
    const: LmTableRow: source_row
    const: LmTableCell: key_cell
    const: LmTableCell: cell
    const: LmTransRegistryFact: fact

    if: c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0
        return: 1
    source_table_count: lm_registry_view_source_table_count(c.lm_trans_registry->view)
    descriptor_index: 0U
    while: descriptor_index < source_table_count
        descriptor: lm_registry_view_source_table_at(c.lm_trans_registry->view, descriptor_index)
        column_count: lm_table_descriptor_column_count(descriptor)
        if: descriptor = 0 || descriptor\name = 0 || column_count = 0U
            c.fprintf(c.stderr, "trans registry source table error: invalid descriptor at %zu\n", descriptor_index)
            return: 1

        column_index: 0U
        while: column_index < column_count
            column: lm_table_descriptor_column_at(descriptor, column_index)
            if: column = 0 || column\name = 0 || column\index != column_index || column\descriptors = 0
                c.fprintf(c.stderr, "trans registry source table error: invalid column %zu for %s\n", column_index, descriptor\name)
                return: 1
            descriptor_count: lm_table_column_descriptor_descriptor_count(column)
            first_descriptor: lm_table_column_descriptor_descriptor_at(column, 0U)
            if: (descriptor_count = 0U && column\descriptor != 0) || (descriptor_count != 0U && (column\descriptor = 0 || first_descriptor = 0 || c.strcmp(column\descriptor, first_descriptor) != 0))
                c.fprintf(c.stderr, "trans registry source table error: descriptor order differs for %s.%s\n", descriptor\name, column\name)
                return: 1
            column_index: column_index + 1U

        row_count: lm_table_descriptor_materialized_row_count(descriptor)
        row_index: 0U
        while: row_index < row_count
            row: lm_table_descriptor_materialized_row_at(descriptor, row_index)
            if: row = 0 || row\local_sequence != row_index || lm_table_row_cell_count(row) != column_count
                c.fprintf(c.stderr, "trans registry source table error: invalid row %zu for %s\n", row_index, descriptor\name)
                return: 1
            key_cell: lm_table_row_cell_at(row, 0U)
            if: key_cell = 0 || key_cell\atom = 0 || key_cell\value = 0 || key_cell\node != 0 || key_cell\source != 0
                c.fprintf(c.stderr, "trans registry source table error: invalid key cell in %s row %zu\n", descriptor\name, row_index)
                return: 1

            if: row\source != 0
                source_row: row\source
                if: lm_trans_registry_source_row_copy_same(row, source_row) = 0
                    c.fprintf(c.stderr, "trans registry source table error: joined row copy differs in %s row %zu\n", descriptor\name, row_index)
                    return: 1
            ---

            cell_index: 1U
            while: cell_index < column_count
                cell: lm_table_row_cell_at(row, cell_index)
                if: cell = 0
                    return: 1
                if: cell\explicit_none != 0
                    if: cell\atom = 0 || cell\value != 0 || cell\node != 0 || cell\source != 0
                        c.fprintf(c.stderr, "trans registry source table error: invalid None cell in %s row %zu column %zu\n", descriptor\name, row_index, cell_index)
                        return: 1
                ---
                else:
                    if: cell\source = 0
                        if: cell\value != 0 || cell\node != 0
                            c.fprintf(c.stderr, "trans registry source table error: materialized cell has no legacy source in %s row %zu column %zu\n", descriptor\name, row_index, cell_index)
                            return: 1
                    ---
                    else:
                        fact: cast: (const: LmTransRegistryFact) cell\source
                        if: fact\key = 0 || c.strcmp(fact\key, key_cell\value) != 0 || (fact\payload = 0) != (cell\value = 0) || (fact\payload != 0 && c.strcmp(fact\payload, cell\value) != 0) || fact\payload_node != cell\node
                            c.fprintf(c.stderr, "trans registry source table error: legacy projection differs in %s row %zu column %zu\n", descriptor\name, row_index, cell_index)
                            return: 1
                    ---
                ---
                cell_index: cell_index + 1U
            row_index: row_index + 1U
        descriptor_index: descriptor_index + 1U
return: 0

fn: lm_trans_registry_assert_view_parity () int
    size_t: fact_count
    size_t: i
    size_t: j
    size_t: descriptor_index
    size_t: table_row_count
    size_t: matching_key_count
    size_t: matching_key_index
    int: first_key_row
    const: LmRegistryViewRow: view_row
    const: LmRegistryViewRow: candidate_view_row
    const: LmRegistryViewRow: selected_view_row
    const: LmRegistryViewRow: default_view_row
    const: LmRegistryViewRow: ordered_view_row
    const: LmTransRegistryFact: legacy_row
    const: LmTransRegistryFact: selected_legacy_row
    const: LmTransRegistryFact: default_legacy_row
    const: LmTransRegistryFact: ordered_legacy_row
    const: LmOwnPtrStack: table_stack
    const: LmOwnPtrStack: key_stack
    LmP0Text: key_text
    LmTableDescriptor: descriptor
    const: LmTableColumnDescriptor: key_column
    const: LmTableColumnDescriptor: payload_column

    if: lm_trans_registry_view_parity_enabled() = 0
        return: 0
    if: c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0
        c.fprintf(c.stderr, "trans registry view parity error: registry view is not initialized\n")
        return: 1
    if: lm_trans_registry_assert_source_table_materialization() != 0
        return: 1

    fact_count: lm_registry_view_fact_count(c.lm_trans_registry->view)
    if: fact_count != c.lm_trans_registry->loaded_fact_count
        c.fprintf(c.stderr, "trans registry view parity error: fact count legacy=%zu view=%zu\n", c.lm_trans_registry->loaded_fact_count, fact_count)
        return: 1

    i: 0U
    while: i < fact_count
        view_row: lm_registry_view_fact_at(c.lm_trans_registry->view, i)
        if: view_row = 0 || view_row\source = 0 || view_row\local_sequence != i
            c.fprintf(c.stderr, "trans registry view parity error: invalid ordered fact at %zu\n", i)
            return: 1
        legacy_row: (cast: (const: LmTransRegistryFact) view_row\source)
        if: lm_trans_registry_view_row_same(legacy_row, view_row) = 0
            c.fprintf(c.stderr, "trans registry view parity error: fact payload differs at %zu\n", i)
            return: 1
        i: i + 1U

    descriptor_index: 0U
    while: descriptor_index < c.lm_trans_registry->view->tables->count
        descriptor: lm_own_ptr_stack_at(c.lm_trans_registry->view->tables, descriptor_index)
        if: descriptor = 0 || lm_table_descriptor_column_count(descriptor) != 2U
            c.fprintf(c.stderr, "trans registry view parity error: legacy projection schema is missing\n")
            return: 1
        key_column: lm_table_descriptor_column_at(descriptor, 0U)
        payload_column: lm_table_descriptor_column_at(descriptor, 1U)
        if: key_column = 0 || payload_column = 0 || key_column\name = 0 || payload_column\name = 0 || key_column\descriptor = 0 || payload_column\descriptor = 0 || c.strcmp(key_column\name, "class") != 0 || c.strcmp(payload_column\name, "value") != 0 || c.strcmp(key_column\descriptor, "key") != 0 || c.strcmp(payload_column\descriptor, "payload") != 0
            c.fprintf(c.stderr, "trans registry view parity error: legacy projection columns differ for %s\n", descriptor\name)
            return: 1

        table_stack: lm_trans_registry_relation_stack_for_table(descriptor\name)
        table_row_count: lm_table_descriptor_row_count(descriptor)
        if: table_row_count != lm_registry_view_table_row_count(c.lm_trans_registry->view, descriptor\name) || lm_registry_view_table_has_rows(c.lm_trans_registry->view, descriptor\name) = 0 || (table_stack = 0 && table_row_count != 0U) || (table_stack != 0 && table_stack\count != table_row_count)
            c.fprintf(c.stderr, "trans registry view parity error: table row count differs for %s\n", descriptor\name)
            return: 1
        i: 0U
        while: i < table_row_count
            ordered_legacy_row: (cast: (const: LmTransRegistryFact) lm_own_ptr_stack_at(table_stack, i))
            ordered_view_row: lm_registry_view_table_row_at(c.lm_trans_registry->view, descriptor\name, i)
            if: lm_trans_registry_view_row_same(ordered_legacy_row, ordered_view_row) = 0
                c.fprintf(c.stderr, "trans registry view parity error: table row order differs for %s\n", descriptor\name)
                return: 1
            i: i + 1U

        default_legacy_row: lm_trans_registry_lookup_default_row_in_identifiers(c.lm_trans_registry->identifiers, descriptor\name)
        default_view_row: lm_registry_view_lookup_default(c.lm_trans_registry->view, descriptor\name)
        if: lm_trans_registry_view_row_same(default_legacy_row, default_view_row) = 0
            c.fprintf(c.stderr, "trans registry view parity error: default row differs for %s\n", descriptor\name)
            return: 1

        key_text: lm_trans_text_from_cstr("__lm_registry_view_missing__")
        if: key_text = 0
            return: 1
        selected_legacy_row: lm_trans_registry_lookup_row_in_identifiers(c.lm_trans_registry->identifiers, key_text, descriptor\name)
        if: selected_legacy_row = 0
            selected_view_row: lm_registry_view_lookup_text(c.lm_trans_registry->view, "__lm_registry_view_missing__", descriptor\name)
            if: lm_trans_registry_view_row_same(default_legacy_row, selected_view_row) = 0
                c.fprintf(c.stderr, "trans registry view parity error: missing/default selection differs for %s\n", descriptor\name)
                lm_trans_text_ref_destroy(@ key_text)
                return: 1
        ---
        lm_trans_text_ref_destroy(@ key_text)

        i: 0U
        while: i < table_row_count
            view_row: lm_table_descriptor_row_at(descriptor, i)
            if: view_row = 0 || view_row\key = 0
                return: 1

            first_key_row: 1
            j: 0U
            while: j < i
                candidate_view_row: lm_table_descriptor_row_at(descriptor, j)
                if: candidate_view_row != 0 && candidate_view_row\key != 0 && c.strcmp(candidate_view_row\key, view_row\key) = 0
                    first_key_row: 0
                    break
                j: j + 1U

            if: first_key_row = 0
                i: i + 1U
                continue

            key_text: lm_trans_text_from_cstr(view_row\key)
            if: key_text = 0
                return: 1
            key_stack: lm_trans_registry_relation_stack_in_identifiers(c.lm_trans_registry->identifiers, key_text, descriptor\name)
            matching_key_count: lm_registry_view_matching_key_count(c.lm_trans_registry->view, descriptor\name, view_row\key)
            if: (key_stack = 0 && matching_key_count != 0U) || (key_stack != 0 && key_stack\count != matching_key_count)
                c.fprintf(c.stderr, "trans registry view parity error: duplicate count differs for %s[%s]\n", descriptor\name, view_row\key)
                lm_trans_text_ref_destroy(@ key_text)
                return: 1
            matching_key_index: 0U
            while: matching_key_index < matching_key_count
                candidate_view_row: lm_registry_view_matching_key_at(c.lm_trans_registry->view, descriptor\name, view_row\key, matching_key_index)
                ordered_legacy_row: (cast: (const: LmTransRegistryFact) lm_own_ptr_stack_at(key_stack, matching_key_index))
                if: lm_trans_registry_view_row_same(ordered_legacy_row, candidate_view_row) = 0
                    c.fprintf(c.stderr, "trans registry view parity error: duplicate order differs for %s[%s]\n", descriptor\name, view_row\key)
                    lm_trans_text_ref_destroy(@ key_text)
                    return: 1
                matching_key_index: matching_key_index + 1U

            selected_legacy_row: lm_trans_registry_lookup_row_in_identifiers(c.lm_trans_registry->identifiers, key_text, descriptor\name)
            selected_view_row: lm_registry_view_lookup_exact(c.lm_trans_registry->view, view_row\key, descriptor\name)
            if: lm_trans_registry_view_row_same(selected_legacy_row, selected_view_row) = 0
                c.fprintf(c.stderr, "trans registry view parity error: latest row differs for %s[%s]\n", descriptor\name, view_row\key)
                lm_trans_text_ref_destroy(@ key_text)
                return: 1
            selected_view_row: lm_registry_view_lookup(c.lm_trans_registry->view, view_row\key, descriptor\name)
            if: lm_trans_registry_view_row_same(selected_legacy_row, selected_view_row) = 0
                c.fprintf(c.stderr, "trans registry view parity error: generic row selection differs for %s[%s]\n", descriptor\name, view_row\key)
                lm_trans_text_ref_destroy(@ key_text)
                return: 1

            default_legacy_row: lm_trans_registry_lookup_default_row_in_identifiers(c.lm_trans_registry->identifiers, descriptor\name)
            if: selected_legacy_row != 0 && selected_legacy_row\payload != 0
                default_legacy_row: selected_legacy_row
            selected_view_row: lm_registry_view_lookup_text(c.lm_trans_registry->view, view_row\key, descriptor\name)
            if: lm_trans_registry_view_row_same(default_legacy_row, selected_view_row) = 0
                c.fprintf(c.stderr, "trans registry view parity error: text exact/default selection differs for %s[%s]\n", descriptor\name, view_row\key)
                lm_trans_text_ref_destroy(@ key_text)
                return: 1
            lm_trans_text_ref_destroy(@ key_text)
            i: i + 1U

        descriptor_index: descriptor_index + 1U

return: 0

fn: lm_trans_registry_assert_selected_table_link (const: @(char source_table); const: (LmP0Text: key); const: @(char target_class_table); const: @(char target_table)) int
    LmP0Text: target_key
    int: target_has_class_row

    if: source_table = 0 || target_table = 0
        return: 1

    target_has_class_row: 1
    target_key: 0
    if: target_class_table != 0
        target_key: lm_trans_text_from_cstr(target_table)
        target_has_class_row: target_key != 0 && lm_trans_registry_has(target_key, target_class_table) != 0
        lm_trans_text_ref_destroy(@ target_key)
    if: target_has_class_row = 0
        c.fprintf(c.stderr, "trans registry inconsistency: %s[\"%.*s\"] points to %s, but %s has no class row for that target\n", source_table, (cast: int key\length), key\data, target_table, target_class_table)
        return: 1
    if: lm_trans_registry_has(key, target_table) = 0
        c.fprintf(c.stderr, "trans registry inconsistency: %s[\"%.*s\"] points to %s, but %s has no matching row for that key\n", source_table, (cast: int key\length), key\data, target_table, target_table)
        return: 1
return: 0

fn: lm_trans_registry_assert_payload_table_exists (const: @(char source_table); const: (LmP0Text: key); const: @(char target_table)) int
    if: source_table = 0 || target_table = 0
        return: 1
    if: lm_trans_registry_table_has_rows(target_table) = 0
        c.fprintf(c.stderr, "trans registry inconsistency: %s[\"%.*s\"] points to %s, but that table has no rows\n", source_table, (cast: int key\length), key\data, target_table)
        return: 1
return: 0

fn: lm_trans_registry_lookup_table_link_checked (const: (LmP0Text: key); const: @(char source_table); const: @(char target_class_table)) const: @: char
    const: @: char target_table

    target_table: lm_trans_registry_lookup(key, source_table)
    if: target_table != 0 && lm_trans_registry_assert_selected_table_link(source_table, key, target_class_table, target_table) != 0
        c.exit(2)
return: target_table

fn: lm_trans_namespace_registry_lookup (const: (LmTransNamespace: namespace_); const: (LmP0Text: key); const: @(char table)) const: @: char
    LmTransRegistryFact: row
    const: @: char payload

    if: namespace_ != 0 && namespace_\registry_identifiers != 0 && (c.lm_trans_registry = 0 || namespace_\registry_identifiers != c.lm_trans_registry->identifiers)
        row: lm_trans_registry_lookup_row_in_identifiers(namespace_\registry_identifiers, key, table)
        if: row != 0
            return: row\payload
    ---

    payload: lm_trans_registry_lookup_exact(key, table)
    if: payload != 0
        return: payload

    if: namespace_ != 0 && namespace_\registry_identifiers != 0 && (c.lm_trans_registry = 0 || namespace_\registry_identifiers != c.lm_trans_registry->identifiers)
        row: lm_trans_registry_lookup_default_row_in_identifiers(namespace_\registry_identifiers, table)
        if: row != 0
            return: row\payload
    ---

return: lm_trans_registry_lookup_default(table)

fn: lm_trans_namespace_registry_lookup_table_link_checked (const: (LmTransNamespace: namespace_); const: (LmP0Text: key); const: @(char source_table); const: @(char target_class_table)) const: @: char
    const: @: char target_table

    target_table: lm_trans_namespace_registry_lookup(namespace_, key, source_table)
    if: target_table != 0 && lm_trans_registry_assert_selected_table_link(source_table, key, target_class_table, target_table) != 0
        c.exit(2)
return: target_table

fn: lm_trans_array_head_find_close (const: (LmP0Text: text); size_t: open_index; @: size_t out_close_index) int
    size_t: i
    size_t: depth
    char: quote

    if: text = 0 || out_close_index = 0 || open_index >= text\length || text\data[open_index] != '['
        return: 0

    i: open_index
    depth: 0U
    while: i < text\length
        if: text\data[i] = '"' || text\data[i] = '`'
            quote: text\data[i]
            i: i + 1U
            while: i < text\length
                if: quote = '"' && text\data[i] = '\\'
                    i: i + 2U
                    continue
                if: quote = '`' && text\data[i] = '`' && i + 1U < text\length && text\data[i + 1U] = '`'
                    i: i + 2U
                    continue
                if: text\data[i] = quote
                    i: i + 1U
                    break
                i: i + 1U
            continue
        if: text\data[i] = '\''
            i: i + 1U
            while: i < text\length
                if: text\data[i] = '\\'
                    i: i + 2U
                    continue
                if: text\data[i] = '\''
                    i: i + 1U
                    break
                i: i + 1U
            continue
        if: text\data[i] = '['
            depth: depth + 1U
        else:
            if: text\data[i] = ']'
                depth: depth - 1U
                if: depth = 0U
                    out_close_index[0]: i
                    return: 1
        ---
        i: i + 1U
return: 0

fn: lm_trans_array_head_next_dimension (const: (LmP0Text: head); @: size_t index; LmP0Text: out_dimension) int
    size_t: close_index

    if: head = 0 || index = 0 || out_dimension = 0 || index[0] >= head\length || head\data[index[0]] != '['
        return: 0
    if: lm_trans_array_head_find_close(head, index[0], @ close_index) = 0
        return: 0

    out_dimension\data: head\data + index[0] + 1U
    out_dimension\length: close_index - index[0] - 1U
    index[0]: close_index + 1U
return: 1

fn: lm_trans_text_is_array_receiver_head (const: (LmP0Text: head)) int
    size_t: index
    size_t: count
    LmP0Text: dimension

    index: 0U
    count: 0U
    if: head = 0
        return: 0
    dimension: lm_trans_text_ref_new_cstr("")
    if: dimension = 0
        return: 0
    while: index < head\length
        if: lm_trans_array_head_next_dimension(head, @ index, dimension) = 0
            lm_trans_text_ref_destroy(@ dimension)
            return: 0
        count: count + 1U

    lm_trans_text_ref_destroy(@ dimension)
return: count > 0U
