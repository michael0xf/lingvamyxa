fn: lm_trans_registry_text_is_numeric_atom (const: (LmP0Text: text)) int
    size_t: i
    int: saw_digit
    int: saw_dot
    char: ch

    if: text = 0 || text\data = 0 || text\length = 0U
        return: 0

    i: 0U
    if: text\data[i] = '-' || text\data[i] = '+'
        i: i + 1U
    if: i >= text\length
        return: 0

    saw_digit: 0
    saw_dot: 0
    while: i < text\length
        ch: text\data[i]
        if: ch >= '0' && ch <= '9'
            saw_digit: 1
            i: i + 1U
            continue
        if: ch = '.' && saw_dot = 0
            saw_dot: 1
            i: i + 1U
            continue
        break

    if: saw_digit = 0
        return: 0

    while: i < text\length
        ch: text\data[i]
        if: ch != 'u' && ch != 'U' && ch != 'l' && ch != 'L' && ch != 'f' && ch != 'F'
            return: 0
        i: i + 1U

return: 1

