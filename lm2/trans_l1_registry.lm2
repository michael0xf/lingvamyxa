const: @: char lm_trans_current_source_path
LmOwnPtrStack: lm_trans_declared_import_paths
LmOwnPtrStack: lm_trans_declared_import_documents
LmOwnPtrStack: lm_trans_emitted_import_prelude_paths
LmOwnPtrStack: lm_trans_emitted_import_function_paths
