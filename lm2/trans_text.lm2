import: "lm4/own_abi.lm4"

fn: lm_trans_text_equals (const: (LmP0Text: text); const: @(char value)) int
    size_t: length

    if: text = 0 || value = 0
        return: 0
    length: c.strlen(value)
return: text\length = length && c.memcmp(text\data, value, length) = 0

fn: lm_trans_text_same (const: (LmP0Text: left); const: (LmP0Text: right)) int
    if: left = 0 || right = 0
        return: 0
    if: left\length != right\length
        return: 0
    if: left\length = 0U
        return: 1
return: c.memcmp(left\data, right\data, left\length) = 0

fn: lm_trans_text_starts_with (const: (LmP0Text: text); const: @(char prefix)) int
    size_t: length

    if: text = 0 || prefix = 0
        return: 0
    length: c.strlen(prefix)
return: text\length >= length && c.memcmp(text\data, prefix, length) = 0

fn: lm_trans_identifier_payload (const: (LmP0Text: atom); LmP0Text: out_payload) int
    if: atom = 0 || out_payload = 0 || atom\data = 0
        return: 0

    out_payload\data: atom\data
    out_payload\length: atom\length
    if: atom\length >= 2U && atom\data[0] = '`' && atom\data[atom\length - 1U] = '`'
        out_payload\data: atom\data + 1U
        out_payload\length: atom\length - 2U

return: 1

fn: lm_trans_identifier_same (const: (LmP0Text: left); const: (LmP0Text: right)) int
    LmP0Text: left_payload
    LmP0Text: right_payload
    int: same

    left_payload: c.lm_trans_text_ref_new_cstr("")
    right_payload: c.lm_trans_text_ref_new_cstr("")
    if: left_payload = 0 || right_payload = 0
        c.lm_trans_text_ref_destroy(@ left_payload)
        c.lm_trans_text_ref_destroy(@ right_payload)
        return: 0

    if: lm_trans_identifier_payload(left, left_payload) = 0 || lm_trans_identifier_payload(right, right_payload) = 0
        c.lm_trans_text_ref_destroy(@ left_payload)
        c.lm_trans_text_ref_destroy(@ right_payload)
        return: 0

    same: lm_trans_text_same(left_payload, right_payload)
    c.lm_trans_text_ref_destroy(@ left_payload)
    c.lm_trans_text_ref_destroy(@ right_payload)
return: same

fn: lm_trans_emit_identifier (FILE: file; const: (LmP0Text: name)) int
    LmP0Text: payload
    int: status

    payload: c.lm_trans_text_ref_new_cstr("")
    if: payload = 0
        return: 1

    if: lm_trans_identifier_payload(name, payload) = 0
        c.lm_trans_text_ref_destroy(@ payload)
        return: 1
    status: lm_trans_write_text(file, payload)
    c.lm_trans_text_ref_destroy(@ payload)
return: status

fn: lm_trans_registry_identifier_value (const: (LmP0Text: atom); LmP0Text: out_payload) int
    if: atom = 0 || out_payload = 0
        return: 0
    if: atom\length > 0U && (atom\data[0] = '"' || atom\data[0] = '\'')
        return: 0
return: lm_trans_identifier_payload(atom, out_payload)

fn: lm_trans_registry_literal_value (const: (LmP0Text: atom); LmP0Text: out_payload) int
    char: quote

    if: atom = 0 || out_payload = 0 || atom\data = 0
        return: 0

    out_payload\data: atom\data
    out_payload\length: atom\length
    if: atom\length < 2U
        return: 1

    quote: atom\data[0]
    if: (quote = '"' || quote = '\'') && atom\data[atom\length - 1U] = quote
        out_payload\data: atom\data + 1U
        out_payload\length: atom\length - 2U
        return: 1

return: lm_trans_identifier_payload(atom, out_payload)

fn: lm_trans_registry_payload_is_null (const: (LmP0Text: atom)) int
    LmP0Text: payload
    int: is_null

    payload: c.lm_trans_text_ref_new_cstr("")
    if: payload = 0
        return: 0
    if: lm_trans_registry_identifier_value(atom, payload) = 0
        c.lm_trans_text_ref_destroy(@ payload)
        return: 0
    is_null: payload\length = 4U && c.memcmp(payload\data, "None", 4U) = 0
    c.lm_trans_text_ref_destroy(@ payload)
return: is_null

fn: lm_trans_text_copy_cstr (const: (LmP0Text: text)) @: char
    if: text = 0
        return: 0
return: lm_own_copy_bytes(text\data, text\length)

fn: lm_trans_text_copy_cstr_from_cstr (const: @(char text)) @: char
    LmP0Text: view
    @: char copy

    view: lm_trans_text_from_cstr(text)
    if: view = 0
        return: 0
    copy: lm_trans_text_copy_cstr(view)
    c.lm_trans_text_ref_destroy(@ view)
return: copy

fn: lm_trans_registry_value_copy_cstr (const: (LmP0Text: value)) @: char
    @: char copy
    size_t: length

    if: value = 0
        return: 0

    length: value\length
    copy: lm_own_arena_new_zero(c.lm_trans_registry->value_arena, length + 1U)
    if: copy = 0
        return: 0
    if: length != 0U
        c.memcpy(copy, value\data, length)
    copy[length]: '\0'
return: copy

fn: lm_trans_registry_clone_text (const: (LmP0Text: source); LmP0Text: out_text) int
    @: char copy

    if: out_text = 0
        return: 1

    out_text\data: ""
    out_text\length: 0U
    if: source = 0
        return: 1
    if: source\length = 0U
        return: 0
    if: source\data = 0
        return: 1

    copy: lm_own_arena_copy_bytes(c.lm_trans_registry->value_arena, source\data, source\length)
    if: copy = 0
        return: 1

    out_text\data: copy
    out_text\length: source\length
return: 0

fn: lm_trans_text_from_cstr (const: @(char text)) LmP0Text
    return: c.lm_trans_text_ref_new_cstr(text)

fn: lm_trans_text_assign_cstr (LmP0Text: out_text; const: @(char text)) int
    if: out_text = 0
        return: 0
    if: text = 0
        text: ""
    out_text\data: text
    out_text\length: c.strlen(text)
return: 1

fn: lm_trans_text_all_char (const: (LmP0Text: text); char: ch) int
    size_t: i
    size_t: length

    if: text = 0
        return: 0

    length: text\length
    if: length = 0U
        return: 0

    i: 0U
    while: i < length
        if: text\data[i] != ch
            return: 0
        i: i + 1U

return: 1

fn: lm_trans_write_all (FILE: file; const: @(char data); size_t: length) int
    if: c.fwrite(data, 1U, length, file) = length
        return: 0
return: 1

fn: lm_trans_put (FILE: file; const: @(char text)) int
    if: c.fputs(text, file) < 0
        return: 1
return: 0

fn: lm_trans_prelude_file (FILE: fallback) FILE
    if: c.lm_trans_prelude_output != 0
        return: c.lm_trans_prelude_output
return: fallback

fn: lm_trans_write_text (FILE: file; const: (LmP0Text: text)) int
    if: text = 0
        return: 1
return: lm_trans_write_all(file, text\data, text\length)

fn: lm_trans_emit_indent (FILE: file; unsigned: indent) int
    unsigned: i

    i: 0U
    while: i < indent
        if: lm_trans_put(file, "    ") != 0
            return: 1
        i: i + 1U
    ---

return: 0

fn: lm_trans_nth_field (const: (LmP0Structure: structure); size_t: index) const: LmP0Field
    const: LmP0Field: field
    size_t: i

    field: c.structure->first_field
    i: 0U
    while: field != 0 && i < index
        field: field\next
        i: i + 1U
    ---

return: field
