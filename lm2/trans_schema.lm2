                 hash                  ulong                 2                       0
                 symbols               LmOwnPtrStack         3                       1
                 relation_buckets      LmTransIdentifierRelation 4                  2
                 relation_bucket_count size_t                5                       0
                 next                  LmTransIdentifierCard 6                       1
    end: LmTransIdentifierCard

