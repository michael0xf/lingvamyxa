        end: lm_rest_lmx_http_client_invalid_provider_configuration

    `LM_REST_LMX_CLIENT_PROVIDER == LM_REST_LMX_CLIENT_PROVIDER_WINHTTP && !defined(_WIN32)`:
        fn: lm_rest_lmx_http_client_invalid_winhttp_target () int
            return: c.LM_REST_LMX_CLIENT_PROVIDER_WINHTTP_REQUIRES_WINDOWS
        end: lm_rest_lmx_http_client_invalid_winhttp_target

    `LM_REST_LMX_CLIENT_PROVIDER == LM_REST_LMX_CLIENT_PROVIDER_LIBCURL`:
        include: "<curl/curl.h>"

        fn: lm_rest_lmx_http_ascii_prefix (const: @(char text); const: @(char prefix)) int
            size_t: index 0U
            uchar: left
            uchar: right

            if: text = 0 || prefix = 0
                return: 0
            while: prefix[index] != '\0'
                left: (cast: uchar text[index])
                right: (cast: uchar prefix[index])
                if: left >= (cast: uchar 'A') && left <= (cast: uchar 'Z')
                    left: (cast: uchar (left + ((cast: uchar 'a') - (cast: uchar 'A'))))
                if: right >= (cast: uchar 'A') && right <= (cast: uchar 'Z')
                    right: (cast: uchar (right + ((cast: uchar 'a') - (cast: uchar 'A'))))
                if: left = (cast: uchar '\0') || left != right
                    return: 0
                index: index + 1U
            return: 1
        end: lm_rest_lmx_http_ascii_prefix

        fn: lm_rest_lmx_http_uri_is_supported (const: @(char uri)) int
            return: lm_rest_lmx_http_ascii_prefix(uri, "http://") || lm_rest_lmx_http_ascii_prefix(uri, "https://")
        end: lm_rest_lmx_http_uri_is_supported

        fn: lm_rest_lmx_http_discard_response (@: char data; size_t: size; size_t: count; @: void context) size_t
            c.LM_UNUSED(data)
            c.LM_UNUSED(context)
            if: size != 0U && count > c.SIZE_MAX / size
                return: 0U
            return: size * count
        end: lm_rest_lmx_http_discard_response

        ifdef:
            `LIBCURL_VERSION_NUM >= 0x075500`:
                fn: lm_rest_lmx_http_configure_protocols (LmCurlEasy: easy) int
                    if: c.curl_easy_setopt(easy, c.CURLOPT_PROTOCOLS_STR, "http,https") != c.CURLE_OK
                        return: 1
                    return: 0
                end: lm_rest_lmx_http_configure_protocols
            default:
                fn: lm_rest_lmx_http_configure_protocols (LmCurlEasy: easy) int
                    if: c.curl_easy_setopt(easy, c.CURLOPT_PROTOCOLS, (cast: long (c.CURLPROTO_HTTP | c.CURLPROTO_HTTPS))) != c.CURLE_OK
                        return: 1
                    return: 0
                end: lm_rest_lmx_http_configure_protocols
        end: ifdef

        sub: lm_rest_lmx_http_client_destroy (@: void opaque_context)
            LmRestLmxHttpClientContext: context 0

            context: (cast: LmRestLmxHttpClientContext opaque_context)
            if: context = 0
                return
            if: context\curl_initialized
                c.curl_global_cleanup()
                context\curl_initialized: 0
            c.free(context)
        end: lm_rest_lmx_http_client_destroy

        fn: lm_rest_lmx_http_client_post (@: void opaque_context; const: @(char normalized_uri); const: @(char body); size_t: length; @: unsigned out_http_status) int
            LmRestLmxHttpClientContext: context 0
            @: c.CURL easy 0
            @: c.LmCurlSlist headers 0
            @: c.LmCurlSlist updated_headers 0
            LmCurlOffset: post_length
            LmCurlCode: result
            long: response_code 0L
            const: @(char post_body)

            finally:
                c.curl_slist_free_all(headers)
                if: easy != 0
                    c.curl_easy_cleanup(easy)
                ---

            context: (cast: LmRestLmxHttpClientContext opaque_context)
            if: out_http_status != 0
                out_http_status[0]: 0U
            if: context = 0 || context\curl_initialized = 0 || normalized_uri = 0 || out_http_status = 0 || (body = 0 && length != 0U) || lm_rest_lmx_http_uri_is_supported(normalized_uri) = 0
                return: 1

            post_length: (cast: LmCurlOffset length)
            if: post_length < (cast: LmCurlOffset 0) || (cast: size_t post_length) != length
                return: 1

            easy: c.curl_easy_init()
            if: easy = 0
                return: 1
            headers: c.curl_slist_append(0, "Content-Type: application/lmx")
            if: headers = 0
                return: 1
            updated_headers: c.curl_slist_append(headers, "Accept: application/lmx")
            if: updated_headers = 0
                return: 1
            headers: updated_headers

            post_body: body
            if: post_body = 0
                post_body: ""

            if: c.curl_easy_setopt(easy, c.CURLOPT_URL, normalized_uri) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_POST, 1L) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_POSTFIELDS, post_body) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_POSTFIELDSIZE_LARGE, post_length) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_HTTPHEADER, headers) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_FOLLOWLOCATION, 0L) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_MAXREDIRS, 0L) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_PATH_AS_IS, 1L) != c.CURLE_OK
                return: 1
            if: lm_rest_lmx_http_configure_protocols(easy) != 0
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_NOSIGNAL, 1L) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_CONNECTTIMEOUT_MS, 10000L) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_TIMEOUT_MS, 30000L) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_SSL_VERIFYPEER, 1L) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_SSL_VERIFYHOST, 2L) != c.CURLE_OK
                return: 1
            if: c.curl_easy_setopt(easy, c.CURLOPT_WRITEFUNCTION, @lm_rest_lmx_http_discard_response) != c.CURLE_OK
                return: 1

            result: c.curl_easy_perform(easy)
            if: result != c.CURLE_OK || c.curl_easy_getinfo(easy, c.CURLINFO_RESPONSE_CODE, @response_code) != c.CURLE_OK || response_code < 0L || (cast: ulong response_code) > (cast: ulong c.UINT_MAX)
                return: 1
            out_http_status[0]: (cast: unsigned response_code)
            return: 0
        end: lm_rest_lmx_http_client_post

        external:
            fn: lm_rest_lmx_http_client_provider_name () const: @(char)
                return: "libcurl"
            end: lm_rest_lmx_http_client_provider_name
        end: external

        external:
            fn: lm_rest_lmx_http_client_install_default (LmMessageThreadRuntime: runtime) int
                LmRestLmxHttpClientContext: context 0
                LmRestLmxProviderOpsV1: ops 0

                finally:
                    c.free(ops)
                    if: context != 0
                        lm_rest_lmx_http_client_destroy(context)
                    ---

                if: runtime = 0
                    return: 1
                context: (cast: LmRestLmxHttpClientContext c.calloc(1U, c.sizeof(context[0])))
                ops: (cast: LmRestLmxProviderOpsV1 c.calloc(1U, c.sizeof(ops[0])))
                if: context = 0 || ops = 0
                    return: 1
                if: c.curl_global_init(c.CURL_GLOBAL_DEFAULT) != c.CURLE_OK
                    return: 1
                context\curl_initialized: 1
                ops\abi_size: c.sizeof(ops[0])
                ops\post: @lm_rest_lmx_http_client_post
                ops\destroy: @lm_rest_lmx_http_client_destroy
                if: lm_message_thread_runtime_set_rest_lmx_provider(runtime, ops, context) != 0
                    return: 1
                context: 0
                return: 0
            end: lm_rest_lmx_http_client_install_default
        end: external

    `LM_REST_LMX_CLIENT_PROVIDER == LM_REST_LMX_CLIENT_PROVIDER_WINHTTP`:
        include: "<windows.h>" "<winhttp.h>"

        fn: lm_rest_lmx_http_wide_uri (const: @(char uri)) @: LmWinWideChar
            size_t: length
            int: wide_length
            @: LmWinWideChar wide_uri 0

            if: uri = 0
                return: 0
            length: c.strlen(uri)
            if: length > (cast: size_t c.INT_MAX) - 1U
                return: 0
            wide_length: c.MultiByteToWideChar(c.CP_UTF8, c.MB_ERR_INVALID_CHARS, uri, -1, 0, 0)
            if: wide_length <= 0 || (cast: size_t wide_length) > c.SIZE_MAX / c.sizeof(wide_uri[0])
                return: 0
            wide_uri: (cast: (@: LmWinWideChar) c.calloc((cast: size_t wide_length), c.sizeof(wide_uri[0])))
            if: wide_uri = 0 || c.MultiByteToWideChar(c.CP_UTF8, c.MB_ERR_INVALID_CHARS, uri, -1, wide_uri, wide_length) != wide_length
                c.free(wide_uri)
                return: 0
            return: wide_uri
        end: lm_rest_lmx_http_wide_uri

        fn: lm_rest_lmx_http_wide_slice (const: @(LmWinWideChar source); LmWinDword: length) @: LmWinWideChar
            @: LmWinWideChar copy 0

            if: source = 0 || (cast: size_t length) > c.SIZE_MAX / c.sizeof(copy[0]) - 1U
                return: 0
            copy: (cast: (@: LmWinWideChar) c.calloc((cast: size_t length) + 1U, c.sizeof(copy[0])))
            if: copy = 0
                return: 0
            if: length != 0U
                c.memcpy(copy, source, (cast: size_t length) * c.sizeof(copy[0]))
            return: copy
        end: lm_rest_lmx_http_wide_slice

        sub: lm_rest_lmx_http_client_destroy (@: void opaque_context)
            LmRestLmxHttpClientContext: context 0

            context: (cast: LmRestLmxHttpClientContext opaque_context)
            if: context = 0
                return
            if: context\session != 0
                c.WinHttpCloseHandle(context\session)
                context\session: 0
            c.free(context)
        end: lm_rest_lmx_http_client_destroy

        fn: lm_rest_lmx_http_client_post (@: void opaque_context; const: @(char normalized_uri); const: @(char body); size_t: length; @: unsigned out_http_status) int
            LmRestLmxHttpClientContext: context 0
            @: LmWinWideChar wide_uri 0
            @: LmWinWideChar host 0
            @: LmWinWideChar path 0
            LmWinUrlComponents: components
            @: void connection 0
            @: void request 0
            @: void request_body 0
            LmWinDword: request_flags c.WINHTTP_FLAG_ESCAPE_DISABLE
            LmWinDword: disabled_features c.WINHTTP_DISABLE_REDIRECTS
            LmWinDword: body_length (cast: LmWinDword length)
            LmWinDword: response_status 0U
            LmWinDword: response_status_size (cast: LmWinDword c.sizeof(response_status))

            finally:
                if: request != 0
                    c.WinHttpCloseHandle(request)
                if: connection != 0
                    c.WinHttpCloseHandle(connection)
                c.free(path)
                c.free(host)
                c.free(wide_uri)

            context: (cast: LmRestLmxHttpClientContext opaque_context)
            if: out_http_status != 0
                out_http_status[0]: 0U
            if: context = 0 || context\session = 0 || normalized_uri = 0 || out_http_status = 0 || (body = 0 && length != 0U) || (cast: size_t body_length) != length
                return: 1
            wide_uri: lm_rest_lmx_http_wide_uri(normalized_uri)
            if: wide_uri = 0
                return: 1

            c.memset(@components, 0, c.sizeof(components))
            c.components.dwStructSize: c.sizeof(components)
            c.components.dwSchemeLength: (cast: LmWinDword -1)
            c.components.dwHostNameLength: (cast: LmWinDword -1)
            c.components.dwUrlPathLength: (cast: LmWinDword -1)
            c.components.dwExtraInfoLength: (cast: LmWinDword -1)
            if: c.WinHttpCrackUrl(wide_uri, 0U, 0U, @components) = 0 || (c.components.nScheme != c.INTERNET_SCHEME_HTTP && c.components.nScheme != c.INTERNET_SCHEME_HTTPS) || c.components.lpszHostName = 0 || c.components.dwHostNameLength = 0U || c.components.dwExtraInfoLength != 0U
                return: 1
            host: lm_rest_lmx_http_wide_slice(c.components.lpszHostName, c.components.dwHostNameLength)
            if: c.components.lpszUrlPath != 0 && c.components.dwUrlPathLength != 0U
                path: lm_rest_lmx_http_wide_slice(c.components.lpszUrlPath, c.components.dwUrlPathLength)
            if: path = 0 && (c.components.lpszUrlPath = 0 || c.components.dwUrlPathLength = 0U)
                path: lm_rest_lmx_http_wide_slice(c.LM_REST_LMX_WINHTTP_ROOT_PATH, 1U)
            if: host = 0 || path = 0
                return: 1

            connection: c.WinHttpConnect(context\session, host, c.components.nPort, 0U)
            if: connection = 0
                return: 1
            if: c.components.nScheme = c.INTERNET_SCHEME_HTTPS
                request_flags: request_flags | c.WINHTTP_FLAG_SECURE
            request: c.WinHttpOpenRequest(connection, c.LM_REST_LMX_WINHTTP_METHOD, path, 0, c.WINHTTP_NO_REFERER, c.WINHTTP_DEFAULT_ACCEPT_TYPES, request_flags)
            if: request = 0
                return: 1
            if: body_length != 0U
                request_body: (cast: (@: void) body)
            if: c.WinHttpSetOption(request, c.WINHTTP_OPTION_DISABLE_FEATURE, @disabled_features, c.sizeof(disabled_features)) = 0
                return: 1
            if: c.WinHttpSetTimeouts(request, 10000, 10000, 30000, 30000) = 0
                return: 1
            if: c.WinHttpAddRequestHeaders(request, c.LM_REST_LMX_WINHTTP_HEADERS, (cast: LmWinDword -1), c.WINHTTP_ADDREQ_FLAG_ADD | c.WINHTTP_ADDREQ_FLAG_REPLACE) = 0
                return: 1
            if: c.WinHttpSendRequest(request, c.WINHTTP_NO_ADDITIONAL_HEADERS, 0U, request_body, body_length, body_length, 0U) = 0
                return: 1
            if: c.WinHttpReceiveResponse(request, 0) = 0
                return: 1
            if: c.WinHttpQueryHeaders(request, c.WINHTTP_QUERY_STATUS_CODE | c.WINHTTP_QUERY_FLAG_NUMBER, c.WINHTTP_HEADER_NAME_BY_INDEX, @response_status, @response_status_size, c.WINHTTP_NO_HEADER_INDEX) = 0
                return: 1
            out_http_status[0]: (cast: unsigned response_status)
            return: 0
        end: lm_rest_lmx_http_client_post

        external:
            fn: lm_rest_lmx_http_client_provider_name () const: @(char)
                return: "winhttp"
            end: lm_rest_lmx_http_client_provider_name
        end: external

        external:
            fn: lm_rest_lmx_http_client_install_default (LmMessageThreadRuntime: runtime) int
                LmRestLmxHttpClientContext: context 0
                LmRestLmxProviderOpsV1: ops 0

                finally:
                    c.free(ops)
                    if: context != 0
                        lm_rest_lmx_http_client_destroy(context)
                    ---

                if: runtime = 0
                    return: 1
                context: (cast: LmRestLmxHttpClientContext c.calloc(1U, c.sizeof(context[0])))
                ops: (cast: LmRestLmxProviderOpsV1 c.calloc(1U, c.sizeof(ops[0])))
                if: context = 0 || ops = 0
                    return: 1
                context\session: c.WinHttpOpen(c.LM_REST_LMX_WINHTTP_USER_AGENT, c.WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, c.WINHTTP_NO_PROXY_NAME, c.WINHTTP_NO_PROXY_BYPASS, 0U)
                if: context\session = 0
                    return: 1
                ops\abi_size: c.sizeof(ops[0])
                ops\post: @lm_rest_lmx_http_client_post
                ops\destroy: @lm_rest_lmx_http_client_destroy
                if: lm_message_thread_runtime_set_rest_lmx_provider(runtime, ops, context) != 0
                    return: 1
                context: 0
                return: 0
            end: lm_rest_lmx_http_client_install_default
        end: external

    default:
        external:
            fn: lm_rest_lmx_http_client_provider_name () const: @(char)
                return: "none"
            end: lm_rest_lmx_http_client_provider_name
        end: external

        external:
            fn: lm_rest_lmx_http_client_install_default (LmMessageThreadRuntime: runtime) int
                if: runtime = 0
                    return: 1
                return: lm_message_thread_runtime_set_rest_lmx_provider(runtime, 0, 0)
            end: lm_rest_lmx_http_client_install_default
        end: external
end: ifdef
