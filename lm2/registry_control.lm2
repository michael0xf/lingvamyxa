import: "lm4/own_abi.lm4"
import: "lm4/parser_abi.lm4"

include: "<stdint.h>" "<stdio.h>" "<stdlib.h>" "<string.h>"

fn: lm_registry_control_text_equals (const: @(char data); size_t: text_length; const: @: char value) int
    size_t: length

    length: c.strlen(value)
return: text_length = length && c.memcmp(data, value, length) = 0

fn: lm_registry_control_text_equals_text (const: (LmP0Text: text); const: @: char value) int
    if: text = 0
        return: 0
return: lm_registry_control_text_equals(text\data, text\length, value)

sub: lm_registry_control_error_set (LmRegistryControlError: error; const: @: char message)
    if: error = 0 || error\message != 0
        return

    error\message: message
end: lm_registry_control_error_set

fn: lm_registry_control_buffer_reserve (LmRegistryControlBuffer: buffer; size_t: extra) int
    @: char new_data
    size_t: new_capacity
    size_t: required

    if: buffer = 0 || buffer\failed != 0
        return: 0

    required: buffer\length + extra + 1U
    if: required <= buffer\capacity
        return: 1

    if: buffer\capacity = 0U
        new_capacity: 256U
    if: buffer\capacity != 0U
        new_capacity: buffer\capacity
    ---

    while: new_capacity < required
        if: new_capacity > c.SIZE_MAX / 2U
            buffer\failed: 1
            return: 0
        new_capacity: new_capacity * 2U

    new_data: lm_own_resize(buffer\data, new_capacity)
    if: new_data = 0
        buffer\failed: 1
        return: 0

    buffer\data: new_data
    buffer\capacity: new_capacity
return: 1

sub: lm_registry_control_buffer_append (LmRegistryControlBuffer: buffer; const: @(char data); size_t: length)
    if: lm_registry_control_buffer_reserve(buffer, length) = 0
        return

    if: length != 0U
        c.memcpy(buffer\data + buffer\length, data, length)
    buffer\length: buffer\length + length
    buffer\data[buffer\length]: '\0'
end: lm_registry_control_buffer_append

sub: lm_registry_control_buffer_append_cstr (LmRegistryControlBuffer: buffer; const: @: char text)
    lm_registry_control_buffer_append(buffer, text, c.strlen(text))
end: lm_registry_control_buffer_append_cstr

sub: lm_registry_control_buffer_append_text (LmRegistryControlBuffer: buffer; const: @(char data); size_t: length)
    lm_registry_control_buffer_append(buffer, data, length)
end: lm_registry_control_buffer_append_text

sub: lm_registry_control_buffer_append_spaces (LmRegistryControlBuffer: buffer; size_t: count)
    while: count != 0U
        lm_registry_control_buffer_append_cstr(buffer, " ")
        count: count - 1U
end: lm_registry_control_buffer_append_spaces

fn: lm_registry_control_buffer_take (LmRegistryControlBuffer: buffer) @: char
    @: char result

    if: buffer = 0 || buffer\failed != 0
        return: 0

    if: lm_registry_control_buffer_reserve(buffer, 0U) = 0
        return: 0

    result: buffer\data
    buffer\data: 0
    buffer\length: 0U
    buffer\capacity: 0U
return: result

sub: lm_registry_control_buffer_destroy (LmRegistryControlBuffer: buffer)
    if: buffer != 0
        lm_own_delete(buffer\data, 0)
        buffer\data: 0
        buffer\length: 0U
        buffer\capacity: 0U
        buffer\failed: 0
end: lm_registry_control_buffer_destroy

fn: lm_registry_control_buffer_new () LmRegistryControlBuffer
    return: lm_own_new_zero(1U * c.sizeof(c.LmRegistryControlBuffer))

sub: lm_registry_control_buffer_delete (LmRegistryControlBuffer: buffer)
    if: buffer != 0
        lm_registry_control_buffer_destroy(buffer)
        lm_own_delete(buffer, 0)
end: lm_registry_control_buffer_delete

fn: lm_registry_control_error_new () LmRegistryControlError
    return: lm_own_new_zero(1U * c.sizeof(c.LmRegistryControlError))

sub: lm_registry_control_error_delete (LmRegistryControlError: error)
    lm_own_delete(error, 0)
end: lm_registry_control_error_delete

fn: lm_registry_control_rename_new () LmRegistryControlRename
    return: lm_own_new_zero(1U * c.sizeof(c.LmRegistryControlRename))

sub: lm_registry_control_rename_delete (LmRegistryControlRename: rename)
    lm_own_delete(rename, 0)
end: lm_registry_control_rename_delete

fn: lm_registry_control_node_ignored (const: (LmP0Node: node)) int
return: node = 0 || (node\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX)) != 0U

fn: lm_registry_control_visible_field_count (const: (LmP0Structure: structure)) size_t
    const: LmP0Field: field
    size_t: count

    count: 0U
    if: structure = 0
        return: 0U

    field: structure\first_field
    while: field != 0
        if: lm_registry_control_node_ignored(field\value) = 0
            count: count + 1U
        field: field\next

return: count

fn: lm_registry_control_nth_visible_field (const: (LmP0Structure: structure); size_t: index) const: LmP0Node
    const: LmP0Field: field
    size_t: current

    if: structure = 0
        return: 0

    current: 0U
    field: structure\first_field
    while: field != 0
        if: lm_registry_control_node_ignored(field\value) = 0
            if: current = index
                return: field\value
            current: current + 1U
        field: field\next

return: 0

fn: lm_registry_control_find_child_frame (const: (LmP0Frame: frame); const: @: char head) const: LmP0Frame
    const: LmP0Field: field
    const: LmP0Node: node

    if: frame = 0
        return: 0

    field: frame\body\first_field
    while: field != 0
        node: field\value
        if: lm_registry_control_node_ignored(node) = 0 && node\kind = c.LM_P0_NODE_FRAME && lm_registry_control_text_equals(node\as\frame\head\data, node\as\frame\head\length, head)
            return: node\as\frame
        field: field\next

return: 0

fn: lm_registry_control_single_body_node (const: (LmP0Frame: frame)) const: LmP0Node
    if: frame = 0 || lm_registry_control_visible_field_count(frame\body) != 1U
        return: 0

return: lm_registry_control_nth_visible_field(frame\body, 0U)

fn: lm_registry_control_table_name_from_frame (const: (LmP0Frame: table_frame); const: @@(char out_name_data); @: size_t out_name_length; LmRegistryControlError: error) int
    const: LmP0Frame: name_frame
    const: LmP0Node: name_node

    name_frame: lm_registry_control_find_child_frame(table_frame, "name")
    if: name_frame = 0
        lm_registry_control_error_set(error, "table must contain name:")
        return: 0

    name_node: lm_registry_control_single_body_node(name_frame)
    if: name_node = 0 || name_node\kind != c.LM_P0_NODE_ATOM
        lm_registry_control_error_set(error, "table name: expects exactly one atom")
        return: 0

    out_name_data[0]: name_node\as\atom\data
    out_name_length[0]: name_node\as\atom\length
return: 1

fn: lm_registry_control_column_spelling_frame_new (const: (LmP0Field: field)) LmRegistryControlColumnSpellingFrame
    LmRegistryControlColumnSpellingFrame: frame

    frame: lm_own_new_zero(c.sizeof(c.LmRegistryControlColumnSpellingFrame))
    if: frame = 0
        return: 0
    frame\field: field
    frame\first: 1
return: frame

fn: lm_registry_control_column_spelling_append_node (LmRegistryControlBuffer: buffer; const: (LmP0Node: node)) int
    LmOwnPtrStack: stack
    LmRegistryControlColumnSpellingFrame: frame
    const: LmP0Node: current
    int: done
    int: status

    if: node = 0
        return: 0

    stack: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
    if: stack = 0
        return: 0
    lm_own_ptr_stack_init(stack, c.lm_own_delete_plain)

    current: node
    done: 0
    status: 1
    while: status != 0 && done = 0
        if: current != 0
            if: current\kind = c.LM_P0_NODE_ATOM || current\kind = c.LM_P0_NODE_DISABLED
                lm_registry_control_buffer_append_text(buffer, current\as\atom\data, current\as\atom\length)
                if: buffer\failed != 0
                    status: 0
                current: 0
                continue
            if: current\kind != c.LM_P0_NODE_STRUCTURE
                status: 0
                current: 0
                continue
            lm_registry_control_buffer_append_cstr(buffer, "(")
            if: buffer\failed != 0
                status: 0
                current: 0
                continue
            frame: lm_registry_control_column_spelling_frame_new(current\as\structure\first_field)
            if: frame = 0
                status: 0
                current: 0
                continue
            if: lm_own_ptr_stack_push(stack, frame) != 0
                lm_own_delete(frame, 0)
                status: 0
                current: 0
                continue
            current: 0
            continue

        frame: lm_own_ptr_stack_top(stack)
        if: frame = 0
            done: 1
            continue

        while: frame\field != 0 && lm_registry_control_node_ignored(frame\field\value) != 0
            frame\field: frame\field\next

        if: frame\field = 0
            lm_registry_control_buffer_append_cstr(buffer, ")")
            lm_own_delete(lm_own_ptr_stack_pop(stack), 0)
            if: buffer\failed != 0
                status: 0
            continue

        if: frame\first = 0
            lm_registry_control_buffer_append_cstr(buffer, " ")
            if: buffer\failed != 0
                status: 0
                continue
            ---

        current: frame\field\value
        frame\field: frame\field\next
        frame\first: 0

    lm_own_ptr_stack_destroy(stack)
    lm_own_delete(stack, 0)
return: status != 0 && buffer\failed = 0

fn: lm_registry_control_column_spelling_alloc (const: (LmP0Node: node); LmRegistryControlError: error) @: char
    LmRegistryControlBuffer: buffer
    @: char result

    buffer: lm_registry_control_buffer_new()
    if: buffer = 0
        lm_registry_control_error_set(error, "out of memory while creating column formatter")
        return: 0
    finally: lm_registry_control_buffer_delete(buffer)

    if: lm_registry_control_column_spelling_append_node(buffer, node) = 0
        lm_registry_control_error_set(error, "columns: cannot format column descriptor")
        return: 0

    result: lm_registry_control_buffer_take(buffer)
    if: result = 0
        lm_registry_control_error_set(error, "out of memory while formatting column")
return: result

sub: lm_registry_control_columns_destroy (@: LmRegistryControlColumn columns; size_t: count)
    size_t: index

    if: columns = 0
        return

    index: 0U
    while: index < count
        if: columns[index] != 0
            lm_own_delete(columns[index]\spelling, 0)
            lm_own_delete(columns[index], 0)
        index: index + 1U
    lm_own_delete(columns, 0)
end: lm_registry_control_columns_destroy

fn: lm_registry_control_columns_from_frame (
    const: LmP0Frame: table_frame
    @@: LmRegistryControlColumn out_columns
    @: size_t out_count
    LmRegistryControlError: error
) int
    const: LmP0Frame: columns_frame
    const: LmP0Node: node
    @: LmRegistryControlColumn columns
    size_t: count
    size_t: index

    columns_frame: lm_registry_control_find_child_frame(table_frame, "columns")
    if: columns_frame = 0
        lm_registry_control_error_set(error, "table must contain columns:")
        return: 0

    count: lm_registry_control_visible_field_count(columns_frame\body)
    if: count = 0U
        lm_registry_control_error_set(error, "columns: must not be empty")
        return: 0

    columns: lm_own_new_zero(count * c.sizeof(columns[0]))
    if: columns = 0
        lm_registry_control_error_set(error, "out of memory while reading columns")
        return: 0
    finally: lm_registry_control_columns_destroy(columns, count)

    index: 0U
    while: index < count
        node: lm_registry_control_nth_visible_field(columns_frame\body, index)
        columns[index]: lm_own_new_zero(c.sizeof(c.LmRegistryControlColumn))
        if: columns[index] = 0
            lm_registry_control_error_set(error, "out of memory while reading columns")
            return: 0
        columns[index]\spelling: lm_registry_control_column_spelling_alloc(node, error)
        if: columns[index]\spelling = 0
            return: 0
        columns[index]\width: c.strlen(columns[index]\spelling)
        index: index + 1U

    out_columns[0]: columns
    out_count[0]: count
    columns: 0
return: 1

fn: lm_registry_control_rows_frame_from_table (const: (LmP0Frame: table_frame); LmRegistryControlError: error) const: LmP0Frame
    const: LmP0Frame: rows_frame

    rows_frame: lm_registry_control_find_child_frame(table_frame, "rows")
    if: rows_frame = 0
        lm_registry_control_error_set(error, "table must contain rows:")
        return: 0

return: rows_frame

fn: lm_registry_control_node_lmx_frame_new (const: (LmP0Field: field); const: (LmP0Trailer: trailer); int: phase; int: first) LmRegistryControlNodeLmxFrame
    LmRegistryControlNodeLmxFrame: frame

    frame: lm_own_new_zero(c.sizeof(c.LmRegistryControlNodeLmxFrame))
    if: frame = 0
        return: 0
    frame\field: field
    frame\trailer: trailer
    frame\phase: phase
    frame\first: first
return: frame

fn: lm_registry_control_node_lmx_append_inline (LmRegistryControlBuffer: buffer; const: (LmP0Node: node)) int
    LmOwnPtrStack: stack
    LmRegistryControlNodeLmxFrame: frame
    const: LmP0Node: current
    int: done
    int: status

    if: node = 0
        return: 0

    stack: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
    if: stack = 0
        return: 0
    lm_own_ptr_stack_init(stack, c.lm_own_delete_plain)

    current: node
    done: 0
    status: 1
    while: status != 0 && done = 0
        if: current != 0
            if: current\kind = c.LM_P0_NODE_ATOM || current\kind = c.LM_P0_NODE_DISABLED
                lm_registry_control_buffer_append_text(buffer, current\as\atom\data, current\as\atom\length)
                if: buffer\failed != 0
                    status: 0
                current: 0
                continue
            if: current\kind = c.LM_P0_NODE_STRUCTURE
                lm_registry_control_buffer_append_cstr(buffer, "(")
                if: buffer\failed != 0
                    status: 0
                    current: 0
                    continue
                frame: lm_registry_control_node_lmx_frame_new(current\as\structure\first_field, 0, c.LM_REGISTRY_CONTROL_NODE_LMX_STRUCTURE, 1)
                if: frame = 0
                    status: 0
                    current: 0
                    continue
                if: lm_own_ptr_stack_push(stack, frame) != 0
                    lm_own_delete(frame, 0)
                    status: 0
                    current: 0
                    continue
                current: 0
                continue
            if: current\kind = c.LM_P0_NODE_FRAME
                lm_registry_control_buffer_append_text(buffer, current\as\frame\head\data, current\as\frame\head\length)
                lm_registry_control_buffer_append_cstr(buffer, ":")
                if: buffer\failed != 0
                    status: 0
                    current: 0
                    continue
                frame: lm_registry_control_node_lmx_frame_new(current\as\frame\body\first_field, current\as\frame\trailer, c.LM_REGISTRY_CONTROL_NODE_LMX_FRAME_BODY, 0)
                if: frame = 0
                    status: 0
                    current: 0
                    continue
                if: lm_own_ptr_stack_push(stack, frame) != 0
                    lm_own_delete(frame, 0)
                    status: 0
                    current: 0
                    continue
                current: 0
                continue
            status: 0
            current: 0
            continue

        frame: lm_own_ptr_stack_top(stack)
        if: frame = 0
            done: 1
            continue

        while: frame\field != 0 && lm_registry_control_node_ignored(frame\field\value) != 0
            frame\field: frame\field\next

        if: frame\field != 0
            if: frame\phase = c.LM_REGISTRY_CONTROL_NODE_LMX_STRUCTURE
                if: frame\first = 0
                    lm_registry_control_buffer_append_cstr(buffer, " ")
                    if: buffer\failed != 0
                        status: 0
                        continue
                    ---
                ---
            if: frame\phase != c.LM_REGISTRY_CONTROL_NODE_LMX_STRUCTURE
                lm_registry_control_buffer_append_cstr(buffer, " ")
                if: buffer\failed != 0
                    status: 0
                    continue
                ---
            current: frame\field\value
            frame\field: frame\field\next
            frame\first: 0
            continue

        if: frame\phase = c.LM_REGISTRY_CONTROL_NODE_LMX_STRUCTURE
            lm_registry_control_buffer_append_cstr(buffer, ")")
            lm_own_delete(lm_own_ptr_stack_pop(stack), 0)
            if: buffer\failed != 0
                status: 0
            continue

        if: frame\phase = c.LM_REGISTRY_CONTROL_NODE_LMX_FRAME_BODY && frame\trailer != 0
            lm_registry_control_buffer_append_cstr(buffer, " ")
            lm_registry_control_buffer_append_text(buffer, frame\trailer\spelling\data, frame\trailer\spelling\length)
            lm_registry_control_buffer_append_cstr(buffer, ":")
            if: buffer\failed != 0
                status: 0
                continue
            frame\field: frame\trailer\body\first_field
            frame\trailer: 0
            frame\phase: c.LM_REGISTRY_CONTROL_NODE_LMX_TRAILER_BODY
            continue

        lm_own_delete(lm_own_ptr_stack_pop(stack), 0)

    lm_own_ptr_stack_destroy(stack)
    lm_own_delete(stack, 0)
return: status != 0 && buffer\failed = 0

fn: lm_registry_control_node_lmx_alloc (const: (LmP0Node: node); LmRegistryControlError: error) @: char
    LmRegistryControlBuffer: buffer
    @: char result

    buffer: lm_registry_control_buffer_new()
    if: buffer = 0
        lm_registry_control_error_set(error, "out of memory while creating node formatter")
        return: 0
    finally: lm_registry_control_buffer_delete(buffer)

    if: lm_registry_control_node_lmx_append_inline(buffer, node) = 0
        lm_registry_control_error_set(error, "cannot format P0 node")
        return: 0

    result: lm_registry_control_buffer_take(buffer)
    if: result = 0
        lm_registry_control_error_set(error, "out of memory while formatting P0 node")
return: result

fn: lm_registry_control_fn_descriptor_frame (const: (LmP0Frame: frame)) int
    const: LmP0Node: params_node
    size_t: field_count

    if: frame = 0 || frame\trailer != 0
        return: 0
    if: lm_registry_control_text_equals(frame\head\data, frame\head\length, "fn") = 0 && lm_registry_control_text_equals(frame\head\data, frame\head\length, "callable") = 0
        return: 0

    field_count: lm_registry_control_visible_field_count(frame\body)
    if: field_count < 2U
        return: 0

    params_node: lm_registry_control_nth_visible_field(frame\body, 1U)
return: params_node != 0 && params_node\kind = c.LM_P0_NODE_STRUCTURE

fn: lm_registry_control_fn_params_append_lmx (LmRegistryControlBuffer: buffer; const: (LmP0Structure: params)) int
    const: LmP0Field: field
    size_t: param_count

    param_count: lm_registry_control_visible_field_count(params)
    if: param_count = 0U
        lm_registry_control_buffer_append_cstr(buffer, "()")
        return: buffer\failed = 0

    lm_registry_control_buffer_append_cstr(buffer, "(\n")
    field: params\first_field
    while: field != 0
        if: lm_registry_control_node_ignored(field\value) = 0
            lm_registry_control_buffer_append_cstr(buffer, "    ")
            if: lm_registry_control_node_lmx_append_inline(buffer, field\value) = 0
                return: 0
            lm_registry_control_buffer_append_cstr(buffer, "\n")
        field: field\next

    lm_registry_control_buffer_append_cstr(buffer, ")")
return: buffer\failed = 0

fn: lm_registry_control_fn_to_lmx_append (LmRegistryControlBuffer: buffer; const: (LmP0Frame: fn_frame); LmRegistryControlError: error) int
    const: LmP0Node: name_node
    const: LmP0Node: params_node
    const: LmP0Node: node
    size_t: field_count
    size_t: index

    if: lm_registry_control_fn_descriptor_frame(fn_frame) = 0
        lm_registry_control_error_set(error, "fn: descriptor expects name and parameter Structure")
        return: 0

    name_node: lm_registry_control_nth_visible_field(fn_frame\body, 0U)
    params_node: lm_registry_control_nth_visible_field(fn_frame\body, 1U)
    if: name_node = 0 || params_node = 0 || params_node\kind != c.LM_P0_NODE_STRUCTURE
        lm_registry_control_error_set(error, "fn: descriptor expects name and parameter Structure")
        return: 0

    if: lm_registry_control_text_equals(fn_frame\head\data, fn_frame\head\length, "callable")
        lm_registry_control_buffer_append_cstr(buffer, "callable: ")
    if: lm_registry_control_text_equals(fn_frame\head\data, fn_frame\head\length, "callable") = 0
        lm_registry_control_buffer_append_cstr(buffer, "fn: ")
    ---

    if: lm_registry_control_node_lmx_append_inline(buffer, name_node) = 0
        return: 0
    lm_registry_control_buffer_append_cstr(buffer, " ")
    if: lm_registry_control_fn_params_append_lmx(buffer, params_node\as\structure) = 0
        return: 0

    field_count: lm_registry_control_visible_field_count(fn_frame\body)
    index: 2U
    while: index < field_count
        node: lm_registry_control_nth_visible_field(fn_frame\body, index)
        lm_registry_control_buffer_append_cstr(buffer, " ")
        if: lm_registry_control_node_lmx_append_inline(buffer, node) = 0
            return: 0
        index: index + 1U

return: buffer\failed = 0

fn: lm_registry_control_fn_to_lmx_alloc (const: (LmP0Frame: fn_frame); LmRegistryControlError: error) @: char
    LmRegistryControlBuffer: buffer
    @: char result

    buffer: lm_registry_control_buffer_new()
    if: buffer = 0
        lm_registry_control_error_set(error, "out of memory while creating fn formatter")
        return: 0
    finally: lm_registry_control_buffer_delete(buffer)

    if: lm_registry_control_fn_to_lmx_append(buffer, fn_frame, error) = 0
        return: 0

    result: lm_registry_control_buffer_take(buffer)
    if: result = 0
        lm_registry_control_error_set(error, "out of memory while formatting fn descriptor")
return: result

fn: lm_registry_control_measure_rows (
    const: LmP0Frame: rows_frame
    @: LmRegistryControlColumn columns
    size_t: column_count
    @: size_t out_row_count
    LmRegistryControlError: error
) int
    const: LmP0Node: node
    @: char spelling
    size_t: cell_count
    size_t: index
    size_t: column_index
    size_t: spelling_length

    cell_count: lm_registry_control_visible_field_count(rows_frame\body)
    if: cell_count = 0U
        out_row_count[0]: 0U
        return: 1

    if: column_count = 0U || (cell_count % column_count) != 0U
        lm_registry_control_error_set(error, "rows: cell count must be divisible by column count; use explicit None for empty cells")
        return: 0

    index: 0U
    while: index < cell_count
        node: lm_registry_control_nth_visible_field(rows_frame\body, index)
        if: node = 0
            lm_registry_control_error_set(error, "rows: cell is empty")
            return: 0

        spelling: lm_registry_control_node_lmx_alloc(node, error)
        if: spelling = 0
            return: 0
        spelling_length: c.strlen(spelling)
        column_index: index % column_count
        if: columns[column_index]\width < spelling_length
            columns[column_index]\width: spelling_length
        lm_own_delete(spelling, 0)
        index: index + 1U

    out_row_count[0]: cell_count / column_count
return: 1

fn: lm_registry_control_emit_columns (LmRegistryControlBuffer: buffer; @: LmRegistryControlColumn columns; size_t: column_count) int
    size_t: index
    size_t: length

    lm_registry_control_buffer_append_cstr(buffer, "    columns: ")
    index: 0U
    while: index < column_count
        length: c.strlen(columns[index]\spelling)
        lm_registry_control_buffer_append_cstr(buffer, columns[index]\spelling)
        if: index + 1U < column_count
            lm_registry_control_buffer_append_spaces(buffer, columns[index]\width - length + 2U)
        index: index + 1U

    lm_registry_control_buffer_append_cstr(buffer, "\n")
return: buffer\failed = 0

fn: lm_registry_control_emit_rows (
    LmRegistryControlBuffer: buffer
    const: LmP0Frame: rows_frame
    @: LmRegistryControlColumn columns
    size_t: column_count
    size_t: row_count
    LmRegistryControlError: error
) int
    const: LmP0Node: node
    @: char spelling
    size_t: row_index
    size_t: column_index
    size_t: cell_index
    size_t: spelling_length

    lm_registry_control_buffer_append_cstr(buffer, "    rows:\n")
    row_index: 0U
    while: row_index < row_count
        lm_registry_control_buffer_append_cstr(buffer, "             ")
        column_index: 0U
        while: column_index < column_count
            cell_index: row_index * column_count + column_index
            node: lm_registry_control_nth_visible_field(rows_frame\body, cell_index)
            spelling: lm_registry_control_node_lmx_alloc(node, error)
            if: spelling = 0
                return: 0
            spelling_length: c.strlen(spelling)
            lm_registry_control_buffer_append_cstr(buffer, spelling)
            if: column_index + 1U < column_count
                lm_registry_control_buffer_append_spaces(buffer, columns[column_index]\width - spelling_length + 2U)
            lm_own_delete(spelling, 0)
            column_index: column_index + 1U
        lm_registry_control_buffer_append_cstr(buffer, "\n")
        row_index: row_index + 1U

return: buffer\failed = 0

sub: lm_registry_control_table_end_name (
    const: LmP0Frame: table_frame
    const: @: char table_name_data
    size_t: table_name_length
    const: @@: char out_name_data
    @: size_t out_name_length
)
    const: LmP0Node: node

    if: table_frame != 0 && table_frame\trailer != 0 && lm_registry_control_text_equals(table_frame\trailer\spelling\data, table_frame\trailer\spelling\length, "end") && lm_registry_control_visible_field_count(table_frame\trailer\body) = 1U
        node: lm_registry_control_nth_visible_field(table_frame\trailer\body, 0U)
        if: node != 0 && node\kind = c.LM_P0_NODE_ATOM
            out_name_data[0]: node\as\atom\data
            out_name_length[0]: node\as\atom\length
            return
    ---

    out_name_data[0]: table_name_data
    out_name_length[0]: table_name_length
end: lm_registry_control_table_end_name

fn: lm_registry_control_table_to_lmx_alloc (const: (LmP0Frame: table_frame); LmRegistryControlError: error) @: char
    const: LmP0Frame: rows_frame
    const: @: char table_name_data
    size_t: table_name_length
    const: @: char end_name_data
    size_t: end_name_length
    @: LmRegistryControlColumn columns
    LmRegistryControlBuffer: buffer
    size_t: column_count
    size_t: row_count
    @: char result

    buffer: lm_registry_control_buffer_new()
    if: buffer = 0
        lm_registry_control_error_set(error, "out of memory while creating table formatter")
        return: 0
    finally: lm_registry_control_buffer_delete(buffer)
    columns: 0
    column_count: 0U
    row_count: 0U
    finally: lm_registry_control_columns_destroy(columns, column_count)

    if: lm_registry_control_table_name_from_frame(table_frame, @ table_name_data, @ table_name_length, error) = 0
        return: 0
    if: lm_registry_control_columns_from_frame(table_frame, @ columns, @ column_count, error) = 0
        return: 0

    rows_frame: lm_registry_control_rows_frame_from_table(table_frame, error)
    if: rows_frame = 0
        return: 0

    if: lm_registry_control_measure_rows(rows_frame, columns, column_count, @ row_count, error) = 0
        return: 0

    lm_registry_control_table_end_name(table_frame, table_name_data, table_name_length, @ end_name_data, @ end_name_length)

    lm_registry_control_buffer_append_cstr(buffer, "table:\n")
    lm_registry_control_buffer_append_cstr(buffer, "    name: ")
    lm_registry_control_buffer_append_text(buffer, table_name_data, table_name_length)
    lm_registry_control_buffer_append_cstr(buffer, "\n")
    lm_registry_control_emit_columns(buffer, columns, column_count)
    lm_registry_control_emit_rows(buffer, rows_frame, columns, column_count, row_count, error)
    lm_registry_control_buffer_append_cstr(buffer, "end: ")
    lm_registry_control_buffer_append_text(buffer, end_name_data, end_name_length)
    lm_registry_control_buffer_append_cstr(buffer, "\n")

    result: lm_registry_control_buffer_take(buffer)
    if: result = 0
        lm_registry_control_error_set(error, "out of memory while formatting table")
return: result

fn: lm_registry_control_emit_frame_from_node (
    LmRegistryControlBuffer: output
    const: LmP0Node: node
    @: int emitted
    LmRegistryControlError: error
) int
    @: char text
    int: is_table
    int: is_fn

    if: lm_registry_control_node_ignored(node) != 0
        return: 1

    if: node\kind != c.LM_P0_NODE_FRAME
        lm_registry_control_error_set(error, "registry root expects frame nodes")
        return: 0

    if: emitted[0] != 0
        lm_registry_control_buffer_append_cstr(output, "\n")

    text: 0
    is_table: lm_registry_control_text_equals(node\as\frame\head\data, node\as\frame\head\length, "table")
    is_fn: lm_registry_control_fn_descriptor_frame(node\as\frame)
    if: is_table
        text: lm_registry_control_table_to_lmx_alloc(node\as\frame, error)
    if: is_table = 0 && is_fn
        text: lm_registry_control_fn_to_lmx_alloc(node\as\frame, error)
    if: is_table = 0 && is_fn = 0
        text: lm_registry_control_node_lmx_alloc(node, error)

    if: text = 0
        return: 0

    lm_registry_control_buffer_append_cstr(output, text)
    if: is_table = 0
        lm_registry_control_buffer_append_cstr(output, "\n")
    lm_own_delete(text, 0)
    emitted[0]: 1
return: output\failed = 0

fn: lm_registry_control_document_to_lmx_alloc (const: (LmP0Document: document); LmRegistryControlError: error) @: char
    const: LmP0Node: root
    const: LmP0Field: field
    LmRegistryControlBuffer: output
    int: emitted
    @: char result

    output: lm_registry_control_buffer_new()
    if: output = 0
        lm_registry_control_error_set(error, "out of memory while creating document formatter")
        return: 0
    finally: lm_registry_control_buffer_delete(output)
    emitted: 0
    root: c.lm_p0_document_root(document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        lm_registry_control_error_set(error, "document root must be a Structure")
        return: 0

    field: root\as\structure\first_field
    while: field != 0
        if: lm_registry_control_emit_frame_from_node(output, field\value, @ emitted, error) = 0
            return: 0
        field: field\next

    result: lm_registry_control_buffer_take(output)
    if: result = 0
        lm_registry_control_error_set(error, "out of memory while formatting registry document")
return: result

fn: lm_registry_control_rename_atom_if_match (LmP0Node: node; LmRegistryControlRename: rename) int
    if: node = 0 || rename = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0

    if: lm_registry_control_text_equals(node\as\atom\data, node\as\atom\length, rename\old_name) = 0
        return: 0

    rename\found_count: rename\found_count + 1U
    node\as\atom\data: rename\new_name
    node\as\atom\length: c.strlen(rename\new_name)
    rename\changed_count: rename\changed_count + 1U
return: 1

fn: lm_registry_control_rename_descriptor_frame_new (const: (LmP0Field: field)) LmRegistryControlRenameDescriptorFrame
    LmRegistryControlRenameDescriptorFrame: frame

    frame: lm_own_new_zero(c.sizeof(c.LmRegistryControlRenameDescriptorFrame))
    if: frame = 0
        return: 0
    frame\field: field
return: frame

fn: lm_registry_control_rename_descriptor_node (LmP0Node: node; LmRegistryControlRename: rename) int
    LmOwnPtrStack: stack
    LmRegistryControlRenameDescriptorFrame: frame
    LmP0Node: current
    int: done
    int: status

    if: node = 0
        return: 0

    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_registry_control_rename_atom_if_match(node, rename)

    if: node\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

    stack: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
    if: stack = 0
        return: 0
    lm_own_ptr_stack_init(stack, c.lm_own_delete_plain)

    frame: lm_registry_control_rename_descriptor_frame_new(node\as\structure\first_field)
    if: frame = 0
        lm_own_ptr_stack_destroy(stack)
        lm_own_delete(stack, 0)
        return: 0
    if: lm_own_ptr_stack_push(stack, frame) != 0
        lm_own_delete(frame, 0)
        lm_own_ptr_stack_destroy(stack)
        lm_own_delete(stack, 0)
        return: 0

    done: 0
    status: 1
    while: status != 0 && done = 0
        frame: lm_own_ptr_stack_top(stack)
        if: frame = 0
            done: 1
            continue

        while: frame\field != 0 && lm_registry_control_node_ignored(frame\field\value) != 0
            frame\field: frame\field\next

        if: frame\field = 0
            lm_own_delete(lm_own_ptr_stack_pop(stack), 0)
            continue

        current: frame\field\value
        frame\field: frame\field\next

        if: current = 0
            continue

        if: current\kind = c.LM_P0_NODE_ATOM
            lm_registry_control_rename_atom_if_match(current, rename)
            continue

        if: current\kind = c.LM_P0_NODE_STRUCTURE
            frame: lm_registry_control_rename_descriptor_frame_new(current\as\structure\first_field)
            if: frame = 0
                status: 0
                continue
            if: lm_own_ptr_stack_push(stack, frame) != 0
                lm_own_delete(frame, 0)
                status: 0
                continue
            ---
        ---

    lm_own_ptr_stack_destroy(stack)
    lm_own_delete(stack, 0)
return: 0

fn: lm_registry_control_rename_table_column_descriptors (LmP0Frame: table_frame; LmRegistryControlRename: rename) int
    const: LmP0Frame: columns_frame
    LmP0Field: field

    if: table_frame = 0 || rename = 0
        return: 0

    columns_frame: lm_registry_control_find_child_frame(table_frame, "columns")
    if: columns_frame = 0
        return: 0

    field: columns_frame\body\first_field
    while: field != 0
        if: lm_registry_control_node_ignored(field\value) = 0
            lm_registry_control_rename_descriptor_node(field\value, rename)
        field: field\next

return: 0

fn: lm_registry_control_rename_structure_frame_new (const: (LmP0Field: field)) LmRegistryControlRenameStructureFrame
    LmRegistryControlRenameStructureFrame: frame

    frame: lm_own_new_zero(c.sizeof(c.LmRegistryControlRenameStructureFrame))
    if: frame = 0
        return: 0
    frame\field: field
return: frame

fn: lm_registry_control_rename_structure_tables (LmP0Structure: structure; LmRegistryControlRename: rename) int
    LmOwnPtrStack: stack
    LmRegistryControlRenameStructureFrame: frame
    LmP0Node: node
    int: done
    int: is_table
    int: status

    if: structure = 0 || rename = 0
        return: 0

    stack: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
    if: stack = 0
        return: 0
    lm_own_ptr_stack_init(stack, c.lm_own_delete_plain)

    frame: lm_registry_control_rename_structure_frame_new(structure\first_field)
    if: frame = 0
        lm_own_ptr_stack_destroy(stack)
        lm_own_delete(stack, 0)
        return: 0
    if: lm_own_ptr_stack_push(stack, frame) != 0
        lm_own_delete(frame, 0)
        lm_own_ptr_stack_destroy(stack)
        lm_own_delete(stack, 0)
        return: 0

    done: 0
    status: 1
    while: status != 0 && done = 0
        frame: lm_own_ptr_stack_top(stack)
        if: frame = 0
            done: 1
            continue

        if: frame\field = 0
            lm_own_delete(lm_own_ptr_stack_pop(stack), 0)
            continue

        node: frame\field\value
        frame\field: frame\field\next

        if: lm_registry_control_node_ignored(node) = 0 && node\kind = c.LM_P0_NODE_FRAME
            is_table: lm_registry_control_text_equals(node\as\frame\head\data, node\as\frame\head\length, "table")
            if: is_table
                lm_registry_control_rename_table_column_descriptors(node\as\frame, rename)
            if: is_table = 0
                if: lm_registry_control_text_equals(node\as\frame\head\data, node\as\frame\head\length, "L4") || lm_registry_control_text_equals(node\as\frame\head\data, node\as\frame\head\length, "registry")
                    frame: lm_registry_control_rename_structure_frame_new(node\as\frame\body\first_field)
                    if: frame = 0
                        status: 0
                        continue
                    if: lm_own_ptr_stack_push(stack, frame) != 0
                        lm_own_delete(frame, 0)
                        status: 0
                        continue
                    ---
                ---
            ---
        continue

    lm_own_ptr_stack_destroy(stack)
    lm_own_delete(stack, 0)
return: 0

fn: lm_registry_control_rename_document_column_descriptor (LmP0Document: document; const: @(char old_name); const: @(char new_name); @: size_t out_changed) int
    LmP0Node: root
    LmRegistryControlRename: rename

    if: out_changed != 0
        out_changed[0]: 0U

    if: document = 0 || old_name = 0 || new_name = 0
        return: 1

    rename: lm_registry_control_rename_new()
    if: rename = 0
        return: 1
    rename\old_name: old_name
    rename\new_name: new_name

    root: c.lm_p0_document_mutable_root(document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        lm_registry_control_rename_delete(rename)
        return: 1

    lm_registry_control_rename_structure_tables(root\as\structure, rename)
    if: out_changed != 0
        out_changed[0]: rename\changed_count
    lm_registry_control_rename_delete(rename)
return: 0

fn: lm_registry_control_parse_file (const: @(char path); @: LmP0Document out_document; LmRegistryControlError: error) int
    LmP0Document: document
    const: LmP0Diagnostic: diagnostic
    int: status

    if: out_document = 0
        return: 1

    out_document[0]: 0
    document: 0
    status: c.lm_p0_parse_file(path, @ document)
    if: status != 0
        diagnostic: c.lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf:
                c.stderr
                "registry_control parse error %d at %zu:%zu in %s: %s\n"
                diagnostic\code
                diagnostic\line
                diagnostic\column
                path
                diagnostic\message
            ---
        lm_registry_control_error_set(error, "cannot parse registry file")
        c.lm_p0_document_destroy(document)
        return: 1

    out_document[0]: document
return: 0

fn: lm_registry_control_write_text_file (const: @(char path); const: @(char text); LmRegistryControlError: error) int
    FILE: file
    size_t: length

    file: c.fopen(path, "wb")
    if: file = 0
        lm_registry_control_error_set(error, "cannot open registry file for writing")
        return: 1

    length: c.strlen(text)
    if: c.fwrite(text, 1U, length, file) != length
        lm_registry_control_error_set(error, "cannot write registry file")
        c.fclose: file
        return: 1

    if: c.fclose(file) != 0
        lm_registry_control_error_set(error, "cannot close registry file")
        return: 1

return: 0

fn: lm_registry_control_mutable_document_load_file (const: @(char path); @: LmP0Document out_document; LmRegistryControlError: error) int
return: lm_registry_control_parse_file(path, out_document, error)

sub: lm_registry_control_mutable_document_destroy (LmP0Document: document)
    c.lm_p0_document_destroy(document)
end: lm_registry_control_mutable_document_destroy

fn: lm_registry_control_mutable_document_save_file (const: @(char path); LmP0Document: document; LmRegistryControlError: error) int
    @: char text
    int: status

    text: lm_registry_control_document_to_lmx_alloc(document, error)
    if: text = 0
        return: 1

    status: lm_registry_control_write_text_file(path, text, error)
    lm_own_delete(text, 0)
return: status

fn: lm_registry_control_rename_file_column_descriptor (const: @(char path); const: @(char old_name); const: @(char new_name); @: size_t out_changed; LmRegistryControlError: error) int
    LmP0Document: document
    int: status

    if: out_changed != 0
        out_changed[0]: 0U

    document: 0
    if: lm_registry_control_mutable_document_load_file(path, @ document, error) != 0
        return: 1

    status: lm_registry_control_rename_document_column_descriptor(document, old_name, new_name, out_changed)
    if: status = 0
        status: lm_registry_control_mutable_document_save_file(path, document, error)
    lm_registry_control_mutable_document_destroy(document)
return: status

fn: lm_registry_control_rename_files_column_descriptor (int: argc; @@: char argv; const: @(char old_name); const: @(char new_name); @: size_t out_changed; LmRegistryControlError: error) int
    int: index
    size_t: changed
    size_t: total_changed

    if: out_changed != 0
        out_changed[0]: 0U

    if: argc < 0 || argv = 0
        return: 1

    total_changed: 0U
    index: 0
    while: index < argc
        changed: 0U
        if: lm_registry_control_rename_file_column_descriptor(argv[index], old_name, new_name, @ changed, error) != 0
            if: out_changed != 0
                out_changed[0]: total_changed
            return: 1
        total_changed: total_changed + changed
        index: index + 1

    if: out_changed != 0
        out_changed[0]: total_changed
return: 0
