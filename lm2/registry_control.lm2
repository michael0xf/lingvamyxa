L4: loadHeaders

L4:
    table:
        name: LmRegistryControlBuffer
        columns: class     (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)
        rows:
                 data      char                   0                       1
                 length    size_t                 1                       0
                 capacity  size_t                 2                       0
                 failed    int                    3                       0
    end: LmRegistryControlBuffer

    table:
        name: LmRegistryControlColumn
        columns: class     (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)
        rows:
                 spelling  char                   0                       1
                 width     size_t                 1                       0
    end: LmRegistryControlColumn

    table:
        name: LmRegistryControlError
        columns: class    (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)  (`field.const` serial)
        rows:
                 message  char                   0                       1                                1
    end: LmRegistryControlError

    table:
        name: LmRegistryControlRename
        columns: class          (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)  (`field.const` serial)
        rows:
                 old_name       char                   0                       1                                1
                 new_name       char                   1                       1                                1
                 found_count    size_t                 2                       0                                0
                 changed_count  size_t                 3                       0                                0
    end: LmRegistryControlRename

    table:
        name: `layout.backend`
        columns: class                    (backend class)
        rows:
                 LmRegistryControlBuffer  c.struct
                 LmRegistryControlColumn  c.struct
                 LmRegistryControlError   c.struct
                 LmRegistryControlRename  c.struct
    end: `layout.backend`
end: L4

import: "lm4/parser_abi.lm4"

include: "<stdint.h>" "<stdio.h>" "<stdlib.h>" "<string.h>"

fn: lm_registry_control_text_equals (const: @(char data); size_t: text_length; const: @: char value) int
    size_t: length

    length: c.strlen(value)
    return: text_length = length && c.memcmp(data, value, length) = 0
end: lm_registry_control_text_equals

fn: lm_registry_control_text_equals_text (LmP0Text: text; const: @: char value) int
    return: lm_registry_control_text_equals(c.text.data, c.text.length, value)
end: lm_registry_control_text_equals_text

sub: lm_registry_control_error_set (@: LmRegistryControlError error; const: @: char message)
    if: error = 0 || error\message != 0
        return

    error\message: message
end: lm_registry_control_error_set

fn: lm_registry_control_buffer_reserve (@: LmRegistryControlBuffer buffer; size_t: extra) int
    @: char new_data
    size_t: new_capacity
    size_t: required

    if: buffer = 0 || buffer\failed != 0
        return: 0

    required: buffer\length + extra + 1U
    if: required <= buffer\capacity
        return: 1

    if: buffer\capacity = 0U
        new_capacity: 256U
    if: buffer\capacity != 0U
        new_capacity: buffer\capacity
    ---

    while: new_capacity < required
        if: new_capacity > c.SIZE_MAX / 2U
            buffer\failed: 1
            return: 0
        new_capacity: new_capacity * 2U

    new_data: c.realloc(buffer\data, new_capacity)
    if: new_data = 0
        buffer\failed: 1
        return: 0

    buffer\data: new_data
    buffer\capacity: new_capacity
    return: 1
end: lm_registry_control_buffer_reserve

sub: lm_registry_control_buffer_append (@: LmRegistryControlBuffer buffer; const: @(char data); size_t: length)
    if: lm_registry_control_buffer_reserve(buffer, length) = 0
        return

    if: length != 0U
        c.memcpy(buffer\data + buffer\length, data, length)
    buffer\length: buffer\length + length
    buffer\data[buffer\length]: '\0'
end: lm_registry_control_buffer_append

sub: lm_registry_control_buffer_append_cstr (@: LmRegistryControlBuffer buffer; const: @: char text)
    lm_registry_control_buffer_append(buffer, text, c.strlen(text))
end: lm_registry_control_buffer_append_cstr

sub: lm_registry_control_buffer_append_text (@: LmRegistryControlBuffer buffer; const: @(char data); size_t: length)
    lm_registry_control_buffer_append(buffer, data, length)
end: lm_registry_control_buffer_append_text

sub: lm_registry_control_buffer_append_spaces (@: LmRegistryControlBuffer buffer; size_t: count)
    while: count != 0U
        lm_registry_control_buffer_append_cstr(buffer, " ")
        count: count - 1U
end: lm_registry_control_buffer_append_spaces

fn: lm_registry_control_buffer_take (@: LmRegistryControlBuffer buffer) @: char
    @: char result

    if: buffer = 0 || buffer\failed != 0
        return: 0

    if: lm_registry_control_buffer_reserve(buffer, 0U) = 0
        return: 0

    result: buffer\data
    buffer\data: 0
    buffer\length: 0U
    buffer\capacity: 0U
    return: result
end: lm_registry_control_buffer_take

sub: lm_registry_control_buffer_destroy (@: LmRegistryControlBuffer buffer)
    if: buffer != 0
        c.free(buffer\data)
        buffer\data: 0
        buffer\length: 0U
        buffer\capacity: 0U
        buffer\failed: 0
end: lm_registry_control_buffer_destroy

fn: lm_registry_control_node_ignored (const: @: LmP0Node node) int
    return: node = 0 || (node\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX)) != 0U
end: lm_registry_control_node_ignored

fn: lm_registry_control_visible_field_count (const: @: LmP0Structure structure) size_t
    const: @: LmP0Field field
    size_t: count

    count: 0U
    if: structure = 0
        return: 0U

    field: structure\first_field
    while: field != 0
        if: lm_registry_control_node_ignored(field\value) = 0
            count: count + 1U
        field: field\next

    return: count
end: lm_registry_control_visible_field_count

fn: lm_registry_control_nth_visible_field (const: @(LmP0Structure structure); size_t: index) const: @: LmP0Node
    const: @: LmP0Field field
    size_t: current

    if: structure = 0
        return: 0

    current: 0U
    field: structure\first_field
    while: field != 0
        if: lm_registry_control_node_ignored(field\value) = 0
            if: current = index
                return: field\value
            current: current + 1U
        field: field\next

    return: 0
end: lm_registry_control_nth_visible_field

fn: lm_registry_control_find_child_frame (const: @(LmP0Frame frame); const: @: char head) const: @: LmP0Frame
    const: @: LmP0Field field
    const: @: LmP0Node node

    if: frame = 0
        return: 0

    field: frame\body\first_field
    while: field != 0
        node: field\value
        if: lm_registry_control_node_ignored(node) = 0 && node\kind = c.LM_P0_NODE_FRAME && lm_registry_control_text_equals(node\as\frame\head\data, node\as\frame\head\length, head)
            return: node\as\frame
        field: field\next

    return: 0
end: lm_registry_control_find_child_frame

fn: lm_registry_control_single_body_node (const: @: LmP0Frame frame) const: @: LmP0Node
    if: frame = 0 || lm_registry_control_visible_field_count(frame\body) != 1U
        return: 0

    return: lm_registry_control_nth_visible_field(frame\body, 0U)
end: lm_registry_control_single_body_node

fn: lm_registry_control_table_name_from_frame (const: @(LmP0Frame table_frame); const: @@(char out_name_data); @: size_t out_name_length; @: LmRegistryControlError error) int
    const: @: LmP0Frame name_frame
    const: @: LmP0Node name_node

    name_frame: lm_registry_control_find_child_frame(table_frame, "name")
    if: name_frame = 0
        lm_registry_control_error_set(error, "table must contain name:")
        return: 0

    name_node: lm_registry_control_single_body_node(name_frame)
    if: name_node = 0 || name_node\kind != c.LM_P0_NODE_ATOM
        lm_registry_control_error_set(error, "table name: expects exactly one atom")
        return: 0

    out_name_data[0]: name_node\as\atom\data
    out_name_length[0]: name_node\as\atom\length
    return: 1
end: lm_registry_control_table_name_from_frame

fn: lm_registry_control_column_spelling_append_node (@: LmRegistryControlBuffer buffer; const: @: LmP0Node node) int
    const: @: LmP0Field field
    int: first

    if: node = 0
        return: 0

    if: node\kind = c.LM_P0_NODE_ATOM || node\kind = c.LM_P0_NODE_DISABLED
        lm_registry_control_buffer_append_text(buffer, node\as\atom\data, node\as\atom\length)
        return: buffer\failed = 0

    if: node\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

    lm_registry_control_buffer_append_cstr(buffer, "(")
    first: 1
    field: node\as\structure\first_field
    while: field != 0
        if: lm_registry_control_node_ignored(field\value) = 0
            if: first = 0
                lm_registry_control_buffer_append_cstr(buffer, " ")
            if: lm_registry_control_column_spelling_append_node(buffer, field\value) = 0
                return: 0
            first: 0
        field: field\next
    lm_registry_control_buffer_append_cstr(buffer, ")")
    return: buffer\failed = 0
end: lm_registry_control_column_spelling_append_node

fn: lm_registry_control_column_spelling_alloc (const: @(LmP0Node node); @: LmRegistryControlError error) @: char
    LmRegistryControlBuffer: buffer
    @: char result

    c.memset(@ buffer, 0, c.sizeof(buffer))
    if: lm_registry_control_column_spelling_append_node(@ buffer, node) = 0
        lm_registry_control_error_set(error, "columns: cannot format column descriptor")
        lm_registry_control_buffer_destroy(@ buffer)
        return: 0

    result: lm_registry_control_buffer_take(@ buffer)
    lm_registry_control_buffer_destroy(@ buffer)
    if: result = 0
        lm_registry_control_error_set(error, "out of memory while formatting column")
    return: result
end: lm_registry_control_column_spelling_alloc

sub: lm_registry_control_columns_destroy (@: LmRegistryControlColumn columns; size_t: count)
    size_t: index

    if: columns = 0
        return

    index: 0U
    while: index < count
        c.free(c.columns[index].spelling)
        index: index + 1U
    c.free(columns)
end: lm_registry_control_columns_destroy

fn: lm_registry_control_columns_from_frame (
    const: @(LmP0Frame table_frame)
    @@: LmRegistryControlColumn out_columns
    @: size_t out_count
    @: LmRegistryControlError error
) int
    const: @: LmP0Frame columns_frame
    const: @: LmP0Node node
    @: LmRegistryControlColumn columns
    size_t: count
    size_t: index

    columns_frame: lm_registry_control_find_child_frame(table_frame, "columns")
    if: columns_frame = 0
        lm_registry_control_error_set(error, "table must contain columns:")
        return: 0

    count: lm_registry_control_visible_field_count(columns_frame\body)
    if: count = 0U
        lm_registry_control_error_set(error, "columns: must not be empty")
        return: 0

    columns: c.calloc(count, c.sizeof(c.LmRegistryControlColumn))
    if: columns = 0
        lm_registry_control_error_set(error, "out of memory while reading columns")
        return: 0

    index: 0U
    while: index < count
        node: lm_registry_control_nth_visible_field(columns_frame\body, index)
        c.columns[index].spelling: lm_registry_control_column_spelling_alloc(node, error)
        if: c.columns[index].spelling = 0
            lm_registry_control_columns_destroy(columns, count)
            return: 0
        c.columns[index].width: c.strlen(c.columns[index].spelling)
        index: index + 1U

    out_columns[0]: columns
    out_count[0]: count
    return: 1
end: lm_registry_control_columns_from_frame

fn: lm_registry_control_rows_frame_from_table (const: @(LmP0Frame table_frame); @: LmRegistryControlError error) const: @: LmP0Frame
    const: @: LmP0Frame rows_frame

    rows_frame: lm_registry_control_find_child_frame(table_frame, "rows")
    if: rows_frame = 0
        lm_registry_control_error_set(error, "table must contain rows:")
        return: 0

    return: rows_frame
end: lm_registry_control_rows_frame_from_table

fn: lm_registry_control_node_lmx_append_inline (@: LmRegistryControlBuffer buffer; const: @: LmP0Node node) int
    const: @: LmP0Field field
    const: @: LmP0Trailer trailer
    int: first

    if: node = 0
        return: 0

    if: node\kind = c.LM_P0_NODE_ATOM || node\kind = c.LM_P0_NODE_DISABLED
        lm_registry_control_buffer_append_text(buffer, node\as\atom\data, node\as\atom\length)
        return: buffer\failed = 0

    if: node\kind = c.LM_P0_NODE_STRUCTURE
        lm_registry_control_buffer_append_cstr(buffer, "(")
        first: 1
        field: node\as\structure\first_field
        while: field != 0
            if: lm_registry_control_node_ignored(field\value) = 0
                if: first = 0
                    lm_registry_control_buffer_append_cstr(buffer, " ")
                if: lm_registry_control_node_lmx_append_inline(buffer, field\value) = 0
                    return: 0
                first: 0
            field: field\next
        lm_registry_control_buffer_append_cstr(buffer, ")")
        return: buffer\failed = 0

    if: node\kind = c.LM_P0_NODE_FRAME
        lm_registry_control_buffer_append_text(buffer, node\as\frame\head\data, node\as\frame\head\length)
        lm_registry_control_buffer_append_cstr(buffer, ":")
        field: node\as\frame\body\first_field
        while: field != 0
            if: lm_registry_control_node_ignored(field\value) = 0
                lm_registry_control_buffer_append_cstr(buffer, " ")
                if: lm_registry_control_node_lmx_append_inline(buffer, field\value) = 0
                    return: 0
                ---
            field: field\next

        trailer: node\as\frame\trailer
        if: trailer != 0
            lm_registry_control_buffer_append_cstr(buffer, " ")
            lm_registry_control_buffer_append_text(buffer, trailer\spelling\data, trailer\spelling\length)
            lm_registry_control_buffer_append_cstr(buffer, ":")
            field: trailer\body\first_field
            while: field != 0
                if: lm_registry_control_node_ignored(field\value) = 0
                    lm_registry_control_buffer_append_cstr(buffer, " ")
                    if: lm_registry_control_node_lmx_append_inline(buffer, field\value) = 0
                        return: 0
                    ---
                field: field\next
        ---
        return: buffer\failed = 0

    return: 0
end: lm_registry_control_node_lmx_append_inline

fn: lm_registry_control_node_lmx_alloc (const: @(LmP0Node node); @: LmRegistryControlError error) @: char
    LmRegistryControlBuffer: buffer
    @: char result

    c.memset(@ buffer, 0, c.sizeof(buffer))
    if: lm_registry_control_node_lmx_append_inline(@ buffer, node) = 0
        lm_registry_control_error_set(error, "cannot format P0 node")
        lm_registry_control_buffer_destroy(@ buffer)
        return: 0

    result: lm_registry_control_buffer_take(@ buffer)
    lm_registry_control_buffer_destroy(@ buffer)
    if: result = 0
        lm_registry_control_error_set(error, "out of memory while formatting P0 node")
    return: result
end: lm_registry_control_node_lmx_alloc

fn: lm_registry_control_measure_rows (
    const: @: LmP0Frame rows_frame
    @: LmRegistryControlColumn columns
    size_t: column_count
    @: size_t out_row_count
    @: LmRegistryControlError error
) int
    const: @: LmP0Node node
    @: char spelling
    size_t: cell_count
    size_t: index
    size_t: column_index
    size_t: spelling_length

    cell_count: lm_registry_control_visible_field_count(rows_frame\body)
    if: cell_count = 0U
        out_row_count[0]: 0U
        return: 1

    if: column_count = 0U || (cell_count % column_count) != 0U
        lm_registry_control_error_set(error, "rows: cell count must be divisible by column count; use explicit NULL for empty cells")
        return: 0

    index: 0U
    while: index < cell_count
        node: lm_registry_control_nth_visible_field(rows_frame\body, index)
        if: node = 0
            lm_registry_control_error_set(error, "rows: cell is empty")
            return: 0

        spelling: lm_registry_control_node_lmx_alloc(node, error)
        if: spelling = 0
            return: 0
        spelling_length: c.strlen(spelling)
        column_index: index % column_count
        if: c.columns[column_index].width < spelling_length
            c.columns[column_index].width: spelling_length
        c.free(spelling)
        index: index + 1U

    out_row_count[0]: cell_count / column_count
    return: 1
end: lm_registry_control_measure_rows

fn: lm_registry_control_emit_columns (@: LmRegistryControlBuffer buffer; const: @(LmRegistryControlColumn columns); size_t: column_count) int
    size_t: index
    size_t: length

    lm_registry_control_buffer_append_cstr(buffer, "    columns: ")
    index: 0U
    while: index < column_count
        length: c.strlen(c.columns[index].spelling)
        lm_registry_control_buffer_append_cstr(buffer, c.columns[index].spelling)
        if: index + 1U < column_count
            lm_registry_control_buffer_append_spaces(buffer, c.columns[index].width - length + 2U)
        index: index + 1U

    lm_registry_control_buffer_append_cstr(buffer, "\n")
    return: buffer\failed = 0
end: lm_registry_control_emit_columns

fn: lm_registry_control_emit_rows (
    @: LmRegistryControlBuffer buffer
    const: @: LmP0Frame rows_frame
    const: @: LmRegistryControlColumn columns
    size_t: column_count
    size_t: row_count
    @: LmRegistryControlError error
) int
    const: @: LmP0Node node
    @: char spelling
    size_t: row_index
    size_t: column_index
    size_t: cell_index
    size_t: spelling_length

    lm_registry_control_buffer_append_cstr(buffer, "    rows:\n")
    row_index: 0U
    while: row_index < row_count
        lm_registry_control_buffer_append_cstr(buffer, "             ")
        column_index: 0U
        while: column_index < column_count
            cell_index: row_index * column_count + column_index
            node: lm_registry_control_nth_visible_field(rows_frame\body, cell_index)
            spelling: lm_registry_control_node_lmx_alloc(node, error)
            if: spelling = 0
                return: 0
            spelling_length: c.strlen(spelling)
            lm_registry_control_buffer_append_cstr(buffer, spelling)
            if: column_index + 1U < column_count
                lm_registry_control_buffer_append_spaces(buffer, c.columns[column_index].width - spelling_length + 2U)
            c.free(spelling)
            column_index: column_index + 1U
        lm_registry_control_buffer_append_cstr(buffer, "\n")
        row_index: row_index + 1U

    return: buffer\failed = 0
end: lm_registry_control_emit_rows

sub: lm_registry_control_table_end_name (
    const: @: LmP0Frame table_frame
    const: @: char table_name_data
    size_t: table_name_length
    const: @@: char out_name_data
    @: size_t out_name_length
)
    const: @: LmP0Node node

    if: table_frame != 0 && table_frame\trailer != 0 && lm_registry_control_text_equals(table_frame\trailer\spelling\data, table_frame\trailer\spelling\length, "end") && lm_registry_control_visible_field_count(table_frame\trailer\body) = 1U
        node: lm_registry_control_nth_visible_field(table_frame\trailer\body, 0U)
        if: node != 0 && node\kind = c.LM_P0_NODE_ATOM
            out_name_data[0]: node\as\atom\data
            out_name_length[0]: node\as\atom\length
            return
    ---

    out_name_data[0]: table_name_data
    out_name_length[0]: table_name_length
end: lm_registry_control_table_end_name

fn: lm_registry_control_table_to_lmx_alloc (const: @(LmP0Frame table_frame); @: LmRegistryControlError error) @: char
    const: @: LmP0Frame rows_frame
    const: @: char table_name_data
    size_t: table_name_length
    const: @: char end_name_data
    size_t: end_name_length
    @: LmRegistryControlColumn columns
    LmRegistryControlBuffer: buffer
    size_t: column_count
    size_t: row_count
    @: char result

    c.memset(@ buffer, 0, c.sizeof(buffer))
    columns: 0
    column_count: 0U
    row_count: 0U

    if: lm_registry_control_table_name_from_frame(table_frame, @ table_name_data, @ table_name_length, error) = 0
        return: 0
    if: lm_registry_control_columns_from_frame(table_frame, @ columns, @ column_count, error) = 0
        return: 0

    rows_frame: lm_registry_control_rows_frame_from_table(table_frame, error)
    if: rows_frame = 0
        lm_registry_control_columns_destroy(columns, column_count)
        return: 0

    if: lm_registry_control_measure_rows(rows_frame, columns, column_count, @ row_count, error) = 0
        lm_registry_control_columns_destroy(columns, column_count)
        return: 0

    lm_registry_control_table_end_name(table_frame, table_name_data, table_name_length, @ end_name_data, @ end_name_length)

    lm_registry_control_buffer_append_cstr(@ buffer, "table:\n")
    lm_registry_control_buffer_append_cstr(@ buffer, "    name: ")
    lm_registry_control_buffer_append_text(@ buffer, table_name_data, table_name_length)
    lm_registry_control_buffer_append_cstr(@ buffer, "\n")
    lm_registry_control_emit_columns(@ buffer, columns, column_count)
    lm_registry_control_emit_rows(@ buffer, rows_frame, columns, column_count, row_count, error)
    lm_registry_control_buffer_append_cstr(@ buffer, "end: ")
    lm_registry_control_buffer_append_text(@ buffer, end_name_data, end_name_length)
    lm_registry_control_buffer_append_cstr(@ buffer, "\n")

    lm_registry_control_columns_destroy(columns, column_count)
    result: lm_registry_control_buffer_take(@ buffer)
    lm_registry_control_buffer_destroy(@ buffer)
    if: result = 0
        lm_registry_control_error_set(error, "out of memory while formatting table")
    return: result
end: lm_registry_control_table_to_lmx_alloc

fn: lm_registry_control_emit_frame_from_node (
    @: LmRegistryControlBuffer output
    const: @: LmP0Node node
    @: int emitted
    @: LmRegistryControlError error
) int
    @: char text
    int: is_table

    if: lm_registry_control_node_ignored(node) != 0
        return: 1

    if: node\kind != c.LM_P0_NODE_FRAME
        lm_registry_control_error_set(error, "registry root expects frame nodes")
        return: 0

    if: emitted[0] != 0
        lm_registry_control_buffer_append_cstr(output, "\n")

    text: 0
    is_table: lm_registry_control_text_equals(node\as\frame\head\data, node\as\frame\head\length, "table")
    if: is_table
        text: lm_registry_control_table_to_lmx_alloc(node\as\frame, error)
    if: is_table = 0
        text: lm_registry_control_node_lmx_alloc(node, error)

    if: text = 0
        return: 0

    lm_registry_control_buffer_append_cstr(output, text)
    if: is_table = 0
        lm_registry_control_buffer_append_cstr(output, "\n")
    c.free(text)
    emitted[0]: 1
    return: output\failed = 0
end: lm_registry_control_emit_frame_from_node

fn: lm_registry_control_document_to_lmx_alloc (const: @(LmP0Document document); @: LmRegistryControlError error) @: char
    const: @: LmP0Node root
    const: @: LmP0Field field
    LmRegistryControlBuffer: output
    int: emitted
    @: char result

    c.memset(@ output, 0, c.sizeof(output))
    emitted: 0
    root: c.lm_p0_document_root(document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        lm_registry_control_error_set(error, "document root must be a Structure")
        lm_registry_control_buffer_destroy(@ output)
        return: 0

    field: root\as\structure\first_field
    while: field != 0
        if: lm_registry_control_emit_frame_from_node(@ output, field\value, @ emitted, error) = 0
            lm_registry_control_buffer_destroy(@ output)
            return: 0
        field: field\next

    result: lm_registry_control_buffer_take(@ output)
    lm_registry_control_buffer_destroy(@ output)
    if: result = 0
        lm_registry_control_error_set(error, "out of memory while formatting registry document")
    return: result
end: lm_registry_control_document_to_lmx_alloc

fn: lm_registry_control_rename_atom_if_match (@: LmP0Node node; @: LmRegistryControlRename rename) int
    if: node = 0 || rename = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0

    if: lm_registry_control_text_equals(node\as\atom\data, node\as\atom\length, rename\old_name) = 0
        return: 0

    rename\found_count: rename\found_count + 1U
    node\as\atom\data: rename\new_name
    node\as\atom\length: c.strlen(rename\new_name)
    rename\changed_count: rename\changed_count + 1U
    return: 1
end: lm_registry_control_rename_atom_if_match

fn: lm_registry_control_rename_descriptor_node (@: LmP0Node node; @: LmRegistryControlRename rename) int
    @: LmP0Field field

    if: node = 0
        return: 0

    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_registry_control_rename_atom_if_match(node, rename)

    if: node\kind = c.LM_P0_NODE_STRUCTURE
        field: node\as\structure\first_field
        while: field != 0
            if: lm_registry_control_node_ignored(field\value) = 0
                lm_registry_control_rename_descriptor_node(field\value, rename)
            field: field\next
        return: 0

    return: 0
end: lm_registry_control_rename_descriptor_node

fn: lm_registry_control_rename_table_column_descriptors (@: LmP0Frame table_frame; @: LmRegistryControlRename rename) int
    const: @: LmP0Frame columns_frame
    @: LmP0Field field

    if: table_frame = 0 || rename = 0
        return: 0

    columns_frame: lm_registry_control_find_child_frame(table_frame, "columns")
    if: columns_frame = 0
        return: 0

    field: columns_frame\body\first_field
    while: field != 0
        if: lm_registry_control_node_ignored(field\value) = 0
            lm_registry_control_rename_descriptor_node(field\value, rename)
        field: field\next

    return: 0
end: lm_registry_control_rename_table_column_descriptors

fn: lm_registry_control_rename_structure_tables (@: LmP0Structure structure; @: LmRegistryControlRename rename) int
    @: LmP0Field field
    @: LmP0Node node
    int: is_table

    if: structure = 0 || rename = 0
        return: 0

    field: structure\first_field
    while: field != 0
        node: field\value
        if: lm_registry_control_node_ignored(node) = 0 && node\kind = c.LM_P0_NODE_FRAME
            is_table: lm_registry_control_text_equals(node\as\frame\head\data, node\as\frame\head\length, "table")
            if: is_table
                lm_registry_control_rename_table_column_descriptors(node\as\frame, rename)
            if: is_table = 0
                if: lm_registry_control_text_equals(node\as\frame\head\data, node\as\frame\head\length, "L4") || lm_registry_control_text_equals(node\as\frame\head\data, node\as\frame\head\length, "registry")
                    lm_registry_control_rename_structure_tables(node\as\frame\body, rename)
                ---
            ---
        field: field\next

    return: 0
end: lm_registry_control_rename_structure_tables

fn: lm_registry_control_rename_document_column_descriptor (const: @(LmP0Document document); const: @(char old_name); const: @(char new_name); @: size_t out_changed) int
    @: LmP0Node root
    LmRegistryControlRename: rename

    if: out_changed != 0
        out_changed[0]: 0U

    if: document = 0 || old_name = 0 || new_name = 0
        return: 1

    c.memset(@ rename, 0, c.sizeof(rename))
    c.rename.old_name: old_name
    c.rename.new_name: new_name

    root: c.lm_p0_document_root(document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        return: 1

    lm_registry_control_rename_structure_tables(root\as\structure, @ rename)
    if: out_changed != 0
        out_changed[0]: c.rename.changed_count
    return: 0
end: lm_registry_control_rename_document_column_descriptor

fn: lm_registry_control_parse_file (const: @(char path); @@: LmP0Document out_document; @: LmRegistryControlError error) int
    @: LmP0Document document
    const: @: LmP0Diagnostic diagnostic
    int: status

    if: out_document = 0
        return: 1

    out_document[0]: 0
    document: 0
    status: c.lm_p0_parse_file(path, @ document)
    if: status != 0
        diagnostic: c.lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf:
                c.stderr
                "registry_control parse error %d at %zu:%zu in %s: %s\n"
                diagnostic\code
                diagnostic\line
                diagnostic\column
                path
                diagnostic\message
            ---
        lm_registry_control_error_set(error, "cannot parse registry file")
        c.lm_p0_document_destroy(document)
        return: 1

    out_document[0]: document
    return: 0
end: lm_registry_control_parse_file

fn: lm_registry_control_write_text_file (const: @(char path); const: @(char text); @: LmRegistryControlError error) int
    @: FILE file
    size_t: length

    file: c.fopen(path, "wb")
    if: file = 0
        lm_registry_control_error_set(error, "cannot open registry file for writing")
        return: 1

    length: c.strlen(text)
    if: c.fwrite(text, 1U, length, file) != length
        lm_registry_control_error_set(error, "cannot write registry file")
        c.fclose: file
        return: 1

    if: c.fclose(file) != 0
        lm_registry_control_error_set(error, "cannot close registry file")
        return: 1

    return: 0
end: lm_registry_control_write_text_file

fn: lm_registry_control_rename_file_column_descriptor (const: @(char path); const: @(char old_name); const: @(char new_name); @: size_t out_changed; @: LmRegistryControlError error) int
    @: LmP0Document document
    @: char text
    int: status

    if: out_changed != 0
        out_changed[0]: 0U

    document: 0
    if: lm_registry_control_parse_file(path, @ document, error) != 0
        return: 1

    status: lm_registry_control_rename_document_column_descriptor(document, old_name, new_name, out_changed)
    if: status = 0
        text: lm_registry_control_document_to_lmx_alloc(document, error)
        if: text = 0
            status: 1
        ---
    if: status = 0
        status: lm_registry_control_write_text_file(path, text, error)
    if: text != 0
        c.free(text)
    c.lm_p0_document_destroy(document)
    return: status
end: lm_registry_control_rename_file_column_descriptor

fn: lm_registry_control_rename_files_column_descriptor (int: argc; @@: char argv; const: @(char old_name); const: @(char new_name); @: size_t out_changed; @: LmRegistryControlError error) int
    int: index
    size_t: changed
    size_t: total_changed

    if: out_changed != 0
        out_changed[0]: 0U

    if: argc < 0 || argv = 0
        return: 1

    total_changed: 0U
    index: 0
    while: index < argc
        changed: 0U
        if: lm_registry_control_rename_file_column_descriptor(argv[index], old_name, new_name, @ changed, error) != 0
            if: out_changed != 0
                out_changed[0]: total_changed
            return: 1
        total_changed: total_changed + changed
        index: index + 1

    if: out_changed != 0
        out_changed[0]: total_changed
    return: 0
end: lm_registry_control_rename_files_column_descriptor
