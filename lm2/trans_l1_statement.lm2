fn: lm_trans_pointer_bindings_init () int
    int: status

    if: lm_trans_registry = 0
        return: 1
    if: lm_trans_registry\binding_pointer_bindings != 0
        return: 0

    status: 0
    if: status = 0 && (lm_trans_pointer_binding_push_call_lowering("lm_trans_call_lower_value", @lm_trans_call_lower_value) != 0 || lm_trans_pointer_binding_push_call_lowering("lm_trans_call_lower_statement", @lm_trans_call_lower_statement) != 0)
