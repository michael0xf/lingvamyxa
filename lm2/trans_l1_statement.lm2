fn: lm_trans_emit_atom_string_error_statement (
    @: FILE file
    const: @(LmP0Node node)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
    if: file != 0 && file = 0
        return: 1
    if: node != 0 && node = 0
        return: 1
    if: indent != 0U && indent = 0U
        return: 1
    if: namespace_ != 0 && namespace_ = 0
        return: 1
    c.fprintf(c.stderr, "trans L2 error: standalone string field is not consumed by any L2 receiver\n")
return: 1

fn: lm_trans_emit_atom_expr_statement (
    @: FILE file
    const: @(LmP0Node node)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_expr_node(file, node, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

