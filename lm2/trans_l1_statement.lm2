    status: lm_trans_namespace_declare_c_name(namespace_, name, "variable", slot_name)
    if: status = 0
        status: lm_trans_namespace_declare_relation_text(namespace_, name, "variable.type", frame\head)
return: status

fn: lm_trans_module_init_declare_anonymous_structure (
    const: LmP0Frame: frame
    LmTransModuleInitEntry: entry
    LmTransNamespace: namespace_
) int
    const: LmP0Text: result_name
    const: LmP0Structure: value_body
    @: char c_type_name
    LmP0Text: slot_name
    LmTransDescriptor: descriptor
    LmTransDescriptor: published_descriptor
    int: status

    if: entry = 0 || entry\slot_name = 0 || lm_trans_anonymous_structure_parts(frame, @ result_name, @ value_body) = 0
        return: 1
    c_type_name: lm_trans_l2_object_suffix_name_new(entry\slot_name, "_type")
    if: c_type_name = 0
        return: 1
    finally: lm_own_delete(c_type_name, 0)
    if: lm_trans_module_init_entry_set_c_type_name(entry, c_type_name) != 0
        return: 1

    descriptor: lm_trans_anonymous_structure_descriptor_new(value_body, result_name, entry\c_type_name, namespace_)
    if: descriptor = 0
        return: 1
    finally: lm_trans_descriptor_delete(descriptor)
    if: lm_trans_anonymous_structure_collision_is_unsupported(namespace_, result_name, descriptor)
        return: 1

    slot_name: lm_trans_text_from_cstr(entry\slot_name)
    if: slot_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ slot_name)

    published_descriptor: descriptor
    status: lm_trans_namespace_bind_descriptor_with_c_name(namespace_, result_name, "variable", slot_name, published_descriptor)
    if: status != 0
        return: 1
    descriptor: 0
    entry\descriptor: published_descriptor
    status: lm_trans_namespace_declare_relation_text(namespace_, result_name, "variable.type", result_name)
    if: status != 0
        if: lm_trans_namespace_rollback_descriptor_binding(namespace_, result_name, published_descriptor) = 0
            descriptor: published_descriptor
            entry\descriptor: 0
        ---
        return: 1
    ---
return: 0

fn: lm_trans_module_init_declare_array_reference (
    const: LmP0Frame: frame
    int: element_is_const
    const: LmTransModuleInitEntry: entry
    LmTransNamespace: namespace_
) int
    LmTransCDeclarator: declarator
    LmP0Text: slot_name
    LmP0Text: slice_type
    const: LmP0Text: element_type_name
    const: LmP0Structure: slice_value
    size_t: rank
    int: status

    declarator: lm_trans_module_init_array_declarator_new(frame, namespace_)
    if: declarator = 0 || entry = 0 || entry\slot_name = 0
        lm_trans_statement_c_declarator_destroy(declarator)
        return: 1
    finally: lm_trans_statement_c_declarator_destroy(declarator)

    rank: lm_trans_array_declarator_rank(declarator)
    if: rank = 0U
        c.fprintf(c.stderr, "trans L2 ArrayReference error: ordinary [] declaration requires at least one dimension\n")
        return: 1
    slice_value: lm_trans_array_declarator_single_structure_value(declarator)
    if: slice_value != 0 && (declarator\type_node = 0 || declarator\type_node\kind != c.LM_P0_NODE_ATOM)
        c.fprintf(c.stderr, "trans L2 ArrayReference error: [] slice value declaration expects an element type\n")
        return: 1

    slot_name: lm_trans_text_from_cstr(entry\slot_name)
    slice_type: lm_trans_text_ref_new_cstr("LmSlice")
    if: slot_name = 0 || slice_type = 0
        lm_trans_text_ref_destroy(@ slot_name)
        lm_trans_text_ref_destroy(@ slice_type)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ slot_name)
        lm_trans_text_ref_destroy(@ slice_type)

    status: lm_trans_namespace_declare_c_name(namespace_, declarator\name, "variable", slot_name)
    if: status = 0
        status: lm_trans_namespace_declare_relation_text(namespace_, declarator\name, "variable.type", slice_type)
    if: status = 0
        status: lm_trans_namespace_mark_array_reference(namespace_, declarator\name, rank, declarator\pointer_depth, element_is_const)
    element_type_name: 0
    if: declarator\type_is_head
        element_type_name: declarator\type_head
    if: declarator\type_is_head = 0 && declarator\type_node != 0 && declarator\type_node\kind = c.LM_P0_NODE_ATOM
        element_type_name: declarator\type_node\as\atom
    if: status = 0 && element_type_name != 0
        status: lm_trans_namespace_declare_relation_text(namespace_, declarator\name, "variable.array-element-type", element_type_name)
    if: status = 0
        status: lm_trans_namespace_declare_array_slice_expr(namespace_, declarator\name, entry\slot_name)
    if: status = 0
        status: lm_trans_namespace_declare_array_helper_id(namespace_, declarator\name, entry\id)
return: status

fn: lm_trans_module_init_declare_value (
    const: LmP0Frame: frame
    int: is_const
    LmTransModuleInitEntry: entry
    LmTransNamespace: namespace_
) int
    if: frame = 0 || entry = 0 || namespace_ = 0
        return: 1
    if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_NAMED_STRUCTURE
        if: is_const
            c.fprintf(c.stderr, "trans hosted module-init limitation: const named Structure construction requires referent-const semantics\n")
            return: 1
        return: lm_trans_module_init_declare_named_structure(frame, entry, namespace_)
    if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_ANONYMOUS_STRUCTURE
        if: is_const
            c.fprintf(c.stderr, "trans hosted module-init limitation: const anonymous Structure construction is not supported\n")
            return: 1
        return: lm_trans_module_init_declare_anonymous_structure(frame, entry, namespace_)
    if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_ARRAY_REFERENCE
        return: lm_trans_module_init_declare_array_reference(frame, is_const, entry, namespace_)
    if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_TABLE
        return: lm_trans_module_init_declare_table(frame, entry, namespace_)
return: 1

fn: lm_trans_module_init_emit_value_prelude (
    FILE: file
    const: LmP0Frame: frame
    const: LmTransModuleInitEntry: entry
    LmTransNamespace: namespace_
) int
    if: entry = 0
        return: 1
    if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_ANONYMOUS_STRUCTURE || entry\kind = c.LM_TRANS_MODULE_INIT_KIND_TABLE
        if: entry\c_type_name = 0 || entry\descriptor = 0
            return: 1
        if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_TABLE
            if: lm_trans_l2_runtime_table_module_row_type_refresh(frame, entry, namespace_) != 0
                return: 1
            return: lm_trans_emit_l2_runtime_table_module_row_type(file, entry\c_type_name, entry\descriptor, namespace_)
        return: lm_trans_emit_anonymous_structure_typedef(file, entry\c_type_name, entry\descriptor, 0U, namespace_)
    ---
return: 0

fn: lm_trans_module_init_emit_value_slot (
    FILE: file
    const: LmP0Frame: frame
    const: LmTransModuleInitEntry: entry
    LmTransNamespace: namespace_
) int
    LmP0Text: slot_name
    LmP0Text: c_type_name

    if: file = 0 || frame = 0 || entry = 0 || entry\slot_name = 0
        return: 1
    slot_name: lm_trans_text_from_cstr(entry\slot_name)
    if: slot_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ slot_name)

    if: lm_trans_put(file, "static ") != 0
        return: 1
    if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_ARRAY_REFERENCE || entry\kind = c.LM_TRANS_MODULE_INIT_KIND_TABLE
        if: lm_trans_put(file, "LmSlice *") != 0
            return: 1
        ---
    else:
        if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_NAMED_STRUCTURE
            if: lm_trans_emit_projected_type_name(file, frame\head, namespace_) != 0 || lm_trans_put(file, " *") != 0
                return: 1
            ---
        else:
            if: entry\kind != c.LM_TRANS_MODULE_INIT_KIND_ANONYMOUS_STRUCTURE || entry\c_type_name = 0
                return: 1
            c_type_name: lm_trans_text_from_cstr(entry\c_type_name)
            if: c_type_name = 0
                return: 1
            if: lm_trans_emit_identifier(file, c_type_name) != 0 || lm_trans_put(file, " *") != 0
                lm_trans_text_ref_destroy(@ c_type_name)
                return: 1
            lm_trans_text_ref_destroy(@ c_type_name)
        ---
    ---
    if: lm_trans_emit_identifier(file, slot_name) != 0
        return: 1
return: lm_trans_put(file, ";\n")

