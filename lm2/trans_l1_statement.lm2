fn: lm_trans_emit_l2_runtime_table_arena_value (
    FILE: file
    const: LmP0Frame: rows_frame
    const: @(char base_name)
    const: @(char row_type_name)
    const: @(char result_name)
    @: LmTransL4CallableType column_types
