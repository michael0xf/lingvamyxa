    if: dispatcher_name = 0 || thread_name = 0 || arena_name = 0
        return: 1
    if: lm_trans_put(file, "static int ") != 0 || lm_trans_put(file, dispatcher_name) != 0 || lm_trans_put(file, "(struct LmMessageThread *") != 0 || lm_trans_put(file, thread_name) != 0 || lm_trans_put(file, ", struct LmOwnArena *") != 0 || lm_trans_put(file, arena_name) != 0 || lm_trans_put(file, ");\n") != 0
        return: 1
    if: lm_trans_put(file, "static inline int lm_message_thread_diagnostic_status(const LmMessageThreadExecutionContext *context) {\n") != 0
        return: 1
    if: lm_trans_put(file, "    if (context == 0 || context->diagnostic_code == 0) {\n") != 0
