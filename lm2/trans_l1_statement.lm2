    int: is_raw_pointer

    if: node = 0 || lm_trans_node_is_ignored(node)
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_namespace_value_is_array_reference(namespace_, node\as\atom)
    if: node\kind = c.LM_P0_NODE_FRAME
        if: lm_trans_callable_frame_result_storage_category(node\as\frame, namespace_, @ is_array_reference, @ is_raw_pointer)
            return: is_array_reference
        field: node\as\frame\body\first_field
