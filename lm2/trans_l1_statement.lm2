    descriptor: lm_trans_l2_runtime_table_row_descriptor_new(column_types, column_names, column_count, row_type_name)
    if: descriptor = 0
        return: 1
    finally: lm_trans_descriptor_delete(descriptor)
    published_descriptor: descriptor
    if: lm_trans_emit_l2_runtime_table_local_row_type(file, row_type_name, descriptor, indent, namespace_) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "LmSlice *") != 0 || lm_trans_put(file, value_name) != 0 || lm_trans_put(file, " = 0;\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1
    if: lm_trans_emit_l2_runtime_table_arena_value(file, rows_frame, row_type_name, row_type_name, pending_name, column_types, column_names, column_count, row_count, published_descriptor, indent + 1U, namespace_, "lm_message_thread_owner(lm_lmx_message_thread)", 0) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, value_name) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_put(file, pending_name) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    status: lm_trans_l2_runtime_table_bind_slice(namespace_, table_name, value_name, published_descriptor)
    descriptor: 0
    if: status != 0
        return: 1
