fn: lm_trans_emit_message_thread_main_exit_query (
    FILE: file
    unsigned: indent
    int: report_failure_to_root
) int
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_lmx_application_exit_snapshot_requested = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_lmx_application_exit_snapshot_ready = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_lmx_application_exit_snapshot_status = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_lmx_application_runtime != 0) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (lm_message_thread_runtime_exit_state(lm_lmx_application_runtime, &lm_lmx_application_exit_snapshot_requested, &lm_lmx_application_exit_snapshot_ready, &lm_lmx_application_exit_snapshot_status) != 0) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_lmx_thread_cleanup_failed = 1;\n") != 0
        return: 1
    if: report_failure_to_root
        if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_lmx_application_controller_failure = 1;\n") != 0
            return: 1
        ---
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "} else {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_lmx_application_exit_requested = lm_lmx_application_exit_snapshot_requested;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_lmx_application_exit_ready = lm_lmx_application_exit_snapshot_ready;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_lmx_application_exit_status = lm_lmx_application_exit_snapshot_status;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_message_thread_main_exit_stop_if_ready (
    FILE: file
    unsigned: indent
    int: has_pool
