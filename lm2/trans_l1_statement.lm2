    finally: lm_trans_text_ref_destroy(@ items_name)
return: lm_trans_emit_array_structure_value_fill(file, indent, items_name, element_type, rank, value, namespace_)

fn: lm_trans_emit_type_receiver_structure_value_alloc (
    FILE: file
