    if: out_name != 0
        out_name[0]: 0
    if: frame = 0 || namespace_ = 0 || out_name = 0 || lm_trans_namespace_has_named_structure_binding(namespace_, frame\head) = 0
        return: 0
    body: lm_trans_named_structure_body(frame)
    name_field: lm_trans_nth_field(body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM || lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom) = 0
        return: 0
    out_name[0]: name_field\value\as\atom
return: 1

fn: lm_trans_module_init_array_declarator_new (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) LmTransCDeclarator
    LmTransCDeclarator: declarator

    if: frame = 0 || namespace_ = 0 || lm_trans_text_is_array_receiver_head(frame\head) = 0
        return: 0
    declarator: lm_trans_statement_c_declarator_new()
    if: declarator = 0
        return: 0
    if: lm_trans_array_declarator_read_from_frame(declarator, frame, namespace_, 1, 1, 1, "trans L2 ArrayReference error: [] declaration expects [@...] type name size...", "trans L2 ArrayReference error: array pointer declaration expects type and name", "trans L2 ArrayReference error: array declaration expects a type/name declaration") != 0
        lm_trans_statement_c_declarator_destroy(declarator)
        return: 0
return: declarator

fn: lm_trans_module_init_declare_named_structure (
    const: LmP0Frame: frame
