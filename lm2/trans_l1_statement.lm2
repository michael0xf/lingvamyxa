        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_list_first_field (
    const: LmP0Field: first
    int: unwrap_single_structure
) const: LmP0Field
    if: unwrap_single_structure && first != 0 && first\next = 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_STRUCTURE
        return: first\value\as\structure\first_field
return: first

fn: lm_trans_statement_frame_is_repeatable (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    if: frame = 0
        return: 0
    if: lm_trans_frame_looks_storage_declaration(frame, namespace_)
        return: 1
    if: lm_trans_text_all_char(frame\head, '@') && frame\body\first_field != 0
        return: 1
    if: lm_trans_text_is_array_receiver_head(frame\head) && frame\body\first_field != 0
        return: 1
return: 0

fn: lm_trans_statement_stack_schedule_control (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char keyword)
) int
    const: LmP0Field: body_start
    int: is_loop
    int: status

    is_loop: c.strcmp(keyword, "while") = 0
    body_start: lm_trans_control_body_start(frame)
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, keyword) != 0 || lm_trans_put(file, " (") != 0 || lm_trans_emit_control_condition(file, frame, namespace_) != 0 || lm_trans_put(file, ") {\n") != 0
        return: 1

    lm_trans_namespace_enter_scope(namespace_)
    if: lm_trans_typedef_projection_scope_enter() != 0
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
    if: is_loop && lm_trans_loop_push(namespace_) != 0
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1

    status: lm_trans_statement_stack_push_indent_text(stack, indent, "}\n")
    if: status = 0
        status: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_leave_scope)
    if: status = 0 && is_loop
        status: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_loop_pop)
    if: status = 0
        status: lm_trans_statement_stack_push_scope_cleanups(stack, indent + 1U)
    if: status = 0
        status: lm_trans_statement_stack_push_list(stack, body_start, indent + 1U, 1, 0, 1)

    if: status != 0
        if: is_loop
            lm_trans_loop_pop(namespace_)
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
return: 0

fn: lm_trans_statement_stack_schedule_synchronized (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: body_start
    unsigned: cleanup_id
    int: status

    if: frame = 0 || frame\body\first_field = 0
        c.fprintf(c.stderr, "trans L2 error: synchronized expects an object expression\n")
        return: 1

    cleanup_id: namespace_\next_cleanup_id
    namespace_\next_cleanup_id: namespace_\next_cleanup_id + 1U
    body_start: lm_trans_control_body_start(frame)
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "void *") != 0 || lm_trans_emit_sync_name(file, cleanup_id) != 0 || lm_trans_put(file, " = (void *)(") != 0 || lm_trans_emit_control_condition(file, frame, namespace_) != 0 || lm_trans_put(file, ");\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_synchronized_enter(") != 0 || lm_trans_emit_sync_name(file, cleanup_id) != 0 || lm_trans_put(file, ");\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1

    lm_trans_namespace_enter_scope(namespace_)
    if: lm_trans_typedef_projection_scope_enter() != 0
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
    if: lm_trans_cleanup_push(namespace_, cleanup_id) != 0
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1

    status: lm_trans_statement_stack_push_indent_text(stack, indent, "}\n")
    if: status = 0
        status: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_leave_scope)
    if: status = 0
        status: lm_trans_statement_stack_push_scope_cleanups(stack, indent + 1U)
    if: status = 0
        status: lm_trans_statement_stack_push_list(stack, body_start, indent + 1U, 1, 0, 1)

    if: status != 0
        lm_trans_cleanup_pop(namespace_)
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
return: 0

fn: lm_trans_statement_stack_schedule_else (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    int: status

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "else {\n") != 0
        return: 1

    lm_trans_namespace_enter_scope(namespace_)
    if: lm_trans_typedef_projection_scope_enter() != 0
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
    status: lm_trans_statement_stack_push_indent_text(stack, indent, "}\n")
    if: status = 0
        status: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_leave_scope)
    if: status = 0
        status: lm_trans_statement_stack_push_scope_cleanups(stack, indent + 1U)
    if: status = 0
        status: lm_trans_statement_stack_push_list(stack, frame\body\first_field, indent + 1U, 1, 0, 1)
    if: status != 0
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
return: 0

fn: lm_trans_statement_stack_schedule_named_structure (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    FILE: declaration_file
    int: typedef_suppressed
    int: status

    c.LM_UNUSED(stack)
    if: lm_trans_declare_hosted_named_structure_layout(namespace_, frame) != 0
        return: 1
    declaration_file: lm_trans_tmpfile()
    if: declaration_file = 0
        return: 1
    status: lm_trans_emit_named_structure_typedef(declaration_file, frame, 0U, namespace_)
    if: status = 0
        status: lm_trans_typedef_projection_claim_local_prepared_text(file, frame\head, declaration_file, @ typedef_suppressed)
    c.fclose(declaration_file)
    if: status != 0
        return: 1
    if: typedef_suppressed = 0 && lm_trans_emit_named_structure_typedef(file, frame, indent, namespace_) != 0
        return: 1
return: 0

fn: lm_trans_statement_stack_schedule_merge_named_structure (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Text: target
    FILE: declaration_file
    int: typedef_suppressed
    int: status

    c.LM_UNUSED(stack)
    if: lm_trans_declare_hosted_merge_named_structure_layout(namespace_, frame) != 0
        return: 1
    target: lm_trans_merge_target_name(frame)
    declaration_file: lm_trans_tmpfile()
    if: target = 0 || declaration_file = 0
        return: 1
    status: lm_trans_emit_merge_named_structure_typedef(declaration_file, frame, 0U, namespace_)
    if: status = 0
        status: lm_trans_typedef_projection_claim_local_prepared_text(file, target, declaration_file, @ typedef_suppressed)
    c.fclose(declaration_file)
    if: status != 0
        return: 1
    if: typedef_suppressed = 0 && lm_trans_emit_merge_named_structure_typedef(file, frame, indent, namespace_) != 0
        return: 1
return: 0

fn: lm_trans_statement_emit_return (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    c.LM_UNUSED(stack)
return: lm_trans_emit_return_statement(file, frame\body\first_field, indent, namespace_)

fn: lm_trans_statement_emit_stop (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: status_field

    c.LM_UNUSED(stack)
    if: frame = 0
        return: 1
    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1

    status_field: frame\body\first_field
    if: status_field != 0 && lm_trans_expr_segment_end(status_field) != 0
        c.fprintf(c.stderr, "trans L2 error: stop receiver expects zero or one status expression\n")
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_message_thread_request_stop(lm_lmx_message_thread, ") != 0
        return: 1
    if: status_field = 0
        if: lm_trans_put(file, "0") != 0
            return: 1
    ---
    if: status_field != 0
        if: lm_trans_put(file, "(int)(") != 0 || lm_trans_emit_expr_fields(file, status_field, namespace_) != 0 || lm_trans_put(file, ")") != 0
            return: 1
    ---
    if: lm_trans_put(file, ");\n") != 0
        return: 1
return: 0

fn: lm_trans_statement_emit_exit (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: status_field

    c.LM_UNUSED(stack)
    if: frame = 0 || frame\body = 0
        return: 1
    if: namespace_ = 0 || namespace_\managed_message_thread_context = 0
        c.fprintf(c.stderr, "trans L2 error: exit receiver requires a managed MessageThread or application root context\n")
        return: 1

    status_field: frame\body\first_field
    if: status_field != 0 && lm_trans_expr_segment_end(status_field) != 0
        c.fprintf(c.stderr, "trans L2 error: exit receiver expects zero or one status expression\n")
        return: 1
    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "int lm_lmx_exit_status = ") != 0
        return: 1
    if: status_field = 0
        if: lm_trans_put(file, "0") != 0
            return: 1
        ---
    else:
        if: lm_trans_put(file, "(int)(") != 0 || lm_trans_emit_expr_fields(file, status_field, namespace_) != 0 || lm_trans_put(file, ")") != 0
            return: 1
        ---
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (lm_message_thread_request_exit(lm_lmx_message_thread, lm_lmx_exit_status) != 0) lm_message_thread_request_failure(lm_lmx_message_thread, 1);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

fn: lm_trans_statement_emit_send (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: first
    const: LmP0Field: second
    const: LmP0Field: third
    const: LmP0Field: fourth
    const: LmP0Field: field
    size_t: argument_count

    c.LM_UNUSED(stack)
    if: frame = 0 || frame\body = 0
        return: 1
    if: namespace_ = 0 || namespace_\managed_message_thread_context = 0
        c.fprintf(c.stderr, "trans L2 error: send receiver requires a managed MessageThread or application root context\n")
        return: 1

    argument_count: 0U
    field: frame\body\first_field
    while: field != 0
        argument_count: argument_count + 1U
        field: lm_trans_expr_segment_end(field)
    if: argument_count != 3U && argument_count != 4U
        c.fprintf(c.stderr, "trans L2 error: send receiver expects route, LMX, length or endpoint, route, LMX, length\n")
        return: 1

    first: frame\body\first_field
    second: lm_trans_expr_segment_end(first)
    third: lm_trans_expr_segment_end(second)
    fourth: lm_trans_expr_segment_end(third)

    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "const char *lm_lmx_send_endpoint = ") != 0
        return: 1
    if: argument_count = 4U
        if: lm_trans_put(file, "(const char *)(") != 0 || lm_trans_emit_expr_range(file, first, second, namespace_) != 0 || lm_trans_put(file, ")") != 0
            return: 1
        ---
    else:
        if: lm_trans_put(file, "0") != 0
            return: 1
        ---
    if: lm_trans_put(file, ";\n") != 0
        return: 1

    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "const char *lm_lmx_send_route = (const char *)(") != 0
        return: 1
    if: argument_count = 4U
        if: lm_trans_emit_expr_range(file, second, third, namespace_) != 0
            return: 1
        ---
    else:
        if: lm_trans_emit_expr_range(file, first, second, namespace_) != 0
            return: 1
        ---
    if: lm_trans_put(file, ");\n") != 0
        return: 1

    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "const char *lm_lmx_send_lmx = (const char *)(") != 0
        return: 1
    if: argument_count = 4U
        if: lm_trans_emit_expr_range(file, third, fourth, namespace_) != 0
            return: 1
        ---
    else:
        if: lm_trans_emit_expr_range(file, second, third, namespace_) != 0
            return: 1
        ---
    if: lm_trans_put(file, ");\n") != 0
        return: 1

    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "size_t lm_lmx_send_length = (size_t)(") != 0
        return: 1
    if: argument_count = 4U
        if: lm_trans_emit_expr_range(file, fourth, 0, namespace_) != 0
            return: 1
        ---
    else:
        if: lm_trans_emit_expr_range(file, third, 0, namespace_) != 0
            return: 1
        ---
    if: lm_trans_put(file, ");\n") != 0
        return: 1

    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "int lm_lmx_send_status = lm_message_thread_send_lmx(lm_lmx_message_thread, lm_lmx_send_endpoint, lm_lmx_send_route, lm_lmx_send_lmx, lm_lmx_send_length);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (lm_lmx_send_status != 0) lm_message_thread_request_failure(lm_lmx_message_thread, lm_lmx_send_status);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_throw_channel_prelude (FILE: file) int
    if: lm_trans_emitted_throw_channel
        return: 0
    lm_trans_emitted_throw_channel: 1
    if: lm_trans_put(file, "static int lm_throw_code = 0;\n") != 0
        return: 1
    if: lm_trans_put(file, "static union { long i; void *p; } lm_throw_payload[8];\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_throw_return (
    FILE: file
    unsigned: indent
    LmTransNamespace: namespace_
) int
    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: namespace_ = 0 || namespace_\return_type_node = 0
        return: lm_trans_put(file, "return;\n")
    if: namespace_\return_type_is_struct
        c.fprintf(c.stderr, "trans L2 error: throw from fm Structure return is not implemented in this profile\n")
        return: 1
return: lm_trans_put(file, "return 0;\n")

fn: lm_trans_symbol_throws_node (const: (LmTransSymbol: symbol)) const: LmP0Node
    if: symbol = 0 || symbol\has_callable_shape = 0
        return: 0
return: symbol\callable_throws_node

fn: lm_trans_node_throws_node (const: (LmP0Node: node); const: (LmTransNamespace: namespace_)) const: LmP0Node
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as\frame = 0
        return: 0
return: lm_trans_symbol_throws_node(lm_trans_namespace_find(namespace_, node\as\frame\head))

fn: lm_trans_emit_throwing_dispatch (
    FILE: file
    unsigned: indent
    LmTransNamespace: namespace_
    const: LmP0Node: throws_node
) int
    const: LmP0Field: field
    const: LmP0Node: name_node
    const: LmP0Text: name
    LmTransCatchPad: pad
    int: code

    if: throws_node = 0
        return: 0
    if: throws_node\kind != c.LM_P0_NODE_FRAME || throws_node\as\frame = 0 || throws_node\as\frame\body = 0
        return: 1
    if: lm_trans_emit_throw_channel_prelude(lm_trans_prelude_file(file)) != 0
        return: 1

    field: throws_node\as\frame\body\first_field
    while: field != 0
        name_node: field\value
        if: name_node = 0 || name_node\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: throws lists names, not types\n")
            return: 1
        name: name_node\as\atom
        code: lm_trans_throw_name_code(name)
        if: code = 0
            return: 1
        pad: lm_trans_catch_find(namespace_, name)
        if: pad != 0
            if: lm_trans_emit_indent(file, indent) != 0
                return: 1
            if: c.fprintf(file, "if (lm_throw_code == %d) goto lm_catch_%u;\n", code, pad\id) < 0
                return: 1
            ---
        else:
            if: lm_trans_throws_contains(namespace_\throws_node, name) = 0
                c.fprintf(c.stderr, "trans L2 error: throw \"%.*s\" is not caught and is not in throws\n", (cast: int name\length), name\data)
                return: 1
            if: lm_trans_emit_indent(file, indent) != 0
                return: 1
            if: c.fprintf(file, "if (lm_throw_code == %d) {\n", code) < 0
                return: 1
            if: lm_trans_emit_throw_return(file, indent + 1U, namespace_) != 0
                return: 1
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
                return: 1
            ---
        field: field\next
return: 0

fn: lm_trans_emit_for_expr_segment (
    FILE: file
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
) int
    const: LmP0Node: node

    if: first = 0
        return: 0
    node: first\value
    if: node != 0 && node\kind = c.LM_P0_NODE_STRUCTURE && first\next = stop
        return: lm_trans_emit_expr_range(file, node\as\structure\first_field, 0, namespace_)
return: lm_trans_emit_expr_range(file, first, stop, namespace_)

fn: lm_trans_statement_stack_schedule_for (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: init_field
    const: LmP0Field: condition_field
    const: LmP0Field: step_field
    const: LmP0Field: body_field
    const: LmP0Node: init_node
    int: status

    if: frame = 0 || frame\body = 0 || frame\body\first_field = 0
        c.fprintf(c.stderr, "trans L2 error: for receiver expects init, condition, step and body\n")
        return: 1

    init_field: frame\body\first_field
    condition_field: lm_trans_expr_segment_end(init_field)
    if: condition_field = 0
        c.fprintf(c.stderr, "trans L2 error: for receiver expects init, condition, step and body\n")
        return: 1
    step_field: lm_trans_expr_segment_end(condition_field)
    if: step_field = 0
        c.fprintf(c.stderr, "trans L2 error: for receiver expects init, condition, step and body\n")
        return: 1
    body_field: lm_trans_expr_segment_end(step_field)

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1

    lm_trans_namespace_enter_scope(namespace_)
    if: lm_trans_typedef_projection_scope_enter() != 0
        lm_trans_namespace_leave_scope(namespace_)
        return: 1

    init_node: init_field\value
    if: init_node != 0 && init_node\kind = c.LM_P0_NODE_FRAME && lm_trans_frame_looks_storage_declaration(init_node\as\frame, namespace_)
        if: lm_trans_emit_declaration(file, init_node\as\frame, indent + 1U, namespace_) != 0
            lm_trans_typedef_projection_scope_leave()
            lm_trans_namespace_leave_scope(namespace_)
            return: 1
        ---
    else:
        if: lm_trans_emit_indent(file, indent + 1U) != 0
            lm_trans_typedef_projection_scope_leave()
            lm_trans_namespace_leave_scope(namespace_)
            return: 1
        if: lm_trans_emit_for_expr_segment(file, init_field, condition_field, namespace_) != 0 || lm_trans_put(file, ";\n") != 0
            lm_trans_typedef_projection_scope_leave()
            lm_trans_namespace_leave_scope(namespace_)
            return: 1
        ---

    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "for (; ") != 0
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
    if: lm_trans_emit_for_expr_segment(file, condition_field, step_field, namespace_) != 0
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
    if: lm_trans_put(file, "; ") != 0
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
    if: lm_trans_emit_for_expr_segment(file, step_field, body_field, namespace_) != 0
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
    if: lm_trans_put(file, ") {\n") != 0
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1

    if: lm_trans_loop_push(namespace_) != 0
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1

    status: lm_trans_statement_stack_push_indent_text(stack, indent, "}\n")
    if: status = 0
        status: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_leave_scope)
    if: status = 0
        status: lm_trans_statement_stack_push_indent_text(stack, indent + 1U, "}\n")
    if: status = 0
        status: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_loop_pop)
    if: status = 0
        status: lm_trans_statement_stack_push_scope_cleanups(stack, indent + 2U)
    if: status = 0 && body_field != 0
        status: lm_trans_statement_stack_push_list(stack, body_field, indent + 2U, 1, 0, 1)

    if: status != 0
        lm_trans_loop_pop(namespace_)
        lm_trans_typedef_projection_scope_leave()
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
return: 0

fn: lm_trans_statement_emit_if (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
return: lm_trans_statement_stack_schedule_control(file, stack, frame, indent, namespace_, "if")

fn: lm_trans_statement_emit_while (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
return: lm_trans_statement_stack_schedule_control(file, stack, frame, indent, namespace_, "while")

fn: lm_trans_statement_emit_for (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
return: lm_trans_statement_stack_schedule_for(file, stack, frame, indent, namespace_)

fn: lm_trans_statement_emit_throws (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    c.LM_UNUSED(file)
    c.LM_UNUSED(stack)
    c.LM_UNUSED(indent)
    c.LM_UNUSED(namespace_)
    if: frame = 0
        return: 1
    c.fprintf(c.stderr, "trans L2 error: throws is only valid immediately after the function header\n")
return: 1

fn: lm_trans_statement_emit_throw (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: name_field
    const: LmP0Node: name_node
    const: LmP0Frame: throw_frame
    const: LmP0Field: arg
    const: LmP0Field: arg_next
    const: LmP0Text: name
    int: code
    int: slot

    c.LM_UNUSED(stack)
    if: frame = 0 || frame\body = 0 || frame\body\first_field = 0
        c.fprintf(c.stderr, "trans L2 error: throw receiver expects Name(arguments)\n")
        return: 1

    name_field: frame\body\first_field
    name_node: name_field\value
    if: name_node = 0 || name_node\kind != c.LM_P0_NODE_FRAME || name_node\as\frame = 0
        c.fprintf(c.stderr, "trans L2 error: throw receiver expects Name(arguments)\n")
        return: 1
    if: name_field\next != 0
        c.fprintf(c.stderr, "trans L2 error: throw receiver expects a single Name(arguments) form\n")
        return: 1

    throw_frame: name_node\as\frame
    name: throw_frame\head
    if: lm_trans_throws_contains(namespace_\throws_node, name) = 0
        c.fprintf(c.stderr, "trans L2 error: throw \"%.*s\" is not in the current throws set\n", (cast: int name\length), name\data)
        return: 1

    code: lm_trans_throw_name_code(name)
    if: code = 0
        return: 1
    if: lm_trans_emit_throw_channel_prelude(lm_trans_prelude_file(file)) != 0
        return: 1

    slot: 0
    if: throw_frame\body != 0
        arg: throw_frame\body\first_field
        while: arg != 0
            if: slot >= 8
                c.fprintf(c.stderr, "trans L2 error: throw payload is limited to 8 arguments in this profile\n")
                return: 1
            arg_next: lm_trans_expr_segment_end(arg)
            if: lm_trans_emit_indent(file, indent) != 0
                return: 1
            if: c.fprintf(file, "lm_throw_payload[%d].i = (long)(", slot) < 0
                return: 1
            if: lm_trans_emit_expr_range(file, arg, arg_next, namespace_) != 0
                return: 1
            if: lm_trans_put(file, ");\n") != 0
                return: 1
            if: lm_trans_emit_indent(file, indent) != 0
                return: 1
            if: c.fprintf(file, "lm_throw_payload[%d].p = (void *)(unsigned long)lm_throw_payload[%d].i;\n", slot, slot) < 0
                return: 1
            slot: slot + 1
            arg: arg_next
        ---
    ---

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: c.fprintf(file, "lm_throw_code = %d;\n", code) < 0
        return: 1
return: lm_trans_emit_throw_return(file, indent, namespace_)

fn: lm_trans_catch_param_is_integer (const: (LmP0Text: type_head)) int
return: lm_trans_text_equals(type_head, "int") || lm_trans_text_equals(type_head, "unsigned") || lm_trans_text_equals(type_head, "long") || lm_trans_text_equals(type_head, "short") || lm_trans_text_equals(type_head, "size_t") || lm_trans_text_equals(type_head, "char")

fn: lm_trans_emit_catch_params (
    FILE: file
    const: LmP0Structure: params
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    const: LmP0Node: node
    const: LmP0Frame: param_frame
    const: LmP0Field: name_field
    const: LmP0Node: name_node
    int: slot

    if: params = 0
        return: 0

    slot: 0
    field: params\first_field
    while: field != 0
        node: field\value
        if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as\frame = 0
            c.fprintf(c.stderr, "trans L2 error: catch parameters expect type: name bindings\n")
            return: 1
        param_frame: node\as\frame
        name_field: 0
        if: param_frame\body != 0
            name_field: param_frame\body\first_field
        if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: catch parameter expects a name\n")
            return: 1
        if: slot >= 8
            c.fprintf(c.stderr, "trans L2 error: catch payload is limited to 8 arguments in this profile\n")
            return: 1
        name_node: name_field\value
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        if: lm_trans_emit_type_head_only(file, param_frame\head, namespace_) != 0
            return: 1
        if: lm_trans_put(file, " ") != 0 || lm_trans_emit_identifier(file, name_node\as\atom) != 0
            return: 1
        if: lm_trans_catch_param_is_integer(param_frame\head)
            if: c.fprintf(file, " = (") < 0
                return: 1
            if: lm_trans_emit_type_head_only(file, param_frame\head, namespace_) != 0
                return: 1
            if: c.fprintf(file, ")lm_throw_payload[%d].i;\n", slot) < 0
                return: 1
            ---
        else:
            if: c.fprintf(file, " = (") < 0
                return: 1
            if: lm_trans_emit_type_head_only(file, param_frame\head, namespace_) != 0
                return: 1
            if: c.fprintf(file, ")lm_throw_payload[%d].p;\n", slot) < 0
                return: 1
            ---
        if: lm_trans_namespace_declare_storage_binding(namespace_, name_node\as\atom, param_frame\head) != 0
            return: 1
        slot: slot + 1
        field: field\next
return: 0

fn: lm_trans_statement_emit_catch (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: name_field
    const: LmP0Field: params_field
    const: LmP0Field: body_field
    const: LmP0Node: name_node
    const: LmP0Structure: params
    const: LmP0Field: body_start
    unsigned: catch_id
    LmTransCatchPad: pad

    c.LM_UNUSED(stack)
    if: frame = 0 || frame\body = 0 || frame\body\first_field = 0
        c.fprintf(c.stderr, "trans L2 error: catch receiver expects Name (parameters)\n")
        return: 1

    name_field: frame\body\first_field
    name_node: name_field\value
    if: name_node = 0 || name_node\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: catch receiver expects a throw name\n")
        return: 1

    params_field: name_field\next
    if: params_field = 0 || params_field\value = 0 || params_field\value\kind != c.LM_P0_NODE_STRUCTURE
        c.fprintf(c.stderr, "trans L2 error: catch receiver expects Name (parameters)\n")
        return: 1
    params: params_field\value\as\structure
    body_field: params_field\next
    body_start: body_field
    if: body_field != 0 && body_field\next = 0 && body_field\value != 0 && body_field\value\kind = c.LM_P0_NODE_STRUCTURE
        body_start: body_field\value\as\structure\first_field

    if: lm_trans_throw_name_code(name_node\as\atom) = 0
        return: 1
    if: lm_trans_emit_throw_channel_prelude(lm_trans_prelude_file(file)) != 0
        return: 1

    pad: lm_trans_catch_find(namespace_, name_node\as\atom)
    if: pad = 0 || pad\depth != namespace_\depth
        c.fprintf(c.stderr, "trans L2 internal error: catch \"%.*s\" was not registered in this block\n", (cast: int name_node\as\atom\length), name_node\as\atom\data)
        return: 1
    catch_id: pad\id

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: c.fprintf(file, "goto lm_after_catch_%u;\n", catch_id) < 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: c.fprintf(file, "lm_catch_%u: {\n", catch_id) < 0
        return: 1
    if: lm_trans_emit_catch_params(file, params, indent + 1U, namespace_) != 0
        return: 1
    if: body_start != 0 && lm_trans_emit_statement_list(file, body_start, indent + 1U, namespace_) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: c.fprintf(file, "lm_after_catch_%u: ;\n", catch_id) < 0
        return: 1
return: 0

fn: lm_trans_statement_emit_else (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
return: lm_trans_statement_stack_schedule_else(file, stack, frame, indent, namespace_)

fn: lm_trans_statement_emit_synchronized (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
return: lm_trans_statement_stack_schedule_synchronized(file, stack, frame, indent, namespace_)

fn: lm_trans_statement_emit_finally (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    c.LM_UNUSED(file)
    c.LM_UNUSED(stack)
    c.LM_UNUSED(indent)
    if: frame = 0 || frame\body = 0 || frame\body\first_field = 0
        return: 1
return: lm_trans_finally_push(namespace_, frame\body\first_field)

fn: lm_trans_statement_emit_assert (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    c.LM_UNUSED(stack)
    if: frame = 0 || frame\body = 0 || frame\body\first_field = 0
        c.fprintf(c.stderr, "trans L2 error: assert receiver expects condition expression\n")
        return: 1
    if: lm_trans_emit_message_thread_assert_helper(lm_trans_prelude_file(file)) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (!(") != 0
        return: 1
    if: lm_trans_emit_control_condition(file, frame, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ")) {\n") != 0
        return: 1
    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "lm_message_thread_assert_violation(lm_lmx_message_thread, __FILE__, __LINE__, \"assert\");\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

