fn: lm_trans_array_formal_param_type_info (
    const: LmTransFormalParam: param
    const: @(LmP0Node out_element_type)
    @: size_t out_rank
    @: size_t out_pointer_depth
) int
    LmP0Text: dimension
    size_t: dimension_index
    size_t: rank

    if: out_element_type != 0
        out_element_type[0]: 0
    if: out_rank != 0
        out_rank[0]: 0U
    if: out_pointer_depth != 0
        out_pointer_depth[0]: 0U

    if: param = 0 || param\is_array = 0 || param\declarator = 0
        return: 0

    dimension_index: 0U
    rank: 0U
    dimension: lm_trans_text_ref_new_cstr("")
    if: dimension = 0
        return: 0
    while: lm_trans_array_head_next_dimension(param\declarator\array_head, @ dimension_index, dimension)
        rank: rank + 1U
    if: rank = 0U
        lm_trans_text_ref_destroy(@ dimension)
        return: 0

    if: out_element_type != 0
        out_element_type[0]: param\declarator\type_node
    if: out_rank != 0
        out_rank[0]: rank
    if: out_pointer_depth != 0
        out_pointer_depth[0]: param\declarator\pointer_depth
    lm_trans_text_ref_destroy(@ dimension)
return: 1

fn: lm_trans_emit_array_value_helper (
    FILE: file
    const: LmTransFormalParam: param
    const: LmP0Structure: value
    const: LmTransNamespace: namespace_
    LmP0Text: out_name
) int
    FILE: prelude_file
    FILE: definition_file
    const: LmP0Node: element_type
    LmP0Text: helper_name_text
    LmP0Text: target_name
    LmP0Text: slice_name
    @: char helper_name
    @: char target_name_storage
    @: char slice_name_storage
    @: char owner_expression
    const: @: char thread_name
    int: owner_needed
    size_t: rank
    size_t: pointer_depth
    size_t: count

    if: out_name != 0
        out_name\data: ""
        out_name\length: 0U
    if: out_name = 0 || value = 0 || lm_trans_array_formal_param_type_info(param, @ element_type, @ rank, @ pointer_depth) = 0
        return: 1

    helper_name: lm_trans_array_value_helper_name_new()
    if: helper_name = 0
        return: 1
    finally: lm_own_delete(helper_name, 0)

    target_name_storage: lm_trans_l2_object_suffix_name_new(helper_name, "_value")
    slice_name_storage: lm_trans_l2_object_suffix_name_new(helper_name, "_slice")
    thread_name: lm_trans_module_init_thread_name()
    if: target_name_storage = 0 || slice_name_storage = 0 || thread_name = 0
        lm_own_delete(target_name_storage, 0)
        lm_own_delete(slice_name_storage, 0)
        return: 1
    finally:
        lm_own_delete(target_name_storage, 0)
        lm_own_delete(slice_name_storage, 0)

    helper_name_text: lm_trans_text_ref_new_cstr(helper_name)
    target_name: lm_trans_text_ref_new_cstr(target_name_storage)
    slice_name: lm_trans_text_ref_new_cstr(slice_name_storage)
    if: helper_name_text = 0 || target_name = 0 || slice_name = 0
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ helper_name_text)
        lm_trans_text_ref_destroy(@ target_name)
        lm_trans_text_ref_destroy(@ slice_name)

    prelude_file: lm_trans_prelude_file(file)
    count: lm_trans_structure_field_count(value)
    owner_needed: c.snprintf(0, 0, "lm_message_thread_owner(%s)", thread_name)
    if: owner_needed < 0
        return: 1
    owner_expression: cast: (@: char) lm_own_new_zero((cast: size_t owner_needed) + 1U)
    if: owner_expression = 0
        return: 1
    finally: lm_own_delete(owner_expression, 0)
    if: c.snprintf(owner_expression, (cast: size_t owner_needed) + 1U, "lm_message_thread_owner(%s)", thread_name) != owner_needed
        return: 1

    if: lm_trans_emit_message_thread_runtime_prelude(prelude_file) != 0
        return: 1
    definition_file: lm_trans_tmpfile()
    if: definition_file = 0 || lm_trans_typedef_projection_prelude_alias_enter(definition_file) != 0
        if: definition_file != 0
            c.fclose(definition_file)
        ---
        return: 1
    ---
    finally:
        lm_trans_typedef_projection_prelude_alias_leave(definition_file)
        c.fclose(definition_file)

    if: lm_trans_put(definition_file, "static LmSlice *") != 0 || lm_trans_emit_identifier(definition_file, helper_name_text) != 0 || lm_trans_put(definition_file, "(struct LmMessageThread *") != 0 || lm_trans_put(definition_file, thread_name) != 0 || lm_trans_put(definition_file, ") {\n    ") != 0 || lm_trans_emit_array_pointer_type(definition_file, element_type, pointer_depth + rank, namespace_) != 0 || lm_trans_put(definition_file, " ") != 0 || lm_trans_write_text(definition_file, target_name) != 0 || lm_trans_put(definition_file, ";\n    LmSlice *") != 0 || lm_trans_write_text(definition_file, slice_name) != 0 || lm_trans_put(definition_file, ";\n") != 0
        return: 1
    lm_trans_module_init_emission_enter()
    finally: lm_trans_module_init_emission_leave()
    if: lm_trans_emit_array_structure_value_alloc_assignment(definition_file, 1U, target_name, 0, 0U, element_type, pointer_depth + rank, rank, count, namespace_, thread_name, owner_expression) != 0
        return: 1

    if: count != 0U && (lm_trans_put(definition_file, "    if (") != 0 || lm_trans_write_text(definition_file, target_name) != 0 || lm_trans_put(definition_file, " == 0) {\n        return 0;\n    }\n") != 0)
        return: 1

    if: count != 0U && lm_trans_emit_array_structure_value_fill(definition_file, 1U, target_name, element_type, rank, value, namespace_, thread_name, owner_expression, 0) != 0
        return: 1

    if: lm_trans_put(definition_file, "    ") != 0 || lm_trans_write_text(definition_file, slice_name) != 0 || lm_trans_put(definition_file, " = (LmSlice *)lm_own_arena_new_zero(") != 0 || lm_trans_put(definition_file, thread_name) != 0 || lm_trans_put(definition_file, ", ") != 0 || lm_trans_put(definition_file, owner_expression) != 0 || lm_trans_put(definition_file, ", sizeof(*") != 0 || lm_trans_write_text(definition_file, slice_name) != 0 || lm_trans_put(definition_file, "));\n    if (") != 0 || lm_trans_write_text(definition_file, slice_name) != 0 || lm_trans_put(definition_file, " == 0) {\n        return 0;\n    }\n    ") != 0 || lm_trans_write_text(definition_file, slice_name) != 0 || lm_trans_put(definition_file, "->ptr = (void *)") != 0 || lm_trans_write_text(definition_file, target_name) != 0 || lm_trans_put(definition_file, ";\n    ") != 0 || lm_trans_write_text(definition_file, slice_name) != 0 || lm_trans_put(definition_file, "->length = ") != 0 || lm_trans_emit_size_literal(definition_file, count) != 0 || lm_trans_put(definition_file, ";\n    return ") != 0 || lm_trans_write_text(definition_file, slice_name) != 0 || lm_trans_put(definition_file, ";\n}\n\n") != 0
        return: 1

    if: lm_trans_copy_stream(prelude_file, definition_file) != 0
        return: 1

    if: lm_own_ptr_stack_push(lm_trans_emitted_array_value_helpers, helper_name) != 0
        return: 1

    out_name[0]: helper_name_text[0]
    helper_name: 0
return: 0

fn: lm_trans_callable_frame_result_storage_category (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
    @: int out_array_reference
    @: int out_raw_pointer
) int
    const: LmTransSymbol: symbol
    LmTransL4CallableType: type

    if: out_array_reference != 0
        out_array_reference[0]: 0
    if: out_raw_pointer != 0
        out_raw_pointer[0]: 0
    if: frame = 0 || out_array_reference = 0 || out_raw_pointer = 0
        return: 0
    symbol: lm_trans_namespace_find(namespace_, frame\head)
    if: symbol = 0 || lm_trans_symbol_is_executable_callable(symbol) = 0 || symbol\callable_returns_value = 0 || symbol\callable_return_node = 0
        return: 0

    type: lm_trans_expr_callable_type_new()
    if: type = 0
        return: 0
    if: lm_trans_l4_callable_type_from_node(symbol\callable_return_node, type) = 0
        lm_trans_expr_callable_type_delete(type)
        return: 0
    out_array_reference[0]: type\array_rank != 0U || (type\address_depth = 0U && lm_trans_text_equals(type\class_name, "LmSlice"))
    out_raw_pointer[0]: out_array_reference[0] = 0 && type\address_depth != 0U
    lm_trans_expr_callable_type_delete(type)
return: 1

fn: lm_trans_node_has_direct_array_reference (
    const: LmP0Node: node
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: field
