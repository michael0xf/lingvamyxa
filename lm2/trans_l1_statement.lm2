return: lm_trans_function_header_common(frame, is_external, out, 0, 1, 0)

fn: lm_trans_receiver_sub (
    const: LmP0Frame: frame
    int: is_external
    LmTransFunctionHeader: out
) int
return: lm_trans_function_header_common(frame, is_external, out, 1, 0, 0)

fn: lm_trans_thread_route_literal_valid (const: (LmP0Text: literal)) int
    size_t: index
    uchar: ch

    if: literal = 0 || literal\length < 3U || literal\data[0] != '"' || literal\data[literal\length - 1U] != '"' || literal\data[1] != '/'
        return: 0

    index: 1U
    while: index + 1U < literal\length
        ch: (cast: uchar literal\data[index])
        if: ch < 32U || ch > 126U || ch = '\\' || ch = '?' || ch = '#' || ch = '"'
            return: 0
        index: index + 1U
return: 1

fn: lm_trans_receiver_thread (
    const: LmP0Frame: frame
    int: is_external
    LmTransFunctionHeader: out
) int
    int: status
    const: LmTransFormalParam: param
    const: LmP0Field: route_field
    const: LmP0Frame: route_frame
    const: LmP0Field: route_value

    status: lm_trans_function_header_common(frame, is_external, out, 1, 0, 0)
    if: status <= 0
        return: status
    if: is_external
        c.fprintf(c.stderr, "trans L2 error: thread declaration cannot be external\n")
        return: -1
    if: out\is_descriptor_only
        c.fprintf(c.stderr, "trans L2 error: thread declaration requires route metadata and an executable body\n")
        return: -1
    if: out\params = 0 || out\params\count != 1U
        c.fprintf(c.stderr, "trans L2 error: thread declaration expects exactly one named IncomingMessage parameter\n")
        return: -1
    param: out\params\params[0]
    if: param = 0 || param\has_name = 0 || param\is_array || param\type = 0 || param\type\class_name = 0 || lm_trans_text_equals(param\type\class_name, "IncomingMessage") = 0 || param\type\address_depth != 0U || param\type\array_rank != 0U || param\type\is_const
        c.fprintf(c.stderr, "trans L2 error: thread declaration expects exactly one named parameter of exact class IncomingMessage\n")
        return: -1

    route_field: out\body_start
    if: route_field = 0 || route_field\value = 0 || route_field\value\kind != c.LM_P0_NODE_FRAME
        c.fprintf(c.stderr, "trans L2 error: first thread body frame must be route: \"/absolute/path\"\n")
        return: -1
    route_frame: route_field\value\as\frame
    route_value: route_frame\body\first_field
    if: lm_trans_text_equals(route_frame\head, "route") = 0 || route_value = 0 || route_value\next != 0 || route_value\value = 0 || route_value\value\kind != c.LM_P0_NODE_ATOM || route_frame\trailer != 0 || lm_trans_thread_route_literal_valid(route_value\value\as\atom) = 0
        c.fprintf(c.stderr, "trans L2 error: thread route must be one double-quoted ASCII absolute path without controls, backslash, ?, or #\n")
        return: -1

    out\is_thread_handler: 1
    out\thread_route_literal: route_value\value\as\atom
    out\body_start: route_field\next
return: 1

sub: lm_trans_pointer_binding_delete (@: void object)
    LmTransPointerBinding: binding

    binding: (cast: (LmTransPointerBinding) object)
    if: binding = 0
        return
    lm_own_delete(binding\value, 0)
    lm_own_delete(binding, 0)
end: lm_trans_pointer_binding_delete

fn: lm_trans_pointer_binding_push (
    const: @: char name
    const: LmTransBinding: value
) int
    LmTransPointerBinding: binding

    if: lm_trans_registry = 0 || name = 0 || value = 0
        return: 1
    if: lm_trans_registry\binding_pointer_bindings = 0
        lm_trans_registry\binding_pointer_bindings: lm_trans_ptr_stack_new(@lm_trans_pointer_binding_delete)
        if: lm_trans_registry\binding_pointer_bindings = 0
            return: 1

    ---
    binding: (cast: (LmTransPointerBinding) lm_own_new_zero(c.sizeof(binding[0])))
    if: binding = 0
        return: 1
    binding\name: name
    binding\value: (cast: (LmTransBinding) lm_own_new_zero(c.sizeof(binding\value[0])))
    if: binding\value = 0
        lm_trans_pointer_binding_delete(binding)
        return: 1
    binding\value[0]: value[0]
    if: lm_own_ptr_stack_push(lm_trans_registry\binding_pointer_bindings, binding) != 0
        lm_trans_pointer_binding_delete(binding)
        return: 1
return: 0

