fn: lm_trans_formal_param_list_has_any (const: (LmTransFormalParamList: params)) int
return: params != 0 && params\count != 0U

fn: lm_trans_emit_capture_field (
    FILE: file
    const: LmTransCapture: capture
    unsigned: indent
    size_t: extra_pointer_depth
    const: LmTransNamespace: namespace_
) int
    size_t: i

    if: capture = 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: capture\type_is_head
        if: lm_trans_emit_type_head_only(file, capture\type_head, namespace_) != 0
            return: 1
    ---
    if: capture\type_is_head = 0
        if: lm_trans_emit_type_node(file, capture\type_node, namespace_) != 0
            return: 1
    ---
    if: lm_trans_put(file, " ") != 0
        return: 1
    i: 0U
    while: i < capture\pointer_depth + extra_pointer_depth
        if: lm_trans_put(file, "*") != 0
            return: 1
        i: i + 1U
    if: lm_trans_emit_identifier(file, capture\name) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_env_type_raw (
    FILE: file
    const: LmTransFunctionHeader: function
    const: LmTransNamespace: namespace_
) int
    size_t: i
    const: LmTransCapture: capture

    if: function = 0 || function\has_env = 0 || function\captures = 0
        return: 0

    if: lm_trans_put(file, "typedef struct ") != 0
        return: 1
    if: lm_trans_write_text(file, function\env_type_name) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_write_text(file, function\env_type_name) != 0
        return: 1
    if: lm_trans_put(file, ";\n\nstruct ") != 0
        return: 1
    if: lm_trans_write_text(file, function\env_type_name) != 0
        return: 1
    if: lm_trans_put(file, " {\n") != 0
        return: 1

    i: 0U
    while: i < function\captures\count
        capture: (cast: (const: LmTransCapture) lm_own_ptr_stack_at(function\captures, i))
        if: lm_trans_emit_capture_field(file, capture, 1U, 0U, namespace_) != 0
            return: 1
        i: i + 1U

return: lm_trans_put(file, "};\n\n")

fn: lm_trans_emit_env_type (
    FILE: file
    const: LmTransFunctionHeader: function
    const: LmTransNamespace: namespace_
) int
    FILE: declaration_file
    int: emitted
    int: status

    if: function = 0 || function\has_env = 0 || function\captures = 0
        return: 0

    declaration_file: c.tmpfile()
    if: declaration_file = 0
        return: 1
    status: lm_trans_emit_env_type_raw(declaration_file, function, namespace_)
    if: status = 0
        status: lm_trans_typedef_projection_emit_prepared_text(file, function\env_type_name, declaration_file, @ emitted)
    c.fclose(declaration_file)
return: status

fn: lm_trans_control_body_start (const: (LmP0Frame: frame)) const: LmP0Field
    const: LmP0Field: end_field

    if: frame = 0 || frame\body\first_field = 0
        return: 0

    end_field: lm_trans_expr_segment_end(frame\body\first_field)
    if: end_field != 0 && end_field\value != 0 && end_field\value\kind = c.LM_P0_NODE_STRUCTURE
        return: end_field

return: 0

fn: lm_trans_emit_control_condition (
    FILE: file
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: body_start
    const: LmP0Field: first
    const: LmP0Node: node

    first: frame\body\first_field
    if: first = 0
        return: 0

    body_start: lm_trans_control_body_start(frame)
    while: first != 0 && first\next = body_start
        node: first\value
        if: node = 0 || node\kind != c.LM_P0_NODE_STRUCTURE
            break
        first: node\as\structure\first_field
        body_start: 0
    ---
return: lm_trans_emit_expr_range(file, first, body_start, namespace_)

fn: lm_trans_parse_size_payload (const: @(char payload); @: size_t out_value) int
    @: char end_index
    ulong: value

    if: payload = 0 || payload[0] = '\0' || out_value = 0
        return: 0

    end_index: 0
    value: c.strtoul(payload, @ end_index, 10)
    if: end_index = payload || end_index = 0 || end_index[0] != '\0'
        return: 0

    out_value[0]: (cast: size_t value)
return: 1

fn: lm_trans_positional_name_index_payload (const: (LmP0Text: receiver_key)) const: @: char
return: lm_trans_namespace_registry_source_path_n2_named_typed_value(0, receiver_key, "receiver.positional-name.index", "class", "class", "index", "size_t")

fn: lm_trans_positional_name_argument_payload (const: (LmP0Text: receiver_key)) const: @: char
return: lm_trans_namespace_registry_source_path_n2_named_typed_value(0, receiver_key, "receiver.positional-name.argument", "class", "class", "argument", "class")

fn: lm_trans_frame_positional_name_index (const: (LmP0Frame: frame); @: size_t out_index) int
    const: @: char index_payload
    const: @: char argument_payload
    LmP0Text: receiver_key

    if: frame = 0 || out_index = 0
        return: 0

    receiver_key: lm_trans_statement_text_new()
    if: receiver_key = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ receiver_key)

    if: lm_trans_frame_receiver_key(frame, receiver_key) = 0
        return: 0

    index_payload: lm_trans_positional_name_index_payload(receiver_key)
    if: index_payload != 0
        if: lm_trans_parse_size_payload(index_payload, out_index) = 0
            c.fprintf(
                c.stderr,
                "trans registry error: receiver.positional-name.index for \"%.*s\" must be a non-negative integer\n",
                (cast: int receiver_key\length),
                receiver_key\data
            )
            c.exit(2)
        return: 1

    argument_payload: lm_trans_positional_name_argument_payload(receiver_key)
    if: argument_payload != 0
        out_index[0]: 0U
        return: 1
return: 0

fn: lm_trans_formal_param_unwrap_index_payload (const: (LmP0Text: receiver_key)) const: @: char
return: lm_trans_namespace_registry_source_path_n2_named_typed_value(0, receiver_key, "receiver.formal-param.unwrap", "class", "class", "index", "size_t")

fn: lm_trans_frame_formal_param_unwrap_index (const: (LmP0Frame: frame); @: size_t out_index) int
    const: @: char index_payload
    LmP0Text: receiver_key

    if: frame = 0 || out_index = 0
        return: 0

    receiver_key: lm_trans_statement_text_new()
    if: receiver_key = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ receiver_key)

    if: lm_trans_frame_receiver_key(frame, receiver_key) = 0
        return: 0

    index_payload: lm_trans_formal_param_unwrap_index_payload(receiver_key)
    if: index_payload = 0
        return: 0
    if: lm_trans_parse_size_payload(index_payload, out_index) = 0
        c.fprintf(
            c.stderr,
            "trans registry error: receiver.formal-param.unwrap for \"%.*s\" must be a non-negative integer\n",
            (cast: int receiver_key\length),
            receiver_key\data
        )
        c.exit(2)
return: 1

fn: lm_trans_frame_arg_frame (
    const: LmP0Frame: frame
    const: @(char name)
    const: @(LmP0Frame out_arg)
) int
    const: LmP0Field: field
    const: LmP0Frame: child_frame

    if: frame = 0 || name = 0 || out_arg = 0
        return: 0

    field: frame\body\first_field
    while: field != 0
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            child_frame: field\value\as\frame
            if: lm_trans_text_equals(child_frame\head, name)
                out_arg[0]: child_frame
                return: 1
            ---
        ---
        field: field\next
return: 0

fn: lm_trans_frame_arg_single_node (
    const: LmP0Frame: frame
    const: @(char name)
    const: @(LmP0Node out_node)
) int
    const: LmP0Frame: arg_frame
    const: LmP0Field: field

    if: out_node = 0
        return: 0
    if: lm_trans_frame_arg_frame(frame, name, @ arg_frame) = 0
        return: 0

    field: arg_frame\body\first_field
    if: field = 0 || field\next != 0 || field\value = 0
        return: 0
    out_node[0]: field\value
return: 1

fn: lm_trans_frame_arg_atom_payload (
    const: LmP0Frame: frame
    const: @(char name)
    LmP0Text: out_payload
) int
    const: LmP0Node: node

    if: out_payload = 0
        return: 0
    if: lm_trans_frame_arg_single_node(frame, name, @ node) = 0
        return: 0
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: lm_trans_registry_literal_value(node\as\atom, out_payload)

fn: lm_trans_name_argument_from_frame (const: (LmP0Frame: frame); LmP0Text: out_name) int
    const: LmP0Field: field
    size_t: name_index

    if: frame = 0 || out_name = 0
        return: 0

    if: lm_trans_frame_arg_atom_payload(frame, "name", out_name) && lm_trans_name_argument_is_valid(out_name)
        return: 1

    if: lm_trans_frame_positional_name_index(frame, @ name_index) = 0
        return: 0

    field: lm_trans_nth_field(frame\body, name_index)
    if: field = 0 || field\value = 0
        return: 0

    if: field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_name_argument_is_valid(field\value\as\atom)
        out_name[0]: field\value\as\atom[0]
        return: 1

return: 0

fn: lm_trans_frame_close_target (const: (LmP0Frame: frame); LmP0Text: out_target) int
    const: LmP0Structure: body
    const: LmP0Field: name_field
    const: LmP0Field: value_body_field

    if: frame = 0 || out_target = 0
        return: 0

    if: lm_trans_name_argument_from_frame(frame, out_target)
        return: 1

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    name_field: lm_trans_nth_field(body, 0U)
    value_body_field: lm_trans_nth_field(body, 1U)
    if: lm_trans_is_c_reference_name(frame\head) = 0 && lm_trans_is_reserved_head_name(frame\head) = 0 && lm_trans_text_all_char(frame\head, '@') = 0 && lm_trans_text_is_array_receiver_head(frame\head) = 0 && (frame\flags & c.LM_P0_FRAME_COLON) != 0U && name_field != 0 && name_field\value != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom) && value_body_field != 0 && value_body_field\next = 0 && value_body_field\value != 0 && value_body_field\value\kind = c.LM_P0_NODE_STRUCTURE && value_body_field\value\span\line > name_field\value\span\line
        out_target[0]: name_field\value\as\atom[0]
        return: 1

    out_target[0]: frame\head[0]
return: 1

fn: lm_trans_validate_end_trailer (const: (LmP0Frame: frame)) int
    LmP0Text: actual
    LmP0Text: expected_name
    LmP0Text: expected_head

    if: frame = 0 || frame\trailer = 0
        return: 0

    if: lm_trans_text_equals(frame\trailer\spelling, "end") = 0
        return: 0

    actual: lm_trans_statement_text_new()
    expected_name: lm_trans_statement_text_new()
    expected_head: lm_trans_statement_text_new()
    if: actual = 0 || expected_name = 0 || expected_head = 0
        lm_trans_text_ref_destroy(@ actual)
        lm_trans_text_ref_destroy(@ expected_name)
        lm_trans_text_ref_destroy(@ expected_head)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ actual)
        lm_trans_text_ref_destroy(@ expected_name)
        lm_trans_text_ref_destroy(@ expected_head)

    if: lm_trans_trailer_single_atom(frame\trailer, actual) = 0
        c.fprintf(c.stderr, "trans error: end trailer expects exactly one target name\n")
        return: 1

    if: lm_trans_frame_close_target(frame, expected_name) = 0
        c.fprintf(
            c.stderr,
            "trans error: head \"%.*s\" does not expose a named close target\n",
            (cast: int frame\head\length),
            frame\head\data
        )
        return: 1

    if: lm_trans_frame_receiver_key(frame, expected_head) = 0
        c.fprintf(
            c.stderr,
            "trans error: head \"%.*s\" does not expose a receiver close target\n",
            (cast: int frame\head\length),
            frame\head\data
        )
        return: 1

    if: lm_trans_identifier_same(actual, expected_name) = 0 && lm_trans_identifier_same(actual, expected_head) = 0
        c.fprintf(
            c.stderr,
            "trans error: end target \"%.*s\" does not match close target \"%.*s\" or receiver head \"%.*s\"\n",
            (cast: int actual\length),
            actual\data,
            (cast: int expected_name\length),
            expected_name\data,
            (cast: int expected_head\length),
            expected_head\data
        )
        return: 1

return: 0

fn: lm_trans_emit_cleanup (
    FILE: file
    unsigned: indent
    const: LmTransNamespace: namespace_
    const: LmTransCleanup: cleanup
) int
    if: cleanup = 0
        return: 1

    if: cleanup\body != 0
        return: lm_trans_emit_statement_list(file, cleanup\body, indent, (cast: (LmTransNamespace) namespace_))

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_put(file, "lm_synchronized_leave(") != 0
        return: 1
    if: lm_trans_emit_sync_name(file, cleanup\id) != 0
        return: 1
    if: lm_trans_put(file, ");\n") != 0
        return: 1

return: 0

fn: lm_trans_emit_cleanups_until (
    FILE: file
    unsigned: indent
    const: LmTransNamespace: namespace_
    size_t: cleanup_base
) int
    size_t: index
    const: LmTransCleanup: cleanup

    if: namespace_ = 0 || cleanup_base > namespace_\cleanups\count
        return: 0

    index: namespace_\cleanups\count
    while: index > cleanup_base
        index: index - 1U
        cleanup: (cast: (const: LmTransCleanup) lm_own_ptr_stack_at(namespace_\cleanups, index))
        if: lm_trans_emit_cleanup(file, indent, namespace_, cleanup) != 0
            return: 1

return: 0

fn: lm_trans_emit_scope_cleanups (
    FILE: file
    unsigned: indent
    LmTransNamespace: namespace_
) int
    LmTransCleanup: cleanup

    if: namespace_ = 0 || namespace_\cleanups = 0
        return: 0

    while: namespace_\cleanups\count > 0U
        cleanup: (cast: (LmTransCleanup) lm_own_ptr_stack_top(namespace_\cleanups))
        if: cleanup = 0 || cleanup\scope_depth != namespace_\depth
            return: 0
        cleanup: (cast: (LmTransCleanup) lm_own_ptr_stack_pop(namespace_\cleanups))
        if: lm_trans_emit_cleanup(file, indent, namespace_, cleanup) != 0
            lm_trans_cleanup_destroy(cleanup)
            return: 1
        lm_trans_cleanup_destroy(cleanup)

return: 0

