    LmTransNamespace: namespace_
) int
return: lm_trans_emit_array_declaration_with_qualifier(file, frame, indent, namespace_, "")

fn: lm_trans_emit_pointer_declaration_repeat_with_qualifier (
    FILE: file
    const: LmP0Frame: template_frame
    const: LmP0Structure: body
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    const: LmP0Structure: template_body
    const: LmP0Structure: repeat_body
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Node: type_node
    const: LmP0Node: name_node
    const: LmP0Text: expected_class
    int: status

    template_body: 0
    if: template_frame != 0
        template_body: lm_trans_unwrap_single_anonymous_structure(template_frame\body)
    repeat_body: lm_trans_unwrap_single_anonymous_structure(body)
    type_field: 0
    if: template_body != 0
        type_field: template_body\first_field
    name_field: 0
    if: repeat_body != 0
        name_field: repeat_body\first_field
    if: template_frame = 0 || type_field = 0 || type_field\value = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: repeated @ declaration expects type template and name\n")
        return: 1

    type_node: type_field\value
    if: name_field\next != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_head_can_declare_storage(name_field\value\as\atom, namespace_)
        type_node: name_field\value
        name_field: name_field\next
        if: name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: repeated @ declaration override expects a variable name\n")
            return: 1
    ---

    name_node: name_field\value
    expected_class: 0
    if: type_node != 0 && type_node\kind = c.LM_P0_NODE_ATOM
        expected_class: type_node\as\atom
    if: name_field\next != 0 && lm_trans_guard_c_array_value_range(name_field\next, 0, namespace_, expected_class, template_frame\head\length, lm_trans_qualifier_is_const(qualifier), "raw pointer initializer") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_guard_known_raw_pointer_range(name_field\next, 0, namespace_, expected_class, template_frame\head\length, lm_trans_qualifier_is_const(qualifier), "raw pointer initializer") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1
    if: lm_trans_emit_type_and_name(file, type_node, name_node\as\atom, template_frame\head\length, namespace_) != 0
        return: 1
    if: name_field\next != 0 && lm_trans_range_has_direct_array_reference(name_field\next, 0, namespace_) && (template_frame\head\length != 1U || type_node = 0 || type_node\kind != c.LM_P0_NODE_ATOM || lm_trans_text_equals(type_node\as\atom, "LmSlice") = 0 || lm_trans_range_is_direct_array_reference_address(name_field\next, 0, namespace_) = 0) && lm_trans_range_is_array_reference_data_pointer(name_field\next, 0, namespace_) = 0
        c.fprintf(c.stderr, "trans L2 type error: raw pointer initializer cannot consume an ArrayReference without an explicit adapter\n")
        return: 1
    if: name_field\next != 0 && lm_trans_put(file, " = ") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_emit_expr_fields(file, name_field\next, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    status: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_node)
    if: status = 0
        status: lm_trans_namespace_mark_raw_pointer(namespace_, name_node\as\atom, template_frame\head\length, lm_trans_qualifier_is_const(qualifier))
return: status

fn: lm_trans_emit_array_declaration_repeat_with_qualifier (
    FILE: file
    const: LmP0Frame: template_frame
    const: LmP0Structure: body
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    const: LmP0Structure: repeat_body
    const: LmP0Field: name_field
    const: LmP0Field: initializer_field
    const: LmP0Node: name_node
    LmTransCDeclarator: declarator

    repeat_body: lm_trans_unwrap_single_anonymous_structure(body)

    declarator: lm_trans_statement_c_declarator_new()
    if: declarator = 0
        return: 1
    finally: lm_trans_statement_c_declarator_destroy(declarator)

    if: lm_trans_array_declarator_read_from_frame(declarator, template_frame, namespace_, 1, 1, 0, "trans L2 error: repeated [] declaration expects a type template", "trans L2 error: repeated array pointer declaration expects a type template", "trans L2 error: repeated array declaration expects a type/name declaration template") != 0
        return: 1

    name_field: 0
    if: repeat_body != 0
        name_field: repeat_body\first_field
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: repeated [] declaration expects a variable name\n")
        return: 1

    if: name_field\next != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_head_can_declare_storage(name_field\value\as\atom, namespace_)
        declarator\type_head[0]: name_field\value\as\atom[0]
        declarator\type_node: 0
        declarator\type_is_head: 1
        declarator\pointer_depth: 0U
        name_field: name_field\next
        if: name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: repeated [] declaration override expects a variable name\n")
            return: 1
    ---

    name_node: name_field\value
    declarator\name[0]: name_node\as\atom[0]
    declarator\expression_dimensions: name_field\next
    initializer_field: lm_trans_c_declarator_expression_dimension_tail(declarator)
return: lm_trans_emit_managed_array_declaration(file, declarator, initializer_field, indent, namespace_, qualifier)

fn: lm_trans_emit_c_tagged_declaration (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Node: type_node
    const: LmP0Node: name_node

    type_field: lm_trans_nth_field(frame\body, 0U)
    name_field: lm_trans_nth_field(frame\body, 1U)
    if: type_field = 0 || name_field = 0 || type_field\value = 0 || name_field\value = 0 || type_field\value\kind != c.LM_P0_NODE_ATOM || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: C tagged declaration expects C tag name and variable name\n")
        return: 1

    type_node: type_field\value
    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_type_head_only(file, frame\head, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_emit_name(file, type_node\as\atom) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_emit_identifier(file, name_node\as\atom) != 0
        return: 1
    if: name_field\next != 0 && lm_trans_put(file, " = ") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_emit_expr_fields(file, name_field\next, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
return: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_node)

fn: lm_trans_emit_const_statement (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    const: LmP0Frame: inner

    field: frame\body\first_field
    if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
        c.fprintf(c.stderr, "trans L2 error: const receiver expects exactly one declaration frame\n")
        return: 1

    inner: field\value\as\frame
    if: lm_trans_text_is_array_receiver_head(inner\head)
        return: lm_trans_emit_array_declaration_with_qualifier(file, inner, indent, namespace_, "const ")
    if: lm_trans_namespace_has_named_structure_binding(namespace_, inner\head) && lm_trans_frame_looks_storage_declaration(inner, namespace_)
        c.fprintf(c.stderr, "trans hosted named Structure limitation: const construction/forwarding requires referent-const binding metadata\n")
        return: 1
    if: lm_trans_frame_looks_storage_declaration(inner, namespace_)
        return: lm_trans_emit_declaration_with_qualifier(file, inner, indent, namespace_, "const ")
    if: lm_trans_text_all_char(inner\head, '@')
        return: lm_trans_emit_pointer_declaration_with_qualifier(file, inner, indent, namespace_, "const ")

    c.fprintf(c.stderr, "trans L2 error: const receiver expects storage, pointer, or array declaration\n")
return: 1

fn: lm_trans_emit_call_statement (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    LmTransCallLowering: call
    int: has_args
    const: LmP0Node: throws_node

    call: lm_trans_statement_call_lowering_new()
    if: call = 0
        return: 1
    finally: lm_trans_expr_call_lowering_delete(call)

    if: lm_trans_lower_call(frame\head, namespace_, "callable", call) != 0
        return: 1
    if: lm_trans_validate_profile_c_printf_call(frame, namespace_) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1

    if: call\is_closure
        has_args: call\signature != 0 && call\signature\param_names != 0 && call\signature\param_names\count > 0U
        if: has_args = 0 && lm_trans_call_body_first_field(frame\body) != 0
            c.fprintf(c.stderr, "trans L2 error: too many arguments\n")
            return: 1
        if: lm_trans_emit_name(file, call\name) != 0
            return: 1
        if: lm_trans_put(file, "->call(") != 0
            return: 1
        if: lm_trans_emit_name(file, call\name) != 0
            return: 1
        if: lm_trans_put(file, "->env, lm_lmx_message_thread") != 0
            return: 1
        if: has_args && lm_trans_put(file, ", ") != 0
            return: 1
        if: has_args && lm_trans_emit_call_args(file, frame\body, namespace_, call\signature) != 0
            return: 1
        if: lm_trans_put(file, ")") != 0
            return: 1
        if: lm_trans_put(file, ";\n") != 0
            return: 1
        throws_node: lm_trans_symbol_throws_node(call\signature)
        if: throws_node != 0
            return: lm_trans_emit_throwing_dispatch(file, indent, namespace_, throws_node)
        return: 0

    if: lm_trans_emit_name(file, call\name) != 0
        return: 1
    if: lm_trans_put(file, "(") != 0
        return: 1
    if: lm_trans_emit_call_args(file, frame\body, namespace_, call\signature) != 0
        return: 1
    if: lm_trans_put(file, ")") != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    throws_node: lm_trans_symbol_throws_node(call\signature)
    if: throws_node != 0
        return: lm_trans_emit_throwing_dispatch(file, indent, namespace_, throws_node)
return: 0

fn: lm_trans_text_contains_char (const: (LmP0Text: text); char: ch) int
    size_t: i

    i: 0U
    while: text != 0 && i < text\length
        if: text\data[i] = ch
            return: 1
        i: i + 1U
return: 0

fn: lm_trans_head_looks_assignable_target (const: (LmP0Text: head)) int
return: lm_trans_text_contains_char(head, '[') || lm_trans_text_contains_char(head, '\\') || lm_trans_c_reference_has_path_dot(head)

fn: lm_trans_named_structure_body (const: (LmP0Frame: frame)) const: LmP0Structure
    if: frame = 0
        return: 0
return: lm_trans_unwrap_single_anonymous_structure(frame\body)

fn: lm_trans_frame_looks_named_structure_declaration (const: (LmP0Frame: frame)) int
return: frame != 0 && lm_trans_is_c_reference_name(frame\head) = 0 && lm_trans_is_reserved_head_name(frame\head) = 0 && lm_trans_text_all_char(frame\head, '@') = 0 && lm_trans_text_is_array_receiver_head(frame\head) = 0 && (frame\flags & c.LM_P0_FRAME_COLON) != 0U && (frame\flags & c.LM_P0_FRAME_INLINE_BODY) = 0U

fn: lm_trans_frame_is_structure_callable_field (const: (LmP0Frame: frame)) int
    if: frame = 0 || frame\head = 0
        return: 0
    if: lm_trans_text_equals(frame\head, "fn")
        return: 1
    if: lm_trans_text_equals(frame\head, "sub")
        return: 1
return: lm_trans_text_equals(frame\head, "callable")

fn: lm_trans_descriptor_field_is_callable (
    const: LmTransDescriptorField: field
) int
return: field != 0 && field\descriptor_name != 0 && c.strcmp(field\descriptor_name, "lm.trans.callable") = 0

fn: lm_trans_structure_callable_field_name (
    const: LmP0Frame: field_frame
) const: LmP0Text
    const: LmP0Field: name_field

    if: lm_trans_frame_is_structure_callable_field(field_frame) = 0
        return: 0
    name_field: lm_trans_nth_field(field_frame\body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: name_field\value\as\atom

fn: lm_trans_named_structure_type_set_cstr (
    LmTransL4CallableType: type
    const: @(char class_name)
    size_t: address_depth
    int: is_const
) int
    if: type = 0 || class_name = 0
        return: 0
    if: lm_trans_callable_type_reset(type) != 0
        return: 0
    if: lm_trans_text_assign_cstr(type\class_name, class_name) = 0
        return: 0
    type\address_depth: address_depth
    type\is_const: is_const
return: 1

fn: lm_trans_named_structure_project_graph_field_type (
    LmTransL4CallableType: field_type
) int
    int: is_const

    if: field_type = 0
        return: 0
    if: field_type\array_rank = 0U
        return: 1
    is_const: field_type\is_const
return: lm_trans_named_structure_type_set_cstr(field_type, "LmSlice", 0U, is_const)

fn: lm_trans_named_structure_type_set_text (
    LmTransL4CallableType: type
    const: LmP0Text: class_name
    size_t: address_depth
    int: is_const
) int
    if: type = 0 || class_name = 0
        return: 0
    if: lm_trans_callable_type_reset(type) != 0
        return: 0
    type\class_name[0]: class_name[0]
    type\address_depth: address_depth
    type\is_const: is_const
return: 1

fn: lm_trans_named_structure_atom_is_decimal_literal (const: (LmP0Text: atom)) int
    size_t: i
    char: ch

    if: atom = 0 || atom\length = 0U
        return: 0

    i: 0U
    while: i < atom\length
        ch: atom\data[i]
        if: ch < '0' || ch > '9'
            return: 0
        i: i + 1U
return: 1

fn: lm_trans_named_structure_atom_is_c_string_literal (const: (LmP0Text: atom)) int
    if: atom = 0 || atom\data = 0
        return: 0
    if: atom\length >= 2U && atom\data[0] = '"' && atom\data[atom\length - 1U] = '"'
        return: 1
return: lm_trans_text_starts_with(atom, "c.") && atom\length >= 4U && atom\data[2] = '"' && atom\data[atom\length - 1U] = '"'

fn: lm_trans_named_structure_field_type_from_atom (
    const: LmP0Text: atom
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
) int
    const: LmTransSymbol: relation

    if: atom = 0 || out_type = 0
        return: 0

    relation: lm_trans_namespace_relation_symbol_latest(namespace_, atom, "variable.type")
    if: relation != 0 && relation\has_c_name && relation\c_name != 0
        if: lm_trans_callable_type_reset(out_type) != 0
            return: 0
        out_type\class_name[0]: relation\c_name[0]
        out_type\address_depth: 0U
        out_type\is_const: 0
        return: 1

    if: lm_trans_named_structure_atom_is_decimal_literal(atom)
        return: lm_trans_named_structure_type_set_cstr(out_type, "int", 0U, 0)

    if: lm_trans_named_structure_atom_is_c_string_literal(atom)
        return: lm_trans_named_structure_type_set_cstr(out_type, "char", 1U, 1)

return: 0

fn: lm_trans_named_structure_single_initializer_node (
    const: LmP0Field: initializer
    const: @(LmP0Node out_node)
) int
    const: LmP0Node: current
    const: LmP0Field: field

    if: out_node != 0
        out_node[0]: 0
    if: initializer = 0 || initializer\next != 0 || initializer\value = 0 || out_node = 0
        return: 0

    current: initializer\value
    while: current != 0 && current\kind = c.LM_P0_NODE_STRUCTURE
        field: current\as\structure\first_field
        if: field = 0 || field\next != 0 || field\value = 0
            return: 0
        current: field\value

    out_node[0]: current
return: current != 0

fn: lm_trans_named_structure_field_type_from_initializer (
    const: LmP0Field: initializer
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
) int
    const: LmP0Node: node
    int: status

    if: initializer = 0 || out_type = 0
        return: 0
    if: lm_trans_named_structure_single_initializer_node(initializer, @ node) = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_named_structure_field_type_from_atom(node\as\atom, namespace_, out_type)
    status: lm_trans_node_result_type(node, namespace_, out_type)
    if: status > 0
        return: 1
return: 0

fn: lm_trans_named_structure_inferred_field_info (
    const: LmP0Frame: field_frame
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
    const: @(LmP0Text out_name)
    const: @(LmP0Field out_initializer)
) int
    const: LmP0Structure: body
    const: LmP0Field: initializer

    if: field_frame = 0 || out_type = 0 || out_name = 0 || out_initializer = 0
        return: 0
    if: (field_frame\flags & c.LM_P0_FRAME_COLON) = 0U
        return: 0
    if: lm_trans_atom_can_be_new_binding_name(field_frame\head) = 0 || lm_trans_is_reserved_head_name(field_frame\head)
        return: 0

    body: lm_trans_named_structure_body(field_frame)
    if: body = 0
        return: 0
    initializer: body\first_field
    if: initializer = 0
        return: 0
    if: lm_trans_named_structure_field_type_from_initializer(initializer, namespace_, out_type) = 0
        return: 0

    out_name[0]: field_frame\head
    out_initializer[0]: initializer
return: 1

fn: lm_trans_named_structure_type_is_available (
    const: LmP0Text: type_name
    const: LmTransNamespace: namespace_
    const: LmP0Text: pending_owner
) int
    if: type_name = 0
        return: 0
    if: pending_owner != 0 && lm_trans_text_same(type_name, pending_owner)
        return: 1
return: lm_trans_head_can_declare_storage(type_name, namespace_)

fn: lm_trans_named_structure_array_field_info (
    const: LmP0Frame: field_frame
    const: LmTransNamespace: namespace_
    const: LmP0Text: pending_owner
    LmTransL4CallableType: out_type
    const: @(LmP0Text out_name)
    const: @(LmP0Field out_initializer)
) int
    const: LmP0Structure: body
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Frame: inner
    const: LmP0Structure: inner_body
    LmP0Text: dimension
    size_t: dimension_index
    size_t: rank

    if: field_frame = 0 || out_type = 0 || out_name = 0 || out_initializer = 0
        return: 0
    if: lm_trans_text_is_array_receiver_head(field_frame\head) = 0
        return: 0

    body: lm_trans_named_structure_body(field_frame)
    type_field: 0
    if: body != 0
        type_field: body\first_field
    while: type_field != 0 && lm_trans_node_is_ignored(type_field\value)
        type_field: type_field\next
    if: type_field = 0 || type_field\value = 0
        return: 0

    if: lm_trans_callable_type_reset(out_type) != 0
        return: 0

    dimension: lm_trans_text_ref_new_cstr("")
    if: dimension = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ dimension)
    dimension_index: 0U
    rank: 0U
    while: lm_trans_array_head_next_dimension(field_frame\head, @ dimension_index, dimension)
        rank: rank + 1U
    if: rank = 0U
        return: 0

    name_field: 0
    if: type_field\value\kind = c.LM_P0_NODE_ATOM
        if: lm_trans_named_structure_type_set_text(out_type, type_field\value\as\atom, 0U, 0) = 0
            return: 0
        name_field: type_field\next
        while: name_field != 0 && lm_trans_node_is_ignored(name_field\value)
            name_field: name_field\next
        ---
    else:
        if: type_field\value\kind != c.LM_P0_NODE_FRAME
            return: 0
        inner: type_field\value\as\frame
        if: lm_trans_named_structure_type_set_text(out_type, inner\head, 0U, 0) = 0
            return: 0
        inner_body: lm_trans_named_structure_body(inner)
        name_field: 0
        if: inner_body != 0
            name_field: inner_body\first_field
        while: name_field != 0 && lm_trans_node_is_ignored(name_field\value)
            name_field: name_field\next
        if: name_field = 0
            name_field: type_field\next
            while: name_field != 0 && lm_trans_node_is_ignored(name_field\value)
                name_field: name_field\next
            ---
        ---
    ---
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom) = 0
        return: 0
    if: lm_trans_named_structure_type_is_available(out_type\class_name, namespace_, pending_owner) = 0
        return: 0

    out_type\array_rank: rank
    out_type\address_depth: out_type\address_depth + 1U
    out_name[0]: name_field\value\as\atom
    out_initializer[0]: name_field\next
return: 1

fn: lm_trans_named_structure_field_info_for_owner (
    const: LmP0Frame: field_frame
    const: LmTransNamespace: namespace_
    const: LmP0Text: pending_owner
    LmTransL4CallableType: out_type
    const: @(LmP0Text out_name)
    const: @(LmP0Field out_initializer)
) int
    const: LmP0Frame: current_frame
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Frame: inner
    size_t: pointer_depth

    if: field_frame = 0 || out_type = 0 || out_name = 0 || out_initializer = 0
        return: 0
    if: lm_trans_named_structure_array_field_info(field_frame, namespace_, pending_owner, out_type, out_name, out_initializer)
        return: 1

    current_frame: field_frame
    pointer_depth: 0U

    while: lm_trans_text_all_char(current_frame\head, '@')
        body: lm_trans_named_structure_body(current_frame)
        if: body = 0
            return: 0

        field: body\first_field
        if: field != 0 && field\next = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            inner: field\value\as\frame
            pointer_depth: pointer_depth + current_frame\head\length
            current_frame: inner
            continue

        type_field: lm_trans_nth_field(body, 0U)
        name_field: lm_trans_nth_field(body, 1U)
        if: type_field = 0 || name_field = 0 || type_field\value = 0 || name_field\value = 0 || type_field\value\kind != c.LM_P0_NODE_ATOM || name_field\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        if: lm_trans_named_structure_type_set_text(out_type, type_field\value\as\atom, pointer_depth + current_frame\head\length, 0) = 0
            return: 0
        out_name[0]: name_field\value\as\atom
        out_initializer[0]: name_field\next
        return: lm_trans_named_structure_type_is_available(out_type\class_name, namespace_, pending_owner)
    ---

    body: lm_trans_named_structure_body(current_frame)
    if: body = 0
        return: 0
    if: lm_trans_named_structure_type_is_available(current_frame\head, namespace_, pending_owner) = 0
        return: lm_trans_named_structure_inferred_field_info(field_frame, namespace_, out_type, out_name, out_initializer)

    name_field: lm_trans_nth_field(body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: lm_trans_named_structure_type_set_text(out_type, current_frame\head, pointer_depth, 0) = 0
        return: 0
    out_name[0]: name_field\value\as\atom
    out_initializer[0]: name_field\next
    return: lm_trans_atom_can_be_new_binding_name(out_name[0])

return: lm_trans_named_structure_inferred_field_info(field_frame, namespace_, out_type, out_name, out_initializer)

fn: lm_trans_named_structure_field_info (
    const: LmP0Frame: field_frame
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
    const: @(LmP0Text out_name)
    const: @(LmP0Field out_initializer)
) int
return: lm_trans_named_structure_field_info_for_owner(field_frame, namespace_, 0, out_type, out_name, out_initializer)

fn: lm_trans_frame_looks_named_structure_layout_declaration (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    LmTransL4CallableType: field_type
    const: LmP0Text: name
    const: LmP0Field: initializer

    if: lm_trans_frame_looks_named_structure_declaration(frame) = 0
        return: 0

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 0
    finally: lm_trans_expr_callable_type_delete(field_type)

    body: lm_trans_named_structure_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && field\value\kind != c.LM_P0_NODE_FRAME
            return: 0
        if: lm_trans_node_is_ignored(field\value) = 0 && lm_trans_frame_is_structure_callable_field(field\value\as\frame) = 0 && lm_trans_named_structure_field_info_for_owner(field\value\as\frame, namespace_, frame\head, field_type, @ name, @ initializer) = 0
            return: 0
        field: field\next
return: 1

fn: lm_trans_frame_looks_named_structure_construction (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    const: LmP0Field: name_field
    const: LmP0Field: value_body_field

    if: frame = 0 || namespace_ = 0 || (frame\flags & c.LM_P0_FRAME_COLON) = 0U || lm_trans_namespace_has_named_structure_binding(namespace_, frame\head) = 0
        return: 0

    body: lm_trans_named_structure_body(frame)
    name_field: lm_trans_nth_field(body, 0U)
    value_body_field: lm_trans_nth_field(body, 1U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM || lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom) = 0
        return: 0
    if: value_body_field = 0 || value_body_field\next != 0 || value_body_field\value = 0 || value_body_field\value\kind != c.LM_P0_NODE_STRUCTURE || value_body_field\value\span\line <= name_field\value\span\line
        return: 0
return: 1

fn: lm_trans_named_structure_construction_field_occurrence (
    const: LmP0Structure: body
    const: LmP0Field: selected
    const: LmP0Text: name
) size_t
    const: LmP0Field: field
    const: LmP0Frame: field_frame
    size_t: occurrence

    occurrence: 0U
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0 && field != selected
        if: lm_trans_node_is_ignored(field\value) = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            field_frame: field\value\as\frame
            if: lm_trans_identifier_same(field_frame\head, name)
                occurrence: occurrence + 1U
            ---
        ---
        field: field\next
return: occurrence

fn: lm_trans_emit_named_structure_construction_initializer (
    FILE: file
    const: LmP0Frame: frame
    const: LmP0Text: instance_name
    const: LmTransDescriptor: descriptor
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Structure: outer_body
    const: LmP0Field: value_body_field
    const: LmP0Structure: value_body
    const: LmP0Field: field
    const: LmP0Frame: field_frame
    const: LmP0Structure: initializer
    const: LmP0Field: initializer_first
    const: LmTransDescriptorField: descriptor_field
    LmTransL4CallableType: expected_type
    @: char logical_name
    @: char projected_name
    LmP0Text: projected_name_text
    size_t: occurrence
    size_t: matching_count

    if: file = 0 || frame = 0 || instance_name = 0 || descriptor = 0 || namespace_ = 0
        return: 1

    if: descriptor\has_structural_fields = 0
        c.fprintf(c.stderr, "trans L2 structure construction error: \"%.*s\" has no structural descriptor\n", (cast: int frame\head\length), frame\head\data)
        return: 1

    outer_body: lm_trans_named_structure_body(frame)
    value_body_field: lm_trans_nth_field(outer_body, 1U)
    if: value_body_field = 0 || value_body_field\value = 0 || value_body_field\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 1
    value_body: value_body_field\value\as\structure

    expected_type: lm_trans_expr_callable_type_new()
    if: expected_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(expected_type)

    field: value_body\first_field
    while: field != 0
        logical_name: 0
        projected_name: 0
        projected_name_text: 0

        if: lm_trans_node_is_ignored(field\value) = 0 && (field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME)
            c.fprintf(c.stderr, "trans L2 structure construction error: initializer body for \"%.*s\" expects field frames\n", (cast: int frame\head\length), frame\head\data)
            return: 1

        if: lm_trans_node_is_ignored(field\value) = 0 && field\value\kind = c.LM_P0_NODE_FRAME && lm_trans_frame_is_structure_callable_field(field\value\as\frame)
            field: field\next
            continue
        if: lm_trans_node_is_ignored(field\value) = 0
            field_frame: field\value\as\frame
            initializer: lm_trans_named_structure_body(field_frame)
            initializer_first: lm_trans_l2_structure_first_present_field(initializer)
            if: (field_frame\flags & c.LM_P0_FRAME_COLON) = 0U || lm_trans_atom_can_be_new_binding_name(field_frame\head) = 0 || initializer_first = 0
                c.fprintf(c.stderr, "trans L2 structure construction error: field \"%.*s\" expects an initializer expression\n", (cast: int field_frame\head\length), field_frame\head\data)
                return: 1

            logical_name: lm_trans_descriptor_name_copy(field_frame\head)
            if: logical_name = 0
                return: 1
            occurrence: lm_trans_named_structure_construction_field_occurrence(value_body, field, field_frame\head)
            descriptor_field: lm_trans_descriptor_structural_field_occurrence(descriptor, logical_name, occurrence)
            if: descriptor_field = 0
                matching_count: lm_trans_descriptor_structural_field_occurrence_count(descriptor, logical_name)
                c.fprintf(c.stderr, "trans L2 structure construction error: class \"%.*s\" has no field occurrence [%zu]%.*s (matching occurrence count: %zu)\n", (cast: int frame\head\length), frame\head\data, occurrence, (cast: int field_frame\head\length), field_frame\head\data, matching_count)
                lm_own_delete(logical_name, 0)
                return: 1
            ---

            projected_name: lm_trans_descriptor_projected_member_name_new(descriptor, descriptor_field)
            if: projected_name = 0
                lm_own_delete(logical_name, 0)
                return: 1
            projected_name_text: lm_trans_text_from_cstr(projected_name)
            if: projected_name_text = 0
                lm_own_delete(projected_name, 0)
                lm_own_delete(logical_name, 0)
                return: 1

            if: lm_trans_named_structure_type_set_cstr(expected_type, descriptor_field\descriptor_name, descriptor_field\address_depth, descriptor_field\is_const) = 0
                lm_trans_text_ref_destroy(@ projected_name_text)
                lm_own_delete(projected_name, 0)
                lm_own_delete(logical_name, 0)
                return: 1

            if: descriptor_field\has_array_count
                c.fprintf(c.stderr, "trans hosted C backend limitation: construction of fixed-array field [%zu]%.*s on \"%.*s\" requires ArrayReference projection\n", occurrence, (cast: int field_frame\head\length), field_frame\head\data, (cast: int frame\head\length), frame\head\data)
                lm_trans_text_ref_destroy(@ projected_name_text)
                lm_own_delete(projected_name, 0)
                lm_own_delete(logical_name, 0)
                return: 1

            if: descriptor_field\is_const
                if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "memcpy((void *)&") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, "->") != 0 || lm_trans_emit_identifier(file, projected_name_text) != 0 || lm_trans_put(file, ", &(") != 0 || lm_trans_emit_callable_type_named(file, expected_type, 0, namespace_) != 0 || lm_trans_put(file, "){") != 0 || lm_trans_emit_expr_range_with_expected_type(file, initializer_first, 0, namespace_, expected_type) != 0 || lm_trans_put(file, "}, sizeof(") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, "->") != 0 || lm_trans_emit_identifier(file, projected_name_text) != 0 || lm_trans_put(file, "));\n") != 0
                    lm_trans_text_ref_destroy(@ projected_name_text)
                    lm_own_delete(projected_name, 0)
                    lm_own_delete(logical_name, 0)
                    return: 1
                ---
            else:
                if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, "->") != 0 || lm_trans_emit_identifier(file, projected_name_text) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_expr_range_with_expected_type(file, initializer_first, 0, namespace_, expected_type) != 0 || lm_trans_put(file, ";\n") != 0
                    lm_trans_text_ref_destroy(@ projected_name_text)
                    lm_own_delete(projected_name, 0)
                    lm_own_delete(logical_name, 0)
                    return: 1
                ---
            ---

            lm_trans_text_ref_destroy(@ projected_name_text)
            lm_own_delete(projected_name, 0)
            lm_own_delete(logical_name, 0)
        ---
        field: field\next

return: 0

fn: lm_trans_emit_named_structure_construction (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    const: LmP0Field: name_field
    const: LmP0Text: instance_name
    const: LmTransSymbol: existing_symbol
    const: LmTransDescriptor: descriptor
    int: status

    if: file = 0 || frame = 0 || namespace_ = 0 || lm_trans_frame_looks_named_structure_construction(frame, namespace_) = 0
        return: 1

    body: lm_trans_named_structure_body(frame)
    name_field: lm_trans_nth_field(body, 0U)
    instance_name: name_field\value\as\atom

    existing_symbol: lm_trans_namespace_find(namespace_, instance_name)
    if: existing_symbol != 0
        c.fprintf(c.stderr, "trans hosted C backend limitation: Structure construction result \"%.*s\" collides with an existing binding and requires occurrence-aware value projection\n", (cast: int instance_name\length), instance_name\data)
        return: 1

    descriptor: lm_trans_namespace_descriptor(namespace_, frame\head)
    if: descriptor = 0 || descriptor\has_structural_fields = 0
        return: 1

    if: lm_trans_named_structure_uses_graph_header(namespace_, frame\head)
        if: lm_trans_emit_structure_graph_header(lm_trans_prelude_file(file)) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_projected_type_name(file, frame\head, namespace_) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, " = ") != 0
            return: 1
        if: lm_trans_emit_graph_structure_new(file, frame\head, "lm_lmx_message_thread", "lm_message_thread_owner(lm_lmx_message_thread)", instance_name) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_descriptor_payload_is_empty(descriptor) = 0
            status: lm_trans_emit_named_structure_construction_initializer(file, frame, instance_name, descriptor, indent, namespace_)
            if: status != 0
                return: 1
            ---
        ---
        return: lm_trans_namespace_declare_storage_binding(namespace_, instance_name, frame\head)

    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, " = (") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, "));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, " == 0) {\n") != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "abort();\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1

    status: lm_trans_emit_named_structure_construction_initializer(file, frame, instance_name, descriptor, indent, namespace_)
    if: status != 0
        return: 1
return: lm_trans_namespace_declare_storage_binding(namespace_, instance_name, frame\head)

fn: lm_trans_named_structure_relation_table_new (
    const: LmP0Text: owner
    const: @(char suffix)
) @: char
    @: char owner_name
    @: char table_name
    size_t: owner_length
    size_t: suffix_length

    owner_name: lm_trans_prefixed_identifier_name_new("", owner, "")
    if: owner_name = 0 || suffix = 0
        lm_own_delete(owner_name, 0)
        return: 0
    finally: lm_own_delete(owner_name, 0)

    owner_length: c.strlen(owner_name)
    suffix_length: c.strlen(suffix)
    table_name: (cast: (@: char) lm_own_new_zero(owner_length + suffix_length + 1U))
    if: table_name = 0
        return: 0
    c.memcpy(table_name, owner_name, owner_length)
    c.memcpy(table_name + owner_length, suffix, suffix_length + 1U)
return: table_name

fn: lm_trans_named_structure_push_relation (
    const: LmP0Text: owner
    const: @(char suffix)
    const: LmP0Text: key
    const: LmP0Text: payload
) int
    @: char table_name
    LmP0Text: table_atom
    const: @: char value_column_name
    const: @: char value_descriptor

    if: suffix = 0
        return: 1
    value_column_name: 0
    value_descriptor: 0
    if: c.strcmp(suffix, ".field.class") = 0
        value_column_name: "field"
        value_descriptor: "class"
    if: c.strcmp(suffix, ".field.union") = 0
        value_column_name: "union"
        value_descriptor: "class"
    if: c.strcmp(suffix, ".field.index") = 0
        value_column_name: "index"
        value_descriptor: "size_t"
    if: c.strcmp(suffix, ".field.address-depth") = 0
        value_column_name: "depth"
        value_descriptor: "size_t"
    if: c.strcmp(suffix, ".field.const") = 0
        value_column_name: "value"
        value_descriptor: "int"
    if: c.strcmp(suffix, ".field.array-count") = 0
        value_column_name: "count"
        value_descriptor: "size_t"
    if: value_column_name = 0 || value_descriptor = 0
        return: 1

    table_name: lm_trans_named_structure_relation_table_new(owner, suffix)
    if: table_name = 0
        return: 1
    finally: lm_own_delete(table_name, 0)

    table_atom: lm_trans_text_from_cstr(table_name)
    if: table_atom = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ table_atom)

return: lm_trans_registry_push_generated_source_n2_row_atoms(table_atom, key, payload, "class", "class", value_column_name, value_descriptor) != 0

fn: lm_trans_bind_named_structure_descriptor (
    LmTransNamespace: namespace_
    const: LmP0Text: owner
    @: LmTransDescriptor descriptor
) int
    LmTransDescriptor: transferred_descriptor

    if: namespace_ = 0 || owner = 0 || descriptor = 0 || descriptor[0] = 0
        return: 1

    transferred_descriptor: descriptor[0]
    if: lm_trans_namespace_bind_descriptor(namespace_, owner, "structureConstructor", transferred_descriptor) != 0
        return: 1
    descriptor[0]: 0
return: 0

fn: lm_trans_named_structure_push_field_relations (
    const: LmP0Text: owner
    const: LmP0Text: name
    const: LmTransL4CallableType: type
    size_t: index
) int
    LmP0Text: index_payload
    LmP0Text: depth_payload
    LmP0Text: const_payload
    c.array: [32]: char index_buffer
    c.array: [32]: char depth_buffer
    int: status

    if: owner = 0 || name = 0 || type = 0 || type\class_name = 0
        return: 1

    c.snprintf(index_buffer, c.sizeof(index_buffer), "%zu", index)
    c.snprintf(depth_buffer, c.sizeof(depth_buffer), "%zu", type\address_depth)
    index_payload: lm_trans_text_from_cstr(index_buffer)
    if: index_payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ index_payload)

    depth_payload: lm_trans_text_from_cstr(depth_buffer)
    if: depth_payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ depth_payload)

    status: lm_trans_named_structure_push_relation(owner, ".field.class", name, type\class_name) != 0 || lm_trans_named_structure_push_relation(owner, ".field.index", name, index_payload) != 0 || lm_trans_named_structure_push_relation(owner, ".field.address-depth", name, depth_payload) != 0
    if: status = 0 && type\is_const
        const_payload: lm_trans_text_from_cstr("1")
        if: const_payload = 0
            return: 1
        status: lm_trans_named_structure_push_relation(owner, ".field.const", name, const_payload) != 0
        lm_trans_text_ref_destroy(@ const_payload)
return: status != 0

fn: lm_trans_hosted_descriptor_redeclaration_is_unsupported (
    const: LmTransNamespace: namespace_
    const: LmP0Text: owner
    const: LmTransDescriptor: pending_descriptor
) int
    const: LmTransSymbol: old_symbol
    int: compatible

    old_symbol: lm_trans_namespace_find(namespace_, owner)
    if: old_symbol = 0
        return: 0
    if: old_symbol\descriptor = 0
        c.fprintf(c.stderr, "trans L2 redeclaration error: old binding \"%.*s\" has no structural descriptor\n", (cast: int owner\length), owner\data)
        return: 1
    if: lm_trans_descriptor_implements(old_symbol\descriptor, pending_descriptor, pending_descriptor, @ compatible) != 0
        c.fprintf(c.stderr, "trans L2 redeclaration error: malformed descriptor for \"%.*s\"\n", (cast: int owner\length), owner\data)
        return: 1
    if: compatible = 0
        c.fprintf(c.stderr, "trans L2 redeclaration error: implements(varA varB Consumer) is false for \"%.*s\"\n", (cast: int owner\length), owner\data)
        return: 1

    if: lm_trans_descriptor_structural_same(old_symbol\descriptor, pending_descriptor)
        return: 0

    c.fprintf(c.stderr, "trans hosted C backend limitation: compatible non-identical occurrences of \"%.*s\" require occurrence-aware type projection\n", (cast: int owner\length), owner\data)
return: 1

fn: lm_trans_declare_named_structure_layout_mode (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
    int: reject_hosted_redeclaration
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    LmTransL4CallableType: field_type
    const: LmP0Text: name
    const: LmP0Field: initializer
    LmTransDescriptor: descriptor
    size_t: index
    @: char layout_c_type

    if: namespace_ = 0 || frame = 0 || lm_trans_frame_looks_named_structure_layout_declaration(frame, namespace_) = 0
        return: 1

    descriptor: lm_trans_descriptor_new()
    finally: lm_trans_descriptor_delete(descriptor)
    if: descriptor = 0 || lm_trans_descriptor_mark_structural_fields(descriptor) != 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    body: lm_trans_named_structure_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    index: 0U
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: field\value\kind != c.LM_P0_NODE_FRAME
                return: 1
            if: lm_trans_frame_is_structure_callable_field(field\value\as\frame)
                name: lm_trans_structure_callable_field_name(field\value\as\frame)
                if: name = 0
                    c.fprintf(c.stderr, "trans L2 structure descriptor error: nested fn/sub/callable expects a name\n")
                    return: 1
                if: lm_trans_named_structure_type_set_cstr(field_type, "lm.trans.callable", 1U, 0) = 0
                    return: 1
                if: lm_trans_descriptor_add_structural_field(descriptor, name, field_type\class_name, index, field_type\address_depth, 0U, 0, 0, 0) != 0
                    return: 1
                ---
            else:
                if: lm_trans_named_structure_field_info_for_owner(field\value\as\frame, namespace_, frame\head, field_type, @ name, @ initializer) = 0
                    return: 1
                if: initializer != 0
                    c.fprintf(c.stderr, "trans L2 structure descriptor error: field \"%.*s\" cannot contain an instance initializer; construct a value explicitly\n", (cast: int name\length), name\data)
                    return: 1
                if: lm_trans_named_structure_project_graph_field_type(field_type) = 0
                    return: 1
                if: lm_trans_descriptor_add_structural_field(descriptor, name, field_type\class_name, index, field_type\address_depth, 0U, 0, field_type\is_const, 0) != 0
                    return: 1
                ---
            ---
            index: index + 1U
        ---
        field: field\next

    if: reject_hosted_redeclaration && lm_trans_hosted_descriptor_redeclaration_is_unsupported(namespace_, frame\head, descriptor) != 0
        return: 1
    if: lm_trans_descriptor_payload_is_empty(descriptor)
        if: lm_trans_descriptor_set_class_relation(descriptor, "lm.trans.c.type", "LmLmxStructure") != 0
            return: 1
        ---
    else:
        if: lm_trans_descriptor_payload_is_graph_slots_for_owner(namespace_, descriptor, frame\head)
            layout_c_type: lm_trans_graph_layout_c_type_new(frame\head)
            if: layout_c_type = 0
                return: 1
            if: lm_trans_descriptor_set_class_relation(descriptor, "lm.trans.c.type", layout_c_type) != 0
                lm_own_delete(layout_c_type, 0)
                return: 1
            lm_own_delete(layout_c_type, 0)
        ---
    ---
    if: lm_trans_bind_named_structure_descriptor(namespace_, frame\head, @ descriptor) != 0
        return: 1
return: 0

fn: lm_trans_declare_named_structure_layout (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
return: lm_trans_declare_named_structure_layout_mode(namespace_, frame, 0)

fn: lm_trans_declare_hosted_named_structure_layout (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
return: lm_trans_declare_named_structure_layout_mode(namespace_, frame, 1)

fn: lm_trans_descriptor_payload_is_empty (
    const: LmTransDescriptor: descriptor
) int
    if: descriptor = 0 || descriptor\has_structural_fields = 0 || descriptor\structural_fields = 0
        return: 0
return: descriptor\structural_fields\count = 0U

fn: lm_trans_descriptor_graph_field_is_primitive (
    const: LmTransNamespace: namespace_
    const: LmTransDescriptorField: field
) int
    LmP0Text: type_name
    const: @: char class_kind

    if: field = 0 || field\descriptor_name = 0 || field\has_array_count || field\is_union
        return: 0
    type_name: lm_trans_text_from_cstr(field\descriptor_name)
    if: type_name = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ type_name)
    if: lm_trans_namespace_has_named_structure_binding(namespace_, type_name)
        return: 0
    if: lm_trans_builtin_c_type_name(type_name)
        return: 1
    class_kind: lm_trans_namespace_class_kind_value(namespace_, type_name)
    if: class_kind != 0 && c.strcmp(class_kind, "primitive") = 0
        return: 1
return: 0

fn: lm_trans_descriptor_graph_field_is_slot_for_owner (
    const: LmTransNamespace: namespace_
    const: LmTransDescriptorField: field
    const: LmP0Text: pending_owner
) int
    LmP0Text: type_name

    if: field = 0 || field\descriptor_name = 0 || field\has_array_count || field\is_union
        return: 0
    if: lm_trans_descriptor_graph_field_is_primitive(namespace_, field)
        return: 1
    type_name: lm_trans_text_from_cstr(field\descriptor_name)
    if: type_name = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ type_name)
    if: pending_owner != 0 && lm_trans_text_same(type_name, pending_owner)
        return: 1
    if: lm_trans_namespace_has_named_structure_binding(namespace_, type_name)
        return: 1
    if: lm_trans_text_equals(type_name, "LmSlice")
        return: 1
    if: lm_trans_text_equals(type_name, "lm.trans.callable")
        return: 1
return: 0

fn: lm_trans_descriptor_payload_is_graph_primitives (
    const: LmTransNamespace: namespace_
    const: LmTransDescriptor: descriptor
) int
    size_t: i
    const: LmTransDescriptorField: field

    if: descriptor = 0 || descriptor\has_structural_fields = 0 || descriptor\structural_fields = 0 || descriptor\structural_fields\count = 0U
        return: 0
    i: 0U
    while: i < descriptor\structural_fields\count
        field: lm_own_ptr_stack_at(descriptor\structural_fields, i)
        if: lm_trans_descriptor_graph_field_is_primitive(namespace_, field) = 0
            return: 0
        i: i + 1U
return: 1

fn: lm_trans_descriptor_payload_is_graph_slots (
    const: LmTransNamespace: namespace_
    const: LmTransDescriptor: descriptor
) int
return: lm_trans_descriptor_payload_is_graph_slots_for_owner(namespace_, descriptor, 0)

fn: lm_trans_descriptor_payload_is_graph_slots_for_owner (
    const: LmTransNamespace: namespace_
    const: LmTransDescriptor: descriptor
    const: LmP0Text: pending_owner
) int
    size_t: i
    const: LmTransDescriptorField: field

    if: descriptor = 0 || descriptor\has_structural_fields = 0 || descriptor\structural_fields = 0 || descriptor\structural_fields\count = 0U
        return: 0
    i: 0U
    while: i < descriptor\structural_fields\count
        field: lm_own_ptr_stack_at(descriptor\structural_fields, i)
        if: lm_trans_descriptor_graph_field_is_slot_for_owner(namespace_, field, pending_owner) = 0
            return: 0
        i: i + 1U
return: 1

fn: lm_trans_named_structure_uses_graph_header (
    const: LmTransNamespace: namespace_
    const: LmP0Text: name
) int
    const: LmTransDescriptor: descriptor

    descriptor: lm_trans_namespace_descriptor(namespace_, name)
    if: lm_trans_descriptor_payload_is_empty(descriptor)
        return: 1
return: lm_trans_descriptor_payload_is_graph_slots(namespace_, descriptor)

fn: lm_trans_graph_layout_c_type_new (
    const: LmP0Text: name
) @: char
return: lm_trans_l2_c_identifier_new("struct lm_lmx_layout_", name, "")

fn: lm_trans_emit_structure_graph_header (
    FILE: file
) int
    if: file = 0
        return: 1
    if: lm_trans_emit_message_thread_runtime_prelude(file) != 0
        return: 1
    if: lm_trans_emitted_structure_graph_header
        return: 0

    lm_trans_emitted_structure_graph_header: 1
    if: lm_trans_put(file, "typedef struct LmLmxStructure LmLmxStructure;\n") != 0
        return: 1
    if: lm_trans_put(file, "struct LmLmxStructure {\n    LmLmxStructure *descriptor;\n};\n") != 0
        return: 1
    if: lm_trans_put(file, "static LmLmxStructure lm_lmx_structure_descriptor;\n") != 0
        return: 1
    if: lm_trans_put(file, "static void *lm_lmx_structure_new_in(struct LmMessageThread *thread, struct LmOwnArena *arena, LmLmxStructure *descriptor, size_t size)\n{\n") != 0
        return: 1
    if: lm_trans_put(file, "    LmLmxStructure *chunk;\n") != 0
        return: 1
    if: lm_trans_put(file, "    if (size < sizeof(LmLmxStructure))\n        size = sizeof(LmLmxStructure);\n") != 0
        return: 1
    if: lm_trans_put(file, "    if (lm_lmx_structure_descriptor.descriptor == 0)\n        lm_lmx_structure_descriptor.descriptor = &lm_lmx_structure_descriptor;\n") != 0
        return: 1
    if: lm_trans_put(file, "    if (descriptor != 0 && descriptor->descriptor == 0)\n        descriptor->descriptor = &lm_lmx_structure_descriptor;\n") != 0
        return: 1
    if: lm_trans_put(file, "    chunk = (LmLmxStructure *)lm_own_arena_new_zero(thread, arena, size);\n") != 0
        return: 1
    if: lm_trans_put(file, "    if (chunk == 0)\n        abort();\n") != 0
        return: 1
return: lm_trans_put(file, "    chunk->descriptor = descriptor;\n    return chunk;\n}\n")

fn: lm_trans_emit_graph_structure_new (
    FILE: file
    const: LmP0Text: descriptor_name
    const: @: char thread_expr
    const: @: char arena_expr
    const: LmP0Text: instance_name
) int
    if: file = 0 || descriptor_name = 0 || thread_expr = 0 || arena_expr = 0 || instance_name = 0
        return: 1
    if: lm_trans_put(file, "lm_lmx_structure_new_in(") != 0 || lm_trans_put(file, thread_expr) != 0 || lm_trans_put(file, ", ") != 0 || lm_trans_put(file, arena_expr) != 0
        return: 1
    if: lm_trans_put(file, ", &lm_lmx_desc_") != 0 || lm_trans_emit_identifier(file, descriptor_name) != 0
        return: 1
    if: lm_trans_put(file, ", sizeof(*") != 0 || lm_trans_emit_identifier(file, instance_name) != 0
        return: 1
return: lm_trans_put(file, "))")

fn: lm_trans_emit_named_structure_graph_descriptor (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    const: LmTransDescriptor: descriptor
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmTransDescriptorField: callable_field
    size_t: descriptor_index

    if: file = 0 || frame = 0 || frame\head = 0
        return: 1
    if: lm_trans_emit_structure_graph_header(lm_trans_prelude_file(file)) != 0
        return: 1

    descriptor: lm_trans_namespace_descriptor(namespace_, frame\head)
    if: lm_trans_descriptor_payload_is_graph_slots(namespace_, descriptor)
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct lm_lmx_layout_") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct lm_lmx_layout_") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " {\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "LmLmxStructure *descriptor;\n") != 0
            return: 1
        body: lm_trans_named_structure_body(frame)
        field: 0
        if: body != 0
            field: body\first_field
        descriptor_index: 0U
        while: field != 0
            if: lm_trans_node_is_ignored(field\value) = 0 && field\value\kind = c.LM_P0_NODE_FRAME && lm_trans_frame_is_structure_callable_field(field\value\as\frame)
                descriptor_index: descriptor_index + 1U
                field: field\next
                continue
            if: lm_trans_node_is_ignored(field\value) = 0 && (field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_emit_named_structure_field_declaration(file, field\value\as\frame, descriptor, descriptor_index, indent + 1U, namespace_) != 0)
                return: 1
            if: lm_trans_node_is_ignored(field\value) = 0
                descriptor_index: descriptor_index + 1U
            field: field\next
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "};\n") != 0
            return: 1
        ---
    ---

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_put(file, "static LmLmxStructure lm_lmx_desc_") != 0 || lm_trans_emit_identifier(file, frame\head) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: descriptor = 0 || descriptor\structural_fields = 0
        return: 0
    descriptor_index: 0U
    while: descriptor_index < descriptor\structural_fields\count
        callable_field: lm_own_ptr_stack_at(descriptor\structural_fields, descriptor_index)
        if: lm_trans_descriptor_field_is_callable(callable_field) && callable_field\name != 0
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "static int lm_lmx_fn_") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, "_") != 0 || lm_trans_put(file, callable_field\name) != 0
                return: 1
            if: lm_trans_put(file, "(void) { return 0; }\n") != 0
                return: 1
            ---
        ---
        descriptor_index: descriptor_index + 1U
return: 0

fn: lm_trans_emit_named_structure_field_declaration (
    FILE: file
    const: LmP0Frame: field_frame
    const: LmTransDescriptor: descriptor
    size_t: descriptor_index
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    LmTransL4CallableType: field_type
    const: LmP0Text: name
    const: LmP0Field: initializer
    const: LmTransDescriptorField: descriptor_field
    @: char projected_name
    LmP0Text: projected_name_text

    projected_name: 0
    projected_name_text: 0
    finally: lm_own_delete(projected_name, 0)
    finally: lm_trans_text_ref_destroy(@ projected_name_text)

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    if: lm_trans_named_structure_field_info(field_frame, namespace_, field_type, @ name, @ initializer) = 0
        return: 1
    if: initializer != 0
        c.fprintf(c.stderr, "trans L2 structure descriptor error: field \"%.*s\" cannot contain an instance initializer; construct a value explicitly\n", (cast: int name\length), name\data)
        return: 1

    descriptor_field: lm_trans_descriptor_structural_field_by_index(descriptor, descriptor_index)
    if: descriptor_field = 0
        return: 1
    projected_name: lm_trans_descriptor_projected_member_name_new(descriptor, descriptor_field)
    if: projected_name = 0
        return: 1
    projected_name_text: lm_trans_text_from_cstr(projected_name)
    if: projected_name_text = 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_callable_type_named(file, field_type, projected_name_text, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_named_structure_typedef (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmTransDescriptor: descriptor
    size_t: descriptor_index

    if: file = 0 || frame = 0 || lm_trans_frame_looks_named_structure_layout_declaration(frame, namespace_) = 0
        return: 1

    descriptor: lm_trans_namespace_descriptor(namespace_, frame\head)
    if: descriptor = 0 || descriptor\has_structural_fields = 0
        return: 1
    if: lm_trans_named_structure_uses_graph_header(namespace_, frame\head)
        return: lm_trans_emit_named_structure_graph_descriptor(file, frame, indent, namespace_)

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_put(file, "struct ") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "typedef struct ") != 0
        return: 1
    if: lm_trans_emit_identifier(file, frame\head) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct ") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " {\n") != 0
        return: 1

    body: lm_trans_named_structure_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    descriptor_index: 0U
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && field\value\kind = c.LM_P0_NODE_FRAME && lm_trans_frame_is_structure_callable_field(field\value\as\frame)
            descriptor_index: descriptor_index + 1U
            field: field\next
            continue
        if: lm_trans_node_is_ignored(field\value) = 0 && (field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_emit_named_structure_field_declaration(file, field\value\as\frame, descriptor, descriptor_index, indent + 1U, namespace_) != 0)
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0
            descriptor_index: descriptor_index + 1U
        field: field\next

    if: descriptor_index = 0U
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "unsigned char lm_lmx_empty_structure;\n") != 0
            return: 1
        ---
    ---

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
return: lm_trans_put(file, "};\n")

fn: lm_trans_l2_c_identifier_char (char: ch) int
return: (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch = '_'

fn: lm_trans_l2_c_identifier_new (
    const: @(char prefix)
    const: LmP0Text: text
    const: @(char suffix)
) @: char
    LmP0Text: payload
    @: char result
    size_t: prefix_length
    size_t: suffix_length
    size_t: payload_length
    size_t: length
    size_t: i
    size_t: out
    char: ch

    if: prefix = 0 || text = 0
        return: 0

    payload: lm_trans_text_ref_new_cstr("")
    if: payload = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ payload)

    if: lm_trans_registry_literal_value(text, payload) = 0
        return: 0

    prefix_length: c.strlen(prefix)
    suffix_length: 0U
    if: suffix != 0
        suffix_length: c.strlen(suffix)
    payload_length: 1U
    if: payload\length != 0U
        payload_length: payload\length
    length: prefix_length + payload_length + suffix_length
    result: (cast: (@: char) lm_own_new_zero(length + 1U))
    if: result = 0
        return: 0

    c.memcpy(result, prefix, prefix_length)
    out: prefix_length
    if: payload\length = 0U
        result[out]: 'x'
        out: out + 1U
    if: payload\length != 0U
        i: 0U
        while: i < payload\length
            ch: payload\data[i]
            if: lm_trans_l2_c_identifier_char(ch)
                result[out]: ch
            if: lm_trans_l2_c_identifier_char(ch) = 0
                result[out]: '_'
            out: out + 1U
            i: i + 1U
    ---
    if: suffix_length != 0U
        c.memcpy(result + out, suffix, suffix_length)
        out: out + suffix_length
    result[out]: '\0'
return: result

fn: lm_trans_l2_structure_first_present_field (const: (LmP0Structure: structure)) const: LmP0Field
    const: LmP0Field: field

    field: 0
    if: structure != 0
        field: structure\first_field
    while: field != 0 && lm_trans_node_is_ignored(field\value)
        field: field\next
return: field

fn: lm_trans_l2_structure_next_present_field (const: (LmP0Field: field)) const: LmP0Field
    if: field != 0
        field: field\next
    while: field != 0 && lm_trans_node_is_ignored(field\value)
        field: field\next
return: field

fn: lm_trans_l2_table_cell_node_is_present (const: LmP0Node: node) int
    if: node = 0 || (node\flags & c.LM_P0_NODE_INACTIVE) != 0U || lm_trans_node_is_positional_skip(node)
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(node\as\atom, "None")
        return: 1
