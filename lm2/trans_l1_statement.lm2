    size_t: column_count
    size_t: row_count
    const: LmTransDescriptor: row_descriptor
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char arena_expression)
    int: module_initializer
) int
    const: LmP0Field: cell
    const: LmP0Field: next_cell
    const: LmP0Structure: inline_body
    const: LmTransDescriptorField: descriptor_field
    @: char items_name
    @: char row_name
    @: char cell_name
    @: char projected_name
    size_t: row_index
    size_t: column_index

    if: file = 0 || rows_frame = 0 || base_name = 0 || row_type_name = 0 || result_name = 0 || column_types = 0 || column_names = 0 || column_count = 0U || row_descriptor = 0 || namespace_ = 0 || arena_expression = 0
        return: 1
    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1

    items_name: lm_trans_l2_object_suffix_name_new(base_name, "_items")
    if: items_name = 0
        return: 1
    finally: lm_own_delete(items_name, 0)

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "const ") != 0 || lm_trans_put(file, row_type_name) != 0 || lm_trans_put(file, " **") != 0 || lm_trans_put(file, items_name) != 0 || lm_trans_put(file, " = 0;\n") != 0
        return: 1

    if: row_count != 0U
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, items_name) != 0 || lm_trans_put(file, " = (const ") != 0 || lm_trans_put(file, row_type_name) != 0 || lm_trans_put(file, " **)lm_own_arena_array_new_zero(") != 0 || lm_trans_put(file, lm_trans_current_thread_name()) != 0 || lm_trans_put(file, ", ") != 0 || lm_trans_put(file, arena_expression) != 0 || lm_trans_put(file, ", sizeof(*") != 0 || lm_trans_put(file, items_name) != 0 || lm_trans_put(file, "), ") != 0 || lm_trans_emit_size_literal(file, row_count) != 0 || lm_trans_put(file, ", 1U, 0U);\n") != 0
            return: 1
        if: lm_trans_emit_l2_runtime_table_allocation_guard(file, items_name, indent, module_initializer) != 0
            return: 1
        ---
    ---

    cell: lm_trans_l2_table_first_cell_field(rows_frame\body)
    row_index: 0U
    while: row_index < row_count
        row_name: lm_trans_l2_runtime_table_row_name_new(base_name, row_index)
        if: row_name = 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, row_type_name) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_put(file, row_name) != 0 || lm_trans_put(file, " = (") != 0 || lm_trans_put(file, row_type_name) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(") != 0 || lm_trans_put(file, lm_trans_current_thread_name()) != 0 || lm_trans_put(file, ", ") != 0 || lm_trans_put(file, arena_expression) != 0 || lm_trans_put(file, ", sizeof(*") != 0 || lm_trans_put(file, row_name) != 0 || lm_trans_put(file, "));\n") != 0
            lm_own_delete(row_name, 0)
            return: 1
        if: lm_trans_emit_l2_runtime_table_allocation_guard(file, row_name, indent, module_initializer) != 0
            lm_own_delete(row_name, 0)
            return: 1

        column_index: 0U
        while: column_index < column_count
            if: cell = 0 || cell\value = 0
                lm_own_delete(row_name, 0)
                return: 1
            next_cell: lm_trans_l2_table_next_cell_field(cell)
            descriptor_field: lm_trans_descriptor_structural_field_by_index(row_descriptor, column_index)
            if: descriptor_field = 0
                lm_own_delete(row_name, 0)
                return: 1
            projected_name: lm_trans_descriptor_projected_member_name_new(row_descriptor, descriptor_field)
            if: projected_name = 0
                lm_own_delete(row_name, 0)
                return: 1

            inline_body: 0
            if: lm_trans_l2_table_next_cell_field(cell) = next_cell
                inline_body: lm_trans_l2_table_cell_inline_layout_body(cell\value, column_types[column_index], namespace_)
            ---
            if: inline_body != 0
                cell_name: lm_trans_l2_table_cell_storage_name_new(base_name, row_index, column_index)
                if: cell_name = 0 || lm_trans_emit_l2_runtime_table_inline_value(file, inline_body, column_types[column_index], cell_name, indent, namespace_, arena_expression, module_initializer) != 0 || lm_trans_emit_l2_runtime_table_member_name(file, row_name, projected_name, cell_name, column_types[column_index], indent, namespace_) != 0
                    lm_own_delete(cell_name, 0)
                    lm_own_delete(projected_name, 0)
                    lm_own_delete(row_name, 0)
                    return: 1
                lm_own_delete(cell_name, 0)
            else:
                if: lm_trans_emit_l2_runtime_table_member_expression(file, row_name, projected_name, cell, next_cell, column_types[column_index], indent, namespace_) != 0
                    lm_own_delete(projected_name, 0)
                    lm_own_delete(row_name, 0)
                    return: 1
                ---
            ---
            lm_own_delete(projected_name, 0)
            cell: next_cell
            column_index: column_index + 1U
        ---

        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, items_name) != 0 || c.fprintf(file, "[%zuU] = ", row_index) < 0 || lm_trans_put(file, row_name) != 0 || lm_trans_put(file, ";\n") != 0
            lm_own_delete(row_name, 0)
            return: 1
        lm_own_delete(row_name, 0)
        row_index: row_index + 1U
    ---

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "LmSlice *") != 0 || lm_trans_put(file, result_name) != 0 || lm_trans_put(file, " = (LmSlice *)lm_own_arena_new_zero(") != 0 || lm_trans_put(file, lm_trans_current_thread_name()) != 0 || lm_trans_put(file, ", ") != 0 || lm_trans_put(file, arena_expression) != 0 || lm_trans_put(file, ", sizeof(*") != 0 || lm_trans_put(file, result_name) != 0 || lm_trans_put(file, "));\n") != 0
        return: 1
    if: lm_trans_emit_l2_runtime_table_allocation_guard(file, result_name, indent, module_initializer) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, result_name) != 0 || lm_trans_put(file, "->ptr = (void *)") != 0 || lm_trans_put(file, items_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, result_name) != 0 || lm_trans_put(file, "->length = ") != 0 || lm_trans_emit_size_literal(file, row_count) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
return: 0

