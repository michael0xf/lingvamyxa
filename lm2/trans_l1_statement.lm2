fn: lm_trans_sequence_item_index (const: @(char payload); @: size_t out_index) int
    @: char end_index
    ulong: value

    if: payload = 0 || payload[0] = '\0' || out_index = 0
        return: 0

    end_index: 0
    value: c.strtoul(payload, @ end_index, 10)
    if: end_index = payload || end_index = 0 || end_index[0] != '\0'
        return: 0
    out_index[0]: (cast: size_t value)
return: 1

fn: lm_trans_sequence_item_source_table_name_new (const: (LmP0Text: sequence_name)) @: char
    LmP0Text: sequence_payload
    @: char source_table_name

    sequence_payload: lm_trans_statement_text_new()
    if: sequence_payload = 0
        return: 0
    if: lm_trans_identifier_payload(sequence_name, sequence_payload) = 0
        lm_trans_text_ref_destroy(@ sequence_payload)
        return: 0

    source_table_name: lm_own_new_zero(sequence_payload\length + 6U)
    if: source_table_name != 0
        if: sequence_payload\length != 0U
            c.memcpy(source_table_name, sequence_payload\data, sequence_payload\length)
        c.memcpy(source_table_name + sequence_payload\length, ".item", 6U)
    ---
    lm_trans_text_ref_destroy(@ sequence_payload)
return: source_table_name

fn: lm_trans_sequence_item_count (
    LmTransNamespace: namespace_
    const: LmP0Text: sequence_name
) size_t
    const: LmRegistryView: view
    const: LmOwnPtrStack: rows
    @: char source_table_name
    size_t: count

    if: sequence_name = 0
        return: 0U
    source_table_name: lm_trans_sequence_item_source_table_name_new(sequence_name)
    if: source_table_name = 0
        return: 0U
    view: lm_trans_namespace_registry_view(namespace_)
    if: view != 0
        count: lm_registry_view_table_row_count(view, source_table_name)
    else:
        rows: lm_trans_namespace_registry_relation_stack(namespace_, sequence_name, "item")
        count: 0U
        if: rows != 0
            count: rows\count
    ---
    lm_own_delete(source_table_name, 0)
return: count

fn: lm_trans_sequence_item_at_index (
    LmTransNamespace: namespace_
    const: LmP0Text: sequence_name
    size_t: expected_index
    const: @@(char out_item_name)
) int
    const: LmRegistryView: view
    const: LmRegistryViewRow: view_row
    const: LmOwnPtrStack: rows
    LmTransRegistryFact: row
    const: LmTransRegistryFact: facade_row
    const: LmTableCell: source_key_cell
    const: LmTableCell: source_index_cell
    const: @: char item_name
    const: @: char payload
    @: char source_table_name
    size_t: row_count
    size_t: index
    size_t: i
    int: found

    if: out_item_name != 0
        out_item_name[0]: 0
    if: sequence_name = 0 || out_item_name = 0
        return: 1
    source_table_name: lm_trans_sequence_item_source_table_name_new(sequence_name)
    if: source_table_name = 0
        return: 1
    finally: lm_own_delete(source_table_name, 0)

    view: lm_trans_namespace_registry_view(namespace_)
    rows: 0
    if: view != 0
        row_count: lm_registry_view_table_row_count(view, source_table_name)
    else:
        rows: lm_trans_namespace_registry_relation_stack(namespace_, sequence_name, "item")
        row_count: 0U
        if: rows != 0
            row_count: rows\count
    ---

    found: 0
    i: 0U
    while: i < row_count
        item_name: 0
        payload: 0
        if: view != 0
            view_row: lm_registry_view_table_row_at(view, source_table_name, i)
            if: view_row != 0
                item_name: view_row\key
                payload: view_row\payload
                facade_row: cast: (const: LmTransRegistryFact) view_row\source
                source_key_cell: 0
                source_index_cell: lm_trans_registry_source_path_typed_cell_kind(namespace_, source_table_name, "class", "class", "size_t", "index", facade_row, 0, @ source_key_cell)
                if: source_key_cell != 0 && source_key_cell\value != 0 && source_index_cell != 0 && source_index_cell\value != 0 && lm_trans_registry_view_is_selected() != 0
                    item_name: source_key_cell\value
                    payload: source_index_cell\value
                ---
            ---
        else:
            row: (cast: (LmTransRegistryFact) lm_own_ptr_stack_at(rows, i))
            if: row != 0
                item_name: row\key
                payload: row\payload
        ---
        if: item_name != 0
            if: lm_trans_sequence_item_index(payload, @ index) && index = expected_index
                if: found
                    c.fprintf(c.stderr, "trans registry error: atom statement sequence \"%.*s\" has duplicate index %zu\n", (cast: int sequence_name\length), sequence_name\data, expected_index)
                    return: 1
                found: 1
                out_item_name[0]: item_name
            ---
        ---
        i: i + 1U

    if: found = 0
        c.fprintf(c.stderr, "trans registry error: atom statement sequence \"%.*s\" is missing index %zu\n", (cast: int sequence_name\length), sequence_name\data, expected_index)
        return: 1
return: 0

fn: lm_trans_emit_atom_statement_sequence (
    FILE: file
    const: LmP0Text: sequence_name
    unsigned: indent
    LmTransNamespace: namespace_
) int
    LmTransAtomStatementHandler: handler
    LmP0Node: node
    LmP0NodeAs: node_as
    LmP0Text: item_name
    const: @: char selected_item_name
    const: @: char binding
    size_t: item_count
    size_t: expected_index
    int: status

    item_count: lm_trans_sequence_item_count(namespace_, sequence_name)
    if: item_count = 0U
        c.fprintf(c.stderr, "trans registry error: atom statement sequence \"%.*s\" has no item rows\n", (cast: int sequence_name\length), sequence_name\data)
        return: 1

    node: lm_trans_statement_node_new()
    if: node = 0
        return: 1
    finally: lm_own_delete(node, 0)

    node_as: lm_trans_statement_node_as_new()
    if: node_as = 0
        return: 1
    finally: lm_own_delete(node_as, 0)

    item_name: lm_trans_statement_text_new()
    if: item_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ item_name)

    status: 0
    expected_index: 0U
    while: status = 0 && expected_index < item_count
        selected_item_name: 0
        if: lm_trans_sequence_item_at_index(namespace_, sequence_name, expected_index, @ selected_item_name) != 0
            status: 1
        else:
            if: lm_trans_text_assign_cstr(item_name, selected_item_name) = 0
                status: 1
            if: status = 0
                binding: lm_trans_atom_statement_receiver_binding(item_name)
                handler: lm_trans_atom_statement_binding_handler(binding)
                if: handler = 0 || handler = @lm_trans_atom_statement_emit_sequence_prelude
                    c.fprintf(c.stderr, "trans registry error: atom statement sequence \"%.*s\" item %s has no concrete atom receiver\n", (cast: int sequence_name\length), sequence_name\data, selected_item_name)
                    status: 1
            ---
            if: status = 0
                c.memset(node, 0, c.sizeof(node[0]))
                c.memset(node_as, 0, c.sizeof(node_as[0]))
                node\kind: c.LM_P0_NODE_ATOM
                node\as: node_as
                node\as\atom: item_name
                if: handler(file, node, indent, namespace_) != 0
                    status: 1
            ---
        if: status = 0
            expected_index: expected_index + 1U
return: status

fn: lm_trans_atom_statement_emit_sequence_prelude (
    FILE: file
    const: LmP0Node: node
    unsigned: indent
    LmTransNamespace: namespace_
) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 1
return: lm_trans_emit_atom_statement_sequence(file, node\as\atom, indent, namespace_)

fn: lm_trans_emit_configured_prelude_sequences (
    FILE: file
    LmTransNamespace: namespace_
    @: int out_emitted
) int
    LmOwnPtrStack: sequence_names
    const: @: char sequence_name
    size_t: i

    sequence_names: lm_trans_namespace_registry_source_relation_keys_new(namespace_, lm_trans_text_from_cstr("prelude"), "sequence")
    if: sequence_names = 0
        return: 0
    finally: lm_trans_ptr_stack_delete(@ sequence_names)

    i: 0U
    while: i < sequence_names\count
        sequence_name: lm_own_ptr_stack_at(sequence_names, i)
        if: sequence_name != 0
            if: out_emitted != 0 && out_emitted[0] && lm_trans_put(file, "\n") != 0
                return: 1
            if: lm_trans_emit_atom_statement_sequence(file, lm_trans_text_from_cstr(sequence_name), 0U, namespace_) != 0
                return: 1
            if: out_emitted != 0
                out_emitted[0]: 1
        ---
        i: i + 1U
return: 0

fn: lm_trans_atom_statement_binding_handler (const: @(char binding)) LmTransAtomStatementHandler
    LmTransBinding: resolved
    LmTransAtomStatementHandler: handler

    if: binding = 0
        return: 0

    resolved: lm_trans_statement_binding_new()
    if: resolved = 0
        return: 0
    finally: lm_own_delete(resolved, 0)

    handler: 0
    if: lm_trans_binding_resolve(binding, resolved) && resolved\atom_statement != 0
        handler: resolved\atom_statement
return: handler

fn: lm_trans_lower_atom_statement (const: (LmP0Text: atom)) LmTransAtomStatementHandler
    const: @: char binding
    LmTransAtomStatementHandler: handler

    if: lm_trans_text_equals(atom, "break")
        return: @lm_trans_emit_atom_loop_jump_statement
    if: lm_trans_text_equals(atom, "continue")
        return: @lm_trans_emit_atom_loop_jump_statement
    if: lm_trans_text_equals(atom, "return")
        return: @lm_trans_emit_atom_return_statement
    if: lm_trans_atom_starts_string(atom)
        return: @lm_trans_emit_atom_string_error_statement

    binding: lm_trans_atom_statement_receiver_binding(atom)
    if: binding != 0
        handler: lm_trans_atom_statement_binding_handler(binding)
        if: handler != 0
            return: handler
        c.fprintf(c.stderr, "trans registry error: unknown atom statement binding %s\n", binding)
        return: 0
return: @lm_trans_emit_atom_expr_statement

fn: lm_trans_namespace_publish_function_callable (
    LmTransNamespace: namespace_
    const: LmTransFunctionHeader: function
    const: LmP0Text: code_name
) int
    if: namespace_ = 0 || function = 0 || code_name = 0
        return: 1
    if: lm_trans_namespace_declare_c_name(namespace_, function\name, function\symbol_class, code_name) != 0
        return: 1
return: lm_trans_namespace_set_callable_shape(namespace_, function)

fn: lm_trans_namespace_publish_hoisted_callable (
    LmTransNamespace: namespace_
    const: LmTransFunctionHeader: function
    const: LmTransHoistedFunction: hoisted
) int
    @: char env_arg
    LmP0Text: env_arg_text

    if: namespace_ = 0 || function = 0 || hoisted = 0 || hoisted\function = 0
        return: 1

    env_arg: 0
    env_arg_text: 0
    finally: lm_own_delete(env_arg, 0)
    finally: lm_trans_text_ref_destroy(@ env_arg_text)

    if: lm_trans_namespace_publish_function_callable(namespace_, function, hoisted\function\c_name) != 0
        return: 1

    if: hoisted\function\has_env
        env_arg: lm_trans_env_arg_new(hoisted\env_var_name)
        if: env_arg = 0
            return: 1
        env_arg_text: lm_trans_text_ref_new_cstr(env_arg)
        if: env_arg_text = 0
            return: 1
        if: lm_trans_namespace_set_env_arg(namespace_, function\name, env_arg_text) != 0
            return: 1

    ---
    if: lm_trans_namespace_set_closure_call_name(namespace_, function\name, hoisted\closure_call_name) != 0
        return: 1
return: 0

fn: lm_trans_statement_emit_nested_function (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    LmTransFunctionHeader: function
    const: LmTransHoistedFunction: hoisted
    const: LmTransCapture: capture
    const: LmTransSymbol: symbol
    LmP0Text: descriptor_type
    @: char closure_value_name
    size_t: capture_index

    c.LM_UNUSED(stack)

    function: lm_trans_statement_function_header_new()
    if: function = 0
        return: 1
    finally: lm_trans_function_header_destroy(function)

    descriptor_type: lm_trans_statement_text_new()
    if: descriptor_type = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ descriptor_type)

    closure_value_name: 0
    finally: lm_own_delete(closure_value_name, 0)

    if: lm_trans_function_header_from_frame(frame, 0, function) <= 0
        return: 1

    hoisted: lm_trans_namespace_find_hoisted_function(namespace_, frame)
    if: hoisted = 0
        c.fprintf(c.stderr, "trans L2 internal error: nested function has no hoisted C binding\n")
        return: 1

    if: hoisted\function\has_env
        if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_write_text(file, hoisted\function\env_type_name) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_write_text(file, hoisted\env_var_name) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_write_text(file, hoisted\env_var_name) != 0 || lm_trans_put(file, " = (") != 0 || lm_trans_write_text(file, hoisted\function\env_type_name) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*") != 0 || lm_trans_write_text(file, hoisted\env_var_name) != 0 || lm_trans_put(file, "));\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_write_text(file, hoisted\env_var_name) != 0 || lm_trans_put(file, " == 0) {\n") != 0
            return: 1
        if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
            return: 1
        if: namespace_ != 0 && namespace_\return_type_node != 0
            if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return 0;\n") != 0
                return: 1
        ---
        else:
            if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return;\n") != 0
                return: 1
        ---
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1

        capture_index: 0U
        while: capture_index < hoisted\captures\count
            capture: (cast: (const: LmTransCapture) lm_own_ptr_stack_at(hoisted\captures, capture_index))
            if: capture = 0
                return: 1
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_write_text(file, hoisted\env_var_name) != 0 || lm_trans_put(file, "->") != 0 || lm_trans_emit_identifier(file, capture\name) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_identifier(file, capture\name) != 0 || lm_trans_put(file, ";\n") != 0
                return: 1
            capture_index: capture_index + 1U

    ---
    if: lm_trans_namespace_publish_hoisted_callable(namespace_, function, hoisted) != 0
        return: 1

    symbol: lm_trans_namespace_find(namespace_, function\name)
    if: lm_trans_current_return_is_callable_descriptor(namespace_, descriptor_type) && lm_trans_callable_descriptor_allows_capture(namespace_, descriptor_type) && lm_trans_callable_descriptor_uses_closure_struct(namespace_, descriptor_type) && lm_trans_callable_signature_matches_descriptor_name(descriptor_type, symbol, namespace_)
        closure_value_name: lm_trans_hoisted_suffix_name_new(hoisted\function\c_name, "_closure_value")
        if: closure_value_name = 0
            return: 1
        if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_write_text(file, descriptor_type) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_put(file, closure_value_name) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, closure_value_name) != 0 || lm_trans_put(file, " = (") != 0 || lm_trans_write_text(file, descriptor_type) != 0 || lm_trans_put(file, ")lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*") != 0 || lm_trans_put(file, closure_value_name) != 0 || lm_trans_put(file, "));\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_put(file, closure_value_name) != 0 || lm_trans_put(file, " == 0) {\n") != 0
            return: 1
        if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return 0;\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, closure_value_name) != 0 || lm_trans_put(file, "->call = ") != 0 || lm_trans_write_text(file, hoisted\closure_call_name) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, closure_value_name) != 0 || lm_trans_put(file, "->env = ") != 0
            return: 1
        if: hoisted\function\has_env && lm_trans_write_text(file, hoisted\env_var_name) != 0
            return: 1
        if: hoisted\function\has_env = 0 && lm_trans_put(file, "0") != 0
            return: 1
        if: lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, closure_value_name) != 0 || lm_trans_put(file, "->destroy = 0;\n") != 0
            return: 1

    ---

    if: hoisted\function\is_sub = 0 && hoisted\function\is_struct_return = 0 && hoisted\function\return_node != 0
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "(void)") != 0 || lm_trans_write_text(file, hoisted\closure_call_name) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
return: 0

fn: lm_trans_statement_stack_emit_node (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Node: node
    unsigned: indent
    const: LmP0Frame: repeat_frame
    LmTransNamespace: namespace_
) int
    LmTransAtomStatementHandler: handler
    LmP0Frame: repeated_frame

    if: lm_trans_node_is_ignored(node)
        return: 0

    if: lm_trans_node_is_positional_skip(node)
        c.fprintf(c.stderr, "trans L2 error: skipped positional statement has no default in this profile\n")
        return: 1

    if: node\kind = c.LM_P0_NODE_ATOM
        handler: lm_trans_lower_atom_statement(node\as\atom)
        if: handler = 0
            return: 1
        return: handler(file, node, indent, namespace_)

    if: node\kind = c.LM_P0_NODE_FRAME
        return: lm_trans_statement_stack_emit_frame(file, stack, node\as\frame, indent, namespace_)

    if: node\kind = c.LM_P0_NODE_STRUCTURE && repeat_frame != 0
        if: lm_trans_frame_looks_storage_declaration(repeat_frame, namespace_)
            repeated_frame: lm_trans_statement_frame_new()
            if: repeated_frame = 0
                return: 1
            finally: lm_own_delete(repeated_frame, 0)
            repeated_frame\head: repeat_frame\head
            repeated_frame\flags: c.LM_P0_FRAME_COMPACT
            repeated_frame\body: node\as\structure
            return: lm_trans_statement_stack_emit_frame(file, stack, repeated_frame, indent, namespace_)

        if: lm_trans_text_all_char(repeat_frame\head, '@')
            return: lm_trans_emit_pointer_declaration_repeat_with_qualifier(file, repeat_frame, node\as\structure, indent, namespace_, "")

        if: lm_trans_text_is_array_receiver_head(repeat_frame\head)
            return: lm_trans_emit_array_declaration_repeat_with_qualifier(file, repeat_frame, node\as\structure, indent, namespace_, "")

        repeated_frame: lm_trans_statement_frame_new()
        if: repeated_frame = 0
            return: 1
        finally: lm_own_delete(repeated_frame, 0)
        repeated_frame\head: repeat_frame\head
        repeated_frame\flags: c.LM_P0_FRAME_COMPACT
        repeated_frame\body: node\as\structure
        return: lm_trans_statement_stack_emit_frame(file, stack, repeated_frame, indent, namespace_)

    if: node\kind = c.LM_P0_NODE_STRUCTURE
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
            return: 1
        lm_trans_namespace_enter_scope(namespace_)
        if: lm_trans_typedef_projection_scope_enter() != 0
            lm_trans_namespace_leave_scope(namespace_)
            return: 1
        if: lm_trans_statement_stack_push_indent_text(stack, indent, "}\n") != 0
            lm_trans_typedef_projection_scope_leave()
            lm_trans_namespace_leave_scope(namespace_)
            return: 1
        if: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_leave_scope) != 0
            lm_trans_typedef_projection_scope_leave()
            lm_trans_namespace_leave_scope(namespace_)
            return: 1
        if: node\as\structure != 0 && node\as\structure\first_field != 0
            return: lm_trans_statement_stack_push_list(stack, node\as\structure\first_field, indent + 1U, 1, 0, 1)
        return: 0
return: 0

fn: lm_trans_catch_register_fields (LmTransNamespace: namespace_; const: (LmP0Field: first)) int
    const: LmP0Field: field
    const: LmP0Node: node
    const: LmP0Frame: frame
    const: LmP0Field: name_field
    const: LmP0Node: name_node
    unsigned: catch_id

    field: first
    while: field != 0
        node: field\value
        if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as\frame != 0 && lm_trans_text_equals(node\as\frame\head, "catch")
            frame: node\as\frame
            name_field: 0
            if: frame\body != 0
                name_field: frame\body\first_field
            if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
                c.fprintf(c.stderr, "trans L2 error: catch receiver expects a throw name\n")
                return: 1
            name_node: name_field\value
            if: lm_trans_throw_name_code(name_node\as\atom) = 0
                return: 1
            lm_trans_next_catch_id: lm_trans_next_catch_id + 1U
            catch_id: lm_trans_next_catch_id
            if: lm_trans_catch_push(namespace_, name_node\as\atom, catch_id) != 0
                return: 1
            ---
        ---
        field: field\next
return: 0

fn: lm_trans_statement_job_emit_list (
    FILE: file
    LmTransStatementStack: stack
    LmTransStatementJob: job
    LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    const: LmP0Node: node
    const: LmP0Frame: current_repeat_frame
    const: LmP0Frame: next_repeat_frame
    int: status

    c.LM_UNUSED(file)
    if: job\list = 0
        return: 1

    field: lm_trans_statement_list_first_field(job\list\field, job\list\unwrap_single_structure)
    if: field = 0
        return: 0
    if: job\list\register_catches && lm_trans_catch_register_fields(namespace_, field) != 0
        return: 1

    node: field\value
    current_repeat_frame: 0
    if: job\list\repeat_frame != 0 && node != 0 && node\kind = c.LM_P0_NODE_STRUCTURE
        current_repeat_frame: job\list\repeat_frame

    next_repeat_frame: 0
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && lm_trans_statement_frame_is_repeatable(node\as\frame, namespace_)
        next_repeat_frame: node\as\frame
    else:
        if: current_repeat_frame != 0
            next_repeat_frame: current_repeat_frame

    ---
    status: 0
    if: field\next != 0
        status: lm_trans_statement_stack_push_list(stack, field\next, job\list\indent, 0, next_repeat_frame, 0)
    if: status = 0
        status: lm_trans_statement_stack_push_node(stack, field\value, job\list\indent, current_repeat_frame)
return: status

fn: lm_trans_statement_job_emit_node (
    FILE: file
    LmTransStatementStack: stack
    LmTransStatementJob: job
    LmTransNamespace: namespace_
) int
    if: job\node = 0
        return: 1
return: lm_trans_statement_stack_emit_node(file, stack, job\node\node, job\node\indent, job\node\repeat_frame, namespace_)

fn: lm_trans_statement_job_validate_end (
    FILE: file
    LmTransStatementStack: stack
    LmTransStatementJob: job
    LmTransNamespace: namespace_
) int
    c.LM_UNUSED(file)
    c.LM_UNUSED(stack)
    c.LM_UNUSED(namespace_)
    if: job\frame = 0
        return: 1
return: lm_trans_validate_end_trailer(job\frame\frame)

fn: lm_trans_statement_job_emit_trailer (
    FILE: file
    LmTransStatementStack: stack
    LmTransStatementJob: job
    LmTransNamespace: namespace_
) int
    c.LM_UNUSED(stack)
    if: job\frame = 0 || job\frame\frame = 0
        return: 1
return: lm_trans_emit_trailer_statement(file, job\frame\frame\trailer, job\frame\indent, namespace_)

fn: lm_trans_statement_job_leave_scope (
    FILE: file
    LmTransStatementStack: stack
    LmTransStatementJob: job
    LmTransNamespace: namespace_
) int
    int: status

    c.LM_UNUSED(file)
    c.LM_UNUSED(stack)
    c.LM_UNUSED(job)
    status: lm_trans_typedef_projection_scope_leave()
    lm_trans_namespace_leave_scope(namespace_)
return: status

fn: lm_trans_statement_job_loop_pop (
    FILE: file
    LmTransStatementStack: stack
    LmTransStatementJob: job
    LmTransNamespace: namespace_
) int
    c.LM_UNUSED(file)
    c.LM_UNUSED(stack)
    c.LM_UNUSED(job)
    lm_trans_loop_pop(namespace_)
return: 0

fn: lm_trans_statement_job_emit_scope_cleanups (
    FILE: file
    LmTransStatementStack: stack
    LmTransStatementJob: job
    LmTransNamespace: namespace_
) int
    c.LM_UNUSED(stack)
    if: job\text = 0
        return: 1
return: lm_trans_emit_scope_cleanups(file, job\text\indent, namespace_)

fn: lm_trans_statement_job_emit_indent_text (
    FILE: file
    LmTransStatementStack: stack
    LmTransStatementJob: job
    LmTransNamespace: namespace_
) int
    c.LM_UNUSED(stack)
    c.LM_UNUSED(namespace_)
    if: job\text = 0
        return: 1
    if: lm_trans_emit_indent(file, job\text\indent) != 0
        return: 1
return: lm_trans_put(file, job\text\text)

fn: lm_trans_emit_statement_list (
    FILE: file
    const: LmP0Field: first
    unsigned: indent
    LmTransNamespace: namespace_
) int
    LmTransStatementStack: stack
    LmTransStatementJob: job
    int: previous_executable_depth
    size_t: projection_scope_depth
    int: status

    stack: lm_trans_statement_stack_new()
    if: stack = 0
        return: 1

    stack\jobs: lm_trans_ptr_stack_new(lm_trans_statement_job_delete_any)
    if: stack\jobs = 0
        lm_trans_statement_stack_destroy(stack)
        lm_own_delete(stack, 0)
        return: 1

    projection_scope_depth: lm_trans_typedef_projection_scope_depth()
    previous_executable_depth: lm_trans_l2_executable_statement_depth
    lm_trans_l2_executable_statement_depth: previous_executable_depth + 1
    status: lm_trans_statement_stack_push_list(stack, first, indent, 1, 0, 1)
    while: status = 0 && stack\jobs != 0 && stack\jobs\count > 0U
        job: (cast: (LmTransStatementJob) lm_own_ptr_stack_pop(stack\jobs))
        if: job = 0
            status: 1
            break
        if: job\run = 0
            status: 1
        else:
            status: job\run(file, stack, job, namespace_)
        lm_trans_statement_job_delete(job)

    if: lm_trans_typedef_projection_scope_depth() != projection_scope_depth
        if: lm_trans_typedef_projection_scope_restore(projection_scope_depth) != 0 || status = 0
            status: 1
        ---
    lm_trans_l2_executable_statement_depth: previous_executable_depth
    lm_trans_statement_stack_destroy(stack)
    lm_own_delete(stack, 0)
return: status

fn: lm_trans_emit_params_body (
    FILE: file
    const: LmTransFormalParamList: list
    LmTransNamespace: namespace_
    int: emit_void_when_empty
) int
    size_t: index

    if: list = 0
        return: 1

    index: 0U
    while: index < list\count
        if: index != 0U && lm_trans_put(file, ", ") != 0
            return: 1
        if: lm_trans_emit_formal_param(file, list\params[index], namespace_) != 0
            return: 1
        index: index + 1U

    if: list\count = 0U && emit_void_when_empty
        return: lm_trans_put(file, "void")
return: 0

fn: lm_trans_emit_function_params (
    FILE: file
    const: LmTransFunctionHeader: function
    LmTransNamespace: namespace_
) int
    int: has_user_params
    int: wrote_param
    int: status
    LmP0Text: source_c_name

    if: function = 0
        return: 1

    if: function\is_thread_handler
        if: function\params = 0 || function\params\count != 1U || function\params\params[0] = 0
            return: 1
        if: lm_trans_put(file, "struct LmMessageThread *lm_lmx_message_thread, void *lm_lmx_actor_context") != 0
            return: 1
        source_c_name: lm_trans_text_ref_new_cstr("lm_lmx_incoming_message")
        if: source_c_name = 0
            return: 1
        status: lm_trans_namespace_declare_c_name(namespace_, function\params\params[0]\name, "variable", source_c_name)
        if: status = 0
            status: lm_trans_namespace_declare_relation_text(namespace_, function\params\params[0]\name, "variable.type", function\params\params[0]\type\class_name)
        lm_trans_text_ref_destroy(@ source_c_name)
        return: status

    has_user_params: lm_trans_formal_param_list_has_any(function\params)
    wrote_param: 0
    if: function\has_thread_context
        if: lm_trans_put(file, "struct LmMessageThread *lm_lmx_message_thread") != 0
            return: 1
        wrote_param: 1
    ---
    if: function\has_env
        if: wrote_param && lm_trans_put(file, ", ") != 0
            return: 1
        if: lm_trans_write_text(file, function\env_type_name) != 0 || lm_trans_put(file, " *lm_env") != 0
            return: 1
        wrote_param: 1
    ---
    if: has_user_params
        if: wrote_param && lm_trans_put(file, ", ") != 0
            return: 1
        return: lm_trans_emit_params_body(file, function\params, namespace_, 0)
    if: wrote_param = 0
        return: lm_trans_put(file, "void")
return: 0

fn: lm_trans_emit_thread_handler_prologue (
    FILE: file
    const: LmTransFunctionHeader: function
    unsigned: indent
) int
    if: function = 0 || function\is_thread_handler = 0
        return: 0

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "const char *lm_lmx_incoming_lmx = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "size_t lm_lmx_incoming_length = 0U;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "IncomingMessage *lm_lmx_incoming_message;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "(void)lm_lmx_actor_context;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_lmx_incoming_message = (IncomingMessage *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*lm_lmx_incoming_message));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_lmx_incoming_message == 0 || lm_message_thread_current_lmx(lm_lmx_message_thread, &lm_lmx_incoming_lmx, &lm_lmx_incoming_length) != 0) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "lm_message_thread_request_failure(lm_lmx_message_thread, 1);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_lmx_incoming_message->lmx = lm_lmx_incoming_lmx;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_lmx_incoming_message->length = lm_lmx_incoming_length;\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_param_name_list (
    FILE: file
    const: LmTransFormalParamList: list
) int
    LmTransFormalParam: param
    size_t: index
    @: char param_c_name

    if: list = 0
        return: 1

    index: 0U
    while: index < list\count
        param: list\params[index]
        if: index != 0U && lm_trans_put(file, ", ") != 0
            return: 1
        if: param\is_array = 0
            if: lm_trans_emit_identifier(file, param\name) != 0
                return: 1
            ---
        else:
            param_c_name: lm_trans_array_param_c_name_new(param)
            if: param_c_name = 0
                return: 1
            if: lm_trans_put(file, param_c_name) != 0
                lm_own_delete(param_c_name, 0)
                return: 1
            lm_own_delete(param_c_name, 0)
        ---
        index: index + 1U
return: 0

fn: lm_trans_emit_closure_call_wrapper (
    FILE: file
    const: LmTransHoistedFunction: hoisted
    LmTransNamespace: namespace_
) int
    const: LmTransFunctionHeader: function
    int: has_params

    if: hoisted = 0
        return: 1
    function: hoisted\function
    if: function\is_sub || function\is_struct_return || function\return_node = 0
        return: 0

    if: lm_trans_put(file, "static ") != 0 || lm_trans_emit_type_node(file, function\return_node, namespace_) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_write_text(file, hoisted\closure_call_name) != 0 || lm_trans_put(file, "(void *lm_env, struct LmMessageThread *lm_lmx_message_thread") != 0
        return: 1
    has_params: lm_trans_formal_param_list_has_any(function\params)
    if: has_params && lm_trans_put(file, ", ") != 0
        return: 1
    if: lm_trans_emit_params_body(file, function\params, namespace_, 0) != 0 || lm_trans_put(file, ") {\n") != 0
        return: 1
    if: function\has_env = 0
        if: lm_trans_put(file, "    (void)lm_env;\n") != 0
            return: 1
    ---
    if: lm_trans_put(file, "    return ") != 0 || lm_trans_write_text(file, function\c_name) != 0 || lm_trans_put(file, "(") != 0
        return: 1
    if: function\has_thread_context
        if: lm_trans_put(file, "lm_lmx_message_thread") != 0
            return: 1
        if: function\has_env || has_params
            if: lm_trans_put(file, ", ") != 0
                return: 1
        ---
    ---
    if: function\has_env
        if: lm_trans_put(file, "(") != 0 || lm_trans_write_text(file, function\env_type_name) != 0 || lm_trans_put(file, " *)lm_env") != 0
            return: 1
        if: has_params && lm_trans_put(file, ", ") != 0
            return: 1
    ---
    if: lm_trans_emit_param_name_list(file, function\params) != 0
        return: 1
return: lm_trans_put(file, ");\n}\n")

fn: lm_trans_single_frame_node (
    const: LmP0Node: node
    const: @(LmP0Frame out_frame)
) int
    const: LmP0Field: field

    if: node = 0 || out_frame = 0
        return: 0

    if: node\kind = c.LM_P0_NODE_FRAME
        out_frame[0]: node\as\frame
        return: 1

    if: node\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

    field: node\as\structure\first_field
    if: field != 0 && field\next = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
        out_frame[0]: field\value\as\frame
        return: 1
return: 0

fn: lm_trans_formal_param_terminal_frame (
    const: LmP0Node: node
    const: @(LmP0Frame out_frame)
) int
    const: LmP0Node: current
    const: LmP0Frame: frame
    const: LmP0Field: field
    size_t: unwrap_index

    if: out_frame = 0
        return: 0

    current: node
    while: current != 0
        if: current\kind = c.LM_P0_NODE_STRUCTURE
            field: current\as\structure\first_field
            if: field = 0 || field\next != 0 || field\value = 0
                return: 0
            current: field\value
            continue
        ---
        if: lm_trans_single_frame_node(current, @ frame) = 0
            break
        if: lm_trans_frame_formal_param_unwrap_index(frame, @ unwrap_index) = 0
            break
        field: lm_trans_nth_field(frame\body, unwrap_index)
        if: field = 0 || field\value = 0
            return: 0
        current: field\value

return: lm_trans_single_frame_node(current, out_frame)

fn: lm_trans_formal_param_named_value_first (
    const: LmP0Frame: frame
    const: @(LmP0Field out_first)
) int
    const: LmP0Frame: value_frame

    if: out_first = 0
        return: 0
    out_first[0]: 0
    if: lm_trans_frame_arg_frame(frame, "value", @ value_frame) = 0
        return: 0
    if: value_frame = 0 || value_frame\body = 0 || value_frame\body\first_field = 0
        return: 0
    out_first[0]: value_frame\body\first_field
return: 1

fn: lm_trans_formal_param_read (
    const: LmP0Node: node
    LmTransL4CallableType: out_type
    LmP0Text: out_name
    @: int out_has_name
    const: @(LmP0Field out_value_first)
) int
    const: LmP0Frame: frame
    const: LmP0Field: name_field
    size_t: name_index
    int: has_name
    int: named_name

    if: out_has_name != 0
        out_has_name[0]: 0
    if: out_value_first != 0
        out_value_first[0]: 0
    if: out_name != 0
        out_name\data: ""
        out_name\length: 0U

    if: out_type != 0 && lm_trans_l4_callable_type_from_node(node, out_type) = 0
        return: 0

    frame: 0
    lm_trans_formal_param_terminal_frame(node, @ frame)
    if: frame = 0
        return: 1

    has_name: 0
    named_name: 0
    if: out_name != 0
        if: lm_trans_frame_arg_atom_payload(frame, "name", out_name) && lm_trans_name_argument_is_valid(out_name)
            has_name: 1
            named_name: 1
        else:
            if: lm_trans_frame_positional_name_index(frame, @ name_index) = 0
                name_index: 0U
            name_field: lm_trans_nth_field(frame\body, name_index)
            if: name_field != 0 && name_field\value != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_name_argument_is_valid(name_field\value\as\atom)
                out_name[0]: name_field\value\as\atom[0]
                has_name: 1
            ---
        ---

    if: out_has_name != 0
        out_has_name[0]: has_name

    if: out_value_first != 0
        if: lm_trans_formal_param_named_value_first(frame, out_value_first)
            return: 1
        if: named_name = 0
            lm_trans_formal_param_default_fields(node, out_value_first)
        ---

return: 1

fn: lm_trans_formal_param_name (
    const: LmP0Node: node
    LmP0Text: out_name
) int
    int: has_name

    if: lm_trans_formal_param_read(node, 0, out_name, @ has_name, 0) = 0
        return: 0
return: has_name

fn: lm_trans_formal_param_new () LmTransFormalParam
    LmTransFormalParam: param

    param: (cast: (LmTransFormalParam) lm_own_new_zero(c.sizeof(param[0])))
    if: param != 0
        param\type: lm_trans_expr_callable_type_new()
        param\name: lm_trans_statement_text_new()
        param\declarator: lm_trans_statement_c_declarator_new()
        if: param\type = 0 || param\name = 0 || param\declarator = 0
            lm_trans_formal_param_delete(param)
            return: 0
    ---
return: param

sub: lm_trans_formal_param_delete (LmTransFormalParam: param)
    if: param != 0
        lm_trans_expr_callable_type_delete(param\type)
        param\type: 0
        lm_trans_text_ref_destroy(@ param\name)
        lm_trans_statement_c_declarator_destroy(param\declarator)
        param\declarator: 0
    lm_own_delete(param, 0)
end: lm_trans_formal_param_delete

fn: lm_trans_formal_param_read_array_declarator (
    LmTransFormalParam: param
    const: LmP0Frame: frame
) int
    const: LmP0Node: element_type_node
    LmTransL4CallableType: element_type
    size_t: rank
    size_t: pointer_depth
    int: outer_const

    if: param = 0 || param\declarator = 0 || frame = 0
        return: 1

    if: lm_trans_array_declarator_read_from_frame(param\declarator, frame, 0, 0, 0, 1, "trans L2 error: [] parameter expects [@...] type name [dimensions...]", "trans L2 error: [] parameter expects [@...] type name [dimensions...]", "trans L2 error: [] parameter expects [@...] type name [dimensions...]") != 0
        return: 1

    param\declarator\allow_empty_dimensions: 1
    param\declarator\atom_dimensions_only: 1
    if: lm_trans_array_formal_param_type_info(param, @ element_type_node, @ rank, @ pointer_depth) = 0
        return: 1

    element_type: lm_trans_expr_callable_type_new()
    if: element_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(element_type)
    if: lm_trans_l4_callable_type_from_node(element_type_node, element_type) = 0 || pointer_depth > c.SIZE_MAX - element_type\address_depth - 1U
        c.fprintf(c.stderr, "trans L2 error: [] parameter has an invalid element type\n")
        return: 1

    outer_const: param\type\is_const
    param\type\class_name[0]: element_type\class_name[0]
    param\type\address_depth: 1U + pointer_depth + element_type\address_depth
    param\type\array_rank: rank
    param\type\is_const: outer_const || element_type\is_const
return: 0

fn: lm_trans_formal_param_read_into (
    LmTransFormalParam: param
    const: LmP0Node: node
) int
    const: LmP0Frame: frame
    int: has_name
    const: LmP0Field: value_first

    if: param = 0 || node = 0
        return: 1

    value_first: 0
    if: lm_trans_formal_param_read(node, param\type, param\name, @ has_name, @ value_first) = 0
        return: 1

    frame: 0
    lm_trans_formal_param_terminal_frame(node, @ frame)

    param\source_node: node
    param\terminal_frame: frame
    param\value_first: value_first
    param\has_name: has_name
    param\is_array: frame != 0 && lm_trans_text_is_array_receiver_head(frame\head)
    if: param\is_array && lm_trans_formal_param_read_array_declarator(param, frame) != 0
        return: 1
    if: param\is_array
        param\name[0]: param\declarator\name[0]
        param\has_name: 1
return: 0

fn: lm_trans_formal_param_list_new (size_t: count) LmTransFormalParamList
    LmTransFormalParamList: list
    size_t: index

    list: (cast: (LmTransFormalParamList) lm_own_new_zero(c.sizeof(list[0])))
    if: list = 0
        return: 0

    list\count: count
    if: count = 0U
        return: list

    list\params: (cast: (@: LmTransFormalParam) lm_own_new_zero(c.sizeof(list\params[0]) * count))
    if: list\params = 0
        lm_trans_formal_param_list_delete(list)
        return: 0

    index: 0U
    while: index < count
        list\params[index]: lm_trans_formal_param_new()
        if: list\params[index] = 0
            lm_trans_formal_param_list_delete(list)
            return: 0
        index: index + 1U
return: list

sub: lm_trans_formal_param_list_delete (LmTransFormalParamList: list)
    size_t: index

    if: list != 0
        index: 0U
        while: index < list\count
            lm_trans_formal_param_delete(list\params[index])
            index: index + 1U
        lm_own_delete(list\params, 0)
        list\params: 0
        list\count: 0U
    lm_own_delete(list, 0)
end: lm_trans_formal_param_list_delete

fn: lm_trans_formal_param_list_present_count (const: LmP0Structure: structure) size_t
    const: LmP0Field: field
    size_t: count

    count: 0U
    if: structure = 0
        return: 0U

    field: structure\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            count: count + 1U
        field: field\next
return: count

fn: lm_trans_formal_param_list_from_structure (
    const: LmP0Structure: structure
    int: allow_unnamed
    const: @(char error_name)
) LmTransFormalParamList
    const: LmP0Field: field
    LmTransFormalParamList: list
    LmTransFormalParam: param
    size_t: index
    const: @: char label

    label: error_name
    if: label = 0
        label: "formal parameter list"

    if: structure = 0
        c.fprintf(c.stderr, "trans L2 error: %s expects a parameter Structure\n", label)
        return: 0

    list: lm_trans_formal_param_list_new(lm_trans_formal_param_list_present_count(structure))
    if: list = 0
        return: 0

    index: 0U
    field: structure\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value)
            field: field\next
            continue
        ---

        param: list\params[index]
        if: lm_trans_formal_param_read_into(param, field\value) != 0
            c.fprintf(c.stderr, "trans L2 error: %s parameter %zu has unsupported descriptor\n", label, index)
            lm_trans_formal_param_list_delete(list)
            return: 0
        if: allow_unnamed = 0 && param\has_name = 0
            c.fprintf(c.stderr, "trans L2 error: %s parameter %zu must expose a binding name\n", label, index)
            lm_trans_formal_param_list_delete(list)
            return: 0
        index: index + 1U
        field: field\next
return: list

fn: lm_trans_formal_param_list_from_node (
    const: LmP0Node: params
    int: allow_unnamed
    const: @(char error_name)
) LmTransFormalParamList
    const: @: char label

    label: error_name
    if: label = 0
        label: "formal parameter list"

    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE
        c.fprintf(c.stderr, "trans L2 error: %s expects a parameter Structure\n", label)
        return: 0
return: lm_trans_formal_param_list_from_structure(params\as\structure, allow_unnamed, label)

fn: lm_trans_namespace_set_signature (
    LmTransNamespace: namespace_
    const: LmP0Text: name
    const: LmP0Frame: function_frame
) int
    LmTransSymbol: symbol
    const: LmP0Field: params_field
    LmTransFormalParamList: params
    LmTransFormalParam: param
    LmOwnPtrStack: param_names
    LmP0Text: param_name_ref
    LmP0Text: existing_param_name_ref
    size_t: index
    size_t: i
    int: allow_unnamed_params

    if: namespace_ = 0 || name = 0 || function_frame = 0
        return: 1

    symbol: lm_trans_namespace_find_mutable(namespace_, name)
    if: symbol = 0
        return: 1

    params_field: lm_trans_nth_field(function_frame\body, 1U)
    if: params_field = 0 || params_field\value = 0 || params_field\value\kind != c.LM_P0_NODE_STRUCTURE
        c.fprintf(c.stderr, "trans L2 error: fn/sub expects a parameter Structure\n")
        return: 1

    param_names: lm_trans_ptr_stack_new(lm_trans_text_ref_delete_any)
    if: param_names = 0
        return: 1
    finally: lm_trans_ptr_stack_delete(@ param_names)

    allow_unnamed_params: lm_trans_symbol_is(symbol, "callableDescriptor")
    params: lm_trans_formal_param_list_from_node(params_field\value, allow_unnamed_params, "function signature")
    if: params = 0
        return: 1
    finally: lm_trans_formal_param_list_delete(params)

    index: 0U
    while: index < params\count
        param: params\params[index]
        i: 0U
        while: i < index
            param_name_ref: (cast: (LmP0Text) lm_own_ptr_stack_at(param_names, i))
            if: param\name\length != 0U && param_name_ref != 0 && lm_trans_identifier_same(param_name_ref, param\name)
                c.fprintf(c.stderr, "trans L2 error: duplicate function parameter name\n")
                return: 1
            i: i + 1U

        param_name_ref: lm_trans_text_ref_new(param\name)
        if: param_name_ref = 0
            return: 1
        if: lm_own_ptr_stack_push(param_names, param_name_ref) != 0
            lm_trans_text_ref_delete_any(param_name_ref)
            return: 1
        index: index + 1U

    if: symbol\has_signature
        if: symbol\param_names = 0 || symbol\param_names\count != param_names\count
            c.fprintf(c.stderr, "trans L2 error: os-imported function signatures must match\n")
            return: 1
        i: 0U
        while: i < param_names\count
            existing_param_name_ref: (cast: (LmP0Text) lm_own_ptr_stack_at(symbol\param_names, i))
            param_name_ref: (cast: (LmP0Text) lm_own_ptr_stack_at(param_names, i))
            if: existing_param_name_ref = 0 || param_name_ref = 0 || lm_trans_identifier_same(existing_param_name_ref, param_name_ref) = 0
                c.fprintf(c.stderr, "trans L2 error: os-imported function signatures must match\n")
                return: 1
            i: i + 1U
        return: 0

    lm_trans_ptr_stack_delete(@ symbol\param_names)
    symbol\param_names: param_names
    param_names: 0
    symbol\has_signature: 1
return: 0

fn: lm_trans_namespace_set_callable_shape (
    LmTransNamespace: namespace_
    const: LmTransFunctionHeader: function
) int
    LmTransSymbol: symbol

    if: namespace_ = 0 || function = 0
        return: 1
    if: lm_trans_namespace_set_signature(namespace_, function\name, function\frame) != 0
        return: 1

    symbol: lm_trans_namespace_find_mutable(namespace_, function\name)
    if: symbol = 0
        return: 1

    symbol\callable_params_node: function\params_node
    symbol\callable_return_node: function\return_node
    symbol\has_callable_shape: 1
    symbol\callable_returns_value: function\is_sub = 0
    symbol\callable_is_struct_return: function\is_struct_return
    symbol\callable_is_external: function\is_external
    symbol\callable_has_thread_context: function\has_thread_context
    symbol\callable_is_thread_handler: function\is_thread_handler
    symbol\callable_throws_node: function\throws_node
    symbol\callable_frame: function\frame
return: 0

fn: lm_trans_function_header_read_params (LmTransFunctionHeader: function) int
    int: allow_unnamed

    if: function = 0
        return: 1

    lm_trans_formal_param_list_delete(function\params)
    function\params: 0

    allow_unnamed: function\is_descriptor_only || function\is_callable_descriptor
    function\params: lm_trans_formal_param_list_from_node(function\params_node, allow_unnamed, "function parameters")
    if: function\params = 0
        return: 1
return: 0

fn: lm_trans_throw_name_code (const: (LmP0Text: name)) int
    size_t: index
    LmP0Text: stored
    LmP0Text: copy

    if: name = 0
        return: 0
    if: lm_trans_throw_names = 0
        lm_trans_throw_names: lm_trans_ptr_stack_new(lm_trans_text_ref_delete_any)
        if: lm_trans_throw_names = 0
            return: 0
        ---
    ---

    index: 0U
    while: index < lm_trans_throw_names\count
        stored: lm_own_ptr_stack_at(lm_trans_throw_names, index)
        if: stored != 0 && lm_trans_text_same(stored, name)
            return: (cast: int index) + 1
        index: index + 1U

    copy: lm_trans_text_ref_new(name)
    if: copy = 0
        return: 0
    if: lm_own_ptr_stack_push(lm_trans_throw_names, copy) != 0
        lm_trans_text_ref_delete_any(copy)
        return: 0
return: (cast: int lm_trans_throw_names\count)

fn: lm_trans_throws_contains (const: (LmP0Node: throws_node); const: (LmP0Text: name)) int
    const: LmP0Field: field
    const: LmP0Node: node

    if: throws_node = 0 || name = 0 || throws_node\kind != c.LM_P0_NODE_FRAME || throws_node\as\frame = 0 || throws_node\as\frame\body = 0
        return: 0

    field: throws_node\as\frame\body\first_field
    while: field != 0
        node: field\value
        if: node != 0 && node\kind = c.LM_P0_NODE_ATOM && lm_trans_text_same(node\as\atom, name)
            return: 1
        field: field\next
return: 0

fn: lm_trans_function_header_take_throws (LmTransFunctionHeader: out) int
    const: LmP0Field: field
    const: LmP0Node: node
    const: LmP0Field: name_field
    const: LmP0Node: name_node

    if: out = 0 || out\body_start = 0
        return: 0

    field: out\body_start
    node: field\value
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as\frame = 0 || lm_trans_text_equals(node\as\frame\head, "throws") = 0
        return: 0

    if: node\as\frame\body = 0 || node\as\frame\body\first_field = 0
        c.fprintf(c.stderr, "trans L2 error: throws receiver expects names\n")
        return: 1

    name_field: node\as\frame\body\first_field
    while: name_field != 0
        name_node: name_field\value
        if: name_node = 0 || name_node\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: throws lists names, not types\n")
            return: 1
        if: lm_trans_throw_name_code(name_node\as\atom) = 0
            return: 1
        name_field: name_field\next

    out\throws_node: node
    out\body_start: field\next
return: 0

fn: lm_trans_function_header_common (
    const: LmP0Frame: frame
    int: is_external
    LmTransFunctionHeader: out
    int: is_sub
    int: is_struct_return
    int: is_callable_descriptor
) int
    const: LmP0Field: name_field
    const: LmP0Field: params_field
    const: LmP0Field: return_field
    const: LmP0Field: body_field
    LmP0Text: name
    LmP0Text: c_name
    LmP0Text: env_type_name

    if: frame = 0 || out = 0
        return: 0

    name_field: lm_trans_nth_field(frame\body, 0U)
    params_field: lm_trans_nth_field(frame\body, 1U)
    if: name_field = 0 || params_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: fn/sub expects name and parameters\n")
        return: -1

    if: lm_trans_function_header_init_fields(out) != 0
        return: -1

    name: out\name
    c_name: out\c_name
    env_type_name: out\env_type_name
    lm_trans_formal_param_list_delete(out\params)
    c.memset(out, 0, c.sizeof(out[0]))
    out\name: name
    out\c_name: c_name
    out\env_type_name: env_type_name
    out\frame: frame
    out\name[0]: name_field\value\as\atom[0]
    if: lm_trans_identifier_payload(out\name, out\c_name) = 0
        return: -1

    out\params_node: params_field\value
    out\symbol_class: "function"
    if: is_sub
        out\symbol_class: "procedure"
    out\is_sub: is_sub
    out\is_struct_return: is_struct_return
    out\is_external: is_external
    out\is_callable_descriptor: is_callable_descriptor
    out\has_thread_context: is_external = 0

    if: is_sub
        body_field: lm_trans_nth_field(frame\body, 2U)
        if: body_field != 0 && body_field\next = 0 && body_field\value != 0 && body_field\value\kind = c.LM_P0_NODE_STRUCTURE
            out\body_start: body_field\value\as\structure\first_field
        else:
            out\body_start: params_field\next
        if: out\body_start = 0
            out\is_descriptor_only: 1
        if: lm_trans_function_header_read_params(out) != 0
            return: -1
        if: lm_trans_function_header_take_throws(out) != 0
            return: -1
        return: 1

    return_field: lm_trans_nth_field(frame\body, 2U)
    if: return_field = 0 || return_field\value = 0
        c.fprintf(c.stderr, "trans L2 error: fn expects return type\n")
        return: -1

    out\return_node: return_field\value
    body_field: lm_trans_nth_field(frame\body, 3U)
    if: body_field != 0 && body_field\next = 0 && body_field\value != 0 && body_field\value\kind = c.LM_P0_NODE_STRUCTURE
        out\body_start: body_field\value\as\structure\first_field
    else:
        out\body_start: return_field\next

    if: is_struct_return = 0 && out\body_start = 0 && (frame\trailer = 0 || lm_trans_text_equals(frame\trailer\spelling, "return") = 0)
        out\symbol_class: "callableDescriptor"
        out\is_descriptor_only: 1
    if: is_callable_descriptor && out\is_descriptor_only = 0
        c.fprintf(c.stderr, "trans L2 error: callable is supported only for descriptor-only fn declarations in this profile\n")
        return: -1
    if: lm_trans_function_header_read_params(out) != 0
        return: -1
    if: lm_trans_function_header_take_throws(out) != 0
        return: -1
return: 1

fn: lm_trans_receiver_fn (
    const: LmP0Frame: frame
    int: is_external
    LmTransFunctionHeader: out
) int
return: lm_trans_function_header_common(frame, is_external, out, 0, 0, 0)

fn: lm_trans_receiver_callable (
    const: LmP0Frame: frame
    int: is_external
    LmTransFunctionHeader: out
) int
return: lm_trans_function_header_common(frame, is_external, out, 0, 0, 1)

fn: lm_trans_receiver_fm (
    const: LmP0Frame: frame
    int: is_external
