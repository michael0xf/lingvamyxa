fn: lm_trans_c_array_postfix_index_count (
    const: LmP0Field: storage_field
    const: LmP0Field: stop
    @: size_t out_count
    const: @(LmP0Field out_end)
) int
    const: LmP0Field: field
    size_t: depth
    size_t: count

    if: out_count != 0
        out_count[0]: 0U
    if: out_end != 0
        out_end[0]: storage_field
    if: storage_field = 0 || out_count = 0 || out_end = 0
        return: 1
    field: storage_field\next
    count: 0U
    while: field != 0 && field != stop && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(field\value\as\atom, "[")
        depth: 1U
        field: field\next
        while: field != 0 && field != stop && depth != 0U
            if: field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(field\value\as\atom, "[")
                depth: depth + 1U
            if: field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(field\value\as\atom, "]")
                depth: depth - 1U
            field: field\next
        if: depth != 0U
            return: 1
        count: count + 1U
    out_count[0]: count
    out_end[0]: field
return: 0

fn: lm_trans_runtime_table_indexed_field_type (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
) int
    const: LmP0Field: range_first
    const: LmP0Field: range_stop
    const: LmP0Field: root
    const: LmP0Field: field_follow
    const: LmP0Field: member
    const: LmP0Field: indexed_end
    const: LmTransDescriptor: descriptor
    const: LmTransDescriptorField: descriptor_field
    @: char descriptor_field_name
    size_t: effective_depth
    size_t: index_count
    size_t: member_index_count
    size_t: prefix_dereference_count
    size_t: rank

    if: first = 0 || namespace_ = 0 || out_type = 0
        return: 0

    range_first: first
    range_stop: stop
    while: range_first != 0 && range_first != range_stop && range_first\next = range_stop && range_first\value != 0 && range_first\value\kind = c.LM_P0_NODE_STRUCTURE
        range_first: range_first\value\as\structure\first_field
        range_stop: 0
    ---
    prefix_dereference_count: 0U
    while: range_first != 0 && range_first != range_stop && range_first\value != 0 && range_first\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(range_first\value\as\atom, "\\")
        prefix_dereference_count: prefix_dereference_count + 1U
        range_first: range_first\next
    ---
    root: range_first
    if: root = 0 || root = range_stop || root\value = 0 || root\value\kind != c.LM_P0_NODE_ATOM
        return: 0

    rank: lm_trans_namespace_value_array_reference_rank(namespace_, root\value\as\atom)
    descriptor: lm_trans_namespace_descriptor(namespace_, root\value\as\atom)
    if: rank = 0U || descriptor = 0 || descriptor\has_structural_fields = 0 || lm_trans_descriptor_class_relation_value(descriptor, "lm.trans.table-runtime-read-only") = 0
        return: 0
    if: lm_trans_c_array_postfix_index_count(root, range_stop, @ index_count, @ field_follow) != 0
        return: 0
    if: index_count != rank
        if: index_count = 0U
            return: 0
        if: field_follow != 0 && field_follow != range_stop && field_follow\value != 0 && field_follow\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(field_follow\value\as\atom, "\\")
            c.fprintf(c.stderr, "trans L2 Table type error: row field-follow requires exactly %zu index operation(s)\n", rank)
            return: -1
        ---
        return: 0
    ---
    if: field_follow = 0 || field_follow = range_stop || field_follow\value = 0 || field_follow\value\kind != c.LM_P0_NODE_ATOM || lm_trans_text_equals(field_follow\value\as\atom, "\\") = 0
        return: 0
    while: field_follow != 0 && field_follow != range_stop
        if: field_follow\value = 0 || field_follow\value\kind != c.LM_P0_NODE_ATOM || lm_trans_text_equals(field_follow\value\as\atom, "\\") = 0
            return: 0
        member: field_follow\next
        if: member = 0 || member = range_stop || member\value = 0 || member\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 Table type error: indexed row field-follow expects a field name\n")
            return: -1

        descriptor_field_name: lm_trans_descriptor_name_copy(member\value\as\atom)
        if: descriptor_field_name = 0
            return: -1
        descriptor_field: lm_trans_descriptor_structural_field(descriptor, descriptor_field_name)
        lm_own_delete(descriptor_field_name, 0)
        if: descriptor_field = 0 || descriptor_field\is_union || descriptor_field\descriptor_name = 0
            c.fprintf(c.stderr, "trans L2 Table type error: indexed row has no field \"%.*s\"\n", (cast: int member\value\as\atom\length), member\value\as\atom\data)
            return: -1
        if: lm_trans_named_structure_type_set_cstr(out_type, descriptor_field\descriptor_name, descriptor_field\address_depth, descriptor_field\is_const) = 0
            return: -1

        if: lm_trans_c_array_postfix_index_count(member, range_stop, @ member_index_count, @ indexed_end) != 0
            return: 0
        effective_depth: lm_trans_effective_address_depth(out_type\class_name, out_type\address_depth, namespace_)
        if: member_index_count > effective_depth || member_index_count > out_type\address_depth
            return: 0
        out_type\address_depth: out_type\address_depth - member_index_count
        if: indexed_end = range_stop
            if: prefix_dereference_count > out_type\address_depth
                c.fprintf(c.stderr, "trans L2 Table type error: indexed field expression has too many prefix dereferences\n")
                return: -1
            out_type\address_depth: out_type\address_depth - prefix_dereference_count
            return: 1
        if: indexed_end = 0
            return: 0
        if: indexed_end\value = 0 || indexed_end\value\kind != c.LM_P0_NODE_ATOM || lm_trans_text_equals(indexed_end\value\as\atom, "\\") = 0
            return: 0
        if: effective_depth - member_index_count != 1U
            c.fprintf(c.stderr, "trans L2 Table type error: field-follow requires exactly one remaining address level after indexing\n")
            return: -1
        descriptor: lm_trans_namespace_descriptor(namespace_, out_type\class_name)
        if: descriptor = 0 || descriptor\has_structural_fields = 0
            return: 0
        field_follow: indexed_end
    ---
return: 0

fn: lm_trans_guard_runtime_table_indexed_field_range (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
    const: LmP0Text: expected_class
    size_t: expected_address_depth
    int: expected_base_is_const
    const: @(char context)
) int
    const: @: char effective_context
    LmTransL4CallableType: actual_type
    size_t: actual_depth
    size_t: expected_depth
    int: status

    actual_type: lm_trans_expr_callable_type_new()
    if: actual_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(actual_type)
    status: lm_trans_runtime_table_indexed_field_type(first, stop, namespace_, actual_type)
    if: status < 0
        return: 1
    if: status = 0
        return: 0

    actual_depth: lm_trans_effective_address_depth(actual_type\class_name, actual_type\address_depth, namespace_)
    expected_depth: lm_trans_effective_address_depth(expected_class, expected_address_depth, namespace_)
    if: (actual_depth = 0U) = (expected_depth = 0U)
        if: actual_depth = 0U && (lm_trans_symbol_is(lm_trans_namespace_find(namespace_, actual_type\class_name), "callableDescriptor") || lm_trans_symbol_is(lm_trans_namespace_find(namespace_, expected_class), "callableDescriptor"))
            if: lm_trans_identifier_same(actual_type\class_name, expected_class)
                return: 0
            ---
        else:
            if: actual_depth = 0U || lm_trans_raw_pointer_type_compatible(actual_type\class_name, actual_type\address_depth, actual_type\is_const, expected_class, expected_address_depth, expected_base_is_const, namespace_)
                return: 0
            ---
        ---
    ---

    effective_context: "typed value"
    if: context != 0
        effective_context: context
    c.fprintf(c.stderr, "trans L2 type error: %s cannot consume this indexed runtime Table field at the required type, address depth, or const qualification\n", effective_context)
return: 1

fn: lm_trans_validate_c_array_postfix_index_ranges (
    const: LmP0Field: storage_field
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: close_field
    const: LmP0Field: field
    const: LmP0Field: index_first
    size_t: depth

    if: storage_field = 0
        return: 1
    field: storage_field\next
    while: field != 0 && field != stop && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(field\value\as\atom, "[")
        index_first: field\next
        close_field: index_first
        depth: 1U
        while: close_field != 0 && close_field != stop && depth != 0U
            if: close_field\value != 0 && close_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(close_field\value\as\atom, "[")
                depth: depth + 1U
            if: close_field\value != 0 && close_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(close_field\value\as\atom, "]")
                depth: depth - 1U
            if: depth != 0U
                close_field: close_field\next
        ---
        if: close_field = 0 || close_field = stop || index_first = close_field
            return: 1
        if: lm_trans_guard_c_array_value_range(index_first, close_field, namespace_, 0, 0U, 0, "c.array index expression") != 0
            return: 1
        if: lm_trans_range_has_non_c_array_raw_pointer(index_first, close_field, namespace_) || lm_trans_range_has_direct_array_reference(index_first, close_field, namespace_) || lm_trans_fields_contain_array_reference_data_pointer(index_first, close_field, namespace_)
            c.fprintf(c.stderr, "trans L2 type error: c.array index expression must be a scalar value, not a pointer or ArrayReference\n")
            return: 1
        ---
        field: close_field\next
return: 0

fn: lm_trans_c_array_range_result_info (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
    @: size_t out_depth
    @: int out_base_is_const
    LmP0Text: out_class
) int
    const: LmP0Field: field
    const: LmP0Field: range_first
    const: LmP0Field: range_stop
    const: LmP0Field: root
    size_t: address_count
    size_t: dereference_count
    size_t: element_depth
    size_t: index_count
    size_t: rank

    if: out_depth != 0
        out_depth[0]: 0U
    if: out_base_is_const != 0
        out_base_is_const[0]: 0
    if: out_class != 0
        out_class\data: ""
        out_class\length: 0U
    if: first = 0 || out_depth = 0 || out_base_is_const = 0
        return: 0

    range_first: first
    range_stop: stop
    while: range_first != 0 && range_first != range_stop && range_first\next = range_stop && range_first\value != 0 && range_first\value\kind = c.LM_P0_NODE_STRUCTURE
        range_first: range_first\value\as\structure\first_field
        range_stop: 0
    if: range_first = 0
        return: 0

    address_count: 0U
    dereference_count: 0U
    field: range_first
    while: field != 0 && field != range_stop && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && (lm_trans_text_equals(field\value\as\atom, "@") || lm_trans_text_equals(field\value\as\atom, "\\"))
        if: lm_trans_text_equals(field\value\as\atom, "@")
            address_count: address_count + 1U
        else:
            dereference_count: dereference_count + 1U
        field: field\next
    root: field
    if: root = 0 || root = range_stop || root\value = 0 || root\value\kind != c.LM_P0_NODE_ATOM || lm_trans_namespace_value_is_c_array_storage(namespace_, root\value\as\atom) = 0
        return: 0

    rank: lm_trans_namespace_value_c_array_rank(namespace_, root\value\as\atom)
    element_depth: lm_trans_namespace_value_c_array_element_address_depth(namespace_, root\value\as\atom)
    if: rank = 0U
        return: -1
    if: lm_trans_validate_c_array_postfix_index_ranges(root, range_stop, namespace_) != 0
        return: -2
    if: lm_trans_c_array_postfix_index_count(root, range_stop, @ index_count, @ field) != 0
        return: -1
    if: field != range_stop
        return: -1
    if: address_count != 0U && index_count < rank
        return: -1
    if: index_count < rank
        if: rank - index_count != 1U
            return: -1
        out_depth[0]: element_depth + 1U
    else:
        if: index_count - rank > element_depth
            return: -1
        out_depth[0]: element_depth - (index_count - rank)
    ---
    if: out_depth[0] + address_count < dereference_count
        return: -1
    out_depth[0]: out_depth[0] + address_count - dereference_count
    out_base_is_const[0]: lm_trans_namespace_value_c_array_element_is_const(namespace_, root\value\as\atom)
    if: out_class != 0
        lm_trans_namespace_relation_text_for_latest_binding(namespace_, root\value\as\atom, "variable.type", out_class)
return: 1

fn: lm_trans_c_array_compound_operands_are_scalar (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    const: LmP0Field: chain_end
    const: LmP0Field: previous
    const: LmP0Node: node
    size_t: effective_depth
    size_t: index_count
    int: base_is_const
    int: category_status
    int: is_array_reference
    int: is_raw_pointer

    previous: 0
    field: first
    while: field != 0 && field != stop
        node: field\value
        if: node != 0 && node\kind = c.LM_P0_NODE_ATOM && lm_trans_namespace_value_is_c_array_storage(namespace_, node\as\atom)
            if: previous != 0 && previous\value != 0 && previous\value\kind = c.LM_P0_NODE_ATOM && (lm_trans_text_equals(previous\value\as\atom, "@") || lm_trans_text_equals(previous\value\as\atom, "\\"))
                return: 0
            if: lm_trans_c_array_postfix_index_count(field, stop, @ index_count, @ chain_end) != 0
                return: 0
            if: chain_end != stop && chain_end != 0 && chain_end\value != 0 && chain_end\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(chain_end\value\as\atom, "\\")
                return: 0
            category_status: lm_trans_c_array_range_result_info(field, chain_end, namespace_, @ effective_depth, @ base_is_const, 0)
            if: category_status != 1 || effective_depth != 0U
                return: 0
            previous: field
            field: chain_end
            continue
        ---
        if: node != 0 && node\kind = c.LM_P0_NODE_FRAME
            if: lm_trans_callable_frame_result_storage_category(node\as\frame, namespace_, @ is_array_reference, @ is_raw_pointer) = 0 && lm_trans_node_has_direct_c_array_storage(node, namespace_)
                return: 0
            ---
        if: node != 0 && node\kind = c.LM_P0_NODE_STRUCTURE && lm_trans_c_array_compound_operands_are_scalar(node\as\structure\first_field, 0, namespace_) = 0
            return: 0
        previous: field
        field: field\next
return: 1

fn: lm_trans_raw_pointer_range_result_info (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
    @: size_t out_depth
    @: int out_base_is_const
    LmP0Text: out_class
) int
    const: LmP0Field: field
    const: LmP0Field: range_first
    const: LmP0Field: range_stop
    const: LmP0Field: root
    size_t: address_count
    size_t: dereference_count
    size_t: index_count
    size_t: root_depth

    if: out_depth != 0
        out_depth[0]: 0U
    if: out_base_is_const != 0
        out_base_is_const[0]: 0
    if: out_class != 0
        out_class\data: ""
        out_class\length: 0U
    if: first = 0 || out_depth = 0 || out_base_is_const = 0
        return: 0

    range_first: first
    range_stop: stop
    while: range_first != 0 && range_first != range_stop && range_first\next = range_stop && range_first\value != 0 && range_first\value\kind = c.LM_P0_NODE_STRUCTURE
        range_first: range_first\value\as\structure\first_field
        range_stop: 0
    if: range_first = 0
        return: 0

    address_count: 0U
    dereference_count: 0U
    field: range_first
    while: field != 0 && field != range_stop && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && (lm_trans_text_equals(field\value\as\atom, "@") || lm_trans_text_equals(field\value\as\atom, "\\"))
        if: lm_trans_text_equals(field\value\as\atom, "@")
            address_count: address_count + 1U
        else:
            dereference_count: dereference_count + 1U
        field: field\next
    root: field
    if: root = 0 || root = range_stop || root\value = 0 || root\value\kind != c.LM_P0_NODE_ATOM || lm_trans_namespace_value_is_c_array_storage(namespace_, root\value\as\atom)
        return: 0
    root_depth: lm_trans_namespace_value_raw_pointer_depth(namespace_, root\value\as\atom)
    if: root_depth = 0U || lm_trans_c_array_postfix_index_count(root, range_stop, @ index_count, @ field) != 0 || field != range_stop
        return: 0
    if: index_count > root_depth || root_depth - index_count + address_count < dereference_count
        return: -1
    out_depth[0]: root_depth - index_count + address_count - dereference_count
    out_base_is_const[0]: lm_trans_namespace_value_raw_pointer_base_is_const(namespace_, root\value\as\atom)
    if: out_class != 0
        lm_trans_namespace_relation_text_for_latest_binding(namespace_, root\value\as\atom, "variable.type", out_class)
return: 1

fn: lm_trans_guard_known_raw_pointer_range (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
    const: LmP0Text: expected_class
    size_t: expected_address_depth
    int: expected_base_is_const
    const: @(char context)
) int
    const: LmP0Node: candidate_node
    const: LmTransSymbol: candidate_symbol
    const: @: char effective_context
    LmTransL4CallableType: candidate_type
    LmP0Text: candidate_class
    size_t: candidate_depth
    int: candidate_base_is_const
    int: candidate_status
    int: candidate_type_status

    effective_context: "typed value"
    if: context != 0
        effective_context: context

    if: lm_trans_guard_runtime_table_indexed_field_range(first, stop, namespace_, expected_class, expected_address_depth, expected_base_is_const, effective_context) != 0
        return: 1

    candidate_node: 0
    if: first != 0 && first != stop && first\next = stop
        candidate_node: lm_trans_transparent_parenthesized_node(first\value)
    candidate_symbol: 0
    if: candidate_node != 0 && candidate_node\kind = c.LM_P0_NODE_FRAME
        candidate_symbol: lm_trans_namespace_find(namespace_, candidate_node\as\frame\head)
    if: candidate_symbol != 0 && lm_trans_symbol_is_executable_callable(candidate_symbol)
        candidate_type: lm_trans_expr_callable_type_new()
        if: candidate_type = 0
            return: 1
        candidate_type_status: lm_trans_node_result_type(candidate_node, namespace_, candidate_type)
        if: candidate_type_status < 0
            lm_trans_expr_callable_type_delete(candidate_type)
            return: 1
        if: candidate_type_status > 0 && candidate_type\array_rank = 0U && candidate_type\address_depth != 0U
            if: lm_trans_raw_pointer_type_compatible(candidate_type\class_name, candidate_type\address_depth, candidate_type\is_const, expected_class, expected_address_depth, expected_base_is_const, namespace_)
                lm_trans_expr_callable_type_delete(candidate_type)
                return: 0
            c.fprintf(c.stderr, "trans L2 type error: %s cannot consume this callable raw pointer result at the required type, address depth, or const qualification\n", effective_context)
            lm_trans_expr_callable_type_delete(candidate_type)
            return: 1
        ---
        lm_trans_expr_callable_type_delete(candidate_type)
    ---

    candidate_class: lm_trans_statement_text_new()
    if: candidate_class = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ candidate_class)

    candidate_status: lm_trans_raw_pointer_range_result_info(first, stop, namespace_, @ candidate_depth, @ candidate_base_is_const, candidate_class)
    if: candidate_status = 0
        return: 0
    if: candidate_status = 1 && candidate_depth = 0U && expected_address_depth = 0U && (expected_class = 0 || expected_class\length = 0U || candidate_class\length = 0U || lm_trans_identifier_same(candidate_class, expected_class))
        return: 0
    if: candidate_status = 1 && lm_trans_raw_pointer_type_compatible(candidate_class, candidate_depth, candidate_base_is_const, expected_class, expected_address_depth, expected_base_is_const, namespace_)
        return: 0

    c.fprintf(c.stderr, "trans L2 type error: %s cannot consume this raw pointer expression at the required type, address depth, or const qualification\n", effective_context)
return: 1

fn: lm_trans_guard_c_array_value_range (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
    const: LmP0Text: expected_class
    size_t: expected_address_depth
    int: expected_base_is_const
    const: @(char context)
) int
    const: @: char effective_context
    LmP0Text: candidate_class
    size_t: candidate_depth
    int: candidate_base_is_const
    int: category_status
    int: has_c_array

    has_c_array: lm_trans_range_has_direct_c_array_storage(first, stop, namespace_)
    candidate_class: lm_trans_statement_text_new()
    if: candidate_class = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ candidate_class)

    if: has_c_array
        category_status: lm_trans_c_array_range_result_info(first, stop, namespace_, @ candidate_depth, @ candidate_base_is_const, candidate_class)
    else:
        category_status: lm_trans_raw_pointer_range_result_info(first, stop, namespace_, @ candidate_depth, @ candidate_base_is_const, candidate_class)
        if: category_status = 0
            return: 0
        if: (expected_class = 0 || lm_trans_text_equals(expected_class, "LmSlice") = 0) && lm_trans_text_equals(candidate_class, "LmSlice") = 0
            return: 0
    ---
    if: has_c_array && category_status = 1 && candidate_depth != 0U && expected_address_depth != 0U && lm_trans_raw_pointer_type_compatible(candidate_class, candidate_depth, candidate_base_is_const, expected_class, expected_address_depth, expected_base_is_const, namespace_)
        return: 0
    if: category_status = 1 && candidate_depth = expected_address_depth && (expected_class = 0 || expected_class\length = 0U || candidate_class\length = 0U || lm_trans_identifier_same(candidate_class, expected_class)) && (candidate_depth = 0U || candidate_base_is_const = 0 || expected_base_is_const)
        return: 0
    if: category_status = -2
        return: 1
    if: has_c_array && category_status <= 0 && expected_address_depth = 0U && lm_trans_c_array_compound_operands_are_scalar(first, stop, namespace_)
        return: 0
    effective_context: "typed value"
    if: context != 0
        effective_context: context
    if: has_c_array
        c.fprintf(c.stderr, "trans L2 type error: %s cannot consume this c.array expression at the required type, address depth, or const qualification\n", effective_context)
    else:
        c.fprintf(c.stderr, "trans L2 type error: %s cannot consume this raw pointer expression at the required type, address depth, or const qualification\n", effective_context)
return: 1

fn: lm_trans_guard_array_reference_range (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
    int: required
    const: @(char context)
) int
    const: LmP0Field: field
    const: LmP0Node: node
    const: @: char effective_context
    LmP0Text: candidate_class
    size_t: candidate_depth
    int: candidate_base_is_const
    int: candidate_status

    if: required = 0
        return: 0
    effective_context: "typed value"
    if: context != 0
        effective_context: context

    if: lm_trans_range_is_direct_array_reference_address(first, stop, namespace_) || lm_trans_fields_contain_array_reference_address(first, stop, namespace_)
        c.fprintf(c.stderr, "trans L2 type error: %s requires an ArrayReference value, not the address of an ArrayReference slot\n", effective_context)
        return: 1

    if: lm_trans_range_is_array_reference_data_pointer(first, stop, namespace_) || lm_trans_fields_contain_array_reference_data_pointer(first, stop, namespace_)
        c.fprintf(c.stderr, "trans L2 type error: %s requires an ArrayReference value, not its raw data pointer\n", effective_context)
        return: 1

    candidate_class: lm_trans_statement_text_new()
    if: candidate_class = 0
        return: 1
    candidate_status: lm_trans_raw_pointer_range_result_info(first, stop, namespace_, @ candidate_depth, @ candidate_base_is_const, candidate_class)
    if: candidate_status = 1 && candidate_depth = 0U && lm_trans_text_equals(candidate_class, "LmSlice")
        lm_trans_text_ref_destroy(@ candidate_class)
        return: 0
    lm_trans_text_ref_destroy(@ candidate_class)
    if: candidate_status != 0
        c.fprintf(c.stderr, "trans L2 type error: %s requires an ArrayReference; raw pointer/storage requires an explicit adapter\n", effective_context)
        return: 1

    if: lm_trans_range_has_direct_raw_pointer(first, stop, namespace_)
        c.fprintf(c.stderr, "trans L2 type error: %s requires an ArrayReference; raw pointer/storage requires an explicit adapter\n", effective_context)
        return: 1

    field: first
    if: field != 0 && field != stop && field\next = stop
        node: field\value
        if: node != 0 && node\kind = c.LM_P0_NODE_ATOM && lm_trans_namespace_value_is_array_reference(namespace_, node\as\atom) = 0
            c.fprintf(c.stderr, "trans L2 type error: %s requires an ArrayReference\n", effective_context)
            return: 1
        ---
    ---
return: 0

fn: lm_trans_guard_array_reference_shape_range (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
    const: LmP0Text: expected_element_class
    size_t: expected_rank
    size_t: expected_element_address_depth
    int: expected_element_is_const
    const: @(char context)
) int
    const: LmP0Node: candidate_node
    const: @: char effective_context
    LmP0Text: candidate_element_class
    LmTransL4CallableType: candidate_type
    size_t: candidate_rank
    size_t: candidate_element_address_depth
    int: candidate_element_is_const
    int: candidate_type_status
    int: known_shape
    const: @: char candidate_const_text
    const: @: char expected_const_text

    if: expected_rank = 0U
        return: 0
    effective_context: "typed ArrayReference"
    if: context != 0
        effective_context: context

    candidate_node: 0
    if: first != 0 && first != stop && first\next = stop
        candidate_node: lm_trans_transparent_parenthesized_node(first\value)

    candidate_element_class: lm_trans_statement_text_new()
    if: candidate_element_class = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ candidate_element_class)
    candidate_rank: 0U
    candidate_element_address_depth: 0U
    candidate_element_is_const: 0
    known_shape: 0

    if: candidate_node != 0 && candidate_node\kind = c.LM_P0_NODE_ATOM && lm_trans_namespace_value_is_array_reference(namespace_, candidate_node\as\atom)
        candidate_rank: lm_trans_namespace_value_array_reference_rank(namespace_, candidate_node\as\atom)
        if: candidate_rank = 0U
            c.fprintf(c.stderr, "trans hosted ArrayReference limitation: %s cannot consume an ArrayReference whose rank and element shape are not statically known\n", effective_context)
            return: 1
        if: lm_trans_namespace_value_array_reference_element_type(namespace_, candidate_node\as\atom, candidate_element_class) = 0
            c.fprintf(c.stderr, "trans L2 internal error: ArrayReference binding has no element-type metadata\n")
            return: 1
        candidate_element_address_depth: lm_trans_namespace_value_array_reference_element_address_depth(namespace_, candidate_node\as\atom)
        candidate_element_is_const: lm_trans_namespace_value_array_reference_element_is_const(namespace_, candidate_node\as\atom)
        known_shape: 1
    ---

    if: known_shape = 0 && candidate_node != 0 && candidate_node\kind = c.LM_P0_NODE_FRAME
        candidate_type: lm_trans_expr_callable_type_new()
        if: candidate_type = 0
            return: 1
        candidate_type_status: lm_trans_node_result_type(candidate_node, namespace_, candidate_type)
        if: candidate_type_status < 0
            lm_trans_expr_callable_type_delete(candidate_type)
            return: 1
        if: candidate_type_status > 0 && (candidate_type\array_rank != 0U || (candidate_type\address_depth = 0U && lm_trans_text_equals(candidate_type\class_name, "LmSlice")))
            if: candidate_type\array_rank = 0U
                c.fprintf(c.stderr, "trans hosted ArrayReference limitation: %s cannot consume a callable ArrayReference result whose rank and element shape are not statically known\n", effective_context)
                lm_trans_expr_callable_type_delete(candidate_type)
                return: 1
            if: candidate_type\address_depth = 0U
                c.fprintf(c.stderr, "trans L2 internal error: callable ArrayReference result has inconsistent rank/address-depth metadata\n")
                lm_trans_expr_callable_type_delete(candidate_type)
                return: 1
            candidate_rank: candidate_type\array_rank
            candidate_element_address_depth: candidate_type\address_depth - 1U
            candidate_element_is_const: candidate_type\is_const
            candidate_element_class[0]: candidate_type\class_name[0]
            known_shape: 1
        ---
        lm_trans_expr_callable_type_delete(candidate_type)
    ---

    if: known_shape = 0
        if: candidate_node != 0 && candidate_node\kind = c.LM_P0_NODE_STRUCTURE
            return: 0
        c.fprintf(c.stderr, "trans hosted ArrayReference limitation: %s requires a candidate whose rank and element shape are statically known\n", effective_context)
        return: 1
    if: candidate_rank != expected_rank || candidate_element_address_depth != expected_element_address_depth || lm_trans_identifier_same(candidate_element_class, expected_element_class) = 0 || (candidate_element_is_const && expected_element_is_const = 0)
        expected_const_text: ""
        candidate_const_text: ""
        if: expected_element_is_const
            expected_const_text: " const"
        if: candidate_element_is_const
            candidate_const_text: " const"
        c.fprintf(c.stderr, "trans L2 ArrayReference type error: %s requires rank %zu element %.*s at address depth %zu%s, but the candidate has rank %zu element %.*s at address depth %zu%s\n", effective_context, expected_rank, (cast: int expected_element_class\length), expected_element_class\data, expected_element_address_depth, expected_const_text, candidate_rank, (cast: int candidate_element_class\length), candidate_element_class\data, candidate_element_address_depth, candidate_const_text)
        return: 1
return: 0

fn: lm_trans_materialize_array_value (
    FILE: file
    LmTransExprStack: stack
    const: LmTransExprSegment: segment
    const: LmTransNamespace: namespace_
    @: int out_consumed
) int
    const: LmP0Structure: value
    LmP0Text: helper_name
    LmP0Text: atom
    LmP0Text: slice_expr
    const: LmTransFormalParam: param
    size_t: expected_element_address_depth
    int: single_atom

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0
        return: 1

    atom: lm_trans_statement_text_new()
    slice_expr: lm_trans_statement_text_new()
    if: atom = 0 || slice_expr = 0
        lm_trans_text_ref_destroy(@ atom)
        lm_trans_text_ref_destroy(@ slice_expr)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ atom)
        lm_trans_text_ref_destroy(@ slice_expr)

    param: 0
    if: segment != 0
        param: segment\expected_param

    single_atom: lm_trans_expr_segment_single_atom(segment, atom)

    if: param != 0 && param\is_array && single_atom && lm_trans_namespace_value_is_c_array_storage(namespace_, atom)
        c.fprintf(c.stderr, "trans L2 type error: array parameter requires an ArrayReference; c.array storage requires an explicit adapter\n")
        return: 1
    ---

    if: param != 0 && param\is_array
        if: param\type = 0 || param\type\address_depth = 0U
            c.fprintf(c.stderr, "trans L2 internal error: array parameter has inconsistent rank/address-depth metadata\n")
            return: 1
        expected_element_address_depth: param\type\address_depth - 1U
        if: lm_trans_guard_array_reference_range(segment\first, segment\stop, namespace_, 1, "array parameter") != 0
            return: 1
        if: lm_trans_guard_array_reference_shape_range(segment\first, segment\stop, namespace_, param\type\class_name, param\type\array_rank, expected_element_address_depth, param\type\is_const, "array parameter") != 0
            return: 1
        ---

    if: single_atom && lm_trans_namespace_relation_text_for_latest_binding(namespace_, atom, "variable.slice-name", slice_expr)
        if: lm_trans_expr_stack_push_text(stack, slice_expr\data) != 0
            return: 1
        out_consumed[0]: 1
        return: 0

    if: param != 0 && param\is_array
        if: single_atom
            return: 0
    ---

    value: lm_trans_expr_segment_single_structure_value(segment)
    if: value = 0
        return: 0

    helper_name: lm_trans_statement_text_new()
    if: helper_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ helper_name)

    if: lm_trans_emit_array_value_helper(file, param, value, namespace_, helper_name) != 0 || lm_trans_expr_stack_push_text(stack, ")") != 0 || lm_trans_expr_stack_push_text(stack, lm_trans_current_thread_name()) != 0 || lm_trans_expr_stack_push_text(stack, "(") != 0 || lm_trans_expr_stack_push_name_text(stack, helper_name) != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_return_name_text (unsigned: id; @: char buffer; size_t: buffer_size; LmP0Text: out_name) int
    int: written

    if: buffer = 0 || buffer_size = 0U || out_name = 0
        return: 1
    written: c.snprintf(buffer, buffer_size, "lm_return_%u", id)
    if: written < 0 || (cast: size_t written) >= buffer_size
        return: 1
    out_name\data: buffer
    out_name\length: (cast: size_t written)
return: 0

fn: lm_trans_emit_fm_result_prologue (
    FILE: file
    const: LmP0Text: function_name
    unsigned: indent
) int
    if: file = 0 || function_name = 0
        return: 1
    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, " *lm_fm_result = (") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*lm_fm_result));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_fm_result == 0) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_typed_value_return_statement (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
    @: int out_consumed
) int
    const: LmP0Structure: structure_value
    LmP0Text: return_name
    c.array: [64]: char return_name_storage
    unsigned: return_id
    int: can_consume
    int: needs_null_check
    int: filled

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0 || namespace_ = 0 || namespace_\return_type_node = 0 || namespace_\return_type_is_struct
        return: 0

    structure_value: lm_trans_fields_single_structure_value(return_fields)
    if: structure_value = 0
        return: 0
    if: lm_trans_type_receiver_structure_value_can_consume(namespace_\return_type_node, structure_value, @ can_consume) != 0
        return: 1
    if: can_consume = 0
        return: 0

    return_name: lm_trans_statement_text_new()
    if: return_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ return_name)

    return_id: namespace_\next_return_id
    namespace_\next_return_id: namespace_\next_return_id + 1U
    if: lm_trans_return_name_text(return_id, return_name_storage, c.sizeof(return_name_storage), return_name) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0
        return: 1
    if: lm_trans_emit_current_return_type(file, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_type_receiver_structure_value_alloc(file, indent + 1U, namespace_\return_type_node, return_name, structure_value, namespace_, out_consumed, @ needs_null_check) != 0
        return: 1
    if: out_consumed[0] = 0
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        return: 0

    if: needs_null_check
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (") != 0
            return: 1
        if: lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, " == 0) {\n") != 0
            return: 1
        if: lm_trans_emit_cleanups_until(file, indent + 2U, namespace_, 0U) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "return 0;\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
    ---

    if: lm_trans_emit_type_receiver_structure_value_fill(file, indent + 1U, namespace_\return_type_node, return_name, structure_value, namespace_, @ filled) != 0
        return: 1
    if: filled = 0
        c.fprintf(c.stderr, "trans L2 error: return type receiver accepted Structure value allocation but not fill\n")
        return: 1

    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return ") != 0
        return: 1
    if: lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

fn: lm_trans_struct_return_field_name_at (
    const: LmP0Structure: descriptor
    size_t: index
    LmP0Text: out_name
) int
    const: LmP0Field: field

    if: descriptor = 0 || out_name = 0
        return: 0

    field: lm_trans_nth_field(descriptor, index)
    if: field = 0 || field\value = 0
        return: 0

return: lm_trans_formal_param_name(field\value, out_name)

fn: lm_trans_struct_return_field_index (
    const: LmP0Structure: descriptor
    const: LmP0Text: name
    @: size_t out_index
) int
    const: LmP0Field: field
    LmP0Text: field_name
    size_t: index

    if: descriptor = 0 || out_index = 0
        return: 0

    field_name: lm_trans_statement_text_new()
    if: field_name = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ field_name)

    index: 0U
    field: descriptor\first_field
    while: field != 0
        if: field\value != 0 && lm_trans_formal_param_name(field\value, field_name) && lm_trans_identifier_same(field_name, name)
            out_index[0]: index
            return: 1
        index: index + 1U
        field: field\next

return: 0

fn: lm_trans_struct_return_field_values_new (size_t: count) @: LmTransStructReturnFieldValue
    @: LmTransStructReturnFieldValue values
    size_t: index

    values: (cast: (@: LmTransStructReturnFieldValue) lm_own_new_zero(c.sizeof(values[0]) * count))
    if: values = 0
        return: 0

    index: 0U
    while: index < count
        values[index]: (cast: (LmTransStructReturnFieldValue) lm_own_new_zero(c.sizeof(values[index][0])))
        if: values[index] = 0
            while: index != 0U
                index: index - 1U
                lm_own_delete(values[index], 0)
            lm_own_delete(values, 0)
            return: 0
        index: index + 1U

return: values

sub: lm_trans_struct_return_field_values_delete (
    @: LmTransStructReturnFieldValue values
    size_t: count
)
    size_t: index

    if: values = 0
        return
    index: 0U
    while: index < count
        lm_own_delete(values[index], 0)
        index: index + 1U
    lm_own_delete(values, 0)
end: lm_trans_struct_return_field_values_delete

fn: lm_trans_struct_return_collect_value_fields (
    const: LmP0Structure: descriptor
    const: LmP0Structure: value
    @: LmTransStructReturnFieldValue fields
    size_t: field_count
) int
    const: LmP0Field: field
    const: LmP0Frame: frame
    size_t: positional_index
    size_t: named_index
    int: positional_disabled
    int: named_in_position

    if: descriptor = 0 || value = 0 || fields = 0
        return: 1

    positional_index: 0U
    positional_disabled: 0
    field: value\first_field
    while: field != 0
        if: field\value = 0
            field: field\next
            continue
        if: lm_trans_node_is_positional_skip(field\value)
            if: positional_disabled
                c.fprintf(c.stderr, "trans L2 error: positional skip after out-of-position named fm return field\n")
                return: 1
            positional_index: positional_index + 1U
            field: field\next
            continue

        if: field\value\kind = c.LM_P0_NODE_FRAME && (field\value\as\frame\flags & c.LM_P0_FRAME_COLON) != 0U && lm_trans_struct_return_field_index(descriptor, field\value\as\frame\head, @ named_index)
            frame: field\value\as\frame
            if: fields[named_index]\present
                c.fprintf(c.stderr, "trans L2 error: duplicate named fm return field\n")
                return: 1
            if: frame\body\first_field = 0
                c.fprintf(c.stderr, "trans L2 error: named fm return field expects a value\n")
                return: 1
            fields[named_index]\first: frame\body\first_field
            fields[named_index]\stop: 0
            fields[named_index]\present: 1
            named_in_position: named_index = positional_index
            if: named_index = positional_index
                positional_index: positional_index + 1U
            if: named_in_position = 0
                positional_disabled: 1
            field: field\next
            continue

        if: positional_disabled
            c.fprintf(c.stderr, "trans L2 error: positional fm return field after out-of-position named field\n")
            return: 1
        if: positional_index >= field_count
            c.fprintf(c.stderr, "trans L2 error: too many positional fm return fields\n")
            return: 1
        if: fields[positional_index]\present
            c.fprintf(c.stderr, "trans L2 error: duplicate positional fm return field\n")
            return: 1
        fields[positional_index]\first: field
        fields[positional_index]\stop: field\next
        fields[positional_index]\present: 1
        positional_index: positional_index + 1U
        field: field\next

return: 0

fn: lm_trans_emit_struct_value_return_statement (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
    @: int out_consumed
) int
    const: LmP0Structure: descriptor
    const: LmP0Structure: value
    @: LmTransStructReturnFieldValue values
    LmP0Text: field_name
    size_t: field_count
    size_t: index

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0 || namespace_ = 0 || namespace_\return_type_is_struct = 0 || namespace_\return_type_node = 0 || namespace_\return_type_node\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

    value: lm_trans_fields_single_structure_value(return_fields)
    if: value = 0
        return: 0

    descriptor: namespace_\return_type_node\as\structure
    field_count: lm_trans_structure_field_count(descriptor)
    if: field_count = 0U
        c.fprintf(c.stderr, "trans L2 error: fm return Structure must not be empty\n")
        return: 1

    field_name: lm_trans_statement_text_new()
    if: field_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ field_name)

    values: lm_trans_struct_return_field_values_new(field_count)
    if: values = 0
        return: 1
    finally: lm_trans_struct_return_field_values_delete(values, field_count)

    if: lm_trans_struct_return_collect_value_fields(descriptor, value, values, field_count) != 0
        return: 1
    index: 0U
    while: index < field_count
        if: values[index]\present = 0
            c.fprintf(c.stderr, "trans L2 error: fm Structure return literal does not fill every return field\n")
            return: 1
        index: index + 1U

    index: 0U
    while: index < field_count
        if: lm_trans_struct_return_field_name_at(descriptor, index, field_name) = 0
            c.fprintf(c.stderr, "trans L2 error: fm return field must expose a binding name\n")
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_fm_result->") != 0 || lm_trans_emit_identifier(file, field_name) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_expr_range(file, values[index]\first, values[index]\stop, namespace_) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        index: index + 1U

    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "return lm_fm_result;\n") != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_current_return_is_callable_descriptor (
    const: LmTransNamespace: namespace_
    LmP0Text: out_type
) int
    const: LmTransSymbol: symbol
    const: LmP0Text: type_name

    if: namespace_ = 0 || namespace_\return_type_node = 0 || namespace_\return_type_node\kind != c.LM_P0_NODE_ATOM
        return: 0

    type_name: namespace_\return_type_node\as\atom
    symbol: lm_trans_namespace_find(namespace_, type_name)
    if: lm_trans_symbol_is(symbol, "callableDescriptor") = 0
        return: 0
    if: out_type != 0
        out_type[0]: type_name[0]
return: 1

fn: lm_trans_emit_raw_callable_return_statement (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
    @: int out_consumed
) int
    LmP0Text: atom
    LmP0Text: descriptor_type
    LmP0Text: return_name
    const: LmTransSymbol: symbol
    LmTransCallableValue: value
    c.array: [64]: char return_name_storage
    unsigned: return_id

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0
        return: 0

    atom: lm_trans_statement_text_new()
    if: atom = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ atom)

    descriptor_type: lm_trans_statement_text_new()
    if: descriptor_type = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ descriptor_type)

    value: lm_trans_callable_value_new()
    if: value = 0
        return: 1
    finally: lm_trans_callable_value_delete(value)

    return_name: lm_trans_statement_text_new()
    if: return_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ return_name)

    if: lm_trans_return_fields_single_atom(return_fields, atom) = 0 || lm_trans_current_return_is_callable_descriptor(namespace_, descriptor_type) = 0 || lm_trans_registry_is_function_pointer_type_name(namespace_, descriptor_type) || lm_trans_callable_descriptor_is_raw_function_reference(namespace_, descriptor_type) = 0
        return: 0

    symbol: lm_trans_callable_value_resolve(namespace_, atom, value)
    if: symbol = 0 || lm_trans_symbol_is_executable_callable(symbol) = 0 || lm_trans_callable_signature_matches_descriptor_name(descriptor_type, symbol, namespace_) = 0
        return: 0

    if: value\has_env_arg || value\uses_closure_struct
        c.fprintf(
            c.stderr,
            "trans L2 error: cannot return capturing callable %.*s as raw descriptor %.*s; descriptor must admit callable.capture\n",
            (cast: int atom\length),
            atom\data,
            (cast: int descriptor_type\length),
            descriptor_type\data
        )
        return: 1

    if: namespace_ != 0 && namespace_\cleanups\count > 0U
        return_id: namespace_\next_return_id
        namespace_\next_return_id: namespace_\next_return_id + 1U
        if: lm_trans_return_name_text(return_id, return_name_storage, c.sizeof(return_name_storage), return_name) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0 || lm_trans_emit_indent(file, indent + 1U) != 0
            return: 1
        if: lm_trans_emit_raw_callable_declarator(file, namespace_, descriptor_type, return_name, "raw callable return") != 0
            return: 1
        if: lm_trans_put(file, " = ") != 0 || lm_trans_write_text(file, value\code_name) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return ") != 0 || lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        out_consumed[0]: 1
        return: 0

    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "return ") != 0 || lm_trans_write_text(file, value\code_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_emit_closure_return_statement (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
    @: int out_consumed
) int
    LmP0Text: atom
    LmP0Text: descriptor_type
    const: LmTransSymbol: symbol
    LmTransCallableValue: value
    @: char closure_value_name

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0
        return: 0

    atom: lm_trans_statement_text_new()
    if: atom = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ atom)

    descriptor_type: lm_trans_statement_text_new()
    if: descriptor_type = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ descriptor_type)

    value: lm_trans_callable_value_new()
    if: value = 0
        return: 1
    finally: lm_trans_callable_value_delete(value)

    closure_value_name: 0
    finally: lm_own_delete(closure_value_name, 0)

    if: lm_trans_return_fields_single_atom(return_fields, atom) = 0 || lm_trans_current_return_is_callable_descriptor(namespace_, descriptor_type) = 0
        return: 0
    symbol: lm_trans_callable_value_resolve(namespace_, atom, value)
    if: symbol = 0 || lm_trans_symbol_is(symbol, "function") = 0
        return: 0
    if: value\has_closure_call = 0
        return: 0
    if: lm_trans_callable_descriptor_allows_capture(namespace_, descriptor_type) = 0
        c.fprintf(
            c.stderr,
            "trans L2 error: callable descriptor %.*s does not admit callable.capture for returned closure %.*s\n",
            (cast: int descriptor_type\length),
            descriptor_type\data,
            (cast: int atom\length),
            atom\data
        )
        return: 1
    if: lm_trans_callable_descriptor_uses_closure_struct(namespace_, descriptor_type) = 0
        c.fprintf(
            c.stderr,
            "trans L2 error: callable descriptor %.*s admits callable.capture but callable.projection is not c.closure-struct\n",
            (cast: int descriptor_type\length),
            descriptor_type\data
        )
        return: 1
    if: lm_trans_callable_signature_matches_descriptor_name(descriptor_type, symbol, namespace_) = 0
        c.fprintf(
            c.stderr,
            "trans L2 error: returned closure %.*s is incompatible with callable descriptor %.*s\n",
            (cast: int atom\length),
            atom\data,
            (cast: int descriptor_type\length),
            descriptor_type\data
        )
        return: 1

    closure_value_name: lm_trans_hoisted_suffix_name_new(value\code_name, "_closure_value")
    if: closure_value_name = 0
        return: 1

    out_consumed[0]: 1
    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "return ") != 0 || lm_trans_put(file, closure_value_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_message_thread_entry_return (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
    @: int out_consumed
) int
    unsigned: return_id

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0 || namespace_ = 0 || namespace_\message_thread_entry = 0
        return: 0

    return_id: namespace_\next_return_id
    namespace_\next_return_id: namespace_\next_return_id + 1U
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "int ") != 0 || lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, " = ") != 0
        return: 1
    if: return_fields = 0
        if: lm_trans_put(file, "0") != 0
            return: 1
    ---
    if: return_fields != 0
        if: lm_trans_emit_expr_fields(file, return_fields, namespace_) != 0
            return: 1
    ---
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "lm_message_thread_request_stop(lm_lmx_message_thread, ") != 0 || lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, ");\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "goto lm_message_thread_turn_end;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_emit_return_statement (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Node: candidate_node
    const: LmTransDescriptor: required_descriptor
    const: LmTransSymbol: candidate_symbol
    LmTransL4CallableType: candidate_type
    LmTransL4CallableType: expected_type
    int: candidate_type_status
    int: expected_array_reference
    size_t: expected_element_address_depth
    unsigned: return_id
    int: consumed

    candidate_node: 0
    if: return_fields != 0 && return_fields\next = 0 && return_fields\value != 0
        candidate_node: return_fields\value
    if: namespace_ != 0 && namespace_\return_type_node != 0
        expected_type: lm_trans_expr_callable_type_new()
        if: expected_type = 0
            return: 1
        if: lm_trans_l4_callable_type_from_node(namespace_\return_type_node, expected_type)
            expected_array_reference: expected_type\array_rank != 0U || (expected_type\address_depth = 0U && lm_trans_text_equals(expected_type\class_name, "LmSlice"))
            if: lm_trans_guard_array_reference_range(return_fields, 0, namespace_, expected_array_reference, "return value") != 0
                lm_trans_expr_callable_type_delete(expected_type)
                return: 1
            ---
            if: expected_array_reference && expected_type\array_rank != 0U
                if: expected_type\address_depth = 0U
                    c.fprintf(c.stderr, "trans L2 internal error: ArrayReference return type has inconsistent rank/address-depth metadata\n")
                    lm_trans_expr_callable_type_delete(expected_type)
                    return: 1
                expected_element_address_depth: expected_type\address_depth - 1U
                if: lm_trans_guard_array_reference_shape_range(return_fields, 0, namespace_, expected_type\class_name, expected_type\array_rank, expected_element_address_depth, expected_type\is_const, "return value") != 0
                    lm_trans_expr_callable_type_delete(expected_type)
                    return: 1
                ---
            ---
            if: expected_array_reference = 0 && lm_trans_guard_c_array_value_range(return_fields, 0, namespace_, expected_type\class_name, expected_type\address_depth, expected_type\is_const, "return value") != 0
                lm_trans_expr_callable_type_delete(expected_type)
                return: 1
            ---
            if: expected_array_reference = 0 && lm_trans_guard_runtime_table_indexed_field_range(return_fields, 0, namespace_, expected_type\class_name, expected_type\address_depth, expected_type\is_const, "return value") != 0
                lm_trans_expr_callable_type_delete(expected_type)
                return: 1
            ---
            if: expected_type\array_rank = 0U && expected_type\address_depth != 0U && lm_trans_range_has_direct_array_reference(return_fields, 0, namespace_) && (expected_type\address_depth != 1U || lm_trans_text_equals(expected_type\class_name, "LmSlice") = 0 || lm_trans_range_is_direct_array_reference_address(return_fields, 0, namespace_) = 0) && lm_trans_range_is_array_reference_data_pointer(return_fields, 0, namespace_) = 0
                c.fprintf(c.stderr, "trans L2 type error: raw pointer return cannot consume an ArrayReference without an explicit adapter\n")
                lm_trans_expr_callable_type_delete(expected_type)
                return: 1
            ---
            candidate_symbol: 0
            if: candidate_node != 0 && candidate_node\kind = c.LM_P0_NODE_FRAME
                candidate_symbol: lm_trans_namespace_find(namespace_, candidate_node\as\frame\head)
            if: candidate_symbol != 0 && lm_trans_symbol_is_executable_callable(candidate_symbol) && (expected_array_reference || expected_type\address_depth != 0U)
                candidate_type: lm_trans_expr_callable_type_new()
                if: candidate_type = 0
                    lm_trans_expr_callable_type_delete(expected_type)
                    return: 1
                candidate_type_status: lm_trans_node_result_type(candidate_node, namespace_, candidate_type)
                if: candidate_type_status < 0
                    lm_trans_expr_callable_type_delete(candidate_type)
                    lm_trans_expr_callable_type_delete(expected_type)
                    return: 1
                if: candidate_type_status > 0 && expected_array_reference && candidate_type\array_rank = 0U && (candidate_type\address_depth != 0U || lm_trans_text_equals(candidate_type\class_name, "LmSlice") = 0)
                    c.fprintf(c.stderr, "trans L2 type error: return value requires an ArrayReference result\n")
                    lm_trans_expr_callable_type_delete(candidate_type)
                    lm_trans_expr_callable_type_delete(expected_type)
                    return: 1
                if: candidate_type_status > 0 && expected_array_reference = 0 && expected_type\address_depth != 0U && (candidate_type\array_rank != 0U || (candidate_type\address_depth = 0U && lm_trans_text_equals(candidate_type\class_name, "LmSlice")))
                    c.fprintf(c.stderr, "trans L2 type error: raw pointer return cannot consume an ArrayReference result without an explicit adapter\n")
                    lm_trans_expr_callable_type_delete(candidate_type)
                    lm_trans_expr_callable_type_delete(expected_type)
                    return: 1
                ---
                if: candidate_type_status > 0 && expected_array_reference = 0 && expected_type\address_depth != 0U && candidate_type\array_rank = 0U && lm_trans_raw_pointer_type_compatible(candidate_type\class_name, candidate_type\address_depth, candidate_type\is_const, expected_type\class_name, expected_type\address_depth, expected_type\is_const, namespace_) = 0
                    c.fprintf(c.stderr, "trans L2 type error: raw pointer return cannot consume callable %.*s result %.*s depth %zu const %d as %.*s depth %zu const %d\n", (cast: int candidate_node\as\frame\head\length), candidate_node\as\frame\head\data, (cast: int candidate_type\class_name\length), candidate_type\class_name\data, candidate_type\address_depth, candidate_type\is_const, (cast: int expected_type\class_name\length), expected_type\class_name\data, expected_type\address_depth, expected_type\is_const)
                    lm_trans_expr_callable_type_delete(candidate_type)
                    lm_trans_expr_callable_type_delete(expected_type)
                    return: 1
                ---
                lm_trans_expr_callable_type_delete(candidate_type)
            ---
            if: candidate_node != 0 && candidate_node\kind = c.LM_P0_NODE_ATOM
                required_descriptor: lm_trans_namespace_descriptor(namespace_, expected_type\class_name)
                if: lm_trans_admit_consumer_uses(namespace_, candidate_node\as\atom, required_descriptor, candidate_node\as\atom, lm_trans_uses_get_fn_frame(), "return value") != 0
                    lm_trans_expr_callable_type_delete(expected_type)
                    return: 1
                ---
            ---
        ---
        lm_trans_expr_callable_type_delete(expected_type)
    ---

    if: lm_trans_emit_message_thread_entry_return(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: return_fields = 0
        if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        return: lm_trans_put(file, "return;\n")

    if: lm_trans_emit_raw_callable_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: lm_trans_emit_closure_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: lm_trans_emit_struct_value_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: lm_trans_emit_typed_value_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: namespace_ != 0 && namespace_\cleanups\count > 0U && namespace_\return_type_node != 0
        return_id: namespace_\next_return_id
        namespace_\next_return_id: namespace_\next_return_id + 1U
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        if: lm_trans_put(file, "{\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0
            return: 1
        if: lm_trans_emit_current_return_type(file, namespace_) != 0
            return: 1
        if: lm_trans_put(file, " ") != 0
            return: 1
        if: lm_trans_emit_return_name(file, return_id) != 0
            return: 1
        if: lm_trans_put(file, " = ") != 0
            return: 1
        if: lm_trans_emit_expr_fields(file, return_fields, namespace_) != 0
            return: 1
        if: lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0
            return: 1
        if: lm_trans_put(file, "return ") != 0
            return: 1
        if: lm_trans_emit_return_name(file, return_id) != 0
            return: 1
        if: lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        return: lm_trans_put(file, "}\n")

    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_put(file, "return ") != 0
        return: 1
    if: lm_trans_emit_expr_fields(file, return_fields, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_trailer_statement (
    FILE: file
    const: LmP0Trailer: trailer
    unsigned: indent
    LmTransNamespace: namespace_
) int
    if: trailer = 0
        return: 0

    if: lm_trans_text_equals(trailer\spelling, "return")
        return: lm_trans_emit_return_statement(file, trailer\body\first_field, indent, namespace_)

    if: lm_trans_text_equals(trailer\spelling, "end")
        return: 0

    c.fprintf(
        c.stderr,
        "trans error: unsupported trailer \"%.*s\"\n",
        (cast: int trailer\spelling\length),
        trailer\spelling\data
    )
return: 1

fn: lm_trans_emit_declaration_with_qualifier (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    const: LmP0Structure: body
    const: LmP0Field: name_field
    const: LmP0Node: name_node
    LmTransL4CallableType: expected_type
    int: is_raw_callable
    int: is_structural_default
    const: LmP0Node: throws_node
    int: allowed_previous

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    name_field: lm_trans_nth_field(body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: declaration expects a name\n")
        return: 1

    name_node: name_field\value
    expected_type: 0
    throws_node: 0
    allowed_previous: 0
    finally: lm_trans_expr_callable_type_delete(expected_type)

    if: lm_trans_text_equals(frame\head, "void")
        c.fprintf(c.stderr, "trans L2 type error: void is not an empty Structure; it has no cell\n")
        return: 1

    is_structural_default: (qualifier = 0 || qualifier[0] = '\0') && name_field\next = 0 && lm_trans_namespace_has_named_structure_binding(namespace_, frame\head)
    if: is_structural_default && lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1

    is_raw_callable: lm_trans_symbol_is(lm_trans_namespace_find(namespace_, frame\head), "callableDescriptor") && lm_trans_callable_descriptor_is_raw_function_reference(namespace_, frame\head)
    if: is_raw_callable && lm_trans_emit_raw_callable_declarator(file, namespace_, frame\head, name_node\as\atom, "callable descriptor") != 0
        return: 1
    if: is_raw_callable = 0 && lm_trans_emit_type_head_only(file, frame\head, namespace_) != 0
        return: 1
    if: is_raw_callable = 0 && lm_trans_put(file, " ") != 0
        return: 1
    if: is_raw_callable = 0 && lm_trans_emit_identifier(file, name_node\as\atom) != 0
        return: 1

    if: is_structural_default
        if: lm_trans_named_structure_uses_graph_header(namespace_, frame\head)
            if: lm_trans_emit_structure_graph_header(lm_trans_prelude_file(file)) != 0
                return: 1
            if: lm_trans_put(file, " = ") != 0
                return: 1
            if: lm_trans_emit_graph_structure_new(file, frame\head, "lm_lmx_message_thread", "lm_message_thread_owner(lm_lmx_message_thread)", name_node\as\atom) != 0
                return: 1
            ---
        else:
            if: lm_trans_put(file, " = (") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*") != 0 || lm_trans_emit_identifier(file, name_node\as\atom) != 0 || lm_trans_put(file, "))") != 0
                return: 1
            ---
        ---
    else:
        if: name_field\next != 0
            expected_type: lm_trans_expr_callable_type_new()
            if: expected_type = 0
                return: 1
            expected_type\class_name[0]: frame\head[0]
            if: name_field\next\next = 0
                throws_node: lm_trans_node_throws_node(name_field\next\value, namespace_)
            allowed_previous: lm_trans_throwing_call_allowed
            if: throws_node != 0
                lm_trans_throwing_call_allowed: 1
            if: lm_trans_put(file, " = ") != 0
                lm_trans_throwing_call_allowed: allowed_previous
                return: 1
            if: lm_trans_emit_expr_range_with_expected_type(file, name_field\next, 0, namespace_, expected_type) != 0
                lm_trans_throwing_call_allowed: allowed_previous
                return: 1
            lm_trans_throwing_call_allowed: allowed_previous
        ---
    ---
    if: lm_trans_put(file, ";\n") != 0
        return: 1

    if: is_structural_default && lm_trans_named_structure_uses_graph_header(namespace_, frame\head) = 0
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_emit_identifier(file, name_node\as\atom) != 0 || lm_trans_put(file, " == 0) {\n") != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "abort();\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
    ---
    if: lm_trans_namespace_declare_storage_binding(namespace_, name_node\as\atom, frame\head) != 0
        return: 1
    if: throws_node != 0
        return: lm_trans_emit_throwing_dispatch(file, indent, namespace_, throws_node)
return: 0

fn: lm_trans_namespace_declare_storage_binding (
    LmTransNamespace: namespace_
    const: LmP0Text: name
    const: LmP0Text: type_head
) int
    LmTransSymbol: symbol
    const: LmTransSymbol: type_symbol
    const: @: char symbol_class
    int: status

    type_symbol: lm_trans_namespace_find(namespace_, type_head)
    if: lm_trans_symbol_is(type_symbol, "callableDescriptor")
        symbol_class: "closure"
        if: lm_trans_callable_descriptor_is_raw_function_reference(namespace_, type_head)
            symbol_class: "functionPointer"
        if: lm_trans_namespace_declare(namespace_, name, symbol_class) != 0
            return: 1
        symbol: lm_trans_namespace_find_mutable(namespace_, name)
        status: lm_trans_symbol_copy_signature(symbol, type_symbol)
        if: status = 0
            status: lm_trans_namespace_declare_relation_text(namespace_, name, "variable.type", type_head)
        return: status

    status: lm_trans_namespace_declare(namespace_, name, "variable")
    if: status = 0
        status: lm_trans_namespace_declare_relation_text(namespace_, name, "variable.type", type_head)
return: status

fn: lm_trans_namespace_declare_node_storage_binding (
    LmTransNamespace: namespace_
    const: LmP0Text: name
    const: LmP0Node: type_node
) int
    if: type_node != 0 && type_node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_namespace_declare_storage_binding(namespace_, name, type_node\as\atom)
return: lm_trans_namespace_declare(namespace_, name, "variable")

fn: lm_trans_emit_declaration (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
return: lm_trans_emit_declaration_with_qualifier(file, frame, indent, namespace_, "")

fn: lm_trans_atom_can_be_new_binding_name (const: (LmP0Text: text)) int
return: lm_trans_atom_is_identifier_like(text)

fn: lm_trans_head_can_declare_storage (
    const: LmP0Text: head
    const: LmTransNamespace: namespace_
) int
    const: LmTransSymbol: symbol

    if: lm_trans_builtin_c_type_name(head)
        return: 1
    if: lm_trans_text_all_char(head, '@') || lm_trans_text_is_array_receiver_head(head)
        return: 0
    if: lm_trans_is_reserved_head_name(head)
        return: 0
    if: lm_trans_namespace_has_named_structure_binding(namespace_, head)
        return: 1
    if: lm_trans_namespace_layout_source_is_supported(namespace_, head)
        return: 1
    if: lm_trans_namespace_class_has(namespace_, head)
        return: 1

    symbol: lm_trans_namespace_find(namespace_, head)
return: lm_trans_symbol_is(symbol, "class") || lm_trans_symbol_is(symbol, "callableDescriptor")

fn: lm_trans_frame_looks_storage_declaration (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    const: LmP0Field: name_field

    if: frame = 0 || lm_trans_head_can_declare_storage(frame\head, namespace_) = 0
        return: 0

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    name_field: lm_trans_nth_field(body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0

return: lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom)

fn: lm_trans_emit_pointer_declaration_with_qualifier (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    const: LmP0Structure: body
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Node: name_node
    const: LmP0Text: expected_class
    int: status

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    type_field: lm_trans_nth_field(body, 0U)
    name_field: lm_trans_nth_field(body, 1U)
    if: type_field = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: @ declaration expects type and name\n")
        return: 1

    name_node: name_field\value
    expected_class: 0
    if: type_field\value != 0 && type_field\value\kind = c.LM_P0_NODE_ATOM
        expected_class: type_field\value\as\atom
    if: name_field\next != 0 && lm_trans_guard_c_array_value_range(name_field\next, 0, namespace_, expected_class, frame\head\length, lm_trans_qualifier_is_const(qualifier), "raw pointer initializer") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_guard_known_raw_pointer_range(name_field\next, 0, namespace_, expected_class, frame\head\length, lm_trans_qualifier_is_const(qualifier), "raw pointer initializer") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_range_has_direct_array_reference(name_field\next, 0, namespace_) && (frame\head\length != 1U || type_field\value = 0 || type_field\value\kind != c.LM_P0_NODE_ATOM || lm_trans_text_equals(type_field\value\as\atom, "LmSlice") = 0 || lm_trans_range_is_direct_array_reference_address(name_field\next, 0, namespace_) = 0) && lm_trans_range_is_array_reference_data_pointer(name_field\next, 0, namespace_) = 0
        c.fprintf(c.stderr, "trans L2 type error: raw pointer initializer cannot consume an ArrayReference without an explicit adapter\n")
        return: 1
    ---
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1
    if: lm_trans_emit_type_and_name(file, type_field\value, name_node\as\atom, frame\head\length, namespace_) != 0
        return: 1
    if: name_field\next != 0 && lm_trans_put(file, " = ") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_emit_expr_fields(file, name_field\next, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    status: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_field\value)
    if: status = 0
        status: lm_trans_namespace_mark_raw_pointer(namespace_, name_node\as\atom, frame\head\length, lm_trans_qualifier_is_const(qualifier))
return: status

fn: lm_trans_emit_pointer_declaration (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
return: lm_trans_emit_pointer_declaration_with_qualifier(file, frame, indent, namespace_, "")

fn: lm_trans_emit_array_initializer_fields (
    FILE: file
    const: LmP0Field: first
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    int: wrote

    wrote: 0
    field: first
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && wrote && lm_trans_put(file, ", ") != 0
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0 && lm_trans_emit_array_initializer_node(file, field\value, namespace_) != 0
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0
            wrote: 1
        field: field\next

return: 0

fn: lm_trans_emit_array_initializer_structure (
    FILE: file
    const: LmP0Structure: structure
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: first

    first: 0
    if: structure != 0
        first: structure\first_field
    if: lm_trans_put(file, "{") != 0
        return: 1
    if: lm_trans_emit_array_initializer_fields(file, first, namespace_) != 0
        return: 1
return: lm_trans_put(file, "}")

fn: lm_trans_emit_array_initializer_node (
    FILE: file
    const: LmP0Node: node
    const: LmTransNamespace: namespace_
) int
    if: node = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: lm_trans_emit_array_initializer_structure(file, node\as\structure, namespace_)
    if: node\kind = c.LM_P0_NODE_FRAME && lm_trans_text_is_array_receiver_head(node\as\frame\head)
        return: lm_trans_emit_array_initializer_structure(file, node\as\frame\body, namespace_)
    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_emit_expr_atom_mode(file, node\as\atom, namespace_, 1)
return: lm_trans_emit_expr_node(file, node, namespace_)

fn: lm_trans_emit_array_initializer (
    FILE: file
    const: LmP0Field: first
    const: LmTransNamespace: namespace_
) int
    if: first != 0 && first\next = 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_STRUCTURE
        if: lm_trans_put(file, " = ") != 0
            return: 1
        return: lm_trans_emit_array_initializer_structure(file, first\value\as\structure, namespace_)

    if: lm_trans_put(file, " = {") != 0
        return: 1
    if: lm_trans_emit_expr_list(file, first, namespace_) != 0
        return: 1
return: lm_trans_put(file, "}")

fn: lm_trans_c_array_declaration_parts (
    const: LmP0Frame: frame
    const: @(LmP0Frame out_array_frame)
    @: int out_is_const
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmP0Frame: declaration

    if: out_array_frame != 0
        out_array_frame[0]: 0
    if: out_is_const != 0
        out_is_const[0]: 0
    if: frame = 0 || out_array_frame = 0 || out_is_const = 0 || lm_trans_text_equals(frame\head, "c.array") = 0
        c.fprintf(c.stderr, "trans L2 c.array error: expected a c.array declaration frame\n")
        return: 1

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    field: 0
    if: body != 0
        field: body\first_field
    if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
        c.fprintf(c.stderr, "trans L2 c.array error: c.array expects exactly one bracket-head array declaration\n")
        return: 1

    declaration: field\value\as\frame
    if: lm_trans_text_equals(declaration\head, "const")
        out_is_const[0]: 1
        body: lm_trans_unwrap_single_anonymous_structure(declaration\body)
        field: 0
        if: body != 0
            field: body\first_field
        if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
            c.fprintf(c.stderr, "trans L2 c.array error: const c.array expects exactly one bracket-head array declaration\n")
            return: 1
        declaration: field\value\as\frame
    ---

    if: lm_trans_text_is_array_receiver_head(declaration\head) = 0
        c.fprintf(c.stderr, "trans L2 c.array error: c.array requires a []-family declarator\n")
        return: 1
    out_array_frame[0]: declaration
return: 0

fn: lm_trans_array_declarator_error (const: @(char message)) int
    if: message != 0
        c.fprintf(c.stderr, "%s\n", message)
return: 1

fn: lm_trans_array_declarator_read_from_frame (
    LmTransCDeclarator: declarator
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
    int: allow_single_frame
    int: allow_type_head
    int: require_name
    const: @(char direct_error)
    const: @(char pointer_error)
    const: @(char nested_error)
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Frame: inner
    size_t: pointer_depth
    int: single_frame
    int: handled

    if: declarator = 0 || frame = 0 || declarator\type_head = 0 || declarator\name = 0 || declarator\array_head = 0
        return: 1

    declarator\type_node: 0
    declarator\expression_dimensions: 0
    declarator\type_head\data: ""
    declarator\type_head\length: 0U
    declarator\name\data: ""
    declarator\name\length: 0U
    declarator\array_head[0]: frame\head[0]
    declarator\pointer_depth: 0U
    declarator\literal_dimension_count: 0U
    declarator\type_is_head: 0

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    field: 0
    if: body != 0
        field: body\first_field

    single_frame: allow_single_frame && field != 0 && field\next = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
    if: single_frame
        inner: field\value\as\frame
        handled: 0
        if: allow_type_head && lm_trans_head_can_declare_storage(inner\head, namespace_)
            if: require_name
                name_field: inner\body\first_field
                if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
                    return: lm_trans_array_declarator_error(direct_error)
                declarator\name[0]: name_field\value\as\atom[0]
                declarator\expression_dimensions: name_field\next
            ---
            declarator\type_head[0]: inner\head[0]
            declarator\type_is_head: 1
            handled: 1
        ---
        if: handled = 0 && lm_trans_text_all_char(inner\head, '@')
            type_field: lm_trans_nth_field(inner\body, 0U)
            if: require_name
                name_field: lm_trans_nth_field(inner\body, 1U)
                if: type_field = 0 || type_field\value = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
                    return: lm_trans_array_declarator_error(pointer_error)
                declarator\name[0]: name_field\value\as\atom[0]
                declarator\expression_dimensions: name_field\next
            else:
                if: type_field = 0 || type_field\value = 0
                    return: lm_trans_array_declarator_error(pointer_error)
            ---
            declarator\pointer_depth: inner\head\length
            declarator\type_node: type_field\value
            handled: 1
        ---
        if: handled = 0
            return: lm_trans_array_declarator_error(nested_error)
        return: 0
    ---

    pointer_depth: 0U
    while: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_all_char(field\value\as\atom, '@')
        pointer_depth: pointer_depth + field\value\as\atom\length
        field: field\next

    type_field: field
    if: require_name
        if: type_field != 0
            name_field: type_field\next
        else:
            name_field: 0
        if: type_field = 0 || type_field\value = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            return: lm_trans_array_declarator_error(direct_error)
        declarator\name[0]: name_field\value\as\atom[0]
        declarator\expression_dimensions: name_field\next
    else:
        if: type_field = 0 || type_field\value = 0
            return: lm_trans_array_declarator_error(direct_error)
    ---

    declarator\pointer_depth: pointer_depth
    declarator\type_node: type_field\value
return: 0

fn: lm_trans_array_declarator_rank (
    const: LmTransCDeclarator: declarator
) size_t
    LmP0Text: dimension
    size_t: dimension_index
    size_t: rank

    if: declarator = 0 || declarator\array_head = 0
        return: 0U
    dimension: lm_trans_statement_text_new()
    if: dimension = 0
        return: 0U
    finally: lm_trans_text_ref_destroy(@ dimension)
    dimension_index: 0U
    rank: declarator\literal_dimension_count
    while: lm_trans_array_head_next_dimension(declarator\array_head, @ dimension_index, dimension)
        rank: rank + 1U
return: rank

fn: lm_trans_c_array_declaration_name (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
    LmP0Text: out_name
    @: size_t out_rank
    @: size_t out_element_address_depth
) int
    const: LmP0Frame: declaration
    LmTransCDeclarator: declarator
    int: is_const

    if: out_name != 0
        out_name\data: ""
        out_name\length: 0U
    if: out_rank != 0
        out_rank[0]: 0U
    if: out_element_address_depth != 0
        out_element_address_depth[0]: 0U
    if: out_name = 0 || out_rank = 0 || out_element_address_depth = 0 || lm_trans_c_array_declaration_parts(frame, @ declaration, @ is_const) != 0
        return: 1
    c.LM_UNUSED(is_const)

    declarator: lm_trans_statement_c_declarator_new()
    if: declarator = 0
        return: 1
    finally: lm_trans_statement_c_declarator_destroy(declarator)
    declarator\atom_dimensions_only: 1
    if: lm_trans_array_declarator_read_from_frame(declarator, declaration, namespace_, 1, 1, 1, "trans L2 c.array error: declaration expects a type, name, and extent", "trans L2 c.array error: pointer declaration expects a type, name, and extent", "trans L2 c.array error: nested declaration expects a type, name, and extent") != 0
        return: 1
    out_name[0]: declarator\name[0]
    out_rank[0]: lm_trans_array_declarator_rank(declarator)
    out_element_address_depth[0]: declarator\pointer_depth
return: 0

fn: lm_trans_array_declarator_empty_rank (
    const: LmTransCDeclarator: declarator
    @: size_t out_rank
) int
    LmP0Text: dimension
    size_t: dimension_index
    size_t: rank

    if: out_rank != 0
        out_rank[0]: 0U
    if: declarator = 0 || declarator\array_head = 0
        return: 0

    dimension: lm_trans_statement_text_new()
    if: dimension = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ dimension)

    dimension_index: 0U
    rank: 0U
    while: lm_trans_array_head_next_dimension(declarator\array_head, @ dimension_index, dimension)
        if: dimension\length != 0U
            return: 0
        rank: rank + 1U
    if: rank = 0U
        return: 0
    if: out_rank != 0
        out_rank[0]: rank
return: 1

fn: lm_trans_array_declarator_single_structure_value (
    const: LmTransCDeclarator: declarator
) const: LmP0Structure
    size_t: rank

    if: lm_trans_array_declarator_empty_rank(declarator, @ rank) = 0
        return: 0
return: lm_trans_fields_single_structure_value(declarator\expression_dimensions)

fn: lm_trans_managed_array_storage_name_new (
    const: @(char role)
    unsigned: id
) @: char
    c.array: [96]: char buffer
    int: written
    @: char result

    if: role = 0
        return: 0
    written: c.snprintf(buffer, c.sizeof(buffer), "lm_lmx_array_%s_%u", role, id)
    if: written < 0 || (cast: size_t written) >= c.sizeof(buffer)
        return: 0
    result: (cast: (@: char) lm_own_new_zero((cast: size_t written) + 1U))
    if: result = 0
        return: 0
    c.memcpy(result, buffer, (cast: size_t written) + 1U)
return: result

fn: lm_trans_emit_managed_array_pointer_type (
    FILE: file
    const: LmTransCDeclarator: declarator
    size_t: pointer_depth
    const: LmTransNamespace: namespace_
) int
    size_t: index

    if: declarator = 0
        return: 1
    if: declarator\type_is_head
        if: lm_trans_emit_type_head_only(file, declarator\type_head, namespace_) != 0
            return: 1
        ---
    else:
        if: declarator\type_node = 0 || lm_trans_emit_type_node(file, declarator\type_node, namespace_) != 0
            return: 1
        ---
    if: pointer_depth = 0U
        return: 0
    if: lm_trans_put(file, " ") != 0
        return: 1
    index: 0U
    while: index < pointer_depth
        if: lm_trans_put(file, "*") != 0
            return: 1
        index: index + 1U
return: 0

fn: lm_trans_emit_managed_array_extent_name (
    FILE: file
    unsigned: id
    size_t: level
) int
    @: char stem

    stem: lm_trans_module_init_private_name_new("array_extent_", 0U)
    if: stem = 0
        return: 1
    if: c.fprintf(file, "%s%u_%zu", stem, id, level) < 0
        lm_own_delete(stem, 0)
        return: 1
    lm_own_delete(stem, 0)
return: 0

fn: lm_trans_emit_managed_array_index_name (
    FILE: file
    unsigned: id
    size_t: level
) int
    @: char stem

    stem: lm_trans_module_init_private_name_new("array_index_", 0U)
    if: stem = 0
        return: 1
    if: c.fprintf(file, "%s%u_%zu", stem, id, level) < 0
        lm_own_delete(stem, 0)
        return: 1
    lm_own_delete(stem, 0)
return: 0

fn: lm_trans_emit_managed_array_raw_extent_name (
    FILE: file
    unsigned: id
    size_t: level
) int
    @: char stem

    stem: lm_trans_module_init_private_name_new("array_raw_extent_", 0U)
    if: stem = 0
        return: 1
    if: c.fprintf(file, "%s%u_%zu", stem, id, level) < 0
        lm_own_delete(stem, 0)
        return: 1
    lm_own_delete(stem, 0)
return: 0

fn: lm_trans_array_extent_class_is_non_integer (
    const: LmP0Text: class_name
    const: LmTransNamespace: namespace_
) int
    const: @: char semantic

    if: class_name = 0 || class_name\length = 0U
        return: 0
    semantic: lm_trans_namespace_class_semantic_value(namespace_, class_name)
    if: semantic != 0
        if: c.strcmp(semantic, "integer") = 0 || c.strcmp(semantic, "count") = 0 || c.strcmp(semantic, "flag") = 0
            return: 0
        ---
        return: 1
    ---
    if: lm_trans_text_equals(class_name, "c.char") || lm_trans_text_equals(class_name, "c.short") || lm_trans_text_equals(class_name, "c.int") || lm_trans_text_equals(class_name, "c.long") || lm_trans_text_equals(class_name, "c.signed") || lm_trans_text_equals(class_name, "c.unsigned") || lm_trans_text_equals(class_name, "c.size_t")
        return: 0
    if: lm_trans_text_equals(class_name, "c.float") || lm_trans_text_equals(class_name, "c.double") || lm_trans_text_equals(class_name, "c.longDouble") || lm_trans_text_equals(class_name, "c.void") || lm_trans_text_equals(class_name, "LmSlice")
        return: 1
return: lm_trans_namespace_descriptor(namespace_, class_name) != 0

fn: lm_trans_managed_array_extent_validate_node (
    const: LmP0Node: node
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    const: LmP0Field: type_field
    const: LmP0Node: type_node
    LmP0Text: value_type
    LmTransL4CallableType: result_type
    size_t: literal_value
    int: result_status

    if: node = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_ATOM
        if: node\as\atom\length != 0U && node\as\atom\data[0] >= '0' && node\as\atom\data[0] <= '9'
            if: lm_trans_c_array_decimal_extent(node\as\atom, @ literal_value) = 0
                c.fprintf(c.stderr, "trans L2 ArrayReference error: extent has an invalid or out-of-range C99 integer literal\n")
                return: 1
            return: 0
        if: node\as\atom\length != 0U && node\as\atom\data[0] = '"'
            c.fprintf(c.stderr, "trans L2 ArrayReference error: extent must be an integer expression\n")
            return: 1
        if: lm_trans_text_starts_with(node\as\atom, "c.")
            c.fprintf(c.stderr, "trans hosted ArrayReference limitation: an untyped c.* atom cannot provide an extent\n")
            return: 1
        if: lm_trans_namespace_value_raw_pointer_depth(namespace_, node\as\atom) != 0U || lm_trans_namespace_value_is_array_reference(namespace_, node\as\atom) || lm_trans_namespace_value_is_c_array_storage(namespace_, node\as\atom)
            c.fprintf(c.stderr, "trans L2 ArrayReference error: extent cannot be an address or array value\n")
            return: 1
        value_type: lm_trans_statement_text_new()
        if: value_type = 0
            return: 1
        if: lm_trans_namespace_relation_text_for_latest_binding(namespace_, node\as\atom, "variable.type", value_type) && lm_trans_array_extent_class_is_non_integer(value_type, namespace_)
            lm_trans_text_ref_destroy(@ value_type)
            c.fprintf(c.stderr, "trans L2 ArrayReference error: extent binding must have an integer type\n")
            return: 1
        lm_trans_text_ref_destroy(@ value_type)
        return: 0
    ---
    if: node\kind = c.LM_P0_NODE_FRAME
        if: lm_trans_text_equals(node\as\frame\head, "cast")
            type_field: lm_trans_call_body_first_field(node\as\frame\body)
            if: type_field = 0 || type_field\value = 0 || type_field\next = 0
                c.fprintf(c.stderr, "trans L2 ArrayReference error: extent cast expects an integer target type and an expression\n")
                return: 1
            type_node: type_field\value
            if: type_node\kind = c.LM_P0_NODE_STRUCTURE
                type_node: lm_trans_single_type_body_node(type_node\as\structure)
            result_type: lm_trans_expr_callable_type_new()
            if: type_node = 0 || result_type = 0
                lm_trans_expr_callable_type_delete(result_type)
                return: 1
            if: lm_trans_l4_callable_type_from_node(type_node, result_type) = 0 || result_type\array_rank != 0U || result_type\address_depth != 0U || lm_trans_array_extent_class_is_non_integer(result_type\class_name, namespace_)
                lm_trans_expr_callable_type_delete(result_type)
                c.fprintf(c.stderr, "trans L2 ArrayReference error: extent cast target must be an integer type\n")
                return: 1
            lm_trans_expr_callable_type_delete(result_type)
            field: type_field\next
            while: field != 0
                if: field\value != 0 && lm_trans_node_is_ignored(field\value) = 0 && lm_trans_managed_array_extent_validate_node(field\value, namespace_) != 0
                    return: 1
                field: field\next
            return: 0
        ---
        result_type: lm_trans_expr_callable_type_new()
        if: result_type = 0
            return: 1
        result_status: lm_trans_node_result_type(node, namespace_, result_type)
        if: result_status < 0
            lm_trans_expr_callable_type_delete(result_type)
            return: 1
        if: result_status > 0
            if: result_type\array_rank != 0U || result_type\address_depth != 0U || lm_trans_array_extent_class_is_non_integer(result_type\class_name, namespace_)
                lm_trans_expr_callable_type_delete(result_type)
                c.fprintf(c.stderr, "trans L2 ArrayReference error: extent callable must return an integer value\n")
                return: 1
            lm_trans_expr_callable_type_delete(result_type)
            return: 0
        lm_trans_expr_callable_type_delete(result_type)
        if: lm_trans_text_starts_with(node\as\frame\head, "c.")
            if: lm_trans_text_equals(node\as\frame\head, "c.sizeof")
                return: 0
            c.fprintf(c.stderr, "trans hosted ArrayReference limitation: an untyped c.* call cannot provide an extent\n")
            return: 1
        ---
        field: 0
        if: node\as\frame\body != 0
            field: node\as\frame\body\first_field
        while: field != 0
            if: field\value != 0 && lm_trans_node_is_ignored(field\value) = 0 && lm_trans_managed_array_extent_validate_node(field\value, namespace_) != 0
                return: 1
            field: field\next
        return: 0
    ---
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        field: node\as\structure\first_field
        while: field != 0
            if: field\value != 0 && lm_trans_node_is_ignored(field\value) = 0 && lm_trans_managed_array_extent_validate_node(field\value, namespace_) != 0
                return: 1
            field: field\next
        return: 0
    ---

    c.fprintf(c.stderr, "trans L2 ArrayReference error: extent must be an integer expression\n")
return: 1

fn: lm_trans_managed_array_extent_validate_text (
    const: LmP0Text: dimension
    const: LmTransNamespace: namespace_
) int
    LmP0Document: document
    const: LmP0Node: root
    int: status

    if: dimension = 0 || dimension\length = 0U
        return: 1
    document: 0
    if: lm_p0_parse_bytes(dimension\data, dimension\length, @ document) != 0 || document = 0
        if: document != 0
            lm_p0_document_destroy(document)
        c.fprintf(c.stderr, "trans L2 ArrayReference error: extent is not a valid expression\n")
        return: 1
    root: lm_p0_document_root(document)
    status: lm_trans_managed_array_extent_validate_node(root, namespace_)
    lm_p0_document_destroy(document)
return: status

fn: lm_trans_emit_managed_array_target_path (
    FILE: file
    const: LmP0Text: items_name
    unsigned: id
    size_t: depth
) int
    size_t: index

    if: items_name = 0 || lm_trans_emit_identifier(file, items_name) != 0
        return: 1
    index: 0U
    while: index < depth
        if: lm_trans_put(file, "[") != 0 || lm_trans_emit_managed_array_index_name(file, id, index) != 0 || lm_trans_put(file, "]") != 0
            return: 1
        index: index + 1U
return: 0

fn: lm_trans_emit_managed_array_extents (
    FILE: file
    const: LmTransCDeclarator: declarator
    unsigned: indent
    const: LmTransNamespace: namespace_
    unsigned: id
    int: return_on_failure
) int
    LmP0Text: dimension
    const: LmP0Field: expression_dimension
    size_t: head_index
    size_t: level
    size_t: literal_index

    if: declarator = 0 || declarator\array_head = 0
        return: 1
    dimension: lm_trans_statement_text_new()
    if: dimension = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ dimension)

    expression_dimension: declarator\expression_dimensions
    head_index: 0U
    level: 0U
    while: lm_trans_array_head_next_dimension(declarator\array_head, @ head_index, dimension)
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "long long ") != 0 || lm_trans_emit_managed_array_raw_extent_name(file, id, level) != 0 || lm_trans_put(file, " = (long long)(") != 0
            return: 1
        if: dimension\length != 0U
            if: lm_trans_managed_array_extent_validate_text(dimension, namespace_) != 0 || lm_trans_emit_c_dimension_text(file, dimension, namespace_, "[] ArrayReference extent") != 0
                return: 1
            ---
        else:
            if: expression_dimension = 0 || expression_dimension\value = 0
                c.fprintf(c.stderr, "trans L2 ArrayReference error: [] declaration expects one extent per dimension\n")
                return: 1
            if: lm_trans_managed_array_extent_validate_node(expression_dimension\value, namespace_) != 0 || lm_trans_emit_expr_node(file, expression_dimension\value, namespace_) != 0
                return: 1
            expression_dimension: expression_dimension\next
        ---
        if: lm_trans_put(file, ");\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_emit_managed_array_raw_extent_name(file, id, level) != 0 || lm_trans_put(file, " < 0) ") != 0
            return: 1
        if: return_on_failure
            if: lm_trans_put(file, "return 1;\n") != 0
                return: 1
            ---
        else:
            if: lm_trans_put(file, "abort();\n") != 0
                return: 1
            ---
        ---
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "size_t ") != 0 || lm_trans_emit_managed_array_extent_name(file, id, level) != 0 || lm_trans_put(file, " = (size_t)") != 0 || lm_trans_emit_managed_array_raw_extent_name(file, id, level) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        level: level + 1U
    ---

    literal_index: 0U
    while: literal_index < declarator\literal_dimension_count
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "size_t ") != 0 || lm_trans_emit_managed_array_extent_name(file, id, level) != 0 || c.fprintf(file, " = %zuU;\n", declarator\literal_dimensions[literal_index]) < 0
            return: 1
        literal_index: literal_index + 1U
        level: level + 1U
return: 0

fn: lm_trans_emit_managed_array_cell_count_name (
    FILE: file
    unsigned: id
) int
    if: file = 0
        return: 1
    if: c.fprintf(file, "lm_lmx_arr_%u_cells", id) < 0
        return: 1
return: 0

fn: lm_trans_emit_managed_array_rectangle (
    FILE: file
    const: LmTransCDeclarator: declarator
    const: LmP0Text: items_name
    unsigned: indent
    const: LmTransNamespace: namespace_
    unsigned: id
    size_t: rank
    const: @(char thread_expression)
    const: @(char arena_expression)
    int: return_on_failure
) int
    size_t: level

    if: file = 0 || declarator = 0 || items_name = 0 || rank = 0U || thread_expression = 0 || arena_expression = 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "size_t ") != 0 || lm_trans_emit_managed_array_cell_count_name(file, id) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_managed_array_extent_name(file, id, 0U) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    level: 1U
    while: level < rank
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_managed_array_cell_count_name(file, id) != 0 || lm_trans_put(file, " *= ") != 0 || lm_trans_emit_managed_array_extent_name(file, id, level) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        level: level + 1U
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_identifier(file, items_name) != 0 || lm_trans_put(file, " = (") != 0 || lm_trans_emit_managed_array_pointer_type(file, declarator, declarator\pointer_depth + 1U, namespace_) != 0 || lm_trans_put(file, ")lm_own_arena_array_new_zero(") != 0 || lm_trans_put(file, thread_expression) != 0 || lm_trans_put(file, ", ") != 0 || lm_trans_put(file, arena_expression) != 0 || lm_trans_put(file, ", sizeof(*") != 0 || lm_trans_emit_identifier(file, items_name) != 0 || lm_trans_put(file, "), ") != 0 || lm_trans_emit_managed_array_cell_count_name(file, id) != 0 || lm_trans_put(file, ", 1U, 0U);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_emit_managed_array_cell_count_name(file, id) != 0 || lm_trans_put(file, " != 0U && ") != 0 || lm_trans_emit_identifier(file, items_name) != 0 || lm_trans_put(file, " == 0) ") != 0
        return: 1
    if: return_on_failure
        return: lm_trans_put(file, "return 1;\n")
return: lm_trans_put(file, "abort();\n")

fn: lm_trans_emit_managed_array_linear_target (
    FILE: file
    const: LmP0Text: items_name
    unsigned: id
    const: @(size_t indices)
    size_t: rank
) int
    size_t: i
    size_t: j

    if: items_name = 0 || lm_trans_emit_identifier(file, items_name) != 0 || lm_trans_put(file, "[") != 0
        return: 1
    i: 0U
    while: i < rank
        if: i != 0U && lm_trans_put(file, " + ") != 0
            return: 1
        if: lm_trans_emit_size_literal(file, indices[i]) != 0
            return: 1
        j: i + 1U
        while: j < rank
            if: lm_trans_put(file, " * ") != 0 || lm_trans_emit_managed_array_extent_name(file, id, j) != 0
                return: 1
            j: j + 1U
        i: i + 1U
return: lm_trans_put(file, "]")

fn: lm_trans_emit_array_rectangle_index_tail (
    FILE: file
    unsigned: id
    size_t: rank
    size_t: index
) int
    size_t: j

    if: index + 1U >= rank
        return: lm_trans_put(file, "]")
    j: index + 1U
    while: j < rank
        if: lm_trans_put(file, " * ") != 0 || lm_trans_emit_managed_array_extent_name(file, id, j) != 0
            return: 1
        j: j + 1U
return: lm_trans_put(file, " + ")

fn: lm_trans_emit_managed_array_level_allocation (
    FILE: file
    const: LmTransCDeclarator: declarator
    const: LmP0Text: items_name
    unsigned: indent
    const: LmTransNamespace: namespace_
    unsigned: id
    size_t: rank
    size_t: level
    const: @(char thread_expression)
    const: @(char arena_expression)
    int: return_on_failure
) int
    size_t: loop_level
    size_t: close_level

    loop_level: 0U
    while: loop_level < level
        if: lm_trans_emit_indent(file, indent + loop_level) != 0 || lm_trans_put(file, "for (size_t ") != 0 || lm_trans_emit_managed_array_index_name(file, id, loop_level) != 0 || lm_trans_put(file, " = 0U; ") != 0 || lm_trans_emit_managed_array_index_name(file, id, loop_level) != 0 || lm_trans_put(file, " < ") != 0 || lm_trans_emit_managed_array_extent_name(file, id, loop_level) != 0 || lm_trans_put(file, "; ") != 0 || lm_trans_emit_managed_array_index_name(file, id, loop_level) != 0 || lm_trans_put(file, " += 1U) {\n") != 0
            return: 1
        loop_level: loop_level + 1U
    ---

    if: thread_expression = 0 || arena_expression = 0
        return: 1
    if: lm_trans_emit_indent(file, indent + level) != 0 || lm_trans_emit_managed_array_target_path(file, items_name, id, level) != 0 || lm_trans_put(file, " = (") != 0 || lm_trans_emit_managed_array_pointer_type(file, declarator, declarator\pointer_depth + rank - level, namespace_) != 0 || lm_trans_put(file, ")lm_own_arena_array_new_zero(") != 0 || lm_trans_put(file, thread_expression) != 0 || lm_trans_put(file, ", ") != 0 || lm_trans_put(file, arena_expression) != 0 || lm_trans_put(file, ", sizeof(*") != 0 || lm_trans_emit_managed_array_target_path(file, items_name, id, level) != 0 || lm_trans_put(file, "), ") != 0 || lm_trans_emit_managed_array_extent_name(file, id, level) != 0 || c.fprintf(file, ", %zuU, %zuU);\n", rank, level) < 0
        return: 1
    if: lm_trans_emit_indent(file, indent + level) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_emit_managed_array_extent_name(file, id, level) != 0 || lm_trans_put(file, " != 0U && ") != 0 || lm_trans_emit_managed_array_target_path(file, items_name, id, level) != 0 || lm_trans_put(file, " == 0) ") != 0
        return: 1
    if: return_on_failure
        if: lm_trans_put(file, "return 1;\n") != 0
            return: 1
        ---
    else:
        if: lm_trans_put(file, "abort();\n") != 0
            return: 1
        ---
    ---

    close_level: level
    while: close_level > 0U
        close_level: close_level - 1U
        if: lm_trans_emit_indent(file, indent + close_level) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
return: 0

fn: lm_trans_array_initializer_nested_structure (
    const: LmP0Node: node
) const: LmP0Structure
    if: node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: node\as\structure
    if: node\kind = c.LM_P0_NODE_FRAME && lm_trans_text_is_array_receiver_head(node\as\frame\head)
        return: node\as\frame\body
return: 0

fn: lm_trans_array_initializer_present_node_count (
    const: LmP0Field: first
) size_t
    const: LmP0Field: field
    size_t: count

    count: 0U
    field: first
    while: field != 0
        if: field\value != 0 && lm_trans_node_is_ignored(field\value) = 0
            count: count + 1U
        field: field\next
return: count

fn: lm_trans_array_initializer_expression_count (
    const: LmP0Field: first
) size_t
    const: LmP0Field: field
    const: LmP0Field: next
    size_t: count

    count: 0U
    field: first
    while: field != 0
        if: field\value = 0 || lm_trans_node_is_ignored(field\value)
            field: field\next
            continue
        next: lm_trans_expr_segment_end(field)
        if: next = field
            return: (cast: size_t -1)
        count: count + 1U
        field: next
return: count

fn: lm_trans_emit_managed_array_initializer_level (
    FILE: file
    const: LmTransCDeclarator: declarator
    const: LmP0Text: items_name
    const: LmP0Field: first
    unsigned: indent
    const: LmTransNamespace: namespace_
    const: LmTransL4CallableType: expected_type
    unsigned: id
    size_t: rank
    size_t: level
    @: size_t indices
    int: return_on_failure
) int
    const: LmP0Field: field
    const: LmP0Field: next
    const: LmP0Structure: child
    size_t: count
    size_t: index

    if: level >= rank || indices = 0
        return: 1
    if: level + 1U = rank
        count: lm_trans_array_initializer_expression_count(first)
        if: count = (cast: size_t -1)
            return: 1
        ---
    else:
        count: lm_trans_array_initializer_present_node_count(first)
    ---
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_emit_managed_array_extent_name(file, id, level) != 0 || c.fprintf(file, " < %zuU) ", count) < 0
        return: 1
    if: return_on_failure
        if: lm_trans_put(file, "return 1;\n") != 0
            return: 1
        ---
    else:
        if: lm_trans_put(file, "abort();\n") != 0
            return: 1
        ---
    ---

    field: first
    index: 0U
    while: field != 0
        if: field\value = 0 || lm_trans_node_is_ignored(field\value)
            field: field\next
            continue
        indices[level]: index
        if: level + 1U = rank
            next: lm_trans_expr_segment_end(field)
            if: next = field || lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_managed_array_linear_target(file, items_name, id, indices, rank) != 0 || lm_trans_put(file, " = ") != 0
                return: 1
            if: expected_type != 0
                if: lm_trans_emit_expr_range_with_expected_type(file, field, next, namespace_, expected_type) != 0
                    return: 1
                ---
            else:
                if: lm_trans_emit_expr_fields(file, field, namespace_) != 0
                    return: 1
                ---
            if: lm_trans_put(file, ";\n") != 0
                return: 1
            field: next
            index: index + 1U
            continue
        ---

        child: lm_trans_array_initializer_nested_structure(field\value)
        if: child = 0
            c.fprintf(c.stderr, "trans L2 ArrayReference error: multidimensional initializer requires explicit nested [] groups\n")
            return: 1
        if: lm_trans_emit_managed_array_initializer_level(file, declarator, items_name, child\first_field, indent, namespace_, expected_type, id, rank, level + 1U, indices, return_on_failure) != 0
            return: 1
        field: field\next
        index: index + 1U
    ---
return: 0

fn: lm_trans_emit_managed_array_initializer (
    FILE: file
    const: LmTransCDeclarator: declarator
    const: LmP0Text: items_name
    const: LmP0Field: initializer
    unsigned: indent
    const: LmTransNamespace: namespace_
    unsigned: id
    size_t: rank
    int: element_is_const
    int: return_on_failure
) int
    const: LmP0Field: first
    const: LmP0Structure: wrapper
    LmTransL4CallableType: expected_type
    @: size_t indices
    int: status

    if: initializer = 0
        return: 0
    first: initializer
    wrapper: lm_trans_fields_single_structure_value(initializer)
    if: wrapper != 0
        first: wrapper\first_field
    if: rank > 1U && lm_trans_c_array_multidimensional_initializer_is_grouped(first) = 0
        c.fprintf(c.stderr, "trans L2 ArrayReference error: multidimensional initializer requires explicit nested [] groups\n")
        return: 1
    if: lm_trans_validate_c_array_initializer_count(declarator, initializer) != 0
        return: 1

    expected_type: lm_trans_expr_callable_type_new()
    if: expected_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(expected_type)
    if: declarator\type_is_head
        expected_type\class_name[0]: declarator\type_head[0]
    else:
        if: declarator\type_node != 0 && declarator\type_node\kind = c.LM_P0_NODE_ATOM
            expected_type\class_name[0]: declarator\type_node\as\atom[0]
        ---
    expected_type\address_depth: declarator\pointer_depth
    expected_type\is_const: element_is_const

    indices: (cast: (@: size_t) lm_own_new_zero(rank * c.sizeof(indices[0])))
    if: indices = 0
        return: 1
    status: lm_trans_emit_managed_array_initializer_level(file, declarator, items_name, first, indent, namespace_, expected_type, id, rank, 0U, indices, return_on_failure)
    lm_own_delete(indices, 0)
return: status

fn: lm_trans_emit_managed_array_declaration (
    FILE: file
    const: LmTransCDeclarator: declarator
    const: LmP0Field: initializer
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    LmP0Text: header_name
    LmP0Text: items_name
    LmP0Text: slice_type
    const: LmP0Text: element_type_name
    @: char header_name_storage
    @: char items_name_storage
    unsigned: id
    size_t: rank
    size_t: level
    int: element_is_const
    int: status

    if: declarator = 0 || declarator\name = 0 || namespace_ = 0
        return: 1
    if: namespace_\managed_message_thread_context = 0
        c.fprintf(c.stderr, "trans hosted ArrayReference limitation: ordinary [] extent construction requires a managed MessageThread context\n")
        return: 1
    if: qualifier != 0 && c.strncmp(qualifier, "static", 6U) = 0
        c.fprintf(c.stderr, "trans hosted ArrayReference limitation: top-level ordinary [] extent construction requires module/root-arena initialization\n")
        return: 1
    rank: lm_trans_array_declarator_rank(declarator)
    if: rank = 0U
        c.fprintf(c.stderr, "trans L2 ArrayReference error: ordinary [] declaration requires at least one dimension\n")
        return: 1
    element_is_const: lm_trans_qualifier_is_const(qualifier)

    id: lm_trans_next_array_value_helper_id
    lm_trans_next_array_value_helper_id: lm_trans_next_array_value_helper_id + 1U
    header_name_storage: lm_trans_managed_array_storage_name_new("reference", id)
    items_name_storage: lm_trans_managed_array_storage_name_new("items", id)
    if: header_name_storage = 0 || items_name_storage = 0
        lm_own_delete(header_name_storage, 0)
        lm_own_delete(items_name_storage, 0)
        return: 1
    finally:
        lm_own_delete(header_name_storage, 0)
        lm_own_delete(items_name_storage, 0)

    header_name: lm_trans_text_from_cstr(header_name_storage)
    items_name: lm_trans_text_from_cstr(items_name_storage)
    slice_type: lm_trans_text_ref_new_cstr("LmSlice")
    if: header_name = 0 || items_name = 0 || slice_type = 0
        lm_trans_text_ref_destroy(@ header_name)
        lm_trans_text_ref_destroy(@ items_name)
        lm_trans_text_ref_destroy(@ slice_type)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ header_name)
        lm_trans_text_ref_destroy(@ items_name)
        lm_trans_text_ref_destroy(@ slice_type)

    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0 || lm_trans_emit_managed_array_extents(file, declarator, indent, namespace_, id, 0) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_managed_array_pointer_type(file, declarator, declarator\pointer_depth + 1U, namespace_) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_emit_identifier(file, items_name) != 0 || lm_trans_put(file, " = 0;\n") != 0
        return: 1
    if: lm_trans_emit_managed_array_rectangle(file, declarator, items_name, indent, namespace_, id, rank, "lm_lmx_message_thread", "lm_message_thread_owner(lm_lmx_message_thread)", 0) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "LmSlice *") != 0 || lm_trans_emit_identifier(file, header_name) != 0 || lm_trans_put(file, " = (LmSlice *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*") != 0 || lm_trans_emit_identifier(file, header_name) != 0 || lm_trans_put(file, "));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_emit_identifier(file, header_name) != 0 || lm_trans_put(file, " == 0) abort();\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_identifier(file, header_name) != 0 || lm_trans_put(file, "->ptr = (void *)") != 0 || lm_trans_emit_identifier(file, items_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_identifier(file, header_name) != 0 || lm_trans_put(file, "->length = ") != 0 || lm_trans_emit_managed_array_cell_count_name(file, id) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_managed_array_initializer(file, declarator, items_name, initializer, indent, namespace_, id, rank, element_is_const, 0) != 0
        return: 1

    status: lm_trans_namespace_declare_c_name(namespace_, declarator\name, "variable", header_name)
    if: status = 0
        status: lm_trans_namespace_declare_relation_text(namespace_, declarator\name, "variable.type", slice_type)
    if: status = 0
        status: lm_trans_namespace_mark_array_reference(namespace_, declarator\name, rank, declarator\pointer_depth, element_is_const)
    element_type_name: 0
    if: declarator\type_is_head
        element_type_name: declarator\type_head
    if: declarator\type_is_head = 0 && declarator\type_node != 0 && declarator\type_node\kind = c.LM_P0_NODE_ATOM
        element_type_name: declarator\type_node\as\atom
    if: status = 0 && element_type_name != 0
        status: lm_trans_namespace_declare_relation_text(namespace_, declarator\name, "variable.array-element-type", element_type_name)
    if: status = 0
        status: lm_trans_namespace_declare_array_slice_expr(namespace_, declarator\name, header_name_storage)
    if: status = 0
        status: lm_trans_namespace_declare_array_helper_id(namespace_, declarator\name, id)
return: status

fn: lm_trans_emit_array_slice_value_declaration (
    FILE: file
    const: LmTransCDeclarator: declarator
    const: LmP0Structure: value
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    LmTransFormalParam: param
    LmP0Text: helper_name
    LmP0Text: header_name
    LmP0Text: slice_type
    @: char header_name_storage
    unsigned: id
    size_t: rank
    int: element_is_const
    int: status

    if: declarator = 0 || declarator\name = 0 || value = 0
        return: 1
    if: declarator\type_node = 0 || declarator\type_node\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: [] slice value declaration expects an element type\n")
        return: 1
    if: namespace_ = 0 || namespace_\managed_message_thread_context = 0
        c.fprintf(c.stderr, "trans hosted ArrayReference limitation: ordinary [] value construction requires a managed MessageThread context\n")
        return: 1
    if: qualifier != 0 && c.strncmp(qualifier, "static", 6U) = 0
        c.fprintf(c.stderr, "trans hosted ArrayReference limitation: top-level ordinary [] value construction requires module/root-arena initialization\n")
        return: 1
    if: lm_trans_array_declarator_empty_rank(declarator, @ rank) = 0
        return: 1
    element_is_const: lm_trans_qualifier_is_const(qualifier)

    param: lm_trans_formal_param_new()
    helper_name: lm_trans_statement_text_new()
    slice_type: lm_trans_text_ref_new_cstr("LmSlice")
    id: lm_trans_next_array_value_helper_id
    lm_trans_next_array_value_helper_id: lm_trans_next_array_value_helper_id + 1U
    header_name_storage: lm_trans_managed_array_storage_name_new("reference", id)
    if: header_name_storage = 0
        lm_own_delete(header_name_storage, 0)
        lm_trans_formal_param_delete(param)
        lm_trans_text_ref_destroy(@ helper_name)
        lm_trans_text_ref_destroy(@ slice_type)
        return: 1
    header_name: lm_trans_text_from_cstr(header_name_storage)
    if: param = 0 || helper_name = 0 || slice_type = 0 || header_name = 0
        lm_trans_formal_param_delete(param)
        lm_trans_text_ref_destroy(@ helper_name)
        lm_trans_text_ref_destroy(@ slice_type)
        lm_own_delete(header_name_storage, 0)
        lm_trans_text_ref_destroy(@ header_name)
        return: 1
    finally:
        lm_trans_formal_param_delete(param)
        lm_trans_text_ref_destroy(@ helper_name)
        lm_trans_text_ref_destroy(@ slice_type)
        lm_own_delete(header_name_storage, 0)
        lm_trans_text_ref_destroy(@ header_name)

    param\is_array: 1
    param\has_name: 1
    param\name[0]: declarator\name[0]
    param\declarator\type_node: declarator\type_node
    param\declarator\expression_dimensions: 0
    param\declarator\type_head[0]: declarator\type_head[0]
    param\declarator\name[0]: declarator\name[0]
    param\declarator\array_head[0]: declarator\array_head[0]
    param\declarator\pointer_depth: declarator\pointer_depth
    param\declarator\literal_dimension_count: 0U
    param\declarator\type_is_head: declarator\type_is_head
    param\declarator\allow_empty_dimensions: 1
    param\declarator\atom_dimensions_only: 1

    if: lm_trans_emit_array_value_helper(file, param, value, namespace_, helper_name) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1
    if: lm_trans_put(file, "LmSlice *") != 0 || lm_trans_emit_identifier(file, header_name) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_identifier(file, helper_name) != 0 || lm_trans_put(file, "(lm_lmx_message_thread);\n") != 0
        return: 1
    status: lm_trans_namespace_declare_c_name(namespace_, declarator\name, "variable", header_name)
    if: status = 0
        status: lm_trans_namespace_declare_relation_text(namespace_, declarator\name, "variable.type", slice_type)
    if: status = 0
        status: lm_trans_namespace_mark_array_reference(namespace_, declarator\name, rank, declarator\pointer_depth, element_is_const)
    if: status = 0
        status: lm_trans_namespace_declare_relation_text(namespace_, declarator\name, "variable.array-element-type", declarator\type_node\as\atom)
    if: status = 0
        status: lm_trans_namespace_declare_array_slice_expr(namespace_, declarator\name, header_name_storage)
    if: status = 0
        status: lm_trans_namespace_declare_array_helper_id(namespace_, declarator\name, id)
return: status

fn: lm_trans_c_array_node_requires_runtime (
    const: LmP0Node: node
    const: LmTransNamespace: namespace_
    int: allow_address_constants
) int
    const: LmP0Field: field
    const: LmTransSymbol: symbol

    if: node = 0 || lm_trans_node_is_ignored(node)
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        if: lm_trans_text_contains_char(node\as\atom, '(')
            return: 1
        if: allow_address_constants && lm_trans_namespace_value_is_c_array_storage(namespace_, node\as\atom)
            return: lm_trans_namespace_value_is_emitted_c_array_storage(namespace_, node\as\atom) = 0
        symbol: lm_trans_namespace_find(namespace_, node\as\atom)
        if: symbol = 0
            return: 0
        if: allow_address_constants && lm_trans_symbol_is_executable_callable(symbol)
            return: 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME
        if: lm_trans_text_is_array_receiver_head(node\as\frame\head) = 0
            return: 1
        field: node\as\frame\body\first_field
    else:
        if: node\kind != c.LM_P0_NODE_STRUCTURE
            return: 1
        field: node\as\structure\first_field
    ---

    while: field != 0
        if: lm_trans_c_array_node_requires_runtime(field\value, namespace_, allow_address_constants)
            return: 1
        field: field\next
return: 0

fn: lm_trans_c_array_postfix_indices_require_runtime (
    const: LmP0Field: storage_field
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: close_field
    const: LmP0Field: field
    size_t: depth

    if: storage_field = 0
        return: 1
    field: storage_field\next
    while: field != 0 && field != stop && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(field\value\as\atom, "[")
        close_field: field\next
        depth: 1U
        while: close_field != 0 && close_field != stop && depth != 0U
            if: close_field\value != 0 && close_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(close_field\value\as\atom, "[")
                depth: depth + 1U
            if: close_field\value != 0 && close_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(close_field\value\as\atom, "]")
                depth: depth - 1U
            if: depth != 0U && lm_trans_c_array_node_requires_runtime(close_field\value, namespace_, 0)
                return: 1
            close_field: close_field\next
        ---
        if: depth != 0U
            return: 1
        field: close_field
    return: field != stop

fn: lm_trans_c_array_range_is_prior_element_address_constant (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: end_field
    const: LmP0Field: range_first
    const: LmP0Field: range_stop
    const: LmP0Field: root
    size_t: index_count
    size_t: rank

    range_first: first
    range_stop: stop
    while: range_first != 0 && range_first != range_stop && range_first\next = range_stop && range_first\value != 0 && range_first\value\kind = c.LM_P0_NODE_STRUCTURE
        range_first: range_first\value\as\structure\first_field
        range_stop: 0
    if: range_first = 0 || range_first = range_stop || range_first\value = 0 || range_first\value\kind != c.LM_P0_NODE_ATOM || lm_trans_text_equals(range_first\value\as\atom, "@") = 0
        return: 0
    root: range_first\next
    if: root = 0 || root = range_stop || root\value = 0 || root\value\kind != c.LM_P0_NODE_ATOM || lm_trans_namespace_value_is_c_array_storage(namespace_, root\value\as\atom) = 0 || lm_trans_namespace_value_is_emitted_c_array_storage(namespace_, root\value\as\atom) = 0
        return: 0
    if: lm_trans_validate_c_array_postfix_index_ranges(root, range_stop, namespace_) != 0
        return: 0
    if: lm_trans_c_array_postfix_index_count(root, range_stop, @ index_count, @ end_field) != 0 || end_field != range_stop
        return: 0
    rank: lm_trans_namespace_value_c_array_rank(namespace_, root\value\as\atom)
    if: rank = 0U || index_count != rank
        return: 0
    if: lm_trans_c_array_postfix_indices_require_runtime(root, range_stop, namespace_)
        return: 0
return: 1

fn: lm_trans_c_array_initializer_fields_require_runtime (
    const: LmP0Field: first
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: cursor
    const: LmP0Field: field
    const: LmP0Field: next
    const: LmP0Node: node
    const: LmP0Structure: nested

    field: first
    while: field != 0
        node: field\value
        if: node = 0 || lm_trans_node_is_ignored(node)
            field: field\next
            continue
        nested: 0
        if: node\kind = c.LM_P0_NODE_STRUCTURE
            nested: node\as\structure
        if: node\kind = c.LM_P0_NODE_FRAME && lm_trans_text_is_array_receiver_head(node\as\frame\head)
            nested: node\as\frame\body
        if: nested != 0
            if: lm_trans_c_array_initializer_fields_require_runtime(nested\first_field, namespace_)
                return: 1
            field: field\next
            continue
        ---

        next: lm_trans_expr_segment_end(field)
        if: lm_trans_c_array_range_is_prior_element_address_constant(field, next, namespace_) = 0
            cursor: field
            while: cursor != next
                if: lm_trans_c_array_node_requires_runtime(cursor\value, namespace_, 1)
                    return: 1
                cursor: cursor\next
            ---
        ---
        field: next
return: 0

fn: lm_trans_c_array_dimension_requires_runtime (
    const: LmP0Text: dimension
    const: LmTransNamespace: namespace_
    @: int out_runtime
) int
    LmP0Document: document
    const: LmP0Node: root
    const: LmP0Field: first

    if: out_runtime != 0
        out_runtime[0]: 0
    if: dimension = 0 || dimension\length = 0U || out_runtime = 0
        return: 1

    document: 0
    if: lm_p0_parse_bytes(dimension\data, dimension\length, @ document) != 0 || document = 0
        if: document != 0
            lm_p0_document_destroy(document)
        c.fprintf(c.stderr, "trans L2 c.array error: array extent is not a valid expression\n")
        return: 1
    root: lm_p0_document_root(document)
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        lm_p0_document_destroy(document)
        c.fprintf(c.stderr, "trans L2 c.array error: array extent is not a valid expression\n")
        return: 1
    first: root\as\structure\first_field
    if: first = 0 || lm_trans_expr_segment_end(first) != 0
        lm_p0_document_destroy(document)
        c.fprintf(c.stderr, "trans L2 c.array error: array extent expects exactly one expression\n")
        return: 1

    out_runtime[0]: lm_trans_c_array_node_requires_runtime(root, namespace_, 0)
    lm_p0_document_destroy(document)
return: 0

fn: lm_trans_c_array_declarator_element_is_lmslice (
    const: LmTransCDeclarator: declarator
) int
    if: declarator = 0
        return: 0
    if: declarator\type_is_head
        return: lm_trans_text_equals(declarator\type_head, "LmSlice")
    if: declarator\type_node != 0 && declarator\type_node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_text_equals(declarator\type_node\as\atom, "LmSlice")
return: 0

fn: lm_trans_c_array_decimal_extent (
    const: LmP0Text: text
    @: size_t out_value
) int
    size_t: literal_end
    size_t: suffix_length
    size_t: index
    size_t: value
    unsigned: base
    unsigned: digit
    char: ch

    if: out_value != 0
        out_value[0]: 0U
    if: text = 0 || text\length = 0U || out_value = 0
        return: 0
    literal_end: text\length
    while: literal_end != 0U && (text\data[literal_end - 1U] = 'u' || text\data[literal_end - 1U] = 'U' || text\data[literal_end - 1U] = 'l' || text\data[literal_end - 1U] = 'L')
        literal_end: literal_end - 1U
    if: literal_end = 0U
        return: 0

    suffix_length: text\length - literal_end
    if: suffix_length > 3U
        return: 0
    if: suffix_length = 2U
        if: (text\data[literal_end] = 'u' || text\data[literal_end] = 'U') && (text\data[literal_end + 1U] = 'u' || text\data[literal_end + 1U] = 'U')
            return: 0
        if: (text\data[literal_end] = 'l' || text\data[literal_end] = 'L') && (text\data[literal_end + 1U] = 'l' || text\data[literal_end + 1U] = 'L') && text\data[literal_end] != text\data[literal_end + 1U]
            return: 0
        ---
    ---
    if: suffix_length = 3U
        if: text\data[literal_end] = 'u' || text\data[literal_end] = 'U'
            if: (text\data[literal_end + 1U] != 'l' && text\data[literal_end + 1U] != 'L') || text\data[literal_end + 2U] != text\data[literal_end + 1U]
                return: 0
            ---
        else:
            if: (text\data[literal_end] != 'l' && text\data[literal_end] != 'L') || text\data[literal_end + 1U] != text\data[literal_end] || (text\data[literal_end + 2U] != 'u' && text\data[literal_end + 2U] != 'U')
                return: 0
            ---
        ---
    ---

    base: 10U
    index: 0U
    if: literal_end > 2U && text\data[0] = '0' && (text\data[1] = 'x' || text\data[1] = 'X')
        base: 16U
        index: 2U
    else:
        if: literal_end > 1U && text\data[0] = '0'
            base: 8U
            index: 1U
        ---
    ---
    value: 0U
    while: index < literal_end
        ch: text\data[index]
        if: ch >= '0' && ch <= '9'
            digit: (cast: unsigned (ch - '0'))
        else:
            if: ch >= 'a' && ch <= 'f'
                digit: 10U + (cast: unsigned (ch - 'a'))
            else:
                if: ch >= 'A' && ch <= 'F'
                    digit: 10U + (cast: unsigned (ch - 'A'))
                else:
                    return: 0
                ---
            ---
        ---
        if: digit >= base
            return: 0
        if: value > ((cast: size_t -1) - (cast: size_t digit)) / (cast: size_t base)
            return: 0
        value: value * (cast: size_t base) + (cast: size_t digit)
        index: index + 1U
    if: (cast: size_t c.LLONG_MAX) < c.SIZE_MAX && value > (cast: size_t c.LLONG_MAX)
        return: 0
    out_value[0]: value
return: 1

fn: lm_trans_c_array_initializer_leaf_count (
    const: LmP0Field: first
    @: size_t out_count
) int
    const: LmP0Field: field
    const: LmP0Field: next
    const: LmP0Node: node
    const: LmP0Structure: nested
    size_t: nested_count

    if: out_count = 0
        return: 1
    out_count[0]: 0U
    field: first
    while: field != 0
        node: field\value
        if: node = 0 || lm_trans_node_is_ignored(node)
            field: field\next
            continue
        nested: 0
        if: node\kind = c.LM_P0_NODE_STRUCTURE
            nested: node\as\structure
        if: node\kind = c.LM_P0_NODE_FRAME && lm_trans_text_is_array_receiver_head(node\as\frame\head)
            nested: node\as\frame\body
        if: nested != 0
            if: lm_trans_c_array_initializer_leaf_count(nested\first_field, @ nested_count) != 0 || out_count[0] > (cast: size_t -1) - nested_count
                return: 1
            out_count[0]: out_count[0] + nested_count
            field: field\next
            continue
        ---
        next: lm_trans_expr_segment_end(field)
        if: out_count[0] = (cast: size_t -1)
            return: 1
        out_count[0]: out_count[0] + 1U
        field: next
return: 0

fn: lm_trans_validate_c_array_initializer_count (
    const: LmTransCDeclarator: declarator
    const: LmP0Field: initializer
) int
    LmP0Text: dimension
    const: LmP0Field: expression_dimension
    const: LmP0Node: node
    size_t: dimension_index
    size_t: extent
    size_t: initializer_count
    size_t: total

    if: declarator = 0 || initializer = 0
        return: 0
    dimension: lm_trans_statement_text_new()
    if: dimension = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ dimension)

    expression_dimension: declarator\expression_dimensions
    dimension_index: 0U
    total: 1U
    while: lm_trans_array_head_next_dimension(declarator\array_head, @ dimension_index, dimension)
        if: dimension\length != 0U
            if: lm_trans_c_array_decimal_extent(dimension, @ extent) = 0
                return: 0
            ---
        else:
            if: expression_dimension = 0
                return: 0
            node: expression_dimension\value
            if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || lm_trans_c_array_decimal_extent(node\as\atom, @ extent) = 0
                return: 0
            expression_dimension: expression_dimension\next
        ---
        if: extent != 0U && total > (cast: size_t -1) / extent
            return: 0
        total: total * extent
    ---

    if: lm_trans_c_array_initializer_leaf_count(initializer, @ initializer_count) != 0
        return: 1
    if: initializer_count > total
        c.fprintf(c.stderr, "trans L2 c.array error: initializer has %zu elements for storage with %zu elements\n", initializer_count, total)
        return: 1
return: 0

fn: lm_trans_validate_c_array_initializer_fields (
    const: LmP0Field: first
    const: LmTransNamespace: namespace_
    const: LmP0Text: element_class
    size_t: element_address_depth
    int: element_base_is_const
    int: element_is_lmslice
) int
    const: LmP0Field: field
    const: LmP0Field: next
    const: LmP0Node: node
    const: LmP0Structure: nested

    field: first
    while: field != 0
        node: field\value
        if: node = 0 || lm_trans_node_is_ignored(node)
            field: field\next
            continue
        nested: 0
        if: node\kind = c.LM_P0_NODE_STRUCTURE
            nested: node\as\structure
        if: node\kind = c.LM_P0_NODE_FRAME && lm_trans_text_is_array_receiver_head(node\as\frame\head)
            nested: node\as\frame\body
        if: nested != 0
            if: lm_trans_validate_c_array_initializer_fields(nested\first_field, namespace_, element_class, element_address_depth, element_base_is_const, element_is_lmslice) != 0
                return: 1
            field: field\next
            continue
        ---

        next: lm_trans_expr_segment_end(field)
        if: lm_trans_guard_c_array_value_range(field, next, namespace_, element_class, element_address_depth, element_base_is_const, "c.array element initializer") != 0
            return: 1
        if: lm_trans_guard_known_raw_pointer_range(field, next, namespace_, element_class, element_address_depth, element_base_is_const, "c.array element initializer") != 0
            return: 1
        if: lm_trans_range_has_direct_array_reference(field, next, namespace_) && (element_address_depth != 1U || element_is_lmslice = 0 || lm_trans_range_is_direct_array_reference_address(field, next, namespace_) = 0) && (element_address_depth = 0U || lm_trans_range_is_array_reference_data_pointer(field, next, namespace_) = 0)
            c.fprintf(c.stderr, "trans L2 type error: c.array element initializer cannot consume an ArrayReference without an explicit raw-storage adapter\n")
            return: 1
        field: next
return: 0

fn: lm_trans_c_array_multidimensional_initializer_is_grouped (
    const: LmP0Field: first
) int
    const: LmP0Field: field
    const: LmP0Node: node

    field: first
    while: field != 0
        node: field\value
        if: node = 0 || lm_trans_node_is_ignored(node)
            field: field\next
            continue
        if: node\kind != c.LM_P0_NODE_STRUCTURE && (node\kind != c.LM_P0_NODE_FRAME || lm_trans_text_is_array_receiver_head(node\as\frame\head) = 0)
            return: 0
        field: field\next
return: 1

fn: lm_trans_validate_c_array_declarator (
    const: LmTransCDeclarator: declarator
    const: LmP0Field: initializer
    const: LmTransNamespace: namespace_
    int: is_static
    int: element_base_is_const
) int
    LmP0Text: dimension
    const: LmP0Field: expression_dimension
    const: LmP0Text: element_class
    size_t: dimension_index
    int: dimension_runtime
    int: runtime_extent

    if: declarator = 0 || declarator\array_head = 0
        return: 1
    if: initializer != 0 && lm_trans_array_declarator_rank(declarator) > 1U && lm_trans_c_array_multidimensional_initializer_is_grouped(initializer) = 0
        c.fprintf(c.stderr, "trans L2 c.array error: multidimensional initializer requires explicit nested [] groups\n")
        return: 1
    ---
    dimension: lm_trans_statement_text_new()
    if: dimension = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ dimension)

    dimension_index: 0U
    expression_dimension: declarator\expression_dimensions
    runtime_extent: 0
    while: lm_trans_array_head_next_dimension(declarator\array_head, @ dimension_index, dimension)
        if: dimension\length != 0U
            if: lm_trans_c_array_dimension_requires_runtime(dimension, namespace_, @ dimension_runtime) != 0
                return: 1
            if: dimension_runtime
                runtime_extent: 1
            ---
        else:
            if: expression_dimension = 0 || expression_dimension\value = 0 || lm_trans_array_body_dimension_can_consume(expression_dimension) = 0
                c.fprintf(c.stderr, "trans L2 c.array error: c.array dimension expects a size expression\n")
                return: 1
            if: lm_trans_c_array_node_requires_runtime(expression_dimension\value, namespace_, 0)
                runtime_extent: 1
            expression_dimension: expression_dimension\next
        ---
    ---

    element_class: 0
    if: declarator\type_is_head
        element_class: declarator\type_head
    if: declarator\type_is_head = 0 && declarator\type_node != 0 && declarator\type_node\kind = c.LM_P0_NODE_ATOM
        element_class: declarator\type_node\as\atom
    if: initializer != 0 && lm_trans_validate_c_array_initializer_fields(initializer, namespace_, element_class, declarator\pointer_depth, element_base_is_const, lm_trans_c_array_declarator_element_is_lmslice(declarator)) != 0
        return: 1
    if: initializer != 0 && lm_trans_validate_c_array_initializer_count(declarator, initializer) != 0
        return: 1

    if: is_static && runtime_extent
        c.fprintf(c.stderr, "trans L2 c.array error: top-level extent must be a C integer constant expression\n")
        return: 1
    if: initializer != 0 && runtime_extent
        c.fprintf(c.stderr, "trans L2 c.array error: a variable-length c.array cannot have an initializer\n")
        return: 1
    if: is_static
        if: lm_trans_c_array_initializer_fields_require_runtime(initializer, namespace_)
            c.fprintf(c.stderr, "trans L2 c.array error: top-level initializer must be a C constant initializer\n")
            return: 1
        ---
    ---
return: 0

fn: lm_trans_emit_array_declaration_core (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
    int: allow_array_reference_semantics
) int
    const: LmP0Field: initializer_field
    const: LmP0Structure: slice_value
    LmTransCDeclarator: declarator
    int: status

    declarator: lm_trans_statement_c_declarator_new()
    if: declarator = 0
        return: 1
    finally: lm_trans_statement_c_declarator_destroy(declarator)

    if: allow_array_reference_semantics = 0
        declarator\atom_dimensions_only: 1

    if: lm_trans_array_declarator_read_from_frame(declarator, frame, namespace_, 1, 1, 1, "trans L2 error: [] declaration expects [@...] type name size...", "trans L2 error: array pointer declaration expects type and name", "trans L2 error: array declaration expects a type/name declaration") != 0
        return: 1

    initializer_field: lm_trans_c_declarator_expression_dimension_tail(declarator)
    if: allow_array_reference_semantics = 0 && lm_trans_validate_c_array_declarator(declarator, initializer_field, namespace_, qualifier != 0 && (c.strcmp(qualifier, "static ") = 0 || c.strcmp(qualifier, "static const ") = 0), lm_trans_qualifier_is_const(qualifier)) != 0
        return: 1

    slice_value: lm_trans_array_declarator_single_structure_value(declarator)
    if: slice_value != 0
        if: allow_array_reference_semantics = 0
            c.fprintf(c.stderr, "trans L2 c.array error: c.array requires explicit machine extents and cannot construct an ArrayReference value\n")
            return: 1
        ---
        return: lm_trans_emit_array_slice_value_declaration(file, declarator, slice_value, indent, namespace_, qualifier)

    if: allow_array_reference_semantics
        return: lm_trans_emit_managed_array_declaration(file, declarator, initializer_field, indent, namespace_, qualifier)

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1

    if: lm_trans_emit_c_declarator(file, declarator, namespace_, "[] array dimension") != 0
        return: 1

    if: initializer_field != 0 && lm_trans_emit_array_initializer(file, initializer_field, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: declarator\type_is_head
        status: lm_trans_namespace_declare_storage_binding(namespace_, declarator\name, declarator\type_head)
    else:
        status: lm_trans_namespace_declare_node_storage_binding(namespace_, declarator\name, declarator\type_node)
    ---
    if: status = 0 && allow_array_reference_semantics = 0
        status: lm_trans_namespace_mark_c_array_storage(namespace_, declarator\name, lm_trans_array_declarator_rank(declarator), declarator\pointer_depth, lm_trans_qualifier_is_const(qualifier))
    if: status = 0 && allow_array_reference_semantics = 0
        status: lm_trans_namespace_mark_c_array_emitted(namespace_, declarator\name)
return: status

fn: lm_trans_emit_array_declaration_with_qualifier (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
return: lm_trans_emit_array_declaration_core(file, frame, indent, namespace_, qualifier, 1)

fn: lm_trans_emit_c_array_declaration_with_qualifier (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    const: LmP0Frame: declaration
    int: is_const

    if: lm_trans_c_array_declaration_parts(frame, @ declaration, @ is_const) != 0
        return: 1
    if: is_const
        if: qualifier != 0 && c.strcmp(qualifier, "static ") = 0
            return: lm_trans_emit_array_declaration_core(file, declaration, indent, namespace_, "static const ", 0)
        if: qualifier != 0 && qualifier[0] != '\0'
            c.fprintf(c.stderr, "trans L2 c.array error: unsupported storage qualifier for const c.array\n")
            return: 1
        return: lm_trans_emit_array_declaration_core(file, declaration, indent, namespace_, "const ", 0)
    ---
return: lm_trans_emit_array_declaration_core(file, declaration, indent, namespace_, qualifier, 0)

fn: lm_trans_emit_array_declaration (
    FILE: file
    const: LmP0Frame: frame
