        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "int lm_lmx_application_exit_status = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "int lm_lmx_application_exit_snapshot_requested = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "int lm_lmx_application_exit_snapshot_ready = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "int lm_lmx_application_exit_snapshot_status = 0;\n") != 0
        return: 1
    if: thread_count != 0U
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct LmMessageThreadPool *lm_lmx_application_pool = 0;\n") != 0
            return: 1
        if: lm_trans_put(file, "#ifdef LM_REST_LMX_INSTALL_DEFAULT_SERVER\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "LmRestLmxHttpServer *lm_lmx_rest_lmx_http_server = 0;\n") != 0
            return: 1
        if: lm_trans_put(file, "#endif\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "int lm_lmx_declared_thread_status = 0;\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "int lm_lmx_declared_thread_failure_status = 0;\n") != 0
            return: 1
        index: 0U
        while: index < thread_count
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_message_thread_main_indexed_text(file, "struct LmMessageThread *lm_lmx_declared_thread_%zu = 0;\n", index) != 0
                return: 1
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_message_thread_main_indexed_text(file, "int lm_lmx_declared_thread_%zu_started = 0;\n", index) != 0
                return: 1
            index: index + 1U
    ---
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_lmx_message_thread = lm_message_thread_new();\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_lmx_message_thread == 0) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return 1;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || c.fputs("lm_lmx_message_thread = ", file) < 0 || lm_trans_put(file, "lm_lmx_message_thread;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || c.fputs("(void)lm_lmx_message_thread;\n", file) < 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "(void)lm_message_thread_set_execution_context(lm_lmx_message_thread, &lm_message_thread_main_context);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_lmx_application_runtime = lm_message_thread_runtime_new();\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_lmx_application_runtime == 0) lm_lmx_thread_startup_failed = 1;\n") != 0
        return: 1
    if: lm_trans_put(file, "#ifdef LM_REST_LMX_INSTALL_DEFAULT_CLIENT\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (!lm_lmx_thread_startup_failed && lm_rest_lmx_http_client_install_default(lm_lmx_application_runtime) != 0) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "(void)lm_message_thread_runtime_delete(lm_lmx_application_runtime);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "lm_lmx_application_runtime = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "lm_message_thread_delete(lm_lmx_message_thread);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return 1;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_put(file, "#endif\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (!lm_lmx_thread_startup_failed && lm_message_thread_runtime_attach_root(lm_lmx_application_runtime, lm_lmx_message_thread) != 0) lm_lmx_thread_startup_failed = 1; else if (!lm_lmx_thread_startup_failed) lm_lmx_application_root_attached = 1;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (!lm_lmx_thread_startup_failed) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "lm_message_thread_main_context.diagnostic_code = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (setjmp(lm_message_thread_main_context.diagnostic_root) == 0) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_put(file, dispatcher_name) != 0 || lm_trans_put(file, "(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread)) != 0) lm_lmx_thread_startup_failed = 1;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "} else {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_lmx_thread_startup_failed = 1;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: thread_count != 0U
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (!lm_lmx_thread_startup_failed) {\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "lm_lmx_application_pool = lm_message_thread_pool_new(lm_lmx_application_runtime, 1U);\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (lm_lmx_application_pool == 0) lm_lmx_thread_startup_failed = 1;\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1

        index: 0U
        while: index < thread_count
            declaration: (cast: (const: LmTransThreadDeclaration) lm_own_ptr_stack_at(namespace_\thread_declarations, index))
            if: declaration = 0
                return: 1
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_message_thread_main_indexed_text(file, "if (!lm_lmx_thread_startup_failed) lm_lmx_declared_thread_%zu = lm_message_thread_new_in(lm_lmx_application_pool);\n", index) != 0
                return: 1
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_message_thread_main_indexed_text(file, "if (!lm_lmx_thread_startup_failed && lm_lmx_declared_thread_%zu == 0) lm_lmx_thread_startup_failed = 1;\n", index) != 0
                return: 1
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_message_thread_main_indexed_text(file, "if (!lm_lmx_thread_startup_failed && lm_message_thread_start_mailbox(lm_lmx_declared_thread_%zu, ", index) != 0 || lm_trans_write_text(file, declaration\c_name) != 0 || lm_trans_put(file, ", 0) != 0) lm_lmx_thread_startup_failed = 1;\n") != 0
                return: 1
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_message_thread_main_indexed_text(file, "if (!lm_lmx_thread_startup_failed) lm_lmx_declared_thread_%zu_started = 1;\n", index) != 0
                return: 1
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_message_thread_main_indexed_text(file, "if (!lm_lmx_thread_startup_failed && lm_message_thread_bind_route(lm_lmx_declared_thread_%zu, ", index) != 0 || lm_trans_write_text(file, declaration\route_literal) != 0 || lm_trans_put(file, ") != 0) lm_lmx_thread_startup_failed = 1;\n") != 0
                return: 1
            index: index + 1U
        if: lm_trans_put(file, "#ifdef LM_REST_LMX_INSTALL_DEFAULT_SERVER\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (!lm_lmx_thread_startup_failed && lm_rest_lmx_http_server_start_default(lm_lmx_application_runtime, &lm_lmx_rest_lmx_http_server) != 0) lm_lmx_thread_startup_failed = 1;\n") != 0
            return: 1
        if: lm_trans_put(file, "#endif\n") != 0
            return: 1
    ---
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_lmx_thread_startup_failed) lm_message_thread_request_failure(lm_lmx_message_thread, 1);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "while (lm_message_thread_begin_turn(lm_lmx_message_thread)) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (lm_lmx_application_controller_failure) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_message_thread_request_failure(lm_lmx_message_thread, 1);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "goto lm_message_thread_turn_end;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (lm_lmx_application_exit_ready) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_message_thread_request_stop(lm_lmx_message_thread, lm_lmx_application_exit_status);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "goto lm_message_thread_turn_end;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "lm_message_thread_main_context.diagnostic_code = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (setjmp(lm_message_thread_main_context.diagnostic_root) == 0) {\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_message_thread_main_end (
    FILE: file
    unsigned: indent
    const: (LmTransNamespace: namespace_)
) int
    size_t: thread_count
    size_t: index

    if: lm_trans_module_init_names_prepare() != 0
        return: 1
    thread_count: 0U
    if: namespace_ != 0 && namespace_\thread_declarations != 0
        thread_count: namespace_\thread_declarations\count

    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "} else {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_message_thread_request_failure(lm_lmx_message_thread, lm_message_thread_diagnostic_status(&lm_message_thread_main_context));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_message_thread_turn_end:\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "(void)lm_message_thread_end_turn(lm_lmx_message_thread);\n") != 0
        return: 1
    if: lm_trans_emit_message_thread_main_exit_safe_point(file, indent + 1U, thread_count != 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_message_thread_main_exit_query(file, indent, 1) != 0
        return: 1
    if: thread_count != 0U
        if: lm_trans_put(file, "#ifdef LM_REST_LMX_INSTALL_DEFAULT_SERVER\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_lmx_rest_lmx_http_server != 0 && (lm_rest_lmx_http_server_stop(&lm_lmx_rest_lmx_http_server) != 0 || lm_lmx_rest_lmx_http_server != 0)) lm_lmx_thread_cleanup_failed = 1;\n") != 0
            return: 1
        if: lm_trans_put(file, "#endif\n") != 0
            return: 1
        ---
    if: lm_trans_emit_message_thread_main_exit_stop_if_ready(file, indent, thread_count != 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_message_thread_exit_status = lm_message_thread_status(lm_lmx_message_thread);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_lmx_application_runtime != 0 && lm_lmx_application_root_attached) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (lm_message_thread_runtime_detach_root(lm_lmx_application_runtime, lm_lmx_message_thread) != 0) lm_lmx_thread_cleanup_failed = 1; else lm_lmx_application_root_attached = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: thread_count != 0U
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_lmx_application_pool != 0) {\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (lm_lmx_thread_startup_failed || lm_lmx_application_root_attached || lm_lmx_application_exit_ready) {\n") != 0
            return: 1
        index: 0U
        while: index < thread_count
            if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_emit_message_thread_main_indexed_text(file, "if (lm_lmx_declared_thread_%zu_started) lm_message_thread_request_stop(lm_lmx_declared_thread_%zu, 0);\n", index) != 0
                return: 1
            index: index + 1U
        if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_message_thread_pool_request_stop(lm_lmx_application_pool);\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "} else {\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "lm_message_thread_pool_request_stop_when_idle(lm_lmx_application_pool);\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        index: 0U
        while: index < thread_count
            if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_message_thread_main_indexed_text(file, "if (lm_lmx_declared_thread_%zu_started) { if (lm_message_thread_join(lm_lmx_declared_thread_%zu, &lm_lmx_declared_thread_status) != 0) lm_lmx_thread_cleanup_failed = 1; else if (lm_lmx_declared_thread_status != 0 && lm_lmx_declared_thread_failure_status == 0) lm_lmx_declared_thread_failure_status = lm_lmx_declared_thread_status; }\n", index) != 0
                return: 1
            index: index + 1U
        if: lm_trans_emit_message_thread_main_exit_query(file, indent, 0) != 0
            return: 1
        if: lm_trans_emit_message_thread_main_exit_stop_if_ready(file, indent, 1) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_lmx_application_pool != 0) {\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (lm_message_thread_pool_delete(lm_lmx_application_pool) != 0) lm_lmx_thread_cleanup_failed = 1; else lm_lmx_application_pool = 0;\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
    ---
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_lmx_application_runtime != 0 && !lm_lmx_application_root_attached") != 0
        return: 1
    if: thread_count != 0U && lm_trans_put(file, " && lm_lmx_application_pool == 0") != 0
        return: 1
    if: lm_trans_put(file, ") {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (lm_message_thread_runtime_delete(lm_lmx_application_runtime) != 0) lm_lmx_thread_cleanup_failed = 1; else lm_lmx_application_runtime = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_message_thread_exit_status == 0 && lm_lmx_application_exit_requested && lm_lmx_application_exit_status != 0) lm_message_thread_exit_status = lm_lmx_application_exit_status;\n") != 0
        return: 1
    if: thread_count != 0U
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_message_thread_exit_status == 0 && lm_lmx_declared_thread_failure_status != 0) lm_message_thread_exit_status = lm_lmx_declared_thread_failure_status;\n") != 0
            return: 1
    ---
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_message_thread_exit_status == 0 && lm_lmx_thread_cleanup_failed) lm_message_thread_exit_status = 1;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (!lm_lmx_application_root_attached) lm_message_thread_delete(lm_lmx_message_thread);\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "return lm_message_thread_exit_status;\n") != 0
        return: 1
return: 0

fn: lm_trans_return_fields_single_atom (
    const: LmP0Field: return_fields
    LmP0Text: out_atom
) int
    if: out_atom = 0 || return_fields = 0 || return_fields\next != 0 || return_fields\value = 0 || return_fields\value\kind != c.LM_P0_NODE_ATOM
        return: 0

    out_atom[0]: return_fields\value\as\atom[0]
return: 1

fn: lm_trans_fields_single_structure_value (
    const: LmP0Field: fields
) const: LmP0Structure
    if: fields = 0 || fields\next != 0 || fields\value = 0 || fields\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

return: fields\value\as\structure

fn: lm_trans_structure_field_count (const: (LmP0Structure: structure)) size_t
    const: LmP0Field: field
    size_t: count

    count: 0U
    field: 0
    if: structure != 0
        field: structure\first_field
    while: field != 0
        count: count + 1U
        field: field\next

return: count

fn: lm_trans_emit_size_literal (FILE: file; size_t: value) int
    if: c.fprintf(file, "%zuU", value) < 0
        return: 1
return: 0

fn: lm_trans_emit_array_pointer_type (
    FILE: file
    const: LmP0Node: element_type
    size_t: pointer_depth
    const: LmTransNamespace: namespace_
) int
    size_t: i

    if: lm_trans_emit_type_node(file, element_type, namespace_) != 0
        return: 1
    if: pointer_depth = 0U
        return: 0
    if: lm_trans_put(file, " ") != 0
        return: 1
    i: 0U
    while: i < pointer_depth
        if: lm_trans_put(file, "*") != 0
            return: 1
        i: i + 1U
return: 0

fn: lm_trans_emit_array_target_path (
    FILE: file
    const: LmP0Text: target_name
    const: @(size_t indices)
    size_t: depth
) int
    size_t: i
    size_t: index_value

    if: target_name = 0 || lm_trans_emit_identifier(file, target_name) != 0
        return: 1
    i: 0U
    while: i < depth
        index_value: 0U
        if: indices != 0
            index_value: indices[i]
        if: lm_trans_put(file, "[") != 0
            return: 1
        if: lm_trans_emit_size_literal(file, index_value) != 0
            return: 1
        if: lm_trans_put(file, "]") != 0
            return: 1
        i: i + 1U
return: 0

fn: lm_trans_emit_array_structure_value_alloc_assignment (
    FILE: file
    unsigned: indent
    const: LmP0Text: target_name
    const: @(size_t indices)
    size_t: depth
    const: LmP0Node: element_type
    size_t: pointer_depth
    size_t: rank
    size_t: count
    const: LmTransNamespace: namespace_
    const: @(char thread_expression)
    const: @(char arena_expression)
) int
    if: thread_expression = 0 || arena_expression = 0
        return: 1
    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_array_target_path(file, target_name, indices, depth) != 0
        return: 1
    if: count = 0U
        return: lm_trans_put(file, " = 0;\n")

    if: lm_trans_put(file, " = (") != 0
        return: 1
    if: lm_trans_emit_array_pointer_type(file, element_type, pointer_depth, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ")lm_own_arena_array_new_zero(") != 0 || lm_trans_put(file, thread_expression) != 0 || lm_trans_put(file, ", ") != 0 || lm_trans_put(file, arena_expression) != 0 || lm_trans_put(file, ", sizeof(*") != 0
        return: 1
    if: lm_trans_emit_array_target_path(file, target_name, indices, depth) != 0
        return: 1
    if: lm_trans_put(file, "), ") != 0
        return: 1
    if: lm_trans_emit_size_literal(file, count) != 0
        return: 1
    if: lm_trans_put(file, ", ") != 0
        return: 1
    if: lm_trans_emit_size_literal(file, rank) != 0
        return: 1
    if: lm_trans_put(file, ", ") != 0
        return: 1
    if: lm_trans_emit_size_literal(file, depth) != 0
        return: 1
return: lm_trans_put(file, ");\n")

fn: lm_trans_emit_array_null_return_check (
    FILE: file
    unsigned: indent
    const: LmP0Text: target_name
    const: @(size_t indices)
    size_t: depth
    const: LmTransNamespace: namespace_
    int: return_error_status
) int
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0
        return: 1
    if: lm_trans_emit_array_target_path(file, target_name, indices, depth) != 0
        return: 1
    if: lm_trans_put(file, " == 0) {\n") != 0
        return: 1
    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0
        return: 1
    if: return_error_status
        if: lm_trans_put(file, "return 1;\n") != 0
            return: 1
        ---
    else:
        if: lm_trans_put(file, "return 0;\n") != 0
            return: 1
        ---
    ---
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
return: lm_trans_put(file, "}\n")

fn: lm_trans_array_structure_value_fill_frame_new (
    const: LmP0Field: field
    size_t: depth
) LmTransArrayStructureValueFillFrame
    LmTransArrayStructureValueFillFrame: frame

    frame: (cast: (LmTransArrayStructureValueFillFrame) lm_own_new_zero(c.sizeof(frame[0])))
    if: frame != 0
        frame\field: field
        frame\depth: depth
        frame\index: 0U
return: frame

fn: lm_trans_emit_array_structure_value_fill_iterative (
    FILE: file
    unsigned: indent
    const: LmP0Text: target_name
    const: LmP0Node: element_type
    size_t: rank
    size_t: depth
    const: LmP0Structure: value
    const: LmTransNamespace: namespace_
    @: size_t indices
    const: @(char thread_expression)
    const: @(char arena_expression)
    int: return_error_status
) int
    LmOwnPtrStack: stack
    LmTransArrayStructureValueFillFrame: frame
    const: LmP0Field: field
    const: LmP0Structure: child
    size_t: count
    size_t: current_depth
    size_t: index
    int: status

    if: rank = 0U || depth >= rank
        return: 1
    if: value = 0 || value\first_field = 0
        return: 0

    stack: lm_trans_ptr_stack_new(c.lm_own_delete_plain)
    if: stack = 0
        return: 1
    finally: lm_trans_ptr_stack_delete(@ stack)

    frame: lm_trans_array_structure_value_fill_frame_new(value\first_field, depth)
    if: frame = 0
        return: 1
    if: lm_own_ptr_stack_push(stack, frame) != 0
        lm_own_delete(frame, 0)
        return: 1

    status: 0
    while: status = 0 && stack\count != 0U
        frame: (cast: (LmTransArrayStructureValueFillFrame) lm_own_ptr_stack_top(stack))
        if: frame = 0 || frame\field = 0
            lm_own_delete(lm_own_ptr_stack_pop(stack), 0)
            continue

        field: frame\field
        current_depth: frame\depth
        index: frame\index
        frame\field: frame\field\next
        frame\index: frame\index + 1U
        indices[current_depth]: index

        if: current_depth + 1U = rank
            if: lm_trans_emit_indent(file, indent) != 0
                status: 1
                break
            if: lm_trans_emit_array_target_path(file, target_name, indices, current_depth + 1U) != 0
                status: 1
                break
            if: lm_trans_put(file, " = ") != 0
                status: 1
                break
            if: lm_trans_emit_expr_node(file, field\value, namespace_) != 0
                status: 1
                break
            if: lm_trans_put(file, ";\n") != 0
                status: 1
                break
            continue

        if: field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
            c.fprintf(c.stderr, "trans L2 error: [] multi-dimensional Structure value expects nested [] Structure fields\n")
            status: 1
            break
        child: field\value\as\structure
        count: lm_trans_structure_field_count(child)
        if: lm_trans_emit_array_structure_value_alloc_assignment(file, indent, target_name, indices, current_depth + 1U, element_type, rank - current_depth - 1U, rank, count, namespace_, thread_expression, arena_expression) != 0
            status: 1
            break
        if: count != 0U && lm_trans_emit_array_null_return_check(file, indent, target_name, indices, current_depth + 1U, namespace_, return_error_status) != 0
            status: 1
            break
        if: child != 0 && child\first_field != 0
            frame: lm_trans_array_structure_value_fill_frame_new(child\first_field, current_depth + 1U)
            if: frame = 0
                status: 1
                break
            if: lm_own_ptr_stack_push(stack, frame) != 0
                lm_own_delete(frame, 0)
                status: 1
                break
            ---
        ---

return: status

fn: lm_trans_emit_array_structure_value_fill (
    FILE: file
    unsigned: indent
    const: LmP0Text: target_name
    const: LmP0Node: element_type
    size_t: rank
    const: LmP0Structure: value
    const: LmTransNamespace: namespace_
    const: @(char thread_expression)
    const: @(char arena_expression)
    int: return_error_status
) int
    @: size_t indices
    int: status

    if: rank = 0U
        return: 1
    indices: (cast: (@: size_t) lm_own_new_zero(rank * c.sizeof(indices[0])))
    if: indices = 0
        return: 1
    finally: lm_own_delete(indices, 0)

    status: lm_trans_emit_array_structure_value_fill_iterative(file, indent, target_name, element_type, rank, 0U, value, namespace_, indices, thread_expression, arena_expression, return_error_status)
return: status

fn: lm_trans_type_receiver_array_structure_value_alloc (
    FILE: file
    unsigned: indent
    const: LmP0Node: type_node
    const: LmP0Text: target_name
    const: LmP0Structure: value
    const: LmTransNamespace: namespace_
    @: int out_consumed
    @: int out_needs_null_check
) int
    const: LmP0Node: element_type
    size_t: rank
    size_t: count
    int: type_status
    @: char items_name_storage
    LmP0Text: items_name

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_needs_null_check != 0
        out_needs_null_check[0]: 0
    if: out_consumed = 0 || out_needs_null_check = 0 || target_name = 0 || value = 0
        return: 0

    type_status: lm_trans_array_type_node_info(type_node, @ element_type, @ rank)
    if: type_status < 0
        return: 1
    if: type_status = 0
        return: 0

    out_consumed[0]: 1
    count: lm_trans_structure_field_count(value)
    out_needs_null_check[0]: 1

    items_name_storage: lm_trans_array_items_name_new(target_name)
    if: items_name_storage = 0
        return: 1
    finally: lm_own_delete(items_name_storage, 0)

    items_name: lm_trans_text_from_cstr(items_name_storage)
    if: items_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ items_name)

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_array_pointer_type(file, element_type, rank, namespace_) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_write_text(file, items_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_array_structure_value_alloc_assignment(file, indent, items_name, 0, 0U, element_type, rank, rank, count, namespace_, "lm_lmx_message_thread", "lm_message_thread_owner(lm_lmx_message_thread)") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: count != 0U
        if: lm_trans_put(file, "if (") != 0 || lm_trans_write_text(file, items_name) != 0 || lm_trans_put(file, " != 0) {\n") != 0
            return: 1
        ---
    else:
        if: lm_trans_put(file, "if (1) {\n") != 0
            return: 1
        ---
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_write_text(file, target_name) != 0 || lm_trans_put(file, " = (LmSlice *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*") != 0 || lm_trans_write_text(file, target_name) != 0 || lm_trans_put(file, "));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_write_text(file, target_name) != 0 || lm_trans_put(file, " != 0) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_write_text(file, target_name) != 0 || lm_trans_put(file, "->ptr = (void *)") != 0 || lm_trans_write_text(file, items_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_write_text(file, target_name) != 0 || lm_trans_put(file, "->length = ") != 0 || lm_trans_emit_size_literal(file, count) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "} else {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_write_text(file, target_name) != 0 || lm_trans_put(file, " = 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

fn: lm_trans_type_receiver_structure_value_can_consume (
    const: LmP0Node: type_node
