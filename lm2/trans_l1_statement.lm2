    c_type_name: lm_trans_text_from_cstr(entry\c_type_name)
    slot_name: lm_trans_text_from_cstr(entry\slot_name)
    value_name_storage: lm_trans_l2_object_suffix_name_new(entry\helper_name, "_value")
    value_name: lm_trans_text_from_cstr(value_name_storage)
    thread_name: lm_trans_module_init_thread_name()
    arena_name: lm_trans_module_init_arena_name()
    if: c_type_name = 0 || slot_name = 0 || value_name_storage = 0 || value_name = 0 || thread_name = 0 || arena_name = 0
        lm_trans_text_ref_destroy(@ c_type_name)
        lm_trans_text_ref_destroy(@ slot_name)
        lm_trans_text_ref_destroy(@ value_name)
        lm_own_delete(value_name_storage, 0)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ c_type_name)
        lm_trans_text_ref_destroy(@ slot_name)
        lm_trans_text_ref_destroy(@ value_name)
        lm_own_delete(value_name_storage, 0)

    if: lm_trans_put(file, "    ") != 0 || lm_trans_emit_identifier(file, c_type_name) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, " = (") != 0 || lm_trans_emit_identifier(file, c_type_name) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(") != 0 || lm_trans_put(file, thread_name) != 0 || lm_trans_put(file, ", ") != 0 || lm_trans_put(file, arena_name) != 0 || lm_trans_put(file, ", sizeof(*") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, "));\n") != 0
        return: 1
    if: lm_trans_put(file, "    if (") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, " == 0) return 1;\n") != 0
        return: 1
    if: lm_trans_emit_anonymous_structure_initializers(file, value_body, result_name, value_name, entry\descriptor, 1U, namespace_) != 0
        return: 1
    if: lm_trans_module_init_emit_slot_root(file, slot_name, value_name) != 0
        return: 1
return: 0

fn: lm_trans_module_init_emit_array_reference_initializer (
    FILE: file
    const: LmP0Frame: frame
    int: element_is_const
    const: LmTransModuleInitEntry: entry
    LmTransNamespace: namespace_
) int
    LmTransCDeclarator: declarator
    const: LmP0Field: initializer
    const: LmP0Structure: slice_value
    const: LmP0Node: element_type
    LmP0Text: slot_name
    LmP0Text: value_name
    LmP0Text: items_name
    @: char value_name_storage
    @: char items_name_storage
    const: @: char thread_name
    const: @: char arena_name
    size_t: rank
    size_t: level
    size_t: count

    declarator: lm_trans_module_init_array_declarator_new(frame, namespace_)
    if: declarator = 0 || entry = 0 || entry\slot_name = 0
        lm_trans_statement_c_declarator_destroy(declarator)
        return: 1
    finally: lm_trans_statement_c_declarator_destroy(declarator)
    rank: lm_trans_array_declarator_rank(declarator)
    if: rank = 0U || lm_trans_module_init_emit_helper_open(file, entry) != 0
        return: 1

    slot_name: lm_trans_text_from_cstr(entry\slot_name)
    value_name_storage: lm_trans_l2_object_suffix_name_new(entry\helper_name, "_value")
    items_name_storage: lm_trans_l2_object_suffix_name_new(entry\helper_name, "_items")
    value_name: lm_trans_text_from_cstr(value_name_storage)
    items_name: lm_trans_text_from_cstr(items_name_storage)
    thread_name: lm_trans_module_init_thread_name()
    arena_name: lm_trans_module_init_arena_name()
    if: slot_name = 0 || value_name_storage = 0 || items_name_storage = 0 || value_name = 0 || items_name = 0 || thread_name = 0 || arena_name = 0
        lm_trans_text_ref_destroy(@ slot_name)
        lm_trans_text_ref_destroy(@ value_name)
        lm_trans_text_ref_destroy(@ items_name)
        lm_own_delete(value_name_storage, 0)
        lm_own_delete(items_name_storage, 0)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ slot_name)
        lm_trans_text_ref_destroy(@ value_name)
        lm_trans_text_ref_destroy(@ items_name)
        lm_own_delete(value_name_storage, 0)
        lm_own_delete(items_name_storage, 0)

    slice_value: lm_trans_array_declarator_single_structure_value(declarator)
    initializer: lm_trans_c_declarator_expression_dimension_tail(declarator)
    if: slice_value != 0
        element_type: declarator\type_node
        count: lm_trans_structure_field_count(slice_value)
        if: element_type = 0 || lm_trans_put(file, "    ") != 0 || lm_trans_emit_managed_array_pointer_type(file, declarator, declarator\pointer_depth + rank, namespace_) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_emit_identifier(file, items_name) != 0 || lm_trans_put(file, " = 0;\n") != 0
            return: 1
        if: lm_trans_emit_array_structure_value_alloc_assignment(file, 1U, items_name, 0, 0U, element_type, declarator\pointer_depth + rank, rank, count, namespace_, thread_name, arena_name) != 0
            return: 1
        if: count != 0U && (lm_trans_put(file, "    if (") != 0 || lm_trans_emit_identifier(file, items_name) != 0 || lm_trans_put(file, " == 0) return 1;\n") != 0)
            return: 1
        if: count != 0U && lm_trans_emit_array_structure_value_fill(file, 1U, items_name, element_type, rank, slice_value, namespace_, thread_name, arena_name, 1) != 0
            return: 1
        ---
    else:
        if: lm_trans_emit_managed_array_extents(file, declarator, 1U, namespace_, entry\id, 1) != 0
            return: 1
        if: lm_trans_put(file, "    ") != 0 || lm_trans_emit_managed_array_pointer_type(file, declarator, declarator\pointer_depth + 1U, namespace_) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_emit_identifier(file, items_name) != 0 || lm_trans_put(file, " = 0;\n") != 0
            return: 1
        if: lm_trans_emit_managed_array_rectangle(file, declarator, items_name, 1U, namespace_, entry\id, rank, thread_name, arena_name, 1) != 0
            return: 1
    ---

    if: lm_trans_put(file, "    LmSlice *") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, " = (LmSlice *)lm_own_arena_new_zero(") != 0 || lm_trans_put(file, thread_name) != 0 || lm_trans_put(file, ", ") != 0 || lm_trans_put(file, arena_name) != 0 || lm_trans_put(file, ", sizeof(*") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, "));\n") != 0
        return: 1
    if: lm_trans_put(file, "    if (") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, " == 0) return 1;\n    ") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, "->ptr = (void *)") != 0 || lm_trans_emit_identifier(file, items_name) != 0 || lm_trans_put(file, ";\n    ") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, "->length = ") != 0
        return: 1
    if: slice_value != 0
        if: lm_trans_emit_size_literal(file, count) != 0
            return: 1
        ---
    else:
        if: lm_trans_emit_managed_array_cell_count_name(file, entry\id) != 0
            return: 1
    ---
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: slice_value = 0 && lm_trans_emit_managed_array_initializer(file, declarator, items_name, initializer, 1U, namespace_, entry\id, rank, element_is_const, 1) != 0
        return: 1
    if: lm_trans_module_init_emit_slot_root(file, slot_name, value_name) != 0
        return: 1
return: 0

fn: lm_trans_module_init_emit_value_initializer (
    FILE: file
    const: LmP0Frame: frame
    int: is_const
    const: LmTransModuleInitEntry: entry
    LmTransNamespace: namespace_
) int
    FILE: helper_output
    int: previous_managed_context
    int: status
    int: alias_status

    if: file = 0 || frame = 0 || entry = 0 || namespace_ = 0
        return: 1
    helper_output: lm_trans_tmpfile()
    if: helper_output = 0
        c.fprintf(c.stderr, "trans module-init error: cannot create helper staging stream\n")
        return: 1
    if: lm_trans_typedef_projection_prelude_alias_enter(helper_output) != 0
        c.fclose(helper_output)
        return: 1
    previous_managed_context: namespace_\managed_message_thread_context
    namespace_\managed_message_thread_context: 1
    lm_trans_module_init_emission_enter()
    if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_NAMED_STRUCTURE
        status: lm_trans_module_init_emit_named_structure_initializer(helper_output, frame, entry, namespace_)
    else:
        if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_ANONYMOUS_STRUCTURE
            status: lm_trans_module_init_emit_anonymous_structure_initializer(helper_output, frame, entry, namespace_)
        else:
            if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_ARRAY_REFERENCE
                status: lm_trans_module_init_emit_array_reference_initializer(helper_output, frame, is_const, entry, namespace_)
            else:
                if: entry\kind = c.LM_TRANS_MODULE_INIT_KIND_TABLE
                    status: lm_trans_module_init_emit_table_initializer(helper_output, frame, entry, namespace_)
                else:
                    status: 1
                ---
            ---
        ---
    ---
    lm_trans_module_init_emission_leave()
    namespace_\managed_message_thread_context: previous_managed_context
    alias_status: lm_trans_typedef_projection_prelude_alias_leave(helper_output)
    if: status = 0 && alias_status != 0
        status: alias_status
    if: status = 0
        status: lm_trans_copy_stream(file, helper_output)
    if: c.fclose(helper_output) != 0
        status: 1
return: status

fn: lm_trans_l2_table_name_atom (const: (LmP0Frame: frame)) const: LmP0Text
    const: LmP0Field: field
    const: LmP0Frame: child_frame
    const: LmP0Field: name_field

    field: 0
    if: frame != 0
        field: lm_trans_l2_structure_first_present_field(frame\body)
    while: field != 0
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            child_frame: field\value\as\frame
            if: lm_trans_text_equals(child_frame\head, "name")
                name_field: lm_trans_l2_structure_first_present_field(child_frame\body)
                if: name_field != 0 && name_field\value != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM
                    return: name_field\value\as\atom
        ---
        field: lm_trans_l2_structure_next_present_field(field)
    if: frame != 0
        return: frame\head
return: 0

fn: lm_trans_l2_runtime_table_name_atom (const: LmP0Frame: frame) const: LmP0Text
    const: LmP0Frame: name_frame
    const: LmP0Field: name_field

    name_frame: lm_trans_l2_table_child_frame(frame, "name")
    if: name_frame = 0 || (name_frame\flags & c.LM_P0_FRAME_COLON) = 0U
        c.fprintf(c.stderr, "trans hosted Table limitation: runtime Table requires an explicit name: frame\n")
        return: 0
    name_field: lm_trans_l2_structure_first_present_field(name_frame\body)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM || lm_trans_l2_structure_next_present_field(name_field) != 0 || lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom) = 0
        c.fprintf(c.stderr, "trans L2 table error: runtime Table name: expects exactly one identifier\n")
        return: 0
return: name_field\value\as\atom

fn: lm_trans_l2_structure_child_frame (const: (LmP0Structure: structure); const: @: char head) const: LmP0Frame
    const: LmP0Field: field
    const: LmP0Frame: child

    field: lm_trans_l2_structure_first_present_field(structure)
    while: field != 0
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            child: field\value\as\frame
            if: lm_trans_text_equals(child\head, head)
                return: child
            ---
        ---
        field: lm_trans_l2_structure_next_present_field(field)
return: 0

fn: lm_trans_l2_table_child_frame (const: (LmP0Frame: frame); const: @: char head) const: LmP0Frame
    if: frame = 0
        return: 0
return: lm_trans_l2_structure_child_frame(frame\body, head)

fn: lm_trans_l2_table_present_field_count (const: (LmP0Structure: structure)) size_t
    const: LmP0Field: field
    size_t: count

    count: 0U
    field: lm_trans_l2_table_first_cell_field(structure)
    while: field != 0
        count: count + 1U
        field: lm_trans_l2_table_next_cell_field(field)
return: count

sub: lm_trans_l2_table_columns_destroy (@: LmTransL4CallableType types; @: LmP0Text names; size_t: count)
    size_t: i
    LmP0Text: name

    i: 0U
    while: i < count
        if: types != 0
            lm_trans_expr_callable_type_delete(types[i])
        if: names != 0
            name: names[i]
            lm_trans_text_ref_destroy(@ name)
            names[i]: 0
        i: i + 1U
    lm_own_delete(types, 0)
    lm_own_delete(names, 0)
end: lm_trans_l2_table_columns_destroy

fn: lm_trans_l2_source_read_columns (
    const: (LmP0Structure: body)
    const: @(char error_context)
    @@: LmTransL4CallableType out_types
    @@: LmP0Text out_names
    @: size_t out_count
) int
    const: LmP0Frame: columns_frame
    LmTransFormalParamList: params
    LmTransFormalParam: param
    @: LmTransL4CallableType types
    @: LmP0Text names
    size_t: count
    size_t: index

    if: out_types = 0 || out_names = 0 || out_count = 0
        return: 1
    out_types[0]: 0
    out_names[0]: 0
    out_count[0]: 0U

    columns_frame: lm_trans_l2_structure_child_frame(body, "columns")
    if: columns_frame = 0
        c.fprintf(c.stderr, "trans L2 %s error: declaration must contain columns\n", error_context)
        return: 1

    params: lm_trans_formal_param_list_from_structure(columns_frame\body, 0, error_context)
    if: params = 0
        return: 1
    finally: lm_trans_formal_param_list_delete(params)

    count: params\count
    if: count = 0U
        c.fprintf(c.stderr, "trans L2 %s error: columns must not be empty\n", error_context)
        return: 1

    types: (cast: (@: LmTransL4CallableType) lm_own_new_zero(count * c.sizeof(types[0])))
    names: (cast: (@: LmP0Text) lm_own_new_zero(count * c.sizeof(names[0])))
    if: types = 0 || names = 0
        lm_trans_l2_table_columns_destroy(types, names, count)
        return: 1
    finally: lm_trans_l2_table_columns_destroy(types, names, count)

    index: 0U
    while: index < count
        param: params\params[index]
        types[index]: lm_trans_expr_callable_type_new()
        names[index]: lm_trans_statement_text_new()
        if: types[index] = 0 || names[index] = 0
            return: 1
        if: lm_trans_callable_type_copy(types[index], param\type) != 0
            return: 1
        names[index][0]: param\name[0]
        if: lm_trans_atom_can_be_new_binding_name(names[index]) = 0
            c.fprintf(c.stderr, "trans L2 %s error: column name must be an identifier\n", error_context)
            return: 1
        index: index + 1U

    out_types[0]: types
    out_names[0]: names
    out_count[0]: count
    types: 0
    names: 0
return: 0

fn: lm_trans_l2_table_read_columns (
    const: LmP0Frame: table_frame
    @@: LmTransL4CallableType out_types
    @@: LmP0Text out_names
    @: size_t out_count
) int
    if: table_frame = 0
        return: 1
return: lm_trans_l2_source_read_columns(table_frame\body, "table", out_types, out_names, out_count)

fn: lm_trans_l2_body_source_marker (
    const: LmP0Structure: body
    const: @(char error_context)
    @: int out_source_marker
) int
    const: LmP0Field: first_field
    const: LmP0Field: field

    if: body = 0 || error_context = 0 || out_source_marker = 0
        return: 1
    out_source_marker[0]: 0

    first_field: lm_trans_l2_structure_first_present_field(body)
    field: first_field
    while: field != 0
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(field\value\as\atom, "source")
            if: field != first_field || out_source_marker[0] != 0
                c.fprintf(c.stderr, "trans L2 %s error: source marker must be the first %s body field and appear exactly once\n", error_context, error_context)
                return: 1
            out_source_marker[0]: 1
        ---
        field: lm_trans_l2_structure_next_present_field(field)

return: 0

fn: lm_trans_l2_table_body_is_source_only (
    const: LmP0Structure: body
    const: @(char error_context)
    @: int out_source_only
) int
return: lm_trans_l2_body_source_marker(body, error_context, out_source_only)

fn: lm_trans_l2_table_rows_frame (const: (LmP0Frame: table_frame)) const: LmP0Frame
    const: LmP0Frame: rows_frame

    rows_frame: lm_trans_l2_table_child_frame(table_frame, "rows")
    if: rows_frame = 0
        c.fprintf(c.stderr, "trans L2 table error: table must contain rows\n")
return: rows_frame

fn: lm_trans_l2_table_emit_cell_spelling (const: LmP0Node: node) int
    if: node = 0
        return: c.fputs("<empty>", c.stderr) < 0
    if: node\kind = c.LM_P0_NODE_ATOM && node\as\atom != 0 && node\as\atom\data != 0
        return: c.fprintf(c.stderr, "%.*s", (cast: int node\as\atom\length), node\as\atom\data) < 0
    if: node\kind = c.LM_P0_NODE_FRAME && node\as\frame != 0 && node\as\frame\head != 0 && node\as\frame\head\data != 0
        return: c.fprintf(c.stderr, "(%.*s:)", (cast: int node\as\frame\head\length), node\as\frame\head\data) < 0
return: c.fputs("<cell>", c.stderr) < 0

fn: lm_trans_l2_table_row_count (const: (LmP0Frame: rows_frame); size_t: column_count; @: size_t out_row_count; const: LmP0Text: table_name) int
    const: LmP0Field: field
    size_t: cell_count
    size_t: leftover
    size_t: skip
    size_t: index
    int: first_leftover

    if: out_row_count = 0 || rows_frame = 0 || column_count = 0U
        return: 1
    cell_count: lm_trans_l2_table_present_field_count(rows_frame\body)
    if: cell_count = 0U
        out_row_count[0]: 0U
        return: 0
    if: (cell_count % column_count) != 0U
        leftover: cell_count % column_count
        if: table_name != 0 && table_name\data != 0
            c.fprintf(c.stderr, "trans L2 table error: \"%.*s\" rows have %zu cells, not divisible by %zu columns (%zu leftover)", (cast: int table_name\length), table_name\data, cell_count, column_count, leftover)
        else:
            c.fprintf(c.stderr, "trans L2 table error: rows have %zu cells, not divisible by %zu columns (%zu leftover)", cell_count, column_count, leftover)
        ---
        skip: cell_count - leftover
        index: 0U
        first_leftover: 1
        field: lm_trans_l2_table_first_cell_field(rows_frame\body)
        while: field != 0
            if: index >= skip
                if: first_leftover != 0
                    c.fputs(": leftover", c.stderr)
                    first_leftover: 0
                c.fputc(' ', c.stderr)
                if: lm_trans_l2_table_emit_cell_spelling(field\value) != 0
                    c.fputc('\n', c.stderr)
                    return: 1
                ---
            ---
            index: index + 1U
            field: lm_trans_l2_table_next_cell_field(field)
        ---
        c.fputc('\n', c.stderr)
        return: 1
    out_row_count[0]: cell_count / column_count
return: 0

fn: lm_trans_l2_runtime_table_row_descriptor_new (
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    const: @(char c_type_name)
) LmTransDescriptor
    LmTransDescriptor: descriptor
    size_t: index

    if: column_types = 0 || column_names = 0 || column_count = 0U || c_type_name = 0
        return: 0
    descriptor: lm_trans_descriptor_new()
    if: descriptor = 0 || lm_trans_descriptor_mark_structural_fields(descriptor) != 0
        lm_trans_descriptor_delete(descriptor)
        return: 0

    index: 0U
    while: index < column_count
        if: column_types[index] = 0 || column_types[index]\class_name = 0
            lm_trans_descriptor_delete(descriptor)
            return: 0
        if: column_types[index]\array_rank != 0U
            c.fprintf(c.stderr, "trans hosted Table limitation: ArrayReference-valued column \"%.*s\" is not supported\n", (cast: int column_names[index]\length), column_names[index]\data)
            lm_trans_descriptor_delete(descriptor)
            return: 0
        if: lm_trans_descriptor_add_structural_field(descriptor, column_names[index], column_types[index]\class_name, index, column_types[index]\address_depth, 0U, 0, column_types[index]\is_const, 0) != 0
            lm_trans_descriptor_delete(descriptor)
            return: 0
        index: index + 1U

    if: lm_trans_descriptor_set_class_relation(descriptor, "lm.trans.c.type", c_type_name) != 0 || lm_trans_descriptor_set_class_relation(descriptor, "lm.trans.c.indexed-members", "1") != 0 || lm_trans_descriptor_set_class_relation(descriptor, "lm.trans.table-runtime-read-only", "1") != 0
        lm_trans_descriptor_delete(descriptor)
        return: 0
return: descriptor

fn: lm_trans_l2_runtime_table_binding_rollback (
    LmTransNamespace: namespace_
    size_t: item_count
    LmTransDescriptor: descriptor
) int
    LmTransSymbol: symbol

    if: namespace_ = 0 || namespace_\items = 0 || namespace_\items\count < item_count
        return: 1
    while: namespace_\items\count > item_count
        symbol: lm_own_ptr_stack_pop(namespace_\items)
        if: symbol = 0
            return: 1
        lm_trans_identifier_table_remove_symbol(namespace_\identifiers, symbol)
        if: symbol\descriptor = descriptor
            symbol\descriptor: 0
        lm_trans_symbol_destroy(symbol)
    ---
return: 0

fn: lm_trans_l2_runtime_table_bind_slice (
    LmTransNamespace: namespace_
    const: LmP0Text: table_name
    const: @(char c_name)
    LmTransDescriptor: descriptor
) int
    LmP0Text: c_name_text
    LmP0Text: slice_type
    size_t: item_count
    int: status

    if: namespace_ = 0 || table_name = 0 || c_name = 0 || descriptor = 0
        lm_trans_descriptor_delete(descriptor)
        return: 1
    c_name_text: lm_trans_text_from_cstr(c_name)
    slice_type: lm_trans_text_ref_new_cstr("LmSlice")
    if: c_name_text = 0 || slice_type = 0
        lm_trans_text_ref_destroy(@ c_name_text)
        lm_trans_text_ref_destroy(@ slice_type)
        lm_trans_descriptor_delete(descriptor)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ c_name_text)
        lm_trans_text_ref_destroy(@ slice_type)

    item_count: lm_trans_namespace_source_item_count(namespace_)
    status: lm_trans_namespace_bind_descriptor_with_c_name(namespace_, table_name, "variable", c_name_text, descriptor)
    if: status != 0
        lm_trans_descriptor_delete(descriptor)
        return: 1
    status: lm_trans_namespace_mark_array_reference(namespace_, table_name, 1U, 0U, 1)
    if: status = 0
        status: lm_trans_namespace_declare_relation_text(namespace_, table_name, "variable.type", slice_type)
    if: status = 0
        status: lm_trans_namespace_declare_relation_text(namespace_, table_name, "variable.array-element-type", table_name)
    if: status = 0
        status: lm_trans_namespace_declare_array_slice_expr(namespace_, table_name, c_name)
    if: status != 0
        if: lm_trans_l2_runtime_table_binding_rollback(namespace_, item_count, descriptor) = 0
            lm_trans_descriptor_delete(descriptor)
        ---
        return: 1
    ---
return: status

fn: lm_trans_module_init_declare_table (
    const: LmP0Frame: frame
    LmTransModuleInitEntry: entry
    LmTransNamespace: namespace_
) int
    const: LmP0Text: table_name
    const: LmP0Frame: rows_frame
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count
    @: char row_type_name
    LmTransDescriptor: descriptor
    int: source_only

    if: frame = 0 || entry = 0 || entry\slot_name = 0 || namespace_ = 0 || lm_trans_l2_table_body_is_source_only(frame\body, "table", @ source_only) != 0 || source_only != 0
        return: 1
    table_name: lm_trans_l2_runtime_table_name_atom(frame)
    if: table_name = 0
        return: 1

    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_table_read_columns(frame, @ column_types, @ column_names, @ column_count) != 0
        return: 1
    rows_frame: lm_trans_l2_table_rows_frame(frame)
    if: rows_frame = 0 || lm_trans_l2_table_row_count(rows_frame, column_count, @ row_count, table_name) != 0
        return: 1
    c.LM_UNUSED(row_count)

    row_type_name: lm_trans_l2_runtime_table_row_type_name_new(table_name, namespace_)
    if: row_type_name = 0 || lm_trans_module_init_entry_set_c_type_name(entry, row_type_name) != 0
        lm_own_delete(row_type_name, 0)
        return: 1
    descriptor: lm_trans_l2_runtime_table_row_descriptor_new(column_types, column_names, column_count, row_type_name)
    lm_own_delete(row_type_name, 0)
    if: descriptor = 0
        return: 1
    if: lm_trans_l2_runtime_table_bind_slice(namespace_, table_name, entry\slot_name, descriptor) != 0
        return: 1
    entry\descriptor: descriptor
return: 0

fn: lm_trans_l2_table_source_descriptor_new (
    const: LmP0Text: table_name
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
) LmTableDescriptor
    c.array: const: [1]: @: char descriptor_data
    c.array: [1]: size_t descriptor_lengths
    LmP0Text: table_value
    LmP0Text: column_value
    LmP0Text: type_value
    LmTableDescriptor: descriptor
    size_t: column_index

    if: table_name = 0 || column_types = 0 || column_names = 0 || column_count = 0U
        return: 0

    table_value: lm_trans_text_ref_new_cstr("")
    column_value: lm_trans_text_ref_new_cstr("")
    type_value: lm_trans_text_ref_new_cstr("")
    if: table_value = 0 || column_value = 0 || type_value = 0 || lm_trans_registry_identifier_value(table_name, table_value) = 0
        lm_trans_text_ref_destroy(@ table_value)
        lm_trans_text_ref_destroy(@ column_value)
        lm_trans_text_ref_destroy(@ type_value)
        return: 0

    descriptor: lm_table_descriptor_new_empty_slice(table_value\data, table_value\length)
    column_index: 0U
    while: descriptor != 0 && column_index < column_count
        if: column_types[column_index] = 0 || column_types[column_index]\class_name = 0 || column_names[column_index] = 0 || lm_trans_registry_identifier_value(column_names[column_index], column_value) = 0 || lm_trans_registry_identifier_value(column_types[column_index]\class_name, type_value) = 0
            lm_table_descriptor_delete_any(descriptor)
            descriptor: 0
            break
        descriptor_data[0]: type_value\data
        descriptor_lengths[0]: type_value\length
        if: lm_table_descriptor_add_column_slices(descriptor, column_value\data, column_value\length, type_value\data, type_value\length, descriptor_data, descriptor_lengths, 1U, column_types[column_index]\address_depth, column_types[column_index]\array_rank, column_types[column_index]\is_const) != 0
            lm_table_descriptor_delete_any(descriptor)
            descriptor: 0
            break
        column_index: column_index + 1U

    lm_trans_text_ref_destroy(@ table_value)
    lm_trans_text_ref_destroy(@ column_value)
    lm_trans_text_ref_destroy(@ type_value)
return: descriptor

fn: lm_trans_l2_table_prepare_source_rows (
    LmTableDescriptor: target
    const: LmP0Frame: rows_frame
    size_t: column_count
    size_t: row_count
    int: require_facade
    @: size_t out_first_row_index
) int
    const: LmP0Field: field
    const: @: LmP0Node cells
    size_t: initial_row_count
    size_t: row_index
    size_t: column_index
    int: status

    if: target = 0 || target\materialized_rows = 0 || rows_frame = 0 || column_count = 0U
        return: 1

    initial_row_count: lm_table_descriptor_materialized_row_count(target)
    if: out_first_row_index != 0
        out_first_row_index[0]: initial_row_count

    cells: (cast: (const: @: LmP0Node) lm_own_new_zero(column_count * c.sizeof(cells[0])))
    if: cells = 0
        return: 1

    status: 0
    field: lm_trans_l2_structure_first_present_field(rows_frame\body)
    row_index: 0U
    while: status = 0 && row_index < row_count
        column_index: 0U
        while: status = 0 && column_index < column_count
            if: field = 0 || field\value = 0
                status: 1
            else:
                cells[column_index]: field\value
                field: lm_trans_l2_structure_next_present_field(field)
            ---
            column_index: column_index + 1U
        if: status = 0 && lm_trans_registry_prepare_source_descriptor_row(target, cells, column_count, require_facade) != 0
            status: 1
        row_index: row_index + 1U

    if: status = 0 && field != 0
        status: 1
    lm_own_delete(cells, 0)

    if: status != 0
        lm_own_ptr_stack_truncate(target\materialized_rows, initial_row_count)
        return: 1
return: 0

fn: lm_trans_l2_table_project_source_rows (LmTableDescriptor: target; size_t: first_row_index) int
    LmTableRow: prepared_row
    size_t: row_index

    if: target = 0 || first_row_index > lm_table_descriptor_materialized_row_count(target)
        return: 1

    row_index: first_row_index
    while: row_index < lm_table_descriptor_materialized_row_count(target)
        prepared_row: lm_own_ptr_stack_at(target\materialized_rows, row_index)
        if: lm_trans_registry_project_source_descriptor_row(target, prepared_row) != 0
            return: 1
        row_index: row_index + 1U
return: 0

fn: lm_trans_l2_table_materialize_source_rows (
    LmTransNamespace: namespace_
    const: LmP0Text: table_name
    const: LmP0Frame: rows_frame
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count
    int: require_facade
) int
    LmRegistryView: view
    LmTableDescriptor: candidate
    LmTableDescriptor: target
    LmTableDescriptor: existing
    size_t: initial_row_count
    int: candidate_is_target
    int: status

    view: 0
    if: c.lm_trans_registry != 0 && lm_trans_namespace_registry_view(namespace_) = c.lm_trans_registry->view
        view: c.lm_trans_registry->view
    if: view = 0
        return: require_facade != 0

    candidate: lm_trans_l2_table_source_descriptor_new(table_name, column_types, column_names, column_count)
    if: candidate = 0
        return: 1

    target: candidate
    candidate_is_target: 1
    existing: lm_registry_view_find_local_source_table_slice(view, candidate\name, c.strlen(candidate\name))
    if: existing != 0 && lm_table_descriptor_schema_same(existing, candidate) != 0
        target: existing
        candidate_is_target: 0
        lm_table_descriptor_delete_any(candidate)
        candidate: 0
    ---

    initial_row_count: lm_table_descriptor_materialized_row_count(target)
    status: lm_trans_l2_table_prepare_source_rows(target, rows_frame, column_count, row_count, require_facade, 0)
    if: status = 0 && lm_trans_registry_preflight_source_descriptor_class_kinds(target, initial_row_count) != 0
        status: 1
    if: status = 0 && lm_trans_l2_table_project_source_rows(target, initial_row_count) != 0
        status: 1

    if: status != 0
        lm_own_ptr_stack_truncate(target\materialized_rows, initial_row_count)
        if: candidate_is_target != 0
            lm_table_descriptor_delete_any(target)
        return: 1

    if: candidate_is_target != 0
        if: lm_registry_view_take_local_source_table(view, target) != 0
            lm_table_descriptor_delete_any(target)
            return: 1
        ---
    else:
        if: lm_table_descriptor_materialized_row_count(target) != initial_row_count
            lm_registry_view_note_mutation(view)
        ---
    ---
return: 0

fn: lm_trans_materialize_l2_table_source (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
    int: require_facade
) int
    const: LmP0Text: table_name
    const: LmP0Frame: rows_frame
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count
    int: source_marker

    if: namespace_ = 0 || frame = 0
        return: 1
    if: lm_trans_l2_body_source_marker(frame\body, "table", @ source_marker) != 0
        return: 1
    if: source_marker = 0
        c.fprintf(c.stderr, "trans L2 table error: source materialization requires an explicit first source marker\n")
        return: 1

    table_name: lm_trans_l2_table_name_atom(frame)
    if: table_name = 0
        return: 1

    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_table_read_columns(frame, @ column_types, @ column_names, @ column_count) != 0
        return: 1

    rows_frame: lm_trans_l2_table_rows_frame(frame)
    if: rows_frame = 0 || lm_trans_l2_table_row_count(rows_frame, column_count, @ row_count, table_name) != 0
        return: 1
return: lm_trans_l2_table_materialize_source_rows(namespace_, table_name, rows_frame, column_types, column_names, column_count, row_count, require_facade)

fn: lm_trans_l2_join_header (
    const: (LmP0Frame: frame)
    const: @(LmP0Structure out_sources)
    const: @(LmP0Text out_target)
    const: @(LmP0Structure out_body)
) int
    const: LmP0Field: field

    if: out_sources = 0 || out_target = 0 || out_body = 0
        return: 1
    out_sources[0]: 0
    out_target[0]: 0
    out_body[0]: 0

    if: frame = 0 || lm_trans_text_equals(frame\head, "join") = 0
        c.fprintf(c.stderr, "trans L2 join error: join receiver expects a join frame\n")
        return: 1

    field: lm_trans_l2_structure_first_present_field(frame\body)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE || lm_trans_l2_structure_first_present_field(field\value\as\structure) = 0
        c.fprintf(c.stderr, "trans L2 join error: join expects a non-empty source table list\n")
        return: 1
    out_sources[0]: field\value\as\structure

    field: lm_trans_l2_structure_next_present_field(field)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 join error: join expects a target table name\n")
        return: 1
    out_target[0]: field\value\as\atom

    field: lm_trans_l2_structure_next_present_field(field)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
        c.fprintf(c.stderr, "trans L2 join error: join expects a table fragment body\n")
        return: 1
    out_body[0]: field\value\as\structure

    if: lm_trans_l2_structure_next_present_field(field) != 0
        c.fprintf(c.stderr, "trans L2 join error: unexpected fields after join body\n")
        return: 1
return: 0

fn: lm_trans_l2_join_is_source_only (const: (LmP0Frame: frame); @: int out_source_only) int
    const: LmP0Structure: sources
    const: LmP0Structure: body
    const: LmP0Text: target_name

    if: out_source_only = 0 || lm_trans_l2_join_header(frame, @ sources, @ target_name, @ body) != 0
        return: 1
    c.LM_UNUSED(sources)
    c.LM_UNUSED(target_name)
return: lm_trans_l2_body_source_marker(body, "join", out_source_only)

fn: lm_trans_l2_join_sources_ready (
    LmTransNamespace: namespace_
    const: (LmP0Frame: frame)
    @: int out_ready
) int
    const: LmP0Structure: sources
    const: LmP0Structure: body
    const: LmP0Text: target_name
    const: LmP0Field: field
    const: LmP0Node: node
    LmP0Text: source_name
    const: LmRegistryView: view

    if: out_ready != 0
        out_ready[0]: 0
    if: namespace_ = 0 || frame = 0 || out_ready = 0
        return: 1

    view: lm_trans_namespace_registry_view(namespace_)
    if: view = 0 || lm_trans_l2_join_header(frame, @ sources, @ target_name, @ body) != 0
        return: 1
    c.LM_UNUSED(target_name)
    c.LM_UNUSED(body)

    source_name: lm_trans_text_ref_new_cstr("")
    if: source_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ source_name)

    field: lm_trans_l2_structure_first_present_field(sources)
    while: field != 0
        node: field\value
        if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || lm_trans_registry_identifier_value(node\as\atom, source_name) = 0
            c.fprintf(c.stderr, "trans L2 join error: source list expects table name atoms\n")
            return: 1
        if: lm_registry_view_find_source_table_slice(view, source_name\data, source_name\length) = 0
            return: 0
        field: lm_trans_l2_structure_next_present_field(field)

    out_ready[0]: 1
return: 0

fn: lm_trans_l2_join_body_rows (const: (LmP0Structure: body); const: @(LmP0Frame out_rows)) int
    const: LmP0Field: field
    const: LmP0Frame: child
    int: have_columns
    int: have_rows
    int: source_marker

    if: body = 0 || out_rows = 0
        return: 1
    out_rows[0]: 0
    if: lm_trans_l2_body_source_marker(body, "join", @ source_marker) != 0
        return: 1
    have_columns: 0
    have_rows: 0
    field: lm_trans_l2_structure_first_present_field(body)
    if: source_marker != 0
        field: lm_trans_l2_structure_next_present_field(field)
    while: field != 0
        if: field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
            c.fprintf(c.stderr, "trans L2 join error: join body expects an optional first source marker followed by columns/rows frames\n")
            return: 1
        child: field\value\as\frame
        if: lm_trans_text_equals(child\head, "columns")
            if: have_columns != 0
                c.fprintf(c.stderr, "trans L2 join error: join expects exactly one columns frame\n")
                return: 1
            have_columns: 1
        else:
            if: lm_trans_text_equals(child\head, "rows")
                if: have_rows != 0
                    c.fprintf(c.stderr, "trans L2 join error: join expects at most one rows frame\n")
                    return: 1
                have_rows: 1
                out_rows[0]: child
            else:
                c.fprintf(c.stderr, "trans L2 join error: join body expects an optional first source marker followed by columns/rows frames\n")
                return: 1
            ---
        ---
        field: lm_trans_l2_structure_next_present_field(field)

    if: have_columns = 0
        c.fprintf(c.stderr, "trans L2 join error: join requires target columns\n")
        return: 1
return: 0

fn: lm_trans_l2_join_stage_source_rows (
    LmRegistryView: view
    LmTableDescriptor: target
    const: (LmP0Structure: sources)
    size_t: snapshot_source_count
    const: @(size_t snapshot_row_counts)
) int
    const: LmP0Field: field
    const: LmP0Node: node
    LmP0Text: source_value
    int: status

    source_value: lm_trans_text_ref_new_cstr("")
    if: source_value = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ source_value)

    status: 0
    field: lm_trans_l2_structure_first_present_field(sources)
    while: status = 0 && field != 0
        node: field\value
        if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 join error: source list expects table name atoms\n")
            status: 1
        else:
            if: lm_trans_registry_identifier_value(node\as\atom, source_value) = 0 || lm_registry_view_append_materialized_rows_mode(view, target, source_value\data, source_value\length, 0, 1, snapshot_source_count, snapshot_row_counts) != 0
                status: 1
            ---
        ---
        field: lm_trans_l2_structure_next_present_field(field)
return: status

fn: lm_trans_l2_join_target_relation_equals (
    const: (LmP0Text: target_name)
    const: @(char suffix)
    const: @(char relation_name)
) int
    size_t: suffix_length
    size_t: relation_length

    if: target_name = 0 || target_name\data = 0 || suffix = 0 || relation_name = 0
        return: 0
    suffix_length: c.strlen(suffix)
    relation_length: c.strlen(relation_name)
    if: target_name\length + suffix_length != relation_length
        return: 0
    if: target_name\length != 0U && c.memcmp(target_name\data, relation_name, target_name\length) != 0
        return: 0
    if: suffix_length != 0U && c.memcmp(suffix, relation_name + target_name\length, suffix_length) != 0
        return: 0
return: 1

fn: lm_trans_l2_join_target_relation_declares_class_kind (
    const: (LmP0Text: target_name)
    const: @(char suffix)
) int
    if: lm_trans_l2_join_target_relation_equals(target_name, suffix, "class") != 0
        return: 1
return: lm_trans_l2_join_target_relation_equals(target_name, suffix, "class.kind")

fn: lm_trans_l2_join_pending_descriptor_class_kind_conflicts (
    const: (LmTableDescriptor: descriptor)
    size_t: first_row_index
    const: @(char name)
    const: @(char kind)
) int
    const: LmTableRow: row
    const: LmTableCell: key_cell
    const: LmTableCell: payload_cell
    size_t: row_count
    size_t: row_index
    size_t: column_count
    size_t: column_index
    int: relation_status

    if: descriptor = 0 || descriptor\materialized_rows = 0 || name = 0 || kind = 0
        return: 1
    row_count: lm_table_descriptor_materialized_row_count(descriptor)
    column_count: lm_table_descriptor_column_count(descriptor)
    if: first_row_index > row_count || column_count = 0U
        return: 1

    row_index: first_row_index
    while: row_index < row_count
        row: lm_table_descriptor_materialized_row_at(descriptor, row_index)
        if: row = 0 || lm_table_row_cell_count(row) != column_count
            return: 1
        if: row\source_native = 0
            key_cell: lm_table_row_cell_at(row, 0U)
            if: key_cell = 0 || key_cell\value = 0 || key_cell\node != 0
                return: 1
            column_index: 1U
            while: column_index < column_count
                payload_cell: lm_table_row_cell_at(row, column_index)
                relation_status: lm_trans_registry_source_descriptor_column_declares_class_kind(descriptor, column_index)
                if: payload_cell = 0 || relation_status < 0 || (payload_cell\value != 0 && payload_cell\node != 0)
                    return: 1
                if: relation_status != 0 && payload_cell\value != 0 && c.strcmp(key_cell\value, name) = 0 && c.strcmp(payload_cell\value, kind) != 0
                    c.fprintf(c.stderr, "trans registry class error: class %s has conflicting kinds %s and %s\n", name, payload_cell\value, kind)
                    return: 1
                column_index: column_index + 1U
        ---
        row_index: row_index + 1U
return: 0

fn: lm_trans_l2_join_preflight_source_facades (
    const: (LmP0Structure: sources)
    const: (LmP0Text: target_name)
    const: (LmTableDescriptor: target)
    size_t: first_row_index
    size_t: snapshot_fact_count
) int
    const: LmP0Field: field
    const: LmP0Node: node
    const: LmRegistryViewRow: view_row
    LmTransRegistryFact: row
    LmTransRegistryFact: previous
    LmP0Text: source_value
    LmP0Text: target_value
    LmP0Text: name_text
    LmP0Text: kind_text
    LmOwnPtrStack: planned_class_kinds
    const: @: char suffix
    size_t: fact_count
    size_t: fact_index
    size_t: previous_index
    int: status

    if: sources = 0 || target_name = 0 || target = 0 || c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0
        return: 1

    source_value: lm_trans_text_ref_new_cstr("")
    target_value: lm_trans_text_ref_new_cstr("")
    planned_class_kinds: lm_trans_ptr_stack_new(0)
    if: source_value = 0 || target_value = 0 || planned_class_kinds = 0
        lm_trans_text_ref_destroy(@ source_value)
        lm_trans_text_ref_destroy(@ target_value)
        lm_trans_ptr_stack_delete(@ planned_class_kinds)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ source_value)
        lm_trans_text_ref_destroy(@ target_value)
        lm_trans_ptr_stack_delete(@ planned_class_kinds)

    if: lm_trans_registry_identifier_value(target_name, target_value) = 0
        return: 1

    status: 0
    fact_count: lm_registry_view_fact_count(c.lm_trans_registry->view)
    if: snapshot_fact_count > fact_count
        return: 1
    fact_count: snapshot_fact_count
    field: lm_trans_l2_structure_first_present_field(sources)
    while: status = 0 && field != 0
        node: field\value
        if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || lm_trans_registry_identifier_value(node\as\atom, source_value) = 0
            status: 1
        else:
            fact_index: 0U
            while: status = 0 && fact_index < fact_count
                view_row: lm_registry_view_fact_at(c.lm_trans_registry->view, fact_index)
                row: 0
                if: view_row != 0
                    row: cast: (LmTransRegistryFact) view_row\source
                if: row != 0 && row\table != 0 && row\key != 0 && row\payload != 0 && row\payload_node = 0 && lm_trans_registry_join_relation_matches(row\table, source_value, @ suffix) != 0 && lm_trans_l2_join_target_relation_declares_class_kind(target_value, suffix) != 0
                    name_text: lm_trans_text_from_cstr(row\key)
                    kind_text: lm_trans_text_from_cstr(row\payload)
                    if: name_text = 0 || kind_text = 0
                        status: 1
                    else:
                        status: lm_trans_registry_check_class_kind_row(name_text, kind_text)
                        if: status = 0
                            status: lm_trans_l2_join_pending_descriptor_class_kind_conflicts(target, first_row_index, row\key, row\payload)
                        previous_index: 0U
                        while: status = 0 && previous_index < planned_class_kinds\count
                            previous: cast: (LmTransRegistryFact) lm_own_ptr_stack_at(planned_class_kinds, previous_index)
                            if: previous = 0 || previous\key = 0 || previous\payload = 0
                                status: 1
                            else:
                                if: c.strcmp(previous\key, row\key) = 0 && c.strcmp(previous\payload, row\payload) != 0
                                    c.fprintf(c.stderr, "trans registry class error: class %s has conflicting kinds %s and %s\n", row\key, previous\payload, row\payload)
                                    status: 1
                            ---
                            previous_index: previous_index + 1U
                        if: status = 0 && lm_own_ptr_stack_push(planned_class_kinds, row) != 0
                            status: 1
                    ---
                    lm_trans_text_ref_destroy(@ name_text)
                    lm_trans_text_ref_destroy(@ kind_text)
                ---
                fact_index: fact_index + 1U
        ---
        field: lm_trans_l2_structure_next_present_field(field)
return: status

fn: lm_trans_l2_join_project_source_facades (
    const: (LmP0Structure: sources)
    const: (LmP0Text: target_name)
    size_t: snapshot_fact_count
) int
    const: LmP0Field: field
    const: LmP0Node: node
    const: LmRegistryViewRow: view_row
    LmTransRegistryFact: row
    LmP0Text: source_value
    LmP0Text: target_value
    size_t: fact_count
    size_t: fact_index
    size_t: copied
    int: status

    if: sources = 0 || target_name = 0 || c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0
        return: 1

    source_value: lm_trans_text_ref_new_cstr("")
    target_value: lm_trans_text_ref_new_cstr("")
    if: source_value = 0 || target_value = 0
        lm_trans_text_ref_destroy(@ source_value)
        lm_trans_text_ref_destroy(@ target_value)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ source_value)
        lm_trans_text_ref_destroy(@ target_value)

    if: lm_trans_registry_identifier_value(target_name, target_value) = 0
        return: 1
    fact_count: lm_registry_view_fact_count(c.lm_trans_registry->view)
    if: snapshot_fact_count > fact_count
        return: 1
    fact_count: snapshot_fact_count

    status: 0
    copied: 0U
    field: lm_trans_l2_structure_first_present_field(sources)
    while: status = 0 && field != 0
        node: field\value
        if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || lm_trans_registry_identifier_value(node\as\atom, source_value) = 0
            status: 1
        else:
            fact_index: 0U
            while: status = 0 && fact_index < fact_count
                view_row: lm_registry_view_fact_at(c.lm_trans_registry->view, fact_index)
                row: 0
                if: view_row != 0
                    row: cast: (LmTransRegistryFact) view_row\source
                status: lm_trans_registry_join_copy_row(row, source_value, target_value, @ copied)
                fact_index: fact_index + 1U
        ---
        field: lm_trans_l2_structure_next_present_field(field)
return: status

fn: lm_trans_materialize_l2_join_source (LmTransNamespace: namespace_; const: (LmP0Frame: frame)) int
    const: LmP0Structure: sources
    const: LmP0Structure: body
    const: LmP0Text: target_name
    const: LmP0Frame: rows_frame
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count
    size_t: initial_row_count
    size_t: direct_row_index
    size_t: snapshot_source_count
    size_t: snapshot_source_index
    size_t: snapshot_fact_count
    @: size_t snapshot_row_counts
    LmRegistryView: view
    LmTableDescriptor: candidate
    LmTableDescriptor: target
    LmTableDescriptor: existing
    const: LmTableDescriptor: snapshot_source
    int: candidate_is_target
    int: source_marker
    int: status

    if: namespace_ = 0 || frame = 0 || c.lm_trans_registry = 0 || lm_trans_namespace_registry_view(namespace_) != c.lm_trans_registry->view
        return: 1
    view: c.lm_trans_registry->view
    if: view = 0 || lm_trans_l2_join_header(frame, @ sources, @ target_name, @ body) != 0 || lm_trans_l2_body_source_marker(body, "join", @ source_marker) != 0
        return: 1
    if: source_marker = 0
        c.fprintf(c.stderr, "trans L2 join error: source materialization requires an explicit first source marker\n")
        return: 1
    if: lm_trans_l2_join_body_rows(body, @ rows_frame) != 0
        return: 1

    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_source_read_columns(body, "join", @ column_types, @ column_names, @ column_count) != 0
        return: 1

    row_count: 0U
    if: rows_frame != 0 && lm_trans_l2_table_row_count(rows_frame, column_count, @ row_count, target_name) != 0
        return: 1

    candidate: lm_trans_l2_table_source_descriptor_new(target_name, column_types, column_names, column_count)
    if: candidate = 0
        return: 1

    target: candidate
    candidate_is_target: 1
    existing: lm_registry_view_find_local_source_table_slice(view, candidate\name, c.strlen(candidate\name))
    if: existing != 0 && lm_table_descriptor_schema_same(existing, candidate) != 0
        target: existing
        candidate_is_target: 0
        lm_table_descriptor_delete_any(candidate)
        candidate: 0
    ---

    snapshot_source_count: lm_registry_view_source_table_count(view)
    snapshot_row_counts: lm_own_new_zero((snapshot_source_count + 1U) * c.sizeof(snapshot_row_counts[0]))
    if: snapshot_row_counts = 0
        if: candidate_is_target != 0
            lm_table_descriptor_delete_any(target)
        return: 1
    finally: lm_own_delete(snapshot_row_counts, 0)
    snapshot_source_index: 0U
    while: snapshot_source_index < snapshot_source_count
        snapshot_source: lm_registry_view_source_table_at(view, snapshot_source_index)
        if: snapshot_source = 0
            if: candidate_is_target != 0
                lm_table_descriptor_delete_any(target)
            return: 1
        snapshot_row_counts[snapshot_source_index]: lm_table_descriptor_materialized_row_count(snapshot_source)
        snapshot_source_index: snapshot_source_index + 1U
    snapshot_fact_count: lm_registry_view_fact_count(view)

    initial_row_count: lm_table_descriptor_materialized_row_count(target)
    status: lm_trans_l2_join_stage_source_rows(view, target, sources, snapshot_source_count, snapshot_row_counts)
    direct_row_index: lm_table_descriptor_materialized_row_count(target)
    if: status = 0 && rows_frame != 0 && lm_trans_l2_table_prepare_source_rows(target, rows_frame, column_count, row_count, 0, 0) != 0
        status: 1
    if: status = 0 && lm_trans_registry_preflight_source_descriptor_class_kinds(target, initial_row_count) != 0
        status: 1
    if: status = 0 && lm_trans_l2_join_preflight_source_facades(sources, target_name, target, initial_row_count, snapshot_fact_count) != 0
        status: 1
    if: status = 0 && lm_trans_l2_join_project_source_facades(sources, target_name, snapshot_fact_count) != 0
        status: 1
    if: status = 0 && lm_trans_l2_table_project_source_rows(target, direct_row_index) != 0
        status: 1

    if: status != 0
        lm_own_ptr_stack_truncate(target\materialized_rows, initial_row_count)
        if: candidate_is_target != 0
            lm_table_descriptor_delete_any(target)
        return: 1

    if: candidate_is_target != 0
        if: lm_registry_view_take_local_source_table(view, target) != 0
            lm_table_descriptor_delete_any(target)
            return: 1
        ---
    else:
        if: lm_table_descriptor_materialized_row_count(target) != initial_row_count
            lm_registry_view_note_mutation(view)
        ---
    ---
return: 0

fn: lm_trans_declare_l2_join_mode (LmTransNamespace: namespace_; const: (LmP0Frame: frame); int: materialize_source) int
    int: source_only

    if: lm_trans_validate_l2_join_frame(frame) != 0 || lm_trans_l2_join_is_source_only(frame, @ source_only) != 0
        return: 1
    if: lm_trans_l2_table_materialization_suppression_depth > 0
        c.fprintf(c.stderr, "trans L2 join error: joins are not allowed in os/ifdef branches\n")
        return: 1
    if: source_only = 0
        c.fprintf(c.stderr, "trans L2 join error: runtime join lowering is not implemented\n")
        return: 1
    if: materialize_source = 0 || (lm_trans_current_source_path != 0 && lm_trans_registry_path_is_predefined(lm_trans_current_source_path) != 0)
        return: 0
return: lm_trans_materialize_l2_join_source(namespace_, frame)

fn: lm_trans_declare_l2_join (LmTransNamespace: namespace_; const: (LmP0Frame: frame)) int
return: lm_trans_declare_l2_join_mode(namespace_, frame, 1)

fn: lm_trans_declare_l2_table_mode (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
    int: materialize_source
) int
    int: source_only

    if: frame = 0 || lm_trans_l2_table_body_is_source_only(frame\body, "table", @ source_only) != 0
        return: 1
    if: source_only != 0 && lm_trans_l2_table_materialization_suppression_depth > 0
        c.fprintf(c.stderr, "trans L2 table error: Registry tables are not allowed in os/ifdef branches\n")
        return: 1
    if: source_only = 0 || materialize_source = 0 || lm_trans_l2_table_materialization_suppression_depth > 0 || (lm_trans_current_source_path != 0 && lm_trans_registry_path_is_predefined(lm_trans_current_source_path) != 0)
        return: 0
return: lm_trans_materialize_l2_table_source(namespace_, frame, 0)

fn: lm_trans_declare_l2_table (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
return: lm_trans_declare_l2_table_mode(namespace_, frame, 1)

fn: lm_trans_l2_table_cell_inline_layout_body (
    const: LmP0Node: node
    const: LmTransL4CallableType: expected_type
    const: LmTransNamespace: namespace_
) const: LmP0Structure
    const: LmP0Field: field
    const: LmP0Field: next
    const: LmP0Node: current

    if: node = 0 || expected_type = 0 || expected_type\class_name = 0
        return: 0
    if: lm_trans_effective_address_depth(expected_type\class_name, expected_type\address_depth, namespace_) != 1U
        return: 0
    if: lm_trans_namespace_layout_source_is_supported(namespace_, expected_type\class_name) = 0 && lm_trans_namespace_has_named_structure_binding(namespace_, expected_type\class_name) = 0
        return: 0
    current: node
    while: current != 0 && current\kind = c.LM_P0_NODE_STRUCTURE
        field: lm_trans_l2_table_first_cell_field(current\as\structure)
        if: field = 0
            return: 0
        next: lm_trans_l2_table_next_cell_field(field)
        if: next = 0 && field\value != 0
            if: field\value\kind = c.LM_P0_NODE_STRUCTURE
                current: field\value
                continue
            if: field\value\kind = c.LM_P0_NODE_FRAME && lm_trans_identifier_same(field\value\as\frame\head, expected_type\class_name)
                return: field\value\as\frame\body
            ---
        ---
        while: field != 0
            if: field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME || (field\value\as\frame\flags & c.LM_P0_FRAME_COLON) = 0U
                return: 0
            field: lm_trans_l2_table_next_cell_field(field)
        ---
        return: current\as\structure
    ---
    if: current != 0 && current\kind = c.LM_P0_NODE_FRAME && lm_trans_identifier_same(current\as\frame\head, expected_type\class_name)
        return: current\as\frame\body
return: 0

fn: lm_trans_l2_table_cell_storage_name_new (const: @(char object_name); size_t: row_index; size_t: column_index) @: char
    c.array: [64]: char suffix

    c.snprintf(suffix, c.sizeof(suffix), "_r%zu_c%zu", row_index, column_index)
return: lm_trans_l2_object_suffix_name_new(object_name, suffix)

fn: lm_trans_l2_table_layout_field_type (
    const: LmP0Text: owner
    const: LmP0Text: field_name
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
) int
    @: char relation_name
    @: char descriptor_field_name
    const: @: char field_class
    const: @: char address_depth_payload
    const: @: char const_payload
    const: LmTransDescriptor: descriptor
    const: LmTransDescriptorField: descriptor_field
    size_t: address_depth
    size_t: const_flag

    if: owner = 0 || field_name = 0 || namespace_ = 0 || out_type = 0
        return: 0

    descriptor: lm_trans_namespace_descriptor(namespace_, owner)
    if: descriptor != 0 && descriptor\has_structural_fields
        descriptor_field_name: lm_trans_descriptor_name_copy(field_name)
        if: descriptor_field_name = 0
            return: 0
        descriptor_field: lm_trans_descriptor_structural_field(descriptor, descriptor_field_name)
        lm_own_delete(descriptor_field_name, 0)
        if: descriptor_field = 0 || descriptor_field\is_union || descriptor_field\descriptor_name = 0
            c.fprintf(c.stderr, "trans L2 table error: inline row value field \"%.*s\" is not declared on \"%.*s\"\n", (cast: int field_name\length), field_name\data, (cast: int owner\length), owner\data)
            return: 0
        return: lm_trans_named_structure_type_set_cstr(out_type, descriptor_field\descriptor_name, descriptor_field\address_depth, descriptor_field\is_const)
    ---

    relation_name: lm_trans_registry_relation_name_new(owner, ".field.class")
    if: relation_name = 0
        return: 0
    field_class: lm_trans_namespace_registry_source_path_n2_named_typed_value(namespace_, field_name, relation_name, "class", "class", "field", "class")
    lm_own_delete(relation_name, 0)
    if: field_class = 0
        c.fprintf(c.stderr, "trans L2 table error: inline row value field \"%.*s\" is not declared on \"%.*s\"\n", (cast: int field_name\length), field_name\data, (cast: int owner\length), owner\data)
        return: 0

    address_depth: 0U
    relation_name: lm_trans_registry_relation_name_new(owner, ".field.address-depth")
    if: relation_name = 0
        return: 0
    address_depth_payload: lm_trans_namespace_registry_source_path_n2_named_typed_value(namespace_, field_name, relation_name, "class", "class", "depth", "size_t")
    lm_own_delete(relation_name, 0)
    if: address_depth_payload != 0 && lm_trans_parse_size_payload(address_depth_payload, @ address_depth) = 0
        c.fprintf(c.stderr, "trans L2 table error: inline row value field \"%.*s\" on \"%.*s\" has invalid field.address-depth\n", (cast: int field_name\length), field_name\data, (cast: int owner\length), owner\data)
        return: 0

    const_flag: 0U
    relation_name: lm_trans_registry_relation_name_new(owner, ".field.const")
    if: relation_name = 0
        return: 0
    const_payload: lm_trans_namespace_registry_source_path_n2_named_typed_value(namespace_, field_name, relation_name, "class", "class", "value", "int")
    lm_own_delete(relation_name, 0)
    if: const_payload != 0 && lm_trans_parse_size_payload(const_payload, @ const_flag) = 0
        c.fprintf(c.stderr, "trans L2 table error: inline row value field \"%.*s\" on \"%.*s\" has invalid field.const\n", (cast: int field_name\length), field_name\data, (cast: int owner\length), owner\data)
        return: 0

return: lm_trans_named_structure_type_set_cstr(out_type, field_class, address_depth, const_flag != 0U)

fn: lm_trans_emit_l2_table_expr_with_expected_type (
    FILE: file
    const: LmP0Field: first
    const: LmP0Field: stop
    LmTransNamespace: namespace_
    const: LmTransL4CallableType: expected_type
) int
    if: expected_type = 0 || expected_type\class_name = 0
        return: 1
return: lm_trans_emit_expr_range_with_expected_type(file, first, stop, namespace_, expected_type)

fn: lm_trans_l2_runtime_table_row_name_new (const: @(char base_name); size_t: row_index) @: char
    c.array: [64]: char suffix

    c.snprintf(suffix, c.sizeof(suffix), "_row_%zu", row_index)
return: lm_trans_l2_object_suffix_name_new(base_name, suffix)

fn: lm_trans_emit_l2_runtime_table_allocation_guard (
    FILE: file
    const: @(char name)
    unsigned: indent
    int: module_initializer
) int
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_put(file, name) != 0 || lm_trans_put(file, " == 0) {") != 0
        return: 1
    if: module_initializer
        if: lm_trans_put(file, " return 1; }\n") != 0
            return: 1
        ---
    else:
        if: lm_trans_put(file, " abort(); }\n") != 0
            return: 1
        ---
    ---
return: 0

fn: lm_trans_l2_runtime_table_expression_node_is_complete (
    const: LmP0Node: node
    const: LmTransL4CallableType: expected_type
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: first

    if: lm_trans_l2_table_cell_node_is_present(node) = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        if: expected_type != 0 && expected_type\class_name != 0 && lm_trans_contextual_literal_value(namespace_, node\as\atom, expected_type\class_name) != 0
            return: 1
        return: lm_trans_text_is_operator_atom(node\as\atom) = 0 && lm_trans_text_equals(node\as\atom, "@") = 0 && lm_trans_text_equals(node\as\atom, "\\") = 0
    if: node\kind = c.LM_P0_NODE_FRAME
        return: 1
    if: node\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
    first: lm_trans_l2_table_first_cell_field(node\as\structure)
    if: first = 0
        return: 0
return: lm_trans_expr_segment_end(first) = 0

fn: lm_trans_l2_runtime_table_validate_member_expression (
    const: LmP0Field: first
    const: LmP0Field: stop
    const: LmTransL4CallableType: expected_type
    const: LmTransNamespace: namespace_
) int
    const: LmP0Node: node
    const: LmP0Node: candidate
    const: LmP0Field: field
    const: LmP0Field: next
    LmTransL4CallableType: actual_type
    size_t: actual_depth
    size_t: expected_depth
    size_t: zero_index
    int: zero_literal
    int: known_type

    field: first
    while: field != 0 && field != stop && lm_trans_l2_table_cell_node_is_present(field\value) = 0
        field: field\next
    if: field = 0 || field = stop || field\value = 0
        return: 1
    next: lm_trans_l2_table_next_cell_field(field)
    if: next != stop || lm_trans_l2_runtime_table_expression_node_is_complete(field\value, expected_type, namespace_) = 0
        c.fprintf(c.stderr, "trans L2 Table error: each runtime Table cell must be one complete expression; group compound expressions with parentheses\n")
        return: 1

    node: field\value
    candidate: node
    while: candidate != 0 && candidate\kind = c.LM_P0_NODE_STRUCTURE
        field: lm_trans_l2_table_first_cell_field(candidate\as\structure)
        if: field = 0 || lm_trans_l2_table_next_cell_field(field) != 0 || field\value = 0
            candidate: 0
        else:
            candidate: field\value
        ---
    ---
    if: candidate = 0 || expected_type = 0
        return: 0
    expected_depth: lm_trans_effective_address_depth(expected_type\class_name, expected_type\address_depth, namespace_)
    if: candidate\kind = c.LM_P0_NODE_ATOM && expected_depth != 0U && lm_trans_named_structure_atom_is_decimal_literal(candidate\as\atom)
        zero_literal: 1
        zero_index: 0U
        while: zero_index < candidate\as\atom\length
            if: candidate\as\atom\data[zero_index] != '0'
                zero_literal: 0
            zero_index: zero_index + 1U
        if: zero_literal
            return: 0
        ---
    ---

    actual_type: lm_trans_expr_callable_type_new()
    if: actual_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(actual_type)
    known_type: lm_trans_runtime_table_indexed_field_type(first, stop, namespace_, actual_type)
    if: known_type < 0
        return: 1
    if: known_type = 0
        if: candidate\kind = c.LM_P0_NODE_ATOM
            known_type: lm_trans_named_structure_field_type_from_atom(candidate\as\atom, namespace_, actual_type)
            if: known_type != 0 && (lm_trans_namespace_value_is_raw_pointer(namespace_, candidate\as\atom) || lm_trans_namespace_value_is_array_reference(namespace_, candidate\as\atom))
                actual_type\address_depth: lm_trans_namespace_value_raw_pointer_depth(namespace_, candidate\as\atom)
                actual_type\is_const: lm_trans_namespace_value_raw_pointer_base_is_const(namespace_, candidate\as\atom)
                if: lm_trans_namespace_value_is_array_reference(namespace_, candidate\as\atom)
                    actual_type\array_rank: lm_trans_namespace_value_array_reference_rank(namespace_, candidate\as\atom)
                    actual_type\address_depth: lm_trans_namespace_value_array_reference_element_address_depth(namespace_, candidate\as\atom) + 1U
                    actual_type\is_const: lm_trans_namespace_value_array_reference_element_is_const(namespace_, candidate\as\atom)
                ---
            ---
            if: known_type = 0 && (lm_trans_text_equals(candidate\as\atom, "c.stdin") || lm_trans_text_equals(candidate\as\atom, "c.stdout") || lm_trans_text_equals(candidate\as\atom, "c.stderr"))
                known_type: lm_trans_named_structure_type_set_cstr(actual_type, "void", 1U, 0)
            ---
        else:
            if: candidate\kind = c.LM_P0_NODE_FRAME
                if: lm_trans_symbol_is(lm_trans_namespace_find(namespace_, expected_type\class_name), "callableDescriptor") = 0
                    known_type: lm_trans_node_result_type(candidate, namespace_, actual_type)
                    if: known_type < 0
                        return: 1
                    ---
                ---
            ---
        ---
    ---
    if: known_type = 0
        return: 0
    if: actual_type\array_rank != expected_type\array_rank
        c.fprintf(c.stderr, "trans L2 Table type error: runtime Table cell does not match its column type\n")
        return: 1
    actual_depth: lm_trans_effective_address_depth(actual_type\class_name, actual_type\address_depth, namespace_)
    if: (actual_depth = 0U) != (expected_depth = 0U)
        c.fprintf(c.stderr, "trans L2 Table type error: runtime Table cell does not match its column type\n")
        return: 1
    if: actual_depth = 0U && (lm_trans_symbol_is(lm_trans_namespace_find(namespace_, actual_type\class_name), "callableDescriptor") || lm_trans_symbol_is(lm_trans_namespace_find(namespace_, expected_type\class_name), "callableDescriptor")) && lm_trans_identifier_same(actual_type\class_name, expected_type\class_name) = 0
