return: type_receiver\type_structure_value_alloc(file, indent, type_node, target_name, value, namespace_, out_consumed, out_needs_null_check)

fn: lm_trans_emit_type_receiver_structure_value_fill (
    FILE: file
    unsigned: indent
    const: LmP0Node: type_node
