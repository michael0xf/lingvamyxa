return: type_receiver\type_structure_value_fill(file, indent, type_node, target_name, value, namespace_, out_consumed)

fn: lm_trans_expr_segment_single_structure_value (
    const: LmTransExprSegment: segment
) const: LmP0Structure
    if: segment = 0 || segment\first = 0 || segment\first\next != segment\stop || segment\first\value = 0 || segment\first\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

return: segment\first\value\as\structure

fn: lm_trans_expr_segment_single_atom (
    const: LmTransExprSegment: segment
    LmP0Text: out_atom
) int
    if: out_atom != 0
        out_atom\data: ""
        out_atom\length: 0U
    if: segment = 0 || out_atom = 0 || segment\first = 0 || segment\first\next != segment\stop || segment\first\value = 0 || segment\first\value\kind != c.LM_P0_NODE_ATOM
        return: 0

    out_atom[0]: segment\first\value\as\atom[0]
return: 1

fn: lm_trans_array_value_helper_name_new () @: char
    [64]: char buffer
    int: written
    @: char name

    written: c.snprintf(buffer, c.sizeof(buffer), "lm_trans_array_value_%u", lm_trans_next_array_value_helper_id)
    lm_trans_next_array_value_helper_id: lm_trans_next_array_value_helper_id + 1U
    if: written < 0 || (cast: size_t written) >= c.sizeof(buffer)
        return: 0

    name: (cast: (@: char) lm_own_new_zero((cast: size_t written) + 1U))
    if: name = 0
        return: 0
    c.memcpy(name, buffer, (cast: size_t written) + 1U)
return: name

fn: lm_trans_array_formal_param_type_info (
    const: LmTransFormalParam: param
    const: @(LmP0Node out_element_type)
    @: size_t out_rank
    @: size_t out_pointer_depth
) int
    LmP0Text: dimension
    size_t: dimension_index
    size_t: rank

    if: out_element_type != 0
        out_element_type[0]: 0
    if: out_rank != 0
        out_rank[0]: 0U
    if: out_pointer_depth != 0
        out_pointer_depth[0]: 0U

    if: param = 0 || param\is_array = 0 || param\declarator = 0
        return: 0

    dimension_index: 0U
    rank: 0U
    dimension: lm_trans_text_ref_new_cstr("")
    if: dimension = 0
        return: 0
    while: lm_trans_array_head_next_dimension(param\declarator\array_head, @ dimension_index, dimension)
        rank: rank + 1U
    if: rank = 0U
        lm_trans_text_ref_destroy(@ dimension)
        return: 0

    if: out_element_type != 0
        out_element_type[0]: param\declarator\type_node
    if: out_rank != 0
        out_rank[0]: rank
    if: out_pointer_depth != 0
        out_pointer_depth[0]: param\declarator\pointer_depth
    lm_trans_text_ref_destroy(@ dimension)
return: 1

fn: lm_trans_emit_array_value_helper (
    FILE: file
    const: LmTransFormalParam: param
    const: LmP0Structure: value
    const: LmTransNamespace: namespace_
    LmP0Text: out_name
) int
    FILE: prelude_file
    const: LmP0Node: element_type
    LmP0Text: helper_name_text
    LmP0Text: target_name
    LmP0Text: slice_name
    @: char helper_name
    size_t: rank
    size_t: pointer_depth
    size_t: count

    if: out_name != 0
        out_name\data: ""
        out_name\length: 0U
    if: out_name = 0 || value = 0 || lm_trans_array_formal_param_type_info(param, @ element_type, @ rank, @ pointer_depth) = 0
        return: 1

    helper_name: lm_trans_array_value_helper_name_new()
    if: helper_name = 0
        return: 1
    finally: lm_own_delete(helper_name, 0)

    helper_name_text: lm_trans_text_ref_new_cstr(helper_name)
    target_name: lm_trans_text_ref_new_cstr("lm_value")
    slice_name: lm_trans_text_ref_new_cstr("lm_slice")
    if: helper_name_text = 0 || target_name = 0 || slice_name = 0
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ helper_name_text)
        lm_trans_text_ref_destroy(@ target_name)
        lm_trans_text_ref_destroy(@ slice_name)

    prelude_file: lm_trans_prelude_file(file)
    count: lm_trans_structure_field_count(value)

    if: lm_trans_emit_message_thread_runtime_prelude(prelude_file) != 0
        return: 1
    if: lm_trans_put(prelude_file, "static LmSlice *") != 0 || lm_trans_emit_identifier(prelude_file, helper_name_text) != 0 || lm_trans_put(prelude_file, "(struct LmMessageThread *lm_lmx_message_thread) {\n    ") != 0 || lm_trans_emit_array_pointer_type(prelude_file, element_type, pointer_depth + rank, namespace_) != 0 || lm_trans_put(prelude_file, " ") != 0 || lm_trans_write_text(prelude_file, target_name) != 0 || lm_trans_put(prelude_file, ";\n    LmSlice *") != 0 || lm_trans_write_text(prelude_file, slice_name) != 0 || lm_trans_put(prelude_file, ";\n") != 0
        return: 1
    if: lm_trans_emit_array_structure_value_alloc_assignment(prelude_file, 1U, target_name, 0, 0U, element_type, pointer_depth + rank, rank, count, namespace_) != 0
        return: 1

    if: count != 0U && (lm_trans_put(prelude_file, "    if (") != 0 || lm_trans_write_text(prelude_file, target_name) != 0 || lm_trans_put(prelude_file, " == 0) {\n        return 0;\n    }\n") != 0)
        return: 1

    if: count != 0U && lm_trans_emit_array_structure_value_fill(prelude_file, 1U, target_name, element_type, rank, value, namespace_) != 0
        return: 1

    if: lm_trans_put(prelude_file, "    ") != 0 || lm_trans_write_text(prelude_file, slice_name) != 0 || lm_trans_put(prelude_file, " = (LmSlice *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*") != 0 || lm_trans_write_text(prelude_file, slice_name) != 0 || lm_trans_put(prelude_file, "));\n    if (") != 0 || lm_trans_write_text(prelude_file, slice_name) != 0 || lm_trans_put(prelude_file, " == 0) {\n        return 0;\n    }\n    ") != 0 || lm_trans_write_text(prelude_file, slice_name) != 0 || lm_trans_put(prelude_file, "->ptr = (void *)") != 0 || lm_trans_write_text(prelude_file, target_name) != 0 || lm_trans_put(prelude_file, ";\n    ") != 0 || lm_trans_write_text(prelude_file, slice_name) != 0 || lm_trans_put(prelude_file, "->length = ") != 0 || lm_trans_emit_size_literal(prelude_file, count) != 0 || lm_trans_put(prelude_file, ";\n    return ") != 0 || lm_trans_write_text(prelude_file, slice_name) != 0 || lm_trans_put(prelude_file, ";\n}\n\n") != 0
        return: 1

    if: lm_own_ptr_stack_push(lm_trans_emitted_array_value_helpers, helper_name) != 0
        return: 1

    out_name[0]: helper_name_text[0]
    helper_name: 0
return: 0

fn: lm_trans_materialize_array_value (
    FILE: file
    LmTransExprStack: stack
    const: LmTransExprSegment: segment
    const: LmTransNamespace: namespace_
    @: int out_consumed
) int
    const: LmP0Structure: value
    LmP0Text: helper_name
    LmP0Text: atom
    LmP0Text: slice_expr
    LmP0Text: slice_length
    const: LmTransFormalParam: param

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0
        return: 1

    atom: lm_trans_statement_text_new()
    slice_expr: lm_trans_statement_text_new()
    slice_length: lm_trans_statement_text_new()
    if: atom = 0 || slice_expr = 0 || slice_length = 0
        lm_trans_text_ref_destroy(@ atom)
        lm_trans_text_ref_destroy(@ slice_expr)
        lm_trans_text_ref_destroy(@ slice_length)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ atom)
        lm_trans_text_ref_destroy(@ slice_expr)
        lm_trans_text_ref_destroy(@ slice_length)

    if: lm_trans_expr_segment_single_atom(segment, atom) && lm_trans_namespace_relation_text_latest(namespace_, atom, "variable.slice-name", slice_expr)
        if: lm_trans_expr_stack_push_text(stack, slice_expr\data) != 0
            return: 1
        out_consumed[0]: 1
        return: 0

    if: lm_trans_expr_segment_single_atom(segment, atom) && lm_trans_namespace_relation_text_latest(namespace_, atom, "variable.slice-length", slice_length)
        if: lm_trans_expr_stack_push_text(stack, " }") != 0 || lm_trans_expr_stack_push_text(stack, slice_length\data) != 0 || lm_trans_expr_stack_push_text(stack, ", ") != 0 || lm_trans_expr_stack_push_name_text(stack, atom) != 0 || lm_trans_expr_stack_push_text(stack, "(void *)") != 0 || lm_trans_expr_stack_push_text(stack, "&(LmSlice){ ") != 0
            return: 1
        out_consumed[0]: 1
        return: 0

    value: lm_trans_expr_segment_single_structure_value(segment)
    if: value = 0
        return: 0

    helper_name: lm_trans_statement_text_new()
    if: helper_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ helper_name)

    param: 0
    if: segment != 0
        param: segment\expected_param
    if: lm_trans_emit_array_value_helper(file, param, value, namespace_, helper_name) != 0 || lm_trans_expr_stack_push_text(stack, ")") != 0 || lm_trans_expr_stack_push_text(stack, "lm_lmx_message_thread") != 0 || lm_trans_expr_stack_push_text(stack, "(") != 0 || lm_trans_expr_stack_push_name_text(stack, helper_name) != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_return_name_text (unsigned: id; @: char buffer; size_t: buffer_size; LmP0Text: out_name) int
    int: written

    if: buffer = 0 || buffer_size = 0U || out_name = 0
        return: 1
    written: c.snprintf(buffer, buffer_size, "lm_return_%u", id)
    if: written < 0 || (cast: size_t written) >= buffer_size
        return: 1
    out_name\data: buffer
    out_name\length: (cast: size_t written)
return: 0

fn: lm_trans_emit_fm_result_prologue (
    FILE: file
    const: LmP0Text: function_name
    unsigned: indent
) int
    if: file = 0 || function_name = 0
        return: 1
    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, " *lm_fm_result = (") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*lm_fm_result));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (lm_fm_result == 0) {\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_typed_value_return_statement (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
    @: int out_consumed
) int
    const: LmP0Structure: structure_value
    LmP0Text: return_name
    [64]: char return_name_storage
    unsigned: return_id
    int: can_consume
    int: needs_null_check
    int: filled

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0 || namespace_ = 0 || namespace_\return_type_node = 0 || namespace_\return_type_is_struct
        return: 0

    structure_value: lm_trans_fields_single_structure_value(return_fields)
    if: structure_value = 0
        return: 0
    if: lm_trans_type_receiver_structure_value_can_consume(namespace_\return_type_node, structure_value, @ can_consume) != 0
        return: 1
    if: can_consume = 0
        return: 0

    return_name: lm_trans_statement_text_new()
    if: return_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ return_name)

    return_id: namespace_\next_return_id
    namespace_\next_return_id: namespace_\next_return_id + 1U
    if: lm_trans_return_name_text(return_id, return_name_storage, c.sizeof(return_name_storage), return_name) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0
        return: 1
    if: lm_trans_emit_current_return_type(file, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_type_receiver_structure_value_alloc(file, indent + 1U, namespace_\return_type_node, return_name, structure_value, namespace_, out_consumed, @ needs_null_check) != 0
        return: 1
    if: out_consumed[0] = 0
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        return: 0

    if: needs_null_check
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (") != 0
            return: 1
        if: lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, " == 0) {\n") != 0
            return: 1
        if: lm_trans_emit_cleanups_until(file, indent + 2U, namespace_, 0U) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "return 0;\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
    ---

    if: lm_trans_emit_type_receiver_structure_value_fill(file, indent + 1U, namespace_\return_type_node, return_name, structure_value, namespace_, @ filled) != 0
        return: 1
    if: filled = 0
        c.fprintf(c.stderr, "trans L2 error: return type receiver accepted Structure value allocation but not fill\n")
        return: 1

    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return ") != 0
        return: 1
    if: lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

fn: lm_trans_struct_return_field_name_at (
    const: LmP0Structure: descriptor
    size_t: index
    LmP0Text: out_name
) int
    const: LmP0Field: field

    if: descriptor = 0 || out_name = 0
        return: 0

    field: lm_trans_nth_field(descriptor, index)
    if: field = 0 || field\value = 0
        return: 0

return: lm_trans_formal_param_name(field\value, out_name)

fn: lm_trans_struct_return_field_index (
    const: LmP0Structure: descriptor
    const: LmP0Text: name
    @: size_t out_index
) int
    const: LmP0Field: field
    LmP0Text: field_name
    size_t: index

    if: descriptor = 0 || out_index = 0
        return: 0

    field_name: lm_trans_statement_text_new()
    if: field_name = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ field_name)

    index: 0U
    field: descriptor\first_field
    while: field != 0
        if: field\value != 0 && lm_trans_formal_param_name(field\value, field_name) && lm_trans_identifier_same(field_name, name)
            out_index[0]: index
            return: 1
        index: index + 1U
        field: field\next

return: 0

fn: lm_trans_struct_return_field_values_new (size_t: count) @: LmTransStructReturnFieldValue
    @: LmTransStructReturnFieldValue values
    size_t: index

    values: (cast: (@: LmTransStructReturnFieldValue) lm_own_new_zero(c.sizeof(values[0]) * count))
    if: values = 0
        return: 0

    index: 0U
    while: index < count
        values[index]: (cast: (LmTransStructReturnFieldValue) lm_own_new_zero(c.sizeof(values[index][0])))
        if: values[index] = 0
            while: index != 0U
                index: index - 1U
                lm_own_delete(values[index], 0)
            lm_own_delete(values, 0)
            return: 0
        index: index + 1U

return: values

sub: lm_trans_struct_return_field_values_delete (
    @: LmTransStructReturnFieldValue values
    size_t: count
)
    size_t: index

    if: values = 0
        return
    index: 0U
    while: index < count
        lm_own_delete(values[index], 0)
        index: index + 1U
    lm_own_delete(values, 0)
end: lm_trans_struct_return_field_values_delete

fn: lm_trans_struct_return_collect_value_fields (
    const: LmP0Structure: descriptor
    const: LmP0Structure: value
    @: LmTransStructReturnFieldValue fields
    size_t: field_count
) int
    const: LmP0Field: field
    const: LmP0Frame: frame
    size_t: positional_index
    size_t: named_index
    int: positional_disabled
    int: named_in_position

    if: descriptor = 0 || value = 0 || fields = 0
        return: 1

    positional_index: 0U
    positional_disabled: 0
    field: value\first_field
    while: field != 0
        if: field\value = 0
            field: field\next
            continue
        if: lm_trans_node_is_positional_skip(field\value)
            if: positional_disabled
                c.fprintf(c.stderr, "trans L2 error: positional skip after out-of-position named fm return field\n")
                return: 1
            positional_index: positional_index + 1U
            field: field\next
            continue

        if: field\value\kind = c.LM_P0_NODE_FRAME && (field\value\as\frame\flags & c.LM_P0_FRAME_COLON) != 0U && lm_trans_struct_return_field_index(descriptor, field\value\as\frame\head, @ named_index)
            frame: field\value\as\frame
            if: fields[named_index]\present
                c.fprintf(c.stderr, "trans L2 error: duplicate named fm return field\n")
                return: 1
            if: frame\body\first_field = 0
                c.fprintf(c.stderr, "trans L2 error: named fm return field expects a value\n")
                return: 1
            fields[named_index]\first: frame\body\first_field
            fields[named_index]\stop: 0
            fields[named_index]\present: 1
            named_in_position: named_index = positional_index
            if: named_index = positional_index
                positional_index: positional_index + 1U
            if: named_in_position = 0
                positional_disabled: 1
            field: field\next
            continue

        if: positional_disabled
            c.fprintf(c.stderr, "trans L2 error: positional fm return field after out-of-position named field\n")
            return: 1
        if: positional_index >= field_count
            c.fprintf(c.stderr, "trans L2 error: too many positional fm return fields\n")
            return: 1
        if: fields[positional_index]\present
            c.fprintf(c.stderr, "trans L2 error: duplicate positional fm return field\n")
            return: 1
        fields[positional_index]\first: field
        fields[positional_index]\stop: field\next
        fields[positional_index]\present: 1
        positional_index: positional_index + 1U
        field: field\next

return: 0

fn: lm_trans_emit_struct_value_return_statement (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
    @: int out_consumed
) int
    const: LmP0Structure: descriptor
    const: LmP0Structure: value
    @: LmTransStructReturnFieldValue values
    LmP0Text: field_name
    size_t: field_count
    size_t: index

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0 || namespace_ = 0 || namespace_\return_type_is_struct = 0 || namespace_\return_type_node = 0 || namespace_\return_type_node\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

    value: lm_trans_fields_single_structure_value(return_fields)
    if: value = 0
        return: 0

    descriptor: namespace_\return_type_node\as\structure
    field_count: lm_trans_structure_field_count(descriptor)
    if: field_count = 0U
        c.fprintf(c.stderr, "trans L2 error: fm return Structure must not be empty\n")
        return: 1

    field_name: lm_trans_statement_text_new()
    if: field_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ field_name)

    values: lm_trans_struct_return_field_values_new(field_count)
    if: values = 0
        return: 1
    finally: lm_trans_struct_return_field_values_delete(values, field_count)

    if: lm_trans_struct_return_collect_value_fields(descriptor, value, values, field_count) != 0
        return: 1
    index: 0U
    while: index < field_count
        if: values[index]\present = 0
            c.fprintf(c.stderr, "trans L2 error: fm Structure return literal does not fill every return field\n")
            return: 1
        index: index + 1U

    index: 0U
    while: index < field_count
        if: lm_trans_struct_return_field_name_at(descriptor, index, field_name) = 0
            c.fprintf(c.stderr, "trans L2 error: fm return field must expose a binding name\n")
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_fm_result->") != 0 || lm_trans_emit_identifier(file, field_name) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_expr_range(file, values[index]\first, values[index]\stop, namespace_) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        index: index + 1U

    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "return lm_fm_result;\n") != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_current_return_is_callable_descriptor (
    const: LmTransNamespace: namespace_
    LmP0Text: out_type
) int
    const: LmTransSymbol: symbol
    const: LmP0Text: type_name

    if: namespace_ = 0 || namespace_\return_type_node = 0 || namespace_\return_type_node\kind != c.LM_P0_NODE_ATOM
        return: 0

    type_name: namespace_\return_type_node\as\atom
    symbol: lm_trans_namespace_find(namespace_, type_name)
    if: lm_trans_symbol_is(symbol, "callableDescriptor") = 0
        return: 0
    if: out_type != 0
        out_type[0]: type_name[0]
return: 1

fn: lm_trans_emit_raw_callable_return_statement (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
    @: int out_consumed
) int
    LmP0Text: atom
    LmP0Text: descriptor_type
    LmP0Text: return_name
    const: LmTransSymbol: symbol
    LmTransCallableValue: value
    [64]: char return_name_storage
    unsigned: return_id

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0
        return: 0

    atom: lm_trans_statement_text_new()
    if: atom = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ atom)

    descriptor_type: lm_trans_statement_text_new()
    if: descriptor_type = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ descriptor_type)

    value: lm_trans_callable_value_new()
    if: value = 0
        return: 1
    finally: lm_trans_callable_value_delete(value)

    return_name: lm_trans_statement_text_new()
    if: return_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ return_name)

    if: lm_trans_return_fields_single_atom(return_fields, atom) = 0 || lm_trans_current_return_is_callable_descriptor(namespace_, descriptor_type) = 0 || lm_trans_registry_is_function_pointer_type_name(namespace_, descriptor_type) || lm_trans_callable_descriptor_is_raw_function_reference(namespace_, descriptor_type) = 0
        return: 0

    symbol: lm_trans_callable_value_resolve(namespace_, atom, value)
    if: symbol = 0 || lm_trans_symbol_is_executable_callable(symbol) = 0 || lm_trans_callable_signature_matches_descriptor_name(descriptor_type, symbol, namespace_) = 0
        return: 0

    if: value\has_env_arg || value\uses_closure_struct
        c.fprintf(
            c.stderr,
            "trans L2 error: cannot return capturing callable %.*s as raw descriptor %.*s; descriptor must admit callable.capture\n",
            (cast: int atom\length),
            atom\data,
            (cast: int descriptor_type\length),
            descriptor_type\data
        )
        return: 1

    if: namespace_ != 0 && namespace_\cleanups\count > 0U
        return_id: namespace_\next_return_id
        namespace_\next_return_id: namespace_\next_return_id + 1U
        if: lm_trans_return_name_text(return_id, return_name_storage, c.sizeof(return_name_storage), return_name) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0 || lm_trans_emit_indent(file, indent + 1U) != 0
            return: 1
        if: lm_trans_emit_raw_callable_declarator(file, namespace_, descriptor_type, return_name, "raw callable return") != 0
            return: 1
        if: lm_trans_put(file, " = ") != 0 || lm_trans_write_text(file, value\code_name) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return ") != 0 || lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        out_consumed[0]: 1
        return: 0

    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "return ") != 0 || lm_trans_write_text(file, value\code_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_emit_closure_return_statement (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
    @: int out_consumed
) int
    LmP0Text: atom
    LmP0Text: descriptor_type
    const: LmTransSymbol: symbol
    LmTransCallableValue: value
    @: char closure_value_name

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0
        return: 0

    atom: lm_trans_statement_text_new()
    if: atom = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ atom)

    descriptor_type: lm_trans_statement_text_new()
    if: descriptor_type = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ descriptor_type)

    value: lm_trans_callable_value_new()
    if: value = 0
        return: 1
    finally: lm_trans_callable_value_delete(value)

    closure_value_name: 0
    finally: lm_own_delete(closure_value_name, 0)

    if: lm_trans_return_fields_single_atom(return_fields, atom) = 0 || lm_trans_current_return_is_callable_descriptor(namespace_, descriptor_type) = 0
        return: 0
    symbol: lm_trans_callable_value_resolve(namespace_, atom, value)
    if: symbol = 0 || lm_trans_symbol_is(symbol, "function") = 0
        return: 0
    if: value\has_closure_call = 0
        return: 0
    if: lm_trans_callable_descriptor_allows_capture(namespace_, descriptor_type) = 0
        c.fprintf(
            c.stderr,
            "trans L2 error: callable descriptor %.*s does not admit callable.capture for returned closure %.*s\n",
            (cast: int descriptor_type\length),
            descriptor_type\data,
            (cast: int atom\length),
            atom\data
        )
        return: 1
    if: lm_trans_callable_descriptor_uses_closure_struct(namespace_, descriptor_type) = 0
        c.fprintf(
            c.stderr,
            "trans L2 error: callable descriptor %.*s admits callable.capture but callable.projection is not c.closure-struct\n",
            (cast: int descriptor_type\length),
            descriptor_type\data
        )
        return: 1
    if: lm_trans_callable_signature_matches_descriptor_name(descriptor_type, symbol, namespace_) = 0
        c.fprintf(
            c.stderr,
            "trans L2 error: returned closure %.*s is incompatible with callable descriptor %.*s\n",
            (cast: int atom\length),
            atom\data,
            (cast: int descriptor_type\length),
            descriptor_type\data
        )
        return: 1

    closure_value_name: lm_trans_hoisted_suffix_name_new(value\code_name, "_closure_value")
    if: closure_value_name = 0
        return: 1

    out_consumed[0]: 1
    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "return ") != 0 || lm_trans_put(file, closure_value_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_message_thread_entry_return (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
    @: int out_consumed
) int
    unsigned: return_id

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0 || namespace_ = 0 || namespace_\message_thread_entry = 0
        return: 0

    return_id: namespace_\next_return_id
    namespace_\next_return_id: namespace_\next_return_id + 1U
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "int ") != 0 || lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, " = ") != 0
        return: 1
    if: return_fields = 0
        if: lm_trans_put(file, "0") != 0
            return: 1
    ---
    if: return_fields != 0
        if: lm_trans_emit_expr_fields(file, return_fields, namespace_) != 0
            return: 1
    ---
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "lm_message_thread_request_stop(lm_lmx_message_thread, ") != 0 || lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, ");\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "goto lm_message_thread_turn_end;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_emit_return_statement (
    FILE: file
    const: LmP0Field: return_fields
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Node: candidate_node
    const: LmTransDescriptor: required_descriptor
    LmTransL4CallableType: expected_type
    unsigned: return_id
    int: consumed

    candidate_node: 0
    if: return_fields != 0 && return_fields\next = 0 && return_fields\value != 0 && return_fields\value\kind = c.LM_P0_NODE_ATOM
        candidate_node: return_fields\value
    if: candidate_node != 0 && namespace_ != 0 && namespace_\return_type_node != 0
        expected_type: lm_trans_expr_callable_type_new()
        if: expected_type = 0
            return: 1
        if: lm_trans_l4_callable_type_from_node(namespace_\return_type_node, expected_type)
            required_descriptor: lm_trans_namespace_descriptor(namespace_, expected_type\class_name)
            if: lm_trans_guard_direct_structure_value_layout(namespace_, candidate_node\as\atom, required_descriptor, "return value") != 0
                lm_trans_expr_callable_type_delete(expected_type)
                return: 1
            ---
        ---
        lm_trans_expr_callable_type_delete(expected_type)
    ---

    if: lm_trans_emit_message_thread_entry_return(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: return_fields = 0
        if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        return: lm_trans_put(file, "return;\n")

    if: lm_trans_emit_raw_callable_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: lm_trans_emit_closure_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: lm_trans_emit_struct_value_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: lm_trans_emit_typed_value_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: namespace_ != 0 && namespace_\cleanups\count > 0U && namespace_\return_type_node != 0
        return_id: namespace_\next_return_id
        namespace_\next_return_id: namespace_\next_return_id + 1U
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        if: lm_trans_put(file, "{\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0
            return: 1
        if: lm_trans_emit_current_return_type(file, namespace_) != 0
            return: 1
        if: lm_trans_put(file, " ") != 0
            return: 1
        if: lm_trans_emit_return_name(file, return_id) != 0
            return: 1
        if: lm_trans_put(file, " = ") != 0
            return: 1
        if: lm_trans_emit_expr_fields(file, return_fields, namespace_) != 0
            return: 1
        if: lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0
            return: 1
        if: lm_trans_put(file, "return ") != 0
            return: 1
        if: lm_trans_emit_return_name(file, return_id) != 0
            return: 1
        if: lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        return: lm_trans_put(file, "}\n")

    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_put(file, "return ") != 0
        return: 1
    if: lm_trans_emit_expr_fields(file, return_fields, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_trailer_statement (
    FILE: file
    const: LmP0Trailer: trailer
    unsigned: indent
    LmTransNamespace: namespace_
) int
    if: trailer = 0
        return: 0

    if: lm_trans_text_equals(trailer\spelling, "return")
        return: lm_trans_emit_return_statement(file, trailer\body\first_field, indent, namespace_)

    if: lm_trans_text_equals(trailer\spelling, "end")
        return: 0

    c.fprintf(
        c.stderr,
        "trans error: unsupported trailer \"%.*s\"\n",
        (cast: int trailer\spelling\length),
        trailer\spelling\data
    )
return: 1

fn: lm_trans_emit_declaration_with_qualifier (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    const: LmP0Structure: body
    const: LmP0Field: name_field
    const: LmP0Node: name_node
    LmTransL4CallableType: expected_type
    int: is_raw_callable
    int: is_structural_default

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    name_field: lm_trans_nth_field(body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: declaration expects a name\n")
        return: 1

    name_node: name_field\value
    expected_type: 0
    finally: lm_trans_expr_callable_type_delete(expected_type)

    is_structural_default: (qualifier = 0 || qualifier[0] = '\0') && name_field\next = 0 && lm_trans_namespace_has_named_structure_binding(namespace_, frame\head)
    if: is_structural_default && lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1

    is_raw_callable: lm_trans_symbol_is(lm_trans_namespace_find(namespace_, frame\head), "callableDescriptor") && lm_trans_callable_descriptor_is_raw_function_reference(namespace_, frame\head)
    if: is_raw_callable && lm_trans_emit_raw_callable_declarator(file, namespace_, frame\head, name_node\as\atom, "callable descriptor") != 0
        return: 1
    if: is_raw_callable = 0 && lm_trans_emit_type_head_only(file, frame\head, namespace_) != 0
        return: 1
    if: is_raw_callable = 0 && lm_trans_put(file, " ") != 0
        return: 1
    if: is_raw_callable = 0 && lm_trans_emit_identifier(file, name_node\as\atom) != 0
        return: 1

    if: is_structural_default
        if: lm_trans_put(file, " = (") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*") != 0 || lm_trans_emit_identifier(file, name_node\as\atom) != 0 || lm_trans_put(file, "))") != 0
            return: 1
        ---
    else:
        if: name_field\next != 0
            expected_type: lm_trans_expr_callable_type_new()
            if: expected_type = 0
                return: 1
            expected_type\class_name[0]: frame\head[0]
            if: lm_trans_put(file, " = ") != 0
                return: 1
            if: lm_trans_emit_expr_range_with_expected_type(file, name_field\next, 0, namespace_, expected_type) != 0
                return: 1
        ---
    ---
    if: lm_trans_put(file, ";\n") != 0
        return: 1

    if: is_structural_default
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_emit_identifier(file, name_node\as\atom) != 0 || lm_trans_put(file, " == 0) {\n") != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "abort();\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
    ---
return: lm_trans_namespace_declare_storage_binding(namespace_, name_node\as\atom, frame\head)

fn: lm_trans_namespace_declare_storage_binding (
    LmTransNamespace: namespace_
    const: LmP0Text: name
    const: LmP0Text: type_head
) int
    LmTransSymbol: symbol
    const: LmTransSymbol: type_symbol
    const: @: char symbol_class
    int: status

    type_symbol: lm_trans_namespace_find(namespace_, type_head)
    if: lm_trans_symbol_is(type_symbol, "callableDescriptor")
        symbol_class: "closure"
        if: lm_trans_callable_descriptor_is_raw_function_reference(namespace_, type_head)
            symbol_class: "functionPointer"
        if: lm_trans_namespace_declare(namespace_, name, symbol_class) != 0
            return: 1
        symbol: lm_trans_namespace_find_mutable(namespace_, name)
        status: lm_trans_symbol_copy_signature(symbol, type_symbol)
        if: status = 0
            status: lm_trans_namespace_declare_relation_text(namespace_, name, "variable.type", type_head)
        return: status

    status: lm_trans_namespace_declare(namespace_, name, "variable")
    if: status = 0
        status: lm_trans_namespace_declare_relation_text(namespace_, name, "variable.type", type_head)
return: status

fn: lm_trans_namespace_declare_node_storage_binding (
    LmTransNamespace: namespace_
    const: LmP0Text: name
    const: LmP0Node: type_node
) int
    if: type_node != 0 && type_node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_namespace_declare_storage_binding(namespace_, name, type_node\as\atom)
return: lm_trans_namespace_declare(namespace_, name, "variable")

fn: lm_trans_emit_declaration (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
return: lm_trans_emit_declaration_with_qualifier(file, frame, indent, namespace_, "")

fn: lm_trans_atom_can_be_new_binding_name (const: (LmP0Text: text)) int
return: lm_trans_atom_is_identifier_like(text)

fn: lm_trans_head_can_declare_storage (
    const: LmP0Text: head
    const: LmTransNamespace: namespace_
) int
    const: LmTransSymbol: symbol

    if: lm_trans_builtin_c_type_name(head)
        return: 1
    if: lm_trans_text_all_char(head, '@') || lm_trans_text_is_array_receiver_head(head)
        return: 0
    if: lm_trans_is_reserved_head_name(head)
        return: 0
    if: lm_trans_namespace_has_named_structure_binding(namespace_, head)
        return: 1
    if: lm_trans_namespace_layout_source_is_supported(namespace_, head)
        return: 1
    if: lm_trans_namespace_class_has(namespace_, head)
        return: 1

    symbol: lm_trans_namespace_find(namespace_, head)
return: lm_trans_symbol_is(symbol, "class") || lm_trans_symbol_is(symbol, "callableDescriptor")

fn: lm_trans_frame_looks_storage_declaration (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    const: LmP0Field: name_field

    if: frame = 0 || lm_trans_head_can_declare_storage(frame\head, namespace_) = 0
        return: 0

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    name_field: lm_trans_nth_field(body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0

return: lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom)

fn: lm_trans_emit_pointer_declaration_with_qualifier (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    const: LmP0Structure: body
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Node: name_node

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    type_field: lm_trans_nth_field(body, 0U)
    name_field: lm_trans_nth_field(body, 1U)
    if: type_field = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: @ declaration expects type and name\n")
        return: 1

    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1
    if: lm_trans_emit_type_and_name(file, type_field\value, name_node\as\atom, frame\head\length, namespace_) != 0
        return: 1
    if: name_field\next != 0 && lm_trans_put(file, " = ") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_emit_expr_fields(file, name_field\next, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
return: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_field\value)

fn: lm_trans_emit_pointer_declaration (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
return: lm_trans_emit_pointer_declaration_with_qualifier(file, frame, indent, namespace_, "")

fn: lm_trans_emit_array_initializer_fields (
    FILE: file
    const: LmP0Field: first
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    int: wrote

    wrote: 0
    field: first
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && wrote && lm_trans_put(file, ", ") != 0
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0 && lm_trans_emit_array_initializer_node(file, field\value, namespace_) != 0
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0
            wrote: 1
        field: field\next

return: 0

fn: lm_trans_emit_array_initializer_structure (
    FILE: file
    const: LmP0Structure: structure
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: first

    first: 0
    if: structure != 0
        first: structure\first_field
    if: lm_trans_put(file, "{") != 0
        return: 1
    if: lm_trans_emit_array_initializer_fields(file, first, namespace_) != 0
        return: 1
return: lm_trans_put(file, "}")

fn: lm_trans_emit_array_initializer_node (
    FILE: file
    const: LmP0Node: node
    const: LmTransNamespace: namespace_
) int
    if: node = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: lm_trans_emit_array_initializer_structure(file, node\as\structure, namespace_)
    if: node\kind = c.LM_P0_NODE_FRAME && lm_trans_text_is_array_receiver_head(node\as\frame\head)
        return: lm_trans_emit_array_initializer_structure(file, node\as\frame\body, namespace_)
    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_emit_expr_atom_mode(file, node\as\atom, namespace_, 1)
return: lm_trans_emit_expr_node(file, node, namespace_)

fn: lm_trans_emit_array_initializer (
    FILE: file
    const: LmP0Field: first
    const: LmTransNamespace: namespace_
) int
    if: first != 0 && first\next = 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_STRUCTURE
        if: lm_trans_put(file, " = ") != 0
            return: 1
        return: lm_trans_emit_array_initializer_structure(file, first\value\as\structure, namespace_)

    if: lm_trans_put(file, " = {") != 0
        return: 1
    if: lm_trans_emit_expr_list(file, first, namespace_) != 0
        return: 1
return: lm_trans_put(file, "}")

fn: lm_trans_array_declarator_error (const: @(char message)) int
    if: message != 0
        c.fprintf(c.stderr, "%s\n", message)
return: 1

fn: lm_trans_array_declarator_read_from_frame (
    LmTransCDeclarator: declarator
    const: LmP0Frame: frame
    LmTransNamespace: namespace_
    int: allow_single_frame
    int: allow_type_head
    int: require_name
    const: @(char direct_error)
    const: @(char pointer_error)
    const: @(char nested_error)
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Frame: inner
    size_t: pointer_depth
    int: single_frame
    int: handled

    if: declarator = 0 || frame = 0 || declarator\type_head = 0 || declarator\name = 0 || declarator\array_head = 0
        return: 1

    declarator\type_node: 0
    declarator\expression_dimensions: 0
    declarator\type_head\data: ""
    declarator\type_head\length: 0U
    declarator\name\data: ""
    declarator\name\length: 0U
    declarator\array_head[0]: frame\head[0]
    declarator\pointer_depth: 0U
    declarator\literal_dimension_count: 0U
    declarator\type_is_head: 0

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    field: 0
    if: body != 0
        field: body\first_field

    single_frame: allow_single_frame && field != 0 && field\next = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
    if: single_frame
        inner: field\value\as\frame
        handled: 0
        if: allow_type_head && lm_trans_head_can_declare_storage(inner\head, namespace_)
            if: require_name
                name_field: inner\body\first_field
                if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
                    return: lm_trans_array_declarator_error(direct_error)
                declarator\name[0]: name_field\value\as\atom[0]
                declarator\expression_dimensions: name_field\next
            ---
            declarator\type_head[0]: inner\head[0]
            declarator\type_is_head: 1
            handled: 1
        ---
        if: handled = 0 && lm_trans_text_all_char(inner\head, '@')
            type_field: lm_trans_nth_field(inner\body, 0U)
            if: require_name
                name_field: lm_trans_nth_field(inner\body, 1U)
                if: type_field = 0 || type_field\value = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
                    return: lm_trans_array_declarator_error(pointer_error)
                declarator\name[0]: name_field\value\as\atom[0]
                declarator\expression_dimensions: name_field\next
            else:
                if: type_field = 0 || type_field\value = 0
                    return: lm_trans_array_declarator_error(pointer_error)
            ---
            declarator\pointer_depth: inner\head\length
            declarator\type_node: type_field\value
            handled: 1
        ---
        if: handled = 0
            return: lm_trans_array_declarator_error(nested_error)
        return: 0
    ---

    pointer_depth: 0U
    while: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_all_char(field\value\as\atom, '@')
        pointer_depth: pointer_depth + field\value\as\atom\length
        field: field\next

    type_field: field
    if: require_name
        if: type_field != 0
            name_field: type_field\next
        else:
            name_field: 0
        if: type_field = 0 || type_field\value = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            return: lm_trans_array_declarator_error(direct_error)
        declarator\name[0]: name_field\value\as\atom[0]
        declarator\expression_dimensions: name_field\next
    else:
        if: type_field = 0 || type_field\value = 0
            return: lm_trans_array_declarator_error(direct_error)
    ---

    declarator\pointer_depth: pointer_depth
    declarator\type_node: type_field\value
return: 0

fn: lm_trans_size_literal_cstr_new (size_t: value) @: char
    [32]: char buffer
    int: written
    @: char result

    written: c.snprintf(buffer, c.sizeof(buffer), "%zuU", value)
    if: written < 0 || (cast: size_t written) >= c.sizeof(buffer)
        return: 0
    result: (cast: (@: char) lm_own_new_zero((cast: size_t written) + 1U))
    if: result = 0
        return: 0
    c.memcpy(result, buffer, (cast: size_t written) + 1U)
return: result

fn: lm_trans_array_declarator_first_length_cstr_new (
    const: LmTransCDeclarator: declarator
) @: char
    LmP0Text: head_dimension
    size_t: head_index
    const: LmP0Field: expression_dimension

    if: declarator = 0
        return: 0

    head_dimension: lm_trans_statement_text_new()
    if: head_dimension = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ head_dimension)

    head_index: 0U
    if: declarator\array_head != 0 && lm_trans_array_head_next_dimension(declarator\array_head, @ head_index, head_dimension)
        if: head_dimension\length != 0U
            return: lm_trans_text_copy_cstr(head_dimension)
        expression_dimension: declarator\expression_dimensions
        if: expression_dimension != 0 && expression_dimension\value != 0 && expression_dimension\value\kind = c.LM_P0_NODE_ATOM && (declarator\atom_dimensions_only = 0 || lm_trans_array_body_dimension_can_consume(expression_dimension))
            return: lm_trans_text_copy_cstr(expression_dimension\value\as\atom)
        if: declarator\literal_dimension_count != 0U
            return: lm_trans_size_literal_cstr_new(declarator\literal_dimensions[0])
        return: lm_trans_text_copy_cstr_from_cstr("0U")
    ---

    if: declarator\literal_dimension_count != 0U
        return: lm_trans_size_literal_cstr_new(declarator\literal_dimensions[0])
return: lm_trans_text_copy_cstr_from_cstr("0U")

fn: lm_trans_emit_array_slice_sidecar (
    FILE: file
    const: LmTransCDeclarator: declarator
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char dimension_error_name)
) int
    @: char slice_length_storage
    int: status

    c.LM_UNUSED(file)
    c.LM_UNUSED(indent)
    c.LM_UNUSED(dimension_error_name)
    if: declarator = 0 || declarator\name = 0
        return: 1

    slice_length_storage: lm_trans_array_declarator_first_length_cstr_new(declarator)
    if: slice_length_storage = 0
        return: 1
    finally: lm_own_delete(slice_length_storage, 0)

    status: lm_trans_namespace_declare_array_slice_length(namespace_, declarator\name, slice_length_storage)
return: status

fn: lm_trans_array_declarator_empty_rank (
    const: LmTransCDeclarator: declarator
    @: size_t out_rank
) int
    LmP0Text: dimension
    size_t: dimension_index
    size_t: rank

    if: out_rank != 0
        out_rank[0]: 0U
    if: declarator = 0 || declarator\array_head = 0
        return: 0

    dimension: lm_trans_statement_text_new()
    if: dimension = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ dimension)

    dimension_index: 0U
    rank: 0U
    while: lm_trans_array_head_next_dimension(declarator\array_head, @ dimension_index, dimension)
        if: dimension\length != 0U
            return: 0
        rank: rank + 1U
    if: rank = 0U
        return: 0
    if: out_rank != 0
        out_rank[0]: rank
return: 1

fn: lm_trans_array_declarator_single_structure_value (
    const: LmTransCDeclarator: declarator
) const: LmP0Structure
    size_t: rank

    if: lm_trans_array_declarator_empty_rank(declarator, @ rank) = 0
        return: 0
return: lm_trans_fields_single_structure_value(declarator\expression_dimensions)

fn: lm_trans_emit_array_slice_value_declaration (
    FILE: file
    const: LmTransCDeclarator: declarator
    const: LmP0Structure: value
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    LmTransFormalParam: param
    LmP0Text: helper_name
    LmP0Text: slice_type
    int: status

    if: declarator = 0 || declarator\name = 0 || value = 0
        return: 1
    if: declarator\type_node = 0
        c.fprintf(c.stderr, "trans L2 error: [] slice value declaration expects an element type\n")
        return: 1

    param: lm_trans_formal_param_new()
    helper_name: lm_trans_statement_text_new()
    slice_type: lm_trans_text_ref_new_cstr("LmSlice")
    if: param = 0 || helper_name = 0 || slice_type = 0
        lm_trans_formal_param_delete(param)
        lm_trans_text_ref_destroy(@ helper_name)
        lm_trans_text_ref_destroy(@ slice_type)
        return: 1
    finally:
        lm_trans_formal_param_delete(param)
        lm_trans_text_ref_destroy(@ helper_name)
        lm_trans_text_ref_destroy(@ slice_type)

    param\is_array: 1
    param\has_name: 1
    param\name[0]: declarator\name[0]
    param\declarator\type_node: declarator\type_node
    param\declarator\expression_dimensions: 0
    param\declarator\type_head[0]: declarator\type_head[0]
    param\declarator\name[0]: declarator\name[0]
    param\declarator\array_head[0]: declarator\array_head[0]
    param\declarator\pointer_depth: declarator\pointer_depth
    param\declarator\literal_dimension_count: 0U
    param\declarator\type_is_head: declarator\type_is_head
    param\declarator\allow_empty_dimensions: 1
    param\declarator\atom_dimensions_only: 1

    if: lm_trans_emit_array_value_helper(file, param, value, namespace_, helper_name) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1
    if: lm_trans_put(file, "LmSlice *") != 0 || lm_trans_emit_identifier(file, declarator\name) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_identifier(file, helper_name) != 0 || lm_trans_put(file, "(lm_lmx_message_thread);\n") != 0
        return: 1

    status: lm_trans_namespace_declare_storage_binding(namespace_, declarator\name, slice_type)
return: status

fn: lm_trans_emit_array_declaration_with_qualifier (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    const: LmP0Field: initializer_field
    const: LmP0Structure: slice_value
    LmTransCDeclarator: declarator

    declarator: lm_trans_statement_c_declarator_new()
    if: declarator = 0
        return: 1
    finally: lm_trans_statement_c_declarator_destroy(declarator)

    if: lm_trans_array_declarator_read_from_frame(declarator, frame, namespace_, 1, 1, 1, "trans L2 error: [] declaration expects [@...] type name size...", "trans L2 error: array pointer declaration expects type and name", "trans L2 error: array declaration expects a type/name declaration") != 0
        return: 1

    slice_value: lm_trans_array_declarator_single_structure_value(declarator)
    if: slice_value != 0
        return: lm_trans_emit_array_slice_value_declaration(file, declarator, slice_value, indent, namespace_, qualifier)

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1

    if: lm_trans_emit_c_declarator(file, declarator, namespace_, "[] array dimension") != 0
        return: 1

    initializer_field: lm_trans_c_declarator_expression_dimension_tail(declarator)
    if: initializer_field != 0 && lm_trans_emit_array_initializer(file, initializer_field, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_array_slice_sidecar(file, declarator, indent, namespace_, "[] array dimension") != 0
        return: 1
    if: declarator\type_is_head
        return: lm_trans_namespace_declare_storage_binding(namespace_, declarator\name, declarator\type_head)
return: lm_trans_namespace_declare_node_storage_binding(namespace_, declarator\name, declarator\type_node)

fn: lm_trans_emit_array_declaration (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
return: lm_trans_emit_array_declaration_with_qualifier(file, frame, indent, namespace_, "")

fn: lm_trans_emit_pointer_declaration_repeat_with_qualifier (
    FILE: file
    const: LmP0Frame: template_frame
    const: LmP0Structure: body
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    const: LmP0Structure: template_body
    const: LmP0Structure: repeat_body
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Node: type_node
    const: LmP0Node: name_node

    template_body: 0
    if: template_frame != 0
        template_body: lm_trans_unwrap_single_anonymous_structure(template_frame\body)
    repeat_body: lm_trans_unwrap_single_anonymous_structure(body)
    type_field: 0
    if: template_body != 0
        type_field: template_body\first_field
    name_field: 0
    if: repeat_body != 0
        name_field: repeat_body\first_field
    if: template_frame = 0 || type_field = 0 || type_field\value = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: repeated @ declaration expects type template and name\n")
        return: 1

    type_node: type_field\value
    if: name_field\next != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_head_can_declare_storage(name_field\value\as\atom, namespace_)
        type_node: name_field\value
        name_field: name_field\next
        if: name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: repeated @ declaration override expects a variable name\n")
            return: 1
    ---

    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1
    if: lm_trans_emit_type_and_name(file, type_node, name_node\as\atom, template_frame\head\length, namespace_) != 0
        return: 1
    if: name_field\next != 0 && lm_trans_put(file, " = ") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_emit_expr_fields(file, name_field\next, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
return: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_node)

fn: lm_trans_emit_array_declaration_repeat_with_qualifier (
    FILE: file
    const: LmP0Frame: template_frame
    const: LmP0Structure: body
    unsigned: indent
    LmTransNamespace: namespace_
    const: @(char qualifier)
) int
    const: LmP0Structure: repeat_body
    const: LmP0Field: name_field
    const: LmP0Field: initializer_field
    const: LmP0Node: name_node
    LmTransCDeclarator: declarator

    repeat_body: lm_trans_unwrap_single_anonymous_structure(body)

    declarator: lm_trans_statement_c_declarator_new()
    if: declarator = 0
        return: 1
    finally: lm_trans_statement_c_declarator_destroy(declarator)

    if: lm_trans_array_declarator_read_from_frame(declarator, template_frame, namespace_, 1, 1, 0, "trans L2 error: repeated [] declaration expects a type template", "trans L2 error: repeated array pointer declaration expects a type template", "trans L2 error: repeated array declaration expects a type/name declaration template") != 0
        return: 1

    name_field: 0
    if: repeat_body != 0
        name_field: repeat_body\first_field
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: repeated [] declaration expects a variable name\n")
        return: 1

    if: name_field\next != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_head_can_declare_storage(name_field\value\as\atom, namespace_)
        declarator\type_head[0]: name_field\value\as\atom[0]
        declarator\type_node: 0
        declarator\type_is_head: 1
        declarator\pointer_depth: 0U
        name_field: name_field\next
        if: name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: repeated [] declaration override expects a variable name\n")
            return: 1
    ---

    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1

    declarator\name[0]: name_node\as\atom[0]
    declarator\expression_dimensions: name_field\next
    if: lm_trans_emit_c_declarator(file, declarator, namespace_, "repeated [] array dimension") != 0
        return: 1

    initializer_field: lm_trans_c_declarator_expression_dimension_tail(declarator)
    if: initializer_field != 0 && lm_trans_emit_array_initializer(file, initializer_field, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_array_slice_sidecar(file, declarator, indent, namespace_, "repeated [] array dimension") != 0
        return: 1
    if: declarator\type_is_head
        return: lm_trans_namespace_declare_storage_binding(namespace_, declarator\name, declarator\type_head)
return: lm_trans_namespace_declare_node_storage_binding(namespace_, declarator\name, declarator\type_node)

fn: lm_trans_emit_c_tagged_declaration (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Node: type_node
    const: LmP0Node: name_node

    type_field: lm_trans_nth_field(frame\body, 0U)
    name_field: lm_trans_nth_field(frame\body, 1U)
    if: type_field = 0 || name_field = 0 || type_field\value = 0 || name_field\value = 0 || type_field\value\kind != c.LM_P0_NODE_ATOM || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: C tagged declaration expects C tag name and variable name\n")
        return: 1

    type_node: type_field\value
    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_type_head_only(file, frame\head, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_emit_name(file, type_node\as\atom) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_emit_identifier(file, name_node\as\atom) != 0
        return: 1
    if: name_field\next != 0 && lm_trans_put(file, " = ") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_emit_expr_fields(file, name_field\next, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
return: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_node)

fn: lm_trans_emit_const_statement (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    const: LmP0Frame: inner

    field: frame\body\first_field
    if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
        c.fprintf(c.stderr, "trans L2 error: const receiver expects exactly one declaration frame\n")
        return: 1

    inner: field\value\as\frame
    if: lm_trans_text_is_array_receiver_head(inner\head)
        return: lm_trans_emit_array_declaration_with_qualifier(file, inner, indent, namespace_, "const ")
    if: lm_trans_frame_looks_storage_declaration(inner, namespace_)
        return: lm_trans_emit_declaration_with_qualifier(file, inner, indent, namespace_, "const ")
    if: lm_trans_text_all_char(inner\head, '@')
        return: lm_trans_emit_pointer_declaration_with_qualifier(file, inner, indent, namespace_, "const ")

    c.fprintf(c.stderr, "trans L2 error: const receiver expects storage, pointer, or array declaration\n")
return: 1

fn: lm_trans_emit_call_statement (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    LmTransCallLowering: call
    int: has_args

    call: lm_trans_statement_call_lowering_new()
    if: call = 0
        return: 1
    finally: lm_trans_expr_call_lowering_delete(call)

    if: lm_trans_lower_call(frame\head, namespace_, "callable", call) != 0
        return: 1
    if: lm_trans_validate_profile_c_printf_call(frame, namespace_) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1

    if: call\is_closure
        has_args: call\signature != 0 && call\signature\param_names != 0 && call\signature\param_names\count > 0U
        if: has_args = 0 && lm_trans_call_body_first_field(frame\body) != 0
            c.fprintf(c.stderr, "trans L2 error: too many arguments\n")
            return: 1
        if: lm_trans_emit_name(file, call\name) != 0
            return: 1
        if: lm_trans_put(file, "->call(") != 0
            return: 1
        if: lm_trans_emit_name(file, call\name) != 0
            return: 1
        if: lm_trans_put(file, "->env, lm_lmx_message_thread") != 0
            return: 1
        if: has_args && lm_trans_put(file, ", ") != 0
            return: 1
        if: has_args && lm_trans_emit_call_args(file, frame\body, namespace_, call\signature) != 0
            return: 1
        if: lm_trans_put(file, ")") != 0
            return: 1
        return: lm_trans_put(file, ";\n")

    if: lm_trans_emit_name(file, call\name) != 0
        return: 1
    if: lm_trans_put(file, "(") != 0
        return: 1
    if: lm_trans_emit_call_args(file, frame\body, namespace_, call\signature) != 0
        return: 1
    if: lm_trans_put(file, ")") != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_text_contains_char (const: (LmP0Text: text); char: ch) int
    size_t: i

    i: 0U
    while: text != 0 && i < text\length
        if: text\data[i] = ch
            return: 1
        i: i + 1U
return: 0

fn: lm_trans_head_looks_assignable_target (const: (LmP0Text: head)) int
return: lm_trans_text_contains_char(head, '[') || lm_trans_text_contains_char(head, '\\') || lm_trans_c_reference_has_path_dot(head)

fn: lm_trans_named_structure_body (const: (LmP0Frame: frame)) const: LmP0Structure
    if: frame = 0
        return: 0
return: lm_trans_unwrap_single_anonymous_structure(frame\body)

fn: lm_trans_frame_looks_named_structure_declaration (const: (LmP0Frame: frame)) int
return: frame != 0 && lm_trans_is_c_reference_name(frame\head) = 0 && lm_trans_is_reserved_head_name(frame\head) = 0 && lm_trans_text_all_char(frame\head, '@') = 0 && lm_trans_text_is_array_receiver_head(frame\head) = 0 && (frame\flags & c.LM_P0_FRAME_COLON) != 0U && (frame\flags & c.LM_P0_FRAME_INLINE_BODY) = 0U

fn: lm_trans_named_structure_type_set_cstr (
    LmTransL4CallableType: type
    const: @(char class_name)
    size_t: address_depth
    int: is_const
) int
    if: type = 0 || class_name = 0
        return: 0
    if: lm_trans_callable_type_reset(type) != 0
        return: 0
    if: lm_trans_text_assign_cstr(type\class_name, class_name) = 0
        return: 0
    type\address_depth: address_depth
    type\is_const: is_const
return: 1

fn: lm_trans_named_structure_type_set_text (
    LmTransL4CallableType: type
    const: LmP0Text: class_name
    size_t: address_depth
    int: is_const
) int
    if: type = 0 || class_name = 0
        return: 0
    if: lm_trans_callable_type_reset(type) != 0
        return: 0
    type\class_name[0]: class_name[0]
    type\address_depth: address_depth
    type\is_const: is_const
return: 1

fn: lm_trans_named_structure_atom_is_decimal_literal (const: (LmP0Text: atom)) int
    size_t: i
    char: ch

    if: atom = 0 || atom\length = 0U
        return: 0

    i: 0U
    while: i < atom\length
        ch: atom\data[i]
        if: ch < '0' || ch > '9'
            return: 0
        i: i + 1U
return: 1

fn: lm_trans_named_structure_atom_is_c_string_literal (const: (LmP0Text: atom)) int
    if: atom = 0 || atom\data = 0
        return: 0
    if: atom\length >= 2U && atom\data[0] = '"' && atom\data[atom\length - 1U] = '"'
        return: 1
return: lm_trans_text_starts_with(atom, "c.") && atom\length >= 4U && atom\data[2] = '"' && atom\data[atom\length - 1U] = '"'

fn: lm_trans_named_structure_field_type_from_atom (
    const: LmP0Text: atom
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
) int
    const: LmTransSymbol: relation

    if: atom = 0 || out_type = 0
        return: 0

    relation: lm_trans_namespace_relation_symbol_latest(namespace_, atom, "variable.type")
    if: relation != 0 && relation\has_c_name && relation\c_name != 0
        if: lm_trans_callable_type_reset(out_type) != 0
            return: 0
        out_type\class_name[0]: relation\c_name[0]
        out_type\address_depth: 0U
        out_type\is_const: 0
        return: 1

    if: lm_trans_named_structure_atom_is_decimal_literal(atom)
        return: lm_trans_named_structure_type_set_cstr(out_type, "int", 0U, 0)

    if: lm_trans_named_structure_atom_is_c_string_literal(atom)
        return: lm_trans_named_structure_type_set_cstr(out_type, "char", 1U, 1)

return: 0

fn: lm_trans_named_structure_single_initializer_node (
    const: LmP0Field: initializer
    const: @(LmP0Node out_node)
) int
    const: LmP0Node: current
    const: LmP0Field: field

    if: out_node != 0
        out_node[0]: 0
    if: initializer = 0 || initializer\next != 0 || initializer\value = 0 || out_node = 0
        return: 0

    current: initializer\value
    while: current != 0 && current\kind = c.LM_P0_NODE_STRUCTURE
        field: current\as\structure\first_field
        if: field = 0 || field\next != 0 || field\value = 0
            return: 0
        current: field\value

    out_node[0]: current
return: current != 0

fn: lm_trans_named_structure_field_type_from_initializer (
    const: LmP0Field: initializer
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
) int
    const: LmP0Node: node
    int: status

    if: initializer = 0 || out_type = 0
        return: 0
    if: lm_trans_named_structure_single_initializer_node(initializer, @ node) = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_named_structure_field_type_from_atom(node\as\atom, namespace_, out_type)
    status: lm_trans_node_result_type(node, namespace_, out_type)
    if: status > 0
        return: 1
return: 0

fn: lm_trans_named_structure_inferred_field_info (
    const: LmP0Frame: field_frame
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
    const: @(LmP0Text out_name)
    const: @(LmP0Field out_initializer)
) int
    const: LmP0Structure: body
    const: LmP0Field: initializer

    if: field_frame = 0 || out_type = 0 || out_name = 0 || out_initializer = 0
        return: 0
    if: (field_frame\flags & c.LM_P0_FRAME_COLON) = 0U
        return: 0
    if: lm_trans_atom_can_be_new_binding_name(field_frame\head) = 0 || lm_trans_is_reserved_head_name(field_frame\head)
        return: 0

    body: lm_trans_named_structure_body(field_frame)
    if: body = 0
        return: 0
    initializer: body\first_field
    if: initializer = 0
        return: 0
    if: lm_trans_named_structure_field_type_from_initializer(initializer, namespace_, out_type) = 0
        return: 0

    out_name[0]: field_frame\head
    out_initializer[0]: initializer
return: 1

fn: lm_trans_named_structure_type_is_available (
    const: LmP0Text: type_name
    const: LmTransNamespace: namespace_
    const: LmP0Text: pending_owner
) int
    if: type_name = 0
        return: 0
    if: pending_owner != 0 && lm_trans_text_same(type_name, pending_owner)
        return: 1
return: lm_trans_head_can_declare_storage(type_name, namespace_)

fn: lm_trans_named_structure_field_info_for_owner (
    const: LmP0Frame: field_frame
    const: LmTransNamespace: namespace_
    const: LmP0Text: pending_owner
    LmTransL4CallableType: out_type
    const: @(LmP0Text out_name)
    const: @(LmP0Field out_initializer)
) int
    const: LmP0Frame: current_frame
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Frame: inner
    size_t: pointer_depth

    if: field_frame = 0 || out_type = 0 || out_name = 0 || out_initializer = 0
        return: 0

    current_frame: field_frame
    pointer_depth: 0U

    while: lm_trans_text_all_char(current_frame\head, '@')
        body: lm_trans_named_structure_body(current_frame)
        if: body = 0
            return: 0

        field: body\first_field
        if: field != 0 && field\next = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            inner: field\value\as\frame
            pointer_depth: pointer_depth + current_frame\head\length
            current_frame: inner
            continue

        type_field: lm_trans_nth_field(body, 0U)
        name_field: lm_trans_nth_field(body, 1U)
        if: type_field = 0 || name_field = 0 || type_field\value = 0 || name_field\value = 0 || type_field\value\kind != c.LM_P0_NODE_ATOM || name_field\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        if: lm_trans_named_structure_type_set_text(out_type, type_field\value\as\atom, pointer_depth + current_frame\head\length, 0) = 0
            return: 0
        out_name[0]: name_field\value\as\atom
        out_initializer[0]: name_field\next
        return: lm_trans_named_structure_type_is_available(out_type\class_name, namespace_, pending_owner)
    ---

    body: lm_trans_named_structure_body(current_frame)
    if: body = 0
        return: 0
    if: lm_trans_named_structure_type_is_available(current_frame\head, namespace_, pending_owner) = 0
        return: lm_trans_named_structure_inferred_field_info(field_frame, namespace_, out_type, out_name, out_initializer)

    name_field: lm_trans_nth_field(body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: lm_trans_named_structure_type_set_text(out_type, current_frame\head, pointer_depth, 0) = 0
        return: 0
    out_name[0]: name_field\value\as\atom
    out_initializer[0]: name_field\next
    return: lm_trans_atom_can_be_new_binding_name(out_name[0])

return: lm_trans_named_structure_inferred_field_info(field_frame, namespace_, out_type, out_name, out_initializer)

fn: lm_trans_named_structure_field_info (
    const: LmP0Frame: field_frame
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
    const: @(LmP0Text out_name)
    const: @(LmP0Field out_initializer)
) int
return: lm_trans_named_structure_field_info_for_owner(field_frame, namespace_, 0, out_type, out_name, out_initializer)

fn: lm_trans_frame_looks_named_structure_layout_declaration (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    LmTransL4CallableType: field_type
    const: LmP0Text: name
    const: LmP0Field: initializer

    if: lm_trans_frame_looks_named_structure_declaration(frame) = 0
        return: 0

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 0
    finally: lm_trans_expr_callable_type_delete(field_type)

    body: lm_trans_named_structure_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && field\value\kind != c.LM_P0_NODE_FRAME
            return: 0
        if: lm_trans_node_is_ignored(field\value) = 0 && lm_trans_named_structure_field_info_for_owner(field\value\as\frame, namespace_, frame\head, field_type, @ name, @ initializer) = 0
            return: 0
        field: field\next
return: 1

fn: lm_trans_frame_looks_named_structure_construction (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    const: LmP0Field: name_field
    const: LmP0Field: value_body_field

    if: frame = 0 || namespace_ = 0 || (frame\flags & c.LM_P0_FRAME_COLON) = 0U || lm_trans_namespace_has_named_structure_binding(namespace_, frame\head) = 0
        return: 0

    body: lm_trans_named_structure_body(frame)
    name_field: lm_trans_nth_field(body, 0U)
    value_body_field: lm_trans_nth_field(body, 1U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM || lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom) = 0
        return: 0
    if: value_body_field = 0 || value_body_field\next != 0 || value_body_field\value = 0 || value_body_field\value\kind != c.LM_P0_NODE_STRUCTURE || value_body_field\value\span\line <= name_field\value\span\line
        return: 0
return: 1

fn: lm_trans_named_structure_construction_field_occurrence (
    const: LmP0Structure: body
    const: LmP0Field: selected
    const: LmP0Text: name
) size_t
    const: LmP0Field: field
    const: LmP0Frame: field_frame
    size_t: occurrence

    occurrence: 0U
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0 && field != selected
        if: lm_trans_node_is_ignored(field\value) = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            field_frame: field\value\as\frame
            if: lm_trans_identifier_same(field_frame\head, name)
                occurrence: occurrence + 1U
            ---
        ---
        field: field\next
return: occurrence

fn: lm_trans_emit_named_structure_construction_initializer (
    FILE: file
    const: LmP0Frame: frame
    const: LmP0Text: instance_name
    const: LmTransDescriptor: descriptor
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Structure: outer_body
    const: LmP0Field: value_body_field
    const: LmP0Structure: value_body
    const: LmP0Field: field
    const: LmP0Frame: field_frame
    const: LmP0Structure: initializer
    const: LmP0Field: initializer_first
    const: LmTransDescriptorField: descriptor_field
    LmTransL4CallableType: expected_type
    @: char logical_name
    @: char projected_name
    LmP0Text: projected_name_text
    size_t: occurrence
    size_t: matching_count

    if: file = 0 || frame = 0 || instance_name = 0 || descriptor = 0 || namespace_ = 0
        return: 1

    if: descriptor\has_structural_fields = 0
        c.fprintf(c.stderr, "trans L2 structure construction error: \"%.*s\" has no structural descriptor\n", (cast: int frame\head\length), frame\head\data)
        return: 1

    outer_body: lm_trans_named_structure_body(frame)
    value_body_field: lm_trans_nth_field(outer_body, 1U)
    if: value_body_field = 0 || value_body_field\value = 0 || value_body_field\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 1
    value_body: value_body_field\value\as\structure

    expected_type: lm_trans_expr_callable_type_new()
    if: expected_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(expected_type)

    field: value_body\first_field
    while: field != 0
        logical_name: 0
        projected_name: 0
        projected_name_text: 0

        if: lm_trans_node_is_ignored(field\value) = 0 && (field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME)
            c.fprintf(c.stderr, "trans L2 structure construction error: initializer body for \"%.*s\" expects field frames\n", (cast: int frame\head\length), frame\head\data)
            return: 1

        if: lm_trans_node_is_ignored(field\value) = 0
            field_frame: field\value\as\frame
            initializer: lm_trans_named_structure_body(field_frame)
            initializer_first: lm_trans_l2_structure_first_present_field(initializer)
            if: (field_frame\flags & c.LM_P0_FRAME_COLON) = 0U || lm_trans_atom_can_be_new_binding_name(field_frame\head) = 0 || initializer_first = 0
                c.fprintf(c.stderr, "trans L2 structure construction error: field \"%.*s\" expects an initializer expression\n", (cast: int field_frame\head\length), field_frame\head\data)
                return: 1

            logical_name: lm_trans_descriptor_name_copy(field_frame\head)
            if: logical_name = 0
                return: 1
            occurrence: lm_trans_named_structure_construction_field_occurrence(value_body, field, field_frame\head)
            descriptor_field: lm_trans_descriptor_structural_field_occurrence(descriptor, logical_name, occurrence)
            if: descriptor_field = 0
                matching_count: lm_trans_descriptor_structural_field_occurrence_count(descriptor, logical_name)
                c.fprintf(c.stderr, "trans L2 structure construction error: class \"%.*s\" has no field occurrence [%zu]%.*s (matching occurrence count: %zu)\n", (cast: int frame\head\length), frame\head\data, occurrence, (cast: int field_frame\head\length), field_frame\head\data, matching_count)
                lm_own_delete(logical_name, 0)
                return: 1
            ---

            projected_name: lm_trans_descriptor_projected_member_name_new(descriptor, descriptor_field)
            if: projected_name = 0
                lm_own_delete(logical_name, 0)
                return: 1
            projected_name_text: lm_trans_text_from_cstr(projected_name)
            if: projected_name_text = 0
                lm_own_delete(projected_name, 0)
                lm_own_delete(logical_name, 0)
                return: 1

            if: lm_trans_named_structure_type_set_cstr(expected_type, descriptor_field\descriptor_name, descriptor_field\address_depth, descriptor_field\is_const) = 0
                lm_trans_text_ref_destroy(@ projected_name_text)
                lm_own_delete(projected_name, 0)
                lm_own_delete(logical_name, 0)
                return: 1

            if: descriptor_field\has_array_count
                c.fprintf(c.stderr, "trans hosted C backend limitation: construction of fixed-array field [%zu]%.*s on \"%.*s\" requires ArrayReference projection\n", occurrence, (cast: int field_frame\head\length), field_frame\head\data, (cast: int frame\head\length), frame\head\data)
                lm_trans_text_ref_destroy(@ projected_name_text)
                lm_own_delete(projected_name, 0)
                lm_own_delete(logical_name, 0)
                return: 1

            if: descriptor_field\is_const
                if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "memcpy((void *)&") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, "->") != 0 || lm_trans_emit_identifier(file, projected_name_text) != 0 || lm_trans_put(file, ", &(") != 0 || lm_trans_emit_callable_type_named(file, expected_type, 0, namespace_) != 0 || lm_trans_put(file, "){") != 0 || lm_trans_emit_expr_range_with_expected_type(file, initializer_first, 0, namespace_, expected_type) != 0 || lm_trans_put(file, "}, sizeof(") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, "->") != 0 || lm_trans_emit_identifier(file, projected_name_text) != 0 || lm_trans_put(file, "));\n") != 0
                    lm_trans_text_ref_destroy(@ projected_name_text)
                    lm_own_delete(projected_name, 0)
                    lm_own_delete(logical_name, 0)
                    return: 1
                ---
            else:
                if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, "->") != 0 || lm_trans_emit_identifier(file, projected_name_text) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_expr_range_with_expected_type(file, initializer_first, 0, namespace_, expected_type) != 0 || lm_trans_put(file, ";\n") != 0
                    lm_trans_text_ref_destroy(@ projected_name_text)
                    lm_own_delete(projected_name, 0)
                    lm_own_delete(logical_name, 0)
                    return: 1
                ---
            ---

            lm_trans_text_ref_destroy(@ projected_name_text)
            lm_own_delete(projected_name, 0)
            lm_own_delete(logical_name, 0)
        ---
        field: field\next

return: 0

fn: lm_trans_emit_named_structure_construction (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    const: LmP0Field: name_field
    const: LmP0Text: instance_name
    const: LmTransSymbol: existing_symbol
    const: LmTransDescriptor: descriptor
    int: status

    if: file = 0 || frame = 0 || namespace_ = 0 || lm_trans_frame_looks_named_structure_construction(frame, namespace_) = 0
        return: 1

    body: lm_trans_named_structure_body(frame)
    name_field: lm_trans_nth_field(body, 0U)
    instance_name: name_field\value\as\atom

    existing_symbol: lm_trans_namespace_find(namespace_, instance_name)
    if: existing_symbol != 0
        c.fprintf(c.stderr, "trans hosted C backend limitation: Structure construction result \"%.*s\" collides with an existing binding and requires occurrence-aware value projection\n", (cast: int instance_name\length), instance_name\data)
        return: 1

    descriptor: lm_trans_namespace_descriptor(namespace_, frame\head)
    if: descriptor = 0 || descriptor\has_structural_fields = 0
        return: 1

    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, " = (") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, "));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_emit_identifier(file, instance_name) != 0 || lm_trans_put(file, " == 0) {\n") != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "abort();\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1

    status: lm_trans_emit_named_structure_construction_initializer(file, frame, instance_name, descriptor, indent, namespace_)
    if: status != 0
        return: 1
return: lm_trans_namespace_declare_storage_binding(namespace_, instance_name, frame\head)

fn: lm_trans_named_structure_relation_table_new (
    const: LmP0Text: owner
    const: @(char suffix)
) @: char
    @: char owner_name
    @: char table_name
    size_t: owner_length
    size_t: suffix_length

    owner_name: lm_trans_prefixed_identifier_name_new("", owner, "")
    if: owner_name = 0 || suffix = 0
        lm_own_delete(owner_name, 0)
        return: 0
    finally: lm_own_delete(owner_name, 0)

    owner_length: c.strlen(owner_name)
    suffix_length: c.strlen(suffix)
    table_name: (cast: (@: char) lm_own_new_zero(owner_length + suffix_length + 1U))
    if: table_name = 0
        return: 0
    c.memcpy(table_name, owner_name, owner_length)
    c.memcpy(table_name + owner_length, suffix, suffix_length + 1U)
return: table_name

fn: lm_trans_named_structure_push_relation (
    const: LmP0Text: owner
    const: @(char suffix)
    const: LmP0Text: key
    const: LmP0Text: payload
) int
    @: char table_name
    LmP0Text: table_atom
    const: @: char value_column_name
    const: @: char value_descriptor

    if: suffix = 0
        return: 1
    value_column_name: 0
    value_descriptor: 0
    if: c.strcmp(suffix, ".field.class") = 0
        value_column_name: "field"
        value_descriptor: "class"
    if: c.strcmp(suffix, ".field.union") = 0
        value_column_name: "union"
        value_descriptor: "class"
    if: c.strcmp(suffix, ".field.index") = 0
        value_column_name: "index"
        value_descriptor: "size_t"
    if: c.strcmp(suffix, ".field.address-depth") = 0
        value_column_name: "depth"
        value_descriptor: "size_t"
    if: c.strcmp(suffix, ".field.const") = 0
        value_column_name: "value"
        value_descriptor: "int"
    if: c.strcmp(suffix, ".field.array-count") = 0
        value_column_name: "count"
        value_descriptor: "size_t"
    if: value_column_name = 0 || value_descriptor = 0
        return: 1

    table_name: lm_trans_named_structure_relation_table_new(owner, suffix)
    if: table_name = 0
        return: 1
    finally: lm_own_delete(table_name, 0)

    table_atom: lm_trans_text_from_cstr(table_name)
    if: table_atom = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ table_atom)

return: lm_trans_registry_push_generated_source_n2_row_atoms(table_atom, key, payload, "class", "class", value_column_name, value_descriptor) != 0

fn: lm_trans_bind_named_structure_descriptor (
    LmTransNamespace: namespace_
    const: LmP0Text: owner
    @: LmTransDescriptor descriptor
) int
    LmTransDescriptor: transferred_descriptor

    if: namespace_ = 0 || owner = 0 || descriptor = 0 || descriptor[0] = 0
        return: 1

    transferred_descriptor: descriptor[0]
    if: lm_trans_namespace_bind_descriptor(namespace_, owner, "structureConstructor", transferred_descriptor) != 0
        return: 1
    descriptor[0]: 0
return: 0

fn: lm_trans_named_structure_push_field_relations (
    const: LmP0Text: owner
    const: LmP0Text: name
    const: LmTransL4CallableType: type
    size_t: index
) int
    LmP0Text: index_payload
    LmP0Text: depth_payload
    LmP0Text: const_payload
    [32]: char index_buffer
    [32]: char depth_buffer
    int: status

    if: owner = 0 || name = 0 || type = 0 || type\class_name = 0
        return: 1

    c.snprintf(index_buffer, c.sizeof(index_buffer), "%zu", index)
    c.snprintf(depth_buffer, c.sizeof(depth_buffer), "%zu", type\address_depth)
    index_payload: lm_trans_text_from_cstr(index_buffer)
    if: index_payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ index_payload)

    depth_payload: lm_trans_text_from_cstr(depth_buffer)
    if: depth_payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ depth_payload)

    status: lm_trans_named_structure_push_relation(owner, ".field.class", name, type\class_name) != 0 || lm_trans_named_structure_push_relation(owner, ".field.index", name, index_payload) != 0 || lm_trans_named_structure_push_relation(owner, ".field.address-depth", name, depth_payload) != 0
    if: status = 0 && type\is_const
        const_payload: lm_trans_text_from_cstr("1")
        if: const_payload = 0
            return: 1
        status: lm_trans_named_structure_push_relation(owner, ".field.const", name, const_payload) != 0
        lm_trans_text_ref_destroy(@ const_payload)
return: status != 0

fn: lm_trans_hosted_descriptor_redeclaration_is_unsupported (
    const: LmTransNamespace: namespace_
    const: LmP0Text: owner
    const: LmTransDescriptor: pending_descriptor
) int
    const: LmTransSymbol: old_symbol
    int: compatible

    old_symbol: lm_trans_namespace_find(namespace_, owner)
    if: old_symbol = 0
        return: 0
    if: old_symbol\descriptor = 0
        c.fprintf(c.stderr, "trans L2 redeclaration error: old binding \"%.*s\" has no structural descriptor\n", (cast: int owner\length), owner\data)
        return: 1
    if: lm_trans_descriptor_implements(old_symbol\descriptor, pending_descriptor, @ compatible) != 0
        c.fprintf(c.stderr, "trans L2 redeclaration error: malformed descriptor for \"%.*s\"\n", (cast: int owner\length), owner\data)
        return: 1
    if: compatible = 0
        c.fprintf(c.stderr, "trans L2 redeclaration error: implements(old, new) is false for \"%.*s\"\n", (cast: int owner\length), owner\data)
        return: 1

    if: lm_trans_descriptor_structural_same(old_symbol\descriptor, pending_descriptor)
        return: 0

    c.fprintf(c.stderr, "trans hosted C backend limitation: compatible non-identical occurrences of \"%.*s\" require occurrence-aware type projection\n", (cast: int owner\length), owner\data)
return: 1

fn: lm_trans_declare_named_structure_layout_mode (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
    int: reject_hosted_redeclaration
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    LmTransL4CallableType: field_type
    const: LmP0Text: name
    const: LmP0Field: initializer
    LmTransDescriptor: descriptor
    size_t: index

    if: namespace_ = 0 || frame = 0 || lm_trans_frame_looks_named_structure_layout_declaration(frame, namespace_) = 0
        return: 1

    descriptor: lm_trans_descriptor_new()
    finally: lm_trans_descriptor_delete(descriptor)
    if: descriptor = 0 || lm_trans_descriptor_mark_structural_fields(descriptor) != 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    body: lm_trans_named_structure_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    index: 0U
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && (field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_named_structure_field_info_for_owner(field\value\as\frame, namespace_, frame\head, field_type, @ name, @ initializer) = 0)
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0 && initializer != 0
            c.fprintf(c.stderr, "trans L2 structure descriptor error: field \"%.*s\" cannot contain an instance initializer; construct a value explicitly\n", (cast: int name\length), name\data)
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0 && lm_trans_descriptor_add_structural_field(descriptor, name, field_type\class_name, index, field_type\address_depth, 0U, 0, field_type\is_const, 0) != 0
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0
            index: index + 1U
        field: field\next

    if: reject_hosted_redeclaration && lm_trans_hosted_descriptor_redeclaration_is_unsupported(namespace_, frame\head, descriptor) != 0
        return: 1
    if: lm_trans_bind_named_structure_descriptor(namespace_, frame\head, @ descriptor) != 0
        return: 1
return: 0

fn: lm_trans_declare_named_structure_layout (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
return: lm_trans_declare_named_structure_layout_mode(namespace_, frame, 0)

fn: lm_trans_declare_hosted_named_structure_layout (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
return: lm_trans_declare_named_structure_layout_mode(namespace_, frame, 1)

fn: lm_trans_emit_named_structure_field_declaration (
    FILE: file
    const: LmP0Frame: field_frame
    const: LmTransDescriptor: descriptor
    size_t: descriptor_index
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    LmTransL4CallableType: field_type
    const: LmP0Text: name
    const: LmP0Field: initializer
    const: LmTransDescriptorField: descriptor_field
    @: char projected_name
    LmP0Text: projected_name_text

    projected_name: 0
    projected_name_text: 0
    finally: lm_own_delete(projected_name, 0)
    finally: lm_trans_text_ref_destroy(@ projected_name_text)

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    if: lm_trans_named_structure_field_info(field_frame, namespace_, field_type, @ name, @ initializer) = 0
        return: 1
    if: initializer != 0
        c.fprintf(c.stderr, "trans L2 structure descriptor error: field \"%.*s\" cannot contain an instance initializer; construct a value explicitly\n", (cast: int name\length), name\data)
        return: 1

    descriptor_field: lm_trans_descriptor_structural_field_by_index(descriptor, descriptor_index)
    if: descriptor_field = 0
        return: 1
    projected_name: lm_trans_descriptor_projected_member_name_new(descriptor, descriptor_field)
    if: projected_name = 0
        return: 1
    projected_name_text: lm_trans_text_from_cstr(projected_name)
    if: projected_name_text = 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_callable_type_named(file, field_type, projected_name_text, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_named_structure_typedef (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmTransDescriptor: descriptor
    size_t: descriptor_index

    if: file = 0 || frame = 0 || lm_trans_frame_looks_named_structure_layout_declaration(frame, namespace_) = 0
        return: 1

    descriptor: lm_trans_namespace_descriptor(namespace_, frame\head)
    if: descriptor = 0 || descriptor\has_structural_fields = 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_put(file, "struct ") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "typedef struct ") != 0
        return: 1
    if: lm_trans_emit_identifier(file, frame\head) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct ") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " {\n") != 0
        return: 1

    body: lm_trans_named_structure_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    descriptor_index: 0U
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && (field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_emit_named_structure_field_declaration(file, field\value\as\frame, descriptor, descriptor_index, indent + 1U, namespace_) != 0)
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0
            descriptor_index: descriptor_index + 1U
        field: field\next

    if: descriptor_index = 0U
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "unsigned char lm_lmx_empty_structure;\n") != 0
            return: 1
        ---
    ---

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
return: lm_trans_put(file, "};\n")

fn: lm_trans_l2_c_identifier_char (char: ch) int
return: (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch = '_'

fn: lm_trans_l2_c_identifier_new (
    const: @(char prefix)
    const: LmP0Text: text
    const: @(char suffix)
) @: char
    LmP0Text: payload
    @: char result
    size_t: prefix_length
    size_t: suffix_length
    size_t: payload_length
    size_t: length
    size_t: i
    size_t: out
    char: ch

    if: prefix = 0 || text = 0
        return: 0

    payload: lm_trans_text_ref_new_cstr("")
    if: payload = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ payload)

    if: lm_trans_registry_literal_value(text, payload) = 0
        return: 0

    prefix_length: c.strlen(prefix)
    suffix_length: 0U
    if: suffix != 0
        suffix_length: c.strlen(suffix)
    payload_length: 1U
    if: payload\length != 0U
        payload_length: payload\length
    length: prefix_length + payload_length + suffix_length
    result: (cast: (@: char) lm_own_new_zero(length + 1U))
    if: result = 0
        return: 0

    c.memcpy(result, prefix, prefix_length)
    out: prefix_length
    if: payload\length = 0U
        result[out]: 'x'
        out: out + 1U
    if: payload\length != 0U
        i: 0U
        while: i < payload\length
            ch: payload\data[i]
            if: lm_trans_l2_c_identifier_char(ch)
                result[out]: ch
            if: lm_trans_l2_c_identifier_char(ch) = 0
                result[out]: '_'
            out: out + 1U
            i: i + 1U
    ---
    if: suffix_length != 0U
        c.memcpy(result + out, suffix, suffix_length)
        out: out + suffix_length
    result[out]: '\0'
return: result

fn: lm_trans_l2_structure_first_present_field (const: (LmP0Structure: structure)) const: LmP0Field
    const: LmP0Field: field

    field: 0
    if: structure != 0
        field: structure\first_field
    while: field != 0 && lm_trans_node_is_ignored(field\value)
        field: field\next
return: field

fn: lm_trans_l2_structure_next_present_field (const: (LmP0Field: field)) const: LmP0Field
    if: field != 0
        field: field\next
    while: field != 0 && lm_trans_node_is_ignored(field\value)
        field: field\next
return: field

fn: lm_trans_anonymous_structure_parts (
    const: LmP0Frame: frame
    const: @(LmP0Text out_name)
    const: @(LmP0Structure out_value_body)
) int
    const: LmP0Structure: body
    const: LmP0Field: name_field
    const: LmP0Field: value_body_field
    const: LmP0Field: extra_field

    if: out_name != 0
        out_name[0]: 0
    if: out_value_body != 0
        out_value_body[0]: 0
    if: frame = 0 || out_name = 0 || out_value_body = 0 || lm_trans_text_equals(frame\head, "()") = 0
        return: 0
    if: (frame\flags & c.LM_P0_FRAME_COLON) = 0U
        c.fprintf(c.stderr, "trans L2 anonymous Structure error: () expects the canonical (): result form\n")
        return: 0

    body: lm_trans_named_structure_body(frame)
    name_field: lm_trans_l2_structure_first_present_field(body)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM || lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom) = 0
        c.fprintf(c.stderr, "trans L2 anonymous Structure error: (): expects one result binding name\n")
        return: 0

    value_body_field: lm_trans_l2_structure_next_present_field(name_field)
    if: value_body_field = 0
        out_name[0]: name_field\value\as\atom
        return: 1
    if: value_body_field\value = 0 || value_body_field\value\kind != c.LM_P0_NODE_STRUCTURE || value_body_field\value\span = 0 || name_field\value\span = 0 || value_body_field\value\span\line <= name_field\value\span\line
        c.fprintf(c.stderr, "trans L2 anonymous Structure error: fields of \"%.*s\" must use the following vertical Structure body\n", (cast: int name_field\value\as\atom\length), name_field\value\as\atom\data)
        return: 0

    extra_field: lm_trans_l2_structure_next_present_field(value_body_field)
    if: extra_field != 0
        c.fprintf(c.stderr, "trans L2 anonymous Structure error: \"%.*s\" has fields outside its single value body\n", (cast: int name_field\value\as\atom\length), name_field\value\as\atom\data)
        return: 0

    out_name[0]: name_field\value\as\atom
    out_value_body[0]: value_body_field\value\as\structure
return: 1

fn: lm_trans_anonymous_structure_c_type_name_new (const: (LmP0Text: result_name)) @: char
    [32]: char suffix
    unsigned: id
    int: written

    if: result_name = 0
        return: 0
    id: lm_trans_next_anonymous_structure_id
    lm_trans_next_anonymous_structure_id: lm_trans_next_anonymous_structure_id + 1U
    written: c.snprintf(suffix, c.sizeof(suffix), "_%u", id)
    if: written <= 0 || (cast: size_t written) >= c.sizeof(suffix)
        return: 0
return: lm_trans_l2_c_identifier_new("lm_lmx_anonymous_structure_", result_name, suffix)

fn: lm_trans_anonymous_structure_initializer_array_reference_atom (
    const: LmP0Field: initializer
    const: LmTransNamespace: namespace_
    const: @(LmP0Text out_atom)
) int
    const: LmP0Node: node
    const: LmTransSymbol: type_relation

    if: out_atom != 0
        out_atom[0]: 0
    if: initializer = 0 || namespace_ = 0 || out_atom = 0 || lm_trans_named_structure_single_initializer_node(initializer, @ node) = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0

    if: lm_trans_namespace_relation_symbol_latest(namespace_, node\as\atom, "variable.slice-name") != 0 || lm_trans_namespace_relation_symbol_latest(namespace_, node\as\atom, "variable.slice-length") != 0
        out_atom[0]: node\as\atom
        return: 1

    type_relation: lm_trans_namespace_relation_symbol_latest(namespace_, node\as\atom, "variable.type")
    if: type_relation != 0 && type_relation\has_c_name && type_relation\c_name != 0 && lm_trans_text_equals(type_relation\c_name, "LmSlice")
        out_atom[0]: node\as\atom
        return: 1
    ---
return: 0

fn: lm_trans_anonymous_structure_descriptor_new (
    const: LmP0Structure: value_body
    const: LmP0Text: result_name
    const: @(char c_type_name)
    const: LmTransNamespace: namespace_
) LmTransDescriptor
    const: LmP0Field: field
    const: LmP0Frame: field_frame
    LmTransL4CallableType: field_type
    const: LmP0Text: field_name
    const: LmP0Text: array_initializer_atom
    const: LmP0Field: initializer
    LmTransDescriptor: descriptor
    size_t: descriptor_index

    if: result_name = 0 || c_type_name = 0 || namespace_ = 0
        return: 0

    descriptor: lm_trans_descriptor_new()
    if: descriptor = 0
        return: 0
    if: lm_trans_descriptor_mark_structural_fields(descriptor) != 0
        lm_trans_descriptor_delete(descriptor)
        return: 0

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        lm_trans_descriptor_delete(descriptor)
        return: 0

    descriptor_index: 0U
    field: lm_trans_l2_structure_first_present_field(value_body)
    while: field != 0
        if: field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
            c.fprintf(c.stderr, "trans L2 anonymous Structure error: value body for \"%.*s\" expects field declarations\n", (cast: int result_name\length), result_name\data)
            lm_trans_expr_callable_type_delete(field_type)
            lm_trans_descriptor_delete(descriptor)
            return: 0
        field_frame: field\value\as\frame
        if: lm_trans_named_structure_field_info_for_owner(field_frame, namespace_, 0, field_type, @ field_name, @ initializer) = 0
            c.fprintf(c.stderr, "trans L2 anonymous Structure error: field form \"%.*s\" needs an explicit type and name, or an initializer with a statically known type\n", (cast: int field_frame\head\length), field_frame\head\data)
            lm_trans_expr_callable_type_delete(field_type)
            lm_trans_descriptor_delete(descriptor)
            return: 0
        if: lm_trans_anonymous_structure_initializer_array_reference_atom(initializer, namespace_, @ array_initializer_atom)
            c.fprintf(c.stderr, "trans hosted C backend limitation: anonymous Structure field \"%.*s\" initialized by ArrayReference \"%.*s\" requires ArrayReference projection\n", (cast: int field_name\length), field_name\data, (cast: int array_initializer_atom\length), array_initializer_atom\data)
            lm_trans_expr_callable_type_delete(field_type)
            lm_trans_descriptor_delete(descriptor)
            return: 0
        if: field_type\array_rank != 0U
            c.fprintf(c.stderr, "trans hosted C backend limitation: anonymous Structure field \"%.*s\" requires ArrayReference projection\n", (cast: int field_name\length), field_name\data)
            lm_trans_expr_callable_type_delete(field_type)
            lm_trans_descriptor_delete(descriptor)
            return: 0
        if: lm_trans_descriptor_add_structural_field(descriptor, field_name, field_type\class_name, descriptor_index, field_type\address_depth, 0U, 0, field_type\is_const, 0) != 0
            lm_trans_expr_callable_type_delete(field_type)
            lm_trans_descriptor_delete(descriptor)
            return: 0
        descriptor_index: descriptor_index + 1U
        field: lm_trans_l2_structure_next_present_field(field)
    ---

    lm_trans_expr_callable_type_delete(field_type)
    if: lm_trans_descriptor_set_class_relation(descriptor, "lm.trans.c.type", c_type_name) != 0 || lm_trans_descriptor_set_class_relation(descriptor, "lm.trans.c.indexed-members", "1") != 0
        lm_trans_descriptor_delete(descriptor)
        return: 0
return: descriptor

fn: lm_trans_anonymous_structure_collision_is_unsupported (
    const: LmTransNamespace: namespace_
    const: LmP0Text: result_name
    const: LmTransDescriptor: pending_descriptor
) int
    const: LmTransSymbol: old_symbol
    int: compatible

    old_symbol: lm_trans_namespace_find(namespace_, result_name)
    if: old_symbol = 0
        return: 0
    if: old_symbol\descriptor = 0
        c.fprintf(c.stderr, "trans L2 redeclaration error: old binding \"%.*s\" has no structural descriptor\n", (cast: int result_name\length), result_name\data)
        return: 1
    if: lm_trans_descriptor_implements(old_symbol\descriptor, pending_descriptor, @ compatible) != 0
        c.fprintf(c.stderr, "trans L2 redeclaration error: malformed descriptor for \"%.*s\"\n", (cast: int result_name\length), result_name\data)
        return: 1
    if: compatible = 0
        c.fprintf(c.stderr, "trans L2 redeclaration error: implements(old, new) is false for \"%.*s\"\n", (cast: int result_name\length), result_name\data)
        return: 1

    c.fprintf(c.stderr, "trans hosted C backend limitation: compatible anonymous Structure result \"%.*s\" requires occurrence-aware value projection\n", (cast: int result_name\length), result_name\data)
return: 1

fn: lm_trans_emit_anonymous_structure_typedef (
    FILE: file
    const: @(char c_type_name)
    const: LmTransDescriptor: descriptor
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    LmP0Text: c_type_text
    LmTransL4CallableType: field_type
    const: LmTransDescriptorField: descriptor_field
    @: char projected_name
    LmP0Text: projected_name_text
    size_t: descriptor_index

    if: file = 0 || c_type_name = 0 || descriptor = 0 || descriptor\has_structural_fields = 0 || namespace_ = 0
        return: 1

    c_type_text: lm_trans_text_from_cstr(c_type_name)
    if: c_type_text = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ c_type_text)

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct ") != 0 || lm_trans_emit_identifier(file, c_type_text) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "typedef struct ") != 0 || lm_trans_emit_identifier(file, c_type_text) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_emit_identifier(file, c_type_text) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct ") != 0 || lm_trans_emit_identifier(file, c_type_text) != 0 || lm_trans_put(file, " {\n") != 0
        return: 1

    descriptor_index: 0U
    while: descriptor\structural_fields != 0 && descriptor_index < descriptor\structural_fields\count
        descriptor_field: lm_trans_descriptor_structural_field_by_index(descriptor, descriptor_index)
        if: descriptor_field = 0 || descriptor_field\descriptor_name = 0 || descriptor_field\has_array_count || descriptor_field\is_union
            return: 1
        if: lm_trans_named_structure_type_set_cstr(field_type, descriptor_field\descriptor_name, descriptor_field\address_depth, descriptor_field\is_const) = 0
            return: 1

        projected_name: lm_trans_descriptor_projected_member_name_new(descriptor, descriptor_field)
        if: projected_name = 0
            return: 1
        projected_name_text: lm_trans_text_from_cstr(projected_name)
        if: projected_name_text = 0
            lm_own_delete(projected_name, 0)
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_emit_callable_type_named(file, field_type, projected_name_text, namespace_) != 0 || lm_trans_put(file, ";\n") != 0
            lm_trans_text_ref_destroy(@ projected_name_text)
            lm_own_delete(projected_name, 0)
            return: 1
        lm_trans_text_ref_destroy(@ projected_name_text)
        lm_own_delete(projected_name, 0)
        descriptor_index: descriptor_index + 1U
    ---

    if: descriptor_index = 0U
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "unsigned char lm_lmx_empty_structure;\n") != 0
            return: 1
        ---
    ---
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
return: lm_trans_put(file, "};\n")

fn: lm_trans_emit_anonymous_structure_initializers (
    FILE: file
    const: LmP0Structure: value_body
    const: LmP0Text: result_name
    const: LmP0Text: value_c_name
    const: LmTransDescriptor: descriptor
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    const: LmP0Frame: field_frame
    LmTransL4CallableType: parsed_type
    LmTransL4CallableType: expected_type
    const: LmP0Text: field_name
    const: LmP0Field: initializer
    const: LmTransDescriptorField: descriptor_field
    @: char projected_name
    LmP0Text: projected_name_text
    size_t: descriptor_index

    if: file = 0 || result_name = 0 || value_c_name = 0 || descriptor = 0 || descriptor\has_structural_fields = 0 || namespace_ = 0
        return: 1

    parsed_type: lm_trans_expr_callable_type_new()
    expected_type: lm_trans_expr_callable_type_new()
    if: parsed_type = 0 || expected_type = 0
        lm_trans_expr_callable_type_delete(parsed_type)
        lm_trans_expr_callable_type_delete(expected_type)
        return: 1
    finally: lm_trans_expr_callable_type_delete(parsed_type)
    finally: lm_trans_expr_callable_type_delete(expected_type)

    descriptor_index: 0U
    field: lm_trans_l2_structure_first_present_field(value_body)
    while: field != 0
        if: field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
            return: 1
        field_frame: field\value\as\frame
        if: lm_trans_named_structure_field_info_for_owner(field_frame, namespace_, 0, parsed_type, @ field_name, @ initializer) = 0
            return: 1
        descriptor_field: lm_trans_descriptor_structural_field_by_index(descriptor, descriptor_index)
        if: descriptor_field = 0 || descriptor_field\descriptor_name = 0
            return: 1

        if: initializer != 0
            if: lm_trans_named_structure_type_set_cstr(expected_type, descriptor_field\descriptor_name, descriptor_field\address_depth, descriptor_field\is_const) = 0
                return: 1
            projected_name: lm_trans_descriptor_projected_member_name_new(descriptor, descriptor_field)
            if: projected_name = 0
                return: 1
            projected_name_text: lm_trans_text_from_cstr(projected_name)
            if: projected_name_text = 0
                lm_own_delete(projected_name, 0)
                return: 1

            if: descriptor_field\is_const
                if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "memcpy((void *)&") != 0 || lm_trans_emit_identifier(file, value_c_name) != 0 || lm_trans_put(file, "->") != 0 || lm_trans_emit_identifier(file, projected_name_text) != 0 || lm_trans_put(file, ", &(") != 0 || lm_trans_emit_callable_type_named(file, expected_type, 0, namespace_) != 0 || lm_trans_put(file, "){") != 0 || lm_trans_emit_expr_range_with_expected_type(file, initializer, 0, namespace_, expected_type) != 0 || lm_trans_put(file, "}, sizeof(") != 0 || lm_trans_emit_identifier(file, value_c_name) != 0 || lm_trans_put(file, "->") != 0 || lm_trans_emit_identifier(file, projected_name_text) != 0 || lm_trans_put(file, "));\n") != 0
                    lm_trans_text_ref_destroy(@ projected_name_text)
                    lm_own_delete(projected_name, 0)
                    return: 1
                ---
            else:
                if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_identifier(file, value_c_name) != 0 || lm_trans_put(file, "->") != 0 || lm_trans_emit_identifier(file, projected_name_text) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_expr_range_with_expected_type(file, initializer, 0, namespace_, expected_type) != 0 || lm_trans_put(file, ";\n") != 0
                    lm_trans_text_ref_destroy(@ projected_name_text)
                    lm_own_delete(projected_name, 0)
                    return: 1
                ---
            ---

            lm_trans_text_ref_destroy(@ projected_name_text)
            lm_own_delete(projected_name, 0)
        ---

        descriptor_index: descriptor_index + 1U
        field: lm_trans_l2_structure_next_present_field(field)
    ---

    if: descriptor\structural_fields = 0 || descriptor_index != descriptor\structural_fields\count
        c.fprintf(c.stderr, "trans internal error: anonymous Structure descriptor and initializer fields differ for \"%.*s\"\n", (cast: int result_name\length), result_name\data)
        return: 1
return: 0

fn: lm_trans_emit_anonymous_structure_construction (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Text: result_name
    const: LmP0Structure: value_body
    @: char c_type_name
    @: char value_c_name
    LmP0Text: c_type_text
    LmP0Text: value_c_text
    LmTransDescriptor: descriptor
    LmTransDescriptor: published_descriptor
    int: status

    if: file = 0 || frame = 0 || namespace_ = 0
        return: 1
    if: lm_trans_l2_executable_statement_depth = 0
        c.fprintf(c.stderr, "trans hosted C backend limitation: top-level anonymous Structure value requires module/root-arena initialization\n")
        return: 1
    if: lm_trans_anonymous_structure_parts(frame, @ result_name, @ value_body) = 0
        return: 1

    c_type_name: lm_trans_anonymous_structure_c_type_name_new(result_name)
    if: c_type_name = 0
        return: 1
    finally: lm_own_delete(c_type_name, 0)

    value_c_name: lm_trans_l2_object_suffix_name_new(c_type_name, "_value")
    if: value_c_name = 0
        return: 1
    finally: lm_own_delete(value_c_name, 0)

    descriptor: lm_trans_anonymous_structure_descriptor_new(value_body, result_name, c_type_name, namespace_)
    if: descriptor = 0
        return: 1
    finally: lm_trans_descriptor_delete(descriptor)

    if: lm_trans_anonymous_structure_collision_is_unsupported(namespace_, result_name, descriptor)
        return: 1

    if: lm_trans_emit_message_thread_runtime_prelude(lm_trans_prelude_file(file)) != 0
        return: 1
    if: lm_trans_emit_anonymous_structure_typedef(file, c_type_name, descriptor, indent, namespace_) != 0
        return: 1

    c_type_text: lm_trans_text_from_cstr(c_type_name)
    if: c_type_text = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ c_type_text)

    value_c_text: lm_trans_text_from_cstr(value_c_name)
    if: value_c_text = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ value_c_text)

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_identifier(file, c_type_text) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_emit_identifier(file, value_c_text) != 0 || lm_trans_put(file, " = (") != 0 || lm_trans_emit_identifier(file, c_type_text) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(lm_lmx_message_thread, lm_message_thread_owner(lm_lmx_message_thread), sizeof(*") != 0 || lm_trans_emit_identifier(file, value_c_text) != 0 || lm_trans_put(file, "));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_emit_identifier(file, value_c_text) != 0 || lm_trans_put(file, " == 0) {\n") != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "abort();\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_anonymous_structure_initializers(file, value_body, result_name, value_c_text, descriptor, indent, namespace_) != 0
        return: 1

    published_descriptor: descriptor
    status: lm_trans_namespace_bind_descriptor_with_c_name(namespace_, result_name, "variable", value_c_text, published_descriptor)
    if: status != 0
        return: 1
    descriptor: 0
    status: lm_trans_namespace_declare_relation_text(namespace_, result_name, "variable.type", result_name)
    if: status != 0
        if: lm_trans_namespace_rollback_descriptor_binding(namespace_, result_name, published_descriptor) = 0
            descriptor: published_descriptor
        ---
        return: 1
    ---
return: 0

fn: lm_trans_l2_object_suffix_name_new (
    const: @(char object_name)
    const: @(char suffix)
) @: char
    size_t: object_length
    size_t: suffix_length
    @: char name

    if: object_name = 0 || suffix = 0
        return: 0

    object_length: c.strlen(object_name)
    suffix_length: c.strlen(suffix)
    name: (cast: (@: char) lm_own_new_zero(object_length + suffix_length + 1U))
    if: name = 0
        return: 0
    c.memcpy(name, object_name, object_length)
    c.memcpy(name + object_length, suffix, suffix_length + 1U)
return: name

fn: lm_trans_l2_table_name_atom (const: (LmP0Frame: frame)) const: LmP0Text
    const: LmP0Field: field
    const: LmP0Frame: child_frame
    const: LmP0Field: name_field

    field: 0
    if: frame != 0
        field: lm_trans_l2_structure_first_present_field(frame\body)
    while: field != 0
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            child_frame: field\value\as\frame
            if: lm_trans_text_equals(child_frame\head, "name")
                name_field: lm_trans_l2_structure_first_present_field(child_frame\body)
                if: name_field != 0 && name_field\value != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM
                    return: name_field\value\as\atom
        ---
        field: lm_trans_l2_structure_next_present_field(field)
    if: frame != 0
        return: frame\head
return: 0

fn: lm_trans_l2_structure_child_frame (const: (LmP0Structure: structure); const: @: char head) const: LmP0Frame
    const: LmP0Field: field
    const: LmP0Frame: child

    field: lm_trans_l2_structure_first_present_field(structure)
    while: field != 0
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            child: field\value\as\frame
            if: lm_trans_text_equals(child\head, head)
                return: child
            ---
        ---
        field: lm_trans_l2_structure_next_present_field(field)
return: 0

fn: lm_trans_l2_table_child_frame (const: (LmP0Frame: frame); const: @: char head) const: LmP0Frame
    if: frame = 0
        return: 0
return: lm_trans_l2_structure_child_frame(frame\body, head)

fn: lm_trans_l2_table_present_field_count (const: (LmP0Structure: structure)) size_t
    const: LmP0Field: field
    size_t: count

    count: 0U
    field: lm_trans_l2_structure_first_present_field(structure)
    while: field != 0
        count: count + 1U
        field: lm_trans_l2_structure_next_present_field(field)
return: count

sub: lm_trans_l2_table_columns_destroy (@: LmTransL4CallableType types; @: LmP0Text names; size_t: count)
    size_t: i
    LmP0Text: name

    i: 0U
    while: i < count
        if: types != 0
            lm_trans_expr_callable_type_delete(types[i])
        if: names != 0
            name: names[i]
            lm_trans_text_ref_destroy(@ name)
            names[i]: 0
        i: i + 1U
    lm_own_delete(types, 0)
    lm_own_delete(names, 0)
end: lm_trans_l2_table_columns_destroy

fn: lm_trans_l2_source_read_columns (
    const: (LmP0Structure: body)
    const: @(char error_context)
    @@: LmTransL4CallableType out_types
    @@: LmP0Text out_names
    @: size_t out_count
) int
    const: LmP0Frame: columns_frame
    LmTransFormalParamList: params
    LmTransFormalParam: param
    @: LmTransL4CallableType types
    @: LmP0Text names
    size_t: count
    size_t: index

    if: out_types = 0 || out_names = 0 || out_count = 0
        return: 1
    out_types[0]: 0
    out_names[0]: 0
    out_count[0]: 0U

    columns_frame: lm_trans_l2_structure_child_frame(body, "columns")
    if: columns_frame = 0
        c.fprintf(c.stderr, "trans L2 %s error: declaration must contain columns\n", error_context)
        return: 1

    params: lm_trans_formal_param_list_from_structure(columns_frame\body, 0, error_context)
    if: params = 0
        return: 1
    finally: lm_trans_formal_param_list_delete(params)

    count: params\count
    if: count = 0U
        c.fprintf(c.stderr, "trans L2 %s error: columns must not be empty\n", error_context)
        return: 1

    types: (cast: (@: LmTransL4CallableType) lm_own_new_zero(count * c.sizeof(types[0])))
    names: (cast: (@: LmP0Text) lm_own_new_zero(count * c.sizeof(names[0])))
    if: types = 0 || names = 0
        lm_trans_l2_table_columns_destroy(types, names, count)
        return: 1
    finally: lm_trans_l2_table_columns_destroy(types, names, count)

    index: 0U
    while: index < count
        param: params\params[index]
        types[index]: lm_trans_expr_callable_type_new()
        names[index]: lm_trans_statement_text_new()
        if: types[index] = 0 || names[index] = 0
            return: 1
        if: lm_trans_callable_type_copy(types[index], param\type) != 0
            return: 1
        names[index][0]: param\name[0]
        if: lm_trans_atom_can_be_new_binding_name(names[index]) = 0
            c.fprintf(c.stderr, "trans L2 %s error: column name must be an identifier\n", error_context)
            return: 1
        index: index + 1U

    out_types[0]: types
    out_names[0]: names
    out_count[0]: count
    types: 0
    names: 0
return: 0

fn: lm_trans_l2_table_read_columns (
    const: LmP0Frame: table_frame
    @@: LmTransL4CallableType out_types
    @@: LmP0Text out_names
    @: size_t out_count
) int
    if: table_frame = 0
        return: 1
return: lm_trans_l2_source_read_columns(table_frame\body, "table", out_types, out_names, out_count)

fn: lm_trans_l2_source_columns_registry_keyed (
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    @: int out_registry_keyed
) int
    LmP0Text: name_payload

    if: out_registry_keyed = 0
        return: 1
    out_registry_keyed[0]: 0
    if: column_types = 0 || column_names = 0 || column_count = 0U || column_types[0] = 0 || column_names[0] = 0 || column_types[0]\class_name = 0
        return: 1
    if: column_types[0]\address_depth != 0U || column_types[0]\is_const != 0 || column_types[0]\array_rank != 0U
        return: 0

    name_payload: lm_trans_text_ref_new_cstr("")
    if: name_payload = 0
        lm_trans_text_ref_destroy(@ name_payload)
        return: 1
    finally: lm_trans_text_ref_destroy(@ name_payload)

    if: lm_trans_registry_identifier_value(column_names[0], name_payload) = 0
        return: 1
    out_registry_keyed[0]: name_payload\length = 5U && c.memcmp(name_payload\data, "class", 5U) = 0
return: 0

fn: lm_trans_l2_table_body_is_source_only (
    const: LmP0Structure: body
    const: @(char error_context)
    @: int out_source_only
) int
    const: LmP0Field: first_field
    const: LmP0Field: field
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count

    if: body = 0 || out_source_only = 0
        return: 1
    out_source_only[0]: 0

    first_field: lm_trans_l2_structure_first_present_field(body)
    field: first_field
    while: field != 0
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_equals(field\value\as\atom, "source")
            if: field != first_field || out_source_only[0] != 0
                c.fprintf(c.stderr, "trans L2 table error: source marker must be the first table body field and appear exactly once\n")
                return: 1
            out_source_only[0]: 1
        ---
        field: lm_trans_l2_structure_next_present_field(field)

    if: out_source_only[0] != 0
        return: 0

    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_source_read_columns(body, error_context, @ column_types, @ column_names, @ column_count) != 0
        return: 1

return: lm_trans_l2_source_columns_registry_keyed(column_types, column_names, column_count, out_source_only)

fn: lm_trans_l2_table_rows_frame (const: (LmP0Frame: table_frame)) const: LmP0Frame
    const: LmP0Frame: rows_frame

    rows_frame: lm_trans_l2_table_child_frame(table_frame, "rows")
    if: rows_frame = 0
        c.fprintf(c.stderr, "trans L2 table error: table must contain rows\n")
return: rows_frame

fn: lm_trans_l2_table_row_count (const: (LmP0Frame: rows_frame); size_t: column_count; @: size_t out_row_count) int
    size_t: cell_count

    if: out_row_count = 0 || rows_frame = 0 || column_count = 0U
        return: 1
    cell_count: lm_trans_l2_table_present_field_count(rows_frame\body)
    if: cell_count = 0U
        out_row_count[0]: 0U
        return: 0
    if: (cell_count % column_count) != 0U
        c.fprintf(c.stderr, "trans L2 table error: rows cell count must be divisible by column count\n")
        return: 1
    out_row_count[0]: cell_count / column_count
return: 0

fn: lm_trans_l2_table_source_descriptor_new (
    const: LmP0Text: table_name
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
) LmTableDescriptor
    const: [1]: @: char descriptor_data
    [1]: size_t descriptor_lengths
    LmP0Text: table_value
    LmP0Text: column_value
    LmP0Text: type_value
    LmTableDescriptor: descriptor
    size_t: column_index

    if: table_name = 0 || column_types = 0 || column_names = 0 || column_count = 0U
        return: 0

    table_value: lm_trans_text_ref_new_cstr("")
    column_value: lm_trans_text_ref_new_cstr("")
    type_value: lm_trans_text_ref_new_cstr("")
    if: table_value = 0 || column_value = 0 || type_value = 0 || lm_trans_registry_identifier_value(table_name, table_value) = 0
        lm_trans_text_ref_destroy(@ table_value)
        lm_trans_text_ref_destroy(@ column_value)
        lm_trans_text_ref_destroy(@ type_value)
        return: 0

    descriptor: lm_table_descriptor_new_empty_slice(table_value\data, table_value\length)
    column_index: 0U
    while: descriptor != 0 && column_index < column_count
        if: column_types[column_index] = 0 || column_types[column_index]\class_name = 0 || column_names[column_index] = 0 || lm_trans_registry_identifier_value(column_names[column_index], column_value) = 0 || lm_trans_registry_identifier_value(column_types[column_index]\class_name, type_value) = 0
            lm_table_descriptor_delete_any(descriptor)
            descriptor: 0
            break
        descriptor_data[0]: type_value\data
        descriptor_lengths[0]: type_value\length
        if: lm_table_descriptor_add_column_slices(descriptor, column_value\data, column_value\length, type_value\data, type_value\length, (cast: (const: @@: char) descriptor_data), descriptor_lengths, 1U, column_types[column_index]\address_depth, column_types[column_index]\array_rank, column_types[column_index]\is_const) != 0
            lm_table_descriptor_delete_any(descriptor)
            descriptor: 0
            break
        column_index: column_index + 1U

    lm_trans_text_ref_destroy(@ table_value)
    lm_trans_text_ref_destroy(@ column_value)
    lm_trans_text_ref_destroy(@ type_value)
return: descriptor

fn: lm_trans_l2_table_prepare_source_rows (
    LmTableDescriptor: target
    const: LmP0Frame: rows_frame
    size_t: column_count
    size_t: row_count
    int: require_facade
    @: size_t out_first_row_index
) int
    const: LmP0Field: field
    const: @: LmP0Node cells
    size_t: initial_row_count
    size_t: row_index
    size_t: column_index
    int: status

    if: target = 0 || target\materialized_rows = 0 || rows_frame = 0 || column_count = 0U
        return: 1

    initial_row_count: lm_table_descriptor_materialized_row_count(target)
    if: out_first_row_index != 0
        out_first_row_index[0]: initial_row_count

    cells: (cast: (const: @: LmP0Node) lm_own_new_zero(column_count * c.sizeof(cells[0])))
    if: cells = 0
        return: 1

    status: 0
    field: lm_trans_l2_structure_first_present_field(rows_frame\body)
    row_index: 0U
    while: status = 0 && row_index < row_count
        column_index: 0U
        while: status = 0 && column_index < column_count
            if: field = 0 || field\value = 0
                status: 1
            else:
                cells[column_index]: field\value
                field: lm_trans_l2_structure_next_present_field(field)
            ---
            column_index: column_index + 1U
        if: status = 0 && lm_trans_registry_prepare_source_descriptor_row(target, cells, column_count, require_facade) != 0
            status: 1
        row_index: row_index + 1U

    if: status = 0 && field != 0
        status: 1
    lm_own_delete(cells, 0)

    if: status != 0
        lm_own_ptr_stack_truncate(target\materialized_rows, initial_row_count)
        return: 1
return: 0

fn: lm_trans_l2_table_project_source_rows (LmTableDescriptor: target; size_t: first_row_index) int
    LmTableRow: prepared_row
    size_t: row_index

    if: target = 0 || first_row_index > lm_table_descriptor_materialized_row_count(target)
        return: 1

    row_index: first_row_index
    while: row_index < lm_table_descriptor_materialized_row_count(target)
        prepared_row: lm_own_ptr_stack_at(target\materialized_rows, row_index)
        if: lm_trans_registry_project_source_descriptor_row(target, prepared_row) != 0
            return: 1
        row_index: row_index + 1U
return: 0

fn: lm_trans_l2_table_materialize_source_rows (
    LmTransNamespace: namespace_
    const: LmP0Text: table_name
    const: LmP0Frame: rows_frame
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count
    int: require_facade
) int
    LmRegistryView: view
    LmTableDescriptor: candidate
    LmTableDescriptor: target
    LmTableDescriptor: existing
    size_t: initial_row_count
    int: candidate_is_target
    int: status

    view: 0
    if: c.lm_trans_registry != 0 && lm_trans_namespace_registry_view(namespace_) = c.lm_trans_registry->view
        view: c.lm_trans_registry->view
    if: view = 0
        return: require_facade != 0

    candidate: lm_trans_l2_table_source_descriptor_new(table_name, column_types, column_names, column_count)
    if: candidate = 0
        return: 1

    target: candidate
    candidate_is_target: 1
    existing: lm_registry_view_find_local_source_table_slice(view, candidate\name, c.strlen(candidate\name))
    if: existing != 0 && lm_table_descriptor_schema_same(existing, candidate) != 0
        target: existing
        candidate_is_target: 0
        lm_table_descriptor_delete_any(candidate)
        candidate: 0
    ---

    initial_row_count: lm_table_descriptor_materialized_row_count(target)
    status: lm_trans_l2_table_prepare_source_rows(target, rows_frame, column_count, row_count, require_facade, 0)
    if: status = 0 && lm_trans_registry_preflight_source_descriptor_class_kinds(target, initial_row_count) != 0
        status: 1
    if: status = 0 && lm_trans_l2_table_project_source_rows(target, initial_row_count) != 0
        status: 1

    if: status != 0
        lm_own_ptr_stack_truncate(target\materialized_rows, initial_row_count)
        if: candidate_is_target != 0
            lm_table_descriptor_delete_any(target)
        return: 1

    if: candidate_is_target != 0
        if: lm_registry_view_take_local_source_table(view, target) != 0
            lm_table_descriptor_delete_any(target)
            return: 1
        ---
    else:
        if: lm_table_descriptor_materialized_row_count(target) != initial_row_count
            lm_registry_view_note_mutation(view)
        ---
    ---
return: 0

fn: lm_trans_materialize_l2_table_source (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
    int: require_facade
) int
    const: LmP0Text: table_name
    const: LmP0Frame: rows_frame
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count

    if: namespace_ = 0 || frame = 0
        return: 1

    table_name: lm_trans_l2_table_name_atom(frame)
    if: table_name = 0
        return: 1

    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_table_read_columns(frame, @ column_types, @ column_names, @ column_count) != 0
        return: 1

    rows_frame: lm_trans_l2_table_rows_frame(frame)
    if: rows_frame = 0 || lm_trans_l2_table_row_count(rows_frame, column_count, @ row_count) != 0
        return: 1
return: lm_trans_l2_table_materialize_source_rows(namespace_, table_name, rows_frame, column_types, column_names, column_count, row_count, require_facade)

fn: lm_trans_l2_join_header (
    const: (LmP0Frame: frame)
    const: @(LmP0Structure out_sources)
    const: @(LmP0Text out_target)
    const: @(LmP0Structure out_body)
) int
    const: LmP0Field: field

    if: out_sources = 0 || out_target = 0 || out_body = 0
        return: 1
    out_sources[0]: 0
    out_target[0]: 0
    out_body[0]: 0

    if: frame = 0 || lm_trans_text_equals(frame\head, "join") = 0
        c.fprintf(c.stderr, "trans L2 join error: join receiver expects a join frame\n")
        return: 1

    field: lm_trans_l2_structure_first_present_field(frame\body)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE || lm_trans_l2_structure_first_present_field(field\value\as\structure) = 0
        c.fprintf(c.stderr, "trans L2 join error: join expects a non-empty source table list\n")
        return: 1
    out_sources[0]: field\value\as\structure

    field: lm_trans_l2_structure_next_present_field(field)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 join error: join expects a target table name\n")
        return: 1
    out_target[0]: field\value\as\atom

    field: lm_trans_l2_structure_next_present_field(field)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
        c.fprintf(c.stderr, "trans L2 join error: join expects a table fragment body\n")
        return: 1
    out_body[0]: field\value\as\structure

    if: lm_trans_l2_structure_next_present_field(field) != 0
        c.fprintf(c.stderr, "trans L2 join error: unexpected fields after join body\n")
        return: 1
return: 0

fn: lm_trans_l2_join_sources_ready (
    LmTransNamespace: namespace_
    const: (LmP0Frame: frame)
    @: int out_ready
) int
    const: LmP0Structure: sources
    const: LmP0Structure: body
    const: LmP0Text: target_name
    const: LmP0Field: field
    const: LmP0Node: node
    LmP0Text: source_name
    const: LmRegistryView: view

    if: out_ready != 0
        out_ready[0]: 0
    if: namespace_ = 0 || frame = 0 || out_ready = 0
        return: 1

    view: lm_trans_namespace_registry_view(namespace_)
    if: view = 0 || lm_trans_l2_join_header(frame, @ sources, @ target_name, @ body) != 0
        return: 1
    c.LM_UNUSED(target_name)
    c.LM_UNUSED(body)

    source_name: lm_trans_text_ref_new_cstr("")
    if: source_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ source_name)

    field: lm_trans_l2_structure_first_present_field(sources)
    while: field != 0
        node: field\value
        if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || lm_trans_registry_identifier_value(node\as\atom, source_name) = 0
            c.fprintf(c.stderr, "trans L2 join error: source list expects table name atoms\n")
            return: 1
        if: lm_registry_view_find_source_table_slice(view, source_name\data, source_name\length) = 0
            return: 0
        field: lm_trans_l2_structure_next_present_field(field)

    out_ready[0]: 1
return: 0

fn: lm_trans_l2_join_body_rows (const: (LmP0Structure: body); const: @(LmP0Frame out_rows)) int
    const: LmP0Field: field
    const: LmP0Frame: child
    int: have_columns
    int: have_rows

    if: body = 0 || out_rows = 0
        return: 1
    out_rows[0]: 0
    have_columns: 0
    have_rows: 0
    field: lm_trans_l2_structure_first_present_field(body)
    while: field != 0
        if: field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
            c.fprintf(c.stderr, "trans L2 join error: join body expects columns/rows frames\n")
            return: 1
        child: field\value\as\frame
        if: lm_trans_text_equals(child\head, "columns")
            if: have_columns != 0
                c.fprintf(c.stderr, "trans L2 join error: join expects exactly one columns frame\n")
                return: 1
            have_columns: 1
        else:
            if: lm_trans_text_equals(child\head, "rows")
                if: have_rows != 0
                    c.fprintf(c.stderr, "trans L2 join error: join expects at most one rows frame\n")
                    return: 1
                have_rows: 1
                out_rows[0]: child
            else:
                c.fprintf(c.stderr, "trans L2 join error: join body expects columns/rows frames\n")
                return: 1
            ---
        ---
        field: lm_trans_l2_structure_next_present_field(field)

    if: have_columns = 0
        c.fprintf(c.stderr, "trans L2 join error: join requires target columns\n")
        return: 1
return: 0

fn: lm_trans_l2_join_stage_source_rows (
    LmRegistryView: view
    LmTableDescriptor: target
    const: (LmP0Structure: sources)
    size_t: snapshot_source_count
    const: @(size_t snapshot_row_counts)
) int
    const: LmP0Field: field
    const: LmP0Node: node
    LmP0Text: source_value
    int: status

    source_value: lm_trans_text_ref_new_cstr("")
    if: source_value = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ source_value)

    status: 0
    field: lm_trans_l2_structure_first_present_field(sources)
    while: status = 0 && field != 0
        node: field\value
        if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 join error: source list expects table name atoms\n")
            status: 1
        else:
            if: lm_trans_registry_identifier_value(node\as\atom, source_value) = 0 || lm_registry_view_append_materialized_rows_mode(view, target, source_value\data, source_value\length, 0, 1, snapshot_source_count, snapshot_row_counts) != 0
                status: 1
            ---
        ---
        field: lm_trans_l2_structure_next_present_field(field)
return: status

fn: lm_trans_l2_join_target_relation_equals (
    const: (LmP0Text: target_name)
    const: @(char suffix)
    const: @(char relation_name)
) int
    size_t: suffix_length
    size_t: relation_length

    if: target_name = 0 || target_name\data = 0 || suffix = 0 || relation_name = 0
        return: 0
    suffix_length: c.strlen(suffix)
    relation_length: c.strlen(relation_name)
    if: target_name\length + suffix_length != relation_length
        return: 0
    if: target_name\length != 0U && c.memcmp(target_name\data, relation_name, target_name\length) != 0
        return: 0
    if: suffix_length != 0U && c.memcmp(suffix, relation_name + target_name\length, suffix_length) != 0
        return: 0
return: 1

fn: lm_trans_l2_join_target_relation_declares_class_kind (
    const: (LmP0Text: target_name)
    const: @(char suffix)
) int
    if: lm_trans_l2_join_target_relation_equals(target_name, suffix, "class") != 0
        return: 1
return: lm_trans_l2_join_target_relation_equals(target_name, suffix, "class.kind")

fn: lm_trans_l2_join_pending_descriptor_class_kind_conflicts (
    const: (LmTableDescriptor: descriptor)
    size_t: first_row_index
    const: @(char name)
    const: @(char kind)
) int
    const: LmTableRow: row
    const: LmTableCell: key_cell
    const: LmTableCell: payload_cell
    size_t: row_count
    size_t: row_index
    size_t: column_count
    size_t: column_index
    int: relation_status

    if: descriptor = 0 || descriptor\materialized_rows = 0 || name = 0 || kind = 0
        return: 1
    row_count: lm_table_descriptor_materialized_row_count(descriptor)
    column_count: lm_table_descriptor_column_count(descriptor)
    if: first_row_index > row_count || column_count = 0U
        return: 1

    row_index: first_row_index
    while: row_index < row_count
        row: lm_table_descriptor_materialized_row_at(descriptor, row_index)
        if: row = 0 || lm_table_row_cell_count(row) != column_count
            return: 1
        if: row\source_native = 0
            key_cell: lm_table_row_cell_at(row, 0U)
            if: key_cell = 0 || key_cell\value = 0 || key_cell\node != 0
                return: 1
            column_index: 1U
            while: column_index < column_count
                payload_cell: lm_table_row_cell_at(row, column_index)
                relation_status: lm_trans_registry_source_descriptor_column_declares_class_kind(descriptor, column_index)
                if: payload_cell = 0 || relation_status < 0 || (payload_cell\value != 0 && payload_cell\node != 0)
                    return: 1
                if: relation_status != 0 && payload_cell\value != 0 && c.strcmp(key_cell\value, name) = 0 && c.strcmp(payload_cell\value, kind) != 0
                    c.fprintf(c.stderr, "trans registry class error: class %s has conflicting kinds %s and %s\n", name, payload_cell\value, kind)
                    return: 1
                column_index: column_index + 1U
        ---
        row_index: row_index + 1U
return: 0

fn: lm_trans_l2_join_preflight_source_facades (
    const: (LmP0Structure: sources)
    const: (LmP0Text: target_name)
    const: (LmTableDescriptor: target)
    size_t: first_row_index
    size_t: snapshot_fact_count
) int
    const: LmP0Field: field
    const: LmP0Node: node
    const: LmRegistryViewRow: view_row
    LmTransRegistryFact: row
    LmTransRegistryFact: previous
    LmP0Text: source_value
    LmP0Text: target_value
    LmP0Text: name_text
    LmP0Text: kind_text
    LmOwnPtrStack: planned_class_kinds
    const: @: char suffix
    size_t: fact_count
    size_t: fact_index
    size_t: previous_index
    int: status

    if: sources = 0 || target_name = 0 || target = 0 || c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0
        return: 1

    source_value: lm_trans_text_ref_new_cstr("")
    target_value: lm_trans_text_ref_new_cstr("")
    planned_class_kinds: lm_trans_ptr_stack_new(0)
    if: source_value = 0 || target_value = 0 || planned_class_kinds = 0
        lm_trans_text_ref_destroy(@ source_value)
        lm_trans_text_ref_destroy(@ target_value)
        lm_trans_ptr_stack_delete(@ planned_class_kinds)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ source_value)
        lm_trans_text_ref_destroy(@ target_value)
        lm_trans_ptr_stack_delete(@ planned_class_kinds)

    if: lm_trans_registry_identifier_value(target_name, target_value) = 0
        return: 1

    status: 0
    fact_count: lm_registry_view_fact_count(c.lm_trans_registry->view)
    if: snapshot_fact_count > fact_count
        return: 1
    fact_count: snapshot_fact_count
    field: lm_trans_l2_structure_first_present_field(sources)
    while: status = 0 && field != 0
        node: field\value
        if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || lm_trans_registry_identifier_value(node\as\atom, source_value) = 0
            status: 1
        else:
            fact_index: 0U
            while: status = 0 && fact_index < fact_count
                view_row: lm_registry_view_fact_at(c.lm_trans_registry->view, fact_index)
                row: 0
                if: view_row != 0
                    row: cast: (LmTransRegistryFact) view_row\source
                if: row != 0 && row\table != 0 && row\key != 0 && row\payload != 0 && row\payload_node = 0 && lm_trans_registry_join_relation_matches(row\table, source_value, @ suffix) != 0 && lm_trans_l2_join_target_relation_declares_class_kind(target_value, suffix) != 0
                    name_text: lm_trans_text_from_cstr(row\key)
                    kind_text: lm_trans_text_from_cstr(row\payload)
                    if: name_text = 0 || kind_text = 0
                        status: 1
                    else:
                        status: lm_trans_registry_check_class_kind_row(name_text, kind_text)
                        if: status = 0
                            status: lm_trans_l2_join_pending_descriptor_class_kind_conflicts(target, first_row_index, row\key, row\payload)
                        previous_index: 0U
                        while: status = 0 && previous_index < planned_class_kinds\count
                            previous: cast: (LmTransRegistryFact) lm_own_ptr_stack_at(planned_class_kinds, previous_index)
                            if: previous = 0 || previous\key = 0 || previous\payload = 0
                                status: 1
                            else:
                                if: c.strcmp(previous\key, row\key) = 0 && c.strcmp(previous\payload, row\payload) != 0
                                    c.fprintf(c.stderr, "trans registry class error: class %s has conflicting kinds %s and %s\n", row\key, previous\payload, row\payload)
                                    status: 1
                            ---
                            previous_index: previous_index + 1U
                        if: status = 0 && lm_own_ptr_stack_push(planned_class_kinds, row) != 0
                            status: 1
                    ---
                    lm_trans_text_ref_destroy(@ name_text)
                    lm_trans_text_ref_destroy(@ kind_text)
                ---
                fact_index: fact_index + 1U
        ---
        field: lm_trans_l2_structure_next_present_field(field)
return: status

fn: lm_trans_l2_join_project_source_facades (
    const: (LmP0Structure: sources)
    const: (LmP0Text: target_name)
    size_t: snapshot_fact_count
) int
    const: LmP0Field: field
    const: LmP0Node: node
    const: LmRegistryViewRow: view_row
    LmTransRegistryFact: row
    LmP0Text: source_value
    LmP0Text: target_value
    size_t: fact_count
    size_t: fact_index
    size_t: copied
    int: status

    if: sources = 0 || target_name = 0 || c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0
        return: 1

    source_value: lm_trans_text_ref_new_cstr("")
    target_value: lm_trans_text_ref_new_cstr("")
    if: source_value = 0 || target_value = 0
        lm_trans_text_ref_destroy(@ source_value)
        lm_trans_text_ref_destroy(@ target_value)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ source_value)
        lm_trans_text_ref_destroy(@ target_value)

    if: lm_trans_registry_identifier_value(target_name, target_value) = 0
        return: 1
    fact_count: lm_registry_view_fact_count(c.lm_trans_registry->view)
    if: snapshot_fact_count > fact_count
        return: 1
    fact_count: snapshot_fact_count

    status: 0
    copied: 0U
    field: lm_trans_l2_structure_first_present_field(sources)
    while: status = 0 && field != 0
        node: field\value
        if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || lm_trans_registry_identifier_value(node\as\atom, source_value) = 0
            status: 1
        else:
            fact_index: 0U
            while: status = 0 && fact_index < fact_count
                view_row: lm_registry_view_fact_at(c.lm_trans_registry->view, fact_index)
                row: 0
                if: view_row != 0
                    row: cast: (LmTransRegistryFact) view_row\source
                status: lm_trans_registry_join_copy_row(row, source_value, target_value, @ copied)
                fact_index: fact_index + 1U
        ---
        field: lm_trans_l2_structure_next_present_field(field)
return: status

fn: lm_trans_materialize_l2_join_source (LmTransNamespace: namespace_; const: (LmP0Frame: frame)) int
    const: LmP0Structure: sources
    const: LmP0Structure: body
    const: LmP0Text: target_name
    const: LmP0Frame: rows_frame
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count
    size_t: initial_row_count
    size_t: direct_row_index
    size_t: snapshot_source_count
    size_t: snapshot_source_index
    size_t: snapshot_fact_count
    @: size_t snapshot_row_counts
    LmRegistryView: view
    LmTableDescriptor: candidate
    LmTableDescriptor: target
    LmTableDescriptor: existing
    const: LmTableDescriptor: snapshot_source
    int: candidate_is_target
    int: status

    if: namespace_ = 0 || frame = 0 || c.lm_trans_registry = 0 || lm_trans_namespace_registry_view(namespace_) != c.lm_trans_registry->view
        return: 1
    view: c.lm_trans_registry->view
    if: view = 0 || lm_trans_l2_join_header(frame, @ sources, @ target_name, @ body) != 0 || lm_trans_l2_join_body_rows(body, @ rows_frame) != 0
        return: 1

    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_source_read_columns(body, "join", @ column_types, @ column_names, @ column_count) != 0
        return: 1

    row_count: 0U
    if: rows_frame != 0 && lm_trans_l2_table_row_count(rows_frame, column_count, @ row_count) != 0
        return: 1

    candidate: lm_trans_l2_table_source_descriptor_new(target_name, column_types, column_names, column_count)
    if: candidate = 0
        return: 1

    target: candidate
    candidate_is_target: 1
    existing: lm_registry_view_find_local_source_table_slice(view, candidate\name, c.strlen(candidate\name))
    if: existing != 0 && lm_table_descriptor_schema_same(existing, candidate) != 0
        target: existing
        candidate_is_target: 0
        lm_table_descriptor_delete_any(candidate)
        candidate: 0
    ---

    snapshot_source_count: lm_registry_view_source_table_count(view)
    snapshot_row_counts: lm_own_new_zero((snapshot_source_count + 1U) * c.sizeof(snapshot_row_counts[0]))
    if: snapshot_row_counts = 0
        if: candidate_is_target != 0
            lm_table_descriptor_delete_any(target)
        return: 1
    finally: lm_own_delete(snapshot_row_counts, 0)
    snapshot_source_index: 0U
    while: snapshot_source_index < snapshot_source_count
        snapshot_source: lm_registry_view_source_table_at(view, snapshot_source_index)
        if: snapshot_source = 0
            if: candidate_is_target != 0
                lm_table_descriptor_delete_any(target)
            return: 1
        snapshot_row_counts[snapshot_source_index]: lm_table_descriptor_materialized_row_count(snapshot_source)
        snapshot_source_index: snapshot_source_index + 1U
    snapshot_fact_count: lm_registry_view_fact_count(view)

    initial_row_count: lm_table_descriptor_materialized_row_count(target)
    status: lm_trans_l2_join_stage_source_rows(view, target, sources, snapshot_source_count, snapshot_row_counts)
    direct_row_index: lm_table_descriptor_materialized_row_count(target)
    if: status = 0 && rows_frame != 0 && lm_trans_l2_table_prepare_source_rows(target, rows_frame, column_count, row_count, 0, 0) != 0
        status: 1
    if: status = 0 && lm_trans_registry_preflight_source_descriptor_class_kinds(target, initial_row_count) != 0
        status: 1
    if: status = 0 && lm_trans_l2_join_preflight_source_facades(sources, target_name, target, initial_row_count, snapshot_fact_count) != 0
        status: 1
    if: status = 0 && lm_trans_l2_join_project_source_facades(sources, target_name, snapshot_fact_count) != 0
        status: 1
    if: status = 0 && lm_trans_l2_table_project_source_rows(target, direct_row_index) != 0
        status: 1

    if: status != 0
        lm_own_ptr_stack_truncate(target\materialized_rows, initial_row_count)
        if: candidate_is_target != 0
            lm_table_descriptor_delete_any(target)
        return: 1

    if: candidate_is_target != 0
        if: lm_registry_view_take_local_source_table(view, target) != 0
            lm_table_descriptor_delete_any(target)
            return: 1
        ---
    else:
        if: lm_table_descriptor_materialized_row_count(target) != initial_row_count
            lm_registry_view_note_mutation(view)
        ---
    ---
return: 0

fn: lm_trans_declare_l2_join_mode (LmTransNamespace: namespace_; const: (LmP0Frame: frame); int: materialize_source) int
    if: lm_trans_validate_l2_join_frame(frame) != 0
        return: 1
    if: lm_trans_l2_table_materialization_suppression_depth > 0
        c.fprintf(c.stderr, "trans L2 join error: joins are not allowed in os/ifdef branches\n")
        return: 1
    if: materialize_source = 0 || (lm_trans_current_source_path != 0 && lm_trans_registry_path_is_predefined(lm_trans_current_source_path) != 0)
        return: 0
return: lm_trans_materialize_l2_join_source(namespace_, frame)

fn: lm_trans_declare_l2_join (LmTransNamespace: namespace_; const: (LmP0Frame: frame)) int
return: lm_trans_declare_l2_join_mode(namespace_, frame, 1)

fn: lm_trans_l2_table_object_name_new (const: (LmP0Text: table_name)) @: char
return: lm_trans_l2_c_identifier_new("lm_l2_table_", table_name, "")

fn: lm_trans_l2_table_row_type_name_new (const: (LmP0Text: table_name)) @: char
return: lm_trans_l2_c_identifier_new("lm_l2_table_", table_name, "_row")

fn: lm_trans_l2_table_storage_name_new (const: (LmP0Text: table_name)) @: char
return: lm_trans_l2_c_identifier_new("lm_l2_table_", table_name, "_storage")

fn: lm_trans_l2_table_note_row_layout (
    LmTransNamespace: namespace_
    const: LmP0Text: row_type
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
) int
    size_t: index
    int: status

    c.LM_UNUSED(namespace_)
    if: row_type = 0 || column_types = 0 || column_names = 0
        return: 1

    status: lm_trans_registry_note_class_present(row_type) != 0 || lm_trans_registry_note_class_kind(row_type, "layout") != 0 || lm_trans_registry_note_class_reference_base(row_type) != 0 || lm_trans_registry_note_layout_backend(row_type, "c.struct") != 0
    index: 0U
    while: status = 0 && index < column_count
        status: lm_trans_named_structure_push_field_relations(row_type, column_names[index], column_types[index], index)
        index: index + 1U
return: status != 0

fn: lm_trans_declare_l2_table_binding (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
    const: LmP0Text: table_name
    const: LmP0Frame: rows_frame
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count
    @: char object_name
    @: char row_type_name
    LmP0Text: object_name_text
    LmP0Text: row_type_text
    int: status

    if: namespace_ = 0 || frame = 0
        return: 1

    table_name: lm_trans_l2_table_name_atom(frame)
    if: table_name = 0 || lm_trans_atom_can_be_new_binding_name(table_name) = 0
        c.fprintf(c.stderr, "trans L2 table error: table name must be an identifier\n")
        return: 1

    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_table_read_columns(frame, @ column_types, @ column_names, @ column_count) != 0
        return: 1

    rows_frame: lm_trans_l2_table_rows_frame(frame)
    if: rows_frame = 0 || lm_trans_l2_table_row_count(rows_frame, column_count, @ row_count) != 0
        return: 1

    object_name: lm_trans_l2_table_object_name_new(table_name)
    row_type_name: lm_trans_l2_table_row_type_name_new(table_name)
    if: object_name = 0 || row_type_name = 0
        lm_own_delete(object_name, 0)
        lm_own_delete(row_type_name, 0)
        return: 1
    finally:
        lm_own_delete(object_name, 0)
        lm_own_delete(row_type_name, 0)

    object_name_text: lm_trans_text_from_cstr(object_name)
    row_type_text: lm_trans_text_from_cstr(row_type_name)
    if: object_name_text = 0 || row_type_text = 0
        lm_trans_text_ref_destroy(@ object_name_text)
        lm_trans_text_ref_destroy(@ row_type_text)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ object_name_text)
        lm_trans_text_ref_destroy(@ row_type_text)

    status: lm_trans_l2_table_note_row_layout(namespace_, row_type_text, column_types, column_names, column_count) != 0 || lm_trans_namespace_declare_c_name(namespace_, table_name, "variable", object_name_text) != 0 || lm_trans_namespace_declare_relation_text(namespace_, table_name, "variable.type", row_type_text) != 0
return: status != 0

fn: lm_trans_declare_l2_table_mode (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
    int: materialize_source
) int
    int: source_only

    if: frame = 0 || lm_trans_l2_table_body_is_source_only(frame\body, "table", @ source_only) != 0
        return: 1
    if: source_only != 0 && lm_trans_l2_table_materialization_suppression_depth > 0
        c.fprintf(c.stderr, "trans L2 table error: Registry tables are not allowed in os/ifdef branches\n")
        return: 1
    if: source_only = 0 && lm_trans_declare_l2_table_binding(namespace_, frame) != 0
        return: 1
    if: materialize_source = 0 || lm_trans_l2_table_materialization_suppression_depth > 0 || (lm_trans_current_source_path != 0 && lm_trans_registry_path_is_predefined(lm_trans_current_source_path) != 0)
        return: 0
return: lm_trans_materialize_l2_table_source(namespace_, frame, 0)

fn: lm_trans_declare_l2_table (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
return: lm_trans_declare_l2_table_mode(namespace_, frame, 1)

fn: lm_trans_emit_l2_table_row_type (
    FILE: file
    const: @(char row_type_name)
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    size_t: index

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "typedef struct ") != 0 || lm_trans_put(file, row_type_name) != 0 || lm_trans_put(file, " {\n") != 0
        return: 1
    index: 0U
    while: index < column_count
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_emit_callable_type_named(file, column_types[index], column_names[index], namespace_) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        index: index + 1U
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "} ") != 0 || lm_trans_put(file, row_type_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_l2_table_root_row_type (
    FILE: file
    const: @(char row_type_name)
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    const: LmTransNamespace: namespace_
) int
    FILE: declaration_file
    int: emitted
    int: status

    declaration_file: c.tmpfile()
    if: declaration_file = 0
        return: 1
    status: lm_trans_emit_l2_table_row_type(declaration_file, row_type_name, column_types, column_names, column_count, 0U, namespace_)
    if: status = 0
        status: lm_trans_typedef_projection_emit_prepared_cstr(file, row_type_name, declaration_file, @ emitted)
    c.fclose(declaration_file)
return: status

fn: lm_trans_emit_l2_table_local_row_type (
    FILE: file
    const: @(char row_type_name)
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    FILE: declaration_file
    int: suppressed
    int: status

    declaration_file: c.tmpfile()
    if: declaration_file = 0
        return: 1
    status: lm_trans_emit_l2_table_row_type(declaration_file, row_type_name, column_types, column_names, column_count, 0U, namespace_)
    if: status = 0
        status: lm_trans_typedef_projection_claim_local_prepared_cstr(file, row_type_name, declaration_file, @ suppressed)
    c.fclose(declaration_file)
    if: status != 0 || suppressed
        return: status
return: lm_trans_emit_l2_table_row_type(file, row_type_name, column_types, column_names, column_count, indent, namespace_)

fn: lm_trans_l2_table_cell_inline_layout_body (
    const: LmP0Node: node
    const: LmTransL4CallableType: expected_type
    const: LmTransNamespace: namespace_
) const: LmP0Structure
    if: node = 0 || expected_type = 0 || expected_type\class_name = 0
        return: 0
    if: lm_trans_effective_address_depth(expected_type\class_name, expected_type\address_depth, namespace_) != 1U
        return: 0
    if: lm_trans_namespace_layout_source_is_supported(namespace_, expected_type\class_name) = 0 && lm_trans_namespace_has_named_structure_binding(namespace_, expected_type\class_name) = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: node\as\structure
    if: node\kind = c.LM_P0_NODE_FRAME && lm_trans_identifier_same(node\as\frame\head, expected_type\class_name)
        return: node\as\frame\body
return: 0

fn: lm_trans_l2_table_cell_storage_name_new (const: @(char object_name); size_t: row_index; size_t: column_index) @: char
    [64]: char suffix

    c.snprintf(suffix, c.sizeof(suffix), "_r%zu_c%zu", row_index, column_index)
return: lm_trans_l2_object_suffix_name_new(object_name, suffix)

fn: lm_trans_l2_table_layout_field_type (
    const: LmP0Text: owner
    const: LmP0Text: field_name
    const: LmTransNamespace: namespace_
    LmTransL4CallableType: out_type
) int
    @: char relation_name
    @: char descriptor_field_name
    const: @: char field_class
    const: @: char address_depth_payload
    const: @: char const_payload
    const: LmTransDescriptor: descriptor
    const: LmTransDescriptorField: descriptor_field
    size_t: address_depth
    size_t: const_flag

    if: owner = 0 || field_name = 0 || namespace_ = 0 || out_type = 0
        return: 0

    descriptor: lm_trans_namespace_descriptor(namespace_, owner)
    if: descriptor != 0 && descriptor\has_structural_fields
        descriptor_field_name: lm_trans_descriptor_name_copy(field_name)
        if: descriptor_field_name = 0
            return: 0
        descriptor_field: lm_trans_descriptor_structural_field(descriptor, descriptor_field_name)
        lm_own_delete(descriptor_field_name, 0)
        if: descriptor_field = 0 || descriptor_field\is_union || descriptor_field\descriptor_name = 0
            c.fprintf(c.stderr, "trans L2 table error: inline row value field \"%.*s\" is not declared on \"%.*s\"\n", (cast: int field_name\length), field_name\data, (cast: int owner\length), owner\data)
            return: 0
        return: lm_trans_named_structure_type_set_cstr(out_type, descriptor_field\descriptor_name, descriptor_field\address_depth, descriptor_field\is_const)
    ---

    relation_name: lm_trans_registry_relation_name_new(owner, ".field.class")
    if: relation_name = 0
        return: 0
    field_class: lm_trans_namespace_registry_source_path_n2_named_typed_value(namespace_, field_name, relation_name, "class", "class", "field", "class")
    lm_own_delete(relation_name, 0)
    if: field_class = 0
        c.fprintf(c.stderr, "trans L2 table error: inline row value field \"%.*s\" is not declared on \"%.*s\"\n", (cast: int field_name\length), field_name\data, (cast: int owner\length), owner\data)
        return: 0

    address_depth: 0U
    relation_name: lm_trans_registry_relation_name_new(owner, ".field.address-depth")
    if: relation_name = 0
        return: 0
    address_depth_payload: lm_trans_namespace_registry_source_path_n2_named_typed_value(namespace_, field_name, relation_name, "class", "class", "depth", "size_t")
    lm_own_delete(relation_name, 0)
    if: address_depth_payload != 0 && lm_trans_parse_size_payload(address_depth_payload, @ address_depth) = 0
        c.fprintf(c.stderr, "trans L2 table error: inline row value field \"%.*s\" on \"%.*s\" has invalid field.address-depth\n", (cast: int field_name\length), field_name\data, (cast: int owner\length), owner\data)
        return: 0

    const_flag: 0U
    relation_name: lm_trans_registry_relation_name_new(owner, ".field.const")
    if: relation_name = 0
        return: 0
    const_payload: lm_trans_namespace_registry_source_path_n2_named_typed_value(namespace_, field_name, relation_name, "class", "class", "value", "int")
    lm_own_delete(relation_name, 0)
    if: const_payload != 0 && lm_trans_parse_size_payload(const_payload, @ const_flag) = 0
        c.fprintf(c.stderr, "trans L2 table error: inline row value field \"%.*s\" on \"%.*s\" has invalid field.const\n", (cast: int field_name\length), field_name\data, (cast: int owner\length), owner\data)
        return: 0

return: lm_trans_named_structure_type_set_cstr(out_type, field_class, address_depth, const_flag != 0U)

fn: lm_trans_emit_l2_table_expr_with_expected_type (
    FILE: file
    const: LmP0Field: first
    const: LmP0Field: stop
    LmTransNamespace: namespace_
    const: LmTransL4CallableType: expected_type
) int
    if: expected_type = 0 || expected_type\class_name = 0
        return: 1
return: lm_trans_emit_expr_range_with_expected_type(file, first, stop, namespace_, expected_type)

fn: lm_trans_emit_l2_table_inline_layout_initializer (
    FILE: file
    const: LmP0Structure: body
    const: LmTransL4CallableType: expected_type
    LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    const: LmP0Frame: field_frame
    const: LmP0Field: initializer
    LmTransL4CallableType: field_type
    int: wrote

    if: expected_type = 0 || expected_type\class_name = 0
        return: 1
    if: lm_trans_put(file, " = {") != 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    field: 0
    if: body != 0
        field: body\first_field
    wrote: 0
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
                c.fprintf(c.stderr, "trans L2 table error: inline row value expects field frames\n")
                return: 1
            field_frame: field\value\as\frame
            if: (field_frame\flags & c.LM_P0_FRAME_COLON) = 0U
                c.fprintf(c.stderr, "trans L2 table error: inline row value field \"%.*s\" must use ':'\n", (cast: int field_frame\head\length), field_frame\head\data)
                return: 1
            initializer: field_frame\body\first_field
            if: initializer = 0
                c.fprintf(c.stderr, "trans L2 table error: inline row value field \"%.*s\" requires a value\n", (cast: int field_frame\head\length), field_frame\head\data)
                return: 1
            if: lm_trans_l2_table_layout_field_type(expected_type\class_name, field_frame\head, namespace_, field_type) = 0
                return: 1
            if: wrote && lm_trans_put(file, ", ") != 0
                return: 1
            if: lm_trans_put(file, ".") != 0 || lm_trans_emit_identifier(file, field_frame\head) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_l2_table_expr_with_expected_type(file, initializer, 0, namespace_, field_type) != 0
                return: 1
            wrote: 1
        ---
        field: field\next
    if: wrote = 0 && lm_trans_put(file, "0") != 0
        return: 1
return: lm_trans_put(file, "}")

fn: lm_trans_emit_l2_table_cell_backing_storage (
    FILE: file
    const: @(char object_name)
    const: LmP0Node: cell_node
    const: LmTransL4CallableType: expected_type
    size_t: row_index
    size_t: column_index
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Structure: body
    @: char cell_name

    body: lm_trans_l2_table_cell_inline_layout_body(cell_node, expected_type, namespace_)
    if: body = 0
        return: 0

    cell_name: lm_trans_l2_table_cell_storage_name_new(object_name, row_index, column_index)
    if: cell_name = 0
        return: 1
    finally: lm_own_delete(cell_name, 0)

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "static ") != 0 || lm_trans_emit_type_name(file, expected_type\class_name) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_put(file, cell_name) != 0
        return: 1
    if: lm_trans_emit_l2_table_inline_layout_initializer(file, body, expected_type, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_l2_table_cell_backing_storages (
    FILE: file
    const: LmP0Frame: rows_frame
    const: @(char object_name)
    @: LmTransL4CallableType column_types
    size_t: column_count
    size_t: row_count
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: cell
    size_t: row_index
    size_t: column_index

    cell: lm_trans_l2_structure_first_present_field(rows_frame\body)
    row_index: 0U
    while: row_index < row_count
        column_index: 0U
        while: column_index < column_count
            if: cell = 0 || cell\value = 0
                return: 1
            if: lm_trans_emit_l2_table_cell_backing_storage(file, object_name, cell\value, column_types[column_index], row_index, column_index, indent, namespace_) != 0
                return: 1
            cell: lm_trans_l2_structure_next_present_field(cell)
            column_index: column_index + 1U
        row_index: row_index + 1U
return: 0

fn: lm_trans_emit_l2_table_cell_value (
    FILE: file
    const: @(char object_name)
    const: LmP0Field: cell
    const: LmP0Field: next_cell
    const: LmTransL4CallableType: expected_type
    size_t: row_index
    size_t: column_index
    LmTransNamespace: namespace_
) int
    const: LmP0Structure: inline_body
    @: char cell_name

    if: cell = 0 || cell\value = 0 || expected_type = 0
        return: 1

    inline_body: lm_trans_l2_table_cell_inline_layout_body(cell\value, expected_type, namespace_)
    if: inline_body != 0
        cell_name: lm_trans_l2_table_cell_storage_name_new(object_name, row_index, column_index)
        if: cell_name = 0
            return: 1
        if: lm_trans_put(file, "&") != 0 || lm_trans_put(file, cell_name) != 0
            lm_own_delete(cell_name, 0)
            return: 1
        lm_own_delete(cell_name, 0)
        return: 0
    ---

return: lm_trans_emit_l2_table_expr_with_expected_type(file, cell, next_cell, namespace_, expected_type)

fn: lm_trans_emit_l2_table_row_initializer (
    FILE: file
    const: @(char object_name)
    const: LmP0Field: first_cell
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_index
    LmTransNamespace: namespace_
    const: @(LmP0Field out_next_cell)
) int
    const: LmP0Field: cell
    const: LmP0Field: next_cell
    size_t: column_index

    if: out_next_cell = 0
        return: 1
    cell: first_cell
    if: lm_trans_put(file, "{") != 0
        return: 1
    column_index: 0U
    while: column_index < column_count
        if: cell = 0 || cell\value = 0
            return: 1
        next_cell: lm_trans_l2_structure_next_present_field(cell)
        if: column_index != 0U && lm_trans_put(file, ", ") != 0
            return: 1
        if: lm_trans_put(file, ".") != 0 || lm_trans_emit_identifier(file, column_names[column_index]) != 0 || lm_trans_put(file, " = ") != 0
            return: 1
        if: lm_trans_emit_l2_table_cell_value(file, object_name, cell, next_cell, column_types[column_index], row_index, column_index, namespace_) != 0
            return: 1
        cell: next_cell
        column_index: column_index + 1U
    if: lm_trans_put(file, "}") != 0
        return: 1
    out_next_cell[0]: cell
return: 0

fn: lm_trans_emit_l2_table_storage (
    FILE: file
    const: LmP0Frame: rows_frame
    const: @(char object_name)
    const: @(char row_type_name)
    const: @(char storage_name)
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Field: cell
    size_t: row_index

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "static const ") != 0 || lm_trans_put(file, row_type_name) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_put(file, storage_name) != 0 || lm_trans_put(file, "[] = ") != 0
        return: 1
    if: row_count = 0U
        return: lm_trans_put(file, "{{0}};\n")
    if: lm_trans_put(file, "{\n") != 0
        return: 1
    cell: lm_trans_l2_structure_first_present_field(rows_frame\body)
    row_index: 0U
    while: row_index < row_count
        if: lm_trans_emit_indent(file, indent + 1U) != 0
            return: 1
        if: lm_trans_emit_l2_table_row_initializer(file, object_name, cell, column_types, column_names, column_count, row_index, namespace_, @ cell) != 0
            return: 1
        if: row_index + 1U < row_count && lm_trans_put(file, ",") != 0
            return: 1
        if: lm_trans_put(file, "\n") != 0
            return: 1
        row_index: row_index + 1U
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "};\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_l2_table_pointer (
    FILE: file
    const: @(char row_type_name)
    const: @(char object_name)
    const: @(char storage_name)
    unsigned: indent
) int
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "static const ") != 0 || lm_trans_put(file, row_type_name) != 0 || lm_trans_put(file, " *const ") != 0 || lm_trans_put(file, object_name) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_put(file, storage_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_l2_table_storage_value (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Text: table_name
    const: LmP0Frame: rows_frame
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count
    @: char object_name
    @: char row_type_name
    @: char storage_name
    int: source_only

    if: frame = 0 || lm_trans_l2_table_body_is_source_only(frame\body, "table", @ source_only) != 0
        return: 1
    if: source_only != 0
        return: 0

    table_name: lm_trans_l2_table_name_atom(frame)
    if: table_name = 0 || lm_trans_atom_can_be_new_binding_name(table_name) = 0
        c.fprintf(c.stderr, "trans L2 table error: table name must be an identifier\n")
        return: 1

    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_table_read_columns(frame, @ column_types, @ column_names, @ column_count) != 0
        return: 1

    rows_frame: lm_trans_l2_table_rows_frame(frame)
    if: rows_frame = 0 || lm_trans_l2_table_row_count(rows_frame, column_count, @ row_count) != 0
        return: 1

    object_name: lm_trans_l2_table_object_name_new(table_name)
    row_type_name: lm_trans_l2_table_row_type_name_new(table_name)
    storage_name: lm_trans_l2_table_storage_name_new(table_name)
    if: object_name = 0 || row_type_name = 0 || storage_name = 0
        lm_own_delete(object_name, 0)
        lm_own_delete(row_type_name, 0)
        lm_own_delete(storage_name, 0)
        return: 1
    finally:
        lm_own_delete(object_name, 0)
        lm_own_delete(row_type_name, 0)
        lm_own_delete(storage_name, 0)

    if: indent != 0U
        if: lm_trans_declare_l2_table_binding(namespace_, frame) != 0 || lm_trans_emit_l2_table_local_row_type(file, row_type_name, column_types, column_names, column_count, indent, namespace_) != 0
            return: 1
        ---
    else:
        if: lm_trans_emit_l2_table_root_row_type(file, row_type_name, column_types, column_names, column_count, namespace_) != 0
            return: 1
        ---
    if: lm_trans_emit_l2_table_cell_backing_storages(file, rows_frame, object_name, column_types, column_count, row_count, indent, namespace_) != 0
        return: 1
    if: lm_trans_emit_l2_table_storage(file, rows_frame, object_name, row_type_name, storage_name, column_types, column_names, column_count, row_count, indent, namespace_) != 0
        return: 1
    if: lm_trans_emit_l2_table_pointer(file, row_type_name, object_name, storage_name, indent) != 0
        return: 1
return: 0

fn: lm_trans_validate_l2_join_frame (const: (LmP0Frame: frame)) int
    const: LmP0Structure: sources
    const: LmP0Structure: body
    const: LmP0Text: target_name
    const: LmP0Frame: rows_frame
    @: LmTransL4CallableType column_types
    @: LmP0Text column_names
    size_t: column_count
    size_t: row_count

    if: lm_trans_l2_join_header(frame, @ sources, @ target_name, @ body) != 0 || lm_trans_l2_join_body_rows(body, @ rows_frame) != 0
        return: 1
    c.LM_UNUSED(sources)
    c.LM_UNUSED(target_name)

    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_source_read_columns(body, "join", @ column_types, @ column_names, @ column_count) != 0
        return: 1

    row_count: 0U
    if: rows_frame != 0 && lm_trans_l2_table_row_count(rows_frame, column_count, @ row_count) != 0
        return: 1
return: 0

fn: lm_trans_merge_source_list (const: (LmP0Frame: frame)) const: LmP0Structure
    const: LmP0Field: field

    if: frame = 0 || lm_trans_text_equals(frame\head, "merge") = 0
        return: 0
    field: lm_trans_nth_field(frame\body, 0U)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
return: field\value\as\structure

fn: lm_trans_merge_target_name (const: (LmP0Frame: frame)) const: LmP0Text
    const: LmP0Field: field

    if: frame = 0 || lm_trans_text_equals(frame\head, "merge") = 0
        return: 0
    field: lm_trans_nth_field(frame\body, 1U)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: field\value\as\atom

fn: lm_trans_merge_local_body (const: (LmP0Frame: frame)) const: LmP0Structure
    const: LmP0Field: field

    if: frame = 0
        return: 0
    field: lm_trans_nth_field(frame\body, 2U)
    if: field = 0
        return: 0
    if: field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
return: field\value\as\structure

fn: lm_trans_frame_looks_merge_named_structure_declaration (const: (LmP0Frame: frame)) int
    const: LmP0Structure: sources
    const: LmP0Text: target

    sources: lm_trans_merge_source_list(frame)
    target: lm_trans_merge_target_name(frame)
return: sources != 0 && target != 0 && sources\first_field != 0 && lm_trans_atom_can_be_new_binding_name(target)

fn: lm_trans_merge_add_layout_descriptor_field (
    LmTransDescriptor: descriptor
    const: LmTransLayoutField: field
    size_t: index
) int
    LmP0Text: name
    LmP0Text: payload
    const: @: char payload_source

    if: descriptor = 0 || field = 0 || field\name = 0
        return: 1

    payload_source: field\class_name
    if: field\is_union
        payload_source: field\union_layout_name
    if: payload_source = 0
        return: 1

    name: lm_trans_text_from_cstr(field\name)
    if: name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ name)

    payload: lm_trans_text_from_cstr(payload_source)
    if: payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ payload)

return: lm_trans_descriptor_add_structural_field(descriptor, name, payload, index, field\address_depth, field\array_count, field\has_array_count, field\is_const, field\is_union)

fn: lm_trans_merge_source_layout_name_from_atom_new (
    const: LmP0Text: atom
    const: LmTransNamespace: namespace_
    @@: char out_name
) int
    LmP0Text: payload

    if: out_name != 0
        out_name[0]: 0
    if: atom = 0 || out_name = 0
        return: 0

    payload: lm_trans_statement_text_new()
    if: payload = 0
        return: -1
    finally: lm_trans_text_ref_destroy(@ payload)

    if: lm_trans_identifier_payload(atom, payload) = 0
        return: 0

    if: lm_trans_namespace_layout_source_is_supported(namespace_, payload) = 0 && lm_trans_namespace_has_named_structure_binding(namespace_, payload) = 0
        return: 0

    out_name[0]: lm_trans_text_copy_cstr(payload)
    if: out_name[0] != 0
        return: 1
return: -1

fn: lm_trans_merge_source_layout_name_from_call_new (
    const: LmP0Node: node
    const: LmTransNamespace: namespace_
    @@: char out_name
) int
    LmTransL4CallableType: type
    int: status

    if: out_name != 0
        out_name[0]: 0
    if: node = 0 || out_name = 0
        return: 0

    type: lm_trans_expr_callable_type_new()
    if: type = 0
        return: -1
    finally: lm_trans_expr_callable_type_delete(type)

    status: lm_trans_node_result_type(node, namespace_, type)
    if: status <= 0
        return: status
    if: type\address_depth != 0U || type\is_const
        return: 0

    if: lm_trans_namespace_layout_source_is_supported(namespace_, type\class_name) = 0 && lm_trans_namespace_has_named_structure_binding(namespace_, type\class_name) = 0
        return: 0

    out_name[0]: lm_trans_text_copy_cstr(type\class_name)
    if: out_name[0] != 0
        return: 1
return: -1

fn: lm_trans_merge_push_source_layout_fields (
    LmTransDescriptor: descriptor
    const: @(char layout_name)
    const: LmTransNamespace: namespace_
    @: size_t index
) int
    @: LmTransLayoutField fields
    size_t: field_capacity
    size_t: field_count
    size_t: i

    if: descriptor = 0 || layout_name = 0 || index = 0
        return: 1

    if: lm_trans_validate_layout_occurrence_projection_source(layout_name, namespace_) != 0
        return: 1

    field_capacity: 256U
    fields: lm_trans_layout_fields_new(field_capacity)
    if: fields = 0
        return: 1
    finally: lm_trans_layout_fields_delete(fields, field_capacity)

    if: lm_trans_collect_layout_fields(layout_name, namespace_, fields, field_capacity, @ field_count) != 0 || lm_trans_sort_layout_fields(fields, field_count) != 0
        return: 1

    i: 0U
    while: i < field_count
        if: lm_trans_merge_add_layout_descriptor_field(descriptor, fields[i], index[0]) != 0
            return: 1
        index[0]: index[0] + 1U
        i: i + 1U
return: 0

fn: lm_trans_merge_push_inline_source_fields (
    LmTransDescriptor: descriptor
    const: LmP0Frame: source
    const: LmTransNamespace: namespace_
    @: size_t index
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    LmTransL4CallableType: field_type
    const: LmP0Text: name
    const: LmP0Field: initializer

    if: descriptor = 0 || source = 0 || index = 0 || lm_trans_frame_looks_named_structure_layout_declaration(source, namespace_) = 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    body: lm_trans_named_structure_body(source)
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_named_structure_field_info_for_owner(field\value\as\frame, namespace_, source\head, field_type, @ name, @ initializer) = 0
                return: 1
            if: initializer != 0
                c.fprintf(c.stderr, "trans L2 merge descriptor error: field \"%.*s\" cannot contain an instance initializer; construct a value explicitly\n", (cast: int name\length), name\data)
                return: 1
            if: lm_trans_identifier_same(field_type\class_name, source\head)
                c.fprintf(c.stderr, "trans hosted C backend limitation: inline merge descriptor \"%.*s\" cannot project a self-referential field before that descriptor has a named type projection\n", (cast: int source\head\length), source\head\data)
                return: 1
            if: lm_trans_descriptor_add_structural_field(descriptor, name, field_type\class_name, index[0], field_type\address_depth, 0U, 0, field_type\is_const, 0) != 0
                return: 1
            index[0]: index[0] + 1U
        field: field\next
return: 0

fn: lm_trans_merge_push_source_node_fields (
    LmTransDescriptor: descriptor
    const: LmP0Node: node
    const: LmTransNamespace: namespace_
    @: size_t index
) int
    @: char layout_name
    int: status

    if: descriptor = 0 || node = 0 || index = 0
        return: 1

    layout_name: 0
    finally: lm_own_delete(layout_name, 0)

    status: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        status: lm_trans_merge_source_layout_name_from_atom_new(node\as\atom, namespace_, @ layout_name)
    else:
        if: node\kind = c.LM_P0_NODE_FRAME
            if: lm_trans_frame_looks_named_structure_layout_declaration(node\as\frame, namespace_)
                return: lm_trans_merge_push_inline_source_fields(descriptor, node\as\frame, namespace_, index)
            status: lm_trans_merge_source_layout_name_from_call_new(node, namespace_, @ layout_name)
        else:
            status: lm_trans_merge_source_layout_name_from_call_new(node, namespace_, @ layout_name)

    ---
    if: status < 0
        return: 1
    if: status = 0 || layout_name = 0
        c.fprintf(c.stderr, "trans L2 merge error: source must be a layout atom, inline named structure, or call returning a layout\n")
        return: 1
return: lm_trans_merge_push_source_layout_fields(descriptor, layout_name, namespace_, index)

fn: lm_trans_declare_merge_named_structure_layout_mode (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
    int: reject_hosted_redeclaration
) int
    const: LmP0Structure: sources
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmP0Text: target
    LmTransL4CallableType: field_type
    const: LmP0Text: name
    const: LmP0Field: initializer
    LmTransDescriptor: descriptor
    size_t: index

    if: namespace_ = 0 || frame = 0 || lm_trans_frame_looks_merge_named_structure_declaration(frame) = 0
        c.fprintf(c.stderr, "trans L2 merge error: merge expects (sources...) targetName and an optional body\n")
        return: 1

    target: lm_trans_merge_target_name(frame)
    descriptor: lm_trans_descriptor_new()
    finally: lm_trans_descriptor_delete(descriptor)
    if: descriptor = 0 || lm_trans_descriptor_mark_structural_fields(descriptor) != 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    index: 0U
    sources: lm_trans_merge_source_list(frame)
    field: sources\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: lm_trans_merge_push_source_node_fields(descriptor, field\value, namespace_, @ index) != 0
                return: 1
        ---
        field: field\next

    body: lm_trans_merge_local_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_named_structure_field_info_for_owner(field\value\as\frame, namespace_, target, field_type, @ name, @ initializer) = 0
                return: 1
            if: initializer != 0
                c.fprintf(c.stderr, "trans L2 merge descriptor error: field \"%.*s\" cannot contain an instance initializer; construct a value explicitly\n", (cast: int name\length), name\data)
                return: 1
            if: lm_trans_descriptor_add_structural_field(descriptor, name, field_type\class_name, index, field_type\address_depth, 0U, 0, field_type\is_const, 0) != 0
                return: 1
            index: index + 1U
        field: field\next

    if: reject_hosted_redeclaration && lm_trans_hosted_descriptor_redeclaration_is_unsupported(namespace_, target, descriptor) != 0
        return: 1
    if: lm_trans_bind_named_structure_descriptor(namespace_, target, @ descriptor) != 0
        return: 1
return: 0


fn: lm_trans_declare_merge_named_structure_layout (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
return: lm_trans_declare_merge_named_structure_layout_mode(namespace_, frame, 0)

fn: lm_trans_declare_hosted_merge_named_structure_layout (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
return: lm_trans_declare_merge_named_structure_layout_mode(namespace_, frame, 1)

fn: lm_trans_emit_merge_named_structure_typedef (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    const: LmP0Text: target
    @: char layout_name

    target: lm_trans_merge_target_name(frame)
    if: file = 0 || target = 0
        return: 1

    layout_name: lm_trans_prefixed_identifier_name_new("", target, "")
    if: layout_name = 0
        return: 1
    finally: lm_own_delete(layout_name, 0)

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct ") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "typedef struct ") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct ") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, " {\n") != 0 || lm_trans_emit_layout_fields(file, layout_name, namespace_, indent + 1U) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "};\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_assignment_field_segment (
    FILE: file
    const: LmP0Text: segment
    LmP0Text: current_class
    const: LmTransNamespace: namespace_
) int
    LmP0Text: field_name
    LmP0Text: projected_name_text
    const: LmTransDescriptor: descriptor
    const: LmTransDescriptorField: descriptor_field
    @: char projected_name
    @: char descriptor_field_name
    size_t: occurrence
    size_t: occurrence_count
    int: has_occurrence
    int: status

    field_name: lm_trans_statement_text_new()
    projected_name_text: 0
    projected_name: 0
    descriptor_field_name: 0
    if: field_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ field_name)
    finally: lm_trans_text_ref_destroy(@ projected_name_text)
    finally: lm_own_delete(projected_name, 0)
    finally: lm_own_delete(descriptor_field_name, 0)

    if: lm_trans_field_chain_segment_parse(segment, field_name, @ has_occurrence, @ occurrence) = 0
        if: segment != 0 && segment\length != 0U && segment\data[0] = '['
            c.fprintf(c.stderr, "trans hosted C backend limitation: occurrence-qualified field follow requires a compile-time non-negative decimal ordinal\n")
        else:
            c.fprintf(c.stderr, "trans L2 error: malformed assignment field-follow segment\n")
        return: 1

    status: 0
    if: current_class != 0 && current_class\length != 0U
        status: lm_trans_field_chain_member_resolve(namespace_, current_class, field_name, has_occurrence, occurrence, @ descriptor, @ descriptor_field, @ projected_name)

    if: status < 0
        return: 1
    if: status = 0 && has_occurrence
        occurrence_count: 0U
        descriptor: lm_trans_namespace_descriptor(namespace_, current_class)
        if: descriptor != 0
            descriptor_field_name: lm_trans_descriptor_name_copy(field_name)
            if: descriptor_field_name = 0
                return: 1
            occurrence_count: lm_trans_descriptor_structural_field_occurrence_count(descriptor, descriptor_field_name)
        ---
        c.fprintf(c.stderr, "trans L2 field access error: field \"%.*s\" has no occurrence %zu (matching occurrence count: %zu)\n", (cast: int field_name\length), field_name\data, occurrence, occurrence_count)
        return: 1

    if: status = 0
        if: current_class != 0
            current_class\data: ""
            current_class\length: 0U
        return: lm_trans_emit_identifier(file, field_name)

    projected_name_text: lm_trans_text_from_cstr(projected_name)
    if: projected_name_text = 0 || descriptor_field = 0 || descriptor_field\descriptor_name = 0
        return: 1
    if: lm_trans_emit_identifier(file, projected_name_text) != 0
        return: 1
    if: lm_trans_text_assign_cstr(current_class, descriptor_field\descriptor_name) = 0
        return: 1
return: 0

fn: lm_trans_emit_assignment_target (
    FILE: file
    const: LmP0Text: target
    const: LmTransNamespace: namespace_
) int
    size_t: i
    size_t: close_index
    size_t: deref_depth
    size_t: root_end
    size_t: field_end
    LmP0Text: index_expression
    LmP0Text: target_payload
    LmP0Text: target_path
    LmP0Text: root
    LmP0Text: segment
    LmP0Text: current_class
    int: is_c_reference_path

    index_expression: lm_trans_statement_text_new()
    if: index_expression = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ index_expression)

    target_payload: lm_trans_statement_text_new()
    if: target_payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ target_payload)

    target_path: lm_trans_statement_text_new()
    if: target_path = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ target_path)

    root: lm_trans_statement_text_new()
    if: root = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ root)

    segment: lm_trans_statement_text_new()
    if: segment = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ segment)

    current_class: lm_trans_statement_text_new()
    if: current_class = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ current_class)

    if: lm_trans_identifier_payload(target, target_payload) = 0
        return: 1

    deref_depth: 0U
    while: deref_depth < target_payload\length && target_payload\data[deref_depth] = '\\'
        deref_depth: deref_depth + 1U

    target_path\data: target_payload\data + deref_depth
    target_path\length: target_payload\length - deref_depth
    if: target_path\length = 0U
        c.fprintf(c.stderr, "trans L2 error: dereferenced assignment target expects a binding or field-follow path\n")
        return: 1

    is_c_reference_path: lm_trans_is_c_reference_name(target_path)
    if: is_c_reference_path = 0 && lm_trans_text_contains_char(target_path, '.')
        c.fprintf(c.stderr, "trans L2 error: dot belongs only to c.* ANSI C surface names; use \\ for Lingvamyxa structures\n")
        return: 1

    while: deref_depth > 0U
        if: lm_trans_put(file, "*") != 0
            return: 1
        deref_depth: deref_depth - 1U

    if: target_payload\length != target_path\length && lm_trans_put(file, "(") != 0
        return: 1

    if: is_c_reference_path
        i: 2U
        while: i < target_path\length
            if: target_path\data[i] = '['
                if: lm_trans_array_head_find_close(target_path, i, @ close_index) = 0
                    c.fprintf(c.stderr, "trans L2 error: unclosed index in assignment target\n")
                    return: 1
                index_expression\data: target_path\data + i + 1U
                index_expression\length: close_index - i - 1U
                if: index_expression\length = 0U
                    c.fprintf(c.stderr, "trans L2 error: assignment target index must not be empty\n")
                    return: 1
                if: lm_trans_put(file, "[") != 0 || lm_trans_emit_c_dimension_text(file, index_expression, namespace_, "assignment target index") != 0 || lm_trans_put(file, "]") != 0
                    return: 1
                i: close_index + 1U
                continue
            if: target_path\data[i] = '\\'
                if: lm_trans_put(file, "->") != 0
                    return: 1
                i: i + 1U
                continue
            if: lm_trans_write_all(file, target_path\data + i, 1U) != 0
                return: 1
            i: i + 1U
        ---
    else:
        root_end: 0U
        while: root_end < target_path\length && target_path\data[root_end] != '\\' && target_path\data[root_end] != '['
            root_end: root_end + 1U
        if: root_end = 0U
            c.fprintf(c.stderr, "trans L2 error: assignment target expects a binding before field-follow or indexing\n")
            return: 1
        root\data: target_path\data
        root\length: root_end
        if: lm_trans_emit_expr_atom(file, root, namespace_) != 0
            return: 1
        if: lm_trans_expr_value_class_from_atom(root, namespace_, current_class) = 0
            current_class\data: ""
            current_class\length: 0U
        ---

        i: root_end
        while: i < target_path\length
            if: target_path\data[i] = '['
                if: lm_trans_array_head_find_close(target_path, i, @ close_index) = 0
                    c.fprintf(c.stderr, "trans L2 error: unclosed index in assignment target\n")
                    return: 1
                index_expression\data: target_path\data + i + 1U
                index_expression\length: close_index - i - 1U
                if: index_expression\length = 0U
                    c.fprintf(c.stderr, "trans L2 error: assignment target index must not be empty\n")
                    return: 1
                if: lm_trans_put(file, "[") != 0 || lm_trans_emit_c_dimension_text(file, index_expression, namespace_, "assignment target index") != 0 || lm_trans_put(file, "]") != 0
                    return: 1
                i: close_index + 1U
                continue

            if: target_path\data[i] != '\\'
                c.fprintf(c.stderr, "trans L2 error: malformed assignment field-follow path\n")
                return: 1
            if: lm_trans_put(file, "->") != 0
                return: 1
            i: i + 1U
            if: i >= target_path\length
                c.fprintf(c.stderr, "trans L2 error: assignment field-follow expects a field name\n")
                return: 1

            field_end: i
            if: target_path\data[i] = '['
                if: lm_trans_array_head_find_close(target_path, i, @ close_index) = 0
                    c.fprintf(c.stderr, "trans L2 error: unclosed occurrence selector in assignment target\n")
                    return: 1
                field_end: close_index + 1U
            ---
            while: field_end < target_path\length && target_path\data[field_end] != '\\' && target_path\data[field_end] != '['
                field_end: field_end + 1U
            segment\data: target_path\data + i
            segment\length: field_end - i
            if: lm_trans_emit_assignment_field_segment(file, segment, current_class, namespace_) != 0
                return: 1
            i: field_end
        ---

    if: target_payload\length != target_path\length && lm_trans_put(file, ")") != 0
        return: 1
return: 0

fn: lm_trans_guard_direct_structure_assignment (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: value_field
    const: LmP0Node: candidate_node
    const: LmTransDescriptor: candidate_descriptor
    const: LmTransDescriptor: target_root_descriptor
    const: LmTransDescriptor: required_descriptor
    LmP0Text: target_class
    LmP0Text: target_payload
    LmP0Text: target_root
    size_t: root_start
    size_t: root_end
    int: crosses_indexed_layout
    int: status

    if: frame = 0 || frame\body = 0
        return: 0

    value_field: frame\body\first_field
    if: value_field = 0 || value_field\next != 0 || value_field\value = 0 || value_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    candidate_node: value_field\value

    candidate_descriptor: lm_trans_effective_value_descriptor_from_atom(namespace_, candidate_node\as\atom)
    crosses_indexed_layout: candidate_descriptor != 0 && lm_trans_descriptor_class_relation_value(candidate_descriptor, "lm.trans.c.indexed-members") != 0

    if: crosses_indexed_layout = 0
        target_payload: lm_trans_statement_text_new()
        target_root: lm_trans_statement_text_new()
        if: target_payload = 0 || target_root = 0
            lm_trans_text_ref_destroy(@ target_payload)
            lm_trans_text_ref_destroy(@ target_root)
            return: 1

        if: lm_trans_identifier_payload(frame\head, target_payload)
            root_start: 0U
            while: root_start < target_payload\length && target_payload\data[root_start] = '\\'
                root_start: root_start + 1U
            root_end: root_start
            while: root_end < target_payload\length && target_payload\data[root_end] != '\\' && target_payload\data[root_end] != '['
                root_end: root_end + 1U
            target_root\data: target_payload\data + root_start
            target_root\length: root_end - root_start
            target_root_descriptor: lm_trans_effective_value_descriptor_from_atom(namespace_, target_root)
            crosses_indexed_layout: target_root_descriptor != 0 && lm_trans_descriptor_class_relation_value(target_root_descriptor, "lm.trans.c.indexed-members") != 0
        ---
        lm_trans_text_ref_destroy(@ target_root)
        lm_trans_text_ref_destroy(@ target_payload)
    ---

    if: crosses_indexed_layout = 0
        return: 0

    target_class: lm_trans_statement_text_new()
    if: target_class = 0
        return: 1
    status: 0
    if: lm_trans_expr_value_class_from_atom(frame\head, namespace_, target_class)
        required_descriptor: lm_trans_namespace_descriptor(namespace_, target_class)
        status: lm_trans_guard_direct_structure_value_layout(namespace_, candidate_node\as\atom, required_descriptor, "assignment")
    ---
    lm_trans_text_ref_destroy(@ target_class)
return: status

fn: lm_trans_emit_target_assignment (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    if: lm_trans_guard_direct_structure_assignment(frame, namespace_) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_assignment_target(file, frame\head, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " = ") != 0
        return: 1
    if: lm_trans_emit_expr_fields(file, frame\body\first_field, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_assignment (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    if: lm_trans_guard_direct_structure_assignment(frame, namespace_) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_expr_atom(file, frame\head, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " = ") != 0
        return: 1
    if: lm_trans_emit_expr_fields(file, frame\body\first_field, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_contextual_literal_assignment (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    const: @: char value
    LmP0Text: expected_class
    const: LmP0Structure: body
    const: LmP0Field: target_field
    const: LmP0Node: target_node

    if: frame = 0 || frame\body = 0
        return: 1

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    if: body = 0
        return: 1
    target_field: lm_trans_nth_field(body, 0U)
    if: target_field = 0 || target_field\next != 0 || target_field\value = 0 || target_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: contextual literal assignment expects exactly one target atom\n")
        return: 1

    target_node: target_field\value
    expected_class: lm_trans_statement_text_new()
    if: expected_class = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ expected_class)
    if: lm_trans_expr_value_class_from_atom(target_node\as\atom, namespace_, expected_class) = 0
        c.fprintf(c.stderr, "trans L2 error: contextual literal assignment target \"%.*s\" has no expected class\n", (cast: int target_node\as\atom\length), target_node\as\atom\data)
        return: 1
    value: lm_trans_contextual_literal_value(namespace_, frame\head, expected_class)
    if: value = 0
        c.fprintf(c.stderr, "trans L2 error: contextual literal \"%.*s\" has no value for class \"%.*s\"\n", (cast: int frame\head\length), frame\head\data, (cast: int expected_class\length), expected_class\data)
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_assignment_target(file, target_node\as\atom, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " = ") != 0
        return: 1
    if: lm_trans_put(file, value) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_struct_field_with_qualifier (
    FILE: file
    const: LmP0Node: node
    unsigned: indent
    const: @(char qualifier)
    const: LmTransNamespace: namespace_
) int
    const: LmP0Node: current
    const: LmP0Frame: frame
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Node: name_node
    const: @: char current_qualifier

    current: node
    current_qualifier: qualifier
    while: 1
        if: lm_trans_node_is_ignored(current)
            return: 0

        if: current = 0 || current\kind != c.LM_P0_NODE_FRAME
            c.fprintf(c.stderr, "trans L2 error: structure field must be a named field\n")
            return: 1

        frame: current\as\frame
        if: lm_trans_text_equals(frame\head, "const") = 0
            break
        name_field: frame\body\first_field
        if: name_field = 0 || name_field\next != 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_FRAME
            c.fprintf(c.stderr, "trans L2 error: const structure field expects exactly one field declaration\n")
            return: 1
        current_qualifier: "const "
        current: name_field\value

    if: lm_trans_text_all_char(frame\head, '@')
        type_field: lm_trans_nth_field(frame\body, 0U)
        name_field: lm_trans_nth_field(frame\body, 1U)
        if: type_field = 0 || name_field = 0 || name_field\next != 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: pointer structure field expects type and name\n")
            return: 1
        name_node: name_field\value
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        if: current_qualifier != 0 && lm_trans_put(file, current_qualifier) != 0
            return: 1
        if: lm_trans_emit_type_and_name(file, type_field\value, name_node\as\atom, frame\head\length, namespace_) != 0
            return: 1
        return: lm_trans_put(file, ";\n")

    name_field: lm_trans_nth_field(frame\body, 0U)
    if: name_field = 0 || name_field\next != 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: structure field expects Type: name\n")
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: current_qualifier != 0 && lm_trans_put(file, current_qualifier) != 0
        return: 1
    if: lm_trans_emit_type_head_only(file, frame\head, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_emit_identifier(file, name_field\value\as\atom) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_struct_field (
    FILE: file
    const: LmP0Node: node
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
return: lm_trans_emit_struct_field_with_qualifier(file, node, indent, "", namespace_)

fn: lm_trans_emit_function_return_structure (
    FILE: file
    const: LmP0Text: function_name
    const: LmP0Node: return_node
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: field

    if: return_node = 0 || return_node\kind != c.LM_P0_NODE_STRUCTURE
        c.fprintf(c.stderr, "trans L2 error: fm expects a return Structure\n")
        return: 1

    if: lm_trans_put(file, "typedef struct ") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, ";\n\nstruct ") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, " {\n") != 0
        return: 1

    field: return_node\as\structure\first_field
    if: field = 0
        c.fprintf(c.stderr, "trans L2 error: fm return Structure must not be empty\n")
        return: 1
    while: field != 0
        if: lm_trans_emit_struct_field(file, field\value, 1U, namespace_) != 0
            return: 1
        field: field\next
return: lm_trans_put(file, "};\n\n")

fn: lm_trans_register_function_return_layout (
    const: LmP0Text: owner
    const: LmP0Node: return_node
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    LmTransL4CallableType: field_type
    const: LmP0Text: field_name
    const: LmP0Field: initializer
    size_t: field_index

    if: owner = 0 || return_node = 0 || return_node\kind != c.LM_P0_NODE_STRUCTURE
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    field: return_node\as\structure\first_field
    field_index: 0U
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_named_structure_field_info(field\value\as\frame, namespace_, field_type, @ field_name, @ initializer) = 0
                return: 1
            if: lm_trans_named_structure_push_field_relations(owner, field_name, field_type, field_index) != 0
                return: 1
            field_index: field_index + 1U
        ---
        field: field\next
return: 0

fn: lm_trans_emit_function_return_structure_once (
    FILE: file
    const: LmP0Text: function_name
    const: LmP0Node: return_node
    const: LmTransNamespace: namespace_
) int
    @: char type_name
    LmP0Text: type_name_text
    const: @: char stored_name
    FILE: declaration_file
    int: emitted
    int: status

    type_name: lm_trans_function_return_struct_type_name_new(function_name)
    if: type_name = 0
        return: 1

    declaration_file: c.tmpfile()
    if: declaration_file = 0
        lm_own_delete(type_name, 0)
        return: 1
    status: lm_trans_emit_function_return_structure(declaration_file, function_name, return_node, namespace_)
    if: status = 0
        status: lm_trans_typedef_projection_emit_prepared_cstr(file, type_name, declaration_file, @ emitted)
    c.fclose(declaration_file)
    if: status != 0
        lm_own_delete(type_name, 0)
        return: 1

    stored_name: lm_trans_string_stack_find(lm_trans_emitted_function_return_structs, type_name)
    if: stored_name != 0
        lm_own_delete(type_name, 0)
        return: 0

    type_name_text: lm_trans_text_from_cstr(type_name)
    if: type_name_text = 0
        lm_own_delete(type_name, 0)
        return: 1
    if: lm_trans_register_function_return_layout(type_name_text, return_node, namespace_) != 0
        lm_trans_text_ref_destroy(@ type_name_text)
        lm_own_delete(type_name, 0)
        return: 1
    lm_trans_text_ref_destroy(@ type_name_text)

    if: lm_own_ptr_stack_push(lm_trans_emitted_function_return_structs, type_name) != 0
        lm_own_delete(type_name, 0)
        return: 1
return: 0

sub: lm_trans_statement_stack_destroy (LmTransStatementStack: stack)
    if: stack != 0
        lm_trans_ptr_stack_delete(@ stack\jobs)
end: lm_trans_statement_stack_destroy

fn: lm_trans_statement_stack_push (LmTransStatementStack: stack; LmTransStatementJob: job) int
    if: stack = 0 || stack\jobs = 0 || job = 0
        return: 1
return: lm_own_ptr_stack_push(stack\jobs, job)

fn: lm_trans_statement_stack_push_list (
    LmTransStatementStack: stack
    const: LmP0Field: field
    unsigned: indent
    int: unwrap_single_structure
    const: LmP0Frame: repeat_frame
) int
    LmTransStatementJob: job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: @lm_trans_statement_job_emit_list
    job\destroy: @lm_trans_statement_job_destroy_list
    job\list: (cast: (LmTransStatementListJob) lm_own_new_zero(c.sizeof(job\list[0])))
    if: job\list = 0
        lm_trans_statement_job_delete(job)
        return: 1
    job\list\field: field
    job\list\indent: indent
    job\list\unwrap_single_structure: unwrap_single_structure
    job\list\repeat_frame: repeat_frame
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

