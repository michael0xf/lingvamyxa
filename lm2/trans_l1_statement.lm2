        return: 1
    finally:
        lm_trans_text_ref_destroy(@ slot_name)
        lm_trans_text_ref_destroy(@ value_name)
        lm_own_delete(value_name_storage, 0)

    if: lm_trans_named_structure_uses_graph_header(namespace_, frame\head)
        if: lm_trans_emit_structure_graph_header(lm_trans_prelude_file(file)) != 0
            return: 1
        if: lm_trans_put(file, "    ") != 0 || lm_trans_emit_projected_type_name(file, frame\head, namespace_) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, " = ") != 0
            return: 1
        if: lm_trans_frame_looks_named_structure_construction(frame, namespace_) || initializer = 0
            if: lm_trans_emit_graph_structure_new(file, frame\head, thread_name, arena_name, value_name) != 0 || lm_trans_put(file, ";\n") != 0
                return: 1
            if: lm_trans_put(file, "    if (") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, " == 0) return 1;\n") != 0
                return: 1
            if: lm_trans_frame_looks_named_structure_construction(frame, namespace_)
                descriptor: lm_trans_namespace_descriptor(namespace_, frame\head)
                if: descriptor = 0 || lm_trans_descriptor_payload_is_empty(descriptor) = 0 && lm_trans_emit_named_structure_construction_initializer(file, frame, value_name, descriptor, 1U, namespace_) != 0
                    return: 1
                ---
            ---
        else:
            expected_type: lm_trans_expr_callable_type_new()
            if: expected_type = 0
                return: 1
            expected_type\class_name[0]: frame\head[0]
            if: lm_trans_emit_expr_range_with_expected_type(file, initializer, 0, namespace_, expected_type) != 0 || lm_trans_put(file, ";\n") != 0
                lm_trans_expr_callable_type_delete(expected_type)
                return: 1
            lm_trans_expr_callable_type_delete(expected_type)
        ---
    else:
        if: lm_trans_put(file, "    ") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, " = ") != 0
            return: 1
        if: lm_trans_frame_looks_named_structure_construction(frame, namespace_) || initializer = 0
            if: lm_trans_put(file, "(") != 0 || lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " *)lm_own_arena_new_zero(") != 0 || lm_trans_put(file, thread_name) != 0 || lm_trans_put(file, ", ") != 0 || lm_trans_put(file, arena_name) != 0 || lm_trans_put(file, ", sizeof(*") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, "));\n") != 0
                return: 1
            if: lm_trans_put(file, "    if (") != 0 || lm_trans_emit_identifier(file, value_name) != 0 || lm_trans_put(file, " == 0) return 1;\n") != 0
                return: 1
            if: lm_trans_frame_looks_named_structure_construction(frame, namespace_)
                descriptor: lm_trans_namespace_descriptor(namespace_, frame\head)
                if: descriptor = 0 || lm_trans_emit_named_structure_construction_initializer(file, frame, value_name, descriptor, 1U, namespace_) != 0
