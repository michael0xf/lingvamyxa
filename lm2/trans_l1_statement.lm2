        status: 1

    if: status != 0
        lm_trans_ptr_stack_delete(@ lm_trans_registry\binding_pointer_bindings)
return: status

fn: lm_trans_pointer_binding_find (const: @: char name) const: LmTransPointerBinding
    size_t: i
    const: LmTransPointerBinding: binding
    const: LmOwnPtrStack: bindings

    if: lm_trans_registry = 0 || name = 0
        return: 0
    bindings: lm_trans_registry\binding_pointer_bindings
    if: bindings = 0
        return: 0

    i: 0U
    while: i < bindings\count
        binding: (cast: (const: LmTransPointerBinding) lm_own_ptr_stack_at(bindings, i))
        if: binding != 0 && binding\name != 0 && c.strcmp(binding\name, name) = 0
            return: binding
        i: i + 1U
return: 0

fn: lm_trans_binding_resolve (
    const: @: char binding
    LmTransBinding: out
) int
    const: LmTransPointerBinding: resolved

    if: out = 0
        return: 0

    c.memset(out, 0, c.sizeof(out[0]))
    if: binding = 0 || lm_trans_pointer_bindings_init() != 0
        return: 0

    resolved: lm_trans_pointer_binding_find(binding)
    if: resolved = 0 || resolved\value = 0
        return: 0
    out[0]: resolved\value[0]
return: 1

fn: lm_trans_function_header_from_frame (
    const: LmP0Frame: frame
    int: is_external
    LmTransFunctionHeader: out
) int
    LmTransHeadBinding: binding

    if: frame = 0 || out = 0
        return: 0

    binding: lm_trans_statement_head_binding_new()
    if: binding = 0
        return: -1
    finally: lm_own_delete(binding, 0)

    if: lm_trans_head_binding_resolve(0, frame\head, binding) != 0
        return: -1
    if: binding\function_receiver = 0
        return: 0
return: binding\function_receiver(frame, is_external, out)

fn: lm_trans_top_level_function_header (
    const: LmP0Frame: frame
    LmTransFunctionHeader: out
) int
    const: LmP0Field: field
    const: LmP0Frame: inner
    int: status

    if: frame = 0 || out = 0
        return: 0

    status: lm_trans_function_header_from_frame(frame, 0, out)
    if: status != 0
        return: status
    if: lm_trans_text_equals(frame\head, "external") = 0
        return: 0

    field: frame\body\first_field
    if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
        c.fprintf(c.stderr, "trans L2 error: external receiver expects exactly one fn/sub frame\n")
        return: -1

    inner: field\value\as\frame
    status: lm_trans_function_header_from_frame(inner, 1, out)
    if: status != 0
        return: status

    c.fprintf(c.stderr, "trans L2 error: external receiver expects fn/sub frame\n")
return: -1

fn: lm_trans_hoisted_c_name_new (
    const: LmP0Text: parent_name
    const: LmP0Text: child_name
    unsigned: nested_level
    size_t: index
) @: char
    @: char name
    int: needed

    if: parent_name = 0 || child_name = 0
        return: 0
    needed: c.snprintf(0, 0, "lm_lmx_nested_l%u_parent_%.*s_child_%.*s_i%zu", nested_level, (cast: int parent_name\length), parent_name\data, (cast: int child_name\length), child_name\data, index)
    if: needed < 0
        return: 0

    name: (cast: (@: char) lm_own_new_zero((cast: size_t needed) + 1U))
    if: name = 0
        return: 0
    if: c.snprintf(name, (cast: size_t needed) + 1U, "lm_lmx_nested_l%u_parent_%.*s_child_%.*s_i%zu", nested_level, (cast: int parent_name\length), parent_name\data, (cast: int child_name\length), child_name\data, index) != needed
        lm_own_delete(name, 0)
        return: 0
return: name

fn: lm_trans_hoisted_suffix_name_new (
    const: LmP0Text: base_name
    const: @: char suffix
) @: char
    @: char name
    const: @: char effective_suffix
    int: needed

    if: base_name = 0
        return: 0
    effective_suffix: suffix
    if: effective_suffix = 0
        effective_suffix: ""

    needed: c.snprintf(0, 0, "%.*s%s", (cast: int base_name\length), base_name\data, effective_suffix)
    if: needed < 0
        return: 0

    name: (cast: (@: char) lm_own_new_zero((cast: size_t needed) + 1U))
    if: name = 0
        return: 0
    if: c.snprintf(name, (cast: size_t needed) + 1U, "%.*s%s", (cast: int base_name\length), base_name\data, effective_suffix) != needed
        lm_own_delete(name, 0)
        return: 0
return: name

fn: lm_trans_captured_expr_new (const: (LmP0Text: name)) @: char
    @: char text
    int: needed

    if: name = 0
        return: 0
    needed: c.snprintf(0, 0, "lm_env->%.*s", (cast: int name\length), name\data)
    if: needed < 0
        return: 0

    text: (cast: (@: char) lm_own_new_zero((cast: size_t needed) + 1U))
    if: text = 0
        return: 0
    if: c.snprintf(text, (cast: size_t needed) + 1U, "lm_env->%.*s", (cast: int name\length), name\data) != needed
        lm_own_delete(text, 0)
        return: 0
return: text

fn: lm_trans_env_arg_new (const: (LmP0Text: env_var_name)) @: char
    @: char text
    int: needed

    if: env_var_name = 0
        return: 0
    needed: c.snprintf(0, 0, "%.*s", (cast: int env_var_name\length), env_var_name\data)
    if: needed < 0
        return: 0

    text: (cast: (@: char) lm_own_new_zero((cast: size_t needed) + 1U))
    if: text = 0
        return: 0
    if: c.snprintf(text, (cast: size_t needed) + 1U, "%.*s", (cast: int env_var_name\length), env_var_name\data) != needed
        lm_own_delete(text, 0)
        return: 0
return: text

fn: lm_trans_capture_stack_find (
    const: LmOwnPtrStack: captures
    const: LmP0Text: name
) const: LmTransCapture
    size_t: i
    const: LmTransCapture: capture

    if: captures = 0
        return: 0

    i: 0U
    while: i < captures\count
        capture: (cast: (const: LmTransCapture) lm_own_ptr_stack_at(captures, i))
        if: capture != 0 && lm_trans_identifier_same(capture\name, name)
            return: capture
        i: i + 1U
return: 0

fn: lm_trans_capture_stack_add_copy (
    LmOwnPtrStack: captures
    const: LmTransCapture: source
) int
    LmTransCapture: copy

    if: captures = 0 || source = 0
        return: 1
    if: lm_trans_capture_stack_find(captures, source\name) != 0
        return: 0

    copy: lm_trans_capture_new(source\name, source\type_head, source\type_node, source\pointer_depth, source\type_is_head)
    if: copy = 0
        return: 1
    if: lm_own_ptr_stack_push(captures, copy) != 0
        lm_trans_capture_destroy(copy)
        return: 1
return: 0

fn: lm_trans_local_name_stack_has (
    const: LmOwnPtrStack: names
    const: LmP0Text: name
) int
    size_t: i
    const: LmP0Text: stored

    if: names = 0
        return: 0

    i: 0U
    while: i < names\count
        stored: (cast: (const: LmP0Text) lm_own_ptr_stack_at(names, i))
        if: stored != 0 && lm_trans_identifier_same(stored, name)
            return: 1
        i: i + 1U
return: 0

fn: lm_trans_local_name_stack_add (
    LmOwnPtrStack: names
    const: LmP0Text: name
) int
    LmP0Text: copy

    if: names = 0
        return: 1
    if: lm_trans_local_name_stack_has(names, name)
        return: 0
    copy: lm_trans_text_ref_new(name)
    if: copy = 0
        return: 1
    if: lm_own_ptr_stack_push(names, copy) != 0
        lm_trans_text_ref_delete_any(copy)
        return: 1
return: 0

fn: lm_trans_capture_from_decl_frame (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
    LmTransCapture: out
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Frame: current
    LmTransCDeclarator: array_declarator
    size_t: c_array_element_depth
    size_t: c_array_rank

    if: frame = 0 || out = 0
        return: 0

    current: frame
    while: lm_trans_text_equals(current\head, "const")
        field: current\body\first_field
        if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
            return: 0
        current: field\value\as\frame

    body: lm_trans_unwrap_single_anonymous_structure(current\body)

    if: lm_trans_text_equals(current\head, "c.array")
        if: lm_trans_capture_reset(out) != 0
            return: 0
        if: lm_trans_c_array_declaration_name(current, namespace_, out\name, @ c_array_rank, @ c_array_element_depth) != 0
            return: 0
        c.LM_UNUSED(c_array_rank)
        c.LM_UNUSED(c_array_element_depth)
        out\type_head[0]: current\head[0]
        out\type_is_head: 1
        return: 1
    ---

    if: lm_trans_text_equals(current\head, "()")
        name_field: lm_trans_l2_structure_first_present_field(body)
        if: (current\flags & c.LM_P0_FRAME_COLON) = 0U || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM || lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom) = 0
            return: 0
        if: lm_trans_capture_reset(out) != 0
            return: 0
        out\name[0]: name_field\value\as\atom[0]
        out\type_head[0]: current\head[0]
        out\type_is_head: 1
        return: 1
    ---

    if: lm_trans_head_can_declare_storage(current\head, namespace_)
        name_field: lm_trans_nth_field(body, 0U)
        if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        if: lm_trans_capture_reset(out) != 0
            return: 0
        out\name[0]: name_field\value\as\atom[0]
        out\type_head[0]: current\head[0]
        out\type_is_head: 1
        return: 1

    if: lm_trans_text_all_char(current\head, '@')
        type_field: lm_trans_nth_field(body, 0U)
        name_field: lm_trans_nth_field(body, 1U)
        if: type_field = 0 || name_field = 0 || type_field\value = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        if: lm_trans_capture_reset(out) != 0
            return: 0
        out\name[0]: name_field\value\as\atom[0]
        out\type_node: type_field\value
        out\pointer_depth: current\head\length
        return: 1

    if: lm_trans_text_is_array_receiver_head(current\head)
        array_declarator: lm_trans_statement_c_declarator_new()
        if: array_declarator = 0
            return: 0
        if: lm_trans_array_declarator_read_from_frame(array_declarator, current, namespace_, 1, 1, 1, 0, 0, 0) != 0 || lm_trans_capture_reset(out) != 0
            lm_trans_statement_c_declarator_destroy(array_declarator)
            return: 0
        out\name[0]: array_declarator\name[0]
        out\type_head[0]: current\head[0]
        out\type_is_head: 1
        lm_trans_statement_c_declarator_destroy(array_declarator)
        return: 1
return: 0

fn: lm_trans_capture_candidates_add_decl (
    LmOwnPtrStack: candidates
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    LmTransCapture: capture
    LmTransCapture: stored

    capture: lm_trans_statement_capture_new()
    if: capture = 0
        return: 1
    finally: lm_trans_capture_destroy(capture)

    if: lm_trans_capture_from_decl_frame(frame, namespace_, capture) = 0
        return: 0
    if: lm_trans_capture_stack_find(candidates, capture\name) != 0
        return: 0

    stored: lm_trans_capture_new(capture\name, capture\type_head, capture\type_node, capture\pointer_depth, capture\type_is_head)
    if: stored = 0
        return: 1
    if: lm_own_ptr_stack_push(candidates, stored) != 0
        lm_trans_capture_destroy(stored)
        return: 1
return: 0

fn: lm_trans_capture_candidates_add_array_repeat (
    LmOwnPtrStack: candidates
    const: LmP0Frame: template_frame
    const: LmP0Structure: body
    const: LmTransNamespace: namespace_
) int
    const: LmP0Structure: repeat_body
    const: LmP0Field: name_field
    LmTransCapture: stored

    if: candidates = 0 || template_frame = 0 || lm_trans_text_is_array_receiver_head(template_frame\head) = 0
        return: 1
    repeat_body: lm_trans_unwrap_single_anonymous_structure(body)
    name_field: 0
    if: repeat_body != 0
        name_field: repeat_body\first_field
    if: name_field != 0 && name_field\next != 0 && name_field\value != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_head_can_declare_storage(name_field\value\as\atom, namespace_)
        name_field: name_field\next
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    if: lm_trans_capture_stack_find(candidates, name_field\value\as\atom) != 0
        return: 0

    stored: lm_trans_capture_new(name_field\value\as\atom, template_frame\head, 0, 0U, 1)
    if: stored = 0
        return: 1
    if: lm_own_ptr_stack_push(candidates, stored) != 0
        lm_trans_capture_destroy(stored)
        return: 1
return: 0

fn: lm_trans_capture_candidates_add_formal_param (
    LmOwnPtrStack: candidates
    const: LmTransFormalParam: param
) int
    LmTransCapture: stored
    LmP0Text: array_type

    if: candidates = 0 || param = 0 || param\has_name = 0 || param\type = 0
        return: 0
    if: lm_trans_capture_stack_find(candidates, param\name) != 0
        return: 0

    if: param\is_array
        array_type: lm_trans_text_ref_new_cstr("[]")
        if: array_type = 0
            return: 1
        stored: lm_trans_capture_new(param\name, array_type, 0, 0U, 1)
        lm_trans_text_ref_destroy(@ array_type)
    else:
        stored: lm_trans_capture_new(param\name, param\type\class_name, 0, param\type\address_depth, 1)
    ---
    if: stored = 0
        return: 1
    if: lm_own_ptr_stack_push(candidates, stored) != 0
        lm_trans_capture_destroy(stored)
        return: 1
return: 0

fn: lm_trans_capture_candidates_add_params (
    LmOwnPtrStack: candidates
    const: LmTransFormalParamList: params
) int
    size_t: index

    if: params = 0
        return: 0

    index: 0U
    while: index < params\count
        if: lm_trans_capture_candidates_add_formal_param(candidates, params\params[index]) != 0
            return: 1
        index: index + 1U
return: 0

fn: lm_trans_capture_candidates_add_captures (
    LmOwnPtrStack: candidates
    const: LmOwnPtrStack: captures
) int
    size_t: i
    const: LmTransCapture: capture

    if: captures = 0
        return: 0

    i: 0U
    while: i < captures\count
        capture: (cast: (const: LmTransCapture) lm_own_ptr_stack_at(captures, i))
        if: capture != 0 && lm_trans_capture_stack_add_copy(candidates, capture) != 0
            return: 1
        i: i + 1U
return: 0

fn: lm_trans_collect_local_names_from_fields (
    LmOwnPtrStack: names
    const: LmP0Field: field
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: current

    current: field
    while: current != 0
        if: lm_trans_collect_local_names_from_node(names, current\value, namespace_) != 0
            return: 1
        current: current\next
return: 0

fn: lm_trans_collect_local_names_from_frame (
    LmOwnPtrStack: names
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    LmTransFunctionHeader: nested
    LmTransCapture: capture
    const: LmP0Field: first_field
    int: status

    nested: lm_trans_statement_function_header_new()
    if: nested = 0
        return: 1
    finally: lm_trans_function_header_destroy(nested)

    capture: lm_trans_statement_capture_new()
    if: capture = 0
        return: 1
    finally: lm_trans_capture_destroy(capture)

    if: frame != 0 && lm_trans_local_name_stack_has(names, frame\head) = 0
        status: lm_trans_function_header_from_frame(frame, 0, nested)
        if: status < 0
            return: 1
        if: status > 0
            return: 0

    ---
    if: lm_trans_capture_from_decl_frame(frame, namespace_, capture)
        return: lm_trans_local_name_stack_add(names, capture\name)

    first_field: 0
    if: frame != 0
        first_field: frame\body\first_field
return: lm_trans_collect_local_names_from_fields(names, first_field, namespace_)

fn: lm_trans_collect_local_names_from_node (
    LmOwnPtrStack: names
    const: LmP0Node: node
    const: LmTransNamespace: namespace_
) int
    if: node = 0 || lm_trans_node_is_ignored(node)
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME
        return: lm_trans_collect_local_names_from_frame(names, node\as\frame, namespace_)
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: lm_trans_collect_local_names_from_fields(names, node\as\structure\first_field, namespace_)
return: 0

fn: lm_trans_collect_capture_uses_from_fields (
    LmOwnPtrStack: captures
    const: LmOwnPtrStack: candidates
    const: LmOwnPtrStack: local_names
    const: LmP0Field: field
) int
    const: LmP0Field: current

    current: field
    while: current != 0
        if: lm_trans_collect_capture_uses_from_node(captures, candidates, local_names, current\value) != 0
            return: 1
        current: current\next
return: 0

fn: lm_trans_collect_capture_use_from_atom (
    LmOwnPtrStack: captures
    const: LmOwnPtrStack: candidates
    const: LmOwnPtrStack: local_names
    const: LmP0Text: atom
) int
    const: LmTransCapture: candidate
    LmP0Text: root
    size_t: offset
    size_t: occurrence
    int: has_occurrence
    int: segment_status
    int: status

    if: atom = 0
        return: 0

    root: lm_trans_text_ref_new(atom)
    if: root = 0
        return: 1
    if: lm_trans_text_contains_char(atom, '\\')
        offset: 0U
        segment_status: lm_trans_head_next_field_chain_segment(atom, @ offset, root, @ has_occurrence, @ occurrence)
        if: segment_status <= 0
            lm_trans_text_ref_destroy(@ root)
            return: 1
        if: has_occurrence
            lm_trans_text_ref_destroy(@ root)
            return: 0
    ---

    status: 0
    candidate: lm_trans_capture_stack_find(candidates, root)
    if: candidate != 0 && lm_trans_local_name_stack_has(local_names, root) = 0
        if: candidate\type_is_head && lm_trans_text_equals(candidate\type_head, "()")
            c.fprintf(c.stderr, "trans hosted C backend limitation: capture of local anonymous Structure \"%.*s\" requires hoisted structural type projection\n", (cast: int candidate\name\length), candidate\name\data)
            status: 1
        else:
            if: candidate\type_is_head && lm_trans_text_is_array_receiver_head(candidate\type_head)
                c.fprintf(c.stderr, "trans hosted ArrayReference limitation: capture of ArrayReference \"%.*s\" requires hoisted shape metadata\n", (cast: int candidate\name\length), candidate\name\data)
                status: 1
            else:
                if: candidate\type_is_head && lm_trans_text_equals(candidate\type_head, "c.array")
                    c.fprintf(c.stderr, "trans hosted C backend limitation: capture of local c.array storage \"%.*s\" requires an explicit raw-lifetime adapter\n", (cast: int candidate\name\length), candidate\name\data)
                    status: 1
                else:
                    status: lm_trans_capture_stack_add_copy(captures, candidate)
                ---
            ---
        ---
    ---
    lm_trans_text_ref_destroy(@ root)
return: status

fn: lm_trans_collect_capture_uses_from_frame (
    LmOwnPtrStack: captures
    const: LmOwnPtrStack: candidates
    const: LmOwnPtrStack: local_names
    const: LmP0Frame: frame
) int
    LmTransFunctionHeader: nested
    const: LmP0Field: first_field
    int: status

    nested: lm_trans_statement_function_header_new()
    if: nested = 0
        return: 1
    finally: lm_trans_function_header_destroy(nested)

    if: frame != 0 && lm_trans_local_name_stack_has(local_names, frame\head) = 0
        status: lm_trans_function_header_from_frame(frame, 0, nested)
        if: status < 0
            return: 1
        if: status > 0
            return: 0

    ---
    if: frame != 0 && lm_trans_collect_capture_use_from_atom(captures, candidates, local_names, frame\head) != 0
        return: 1

    first_field: 0
    if: frame != 0
        first_field: frame\body\first_field
return: lm_trans_collect_capture_uses_from_fields(captures, candidates, local_names, first_field)

fn: lm_trans_collect_capture_uses_from_node (
    LmOwnPtrStack: captures
    const: LmOwnPtrStack: candidates
    const: LmOwnPtrStack: local_names
    const: LmP0Node: node
) int
    if: node = 0 || lm_trans_node_is_ignored(node)
        return: 0

    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_collect_capture_use_from_atom(captures, candidates, local_names, node\as\atom)

    if: node\kind = c.LM_P0_NODE_FRAME
        return: lm_trans_collect_capture_uses_from_frame(captures, candidates, local_names, node\as\frame)
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: lm_trans_collect_capture_uses_from_fields(captures, candidates, local_names, node\as\structure\first_field)
return: 0

fn: lm_trans_analyze_function_captures (
    LmTransHoistedFunction: hoisted
    const: LmOwnPtrStack: candidates
    const: LmTransNamespace: namespace_
) int
    LmOwnPtrStack: local_names
    LmTransFormalParam: param
    size_t: index
    int: status

    if: hoisted = 0
        return: 1

    local_names: lm_trans_ptr_stack_new(lm_trans_text_ref_delete_any)
    if: local_names = 0
        return: 1
    finally: lm_trans_ptr_stack_delete(@ local_names)

    status: 0
    if: hoisted\function\params != 0
        index: 0U
        while: status = 0 && index < hoisted\function\params\count
            param: hoisted\function\params\params[index]
            if: param != 0 && param\has_name
                status: lm_trans_local_name_stack_add(local_names, param\name)
            index: index + 1U
    ---
    if: status = 0
        status: lm_trans_collect_local_names_from_fields(local_names, hoisted\function\body_start, namespace_)
    if: status = 0
        status: lm_trans_collect_capture_uses_from_fields(hoisted\captures, candidates, local_names, hoisted\function\body_start)
return: status

fn: lm_trans_collect_hoisted_functions_from_fields (
    LmOwnPtrStack: hoisted_functions
    const: LmP0Text: parent_c_name
    unsigned: nested_level
    LmOwnPtrStack: candidates
    const: LmTransNamespace: namespace_
    const: LmP0Field: field
) int
    const: LmP0Field: current
    const: LmP0Node: node
    const: LmP0Frame: repeat_frame
    LmP0Frame: repeated_frame
    int: status

    current: field
    repeat_frame: 0
    while: current != 0
        node: current\value
        if: node != 0 && node\kind = c.LM_P0_NODE_STRUCTURE && repeat_frame != 0
            if: lm_trans_text_is_array_receiver_head(repeat_frame\head)
                status: lm_trans_capture_candidates_add_array_repeat(candidates, repeat_frame, node\as\structure, namespace_)
            else:
                repeated_frame: lm_trans_statement_frame_new()
                if: repeated_frame = 0
                    return: 1
                repeated_frame\head: repeat_frame\head
                repeated_frame\flags: c.LM_P0_FRAME_COMPACT
                repeated_frame\body: node\as\structure
                status: lm_trans_collect_hoisted_functions_from_frame(hoisted_functions, parent_c_name, nested_level, candidates, namespace_, repeated_frame)
                lm_own_delete(repeated_frame, 0)
            ---
            if: status != 0
                return: 1
            ---
        else:
            if: lm_trans_collect_hoisted_functions_from_node(hoisted_functions, parent_c_name, nested_level, candidates, namespace_, node) != 0
                return: 1
            ---
        if: node != 0 && node\kind = c.LM_P0_NODE_FRAME
            if: lm_trans_statement_frame_is_repeatable(node\as\frame, namespace_)
                repeat_frame: node\as\frame
            else:
                repeat_frame: 0
            ---
        else:
            if: node = 0 || node\kind != c.LM_P0_NODE_STRUCTURE
                repeat_frame: 0
            ---
        current: current\next
return: 0

fn: lm_trans_hoisted_function_from_header (
    const: LmP0Text: parent_c_name
    unsigned: nested_level
    size_t: index
    const: LmP0Frame: frame
    const: LmTransFunctionHeader: function
) LmTransHoistedFunction
    LmTransHoistedFunction: hoisted
    LmTransHoistedFunction: result
    @: char c_name
    @: char closure_call_name

    if: function = 0
        return: 0

    c_name: 0
    closure_call_name: 0
    hoisted: 0
    result: 0
    finally: lm_own_delete(c_name, 0)
    finally: lm_own_delete(closure_call_name, 0)
    finally: lm_trans_hoisted_function_destroy(hoisted)

    c_name: lm_trans_hoisted_c_name_new(parent_c_name, function\name, nested_level, index)
    if: c_name = 0
        return: 0
    closure_call_name: lm_trans_hoisted_suffix_name_new(lm_trans_text_from_cstr(c_name), "_closure_call")
    if: closure_call_name = 0
        return: 0

    hoisted: (cast: (LmTransHoistedFunction) lm_own_new_zero(c.sizeof(hoisted[0])))
    if: hoisted = 0
        return: 0
    hoisted\env_var_name: lm_trans_text_ref_new_cstr("")
    hoisted\closure_call_name: lm_trans_text_ref_new_cstr("")
    if: hoisted\env_var_name = 0 || hoisted\closure_call_name = 0
        return: 0

    hoisted\c_name_storage: c_name
    c_name: 0
    hoisted\closure_call_storage: closure_call_name
    closure_call_name: 0

    hoisted\function: lm_trans_function_header_new()
    if: hoisted\function = 0 || lm_trans_function_header_copy(hoisted\function, function) != 0
        return: 0
    hoisted\function\frame: frame
    lm_trans_text_assign_cstr(hoisted\function\c_name, hoisted\c_name_storage)
    hoisted\function\is_external: 0
    hoisted\function\declare_self_alias: 1
    hoisted\captures: lm_trans_ptr_stack_new(lm_trans_capture_delete_any)
    if: hoisted\captures = 0
        return: 0
    lm_trans_text_assign_cstr(hoisted\closure_call_name, hoisted\closure_call_storage)

    result: hoisted
    hoisted: 0
return: result

fn: lm_trans_hoisted_function_finalize_captures (
    LmTransHoistedFunction: hoisted
    const: LmOwnPtrStack: candidates
    const: LmTransNamespace: namespace_
) int
    @: char env_type_name
    @: char env_var_name

    env_type_name: 0
    env_var_name: 0
    finally: lm_own_delete(env_type_name, 0)
    finally: lm_own_delete(env_var_name, 0)

    if: lm_trans_analyze_function_captures(hoisted, candidates, namespace_) != 0
        return: 1

    if: hoisted\captures\count > 0U
        env_type_name: lm_trans_hoisted_suffix_name_new(hoisted\function\c_name, "Env")
        env_var_name: lm_trans_hoisted_suffix_name_new(hoisted\function\c_name, "_env")
        if: env_type_name = 0 || env_var_name = 0
            return: 1
        hoisted\env_type_storage: env_type_name
        env_type_name: 0
        hoisted\env_var_storage: env_var_name
        env_var_name: 0
        lm_trans_text_assign_cstr(hoisted\env_var_name, hoisted\env_var_storage)
        lm_trans_text_assign_cstr(hoisted\function\env_type_name, hoisted\env_type_storage)
        hoisted\function\captures: hoisted\captures
        hoisted\function\has_env: 1

return: 0

fn: lm_trans_collect_hoisted_function (
    LmOwnPtrStack: hoisted_functions
    const: LmP0Text: parent_c_name
    unsigned: nested_level
    const: LmOwnPtrStack: candidates
    const: LmTransNamespace: namespace_
    const: LmP0Frame: frame
    const: LmTransFunctionHeader: function
) int
    LmTransHoistedFunction: hoisted
    size_t: index

    if: function != 0 && function\is_thread_handler
        c.fprintf(c.stderr, "trans L2 error: thread declarations are top-level only\n")
        return: 1
    if: function = 0 || function\is_descriptor_only
        c.fprintf(c.stderr, "trans L2 error: nested descriptor-only fn is not supported yet\n")
        return: 1

    hoisted: 0
    finally: lm_trans_hoisted_function_destroy(hoisted)

    index: 0U
    if: hoisted_functions != 0
        index: hoisted_functions\count

    hoisted: lm_trans_hoisted_function_from_header(parent_c_name, nested_level, index, frame, function)
    if: hoisted = 0
        return: 1

    if: lm_trans_hoisted_function_finalize_captures(hoisted, candidates, namespace_) != 0
        return: 1

    if: lm_own_ptr_stack_push(hoisted_functions, hoisted) != 0
        return: 1
    hoisted: 0
return: 0

fn: lm_trans_collect_hoisted_functions_from_frame (
    LmOwnPtrStack: hoisted_functions
    const: LmP0Text: parent_c_name
    unsigned: nested_level
    LmOwnPtrStack: candidates
    const: LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
    LmTransFunctionHeader: function
    LmTransCapture: ignored_capture
    const: LmP0Field: first_field
    size_t: scope_base
    int: status

    function: lm_trans_statement_function_header_new()
    if: function = 0
        return: 1
    finally: lm_trans_function_header_destroy(function)

    ignored_capture: lm_trans_statement_capture_new()
    if: ignored_capture = 0
        return: 1
    finally: lm_trans_capture_destroy(ignored_capture)

    if: frame != 0 && lm_trans_capture_stack_find(candidates, frame\head) = 0
        status: lm_trans_function_header_from_frame(frame, 0, function)
        if: status < 0
            return: 1
        if: status > 0
            return: lm_trans_collect_hoisted_function(hoisted_functions, parent_c_name, nested_level, candidates, namespace_, frame, function)

    ---
    if: lm_trans_capture_from_decl_frame(frame, namespace_, ignored_capture)
        return: lm_trans_capture_candidates_add_decl(candidates, frame, namespace_)

    scope_base: 0U
    if: candidates != 0
        scope_base: candidates\count
    first_field: 0
    if: frame != 0
        first_field: frame\body\first_field
    status: lm_trans_collect_hoisted_functions_from_fields(hoisted_functions, parent_c_name, nested_level, candidates, namespace_, first_field)
    lm_own_ptr_stack_truncate(candidates, scope_base)
return: status

fn: lm_trans_collect_hoisted_functions_from_node (
    LmOwnPtrStack: hoisted_functions
    const: LmP0Text: parent_c_name
    unsigned: nested_level
    LmOwnPtrStack: candidates
    const: LmTransNamespace: namespace_
    const: LmP0Node: node
) int
    size_t: scope_base
    int: status

    if: node = 0 || lm_trans_node_is_ignored(node)
        return: 0

    if: node\kind = c.LM_P0_NODE_FRAME
        return: lm_trans_collect_hoisted_functions_from_frame(hoisted_functions, parent_c_name, nested_level, candidates, namespace_, node\as\frame)

    if: node\kind = c.LM_P0_NODE_STRUCTURE
        scope_base: 0U
        if: candidates != 0
            scope_base: candidates\count
        status: lm_trans_collect_hoisted_functions_from_fields(hoisted_functions, parent_c_name, nested_level, candidates, namespace_, node\as\structure\first_field)
        lm_own_ptr_stack_truncate(candidates, scope_base)
        return: status
return: 0

fn: lm_trans_namespace_find_hoisted_function (
    const: LmTransNamespace: namespace_
    const: LmP0Frame: frame
) const: LmTransHoistedFunction
    size_t: i
    const: LmTransHoistedFunction: hoisted

    if: namespace_ = 0 || namespace_\hoisted_functions = 0 || frame = 0
        return: 0

    i: 0U
    while: i < namespace_\hoisted_functions\count
        hoisted: (cast: (const: LmTransHoistedFunction) lm_own_ptr_stack_at(namespace_\hoisted_functions, i))
        if: hoisted != 0 && hoisted\function\frame = frame
            return: hoisted
        i: i + 1U
return: 0
