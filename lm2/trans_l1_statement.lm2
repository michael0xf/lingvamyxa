fn: lm_trans_params_has_any (const: @(LmP0Node params)) int
return: params != 0 && params\kind = c.LM_P0_NODE_STRUCTURE && params\as\structure\first_field != 0

fn: lm_trans_emit_capture_field (
    @: FILE file
    const: @(LmTransCapture capture)
    unsigned: indent
    size_t: extra_pointer_depth
) int
    size_t: i

    if: capture = 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: capture\type_is_head
        if: lm_trans_builtin_c_type_name(capture\type_head)
            if: lm_trans_emit_type_name(file, capture\type_head) != 0
                return: 1
        ---
        if: lm_trans_builtin_c_type_name(capture\type_head) = 0
            if: lm_trans_emit_name(file, capture\type_head) != 0
                return: 1
    ---
    if: capture\type_is_head = 0
        if: lm_trans_emit_type_node(file, capture\type_node) != 0
            return: 1
    ---
    if: lm_trans_put(file, " ") != 0
        return: 1
    i: 0U
    while: i < capture\pointer_depth + extra_pointer_depth
        if: lm_trans_put(file, "*") != 0
            return: 1
        i: i + 1U
    if: lm_trans_emit_identifier(file, capture\name) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_env_type (
    @: FILE file
    const: @(LmTransFunctionHeader function)
    const: @(LmTransNamespace namespace_)
) int
    size_t: i
    const: @: LmTransCapture capture

    if: function = 0 || function\has_env = 0 || function\captures = 0
        return: 0

    if: lm_trans_put(file, "typedef struct ") != 0
        return: 1
    if: lm_trans_write_text(file, function\env_type_name) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_write_text(file, function\env_type_name) != 0
        return: 1
    if: lm_trans_put(file, ";\n\nstruct ") != 0
        return: 1
    if: lm_trans_write_text(file, function\env_type_name) != 0
        return: 1
    if: lm_trans_put(file, " {\n") != 0
        return: 1

    i: 0U
    while: i < function\captures\count
        capture: (cast: (const: @: LmTransCapture) lm_own_ptr_stack_at(function\captures, i))
        if: lm_trans_emit_capture_field(file, capture, 1U, 0U) != 0
            return: 1
        i: i + 1U

    if: namespace_ != 0 && namespace_ = 0
        return: 1
return: lm_trans_put(file, "};\n\n")

fn: lm_trans_control_body_start (const: @(LmP0Frame frame)) const: @: LmP0Field
    const: @: LmP0Field end_field

    if: frame = 0 || frame\body\first_field = 0
        return: 0

    end_field: lm_trans_expr_segment_end(frame\body\first_field)
    if: end_field != 0 && end_field\value != 0 && end_field\value\kind = c.LM_P0_NODE_STRUCTURE
        return: end_field

return: 0

fn: lm_trans_emit_control_condition (
    @: FILE file
    const: @(LmP0Frame frame)
    const: @(LmTransNamespace namespace_)
) int
    const: @: LmP0Field body_start
    const: @: LmP0Field first

    first: frame\body\first_field
    if: first = 0
        return: 0

    body_start: lm_trans_control_body_start(frame)
return: lm_trans_emit_expr_range(file, first, body_start, namespace_)

fn: lm_trans_parse_size_payload (const: @(char payload); @: size_t out_value) int
    @: char end_index
    ulong: value

    if: payload = 0 || payload[0] = '\0' || out_value = 0
        return: 0

    end_index: 0
    value: c.strtoul(payload, @ end_index, 10)
    if: end_index = payload || end_index = 0 || end_index[0] != '\0'
        return: 0

    out_value[0]: (cast: size_t value)
return: 1

fn: lm_trans_frame_positional_name_index (const: @(LmP0Frame frame); @: size_t out_index) int
    const: @: char index_payload
    @: LmP0Text receiver_key

    if: frame = 0 || out_index = 0
        return: 0

    receiver_key: lm_trans_statement_text_new()
    if: receiver_key = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ receiver_key)

    if: lm_trans_frame_receiver_key(frame, receiver_key) = 0
        return: 0

    index_payload: lm_trans_registry_lookup(receiver_key, "receiver.positional-name.index")
    if: index_payload != 0
        if: lm_trans_parse_size_payload(index_payload, out_index) = 0
            c.fprintf(
                c.stderr,
                "trans registry error: receiver.positional-name.index for \"%.*s\" must be a non-negative integer\n",
                (cast: int receiver_key\length),
                receiver_key\data
            )
            c.exit(2)
        return: 1

    if: lm_trans_registry_has(receiver_key, "receiver.positional-name.argument")
        out_index[0]: 0U
        return: 1

return: 0

fn: lm_trans_frame_formal_param_unwrap_index (const: @(LmP0Frame frame); @: size_t out_index) int
    const: @: char index_payload
    @: LmP0Text receiver_key

    if: frame = 0 || out_index = 0
        return: 0

    receiver_key: lm_trans_statement_text_new()
    if: receiver_key = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ receiver_key)

    if: lm_trans_frame_receiver_key(frame, receiver_key) = 0
        return: 0

    index_payload: lm_trans_registry_lookup(receiver_key, "receiver.formal-param.unwrap")
    if: index_payload = 0
        return: 0
    if: lm_trans_parse_size_payload(index_payload, out_index) = 0
        c.fprintf(
            c.stderr,
            "trans registry error: receiver.formal-param.unwrap for \"%.*s\" must be a non-negative integer\n",
            (cast: int receiver_key\length),
            receiver_key\data
        )
        c.exit(2)
return: 1

fn: lm_trans_name_argument_from_frame (const: @(LmP0Frame frame); @: LmP0Text out_name) int
    const: @: LmP0Field field
    const: @: LmP0Field name_field
    const: @: LmP0Frame child_frame
    size_t: name_index

    if: frame = 0 || out_name = 0
        return: 0

    field: frame\body\first_field
    while: field != 0
        if: field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
            field: field\next
            continue
        child_frame: field\value\as\frame
        if: lm_trans_text_equals(child_frame\head, "name") = 0
            field: field\next
            continue
        name_field: child_frame\body\first_field
        if: name_field != 0 && name_field\next = 0 && name_field\value != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_name_argument_is_valid(name_field\value\as\atom)
            out_name[0]: name_field\value\as\atom[0]
            return: 1
        field: field\next

    if: lm_trans_frame_positional_name_index(frame, @ name_index) = 0
        return: 0

    field: lm_trans_nth_field(frame\body, name_index)
    if: field = 0 || field\value = 0
        return: 0

    if: field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_name_argument_is_valid(field\value\as\atom)
        out_name[0]: field\value\as\atom[0]
        return: 1

return: 0

fn: lm_trans_frame_close_target (const: @(LmP0Frame frame); @: LmP0Text out_target) int
    if: frame = 0 || out_target = 0
        return: 0

    if: lm_trans_name_argument_from_frame(frame, out_target)
        return: 1

    out_target[0]: frame\head[0]
return: 1

fn: lm_trans_validate_end_trailer (const: @(LmP0Frame frame)) int
    @: LmP0Text actual
    @: LmP0Text expected_name
    @: LmP0Text expected_head

    if: frame = 0 || frame\trailer = 0
        return: 0

    if: lm_trans_text_equals(frame\trailer\spelling, "end") = 0
        return: 0

    actual: lm_trans_statement_text_new()
    expected_name: lm_trans_statement_text_new()
    expected_head: lm_trans_statement_text_new()
    if: actual = 0 || expected_name = 0 || expected_head = 0
        lm_trans_text_ref_destroy(@ actual)
        lm_trans_text_ref_destroy(@ expected_name)
        lm_trans_text_ref_destroy(@ expected_head)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ actual)
        lm_trans_text_ref_destroy(@ expected_name)
        lm_trans_text_ref_destroy(@ expected_head)

    if: lm_trans_trailer_single_atom(frame\trailer, actual) = 0
        c.fprintf(c.stderr, "trans error: end trailer expects exactly one target name\n")
        return: 1

    if: lm_trans_frame_close_target(frame, expected_name) = 0
        c.fprintf(
            c.stderr,
            "trans error: head \"%.*s\" does not expose a named close target\n",
            (cast: int frame\head\length),
            frame\head\data
        )
        return: 1

    if: lm_trans_frame_receiver_key(frame, expected_head) = 0
        c.fprintf(
            c.stderr,
            "trans error: head \"%.*s\" does not expose a receiver close target\n",
            (cast: int frame\head\length),
            frame\head\data
        )
        return: 1

    if: lm_trans_identifier_same(actual, expected_name) = 0 && lm_trans_identifier_same(actual, expected_head) = 0
        c.fprintf(
            c.stderr,
            "trans error: end target \"%.*s\" does not match close target \"%.*s\" or receiver head \"%.*s\"\n",
            (cast: int actual\length),
            actual\data,
            (cast: int expected_name\length),
            expected_name\data,
            (cast: int expected_head\length),
            expected_head\data
        )
        return: 1

return: 0

fn: lm_trans_emit_cleanup (
    @: FILE file
    unsigned: indent
    const: @(LmTransNamespace namespace_)
    const: @(LmTransCleanup cleanup)
) int
    if: cleanup = 0
        return: 1

    if: cleanup\body != 0
        return: lm_trans_emit_statement_list(file, cleanup\body, indent, (cast: (@: LmTransNamespace) namespace_))

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_put(file, "lm_synchronized_leave(") != 0
        return: 1
    if: lm_trans_emit_sync_name(file, cleanup\id) != 0
        return: 1
    if: lm_trans_put(file, ");\n") != 0
        return: 1

return: 0

fn: lm_trans_emit_cleanups_until (
    @: FILE file
    unsigned: indent
    const: @(LmTransNamespace namespace_)
    size_t: cleanup_base
) int
    size_t: index
    const: @: LmTransCleanup cleanup

    if: namespace_ = 0 || cleanup_base > namespace_\cleanups\count
        return: 0

    index: namespace_\cleanups\count
    while: index > cleanup_base
        index: index - 1U
        cleanup: (cast: (const: @: LmTransCleanup) lm_own_ptr_stack_at(namespace_\cleanups, index))
        if: lm_trans_emit_cleanup(file, indent, namespace_, cleanup) != 0
            return: 1

return: 0

fn: lm_trans_emit_scope_cleanups (
    @: FILE file
    unsigned: indent
    @: LmTransNamespace namespace_
) int
    @: LmTransCleanup cleanup

    if: namespace_ = 0 || namespace_\cleanups = 0
        return: 0

    while: namespace_\cleanups\count > 0U
        cleanup: (cast: (@: LmTransCleanup) lm_own_ptr_stack_top(namespace_\cleanups))
        if: cleanup = 0 || cleanup\scope_depth != namespace_\depth
            return: 0
        cleanup: (cast: (@: LmTransCleanup) lm_own_ptr_stack_pop(namespace_\cleanups))
        if: lm_trans_emit_cleanup(file, indent, namespace_, cleanup) != 0
            lm_trans_cleanup_destroy(cleanup)
            return: 1
        lm_trans_cleanup_destroy(cleanup)

return: 0

fn: lm_trans_return_fields_single_atom (
    const: @(LmP0Field return_fields)
    @: LmP0Text out_atom
) int
    if: out_atom = 0 || return_fields = 0 || return_fields\next != 0 || return_fields\value = 0 || return_fields\value\kind != c.LM_P0_NODE_ATOM
        return: 0

    out_atom[0]: return_fields\value\as\atom[0]
return: 1

fn: lm_trans_fields_single_structure_value (
    const: @(LmP0Field fields)
) const: @: LmP0Structure
    if: fields = 0 || fields\next != 0 || fields\value = 0 || fields\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

return: fields\value\as\structure

fn: lm_trans_structure_field_count (const: @(LmP0Structure structure)) size_t
    const: @: LmP0Field field
    size_t: count

    count: 0U
    field: 0
    if: structure != 0
        field: structure\first_field
    while: field != 0
        count: count + 1U
        field: field\next

return: count

fn: lm_trans_emit_size_literal (@: FILE file; size_t: value) int
    if: c.fprintf(file, "%zuU", value) < 0
        return: 1
return: 0

fn: lm_trans_emit_array_pointer_type (
    @: FILE file
    const: @(LmP0Node element_type)
    size_t: pointer_depth
) int
    size_t: i

    if: lm_trans_emit_type_node(file, element_type) != 0
        return: 1
    if: pointer_depth = 0U
        return: 0
    if: lm_trans_put(file, " ") != 0
        return: 1
    i: 0U
    while: i < pointer_depth
        if: lm_trans_put(file, "*") != 0
            return: 1
        i: i + 1U
return: 0

fn: lm_trans_emit_array_target_path (
    @: FILE file
    const: @(LmP0Text target_name)
    const: @(size_t indices)
    size_t: depth
) int
    size_t: i
    size_t: index_value

    if: target_name = 0 || lm_trans_emit_identifier(file, target_name) != 0
        return: 1
    i: 0U
    while: i < depth
        index_value: 0U
        if: indices != 0
            index_value: indices[i]
        if: lm_trans_put(file, "[") != 0
            return: 1
        if: lm_trans_emit_size_literal(file, index_value) != 0
            return: 1
        if: lm_trans_put(file, "]") != 0
            return: 1
        i: i + 1U
return: 0

fn: lm_trans_emit_array_structure_value_alloc_assignment (
    @: FILE file
    unsigned: indent
    const: @(LmP0Text target_name)
    const: @(size_t indices)
    size_t: depth
    const: @(LmP0Node element_type)
    size_t: pointer_depth
    size_t: rank
    size_t: count
) int
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_array_target_path(file, target_name, indices, depth) != 0
        return: 1
    if: count = 0U
        return: lm_trans_put(file, " = 0;\n")

    if: lm_trans_put(file, " = (") != 0
        return: 1
    if: lm_trans_emit_array_pointer_type(file, element_type, pointer_depth) != 0
        return: 1
    if: lm_trans_put(file, ")lm_own_array_new_zero(sizeof(*") != 0
        return: 1
    if: lm_trans_emit_array_target_path(file, target_name, indices, depth) != 0
        return: 1
    if: lm_trans_put(file, "), ") != 0
        return: 1
    if: lm_trans_emit_size_literal(file, count) != 0
        return: 1
    if: lm_trans_put(file, ", ") != 0
        return: 1
    if: lm_trans_emit_size_literal(file, rank) != 0
        return: 1
    if: lm_trans_put(file, ", ") != 0
        return: 1
    if: lm_trans_emit_size_literal(file, depth) != 0
        return: 1
return: lm_trans_put(file, ");\n")

fn: lm_trans_emit_array_null_return_check (
    @: FILE file
    unsigned: indent
    const: @(LmP0Text target_name)
    const: @(size_t indices)
    size_t: depth
    const: @(LmTransNamespace namespace_)
) int
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (") != 0
        return: 1
    if: lm_trans_emit_array_target_path(file, target_name, indices, depth) != 0
        return: 1
    if: lm_trans_put(file, " == 0) {\n") != 0
        return: 1
    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
return: lm_trans_put(file, "}\n")

fn: lm_trans_array_structure_value_fill_frame_new (
    const: @(LmP0Field field)
    size_t: depth
) @: LmTransArrayStructureValueFillFrame
    @: LmTransArrayStructureValueFillFrame frame

    frame: (cast: (@: LmTransArrayStructureValueFillFrame) lm_own_new_zero(c.sizeof(frame[0])))
    if: frame != 0
        frame\field: field
        frame\depth: depth
        frame\index: 0U
return: frame

fn: lm_trans_emit_array_structure_value_fill_iterative (
    @: FILE file
    unsigned: indent
    const: @(LmP0Text target_name)
    const: @(LmP0Node element_type)
    size_t: rank
    size_t: depth
    const: @(LmP0Structure value)
    const: @(LmTransNamespace namespace_)
    @: size_t indices
) int
    @: LmOwnPtrStack stack
    @: LmTransArrayStructureValueFillFrame frame
    const: @: LmP0Field field
    const: @: LmP0Structure child
    size_t: count
    size_t: current_depth
    size_t: index
    int: status

    if: rank = 0U || depth >= rank
        return: 1
    if: value = 0 || value\first_field = 0
        return: 0

    stack: lm_trans_ptr_stack_new(c.lm_own_delete_plain)
    if: stack = 0
        return: 1
    finally: lm_trans_ptr_stack_delete(@ stack)

    frame: lm_trans_array_structure_value_fill_frame_new(value\first_field, depth)
    if: frame = 0
        return: 1
    if: lm_own_ptr_stack_push(stack, frame) != 0
        lm_own_delete(frame, 0)
        return: 1

    status: 0
    while: status = 0 && stack\count != 0U
        frame: (cast: (@: LmTransArrayStructureValueFillFrame) lm_own_ptr_stack_top(stack))
        if: frame = 0 || frame\field = 0
            lm_own_delete(lm_own_ptr_stack_pop(stack), 0)
            continue

        field: frame\field
        current_depth: frame\depth
        index: frame\index
        frame\field: frame\field\next
        frame\index: frame\index + 1U
        indices[current_depth]: index

        if: current_depth + 1U = rank
            if: lm_trans_emit_indent(file, indent) != 0
                status: 1
                break
            if: lm_trans_emit_array_target_path(file, target_name, indices, current_depth + 1U) != 0
                status: 1
                break
            if: lm_trans_put(file, " = ") != 0
                status: 1
                break
            if: lm_trans_emit_expr_node(file, field\value, namespace_) != 0
                status: 1
                break
            if: lm_trans_put(file, ";\n") != 0
                status: 1
                break
            continue

        if: field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
            c.fprintf(c.stderr, "trans L2 error: [] multi-dimensional Structure value expects nested [] Structure fields\n")
            status: 1
            break
        child: field\value\as\structure
        count: lm_trans_structure_field_count(child)
        if: lm_trans_emit_array_structure_value_alloc_assignment(file, indent, target_name, indices, current_depth + 1U, element_type, rank - current_depth - 1U, rank, count) != 0
            status: 1
            break
        if: count != 0U && lm_trans_emit_array_null_return_check(file, indent, target_name, indices, current_depth + 1U, namespace_) != 0
            status: 1
            break
        if: child != 0 && child\first_field != 0
            frame: lm_trans_array_structure_value_fill_frame_new(child\first_field, current_depth + 1U)
            if: frame = 0
                status: 1
                break
            if: lm_own_ptr_stack_push(stack, frame) != 0
                lm_own_delete(frame, 0)
                status: 1
                break
            ---
        ---

return: status

fn: lm_trans_emit_array_structure_value_fill (
    @: FILE file
    unsigned: indent
    const: @(LmP0Text target_name)
    const: @(LmP0Node element_type)
    size_t: rank
    const: @(LmP0Structure value)
    const: @(LmTransNamespace namespace_)
) int
    @: size_t indices
    int: status

    if: rank = 0U
        return: 1
    indices: (cast: (@: size_t) lm_own_new_zero(rank * c.sizeof(indices[0])))
    if: indices = 0
        return: 1
    finally: lm_own_delete(indices, 0)

    status: lm_trans_emit_array_structure_value_fill_iterative(file, indent, target_name, element_type, rank, 0U, value, namespace_, indices)
return: status

fn: lm_trans_type_receiver_array_structure_value_alloc (
    @: FILE file
    unsigned: indent
    const: @(LmP0Node type_node)
    const: @(LmP0Text target_name)
    const: @(LmP0Structure value)
    @: int out_consumed
    @: int out_needs_null_check
) int
    const: @: LmP0Node element_type
    size_t: rank
    size_t: count
    int: type_status

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_needs_null_check != 0
        out_needs_null_check[0]: 0
    if: out_consumed = 0 || out_needs_null_check = 0 || target_name = 0 || value = 0
        return: 0

    type_status: lm_trans_array_type_node_info(type_node, @ element_type, @ rank)
    if: type_status < 0
        return: 1
    if: type_status = 0
        return: 0

    out_consumed[0]: 1
    count: lm_trans_structure_field_count(value)
    out_needs_null_check[0]: count != 0U
return: lm_trans_emit_array_structure_value_alloc_assignment(file, indent, target_name, 0, 0U, element_type, rank, rank, count)

fn: lm_trans_type_receiver_structure_value_can_consume (
    const: @(LmP0Node type_node)
    const: @(LmP0Structure value)
    @: int out_can_consume
) int
    @: LmTransBinding type_receiver
    int: status

    if: out_can_consume != 0
        out_can_consume[0]: 0
    if: out_can_consume = 0 || value = 0
        return: 0

    type_receiver: lm_trans_statement_binding_new()
    if: type_receiver = 0
        return: 1
    finally: lm_own_delete(type_receiver, 0)

    status: lm_trans_lookup_type_receiver_binding(type_node, type_receiver)
    if: status < 0
        return: 1
    if: status = 0
        return: 0
    if: type_receiver\type_structure_value_alloc = 0 || type_receiver\type_structure_value_fill = 0
        return: 0

    out_can_consume[0]: 1
return: 0

fn: lm_trans_type_receiver_array_structure_value_fill (
    @: FILE file
    unsigned: indent
    const: @(LmP0Node type_node)
    const: @(LmP0Text target_name)
    const: @(LmP0Structure value)
    const: @(LmTransNamespace namespace_)
    @: int out_consumed
) int
    const: @: LmP0Node element_type
    size_t: rank
    int: type_status

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0 || target_name = 0 || value = 0
        return: 0

    type_status: lm_trans_array_type_node_info(type_node, @ element_type, @ rank)
    if: type_status < 0
        return: 1
    if: type_status = 0
        return: 0

    out_consumed[0]: 1
return: lm_trans_emit_array_structure_value_fill(file, indent, target_name, element_type, rank, value, namespace_)

fn: lm_trans_emit_type_receiver_structure_value_alloc (
    @: FILE file
    unsigned: indent
    const: @(LmP0Node type_node)
    const: @(LmP0Text target_name)
    const: @(LmP0Structure value)
    @: int out_consumed
    @: int out_needs_null_check
) int
    @: LmTransBinding type_receiver
    int: status

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_needs_null_check != 0
        out_needs_null_check[0]: 0
    if: out_consumed = 0 || out_needs_null_check = 0 || target_name = 0 || value = 0
        return: 0

    type_receiver: lm_trans_statement_binding_new()
    if: type_receiver = 0
        return: 1
    finally: lm_own_delete(type_receiver, 0)

    status: lm_trans_lookup_type_receiver_binding(type_node, type_receiver)
    if: status < 0
        return: 1
    if: status = 0 || type_receiver\type_structure_value_alloc = 0
        return: 0

return: type_receiver\type_structure_value_alloc(file, indent, type_node, target_name, value, out_consumed, out_needs_null_check)

fn: lm_trans_emit_type_receiver_structure_value_fill (
    @: FILE file
    unsigned: indent
    const: @(LmP0Node type_node)
    const: @(LmP0Text target_name)
    const: @(LmP0Structure value)
    const: @(LmTransNamespace namespace_)
    @: int out_consumed
) int
    @: LmTransBinding type_receiver
    int: status

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0 || target_name = 0 || value = 0
        return: 0

    type_receiver: lm_trans_statement_binding_new()
    if: type_receiver = 0
        return: 1
    finally: lm_own_delete(type_receiver, 0)

    status: lm_trans_lookup_type_receiver_binding(type_node, type_receiver)
    if: status < 0
        return: 1
    if: status = 0 || type_receiver\type_structure_value_fill = 0
        return: 0

return: type_receiver\type_structure_value_fill(file, indent, type_node, target_name, value, namespace_, out_consumed)

fn: lm_trans_expr_segment_single_structure_value (
    const: @(LmTransExprSegment segment)
) const: @: LmP0Structure
    if: segment = 0 || segment\first = 0 || segment\first\next != segment\stop || segment\first\value = 0 || segment\first\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

return: segment\first\value\as\structure

fn: lm_trans_array_value_helper_name_new () @: char
    [64]: char buffer
    int: written
    @: char name

    written: c.snprintf(buffer, c.sizeof(buffer), "lm_trans_array_value_%u", lm_trans_next_array_value_helper_id)
    lm_trans_next_array_value_helper_id: lm_trans_next_array_value_helper_id + 1U
    if: written < 0 || (cast: size_t written) >= c.sizeof(buffer)
        return: 0

    name: (cast: (@: char) lm_own_new_zero((cast: size_t written) + 1U))
    if: name = 0
        return: 0
    c.memcpy(name, buffer, (cast: size_t written) + 1U)
return: name

fn: lm_trans_emit_array_value_helper (
    @: FILE file
    const: @(LmP0Node param_node)
    const: @(LmP0Structure value)
    const: @(LmTransNamespace namespace_)
    @: LmP0Text out_name
) int
    @: FILE prelude_file
    const: @: LmP0Node element_type
    @: LmP0Text helper_name_text
    @: LmP0Text target_name
    @: char helper_name
    size_t: rank
    size_t: pointer_depth
    size_t: count

    if: out_name != 0
        out_name\data: ""
        out_name\length: 0U
    if: out_name = 0 || value = 0 || lm_trans_array_param_type_info(param_node, @ element_type, @ rank, @ pointer_depth) = 0
        return: 1

    helper_name: lm_trans_array_value_helper_name_new()
    if: helper_name = 0
        return: 1
    finally: lm_own_delete(helper_name, 0)

    helper_name_text: lm_trans_text_ref_new_cstr(helper_name)
    target_name: lm_trans_text_ref_new_cstr("lm_value")
    if: helper_name_text = 0 || target_name = 0
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ helper_name_text)
        lm_trans_text_ref_destroy(@ target_name)

    prelude_file: lm_trans_prelude_file(file)
    count: lm_trans_structure_field_count(value)

    if: lm_trans_put(prelude_file, "static ") != 0 || lm_trans_emit_array_pointer_type(prelude_file, element_type, pointer_depth + rank) != 0 || lm_trans_put(prelude_file, " ") != 0 || lm_trans_emit_identifier(prelude_file, helper_name_text) != 0 || lm_trans_put(prelude_file, "(void) {\n    ") != 0 || lm_trans_emit_array_pointer_type(prelude_file, element_type, pointer_depth + rank) != 0 || lm_trans_put(prelude_file, " ") != 0 || lm_trans_write_text(prelude_file, target_name) != 0 || lm_trans_put(prelude_file, ";\n") != 0 || lm_trans_emit_array_structure_value_alloc_assignment(prelude_file, 1U, target_name, 0, 0U, element_type, pointer_depth + rank, rank, count) != 0
        return: 1

    if: count != 0U && (lm_trans_put(prelude_file, "    if (") != 0 || lm_trans_write_text(prelude_file, target_name) != 0 || lm_trans_put(prelude_file, " == 0) {\n        return 0;\n    }\n") != 0)
        return: 1

    if: count != 0U && lm_trans_emit_array_structure_value_fill(prelude_file, 1U, target_name, element_type, rank, value, namespace_) != 0
        return: 1

    if: lm_trans_put(prelude_file, "    return ") != 0 || lm_trans_write_text(prelude_file, target_name) != 0 || lm_trans_put(prelude_file, ";\n}\n\n") != 0
        return: 1

    if: lm_own_ptr_stack_push(lm_trans_emitted_array_value_helpers, helper_name) != 0
        return: 1

    out_name[0]: helper_name_text[0]
    helper_name: 0
return: 0

fn: lm_trans_materialize_array_value (
    @: FILE file
    @: LmTransExprStack stack
    const: @(LmTransExprSegment segment)
    const: @(LmTransNamespace namespace_)
    @: int out_consumed
) int
    const: @: LmP0Structure value
    @: LmP0Text helper_name
    const: @: LmP0Node param_node

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0
        return: 1

    value: lm_trans_expr_segment_single_structure_value(segment)
    if: value = 0
        return: 0

    helper_name: lm_trans_statement_text_new()
    if: helper_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ helper_name)

    param_node: 0
    if: segment != 0
        param_node: segment\expected_param
    if: lm_trans_emit_array_value_helper(file, param_node, value, namespace_, helper_name) != 0 || lm_trans_expr_stack_push_text(stack, ")") != 0 || lm_trans_expr_stack_push_text(stack, "(") != 0 || lm_trans_expr_stack_push_name_text(stack, helper_name) != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_return_name_text (unsigned: id; @: char buffer; size_t: buffer_size; @: LmP0Text out_name) int
    int: written

    if: buffer = 0 || buffer_size = 0U || out_name = 0
        return: 1
    written: c.snprintf(buffer, buffer_size, "lm_return_%u", id)
    if: written < 0 || (cast: size_t written) >= buffer_size
        return: 1
    out_name\data: buffer
    out_name\length: (cast: size_t written)
return: 0

fn: lm_trans_emit_typed_value_return_statement (
    @: FILE file
    const: @(LmP0Field return_fields)
    unsigned: indent
    @: LmTransNamespace namespace_
    @: int out_consumed
) int
    const: @: LmP0Structure structure_value
    @: LmP0Text return_name
    [64]: char return_name_storage
    unsigned: return_id
    int: can_consume
    int: needs_null_check
    int: filled

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0 || namespace_ = 0 || namespace_\return_type_node = 0 || namespace_\return_type_is_struct
        return: 0

    structure_value: lm_trans_fields_single_structure_value(return_fields)
    if: structure_value = 0
        return: 0
    if: lm_trans_type_receiver_structure_value_can_consume(namespace_\return_type_node, structure_value, @ can_consume) != 0
        return: 1
    if: can_consume = 0
        return: 0

    return_name: lm_trans_statement_text_new()
    if: return_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ return_name)

    return_id: namespace_\next_return_id
    namespace_\next_return_id: namespace_\next_return_id + 1U
    if: lm_trans_return_name_text(return_id, return_name_storage, c.sizeof(return_name_storage), return_name) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0
        return: 1
    if: lm_trans_emit_current_return_type(file, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_type_receiver_structure_value_alloc(file, indent + 1U, namespace_\return_type_node, return_name, structure_value, out_consumed, @ needs_null_check) != 0
        return: 1
    if: out_consumed[0] = 0
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        return: 0

    if: needs_null_check
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (") != 0
            return: 1
        if: lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, " == 0) {\n") != 0
            return: 1
        if: lm_trans_emit_cleanups_until(file, indent + 2U, namespace_, 0U) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "return 0;\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
    ---

    if: lm_trans_emit_type_receiver_structure_value_fill(file, indent + 1U, namespace_\return_type_node, return_name, structure_value, namespace_, @ filled) != 0
        return: 1
    if: filled = 0
        c.fprintf(c.stderr, "trans L2 error: return type receiver accepted Structure value allocation but not fill\n")
        return: 1

    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return ") != 0
        return: 1
    if: lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

fn: lm_trans_struct_return_field_name_at (
    const: @(LmP0Structure descriptor)
    size_t: index
    @: LmP0Text out_name
) int
    const: @: LmP0Field field

    if: descriptor = 0 || out_name = 0
        return: 0

    field: lm_trans_nth_field(descriptor, index)
    if: field = 0 || field\value = 0
        return: 0

return: lm_trans_formal_param_name(field\value, out_name)

fn: lm_trans_struct_return_field_index (
    const: @(LmP0Structure descriptor)
    const: @(LmP0Text name)
    @: size_t out_index
) int
    const: @: LmP0Field field
    @: LmP0Text field_name
    size_t: index

    if: descriptor = 0 || out_index = 0
        return: 0

    field_name: lm_trans_statement_text_new()
    if: field_name = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ field_name)

    index: 0U
    field: descriptor\first_field
    while: field != 0
        if: field\value != 0 && lm_trans_formal_param_name(field\value, field_name) && lm_trans_identifier_same(field_name, name)
            out_index[0]: index
            return: 1
        index: index + 1U
        field: field\next

return: 0

fn: lm_trans_struct_return_field_values_new (size_t: count) @@: LmTransStructReturnFieldValue
    @@: LmTransStructReturnFieldValue values
    size_t: index

    values: (cast: (@@: LmTransStructReturnFieldValue) lm_own_new_zero(c.sizeof(values[0]) * count))
    if: values = 0
        return: 0

    index: 0U
    while: index < count
        values[index]: (cast: (@: LmTransStructReturnFieldValue) lm_own_new_zero(c.sizeof(values[index][0])))
        if: values[index] = 0
            while: index != 0U
                index: index - 1U
                lm_own_delete(values[index], 0)
            lm_own_delete(values, 0)
            return: 0
        index: index + 1U

return: values

sub: lm_trans_struct_return_field_values_delete (
    @@: LmTransStructReturnFieldValue values
    size_t: count
)
    size_t: index

    if: values = 0
        return
    index: 0U
    while: index < count
        lm_own_delete(values[index], 0)
        index: index + 1U
    lm_own_delete(values, 0)
end: lm_trans_struct_return_field_values_delete

fn: lm_trans_struct_return_collect_value_fields (
    const: @(LmP0Structure descriptor)
    const: @(LmP0Structure value)
    @@: LmTransStructReturnFieldValue fields
    size_t: field_count
) int
    const: @: LmP0Field field
    const: @: LmP0Frame frame
    size_t: positional_index
    size_t: named_index
    int: positional_disabled
    int: named_in_position

    if: descriptor = 0 || value = 0 || fields = 0
        return: 1

    positional_index: 0U
    positional_disabled: 0
    field: value\first_field
    while: field != 0
        if: field\value = 0
            field: field\next
            continue
        if: lm_trans_node_is_positional_skip(field\value)
            if: positional_disabled
                c.fprintf(c.stderr, "trans L2 error: positional skip after out-of-position named fm return field\n")
                return: 1
            positional_index: positional_index + 1U
            field: field\next
            continue

        if: field\value\kind = c.LM_P0_NODE_FRAME && (field\value\as\frame\flags & c.LM_P0_FRAME_COLON) != 0U && lm_trans_struct_return_field_index(descriptor, field\value\as\frame\head, @ named_index)
            frame: field\value\as\frame
            if: fields[named_index]\present
                c.fprintf(c.stderr, "trans L2 error: duplicate named fm return field\n")
                return: 1
            if: frame\body\first_field = 0
                c.fprintf(c.stderr, "trans L2 error: named fm return field expects a value\n")
                return: 1
            fields[named_index]\first: frame\body\first_field
            fields[named_index]\stop: 0
            fields[named_index]\present: 1
            named_in_position: named_index = positional_index
            if: named_index = positional_index
                positional_index: positional_index + 1U
            if: named_in_position = 0
                positional_disabled: 1
            field: field\next
            continue

        if: positional_disabled
            c.fprintf(c.stderr, "trans L2 error: positional fm return field after out-of-position named field\n")
            return: 1
        if: positional_index >= field_count
            c.fprintf(c.stderr, "trans L2 error: too many positional fm return fields\n")
            return: 1
        if: fields[positional_index]\present
            c.fprintf(c.stderr, "trans L2 error: duplicate positional fm return field\n")
            return: 1
        fields[positional_index]\first: field
        fields[positional_index]\stop: field\next
        fields[positional_index]\present: 1
        positional_index: positional_index + 1U
        field: field\next

return: 0

fn: lm_trans_emit_struct_value_return_statement (
    @: FILE file
    const: @(LmP0Field return_fields)
    unsigned: indent
    @: LmTransNamespace namespace_
    @: int out_consumed
) int
    const: @: LmP0Structure descriptor
    const: @: LmP0Structure value
    @@: LmTransStructReturnFieldValue values
    @: LmP0Text return_name
    @: LmP0Text field_name
    [64]: char return_name_storage
    unsigned: return_id
    size_t: field_count
    size_t: index

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0 || namespace_ = 0 || namespace_\return_type_is_struct = 0 || namespace_\return_type_node = 0 || namespace_\return_type_node\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

    value: lm_trans_fields_single_structure_value(return_fields)
    if: value = 0
        return: 0

    descriptor: namespace_\return_type_node\as\structure
    field_count: lm_trans_structure_field_count(descriptor)
    if: field_count = 0U
        c.fprintf(c.stderr, "trans L2 error: fm return Structure must not be empty\n")
        return: 1

    return_name: lm_trans_statement_text_new()
    if: return_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ return_name)

    field_name: lm_trans_statement_text_new()
    if: field_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ field_name)

    values: lm_trans_struct_return_field_values_new(field_count)
    if: values = 0
        return: 1
    finally: lm_trans_struct_return_field_values_delete(values, field_count)

    if: lm_trans_struct_return_collect_value_fields(descriptor, value, values, field_count) != 0
        return: 1
    index: 0U
    while: index < field_count
        if: values[index]\present = 0
            c.fprintf(c.stderr, "trans L2 error: fm Structure return literal does not fill every return field\n")
            return: 1
        index: index + 1U

    return_id: namespace_\next_return_id
    namespace_\next_return_id: namespace_\next_return_id + 1U
    if: lm_trans_return_name_text(return_id, return_name_storage, c.sizeof(return_name_storage), return_name) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_emit_current_return_type(file, namespace_) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1

    index: 0U
    while: index < field_count
        if: lm_trans_struct_return_field_name_at(descriptor, index, field_name) = 0
            c.fprintf(c.stderr, "trans L2 error: fm return field must expose a binding name\n")
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ".") != 0 || lm_trans_emit_identifier(file, field_name) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_expr_range(file, values[index]\first, values[index]\stop, namespace_) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        index: index + 1U

    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return ") != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_current_return_is_callable_descriptor (
    const: @(LmTransNamespace namespace_)
    @: LmP0Text out_type
) int
    const: @: LmTransSymbol symbol
    const: @: LmP0Text type_name

    if: namespace_ = 0 || namespace_\return_type_node = 0 || namespace_\return_type_node\kind != c.LM_P0_NODE_ATOM
        return: 0

    type_name: namespace_\return_type_node\as\atom
    symbol: lm_trans_namespace_find(namespace_, type_name)
    if: lm_trans_symbol_is(symbol, "callableDescriptor") = 0
        return: 0
    if: out_type != 0
        out_type[0]: type_name[0]
return: 1

fn: lm_trans_emit_raw_callable_return_statement (
    @: FILE file
    const: @(LmP0Field return_fields)
    unsigned: indent
    @: LmTransNamespace namespace_
    @: int out_consumed
) int
    @: LmP0Text atom
    @: LmP0Text descriptor_type
    @: LmP0Text name
    @: LmP0Text return_name
    const: @: LmTransSymbol symbol
    [64]: char return_name_storage
    unsigned: return_id

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0
        return: 0

    atom: lm_trans_statement_text_new()
    if: atom = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ atom)

    descriptor_type: lm_trans_statement_text_new()
    if: descriptor_type = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ descriptor_type)

    name: lm_trans_statement_text_new()
    if: name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ name)

    return_name: lm_trans_statement_text_new()
    if: return_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ return_name)

    if: lm_trans_return_fields_single_atom(return_fields, atom) = 0 || lm_trans_current_return_is_callable_descriptor(namespace_, descriptor_type) = 0 || lm_trans_registry_is_function_pointer_type_name(namespace_, descriptor_type) || lm_trans_callable_descriptor_is_raw_function_reference(namespace_, descriptor_type) = 0
        return: 0

    symbol: lm_trans_namespace_find(namespace_, atom)
    if: symbol = 0 || lm_trans_symbol_is_executable_callable(symbol) = 0 || lm_trans_callable_signature_matches_descriptor_name(descriptor_type, symbol, namespace_) = 0
        return: 0

    if: symbol\has_env_arg || lm_trans_symbol_is(symbol, "closure")
        c.fprintf(
            c.stderr,
            "trans L2 error: cannot return capturing callable %.*s as raw descriptor %.*s; use `lazy fn`\n",
            (cast: int atom\length),
            atom\data,
            (cast: int descriptor_type\length),
            descriptor_type\data
        )
        return: 1

    name[0]: atom[0]
    if: symbol\has_c_name
        name[0]: symbol\c_name[0]

    if: namespace_ != 0 && namespace_\cleanups\count > 0U
        return_id: namespace_\next_return_id
        namespace_\next_return_id: namespace_\next_return_id + 1U
        if: lm_trans_return_name_text(return_id, return_name_storage, c.sizeof(return_name_storage), return_name) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0 || lm_trans_emit_indent(file, indent + 1U) != 0
            return: 1
        if: lm_trans_emit_raw_callable_declarator(file, namespace_, descriptor_type, return_name, "raw callable return") != 0
            return: 1
        if: lm_trans_put(file, " = ") != 0 || lm_trans_write_text(file, name) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return ") != 0 || lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        out_consumed[0]: 1
        return: 0

    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "return ") != 0 || lm_trans_write_text(file, name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_emit_closure_return_statement (
    @: FILE file
    const: @(LmP0Field return_fields)
    unsigned: indent
    @: LmTransNamespace namespace_
    @: int out_consumed
) int
    @: LmP0Text atom
    @: LmP0Text descriptor_type
    const: @: LmTransSymbol symbol
    unsigned: return_id

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0
        return: 0

    atom: lm_trans_statement_text_new()
    if: atom = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ atom)

    descriptor_type: lm_trans_statement_text_new()
    if: descriptor_type = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ descriptor_type)

    if: lm_trans_return_fields_single_atom(return_fields, atom) = 0 || lm_trans_current_return_is_callable_descriptor(namespace_, descriptor_type) = 0
        return: 0
    if: lm_trans_callable_descriptor_is_lazy(namespace_, descriptor_type) = 0
        return: 0

    symbol: lm_trans_namespace_find(namespace_, atom)
    if: symbol = 0 || lm_trans_symbol_is(symbol, "function") = 0 || symbol\has_closure_call_name = 0
        return: 0

    out_consumed[0]: 1
    return_id: namespace_\next_return_id
    namespace_\next_return_id: namespace_\next_return_id + 1U

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_write_text(file, descriptor_type) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0 || lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_emit_return_name(file, return_id) != 0
        return: 1
    if: lm_trans_put(file, " = (") != 0 || lm_trans_write_text(file, descriptor_type) != 0
        return: 1
    if: lm_trans_put(file, ")lm_own_new_zero(sizeof(*") != 0 || lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, "));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (") != 0
        return: 1
    if: lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, " == 0) {\n") != 0
        return: 1
    if: lm_trans_emit_cleanups_until(file, indent + 2U, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "return 0;\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_emit_return_name(file, return_id) != 0
        return: 1
    if: lm_trans_put(file, "->call = ") != 0 || lm_trans_write_text(file, symbol\closure_call_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, "->env = ") != 0
        return: 1
    if: symbol\has_env_arg && lm_trans_write_text(file, symbol\env_arg) != 0
        return: 1
    if: symbol\has_env_arg = 0 && lm_trans_put(file, "0") != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_emit_return_name(file, return_id) != 0
        return: 1
    if: lm_trans_put(file, "->destroy = 0;\n") != 0
        return: 1
    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return ") != 0
        return: 1
    if: lm_trans_emit_return_name(file, return_id) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
return: 0

fn: lm_trans_named_structure_escape_return_info (
    const: @(LmP0Field return_fields)
    const: @(LmTransNamespace namespace_)
    @: LmP0Text out_atom
    @: LmP0Text out_type_name
) int
    @: LmP0Text atom
    @: LmP0Text variable_type
    @: LmTransL4CallableType return_type
    int: result

    if: out_atom != 0
        out_atom\data: ""
        out_atom\length: 0U
    if: out_type_name != 0
        out_type_name\data: ""
        out_type_name\length: 0U
    if: return_fields = 0 || namespace_ = 0 || namespace_\return_type_node = 0 || namespace_\return_type_is_struct || out_atom = 0 || out_type_name = 0
        return: 0

    atom: lm_trans_statement_text_new()
    variable_type: lm_trans_statement_text_new()
    return_type: lm_trans_expr_callable_type_new()
    if: atom = 0 || variable_type = 0 || return_type = 0
        lm_trans_text_ref_destroy(@ atom)
        lm_trans_text_ref_destroy(@ variable_type)
        lm_trans_expr_callable_type_delete(return_type)
        return: -1

    result: 0
    if: lm_trans_return_fields_single_atom(return_fields, atom) = 0
        result: 0
    else:
        if: lm_trans_namespace_relation_text_latest(namespace_, atom, "variable.type", variable_type) = 0
            result: 0
        else:
            if: lm_trans_identifier_same(atom, variable_type) = 0
                result: 0
            else:
                if: lm_trans_namespace_registry_lookup(namespace_, variable_type, "layout.backend") = 0
                    result: 0
                else:
                    if: lm_trans_callable_return_type_from_node(namespace_\return_type_node, return_type) = 0
                        result: -1
                    else:
                        if: return_type\address_depth = 0U && return_type\is_const = 0 && lm_trans_identifier_same(return_type\class_name, variable_type)
                            out_atom[0]: atom[0]
                            out_type_name[0]: variable_type[0]
                            result: 1
                        ---
                    ---
                ---
            ---
        ---
    ---

    lm_trans_text_ref_destroy(@ atom)
    lm_trans_text_ref_destroy(@ variable_type)
    lm_trans_expr_callable_type_delete(return_type)
return: result

fn: lm_trans_emit_named_structure_escape_return_statement (
    @: FILE file
    const: @(LmP0Field return_fields)
    unsigned: indent
    @: LmTransNamespace namespace_
    @: int out_consumed
) int
    @: LmP0Text atom
    @: LmP0Text type_name
    @: LmP0Text return_name
    [64]: char return_name_storage
    unsigned: return_id
    int: info

    if: out_consumed != 0
        out_consumed[0]: 0
    if: out_consumed = 0
        return: 0

    atom: lm_trans_statement_text_new()
    type_name: lm_trans_statement_text_new()
    return_name: lm_trans_statement_text_new()
    if: atom = 0 || type_name = 0 || return_name = 0
        lm_trans_text_ref_destroy(@ atom)
        lm_trans_text_ref_destroy(@ type_name)
        lm_trans_text_ref_destroy(@ return_name)
        return: 1
    finally: lm_trans_text_ref_destroy(@ atom)
    finally: lm_trans_text_ref_destroy(@ type_name)
    finally: lm_trans_text_ref_destroy(@ return_name)

    info: lm_trans_named_structure_escape_return_info(return_fields, namespace_, atom, type_name)
    if: info < 0
        return: 1
    if: info = 0
        return: 0

    return_id: namespace_\next_return_id
    namespace_\next_return_id: namespace_\next_return_id + 1U
    if: lm_trans_return_name_text(return_id, return_name_storage, c.sizeof(return_name_storage), return_name) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_emit_current_return_type(file, namespace_) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, " = (") != 0 || lm_trans_emit_current_return_type(file, namespace_) != 0 || lm_trans_put(file, ")lm_own_new_zero(sizeof(*") != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, "));\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "if (") != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, " == 0) {\n") != 0
        return: 1
    if: lm_trans_emit_cleanups_until(file, indent + 2U, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent + 2U) != 0 || lm_trans_put(file, "return 0;\n") != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "*") != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, " = *") != 0 || lm_trans_emit_expr_atom(file, atom, namespace_) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0 || lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "return ") != 0 || lm_trans_write_text(file, return_name) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
        return: 1

    out_consumed[0]: 1
return: 0

fn: lm_trans_emit_return_statement (
    @: FILE file
    const: @(LmP0Field return_fields)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
    unsigned: return_id
    int: consumed

    if: return_fields = 0
        if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        return: lm_trans_put(file, "return;\n")

    if: lm_trans_emit_raw_callable_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: lm_trans_emit_closure_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: lm_trans_emit_named_structure_escape_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: lm_trans_emit_struct_value_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: lm_trans_emit_typed_value_return_statement(file, return_fields, indent, namespace_, @ consumed) != 0
        return: 1
    if: consumed
        return: 0

    if: namespace_ != 0 && namespace_\cleanups\count > 0U && namespace_\return_type_node != 0
        return_id: namespace_\next_return_id
        namespace_\next_return_id: namespace_\next_return_id + 1U
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        if: lm_trans_put(file, "{\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0
            return: 1
        if: lm_trans_emit_current_return_type(file, namespace_) != 0
            return: 1
        if: lm_trans_put(file, " ") != 0
            return: 1
        if: lm_trans_emit_return_name(file, return_id) != 0
            return: 1
        if: lm_trans_put(file, " = ") != 0
            return: 1
        if: lm_trans_emit_expr_fields(file, return_fields, namespace_) != 0
            return: 1
        if: lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_cleanups_until(file, indent + 1U, namespace_, 0U) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0
            return: 1
        if: lm_trans_put(file, "return ") != 0
            return: 1
        if: lm_trans_emit_return_name(file, return_id) != 0
            return: 1
        if: lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        return: lm_trans_put(file, "}\n")

    if: lm_trans_emit_cleanups_until(file, indent, namespace_, 0U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_put(file, "return ") != 0
        return: 1
    if: lm_trans_emit_expr_fields(file, return_fields, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_trailer_statement (
    @: FILE file
    const: @(LmP0Trailer trailer)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
    if: trailer = 0
        return: 0

    if: lm_trans_text_equals(trailer\spelling, "return")
        return: lm_trans_emit_return_statement(file, trailer\body\first_field, indent, namespace_)

    if: lm_trans_text_equals(trailer\spelling, "end")
        return: 0

    c.fprintf(
        c.stderr,
        "trans error: unsupported trailer \"%.*s\"\n",
        (cast: int trailer\spelling\length),
        trailer\spelling\data
    )
return: 1

fn: lm_trans_emit_declaration_with_qualifier (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
    const: @(char qualifier)
) int
    const: @: LmP0Structure body
    const: @: LmP0Field name_field
    const: @: LmP0Node name_node
    int: is_raw_callable

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    name_field: lm_trans_nth_field(body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: declaration expects a name\n")
        return: 1

    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1

    is_raw_callable: lm_trans_symbol_is(lm_trans_namespace_find(namespace_, frame\head), "callableDescriptor") && lm_trans_callable_descriptor_is_raw_function_reference(namespace_, frame\head)
    if: is_raw_callable && lm_trans_emit_raw_callable_declarator(file, namespace_, frame\head, name_node\as\atom, "callable descriptor") != 0
        return: 1
    if: is_raw_callable = 0 && lm_trans_emit_type_head_only(file, frame\head) != 0
        return: 1
    if: is_raw_callable = 0 && lm_trans_put(file, " ") != 0
        return: 1
    if: is_raw_callable = 0 && lm_trans_emit_identifier(file, name_node\as\atom) != 0
        return: 1

    if: name_field\next != 0 && lm_trans_put(file, " = ") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_emit_expr_fields(file, name_field\next, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
return: lm_trans_namespace_declare_storage_binding(namespace_, name_node\as\atom, frame\head)

fn: lm_trans_namespace_declare_storage_binding (
    @: LmTransNamespace namespace_
    const: @(LmP0Text name)
    const: @(LmP0Text type_head)
) int
    @: LmTransSymbol symbol
    const: @: LmTransSymbol type_symbol
    const: @: char symbol_class
    int: status

    type_symbol: lm_trans_namespace_find(namespace_, type_head)
    if: lm_trans_symbol_is(type_symbol, "callableDescriptor")
        symbol_class: "closure"
        if: lm_trans_callable_descriptor_is_raw_function_reference(namespace_, type_head)
            symbol_class: "functionPointer"
        if: lm_trans_namespace_declare(namespace_, name, symbol_class) != 0
            return: 1
        symbol: lm_trans_namespace_find_mutable(namespace_, name)
        status: lm_trans_symbol_copy_signature(symbol, type_symbol)
        if: status = 0
            status: lm_trans_namespace_declare_relation_text(namespace_, name, "variable.type", type_head)
        return: status

    status: lm_trans_namespace_declare(namespace_, name, "variable")
    if: status = 0
        status: lm_trans_namespace_declare_relation_text(namespace_, name, "variable.type", type_head)
return: status

fn: lm_trans_namespace_declare_node_storage_binding (
    @: LmTransNamespace namespace_
    const: @(LmP0Text name)
    const: @(LmP0Node type_node)
) int
    if: type_node != 0 && type_node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_namespace_declare_storage_binding(namespace_, name, type_node\as\atom)
return: lm_trans_namespace_declare(namespace_, name, "variable")

fn: lm_trans_emit_declaration (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
return: lm_trans_emit_declaration_with_qualifier(file, frame, indent, namespace_, "")

fn: lm_trans_atom_can_be_new_binding_name (const: @(LmP0Text text)) int
return: lm_trans_atom_is_identifier_like(text)

fn: lm_trans_head_can_declare_storage (
    const: @(LmP0Text head)
    const: @(LmTransNamespace namespace_)
) int
    const: @: LmTransSymbol symbol

    if: lm_trans_builtin_c_type_name(head)
        return: 1
    if: lm_trans_text_all_char(head, '@') || lm_trans_text_is_array_receiver_head(head)
        return: 0
    if: lm_trans_is_reserved_head_name(head)
        return: 0
    if: lm_trans_registry_has(head, "class.present")
        return: 1

    symbol: lm_trans_namespace_find(namespace_, head)
return: lm_trans_symbol_is(symbol, "class") || lm_trans_symbol_is(symbol, "callableDescriptor")

fn: lm_trans_frame_looks_storage_declaration (
    const: @(LmP0Frame frame)
    const: @(LmTransNamespace namespace_)
) int
    const: @: LmP0Structure body
    const: @: LmP0Field name_field

    if: frame = 0 || lm_trans_head_can_declare_storage(frame\head, namespace_) = 0
        return: 0

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    name_field: lm_trans_nth_field(body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0

return: lm_trans_atom_can_be_new_binding_name(name_field\value\as\atom)

fn: lm_trans_emit_pointer_declaration_with_qualifier (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
    const: @(char qualifier)
) int
    const: @: LmP0Structure body
    const: @: LmP0Field type_field
    const: @: LmP0Field name_field
    const: @: LmP0Node name_node

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    type_field: lm_trans_nth_field(body, 0U)
    name_field: lm_trans_nth_field(body, 1U)
    if: type_field = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: @ declaration expects type and name\n")
        return: 1

    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1
    if: lm_trans_emit_type_and_name(file, type_field\value, name_node\as\atom, frame\head\length, namespace_) != 0
        return: 1
    if: name_field\next != 0 && lm_trans_put(file, " = ") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_emit_expr_fields(file, name_field\next, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
return: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_field\value)

fn: lm_trans_emit_pointer_declaration (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
return: lm_trans_emit_pointer_declaration_with_qualifier(file, frame, indent, namespace_, "")

fn: lm_trans_emit_array_initializer_fields (
    @: FILE file
    const: @(LmP0Field first)
    const: @(LmTransNamespace namespace_)
) int
    const: @: LmP0Field field
    int: wrote

    wrote: 0
    field: first
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && wrote && lm_trans_put(file, ", ") != 0
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0 && lm_trans_emit_array_initializer_node(file, field\value, namespace_) != 0
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0
            wrote: 1
        field: field\next

return: 0

fn: lm_trans_emit_array_initializer_structure (
    @: FILE file
    const: @(LmP0Structure structure)
    const: @(LmTransNamespace namespace_)
) int
    const: @: LmP0Field first

    first: 0
    if: structure != 0
        first: structure\first_field
    if: lm_trans_put(file, "{") != 0
        return: 1
    if: lm_trans_emit_array_initializer_fields(file, first, namespace_) != 0
        return: 1
return: lm_trans_put(file, "}")

fn: lm_trans_emit_array_initializer_node (
    @: FILE file
    const: @(LmP0Node node)
    const: @(LmTransNamespace namespace_)
) int
    if: node = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: lm_trans_emit_array_initializer_structure(file, node\as\structure, namespace_)
    if: node\kind = c.LM_P0_NODE_FRAME && lm_trans_text_is_array_receiver_head(node\as\frame\head)
        return: lm_trans_emit_array_initializer_structure(file, node\as\frame\body, namespace_)
    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_emit_expr_atom_mode(file, node\as\atom, namespace_, 1)
return: lm_trans_emit_expr_node(file, node, namespace_)

fn: lm_trans_emit_array_initializer (
    @: FILE file
    const: @(LmP0Field first)
    const: @(LmTransNamespace namespace_)
) int
    if: first != 0 && first\next = 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_STRUCTURE
        if: lm_trans_put(file, " = ") != 0
            return: 1
        return: lm_trans_emit_array_initializer_structure(file, first\value\as\structure, namespace_)

    if: lm_trans_put(file, " = {") != 0
        return: 1
    if: lm_trans_emit_expr_list(file, first, namespace_) != 0
        return: 1
return: lm_trans_put(file, "}")

fn: lm_trans_emit_array_declaration_with_qualifier (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
    const: @(char qualifier)
) int
    const: @: LmP0Structure body
    const: @: LmP0Field field
    const: @: LmP0Field type_field
    const: @: LmP0Field name_field
    const: @: LmP0Field dimension_field
    const: @: LmP0Field initializer_field
    const: @: LmP0Node name_node
    const: @: LmP0Node type_node
    const: @: LmP0Frame inner
    @: LmTransCDeclarator declarator
    @: LmP0Text type_head
    size_t: pointer_depth
    int: type_is_head
    int: single_frame
    int: handled

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    field: 0
    if: body != 0
        field: body\first_field
    pointer_depth: 0U
    type_node: 0
    type_head: lm_trans_statement_text_new()
    if: type_head = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ type_head)

    type_head\data: 0
    type_head\length: 0U
    type_is_head: 0
    dimension_field: 0
    name_field: 0
    type_field: 0

    single_frame: field != 0 && field\next = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
    if: single_frame
        inner: field\value\as\frame
        handled: 0
        if: lm_trans_head_can_declare_storage(inner\head, namespace_)
            name_field: inner\body\first_field
            if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
                c.fprintf(c.stderr, "trans L2 error: array declaration expects a variable name\n")
                return: 1
            type_head[0]: inner\head[0]
            type_is_head: 1
            dimension_field: name_field\next
            handled: 1
        if: handled = 0 && lm_trans_text_all_char(inner\head, '@')
            type_field: lm_trans_nth_field(inner\body, 0U)
            name_field: lm_trans_nth_field(inner\body, 1U)
            if: type_field = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
                c.fprintf(c.stderr, "trans L2 error: array pointer declaration expects type and name\n")
                return: 1
            pointer_depth: inner\head\length
            type_node: type_field\value
            dimension_field: name_field\next
            handled: 1
        if: handled = 0
            c.fprintf(c.stderr, "trans L2 error: array declaration expects a type/name declaration\n")
            return: 1
    ---

    if: single_frame = 0
        while: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_all_char(field\value\as\atom, '@')
            pointer_depth: pointer_depth + field\value\as\atom\length
            field: field\next

        type_field: field
        name_field: 0
        if: type_field != 0
            name_field: type_field\next
        if: type_field = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: [] declaration expects [@...] type name size...\n")
            return: 1
        type_node: type_field\value
        dimension_field: name_field\next
    ---

    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1

    declarator: lm_trans_statement_c_declarator_new()
    if: declarator = 0
        return: 1
    finally: lm_trans_statement_c_declarator_destroy(declarator)

    declarator\type_node: type_node
    declarator\type_head[0]: type_head[0]
    declarator\name[0]: name_node\as\atom[0]
    declarator\pointer_depth: pointer_depth
    declarator\type_is_head: type_is_head
    declarator\array_head[0]: frame\head[0]
    declarator\expression_dimensions: dimension_field
    if: lm_trans_emit_c_declarator(file, declarator, namespace_, "[] array dimension") != 0
        return: 1

    initializer_field: declarator\expression_dimensions
    if: initializer_field != 0 && lm_trans_emit_array_initializer(file, initializer_field, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: type_is_head
        return: lm_trans_namespace_declare_storage_binding(namespace_, name_node\as\atom, type_head)
return: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_node)

fn: lm_trans_emit_array_declaration (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
return: lm_trans_emit_array_declaration_with_qualifier(file, frame, indent, namespace_, "")

fn: lm_trans_emit_pointer_declaration_repeat_with_qualifier (
    @: FILE file
    const: @(LmP0Frame template_frame)
    const: @(LmP0Structure body)
    unsigned: indent
    @: LmTransNamespace namespace_
    const: @(char qualifier)
) int
    const: @: LmP0Structure template_body
    const: @: LmP0Structure repeat_body
    const: @: LmP0Field type_field
    const: @: LmP0Field name_field
    const: @: LmP0Node type_node
    const: @: LmP0Node name_node

    template_body: 0
    if: template_frame != 0
        template_body: lm_trans_unwrap_single_anonymous_structure(template_frame\body)
    repeat_body: lm_trans_unwrap_single_anonymous_structure(body)
    type_field: 0
    if: template_body != 0
        type_field: template_body\first_field
    name_field: 0
    if: repeat_body != 0
        name_field: repeat_body\first_field
    if: template_frame = 0 || type_field = 0 || type_field\value = 0 || name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: repeated @ declaration expects type template and name\n")
        return: 1

    type_node: type_field\value
    if: name_field\next != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_head_can_declare_storage(name_field\value\as\atom, namespace_)
        type_node: name_field\value
        name_field: name_field\next
        if: name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: repeated @ declaration override expects a variable name\n")
            return: 1
    ---

    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1
    if: lm_trans_emit_type_and_name(file, type_node, name_node\as\atom, template_frame\head\length, namespace_) != 0
        return: 1
    if: name_field\next != 0 && lm_trans_put(file, " = ") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_emit_expr_fields(file, name_field\next, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
return: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_node)

fn: lm_trans_emit_array_declaration_repeat_with_qualifier (
    @: FILE file
    const: @(LmP0Frame template_frame)
    const: @(LmP0Structure body)
    unsigned: indent
    @: LmTransNamespace namespace_
    const: @(char qualifier)
) int
    const: @: LmP0Structure template_body
    const: @: LmP0Structure repeat_body
    const: @: LmP0Field field
    const: @: LmP0Field type_field
    const: @: LmP0Field name_field
    const: @: LmP0Field dimension_field
    const: @: LmP0Field initializer_field
    const: @: LmP0Node name_node
    const: @: LmP0Node type_node
    const: @: LmP0Node template_type_node
    const: @: LmP0Frame inner
    @: LmTransCDeclarator declarator
    @: LmP0Text type_head
    @: LmP0Text template_type_head
    size_t: pointer_depth
    int: type_is_head
    int: template_type_is_head
    int: single_template_frame
    int: handled

    template_body: 0
    if: template_frame != 0
        template_body: lm_trans_unwrap_single_anonymous_structure(template_frame\body)
    repeat_body: lm_trans_unwrap_single_anonymous_structure(body)
    field: 0
    if: template_body != 0
        field: template_body\first_field
    pointer_depth: 0U
    type_node: 0
    template_type_node: 0

    type_head: lm_trans_statement_text_new()
    if: type_head = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ type_head)

    template_type_head: lm_trans_statement_text_new()
    if: template_type_head = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ template_type_head)

    type_head\data: 0
    type_head\length: 0U
    template_type_head\data: 0
    template_type_head\length: 0U
    type_is_head: 0
    template_type_is_head: 0

    single_template_frame: field != 0 && field\next = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
    if: single_template_frame
        inner: field\value\as\frame
        handled: 0
        if: lm_trans_head_can_declare_storage(inner\head, namespace_)
            template_type_head[0]: inner\head[0]
            template_type_is_head: 1
            handled: 1
        if: handled = 0 && lm_trans_text_all_char(inner\head, '@')
            type_field: lm_trans_nth_field(inner\body, 0U)
            if: type_field = 0 || type_field\value = 0
                c.fprintf(c.stderr, "trans L2 error: repeated array pointer declaration expects a type template\n")
                return: 1
            pointer_depth: inner\head\length
            template_type_node: type_field\value
            handled: 1
        if: handled = 0
            c.fprintf(c.stderr, "trans L2 error: repeated array declaration expects a type/name declaration template\n")
            return: 1
    ---

    if: single_template_frame = 0
        while: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_text_all_char(field\value\as\atom, '@')
            pointer_depth: pointer_depth + field\value\as\atom\length
            field: field\next

        type_field: field
        if: type_field = 0 || type_field\value = 0
            c.fprintf(c.stderr, "trans L2 error: repeated [] declaration expects a type template\n")
            return: 1
        template_type_node: type_field\value
    ---

    name_field: 0
    if: repeat_body != 0
        name_field: repeat_body\first_field
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: repeated [] declaration expects a variable name\n")
        return: 1

    type_node: template_type_node
    type_head[0]: template_type_head[0]
    type_is_head: template_type_is_head
    if: name_field\next != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_head_can_declare_storage(name_field\value\as\atom, namespace_)
        type_head[0]: name_field\value\as\atom[0]
        type_node: 0
        type_is_head: 1
        pointer_depth: 0U
        name_field: name_field\next
        if: name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: repeated [] declaration override expects a variable name\n")
            return: 1
    ---

    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1

    dimension_field: name_field\next
    declarator: lm_trans_statement_c_declarator_new()
    if: declarator = 0
        return: 1
    finally: lm_trans_statement_c_declarator_destroy(declarator)

    declarator\type_node: type_node
    declarator\type_head[0]: type_head[0]
    declarator\name[0]: name_node\as\atom[0]
    declarator\pointer_depth: pointer_depth
    declarator\type_is_head: type_is_head
    declarator\array_head[0]: template_frame\head[0]
    declarator\expression_dimensions: dimension_field
    if: lm_trans_emit_c_declarator(file, declarator, namespace_, "repeated [] array dimension") != 0
        return: 1

    initializer_field: declarator\expression_dimensions
    if: initializer_field != 0 && lm_trans_emit_array_initializer(file, initializer_field, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
    if: type_is_head
        return: lm_trans_namespace_declare_storage_binding(namespace_, name_node\as\atom, type_head)
return: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_node)

fn: lm_trans_emit_c_tagged_declaration (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
    const: @: LmP0Field type_field
    const: @: LmP0Field name_field
    const: @: LmP0Node type_node
    const: @: LmP0Node name_node

    type_field: lm_trans_nth_field(frame\body, 0U)
    name_field: lm_trans_nth_field(frame\body, 1U)
    if: type_field = 0 || name_field = 0 || type_field\value = 0 || name_field\value = 0 || type_field\value\kind != c.LM_P0_NODE_ATOM || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: C tagged declaration expects C tag name and variable name\n")
        return: 1

    type_node: type_field\value
    name_node: name_field\value
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_name(file, frame\head) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_emit_name(file, type_node\as\atom) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_emit_identifier(file, name_node\as\atom) != 0
        return: 1
    if: name_field\next != 0 && lm_trans_put(file, " = ") != 0
        return: 1
    if: name_field\next != 0 && lm_trans_emit_expr_fields(file, name_field\next, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1
return: lm_trans_namespace_declare_node_storage_binding(namespace_, name_node\as\atom, type_node)

fn: lm_trans_emit_const_statement (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
    const: @: LmP0Field field
    const: @: LmP0Frame inner

    field: frame\body\first_field
    if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME
        c.fprintf(c.stderr, "trans L2 error: const receiver expects exactly one declaration frame\n")
        return: 1

    inner: field\value\as\frame
    if: lm_trans_text_is_array_receiver_head(inner\head)
        return: lm_trans_emit_array_declaration_with_qualifier(file, inner, indent, namespace_, "const ")
    if: lm_trans_frame_looks_storage_declaration(inner, namespace_)
        return: lm_trans_emit_declaration_with_qualifier(file, inner, indent, namespace_, "const ")
    if: lm_trans_text_all_char(inner\head, '@')
        return: lm_trans_emit_pointer_declaration_with_qualifier(file, inner, indent, namespace_, "const ")

    c.fprintf(c.stderr, "trans L2 error: const receiver expects storage, pointer, or array declaration\n")
return: 1

fn: lm_trans_emit_call_statement (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    const: @(LmTransNamespace namespace_)
) int
    @: LmTransCallLowering call
    int: has_args

    call: lm_trans_statement_call_lowering_new()
    if: call = 0
        return: 1
    finally: lm_trans_expr_call_lowering_delete(call)

    if: lm_trans_lower_call(frame\head, namespace_, "callable", call) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1

    if: call\is_closure
        has_args: call\signature != 0 && call\signature\param_names != 0 && call\signature\param_names\count > 0U
        if: has_args = 0 && lm_trans_call_body_first_field(frame\body) != 0
            c.fprintf(c.stderr, "trans L2 error: too many arguments\n")
            return: 1
        if: lm_trans_emit_name(file, call\name) != 0
            return: 1
        if: lm_trans_put(file, "->call(") != 0
            return: 1
        if: lm_trans_emit_name(file, call\name) != 0
            return: 1
        if: lm_trans_put(file, "->env") != 0
            return: 1
        if: has_args && lm_trans_put(file, ", ") != 0
            return: 1
        if: has_args && lm_trans_emit_call_args(file, frame\body, namespace_, call\signature) != 0
            return: 1
        if: lm_trans_put(file, ")") != 0
            return: 1
        return: lm_trans_put(file, ";\n")

    if: lm_trans_emit_name(file, call\name) != 0
        return: 1
    if: lm_trans_put(file, "(") != 0
        return: 1
    if: lm_trans_emit_call_args(file, frame\body, namespace_, call\signature) != 0
        return: 1
    if: lm_trans_put(file, ")") != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_text_contains_char (const: @(LmP0Text text); char: ch) int
    size_t: i

    i: 0U
    while: text != 0 && i < text\length
        if: text\data[i] = ch
            return: 1
        i: i + 1U
return: 0

fn: lm_trans_head_looks_assignable_target (const: @(LmP0Text head)) int
return: lm_trans_text_contains_char(head, '[') || lm_trans_text_contains_char(head, '\\') || lm_trans_c_reference_has_path_dot(head)

fn: lm_trans_prefixed_identifier_name_new (
    const: @(char prefix)
    const: @(LmP0Text name)
    const: @(char suffix)
) @: char
    @: LmP0Text payload
    @: char result
    size_t: prefix_length
    size_t: suffix_length
    size_t: length

    if: prefix = 0 || name = 0
        return: 0

    payload: lm_trans_statement_text_new()
    if: payload = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ payload)

    if: lm_trans_identifier_payload(name, payload) = 0
        return: 0

    prefix_length: c.strlen(prefix)
    suffix_length: 0U
    if: suffix != 0
        suffix_length: c.strlen(suffix)
    length: prefix_length + payload\length + suffix_length
    result: (cast: (@: char) lm_own_new_zero(length + 1U))
    if: result = 0
        return: 0
    c.memcpy(result, prefix, prefix_length)
    if: payload\length != 0U
        c.memcpy(result + prefix_length, payload\data, payload\length)
    if: suffix_length != 0U
        c.memcpy(result + prefix_length + payload\length, suffix, suffix_length)
    result[length]: '\0'
return: result

fn: lm_trans_named_structure_body (const: @(LmP0Frame frame)) const: @: LmP0Structure
    if: frame = 0
        return: 0
return: lm_trans_unwrap_single_anonymous_structure(frame\body)

fn: lm_trans_frame_looks_named_structure_declaration (const: @(LmP0Frame frame)) int
return: frame != 0 && lm_trans_is_c_reference_name(frame\head) = 0 && lm_trans_is_reserved_head_name(frame\head) = 0 && lm_trans_text_all_char(frame\head, '@') = 0 && lm_trans_text_is_array_receiver_head(frame\head) = 0 && (frame\flags & c.LM_P0_FRAME_COLON) != 0U && (frame\flags & c.LM_P0_FRAME_INLINE_BODY) = 0U

fn: lm_trans_named_structure_type_set_cstr (
    @: LmTransL4CallableType type
    const: @(char class_name)
    size_t: address_depth
    int: is_const
) int
    if: type = 0 || class_name = 0
        return: 0
    if: lm_trans_callable_type_reset(type) != 0
        return: 0
    if: lm_trans_text_assign_cstr(type\class_name, class_name) = 0
        return: 0
    type\address_depth: address_depth
    type\is_const: is_const
return: 1

fn: lm_trans_named_structure_type_set_text (
    @: LmTransL4CallableType type
    const: @(LmP0Text class_name)
    size_t: address_depth
    int: is_const
) int
    if: type = 0 || class_name = 0
        return: 0
    if: lm_trans_callable_type_reset(type) != 0
        return: 0
    type\class_name[0]: class_name[0]
    type\address_depth: address_depth
    type\is_const: is_const
return: 1

fn: lm_trans_named_structure_atom_is_decimal_literal (const: @(LmP0Text atom)) int
    size_t: i
    char: ch

    if: atom = 0 || atom\length = 0U
        return: 0

    i: 0U
    while: i < atom\length
        ch: atom\data[i]
        if: ch < '0' || ch > '9'
            return: 0
        i: i + 1U
return: 1

fn: lm_trans_named_structure_atom_is_c_string_literal (const: @(LmP0Text atom)) int
return: atom != 0 && lm_trans_text_starts_with(atom, "c.") && atom\length > 2U && atom\data[2] = '"'

fn: lm_trans_named_structure_field_type_from_atom (
    const: @(LmP0Text atom)
    const: @(LmTransNamespace namespace_)
    @: LmTransL4CallableType out_type
) int
    const: @: LmTransSymbol relation

    if: atom = 0 || out_type = 0
        return: 0

    relation: lm_trans_namespace_relation_symbol_latest(namespace_, atom, "variable.type")
    if: relation != 0 && relation\has_c_name && relation\c_name != 0
        if: lm_trans_callable_type_reset(out_type) != 0
            return: 0
        out_type\class_name[0]: relation\c_name[0]
        out_type\address_depth: 0U
        out_type\is_const: 0
        return: 1

    if: lm_trans_named_structure_atom_is_decimal_literal(atom)
        return: lm_trans_named_structure_type_set_cstr(out_type, "int", 0U, 0)

    if: lm_trans_named_structure_atom_is_c_string_literal(atom)
        return: lm_trans_named_structure_type_set_cstr(out_type, "char", 1U, 1)

return: 0

fn: lm_trans_named_structure_single_initializer_node (
    const: @(LmP0Field initializer)
    const: @@(LmP0Node out_node)
) int
    const: @: LmP0Node current
    const: @: LmP0Field field

    if: out_node != 0
        out_node[0]: 0
    if: initializer = 0 || initializer\next != 0 || initializer\value = 0 || out_node = 0
        return: 0

    current: initializer\value
    while: current != 0 && current\kind = c.LM_P0_NODE_STRUCTURE
        field: current\as\structure\first_field
        if: field = 0 || field\next != 0 || field\value = 0
            return: 0
        current: field\value

    out_node[0]: current
return: current != 0

fn: lm_trans_named_structure_field_type_from_initializer (
    const: @(LmP0Field initializer)
    const: @(LmTransNamespace namespace_)
    @: LmTransL4CallableType out_type
) int
    const: @: LmP0Node node
    int: status

    if: initializer = 0 || out_type = 0
        return: 0
    if: lm_trans_named_structure_single_initializer_node(initializer, @ node) = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_named_structure_field_type_from_atom(node\as\atom, namespace_, out_type)
    status: lm_trans_node_result_type(node, namespace_, out_type)
    if: status > 0
        return: 1
return: 0

fn: lm_trans_named_structure_inferred_field_info (
    const: @(LmP0Frame field_frame)
    const: @(LmTransNamespace namespace_)
    @: LmTransL4CallableType out_type
    const: @@(LmP0Text out_name)
    const: @@(LmP0Field out_initializer)
) int
    const: @: LmP0Structure body
    const: @: LmP0Field initializer

    if: field_frame = 0 || out_type = 0 || out_name = 0 || out_initializer = 0
        return: 0
    if: (field_frame\flags & c.LM_P0_FRAME_COLON) = 0U
        return: 0
    if: lm_trans_atom_can_be_new_binding_name(field_frame\head) = 0 || lm_trans_is_reserved_head_name(field_frame\head)
        return: 0

    body: lm_trans_named_structure_body(field_frame)
    if: body = 0
        return: 0
    initializer: body\first_field
    if: initializer = 0
        return: 0
    if: lm_trans_named_structure_field_type_from_initializer(initializer, namespace_, out_type) = 0
        return: 0

    out_name[0]: field_frame\head
    out_initializer[0]: initializer
return: 1

fn: lm_trans_named_structure_field_info (
    const: @(LmP0Frame field_frame)
    const: @(LmTransNamespace namespace_)
    @: LmTransL4CallableType out_type
    const: @@(LmP0Text out_name)
    const: @@(LmP0Field out_initializer)
) int
    const: @: LmP0Frame current_frame
    const: @: LmP0Structure body
    const: @: LmP0Field field
    const: @: LmP0Field type_field
    const: @: LmP0Field name_field
    const: @: LmP0Frame inner
    size_t: pointer_depth

    if: field_frame = 0 || out_type = 0 || out_name = 0 || out_initializer = 0
        return: 0

    current_frame: field_frame
    pointer_depth: 0U

    while: lm_trans_text_all_char(current_frame\head, '@')
        body: lm_trans_named_structure_body(current_frame)
        if: body = 0
            return: 0

        field: body\first_field
        if: field != 0 && field\next = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            inner: field\value\as\frame
            pointer_depth: pointer_depth + current_frame\head\length
            current_frame: inner
            continue

        type_field: lm_trans_nth_field(body, 0U)
        name_field: lm_trans_nth_field(body, 1U)
        if: type_field = 0 || name_field = 0 || type_field\value = 0 || name_field\value = 0 || type_field\value\kind != c.LM_P0_NODE_ATOM || name_field\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        if: lm_trans_named_structure_type_set_text(out_type, type_field\value\as\atom, pointer_depth + current_frame\head\length, 0) = 0
            return: 0
        out_name[0]: name_field\value\as\atom
        out_initializer[0]: name_field\next
        return: lm_trans_head_can_declare_storage(out_type\class_name, namespace_)
    ---

    body: lm_trans_named_structure_body(current_frame)
    if: body = 0
        return: 0
    if: lm_trans_head_can_declare_storage(current_frame\head, namespace_) = 0
        return: lm_trans_named_structure_inferred_field_info(field_frame, namespace_, out_type, out_name, out_initializer)

    name_field: lm_trans_nth_field(body, 0U)
    if: name_field = 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: lm_trans_named_structure_type_set_text(out_type, current_frame\head, pointer_depth, 0) = 0
        return: 0
    out_name[0]: name_field\value\as\atom
    out_initializer[0]: name_field\next
    return: lm_trans_atom_can_be_new_binding_name(out_name[0])

return: lm_trans_named_structure_inferred_field_info(field_frame, namespace_, out_type, out_name, out_initializer)

fn: lm_trans_frame_looks_named_structure_layout_declaration (
    const: @(LmP0Frame frame)
    const: @(LmTransNamespace namespace_)
) int
    const: @: LmP0Structure body
    const: @: LmP0Field field
    @: LmTransL4CallableType field_type
    const: @: LmP0Text name
    const: @: LmP0Field initializer
    int: saw_field

    if: lm_trans_frame_looks_named_structure_declaration(frame) = 0
        return: 0

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 0
    finally: lm_trans_expr_callable_type_delete(field_type)

    body: lm_trans_named_structure_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    saw_field: 0
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && field\value\kind != c.LM_P0_NODE_FRAME
            return: 0
        if: lm_trans_node_is_ignored(field\value) = 0 && lm_trans_named_structure_field_info(field\value\as\frame, namespace_, field_type, @ name, @ initializer) = 0
            return: 0
        if: lm_trans_node_is_ignored(field\value) = 0
            saw_field: 1
        field: field\next
return: saw_field

fn: lm_trans_named_structure_relation_table_new (
    const: @(LmP0Text owner)
    const: @(char suffix)
) @: char
    @: char owner_name
    @: char table_name
    size_t: owner_length
    size_t: suffix_length

    owner_name: lm_trans_prefixed_identifier_name_new("", owner, "")
    if: owner_name = 0 || suffix = 0
        lm_own_delete(owner_name, 0)
        return: 0
    finally: lm_own_delete(owner_name, 0)

    owner_length: c.strlen(owner_name)
    suffix_length: c.strlen(suffix)
    table_name: (cast: (@: char) lm_own_new_zero(owner_length + suffix_length + 1U))
    if: table_name = 0
        return: 0
    c.memcpy(table_name, owner_name, owner_length)
    c.memcpy(table_name + owner_length, suffix, suffix_length + 1U)
return: table_name

fn: lm_trans_named_structure_push_relation (
    const: @(LmP0Text owner)
    const: @(char suffix)
    const: @(LmP0Text key)
    const: @(LmP0Text payload)
) int
    @: char table_name
    @: LmP0Text table_atom

    table_name: lm_trans_named_structure_relation_table_new(owner, suffix)
    if: table_name = 0
        return: 1
    finally: lm_own_delete(table_name, 0)

    table_atom: lm_trans_text_from_cstr(table_name)
    if: table_atom = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ table_atom)

return: lm_trans_registry_push_row_atoms(table_atom, key, payload) != 0

fn: lm_trans_declare_named_structure_owner (
    @: LmTransNamespace namespace_
    const: @(LmP0Text owner)
) int
    @: LmP0Text storage_name
    @: LmP0Text layout_backend_table
    @: LmP0Text backend_payload
    @: char storage_name_text
    int: status

    if: namespace_ = 0 || owner = 0
        return: 1

    storage_name_text: lm_trans_prefixed_identifier_name_new("lm_", owner, "")
    if: storage_name_text = 0
        return: 1
    finally: lm_own_delete(storage_name_text, 0)

    storage_name: lm_trans_text_from_cstr(storage_name_text)
    if: storage_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ storage_name)

    layout_backend_table: lm_trans_text_from_cstr("layout.backend")
    if: layout_backend_table = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ layout_backend_table)

    backend_payload: lm_trans_text_from_cstr("c.struct")
    if: backend_payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ backend_payload)

    status: lm_trans_registry_note_class_present(owner) != 0 || lm_trans_registry_note_class_kind(owner, "layout") != 0 || lm_trans_registry_push_row_atoms(layout_backend_table, owner, backend_payload) != 0 || lm_trans_namespace_declare_c_name(namespace_, owner, "variable", storage_name) != 0 || lm_trans_namespace_declare_relation_text(namespace_, owner, "variable.type", owner) != 0
return: status != 0

fn: lm_trans_named_structure_push_field_relations (
    const: @(LmP0Text owner)
    const: @(LmP0Text name)
    const: @(LmTransL4CallableType type)
    size_t: index
) int
    @: LmP0Text index_payload
    @: LmP0Text depth_payload
    @: LmP0Text const_payload
    [32]: char index_buffer
    [32]: char depth_buffer
    int: status

    if: owner = 0 || name = 0 || type = 0 || type\class_name = 0
        return: 1

    c.snprintf(index_buffer, c.sizeof(index_buffer), "%lu", (cast: ulong index))
    c.snprintf(depth_buffer, c.sizeof(depth_buffer), "%lu", (cast: ulong type\address_depth))
    index_payload: lm_trans_text_from_cstr(index_buffer)
    if: index_payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ index_payload)

    depth_payload: lm_trans_text_from_cstr(depth_buffer)
    if: depth_payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ depth_payload)

    status: lm_trans_named_structure_push_relation(owner, ".field.class", name, type\class_name) != 0 || lm_trans_named_structure_push_relation(owner, ".field.index", name, index_payload) != 0 || lm_trans_named_structure_push_relation(owner, ".field.address-depth", name, depth_payload) != 0
    if: status = 0 && type\is_const
        const_payload: lm_trans_text_from_cstr("1")
        if: const_payload = 0
            return: 1
        status: lm_trans_named_structure_push_relation(owner, ".field.const", name, const_payload) != 0
        lm_trans_text_ref_destroy(@ const_payload)
return: status != 0

fn: lm_trans_declare_named_structure_layout (
    @: LmTransNamespace namespace_
    const: @(LmP0Frame frame)
) int
    const: @: LmP0Structure body
    const: @: LmP0Field field
    @: LmTransL4CallableType field_type
    const: @: LmP0Text name
    const: @: LmP0Field initializer
    size_t: index

    if: namespace_ = 0 || frame = 0 || lm_trans_frame_looks_named_structure_layout_declaration(frame, namespace_) = 0
        return: 1
    if: lm_trans_declare_named_structure_owner(namespace_, frame\head) != 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    body: lm_trans_named_structure_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    index: 0U
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && (field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_named_structure_field_info(field\value\as\frame, namespace_, field_type, @ name, @ initializer) = 0)
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0 && lm_trans_named_structure_push_field_relations(frame\head, name, field_type, index) != 0
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0
            index: index + 1U
        field: field\next
return: 0

fn: lm_trans_emit_named_structure_field_declaration (
    @: FILE file
    const: @(LmP0Frame field_frame)
    unsigned: indent
    const: @(LmTransNamespace namespace_)
) int
    @: LmTransL4CallableType field_type
    const: @: LmP0Text name
    const: @: LmP0Field initializer

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    if: lm_trans_named_structure_field_info(field_frame, namespace_, field_type, @ name, @ initializer) = 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_callable_type_named(file, field_type, name) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_named_structure_typedef (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    const: @(LmTransNamespace namespace_)
) int
    const: @: LmP0Structure body
    const: @: LmP0Field field

    if: file = 0 || frame = 0 || lm_trans_frame_looks_named_structure_layout_declaration(frame, namespace_) = 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_put(file, "typedef struct ") != 0
        return: 1
    if: lm_trans_emit_identifier(file, frame\head) != 0
        return: 1
    if: lm_trans_put(file, " {\n") != 0
        return: 1

    body: lm_trans_named_structure_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && (field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_emit_named_structure_field_declaration(file, field\value\as\frame, indent + 1U, namespace_) != 0)
            return: 1
        field: field\next

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "} ") != 0
        return: 1
    if: lm_trans_emit_identifier(file, frame\head) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_named_structure_initializer (
    @: FILE file
    const: @(LmP0Frame frame)
    const: @(LmTransNamespace namespace_)
) int
return: lm_trans_emit_named_structure_body_initializer(file, lm_trans_named_structure_body(frame), namespace_)

fn: lm_trans_emit_named_structure_body_initializer (
    @: FILE file
    const: @(LmP0Structure body)
    const: @(LmTransNamespace namespace_)
) int
    const: @: LmP0Field field
    @: LmTransL4CallableType field_type
    const: @: LmP0Text name
    const: @: LmP0Field initializer
    int: wrote

    if: lm_trans_put(file, " = {") != 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    field: 0
    if: body != 0
        field: body\first_field
    wrote: 0
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0 && (field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_named_structure_field_info(field\value\as\frame, namespace_, field_type, @ name, @ initializer) = 0)
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0 && initializer != 0 && wrote && lm_trans_put(file, ", ") != 0
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0 && initializer != 0 && (lm_trans_put(file, ".") != 0 || lm_trans_emit_identifier(file, name) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_expr_fields(file, initializer, namespace_) != 0)
            return: 1
        if: lm_trans_node_is_ignored(field\value) = 0 && initializer != 0
            wrote: 1
        field: field\next

    if: wrote = 0 && lm_trans_put(file, "0") != 0
        return: 1
return: lm_trans_put(file, "}")

fn: lm_trans_emit_named_structure_storage (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
    const: @(char qualifier)
) int
    @: char storage_name
    @: char pointer_name

    if: file = 0 || namespace_ = 0 || frame = 0 || lm_trans_frame_looks_named_structure_layout_declaration(frame, namespace_) = 0
        return: 1

    storage_name: lm_trans_prefixed_identifier_name_new("lm_", frame\head, "_storage")
    if: storage_name = 0
        return: 1
    finally: lm_own_delete(storage_name, 0)

    pointer_name: lm_trans_prefixed_identifier_name_new("lm_", frame\head, "")
    if: pointer_name = 0
        return: 1
    finally: lm_own_delete(pointer_name, 0)

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1
    if: lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_put(file, storage_name) != 0
        return: 1
    if: lm_trans_emit_named_structure_initializer(file, frame, namespace_) != 0
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: qualifier != 0 && lm_trans_put(file, qualifier) != 0
        return: 1
    if: lm_trans_emit_identifier(file, frame\head) != 0 || lm_trans_put(file, " *") != 0
        return: 1
    if: lm_trans_put(file, pointer_name) != 0
        return: 1
    if: lm_trans_put(file, " = &") != 0 || lm_trans_put(file, storage_name) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_l2_c_identifier_char (char: ch) int
return: (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch = '_'

fn: lm_trans_l2_c_identifier_new (
    const: @(char prefix)
    const: @(LmP0Text text)
    const: @(char suffix)
) @: char
    @: LmP0Text payload
    @: char result
    size_t: prefix_length
    size_t: suffix_length
    size_t: payload_length
    size_t: length
    size_t: i
    size_t: out
    char: ch

    if: prefix = 0 || text = 0
        return: 0

    payload: lm_trans_text_ref_new_cstr("")
    if: payload = 0
        return: 0
    finally: lm_trans_text_ref_destroy(@ payload)

    if: lm_trans_registry_literal_value(text, payload) = 0
        return: 0

    prefix_length: c.strlen(prefix)
    suffix_length: 0U
    if: suffix != 0
        suffix_length: c.strlen(suffix)
    payload_length: 1U
    if: payload\length != 0U
        payload_length: payload\length
    length: prefix_length + payload_length + suffix_length
    result: (cast: (@: char) lm_own_new_zero(length + 1U))
    if: result = 0
        return: 0

    c.memcpy(result, prefix, prefix_length)
    out: prefix_length
    if: payload\length = 0U
        result[out]: 'x'
        out: out + 1U
    if: payload\length != 0U
        i: 0U
        while: i < payload\length
            ch: payload\data[i]
            if: lm_trans_l2_c_identifier_char(ch)
                result[out]: ch
            if: lm_trans_l2_c_identifier_char(ch) = 0
                result[out]: '_'
            out: out + 1U
            i: i + 1U
    ---
    if: suffix_length != 0U
        c.memcpy(result + out, suffix, suffix_length)
        out: out + suffix_length
    result[out]: '\0'
return: result

fn: lm_trans_emit_c_string_literal_text (@: FILE file; const: @(LmP0Text text)) int
    size_t: i
    uchar: ch

    if: file = 0 || text = 0
        return: 1
    if: lm_trans_put(file, "\"") != 0
        return: 1
    i: 0U
    while: i < text\length
        ch: (cast: uchar text\data[i])
        if: (ch = '\\' || ch = '"') && (c.fputc('\\', file) = c.EOF || c.fputc((cast: int ch), file) = c.EOF)
            return: 1
        if: ch = '\n' && lm_trans_put(file, "\\n") != 0
            return: 1
        if: ch = '\r' && lm_trans_put(file, "\\r") != 0
            return: 1
        if: ch = '\t' && lm_trans_put(file, "\\t") != 0
            return: 1
        if: ch != '\\' && ch != '"' && ch != '\n' && ch != '\r' && ch != '\t' && (ch < 32U || ch > 126U) && c.fprintf(file, "\\%03o", (cast: unsigned ch)) < 0
            return: 1
        if: ch != '\\' && ch != '"' && ch != '\n' && ch != '\r' && ch != '\t' && ch >= 32U && ch <= 126U && c.fputc((cast: int ch), file) = c.EOF
            return: 1
        i: i + 1U
return: lm_trans_put(file, "\"")

fn: lm_trans_emit_c_string_literal_atom (@: FILE file; const: @(LmP0Text atom)) int
    @: LmP0Text payload

    payload: lm_trans_text_ref_new_cstr("")
    if: payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ payload)

    if: lm_trans_registry_literal_value(atom, payload) = 0
        return: 1
return: lm_trans_emit_c_string_literal_text(file, payload)

fn: lm_trans_l2_structure_first_present_field (const: @(LmP0Structure structure)) const: @: LmP0Field
    const: @: LmP0Field field

    field: 0
    if: structure != 0
        field: structure\first_field
    while: field != 0 && lm_trans_node_is_ignored(field\value)
        field: field\next
return: field

fn: lm_trans_l2_structure_next_present_field (const: @(LmP0Field field)) const: @: LmP0Field
    if: field != 0
        field: field\next
    while: field != 0 && lm_trans_node_is_ignored(field\value)
        field: field\next
return: field

fn: lm_trans_l2_structure_has_present_fields (const: @(LmP0Structure structure)) int
return: lm_trans_l2_structure_first_present_field(structure) != 0

fn: lm_trans_l2_frame_wrapper_node_new (const: @(LmP0Frame frame)) @: LmP0Node
    @: LmP0Node node

    if: frame = 0
        return: 0
    node: (cast: (@: LmP0Node) lm_own_new_zero(c.sizeof(node[0])))
    if: node = 0
        return: 0
    node\as: (cast: (@: LmP0NodeAs) lm_own_new_zero(c.sizeof(node\as[0])))
    if: node\as = 0
        lm_own_delete(node, 0)
        return: 0
    node\kind: c.LM_P0_NODE_FRAME
    node\as\frame: (cast: (@: LmP0Frame) frame)
return: node

sub: lm_trans_l2_frame_wrapper_node_delete (@@(LmP0Node node))
    if: node = 0 || node[0] = 0
        return
    lm_own_delete(node[0]\as, 0)
    lm_own_delete(node[0], 0)
    node[0]: 0
end: lm_trans_l2_frame_wrapper_node_delete

fn: lm_trans_l2_structure_member_name_new (const: @(LmP0Node node); size_t: index) @: char
    const: @: LmP0Text base
    @: LmP0Text generated_base
    [32]: char suffix

    generated_base: 0
    finally: lm_trans_text_ref_destroy(@ generated_base)

    base: 0
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME
        base: node\as\frame\head
    if: base = 0 && node != 0 && node\kind = c.LM_P0_NODE_STRUCTURE
        generated_base: lm_trans_text_ref_new_cstr("structure")
        if: generated_base = 0
            return: 0
        base: generated_base
    if: base = 0
        generated_base: lm_trans_text_ref_new_cstr("atom")
        if: generated_base = 0
            return: 0
        base: generated_base

    c.snprintf(suffix, c.sizeof(suffix), "_%lu", (cast: ulong index))
return: lm_trans_l2_c_identifier_new("field_", base, suffix)

fn: lm_trans_l2_object_suffix_name_new (
    const: @(char object_name)
    const: @(char suffix)
) @: char
    size_t: object_length
    size_t: suffix_length
    @: char name

    if: object_name = 0 || suffix = 0
        return: 0

    object_length: c.strlen(object_name)
    suffix_length: c.strlen(suffix)
    name: (cast: (@: char) lm_own_new_zero(object_length + suffix_length + 1U))
    if: name = 0
        return: 0
    c.memcpy(name, object_name, object_length)
    c.memcpy(name + object_length, suffix, suffix_length + 1U)
return: name

fn: lm_trans_l2_child_object_name_new (
    const: @(char object_name)
    const: @(char member_name)
) @: char
    size_t: object_length
    size_t: member_length
    @: char name

    if: object_name = 0 || member_name = 0
        return: 0

    object_length: c.strlen(object_name)
    member_length: c.strlen(member_name)
    name: (cast: (@: char) lm_own_new_zero(object_length + member_length + 2U))
    if: name = 0
        return: 0
    c.memcpy(name, object_name, object_length)
    name[object_length]: '_'
    c.memcpy(name + object_length + 1U, member_name, member_length + 1U)
return: name

fn: lm_trans_l2_object_type_name_new (const: @(char object_name)) @: char
return: lm_trans_l2_object_suffix_name_new(object_name, "_type")

fn: lm_trans_l2_object_storage_name_new (const: @(char object_name)) @: char
return: lm_trans_l2_object_suffix_name_new(object_name, "_storage")

fn: lm_trans_emit_l2_structure_fields_children (
    @: FILE file
    const: @(LmP0Structure structure)
    const: @(char object_name)
    unsigned: indent
) int
    const: @: LmP0Field field
    @: char member_name
    @: char child_object_name
    size_t: index

    field: lm_trans_l2_structure_first_present_field(structure)
    index: 0U
    while: field != 0
        if: field\value != 0 && (field\value\kind = c.LM_P0_NODE_STRUCTURE || field\value\kind = c.LM_P0_NODE_FRAME)
            member_name: lm_trans_l2_structure_member_name_new(field\value, index)
            if: member_name = 0
                return: 1
            child_object_name: lm_trans_l2_child_object_name_new(object_name, member_name)
            if: child_object_name = 0
                lm_own_delete(member_name, 0)
                return: 1
            if: lm_trans_emit_l2_structure_node_definition(file, field\value, child_object_name, indent) != 0
                lm_own_delete(child_object_name, 0)
                lm_own_delete(member_name, 0)
                return: 1
            lm_own_delete(child_object_name, 0)
            lm_own_delete(member_name, 0)
        index: index + 1U
        field: lm_trans_l2_structure_next_present_field(field)
return: 0

fn: lm_trans_emit_l2_structure_node_type (
    @: FILE file
    const: @(LmP0Node node)
    const: @(char object_name)
    const: @(char member_name)
    unsigned: indent
) int
    @: char child_object_name
    @: char child_type_name
    int: status

    if: file = 0 || node = 0 || object_name = 0 || member_name = 0
        return: 1

    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "const char *") != 0 || lm_trans_put(file, member_name) != 0 || lm_trans_put(file, ";\n") != 0

    if: node\kind = c.LM_P0_NODE_STRUCTURE || node\kind = c.LM_P0_NODE_FRAME
        child_object_name: lm_trans_l2_child_object_name_new(object_name, member_name)
        if: child_object_name = 0
            return: 1
        child_type_name: lm_trans_l2_object_type_name_new(child_object_name)
        if: child_type_name = 0
            lm_own_delete(child_object_name, 0)
            return: 1
        status: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "const ") != 0 || lm_trans_put(file, child_type_name) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_put(file, member_name) != 0 || lm_trans_put(file, ";\n") != 0
        lm_own_delete(child_type_name, 0)
        lm_own_delete(child_object_name, 0)
        return: status

return: 1

fn: lm_trans_emit_l2_structure_fields_type (
    @: FILE file
    const: @(LmP0Structure structure)
    const: @(char object_name)
    unsigned: indent
) int
    const: @: LmP0Field field
    @: char member_name
    size_t: index

    field: lm_trans_l2_structure_first_present_field(structure)
    if: field = 0
        return: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "const char *empty;\n") != 0

    index: 0U
    while: field != 0
        member_name: lm_trans_l2_structure_member_name_new(field\value, index)
        if: member_name = 0
            return: 1
        if: lm_trans_emit_l2_structure_node_type(file, field\value, object_name, member_name, indent) != 0
            lm_own_delete(member_name, 0)
            return: 1
        lm_own_delete(member_name, 0)
        index: index + 1U
        field: lm_trans_l2_structure_next_present_field(field)
return: 0

fn: lm_trans_emit_l2_structure_field_initializer (
    @: FILE file
    const: @(LmP0Node node)
    const: @(char object_name)
    const: @(char member_name)
) int
    @: char child_object_name
    @: char child_storage_name
    int: status

    if: file = 0 || node = 0 || object_name = 0 || member_name = 0
        return: 1

    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_emit_c_string_literal_atom(file, node\as\atom)

    if: node\kind = c.LM_P0_NODE_STRUCTURE || node\kind = c.LM_P0_NODE_FRAME
        child_object_name: lm_trans_l2_child_object_name_new(object_name, member_name)
        if: child_object_name = 0
            return: 1
        child_storage_name: lm_trans_l2_object_storage_name_new(child_object_name)
        if: child_storage_name = 0
            lm_own_delete(child_object_name, 0)
            return: 1
        status: lm_trans_put(file, "&") != 0 || lm_trans_put(file, child_storage_name) != 0
        lm_own_delete(child_storage_name, 0)
        lm_own_delete(child_object_name, 0)
        return: status

return: 1

fn: lm_trans_emit_l2_structure_fields_initializer (
    @: FILE file
    const: @(LmP0Structure structure)
    const: @(char object_name)
) int
    const: @: LmP0Field field
    @: char member_name
    size_t: index
    int: wrote

    field: lm_trans_l2_structure_first_present_field(structure)
    if: field = 0
        return: lm_trans_put(file, "0")

    wrote: 0
    index: 0U
    while: field != 0
        if: wrote && lm_trans_put(file, ", ") != 0
            return: 1
        member_name: lm_trans_l2_structure_member_name_new(field\value, index)
        if: member_name = 0
            return: 1
        if: lm_trans_emit_l2_structure_field_initializer(file, field\value, object_name, member_name) != 0
            lm_own_delete(member_name, 0)
            return: 1
        lm_own_delete(member_name, 0)
        wrote: 1
        index: index + 1U
        field: lm_trans_l2_structure_next_present_field(field)
return: 0

fn: lm_trans_emit_l2_structure_node_initializer (
    @: FILE file
    const: @(LmP0Node node)
    const: @(char object_name)
) int
    if: file = 0 || node = 0 || object_name = 0
        return: 1

    if: node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_emit_c_string_literal_atom(file, node\as\atom)

    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: lm_trans_put(file, "{") != 0 || lm_trans_emit_l2_structure_fields_initializer(file, node\as\structure, object_name) != 0 || lm_trans_put(file, "}") != 0

    if: node\kind = c.LM_P0_NODE_FRAME
        if: lm_trans_put(file, "{") != 0 || lm_trans_emit_c_string_literal_atom(file, node\as\frame\head) != 0
            return: 1
        if: lm_trans_l2_structure_has_present_fields(node\as\frame\body) && (lm_trans_put(file, ", ") != 0 || lm_trans_emit_l2_structure_fields_initializer(file, node\as\frame\body, object_name) != 0)
            return: 1
        return: lm_trans_put(file, "}") != 0

return: 1

fn: lm_trans_emit_l2_structure_node_definition (
    @: FILE file
    const: @(LmP0Node node)
    const: @(char object_name)
    unsigned: indent
) int
    @: char type_name
    @: char storage_name

    if: file = 0 || node = 0 || object_name = 0
        return: 1
    if: node\kind != c.LM_P0_NODE_STRUCTURE && node\kind != c.LM_P0_NODE_FRAME
        return: 0

    if: node\kind = c.LM_P0_NODE_FRAME && lm_trans_emit_l2_structure_fields_children(file, node\as\frame\body, object_name, indent) != 0
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE && lm_trans_emit_l2_structure_fields_children(file, node\as\structure, object_name, indent) != 0
        return: 1

    type_name: lm_trans_l2_object_type_name_new(object_name)
    if: type_name = 0
        return: 1
    finally: lm_own_delete(type_name, 0)

    storage_name: lm_trans_l2_object_storage_name_new(object_name)
    if: storage_name = 0
        return: 1
    finally: lm_own_delete(storage_name, 0)

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "typedef struct ") != 0 || lm_trans_put(file, type_name) != 0 || lm_trans_put(file, " {\n") != 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && (lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "const char *head;\n") != 0 || lm_trans_emit_l2_structure_fields_type(file, node\as\frame\body, object_name, indent + 1U) != 0)
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE && lm_trans_emit_l2_structure_fields_type(file, node\as\structure, object_name, indent + 1U) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "} ") != 0 || lm_trans_put(file, type_name) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "static const ") != 0 || lm_trans_put(file, type_name) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_put(file, storage_name) != 0 || lm_trans_put(file, " = ") != 0 || lm_trans_emit_l2_structure_node_initializer(file, node, object_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
return: 0

fn: lm_trans_l2_table_name_atom (const: @(LmP0Frame frame)) const: @: LmP0Text
    const: @: LmP0Field field
    const: @: LmP0Frame child_frame
    const: @: LmP0Field name_field

    field: 0
    if: frame != 0
        field: lm_trans_l2_structure_first_present_field(frame\body)
    while: field != 0
        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_FRAME
            child_frame: field\value\as\frame
            if: lm_trans_text_equals(child_frame\head, "name")
                name_field: lm_trans_l2_structure_first_present_field(child_frame\body)
                if: name_field != 0 && name_field\value != 0 && name_field\value\kind = c.LM_P0_NODE_ATOM
                    return: name_field\value\as\atom
        ---
        field: lm_trans_l2_structure_next_present_field(field)
    if: frame != 0
        return: frame\head
return: 0

fn: lm_trans_l2_join_target_atom (const: @(LmP0Frame frame)) const: @: LmP0Text
    const: @: LmP0Field field

    field: 0
    if: frame != 0
        field: lm_trans_l2_structure_first_present_field(frame\body)
    if: field != 0
        field: lm_trans_l2_structure_next_present_field(field)
    if: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM
        return: field\value\as\atom
    if: frame != 0
        return: frame\head
return: 0

fn: lm_trans_emit_l2_structure_frame_storage (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    const: @(char prefix)
    const: @(LmP0Text name_hint)
) int
    [32]: char id_suffix
    @: char object_name
    @: char type_name
    @: char storage_name
    @: LmP0Node node

    if: file = 0 || frame = 0 || prefix = 0 || name_hint = 0
        return: 1

    lm_trans_next_l2_structure_object_id: lm_trans_next_l2_structure_object_id + 1U
    c.snprintf(id_suffix, c.sizeof(id_suffix), "_%lu", (cast: ulong lm_trans_next_l2_structure_object_id))
    object_name: lm_trans_l2_c_identifier_new(prefix, name_hint, id_suffix)
    if: object_name = 0
        return: 1
    finally: lm_own_delete(object_name, 0)

    type_name: lm_trans_l2_object_type_name_new(object_name)
    if: type_name = 0
        return: 1
    finally: lm_own_delete(type_name, 0)

    storage_name: lm_trans_l2_object_storage_name_new(object_name)
    if: storage_name = 0
        return: 1
    finally: lm_own_delete(storage_name, 0)

    node: lm_trans_l2_frame_wrapper_node_new(frame)
    if: node = 0
        return: 1
    finally: lm_trans_l2_frame_wrapper_node_delete(@ node)

    if: lm_trans_emit_l2_structure_node_definition(file, node, object_name, indent) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "static const ") != 0 || lm_trans_put(file, type_name) != 0 || lm_trans_put(file, " *const ") != 0 || lm_trans_put(file, object_name) != 0 || lm_trans_put(file, " = &") != 0 || lm_trans_put(file, storage_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1

    if: indent = 0U && (lm_trans_put(file, "enum { ") != 0 || lm_trans_put(file, object_name) != 0 || lm_trans_put(file, "_anchor = sizeof(") != 0 || lm_trans_put(file, object_name) != 0 || lm_trans_put(file, ") };\n") != 0)
        return: 1
    if: indent != 0U && (lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "(void)&") != 0 || lm_trans_put(file, object_name) != 0 || lm_trans_put(file, ";\n") != 0)
        return: 1

return: 0

fn: lm_trans_emit_l2_table_structure (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
) int
return: lm_trans_emit_l2_structure_frame_storage(file, frame, indent, "lm_l2_table_", lm_trans_l2_table_name_atom(frame))

fn: lm_trans_emit_l2_join_structure (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
) int
return: lm_trans_emit_l2_structure_frame_storage(file, frame, indent, "lm_l2_join_", lm_trans_l2_join_target_atom(frame))

fn: lm_trans_merge_source_list (const: @(LmP0Frame frame)) const: @: LmP0Structure
    const: @: LmP0Field field

    if: frame = 0 || lm_trans_text_equals(frame\head, "merge") = 0
        return: 0
    field: lm_trans_nth_field(frame\body, 0U)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
return: field\value\as\structure

fn: lm_trans_merge_target_name (const: @(LmP0Frame frame)) const: @: LmP0Text
    const: @: LmP0Field field

    if: frame = 0 || lm_trans_text_equals(frame\head, "merge") = 0
        return: 0
    field: lm_trans_nth_field(frame\body, 1U)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: field\value\as\atom

fn: lm_trans_merge_local_body (const: @(LmP0Frame frame)) const: @: LmP0Structure
    const: @: LmP0Field field

    if: frame = 0
        return: 0
    field: lm_trans_nth_field(frame\body, 2U)
    if: field = 0
        return: 0
    if: field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
return: field\value\as\structure

fn: lm_trans_frame_looks_merge_named_structure_declaration (const: @(LmP0Frame frame)) int
    const: @: LmP0Structure sources
    const: @: LmP0Text target

    sources: lm_trans_merge_source_list(frame)
    target: lm_trans_merge_target_name(frame)
return: sources != 0 && target != 0 && sources\first_field != 0 && lm_trans_atom_can_be_new_binding_name(target)

fn: lm_trans_merge_push_size_relation (
    const: @(LmP0Text owner)
    const: @(char suffix)
    const: @(LmP0Text name)
    size_t: value
) int
    @: LmP0Text payload
    [32]: char buffer

    c.snprintf(buffer, c.sizeof(buffer), "%lu", (cast: ulong value))
    payload: lm_trans_text_from_cstr(buffer)
    if: payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ payload)
return: lm_trans_named_structure_push_relation(owner, suffix, name, payload)

fn: lm_trans_merge_push_layout_field_relations (
    const: @(LmP0Text owner)
    const: @(LmTransLayoutField field)
    size_t: index
) int
    @: LmP0Text name
    @: LmP0Text payload
    const: @: char payload_source
    const: @: char relation_suffix

    if: owner = 0 || field = 0 || field\name = 0
        return: 1

    payload_source: field\class_name
    relation_suffix: ".field.class"
    if: field\is_union
        payload_source: field\union_layout_name
        relation_suffix: ".field.union"

    name: lm_trans_text_from_cstr(field\name)
    if: name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ name)

    payload: lm_trans_text_from_cstr(payload_source)
    if: payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ payload)

    if: lm_trans_named_structure_push_relation(owner, relation_suffix, name, payload) != 0
        return: 1
    if: lm_trans_merge_push_size_relation(owner, ".field.index", name, index) != 0
        return: 1
    if: lm_trans_merge_push_size_relation(owner, ".field.address-depth", name, field\address_depth) != 0
        return: 1
    if: field\is_const && lm_trans_merge_push_size_relation(owner, ".field.const", name, 1U) != 0
        return: 1
    if: field\has_array_count && lm_trans_merge_push_size_relation(owner, ".field.array-count", name, field\array_count) != 0
        return: 1
return: 0

fn: lm_trans_merge_source_layout_name_from_atom_new (
    const: @(LmP0Text atom)
    const: @(LmTransNamespace namespace_)
    @@: char out_name
) int
    @: LmP0Text payload
    const: @: char backend

    if: out_name != 0
        out_name[0]: 0
    if: atom = 0 || out_name = 0
        return: 0

    payload: lm_trans_statement_text_new()
    if: payload = 0
        return: -1
    finally: lm_trans_text_ref_destroy(@ payload)

    if: lm_trans_identifier_payload(atom, payload) = 0
        return: 0

    backend: lm_trans_namespace_registry_lookup(namespace_, payload, "layout.backend")
    if: backend = 0 || lm_trans_layout_backend_is_supported(backend) = 0
        return: 0

    out_name[0]: lm_trans_text_copy_cstr(payload)
    if: out_name[0] != 0
        return: 1
return: -1

fn: lm_trans_merge_source_layout_name_from_call_new (
    const: @(LmP0Node node)
    const: @(LmTransNamespace namespace_)
    @@: char out_name
) int
    @: LmTransL4CallableType type
    const: @: char backend
    int: status

    if: out_name != 0
        out_name[0]: 0
    if: node = 0 || out_name = 0
        return: 0

    type: lm_trans_expr_callable_type_new()
    if: type = 0
        return: -1
    finally: lm_trans_expr_callable_type_delete(type)

    status: lm_trans_node_result_type(node, namespace_, type)
    if: status <= 0
        return: status
    if: type\address_depth != 0U || type\is_const
        return: 0

    backend: lm_trans_namespace_registry_lookup(namespace_, type\class_name, "layout.backend")
    if: backend = 0 || lm_trans_layout_backend_is_supported(backend) = 0
        return: 0

    out_name[0]: lm_trans_text_copy_cstr(type\class_name)
    if: out_name[0] != 0
        return: 1
return: -1

fn: lm_trans_merge_push_source_layout_fields (
    const: @(LmP0Text owner)
    const: @(char layout_name)
    const: @(LmTransNamespace namespace_)
    @: size_t index
) int
    @@: LmTransLayoutField fields
    size_t: field_capacity
    size_t: field_count
    size_t: i

    if: owner = 0 || layout_name = 0 || index = 0
        return: 1

    field_capacity: 256U
    fields: lm_trans_layout_fields_new(field_capacity)
    if: fields = 0
        return: 1
    finally: lm_trans_layout_fields_delete(fields, field_capacity)

    if: lm_trans_collect_layout_fields(layout_name, namespace_, fields, field_capacity, @ field_count) != 0 || lm_trans_sort_layout_fields(fields, field_count) != 0
        return: 1

    i: 0U
    while: i < field_count
        if: lm_trans_merge_push_layout_field_relations(owner, fields[i], index[0]) != 0
            return: 1
        index[0]: index[0] + 1U
        i: i + 1U
return: 0

fn: lm_trans_merge_push_inline_source_fields (
    const: @(LmP0Text owner)
    const: @(LmP0Frame source)
    const: @(LmTransNamespace namespace_)
    @: size_t index
) int
    const: @: LmP0Structure body
    const: @: LmP0Field field
    @: LmTransL4CallableType field_type
    const: @: LmP0Text name
    const: @: LmP0Field initializer

    if: owner = 0 || source = 0 || index = 0 || lm_trans_frame_looks_named_structure_layout_declaration(source, namespace_) = 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    body: lm_trans_named_structure_body(source)
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_named_structure_field_info(field\value\as\frame, namespace_, field_type, @ name, @ initializer) = 0
                return: 1
            if: lm_trans_named_structure_push_field_relations(owner, name, field_type, index[0]) != 0
                return: 1
            index[0]: index[0] + 1U
        field: field\next
return: 0

fn: lm_trans_merge_push_source_node_fields (
    const: @(LmP0Text owner)
    const: @(LmP0Node node)
    const: @(LmTransNamespace namespace_)
    @: size_t index
) int
    @: char layout_name
    int: status

    if: owner = 0 || node = 0 || index = 0
        return: 1

    layout_name: 0
    finally: lm_own_delete(layout_name, 0)

    status: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        status: lm_trans_merge_source_layout_name_from_atom_new(node\as\atom, namespace_, @ layout_name)
    else:
        if: node\kind = c.LM_P0_NODE_FRAME
            if: lm_trans_frame_looks_named_structure_layout_declaration(node\as\frame, namespace_)
                return: lm_trans_merge_push_inline_source_fields(owner, node\as\frame, namespace_, index)
            status: lm_trans_merge_source_layout_name_from_call_new(node, namespace_, @ layout_name)
        else:
            status: lm_trans_merge_source_layout_name_from_call_new(node, namespace_, @ layout_name)

    ---
    if: status < 0
        return: 1
    if: status = 0 || layout_name = 0
        c.fprintf(c.stderr, "trans L2 merge error: source must be a layout atom, inline named structure, or call returning a layout\n")
        return: 1
return: lm_trans_merge_push_source_layout_fields(owner, layout_name, namespace_, index)

fn: lm_trans_declare_merge_named_structure_layout (
    @: LmTransNamespace namespace_
    const: @(LmP0Frame frame)
) int
    const: @: LmP0Structure sources
    const: @: LmP0Structure body
    const: @: LmP0Field field
    const: @: LmP0Text target
    @: LmTransL4CallableType field_type
    const: @: LmP0Text name
    const: @: LmP0Field initializer
    size_t: index

    if: namespace_ = 0 || frame = 0 || lm_trans_frame_looks_merge_named_structure_declaration(frame) = 0
        c.fprintf(c.stderr, "trans L2 merge error: merge expects (sources...) targetName and an optional body\n")
        return: 1

    target: lm_trans_merge_target_name(frame)
    if: lm_trans_declare_named_structure_owner(namespace_, target) != 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    index: 0U
    sources: lm_trans_merge_source_list(frame)
    field: sources\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: lm_trans_merge_push_source_node_fields(target, field\value, namespace_, @ index) != 0
                return: 1
        ---
        field: field\next

    body: lm_trans_merge_local_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_named_structure_field_info(field\value\as\frame, namespace_, field_type, @ name, @ initializer) = 0
                return: 1
            if: lm_trans_named_structure_push_field_relations(target, name, field_type, index) != 0
                return: 1
            index: index + 1U
        field: field\next
return: 0

fn: lm_trans_emit_merge_named_structure_typedef (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    const: @(LmTransNamespace namespace_)
) int
    const: @: LmP0Text target
    @: char layout_name

    target: lm_trans_merge_target_name(frame)
    if: file = 0 || target = 0
        return: 1

    layout_name: lm_trans_prefixed_identifier_name_new("", target, "")
    if: layout_name = 0
        return: 1
    finally: lm_own_delete(layout_name, 0)

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "typedef struct ") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, " {\n") != 0 || lm_trans_emit_layout_fields(file, layout_name, namespace_, indent + 1U) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "} ") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_merge_named_structure_storage (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
    const: @(char qualifier)
) int
    const: @: LmP0Text target
    @: char storage_name
    @: char pointer_name

    target: lm_trans_merge_target_name(frame)
    if: file = 0 || namespace_ = 0 || target = 0
        return: 1

    storage_name: lm_trans_prefixed_identifier_name_new("lm_", target, "_storage")
    if: storage_name = 0
        return: 1
    finally: lm_own_delete(storage_name, 0)

    pointer_name: lm_trans_prefixed_identifier_name_new("lm_", target, "")
    if: pointer_name = 0
        return: 1
    finally: lm_own_delete(pointer_name, 0)

    if: lm_trans_emit_indent(file, indent) != 0 || (qualifier != 0 && lm_trans_put(file, qualifier) != 0) || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_put(file, storage_name) != 0 || lm_trans_emit_named_structure_body_initializer(file, lm_trans_merge_local_body(frame), namespace_) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || (qualifier != 0 && lm_trans_put(file, qualifier) != 0) || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, " *") != 0 || lm_trans_put(file, pointer_name) != 0 || lm_trans_put(file, " = &") != 0 || lm_trans_put(file, storage_name) != 0 || lm_trans_put(file, ";\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_assignment_target (@: FILE file; const: @(LmP0Text target)) int
    size_t: i
    size_t: deref_depth
    @: LmP0Text target_payload
    @: LmP0Text target_path
    int: is_c_reference_path

    target_payload: lm_trans_statement_text_new()
    if: target_payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ target_payload)

    target_path: lm_trans_statement_text_new()
    if: target_path = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ target_path)

    if: lm_trans_identifier_payload(target, target_payload) = 0
        return: 1

    deref_depth: 0U
    while: deref_depth < target_payload\length && target_payload\data[deref_depth] = '\\'
        deref_depth: deref_depth + 1U

    target_path\data: target_payload\data + deref_depth
    target_path\length: target_payload\length - deref_depth
    if: target_path\length = 0U
        c.fprintf(c.stderr, "trans L2 error: dereferenced assignment target expects a binding or field-follow path\n")
        return: 1

    is_c_reference_path: lm_trans_is_c_reference_name(target_path)
    if: is_c_reference_path = 0 && lm_trans_text_contains_char(target_path, '.')
        c.fprintf(c.stderr, "trans L2 error: dot belongs only to c.* ANSI C surface names; use \\ for Lingvamyxa structures\n")
        return: 1

    while: deref_depth > 0U
        if: lm_trans_put(file, "*") != 0
            return: 1
        deref_depth: deref_depth - 1U

    if: target_payload\length != target_path\length && lm_trans_put(file, "(") != 0
        return: 1

    i: 0U
    if: is_c_reference_path
        i: 2U
    while: i < target_path\length
        if: target_path\data[i] = '\\' && lm_trans_put(file, "->") != 0
            return: 1
        if: target_path\data[i] != '\\' && lm_trans_write_all(file, target_path\data + i, 1U) != 0
            return: 1
        i: i + 1U

    if: target_payload\length != target_path\length && lm_trans_put(file, ")") != 0
        return: 1
return: 0

fn: lm_trans_emit_target_assignment (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    const: @(LmTransNamespace namespace_)
) int
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_assignment_target(file, frame\head) != 0
        return: 1
    if: lm_trans_put(file, " = ") != 0
        return: 1
    if: lm_trans_emit_expr_fields(file, frame\body\first_field, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_assignment (
    @: FILE file
    const: @(LmP0Frame frame)
    unsigned: indent
    const: @(LmTransNamespace namespace_)
) int
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_identifier(file, frame\head) != 0
        return: 1
    if: lm_trans_put(file, " = ") != 0
        return: 1
    if: lm_trans_emit_expr_fields(file, frame\body\first_field, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_struct_field_with_qualifier (
    @: FILE file
    const: @(LmP0Node node)
    unsigned: indent
    const: @(char qualifier)
) int
    const: @: LmP0Node current
    const: @: LmP0Frame frame
    const: @: LmP0Field type_field
    const: @: LmP0Field name_field
    const: @: LmP0Node name_node
    const: @: char current_qualifier

    current: node
    current_qualifier: qualifier
    while: 1
        if: lm_trans_node_is_ignored(current)
            return: 0

        if: current = 0 || current\kind != c.LM_P0_NODE_FRAME
            c.fprintf(c.stderr, "trans L2 error: structure field must be a named field\n")
            return: 1

        frame: current\as\frame
        if: lm_trans_text_equals(frame\head, "const") = 0
            break
        name_field: frame\body\first_field
        if: name_field = 0 || name_field\next != 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_FRAME
            c.fprintf(c.stderr, "trans L2 error: const structure field expects exactly one field declaration\n")
            return: 1
        current_qualifier: "const "
        current: name_field\value

    if: lm_trans_text_all_char(frame\head, '@')
        type_field: lm_trans_nth_field(frame\body, 0U)
        name_field: lm_trans_nth_field(frame\body, 1U)
        if: type_field = 0 || name_field = 0 || name_field\next != 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: pointer structure field expects type and name\n")
            return: 1
        name_node: name_field\value
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        if: current_qualifier != 0 && lm_trans_put(file, current_qualifier) != 0
            return: 1
        if: lm_trans_emit_type_and_name(file, type_field\value, name_node\as\atom, frame\head\length, 0) != 0
            return: 1
        return: lm_trans_put(file, ";\n")

    name_field: lm_trans_nth_field(frame\body, 0U)
    if: name_field = 0 || name_field\next != 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: structure field expects Type: name\n")
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: current_qualifier != 0 && lm_trans_put(file, current_qualifier) != 0
        return: 1
    if: lm_trans_emit_name(file, frame\head) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_emit_identifier(file, name_field\value\as\atom) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_struct_field (
    @: FILE file
    const: @(LmP0Node node)
    unsigned: indent
) int
return: lm_trans_emit_struct_field_with_qualifier(file, node, indent, "")

fn: lm_trans_emit_function_return_structure (
    @: FILE file
    const: @(LmP0Text function_name)
    const: @(LmP0Node return_node)
) int
    const: @: LmP0Field field

    if: return_node = 0 || return_node\kind != c.LM_P0_NODE_STRUCTURE
        c.fprintf(c.stderr, "trans L2 error: fm expects a return Structure\n")
        return: 1

    if: lm_trans_put(file, "typedef struct ") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, ";\n\nstruct ") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, " {\n") != 0
        return: 1

    field: return_node\as\structure\first_field
    if: field = 0
        c.fprintf(c.stderr, "trans L2 error: fm return Structure must not be empty\n")
        return: 1
    while: field != 0
        if: lm_trans_emit_struct_field(file, field\value, 1U) != 0
            return: 1
        field: field\next
return: lm_trans_put(file, "};\n\n")

fn: lm_trans_emit_function_return_structure_once (
    @: FILE file
    const: @(LmP0Text function_name)
    const: @(LmP0Node return_node)
) int
    @: char type_name
    const: @: char stored_name

    type_name: lm_trans_function_return_struct_type_name_new(function_name)
    if: type_name = 0
        return: 1

    stored_name: lm_trans_string_stack_find(lm_trans_emitted_function_return_structs, type_name)
    if: stored_name != 0
        lm_own_delete(type_name, 0)
        return: 0

    if: lm_trans_emit_function_return_structure(file, function_name, return_node) != 0
        lm_own_delete(type_name, 0)
        return: 1

    if: lm_own_ptr_stack_push(lm_trans_emitted_function_return_structs, type_name) != 0
        lm_own_delete(type_name, 0)
        return: 1
return: 0

sub: lm_trans_statement_stack_destroy (@: LmTransStatementStack stack)
    if: stack != 0
        lm_trans_ptr_stack_delete(@ stack\jobs)
end: lm_trans_statement_stack_destroy

fn: lm_trans_statement_stack_push (@: LmTransStatementStack stack; @: LmTransStatementJob job) int
    if: stack = 0 || stack\jobs = 0 || job = 0
        return: 1
return: lm_own_ptr_stack_push(stack\jobs, job)

fn: lm_trans_statement_stack_push_list (
    @: LmTransStatementStack stack
    const: @(LmP0Field field)
    unsigned: indent
    int: unwrap_single_structure
    const: @(LmP0Frame repeat_frame)
) int
    @: LmTransStatementJob job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: @lm_trans_statement_job_emit_list
    job\destroy: @lm_trans_statement_job_destroy_list
    job\list: (cast: (@: LmTransStatementListJob) lm_own_new_zero(c.sizeof(job\list[0])))
    if: job\list = 0
        lm_trans_statement_job_delete(job)
        return: 1
    job\list\field: field
    job\list\indent: indent
    job\list\unwrap_single_structure: unwrap_single_structure
    job\list\repeat_frame: repeat_frame
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_stack_push_node (
    @: LmTransStatementStack stack
    const: @(LmP0Node node)
    unsigned: indent
    const: @(LmP0Frame repeat_frame)
) int
    @: LmTransStatementJob job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: @lm_trans_statement_job_emit_node
    job\destroy: @lm_trans_statement_job_destroy_node
    job\node: (cast: (@: LmTransStatementNodeJob) lm_own_new_zero(c.sizeof(job\node[0])))
    if: job\node = 0
        lm_trans_statement_job_delete(job)
        return: 1
    job\node\node: node
    job\node\indent: indent
    job\node\repeat_frame: repeat_frame
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_stack_push_frame_job (
    @: LmTransStatementStack stack
    LmTransStatementJobHandler: handler
    const: @(LmP0Frame frame)
    unsigned: indent
) int
    @: LmTransStatementJob job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: handler
    job\destroy: @lm_trans_statement_job_destroy_frame
    job\frame: (cast: (@: LmTransStatementFrameJob) lm_own_new_zero(c.sizeof(job\frame[0])))
    if: job\frame = 0
        lm_trans_statement_job_delete(job)
        return: 1
    job\frame\frame: frame
    job\frame\indent: indent
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_stack_push_simple (
    @: LmTransStatementStack stack
    LmTransStatementJobHandler: handler
) int
    @: LmTransStatementJob job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: handler
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_stack_push_indent_text (
    @: LmTransStatementStack stack
    unsigned: indent
    const: @(char text)
) int
    @: LmTransStatementJob job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: @lm_trans_statement_job_emit_indent_text
    job\destroy: @lm_trans_statement_job_destroy_text
    job\text: (cast: (@: LmTransStatementTextJob) lm_own_new_zero(c.sizeof(job\text[0])))
    if: job\text = 0
        lm_trans_statement_job_delete(job)
        return: 1
    job\text\indent: indent
    job\text\text: text
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_stack_push_scope_cleanups (
    @: LmTransStatementStack stack
    unsigned: indent
) int
    @: LmTransStatementJob job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: @lm_trans_statement_job_emit_scope_cleanups
    job\destroy: @lm_trans_statement_job_destroy_text
    job\text: (cast: (@: LmTransStatementTextJob) lm_own_new_zero(c.sizeof(job\text[0])))
    if: job\text = 0
        lm_trans_statement_job_delete(job)
        return: 1
    job\text\indent: indent
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_list_first_field (
    const: @(LmP0Field first)
    int: unwrap_single_structure
) const: @: LmP0Field
    if: unwrap_single_structure && first != 0 && first\next = 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_STRUCTURE
        return: first\value\as\structure\first_field
return: first

fn: lm_trans_statement_frame_is_repeatable (
    const: @(LmP0Frame frame)
    const: @(LmTransNamespace namespace_)
) int
    if: frame = 0
        return: 0
    if: lm_trans_frame_looks_storage_declaration(frame, namespace_)
        return: 1
    if: lm_trans_text_all_char(frame\head, '@') && frame\body\first_field != 0
        return: 1
    if: lm_trans_text_is_array_receiver_head(frame\head) && frame\body\first_field != 0
        return: 1
return: 0

fn: lm_trans_statement_stack_schedule_control (
    @: FILE file
    @: LmTransStatementStack stack
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
    const: @(char keyword)
) int
    const: @: LmP0Field body_start
    int: is_loop
    int: status

    is_loop: c.strcmp(keyword, "while") = 0
    body_start: lm_trans_control_body_start(frame)
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, keyword) != 0 || lm_trans_put(file, " (") != 0 || lm_trans_emit_control_condition(file, frame, namespace_) != 0 || lm_trans_put(file, ") {\n") != 0
        return: 1

    lm_trans_namespace_enter_scope(namespace_)
    if: is_loop && lm_trans_loop_push(namespace_) != 0
        lm_trans_namespace_leave_scope(namespace_)
        return: 1

    status: lm_trans_statement_stack_push_indent_text(stack, indent, "}\n")
    if: status = 0
        status: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_leave_scope)
    if: status = 0 && is_loop
        status: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_loop_pop)
    if: status = 0
        status: lm_trans_statement_stack_push_scope_cleanups(stack, indent + 1U)
    if: status = 0
        status: lm_trans_statement_stack_push_list(stack, body_start, indent + 1U, 1, 0)

    if: status != 0
        if: is_loop
            lm_trans_loop_pop(namespace_)
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
return: 0

fn: lm_trans_statement_stack_schedule_synchronized (
    @: FILE file
    @: LmTransStatementStack stack
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
    const: @: LmP0Field body_start
    unsigned: cleanup_id
    int: status

    if: frame = 0 || frame\body\first_field = 0
        c.fprintf(c.stderr, "trans L2 error: synchronized expects an object expression\n")
        return: 1

    cleanup_id: namespace_\next_cleanup_id
    namespace_\next_cleanup_id: namespace_\next_cleanup_id + 1U
    body_start: lm_trans_control_body_start(frame)
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "void *") != 0 || lm_trans_emit_sync_name(file, cleanup_id) != 0 || lm_trans_put(file, " = (void *)(") != 0 || lm_trans_emit_control_condition(file, frame, namespace_) != 0 || lm_trans_put(file, ");\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "lm_synchronized_enter(") != 0 || lm_trans_emit_sync_name(file, cleanup_id) != 0 || lm_trans_put(file, ");\n") != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "{\n") != 0
        return: 1

    lm_trans_namespace_enter_scope(namespace_)
    if: lm_trans_cleanup_push(namespace_, cleanup_id) != 0
        lm_trans_namespace_leave_scope(namespace_)
        return: 1

    status: lm_trans_statement_stack_push_indent_text(stack, indent, "}\n")
    if: status = 0
        status: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_leave_scope)
    if: status = 0
        status: lm_trans_statement_stack_push_scope_cleanups(stack, indent + 1U)
    if: status = 0
        status: lm_trans_statement_stack_push_list(stack, body_start, indent + 1U, 1, 0)

    if: status != 0
        lm_trans_cleanup_pop(namespace_)
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
return: 0

fn: lm_trans_statement_stack_schedule_else (
    @: FILE file
    @: LmTransStatementStack stack
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
    int: status

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "else {\n") != 0
        return: 1

    lm_trans_namespace_enter_scope(namespace_)
    status: lm_trans_statement_stack_push_indent_text(stack, indent, "}\n")
    if: status = 0
        status: lm_trans_statement_stack_push_simple(stack, @lm_trans_statement_job_leave_scope)
    if: status = 0
        status: lm_trans_statement_stack_push_scope_cleanups(stack, indent + 1U)
    if: status = 0
        status: lm_trans_statement_stack_push_list(stack, frame\body\first_field, indent + 1U, 1, 0)
    if: status != 0
        lm_trans_namespace_leave_scope(namespace_)
        return: 1
return: 0

fn: lm_trans_statement_stack_schedule_named_structure (
    @: FILE file
    @: LmTransStatementStack stack
    const: @(LmP0Frame frame)
    unsigned: indent
    @: LmTransNamespace namespace_
) int
    int: had_layout

    if: stack != 0 && stack = 0
        return: 1
    had_layout: lm_trans_namespace_registry_lookup(namespace_, frame\head, "layout.backend") != 0
    if: lm_trans_declare_named_structure_layout(namespace_, frame) != 0
        return: 1
    if: had_layout = 0 && lm_trans_emit_named_structure_typedef(file, frame, indent, namespace_) != 0
        return: 1
return: lm_trans_emit_named_structure_storage(file, frame, indent, namespace_, "")

fn: lm_trans_statement_stack_schedule_merge_named_structure (
