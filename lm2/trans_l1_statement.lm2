    if: existing_symbol != 0 && existing_symbol\depth = namespace_\depth
        c.fprintf(c.stderr, "trans hosted C backend limitation: repeated local runtime Table binding \"%.*s\" in one lexical scope requires occurrence-aware value projection\n", (cast: int table_name\length), table_name\data)
        return: 1

    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_table_read_columns(frame, @ column_types, @ column_names, @ column_count) != 0
        return: 1

    rows_frame: lm_trans_l2_table_rows_frame(frame)
    if: rows_frame = 0 || lm_trans_l2_table_row_count(rows_frame, column_count, @ row_count, table_name) != 0
        return: 1

    row_type_name: lm_trans_l2_runtime_table_row_type_name_new(table_name, namespace_)
    if: row_type_name = 0
        return: 1
    finally: lm_own_delete(row_type_name, 0)
    value_name: lm_trans_l2_object_suffix_name_new(row_type_name, "_value")
    if: value_name = 0
        return: 1
