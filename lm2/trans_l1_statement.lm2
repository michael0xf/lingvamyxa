fn: lm_trans_statement_lowering_from_head (
    const: LmP0Text: head
    const: LmTransNamespace: namespace_
    LmTransStatementLowering: out
) int
    LmTransHeadBinding: binding

    if: out = 0
        return: 0

    binding: lm_trans_statement_head_binding_new()
    if: binding = 0
        return: 0
    finally: lm_own_delete(binding, 0)

    if: lm_trans_head_binding_resolve(namespace_, head, binding) != 0
        return: 0
    if: binding\statement_frame = 0
        return: 0

    out\emit: binding\statement_frame
return: 1

fn: lm_trans_statement_canonical_receiver_head_new (const: LmP0Text: head) LmP0Text
    if: lm_trans_text_all_char(head, '@')
        return: lm_trans_text_from_cstr("@")
    if: lm_trans_text_is_array_receiver_head(head)
        return: lm_trans_text_from_cstr("[]")
return: 0

fn: lm_trans_lower_statement_frame (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
    LmTransStatementLowering: out
) int
    const: LmTransSymbol: symbol
    LmP0Text: dispatch_head
    LmP0Text: family_head

    if: frame = 0 || out = 0
        return: 1

    dispatch_head: frame\head
    family_head: 0
    finally: lm_trans_text_ref_destroy(@ family_head)

    symbol: lm_trans_namespace_find(namespace_, frame\head)
    if: symbol = 0
        family_head: lm_trans_statement_canonical_receiver_head_new(frame\head)
        if: family_head != 0
            symbol: lm_trans_namespace_find(namespace_, family_head)
            if: symbol != 0
                dispatch_head: family_head
            ---
        ---
    ---

    if: lm_trans_l3_receiver_is_excluded(namespace_, dispatch_head)
        c.fprintf(c.stderr, "trans L3 error: receiver \"%.*s\" is not available in L3\n", (cast: int dispatch_head\length), dispatch_head\data)
        return: 1

    if: lm_trans_frame_looks_named_structure_construction(frame, namespace_)
        out\emit: @lm_trans_statement_emit_named_structure_construction
        return: 0

    if: (lm_trans_namespace_layout_source_is_supported(namespace_, frame\head) || lm_trans_namespace_has_named_structure_binding(namespace_, frame\head)) && lm_trans_frame_looks_storage_declaration(frame, namespace_)
        out\emit: @lm_trans_statement_emit_storage_declaration
        return: 0

    if: symbol != 0
        if: symbol\callable_is_thread_handler
            c.fprintf(c.stderr, "trans L2 error: thread handler \"%.*s\" cannot be called directly; send a message to its route\n", (cast: int frame\head\length), frame\head\data)
            return: 1
        if: lm_trans_symbol_is(symbol, "receiver.statement")
            if: lm_trans_text_equals(dispatch_head, "@")
                out\emit: @lm_trans_statement_emit_pointer_declaration
                return: 0
            if: lm_trans_statement_lowering_from_head(dispatch_head, namespace_, out)
                return: 0
            c.fprintf(c.stderr, "trans registry inconsistency: receiver.statement \"%.*s\" has no statement binding\n", (cast: int dispatch_head\length), dispatch_head\data)
            return: 1
        if: lm_trans_symbol_is(symbol, "receiver.function")
            out\emit: @lm_trans_statement_emit_nested_function
            return: 0
        if: lm_trans_symbol_is_executable_callable(symbol)
            out\emit: @lm_trans_statement_emit_call
            return: 0
        if: lm_trans_symbol_is(symbol, "variable")
            out\emit: @lm_trans_statement_emit_assignment
            return: 0
        if: lm_trans_symbol_is(symbol, "structureConstructor")
            if: lm_trans_frame_looks_named_structure_layout_declaration(frame, namespace_)
                out\emit: @lm_trans_statement_emit_named_structure
                return: 0
            c.fprintf(c.stderr, "trans L2 error: Structure descriptor \"%.*s\" is not a runtime value or callable receiver\n", (cast: int frame\head\length), frame\head\data)
            return: 1
        if: lm_trans_symbol_is(symbol, "class") || lm_trans_symbol_is(symbol, "callableDescriptor")
            if: lm_trans_frame_looks_storage_declaration(frame, namespace_)
                out\emit: @lm_trans_statement_emit_storage_declaration
                return: 0
            c.fprintf(c.stderr, "trans L2 error: \"%.*s\" is %s, not a declaration frame\n", (cast: int frame\head\length), frame\head\data, lm_trans_symbol_class_name(symbol\class_name))
            return: 1
        ---
    ---

    if: lm_trans_head_looks_assignable_target(frame\head)
        out\emit: @lm_trans_statement_emit_target_assignment
        return: 0
    if: lm_trans_is_c_reference_name(frame\head)
        if: lm_trans_statement_lowering_from_head(frame\head, namespace_, out)
            return: 0
        out\emit: @lm_trans_statement_emit_call
        return: 0
    if: symbol = 0 && lm_trans_statement_lowering_from_head(frame\head, namespace_, out)
        return: 0
    if: lm_trans_frame_looks_storage_declaration(frame, namespace_)
        out\emit: @lm_trans_statement_emit_storage_declaration
        return: 0
    if: lm_trans_frame_looks_named_structure_declaration(frame)
        out\emit: @lm_trans_statement_emit_named_structure
        return: 0

    if: symbol = 0
        c.fprintf(c.stderr, "trans L2 statement error: unknown Lingvamyxa name \"%.*s\"; use c.%.*s for explicit C-surface spelling\n", (cast: int frame\head\length), frame\head\data, (cast: int frame\head\length), frame\head\data)
        return: 1

    c.fprintf(c.stderr, "trans L2 error: \"%.*s\" is %s, not a statement head\n", (cast: int frame\head\length), frame\head\data, lm_trans_symbol_class_name(symbol\class_name))
return: 1

fn: lm_trans_emit_loop_jump_statement (
    FILE: file
    const: LmP0Text: spelling
    unsigned: indent
    LmTransNamespace: namespace_
) int
    if: lm_trans_emit_cleanups_until(file, indent, namespace_, lm_trans_loop_cleanup_base(namespace_)) != 0
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_write_text(file, spelling) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_statement_stack_emit_frame_lowering (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
    const: LmTransStatementLowering: lowering
) int
    if: lowering = 0 || lowering\emit = 0
        return: 1
return: lowering\emit(file, stack, frame, indent, namespace_)

fn: lm_trans_statement_stack_emit_frame (
    FILE: file
    LmTransStatementStack: stack
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    int: status
    LmTransStatementLowering: lowering

    status: lm_trans_statement_stack_push_frame_job(stack, @lm_trans_statement_job_emit_trailer, frame, indent)
    if: status = 0
        status: lm_trans_statement_stack_push_frame_job(stack, @lm_trans_statement_job_validate_end, frame, indent)
    if: status != 0
        return: 1

    lowering: lm_trans_statement_lowering_new()
    if: lowering = 0
        return: 1
    finally: lm_own_delete(lowering, 0)

    if: lm_trans_lower_statement_frame(frame, namespace_, lowering) != 0
        return: 1
return: lm_trans_statement_stack_emit_frame_lowering(file, stack, frame, indent, namespace_, lowering)

