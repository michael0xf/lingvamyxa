    column_types: 0
    column_names: 0
    column_count: 0U
    finally: lm_trans_l2_table_columns_destroy(column_types, column_names, column_count)
    if: lm_trans_l2_source_read_columns(body, "join", @ column_types, @ column_names, @ column_count) != 0
        return: 1

    row_count: 0U
    if: rows_frame != 0 && lm_trans_l2_table_row_count(rows_frame, column_count, @ row_count, target_name) != 0
        return: 1
return: 0

fn: lm_trans_merge_source_list (const: (LmP0Frame: frame)) const: LmP0Structure
    const: LmP0Field: field

    if: frame = 0 || lm_trans_text_equals(frame\head, "merge") = 0
        return: 0
    field: lm_trans_nth_field(frame\body, 0U)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
return: field\value\as\structure

fn: lm_trans_merge_target_name (const: (LmP0Frame: frame)) const: LmP0Text
    const: LmP0Field: field

    if: frame = 0 || lm_trans_text_equals(frame\head, "merge") = 0
        return: 0
    field: lm_trans_nth_field(frame\body, 1U)
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: field\value\as\atom

fn: lm_trans_merge_local_body (const: (LmP0Frame: frame)) const: LmP0Structure
    const: LmP0Field: field

    if: frame = 0
        return: 0
    field: lm_trans_nth_field(frame\body, 2U)
    if: field = 0
        return: 0
    if: field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
return: field\value\as\structure

fn: lm_trans_frame_looks_merge_named_structure_declaration (const: (LmP0Frame: frame)) int
    const: LmP0Structure: sources
    const: LmP0Text: target

    sources: lm_trans_merge_source_list(frame)
    target: lm_trans_merge_target_name(frame)
return: sources != 0 && target != 0 && sources\first_field != 0 && lm_trans_atom_can_be_new_binding_name(target)

fn: lm_trans_merge_add_layout_descriptor_field (
    LmTransDescriptor: descriptor
    const: LmTransLayoutField: field
    size_t: index
) int
    LmP0Text: name
    LmP0Text: payload
    const: @: char payload_source

    if: descriptor = 0 || field = 0 || field\name = 0
        return: 1

    payload_source: field\class_name
    if: field\is_union
        payload_source: field\union_layout_name
    if: payload_source = 0
        return: 1

    name: lm_trans_text_from_cstr(field\name)
    if: name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ name)

    payload: lm_trans_text_from_cstr(payload_source)
    if: payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ payload)

return: lm_trans_descriptor_add_structural_field(descriptor, name, payload, index, field\address_depth, field\array_count, field\has_array_count, field\is_const, field\is_union)

fn: lm_trans_merge_source_layout_name_from_atom_new (
    const: LmP0Text: atom
    const: LmTransNamespace: namespace_
    @@: char out_name
) int
    LmP0Text: payload

    if: out_name != 0
        out_name[0]: 0
    if: atom = 0 || out_name = 0
        return: 0

    payload: lm_trans_statement_text_new()
    if: payload = 0
        return: -1
    finally: lm_trans_text_ref_destroy(@ payload)

    if: lm_trans_identifier_payload(atom, payload) = 0
        return: 0

    if: lm_trans_namespace_layout_source_is_supported(namespace_, payload) = 0 && lm_trans_namespace_has_named_structure_binding(namespace_, payload) = 0
        return: 0

    out_name[0]: lm_trans_text_copy_cstr(payload)
    if: out_name[0] != 0
        return: 1
return: -1

fn: lm_trans_merge_source_layout_name_from_call_new (
    const: LmP0Node: node
    const: LmTransNamespace: namespace_
    @@: char out_name
) int
    LmTransL4CallableType: type
    int: status

    if: out_name != 0
        out_name[0]: 0
    if: node = 0 || out_name = 0
        return: 0

    type: lm_trans_expr_callable_type_new()
    if: type = 0
        return: -1
    finally: lm_trans_expr_callable_type_delete(type)

    status: lm_trans_node_result_type(node, namespace_, type)
    if: status <= 0
        return: status
    if: type\address_depth != 0U || type\is_const
        return: 0

    if: lm_trans_namespace_layout_source_is_supported(namespace_, type\class_name) = 0 && lm_trans_namespace_has_named_structure_binding(namespace_, type\class_name) = 0
        return: 0

    out_name[0]: lm_trans_text_copy_cstr(type\class_name)
    if: out_name[0] != 0
        return: 1
return: -1

fn: lm_trans_merge_push_graph_descriptor_fields (
    LmTransDescriptor: descriptor
    const: LmTransDescriptor: source
    @: size_t index
) int
    size_t: i
    const: LmTransDescriptorField: field
    LmP0Text: name
    LmP0Text: type_name

    if: descriptor = 0 || source = 0 || index = 0 || source\structural_fields = 0
        return: 1
    i: 0U
    while: i < source\structural_fields\count
        field: lm_own_ptr_stack_at(source\structural_fields, i)
        if: field = 0 || field\name = 0 || field\descriptor_name = 0
            return: 1
        name: lm_trans_text_from_cstr(field\name)
        type_name: lm_trans_text_from_cstr(field\descriptor_name)
        if: name = 0 || type_name = 0
            lm_trans_text_ref_destroy(@ name)
            lm_trans_text_ref_destroy(@ type_name)
            return: 1
        if: lm_trans_descriptor_add_structural_field(descriptor, name, type_name, index[0], field\address_depth, field\array_count, field\has_array_count, field\is_const, field\is_union) != 0
            lm_trans_text_ref_destroy(@ name)
            lm_trans_text_ref_destroy(@ type_name)
            return: 1
        lm_trans_text_ref_destroy(@ name)
        lm_trans_text_ref_destroy(@ type_name)
        index[0]: index[0] + 1U
        i: i + 1U
return: 0

fn: lm_trans_merge_push_source_layout_fields (
    LmTransDescriptor: descriptor
    const: @(char layout_name)
    const: LmTransNamespace: namespace_
    @: size_t index
) int
    @: LmTransLayoutField fields
    size_t: field_capacity
    size_t: field_count
    size_t: i
    LmP0Text: layout_text
    const: LmTransDescriptor: source_descriptor

    if: descriptor = 0 || layout_name = 0 || index = 0
        return: 1
    layout_text: lm_trans_text_from_cstr(layout_name)
    if: layout_text = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ layout_text)
    source_descriptor: lm_trans_namespace_descriptor(namespace_, layout_text)
    if: source_descriptor != 0 && source_descriptor\has_structural_fields && source_descriptor\structural_fields != 0
        return: lm_trans_merge_push_graph_descriptor_fields(descriptor, source_descriptor, index)

    if: lm_trans_validate_layout_occurrence_projection_source(layout_name, namespace_) != 0
        return: 1

    field_capacity: 256U
    fields: lm_trans_layout_fields_new(field_capacity)
    if: fields = 0
        return: 1
    finally: lm_trans_layout_fields_delete(fields, field_capacity)

    if: lm_trans_collect_layout_fields(layout_name, namespace_, fields, field_capacity, @ field_count) != 0 || lm_trans_sort_layout_fields(fields, field_count) != 0
        return: 1

    i: 0U
    while: i < field_count
        if: lm_trans_merge_add_layout_descriptor_field(descriptor, fields[i], index[0]) != 0
            return: 1
        index[0]: index[0] + 1U
        i: i + 1U
return: 0

fn: lm_trans_merge_push_inline_source_fields (
    LmTransDescriptor: descriptor
    const: LmP0Frame: source
    const: LmTransNamespace: namespace_
    @: size_t index
) int
    const: LmP0Structure: body
    const: LmP0Field: field
    LmTransL4CallableType: field_type
    const: LmP0Text: name
    const: LmP0Field: initializer

    if: descriptor = 0 || source = 0 || index = 0 || lm_trans_frame_looks_named_structure_layout_declaration(source, namespace_) = 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    body: lm_trans_named_structure_body(source)
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: field\value\kind != c.LM_P0_NODE_FRAME
                return: 1
            if: lm_trans_frame_is_structure_callable_field(field\value\as\frame)
                name: lm_trans_structure_callable_field_name(field\value\as\frame)
                if: name = 0 || lm_trans_named_structure_type_set_cstr(field_type, "lm.trans.callable", 1U, 0) = 0
                    return: 1
                if: lm_trans_descriptor_add_structural_field(descriptor, name, field_type\class_name, index[0], field_type\address_depth, 0U, 0, 0, 0) != 0
                    return: 1
                ---
            else:
                if: lm_trans_named_structure_field_info_for_owner(field\value\as\frame, namespace_, source\head, field_type, @ name, @ initializer) = 0
                    return: 1
                if: initializer != 0
                    c.fprintf(c.stderr, "trans L2 merge descriptor error: field \"%.*s\" cannot contain an instance initializer; construct a value explicitly\n", (cast: int name\length), name\data)
                    return: 1
                if: lm_trans_identifier_same(field_type\class_name, source\head)
                    c.fprintf(c.stderr, "trans hosted C backend limitation: inline merge descriptor \"%.*s\" cannot project a self-referential field before that descriptor has a named type projection\n", (cast: int source\head\length), source\head\data)
                    return: 1
                if: lm_trans_named_structure_project_graph_field_type(field_type) = 0
                    return: 1
                if: lm_trans_descriptor_add_structural_field(descriptor, name, field_type\class_name, index[0], field_type\address_depth, 0U, 0, field_type\is_const, 0) != 0
                    return: 1
                ---
            ---
            index[0]: index[0] + 1U
        field: field\next
return: 0

fn: lm_trans_merge_push_source_node_fields (
    LmTransDescriptor: descriptor
    const: LmP0Node: node
    const: LmTransNamespace: namespace_
    @: size_t index
) int
    @: char layout_name
    int: status

    if: descriptor = 0 || node = 0 || index = 0
        return: 1

    layout_name: 0
    finally: lm_own_delete(layout_name, 0)

    status: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        status: lm_trans_merge_source_layout_name_from_atom_new(node\as\atom, namespace_, @ layout_name)
    else:
        if: node\kind = c.LM_P0_NODE_FRAME
            if: lm_trans_frame_looks_named_structure_layout_declaration(node\as\frame, namespace_)
                return: lm_trans_merge_push_inline_source_fields(descriptor, node\as\frame, namespace_, index)
            status: lm_trans_merge_source_layout_name_from_call_new(node, namespace_, @ layout_name)
        else:
            status: lm_trans_merge_source_layout_name_from_call_new(node, namespace_, @ layout_name)

    ---
    if: status < 0
        return: 1
    if: status = 0 || layout_name = 0
        c.fprintf(c.stderr, "trans L2 merge error: source must be a layout atom, inline named structure, or call returning a layout\n")
        return: 1
return: lm_trans_merge_push_source_layout_fields(descriptor, layout_name, namespace_, index)

fn: lm_trans_declare_merge_named_structure_layout_mode (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
    int: reject_hosted_redeclaration
) int
    const: LmP0Structure: sources
    const: LmP0Structure: body
    const: LmP0Field: field
    const: LmP0Text: target
    LmTransL4CallableType: field_type
    const: LmP0Text: name
    const: LmP0Field: initializer
    LmTransDescriptor: descriptor
    size_t: index
    @: char layout_c_type

    if: namespace_ = 0 || frame = 0 || lm_trans_frame_looks_merge_named_structure_declaration(frame) = 0
        c.fprintf(c.stderr, "trans L2 merge error: merge expects (sources...) targetName and an optional body\n")
        return: 1

    target: lm_trans_merge_target_name(frame)
    descriptor: lm_trans_descriptor_new()
    finally: lm_trans_descriptor_delete(descriptor)
    if: descriptor = 0 || lm_trans_descriptor_mark_structural_fields(descriptor) != 0
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    index: 0U
    sources: lm_trans_merge_source_list(frame)
    field: sources\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: lm_trans_merge_push_source_node_fields(descriptor, field\value, namespace_, @ index) != 0
                return: 1
        ---
        field: field\next

    body: lm_trans_merge_local_body(frame)
    field: 0
    if: body != 0
        field: body\first_field
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: field\value\kind != c.LM_P0_NODE_FRAME
                return: 1
            if: lm_trans_frame_is_structure_callable_field(field\value\as\frame)
                name: lm_trans_structure_callable_field_name(field\value\as\frame)
                if: name = 0 || lm_trans_named_structure_type_set_cstr(field_type, "lm.trans.callable", 1U, 0) = 0
                    return: 1
                if: lm_trans_descriptor_add_structural_field(descriptor, name, field_type\class_name, index, field_type\address_depth, 0U, 0, 0, 0) != 0
                    return: 1
                ---
            else:
                if: lm_trans_named_structure_field_info_for_owner(field\value\as\frame, namespace_, target, field_type, @ name, @ initializer) = 0
                    return: 1
                if: initializer != 0
                    c.fprintf(c.stderr, "trans L2 merge descriptor error: field \"%.*s\" cannot contain an instance initializer; construct a value explicitly\n", (cast: int name\length), name\data)
                    return: 1
                if: lm_trans_named_structure_project_graph_field_type(field_type) = 0
                    return: 1
                if: lm_trans_descriptor_add_structural_field(descriptor, name, field_type\class_name, index, field_type\address_depth, 0U, 0, field_type\is_const, 0) != 0
                    return: 1
                ---
            ---
            index: index + 1U
        field: field\next

    if: reject_hosted_redeclaration && lm_trans_hosted_descriptor_redeclaration_is_unsupported(namespace_, target, descriptor) != 0
        return: 1
    if: lm_trans_descriptor_payload_is_empty(descriptor)
        if: lm_trans_descriptor_set_class_relation(descriptor, "lm.trans.c.type", "LmLmxStructure") != 0
            return: 1
        ---
    else:
        if: lm_trans_descriptor_payload_is_graph_slots_for_owner(namespace_, descriptor, target)
            layout_c_type: lm_trans_graph_layout_c_type_new(target)
            if: layout_c_type = 0
                return: 1
            if: lm_trans_descriptor_set_class_relation(descriptor, "lm.trans.c.type", layout_c_type) != 0
                lm_own_delete(layout_c_type, 0)
                return: 1
            lm_own_delete(layout_c_type, 0)
        ---
    ---
    if: lm_trans_bind_named_structure_descriptor(namespace_, target, @ descriptor) != 0
        return: 1
return: 0


fn: lm_trans_declare_merge_named_structure_layout (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
return: lm_trans_declare_merge_named_structure_layout_mode(namespace_, frame, 0)

fn: lm_trans_declare_hosted_merge_named_structure_layout (
    LmTransNamespace: namespace_
    const: LmP0Frame: frame
) int
return: lm_trans_declare_merge_named_structure_layout_mode(namespace_, frame, 1)

fn: lm_trans_emit_graph_layout_fields_from_descriptor (
    FILE: file
    const: LmTransDescriptor: descriptor
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    size_t: i
    const: LmTransDescriptorField: field
    LmTransL4CallableType: field_type
    LmP0Text: projected_name_text
    @: char projected_name

    if: file = 0 || descriptor = 0 || descriptor\structural_fields = 0
        return: 1
    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)
    i: 0U
    while: i < descriptor\structural_fields\count
        field: lm_own_ptr_stack_at(descriptor\structural_fields, i)
        if: field = 0 || lm_trans_descriptor_field_is_callable(field)
            i: i + 1U
            continue
        if: lm_trans_named_structure_type_set_cstr(field_type, field\descriptor_name, field\address_depth, field\is_const) = 0
            return: 1
        projected_name: lm_trans_descriptor_projected_member_name_new(descriptor, field)
        if: projected_name = 0
            return: 1
        projected_name_text: lm_trans_text_from_cstr(projected_name)
        if: projected_name_text = 0
            lm_own_delete(projected_name, 0)
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_emit_callable_type_named(file, field_type, projected_name_text, namespace_) != 0 || lm_trans_put(file, ";\n") != 0
            lm_trans_text_ref_destroy(@ projected_name_text)
            lm_own_delete(projected_name, 0)
            return: 1
        lm_trans_text_ref_destroy(@ projected_name_text)
        lm_own_delete(projected_name, 0)
        i: i + 1U
return: 0

fn: lm_trans_emit_merge_named_structure_typedef (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    const: LmP0Text: target
    @: char layout_name
    const: LmTransDescriptor: descriptor

    target: lm_trans_merge_target_name(frame)
    if: file = 0 || target = 0
        return: 1
    descriptor: lm_trans_namespace_descriptor(namespace_, target)
    if: lm_trans_named_structure_uses_graph_header(namespace_, target)
        if: lm_trans_emit_structure_graph_header(lm_trans_prelude_file(file)) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct lm_lmx_layout_") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, ";\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct lm_lmx_layout_") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, " {\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "LmLmxStructure *descriptor;\n") != 0
            return: 1
        if: lm_trans_emit_graph_layout_fields_from_descriptor(file, descriptor, indent + 1U, namespace_) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "};\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "static LmLmxStructure lm_lmx_desc_") != 0 || lm_trans_emit_identifier(file, target) != 0
            return: 1
        return: lm_trans_put(file, ";\n")

    layout_name: lm_trans_prefixed_identifier_name_new("", target, "")
    if: layout_name = 0
        return: 1
    finally: lm_own_delete(layout_name, 0)

    if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct ") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "typedef struct ") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, ";\n") != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "struct ") != 0 || lm_trans_emit_identifier(file, target) != 0 || lm_trans_put(file, " {\n") != 0 || lm_trans_emit_layout_fields(file, layout_name, namespace_, indent + 1U) != 0 || lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "};\n") != 0
        return: 1
return: 0

fn: lm_trans_emit_assignment_field_segment (
    FILE: file
    const: LmP0Text: segment
    LmP0Text: current_class
    const: LmTransNamespace: namespace_
) int
    LmP0Text: field_name
    LmP0Text: projected_name_text
    const: LmTransDescriptor: descriptor
    const: LmTransDescriptorField: descriptor_field
    @: char projected_name
    @: char descriptor_field_name
    size_t: occurrence
    size_t: occurrence_count
    int: has_occurrence
    int: status

    field_name: lm_trans_statement_text_new()
    projected_name_text: 0
    projected_name: 0
    descriptor_field_name: 0
    if: field_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ field_name)
    finally: lm_trans_text_ref_destroy(@ projected_name_text)
    finally: lm_own_delete(projected_name, 0)
    finally: lm_own_delete(descriptor_field_name, 0)

    if: lm_trans_field_chain_segment_parse(segment, field_name, @ has_occurrence, @ occurrence) = 0
        if: segment != 0 && segment\length != 0U && segment\data[0] = '['
            c.fprintf(c.stderr, "trans hosted C backend limitation: occurrence-qualified field follow requires a compile-time non-negative decimal ordinal\n")
        else:
            c.fprintf(c.stderr, "trans L2 error: malformed assignment field-follow segment\n")
        return: 1

    status: 0
    if: current_class != 0 && current_class\length != 0U
        status: lm_trans_field_chain_member_resolve(namespace_, current_class, field_name, has_occurrence, occurrence, @ descriptor, @ descriptor_field, @ projected_name)

    if: status < 0
        return: 1
    if: status = 0 && has_occurrence
        occurrence_count: 0U
        descriptor: lm_trans_namespace_descriptor(namespace_, current_class)
        if: descriptor != 0
            descriptor_field_name: lm_trans_descriptor_name_copy(field_name)
            if: descriptor_field_name = 0
                return: 1
            occurrence_count: lm_trans_descriptor_structural_field_occurrence_count(descriptor, descriptor_field_name)
        ---
        c.fprintf(c.stderr, "trans L2 field access error: field \"%.*s\" has no occurrence %zu (matching occurrence count: %zu)\n", (cast: int field_name\length), field_name\data, occurrence, occurrence_count)
        return: 1

    if: status = 0
        if: current_class != 0
            current_class\data: ""
            current_class\length: 0U
        return: lm_trans_emit_identifier(file, field_name)

    projected_name_text: lm_trans_text_from_cstr(projected_name)
    if: projected_name_text = 0 || descriptor_field = 0 || descriptor_field\descriptor_name = 0
        return: 1
    if: lm_trans_emit_identifier(file, projected_name_text) != 0
        return: 1
    if: lm_trans_text_assign_cstr(current_class, descriptor_field\descriptor_name) = 0
        return: 1
return: 0

fn: lm_trans_emit_assignment_target (
    FILE: file
    const: LmP0Text: target
    const: LmTransNamespace: namespace_
) int
    size_t: i
    size_t: close_index
    size_t: deref_depth
    size_t: root_end
    size_t: field_end
    LmP0Text: index_expression
    LmP0Text: target_payload
    LmP0Text: target_path
    LmP0Text: root
    LmP0Text: segment
    LmP0Text: current_class
    LmP0Text: array_element_type
    size_t: array_rank
    size_t: array_index_count
    unsigned: array_helper_id
    int: array_helper_id_found
    int: is_c_reference_path

    index_expression: lm_trans_statement_text_new()
    if: index_expression = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ index_expression)

    target_payload: lm_trans_statement_text_new()
    if: target_payload = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ target_payload)

    target_path: lm_trans_statement_text_new()
    if: target_path = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ target_path)

    root: lm_trans_statement_text_new()
    if: root = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ root)

    segment: lm_trans_statement_text_new()
    if: segment = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ segment)

    current_class: lm_trans_statement_text_new()
    if: current_class = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ current_class)

    array_element_type: lm_trans_statement_text_new()
    if: array_element_type = 0
        lm_trans_text_ref_destroy(@ array_element_type)
        return: 1
    finally: lm_trans_text_ref_destroy(@ array_element_type)

    if: lm_trans_identifier_payload(target, target_payload) = 0
        return: 1

    deref_depth: 0U
    while: deref_depth < target_payload\length && target_payload\data[deref_depth] = '\\'
        deref_depth: deref_depth + 1U

    target_path\data: target_payload\data + deref_depth
    target_path\length: target_payload\length - deref_depth
    if: target_path\length = 0U
        c.fprintf(c.stderr, "trans L2 error: dereferenced assignment target expects a binding or field-follow path\n")
        return: 1

    is_c_reference_path: lm_trans_is_c_reference_name(target_path)
    if: is_c_reference_path = 0 && lm_trans_text_contains_char(target_path, '.')
        c.fprintf(c.stderr, "trans L2 error: dot belongs only to c.* ANSI C surface names; use \\ for Lingvamyxa structures\n")
        return: 1

    while: deref_depth > 0U
        if: lm_trans_put(file, "*") != 0
            return: 1
        deref_depth: deref_depth - 1U

    if: target_payload\length != target_path\length && lm_trans_put(file, "(") != 0
        return: 1

    if: is_c_reference_path
        i: 2U
        while: i < target_path\length
            if: target_path\data[i] = '['
                if: lm_trans_array_head_find_close(target_path, i, @ close_index) = 0
                    c.fprintf(c.stderr, "trans L2 error: unclosed index in assignment target\n")
                    return: 1
                index_expression\data: target_path\data + i + 1U
                index_expression\length: close_index - i - 1U
                if: index_expression\length = 0U
                    c.fprintf(c.stderr, "trans L2 error: assignment target index must not be empty\n")
                    return: 1
                if: lm_trans_put(file, "[") != 0 || lm_trans_emit_c_dimension_text(file, index_expression, namespace_, "assignment target index") != 0 || lm_trans_put(file, "]") != 0
                    return: 1
                i: close_index + 1U
                continue
            if: target_path\data[i] = '\\'
                if: lm_trans_put(file, "->") != 0
                    return: 1
                i: i + 1U
                continue
            if: lm_trans_write_all(file, target_path\data + i, 1U) != 0
                return: 1
            i: i + 1U
        ---
    else:
        root_end: 0U
        while: root_end < target_path\length && target_path\data[root_end] != '\\' && target_path\data[root_end] != '['
            root_end: root_end + 1U
        if: root_end = 0U
            c.fprintf(c.stderr, "trans L2 error: assignment target expects a binding before field-follow or indexing\n")
            return: 1
        root\data: target_path\data
        root\length: root_end
        array_rank: lm_trans_namespace_value_array_reference_rank(namespace_, root)
        array_index_count: 0U
        array_helper_id: 0U
        array_helper_id_found: 0
        if: array_rank != 0U && root_end < target_path\length && target_path\data[root_end] = '['
            if: lm_trans_emit_array_reference_items_expression(file, root, namespace_) != 0
                c.fprintf(c.stderr, "trans L2 ArrayReference error: indexed assignment target has no backing projection\n")
                return: 1
            array_helper_id_found: lm_trans_namespace_value_array_helper_id(namespace_, root, @ array_helper_id)
            if: lm_trans_namespace_value_array_reference_element_type(namespace_, root, array_element_type) = 0
                array_element_type\data: ""
                array_element_type\length: 0U
            current_class\data: ""
            current_class\length: 0U
        else:
            if: lm_trans_emit_expr_atom(file, root, namespace_) != 0
                return: 1
            if: lm_trans_expr_value_class_from_atom(root, namespace_, current_class) = 0
                current_class\data: ""
                current_class\length: 0U
            ---
        ---

        i: root_end
        while: i < target_path\length
            if: target_path\data[i] = '['
                if: lm_trans_array_head_find_close(target_path, i, @ close_index) = 0
                    c.fprintf(c.stderr, "trans L2 error: unclosed index in assignment target\n")
                    return: 1
                index_expression\data: target_path\data + i + 1U
                index_expression\length: close_index - i - 1U
                if: index_expression\length = 0U
                    c.fprintf(c.stderr, "trans L2 error: assignment target index must not be empty\n")
                    return: 1
                if: array_rank != 0U && array_helper_id_found
                    if: array_index_count = 0U && lm_trans_put(file, "[") != 0
                        return: 1
                    if: lm_trans_emit_c_dimension_text(file, index_expression, namespace_, "assignment target index") != 0
                        return: 1
                    if: lm_trans_emit_array_rectangle_index_tail(file, array_helper_id, array_rank, array_index_count) != 0
                        return: 1
                    ---
                else:
                    if: lm_trans_put(file, "[") != 0 || lm_trans_emit_c_dimension_text(file, index_expression, namespace_, "assignment target index") != 0 || lm_trans_put(file, "]") != 0
                        return: 1
                    ---
                ---
                if: array_rank != 0U
                    array_index_count: array_index_count + 1U
                    if: array_index_count = array_rank
                        current_class[0]: array_element_type[0]
                    else:
                        if: array_index_count < array_rank
                            current_class\data: ""
                            current_class\length: 0U
                        ---
                    ---
                i: close_index + 1U
                continue

            if: target_path\data[i] != '\\'
                c.fprintf(c.stderr, "trans L2 error: malformed assignment field-follow path\n")
                return: 1
            if: lm_trans_put(file, "->") != 0
                return: 1
            i: i + 1U
            if: i >= target_path\length
                c.fprintf(c.stderr, "trans L2 error: assignment field-follow expects a field name\n")
                return: 1

            field_end: i
            if: target_path\data[i] = '['
                if: lm_trans_array_head_find_close(target_path, i, @ close_index) = 0
                    c.fprintf(c.stderr, "trans L2 error: unclosed occurrence selector in assignment target\n")
                    return: 1
                field_end: close_index + 1U
            ---
            while: field_end < target_path\length && target_path\data[field_end] != '\\' && target_path\data[field_end] != '['
                field_end: field_end + 1U
            segment\data: target_path\data + i
            segment\length: field_end - i
            if: lm_trans_emit_assignment_field_segment(file, segment, current_class, namespace_) != 0
                return: 1
            i: field_end
        ---

    if: target_payload\length != target_path\length && lm_trans_put(file, ")") != 0
        return: 1
return: 0

fn: lm_trans_guard_direct_structure_assignment (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: value_field
    const: LmP0Node: candidate_node
    const: LmTransDescriptor: required_descriptor
    LmP0Text: target_class
    int: status

    if: frame = 0 || frame\body = 0
        return: 0

    value_field: frame\body\first_field
    if: value_field = 0 || value_field\next != 0 || value_field\value = 0 || value_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    candidate_node: value_field\value
    if: frame\head = 0 || frame\head\data = 0
        return: 0
    status: 0
    while: status < (cast: int frame\head\length)
        if: frame\head\data[status] = '\\' || frame\head\data[status] = '['
            return: 0
        ---
        status: status + 1
    ---

    target_class: lm_trans_statement_text_new()
    if: target_class = 0
        return: 1
    status: 0
    if: lm_trans_expr_value_class_from_atom(frame\head, namespace_, target_class)
        required_descriptor: lm_trans_namespace_descriptor(namespace_, target_class)
        status: lm_trans_admit_consumer_uses(namespace_, candidate_node\as\atom, required_descriptor, frame\head, lm_trans_uses_get_fn_frame(), "assignment")
    ---
    lm_trans_text_ref_destroy(@ target_class)
return: status

fn: lm_trans_guard_array_storage_assignment (
    const: LmP0Frame: frame
    const: LmTransNamespace: namespace_
) int
    LmP0Text: target_payload
    LmP0Text: target_root
    LmP0Text: target_type
    size_t: close_index
    size_t: consumed_depth
    size_t: element_depth
    size_t: index
    size_t: index_count
    size_t: rank
    size_t: array_reference_shape_rank
    size_t: root_start
    size_t: root_raw_pointer_depth
    size_t: target_raw_pointer_depth
    int: target_is_c_array_element
    int: target_is_array_reference_element
    int: target_is_array_reference
    int: target_base_is_const
    int: target_has_field_follow
    int: target_type_is_lmslice
    const: LmTransDescriptor: target_descriptor

    if: frame = 0 || frame\body = 0
        return: 0
    target_payload: lm_trans_statement_text_new()
    target_root: lm_trans_statement_text_new()
    target_type: lm_trans_statement_text_new()
    if: target_payload = 0 || target_root = 0 || target_type = 0
        lm_trans_text_ref_destroy(@ target_payload)
        lm_trans_text_ref_destroy(@ target_root)
        lm_trans_text_ref_destroy(@ target_type)
        return: 1
    finally:
        lm_trans_text_ref_destroy(@ target_payload)
        lm_trans_text_ref_destroy(@ target_root)
        lm_trans_text_ref_destroy(@ target_type)
    target_raw_pointer_depth: 0U
    target_is_c_array_element: 0
    target_is_array_reference_element: 0
    target_is_array_reference: 0
    target_base_is_const: 0
    target_has_field_follow: 0
    target_type_is_lmslice: 0
    if: lm_trans_identifier_payload(frame\head, target_payload)
        root_start: 0U
        while: root_start < target_payload\length && target_payload\data[root_start] = '\\'
            root_start: root_start + 1U
        index: root_start
        while: index < target_payload\length && target_payload\data[index] != '[' && target_payload\data[index] != '\\'
            index: index + 1U
        target_root\data: target_payload\data + root_start
        target_root\length: index - root_start
        index_count: 0U
        while: index < target_payload\length && target_payload\data[index] = '['
            if: lm_trans_array_head_find_close(target_payload, index, @ close_index) = 0
                c.fprintf(c.stderr, "trans L2 error: unclosed index in assignment target\n")
                return: 1
            index_count: index_count + 1U
            index: close_index + 1U
        if: index < target_payload\length && target_payload\data[index] = '\\'
            target_has_field_follow: 1
        if: lm_trans_namespace_relation_text_for_latest_binding(namespace_, target_root, "variable.type", target_type)
            target_type_is_lmslice: lm_trans_text_equals(target_type, "LmSlice")
        rank: lm_trans_namespace_value_c_array_rank(namespace_, target_root)
        if: rank != 0U
            if: index_count < rank
                c.fprintf(c.stderr, "trans L2 type error: c.array assignment target must index all %zu dimensions before update\n", rank)
                return: 1
            element_depth: lm_trans_namespace_value_c_array_element_address_depth(namespace_, target_root)
            target_base_is_const: lm_trans_namespace_value_c_array_element_is_const(namespace_, target_root)
            consumed_depth: index_count - rank
            if: consumed_depth > element_depth
                c.fprintf(c.stderr, "trans L2 type error: c.array assignment target has too many index operations for its element address depth\n")
                return: 1
            if: lm_trans_namespace_value_c_array_element_is_const(namespace_, target_root) && consumed_depth = element_depth
                c.fprintf(c.stderr, "trans L2 type error: const c.array base element is not an update target\n")
                return: 1
            target_raw_pointer_depth: element_depth - consumed_depth
            target_is_c_array_element: 1
        else:
            array_reference_shape_rank: lm_trans_namespace_value_array_reference_rank(namespace_, target_root)
            if: array_reference_shape_rank != 0U
                if: index_count = 0U
                    if: target_has_field_follow
                        c.fprintf(c.stderr, "trans L2 ArrayReference error: header fields are not direct update targets\n")
                        return: 1
                    target_is_array_reference: 1
                    target_descriptor: lm_trans_namespace_descriptor(namespace_, target_root)
                    if: target_descriptor != 0 && lm_trans_descriptor_class_relation_value(target_descriptor, "lm.trans.table-runtime-read-only") != 0
                        c.fprintf(c.stderr, "trans L2 Table error: runtime Table binding is read-only\n")
                        return: 1
                    ---
                else:
                    if: index_count < array_reference_shape_rank
                        c.fprintf(c.stderr, "trans hosted ArrayReference limitation: partial multidimensional indexing is not an update target\n")
                        return: 1
                    element_depth: lm_trans_namespace_value_array_reference_element_address_depth(namespace_, target_root)
                    target_base_is_const: lm_trans_namespace_value_array_reference_element_is_const(namespace_, target_root)
                    consumed_depth: index_count - array_reference_shape_rank
                    if: consumed_depth > element_depth
                        c.fprintf(c.stderr, "trans L2 ArrayReference error: assignment target has too many index operations for its element address depth\n")
                        return: 1
                    if: target_base_is_const && consumed_depth = element_depth
                        c.fprintf(c.stderr, "trans L2 ArrayReference error: const base element is not an update target\n")
                        return: 1
                    target_raw_pointer_depth: element_depth - consumed_depth
                    target_is_array_reference_element: 1
                    if: lm_trans_namespace_value_array_reference_element_type(namespace_, target_root, target_type) = 0
                        target_type\data: ""
                        target_type\length: 0U
                    target_type_is_lmslice: lm_trans_text_equals(target_type, "LmSlice")
                ---
            else:
                root_raw_pointer_depth: lm_trans_namespace_value_raw_pointer_depth(namespace_, target_root)
                target_base_is_const: lm_trans_namespace_value_raw_pointer_base_is_const(namespace_, target_root)
                consumed_depth: root_start + index_count
                if: root_raw_pointer_depth > consumed_depth
                    target_raw_pointer_depth: root_raw_pointer_depth - consumed_depth
                if: root_raw_pointer_depth != 0U && root_raw_pointer_depth = consumed_depth && target_type_is_lmslice
                    target_is_array_reference: 1
                ---
            ---
        ---
    ---
    if: lm_trans_namespace_value_is_c_array_storage(namespace_, frame\head)
        c.fprintf(c.stderr, "trans L2 type error: c.array storage is not a whole-value assignment target; update an element or use an explicit adapter\n")
        return: 1
    if: lm_trans_namespace_value_is_array_reference(namespace_, frame\head) || target_is_array_reference
        if: lm_trans_guard_array_reference_range(frame\body\first_field, 0, namespace_, 1, "ArrayReference assignment") != 0
            return: 1
        if: target_is_array_reference && array_reference_shape_rank != 0U
            if: lm_trans_namespace_value_array_reference_element_type(namespace_, target_root, target_type) = 0
                c.fprintf(c.stderr, "trans L2 internal error: ArrayReference assignment target has no element-type metadata\n")
                return: 1
            if: lm_trans_guard_array_reference_shape_range(frame\body\first_field, 0, namespace_, target_type, array_reference_shape_rank, lm_trans_namespace_value_array_reference_element_address_depth(namespace_, target_root), lm_trans_namespace_value_array_reference_element_is_const(namespace_, target_root), "ArrayReference assignment") != 0
                return: 1
            ---
        ---
        return: 0
    if: target_raw_pointer_depth = 0U
        target_raw_pointer_depth: lm_trans_namespace_value_raw_pointer_depth(namespace_, frame\head)
    if: lm_trans_guard_c_array_value_range(frame\body\first_field, 0, namespace_, target_type, target_raw_pointer_depth, target_base_is_const, "assignment") != 0
        return: 1
    if: target_has_field_follow = 0 && lm_trans_guard_runtime_table_indexed_field_range(frame\body\first_field, 0, namespace_, target_type, target_raw_pointer_depth, target_base_is_const, "assignment") != 0
        return: 1
    if: target_raw_pointer_depth != 0U && target_has_field_follow = 0 && lm_trans_guard_known_raw_pointer_range(frame\body\first_field, 0, namespace_, target_type, target_raw_pointer_depth, target_base_is_const, "raw pointer assignment") != 0
        return: 1
    if: (target_is_c_array_element || target_is_array_reference_element) && lm_trans_guard_known_raw_pointer_range(frame\body\first_field, 0, namespace_, target_type, target_raw_pointer_depth, target_base_is_const, "array element assignment") != 0
        return: 1
    if: (target_is_c_array_element || target_is_array_reference_element) && lm_trans_range_has_direct_array_reference(frame\body\first_field, 0, namespace_) && (target_raw_pointer_depth != 1U || target_type_is_lmslice = 0 || lm_trans_range_is_direct_array_reference_address(frame\body\first_field, 0, namespace_) = 0) && (target_raw_pointer_depth = 0U || lm_trans_range_is_array_reference_data_pointer(frame\body\first_field, 0, namespace_) = 0)
        c.fprintf(c.stderr, "trans L2 type error: array element assignment cannot consume an ArrayReference without an explicit raw-storage adapter\n")
        return: 1
    if: target_raw_pointer_depth != 0U && lm_trans_range_has_direct_array_reference(frame\body\first_field, 0, namespace_) && (target_raw_pointer_depth != 1U || target_type_is_lmslice = 0 || lm_trans_range_is_direct_array_reference_address(frame\body\first_field, 0, namespace_) = 0) && lm_trans_range_is_array_reference_data_pointer(frame\body\first_field, 0, namespace_) = 0
        c.fprintf(c.stderr, "trans L2 type error: raw pointer assignment cannot consume an ArrayReference without an explicit adapter\n")
        return: 1
return: 0

fn: lm_trans_emit_target_assignment (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    if: lm_trans_guard_array_storage_assignment(frame, namespace_) != 0
        return: 1
    if: lm_trans_guard_direct_structure_assignment(frame, namespace_) != 0
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_assignment_target(file, frame\head, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " = ") != 0
        return: 1
    if: lm_trans_emit_expr_fields(file, frame\body\first_field, namespace_) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_assignment (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    LmTransNamespace: namespace_
) int
    const: LmP0Node: throws_node
    int: allowed_previous

    if: lm_trans_guard_array_storage_assignment(frame, namespace_) != 0
        return: 1
    if: lm_trans_guard_direct_structure_assignment(frame, namespace_) != 0
        return: 1

    throws_node: 0
    if: frame != 0 && frame\body != 0 && frame\body\first_field != 0 && frame\body\first_field\next = 0
        throws_node: lm_trans_node_throws_node(frame\body\first_field\value, namespace_)
    allowed_previous: lm_trans_throwing_call_allowed
    if: throws_node != 0
        lm_trans_throwing_call_allowed: 1

    if: lm_trans_emit_indent(file, indent) != 0
        lm_trans_throwing_call_allowed: allowed_previous
        return: 1
    if: lm_trans_emit_expr_atom(file, frame\head, namespace_) != 0
        lm_trans_throwing_call_allowed: allowed_previous
        return: 1
    if: lm_trans_put(file, " = ") != 0
        lm_trans_throwing_call_allowed: allowed_previous
        return: 1
    if: lm_trans_emit_expr_fields(file, frame\body\first_field, namespace_) != 0
        lm_trans_throwing_call_allowed: allowed_previous
        return: 1
    if: lm_trans_put(file, ";\n") != 0
        lm_trans_throwing_call_allowed: allowed_previous
        return: 1
    lm_trans_throwing_call_allowed: allowed_previous
    if: throws_node != 0
        return: lm_trans_emit_throwing_dispatch(file, indent, namespace_, throws_node)
return: 0

fn: lm_trans_emit_contextual_literal_assignment (
    FILE: file
    const: LmP0Frame: frame
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
    const: @: char value
    LmP0Text: expected_class
    const: LmP0Structure: body
    const: LmP0Field: target_field
    const: LmP0Node: target_node

    if: frame = 0 || frame\body = 0
        return: 1

    body: lm_trans_unwrap_single_anonymous_structure(frame\body)
    if: body = 0
        return: 1
    target_field: lm_trans_nth_field(body, 0U)
    if: target_field = 0 || target_field\next != 0 || target_field\value = 0 || target_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: contextual literal assignment expects exactly one target atom\n")
        return: 1

    target_node: target_field\value
    expected_class: lm_trans_statement_text_new()
    if: expected_class = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ expected_class)
    if: lm_trans_expr_value_class_from_atom(target_node\as\atom, namespace_, expected_class) = 0
        c.fprintf(c.stderr, "trans L2 error: contextual literal assignment target \"%.*s\" has no expected class\n", (cast: int target_node\as\atom\length), target_node\as\atom\data)
        return: 1
    value: lm_trans_contextual_literal_value(namespace_, frame\head, expected_class)
    if: value = 0
        c.fprintf(c.stderr, "trans L2 error: contextual literal \"%.*s\" has no value for class \"%.*s\"\n", (cast: int frame\head\length), frame\head\data, (cast: int expected_class\length), expected_class\data)
        return: 1
    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: lm_trans_emit_assignment_target(file, target_node\as\atom, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " = ") != 0
        return: 1
    if: lm_trans_put(file, value) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_struct_field_with_qualifier (
    FILE: file
    const: LmP0Node: node
    unsigned: indent
    const: @(char qualifier)
    const: LmTransNamespace: namespace_
) int
    const: LmP0Node: current
    const: LmP0Frame: frame
    const: LmP0Field: type_field
    const: LmP0Field: name_field
    const: LmP0Node: name_node
    const: @: char current_qualifier

    current: node
    current_qualifier: qualifier
    while: 1
        if: lm_trans_node_is_ignored(current)
            return: 0

        if: current = 0 || current\kind != c.LM_P0_NODE_FRAME
            c.fprintf(c.stderr, "trans L2 error: structure field must be a named field\n")
            return: 1

        frame: current\as\frame
        if: lm_trans_text_equals(frame\head, "const") = 0
            break
        name_field: frame\body\first_field
        if: name_field = 0 || name_field\next != 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_FRAME
            c.fprintf(c.stderr, "trans L2 error: const structure field expects exactly one field declaration\n")
            return: 1
        current_qualifier: "const "
        current: name_field\value

    if: lm_trans_text_all_char(frame\head, '@')
        type_field: lm_trans_nth_field(frame\body, 0U)
        name_field: lm_trans_nth_field(frame\body, 1U)
        if: type_field = 0 || name_field = 0 || name_field\next != 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(c.stderr, "trans L2 error: pointer structure field expects type and name\n")
            return: 1
        name_node: name_field\value
        if: lm_trans_emit_indent(file, indent) != 0
            return: 1
        if: current_qualifier != 0 && lm_trans_put(file, current_qualifier) != 0
            return: 1
        if: lm_trans_emit_type_and_name(file, type_field\value, name_node\as\atom, frame\head\length, namespace_) != 0
            return: 1
        return: lm_trans_put(file, ";\n")

    name_field: lm_trans_nth_field(frame\body, 0U)
    if: name_field = 0 || name_field\next != 0 || name_field\value = 0 || name_field\value\kind != c.LM_P0_NODE_ATOM
        c.fprintf(c.stderr, "trans L2 error: structure field expects Type: name\n")
        return: 1

    if: lm_trans_emit_indent(file, indent) != 0
        return: 1
    if: current_qualifier != 0 && lm_trans_put(file, current_qualifier) != 0
        return: 1
    if: lm_trans_emit_type_head_only(file, frame\head, namespace_) != 0
        return: 1
    if: lm_trans_put(file, " ") != 0
        return: 1
    if: lm_trans_emit_identifier(file, name_field\value\as\atom) != 0
        return: 1
return: lm_trans_put(file, ";\n")

fn: lm_trans_emit_struct_field (
    FILE: file
    const: LmP0Node: node
    unsigned: indent
    const: LmTransNamespace: namespace_
) int
return: lm_trans_emit_struct_field_with_qualifier(file, node, indent, "", namespace_)

fn: lm_trans_emit_function_return_structure (
    FILE: file
    const: LmP0Text: function_name
    const: LmP0Node: return_node
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: field

    if: return_node = 0 || return_node\kind != c.LM_P0_NODE_STRUCTURE
        c.fprintf(c.stderr, "trans L2 error: fm expects a return Structure\n")
        return: 1

    if: lm_trans_put(file, "typedef struct ") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, " ") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, ";\n\nstruct ") != 0 || lm_trans_emit_function_return_struct_type_name(file, function_name) != 0 || lm_trans_put(file, " {\n") != 0
        return: 1

    field: return_node\as\structure\first_field
    if: field = 0
        c.fprintf(c.stderr, "trans L2 error: fm return Structure must not be empty\n")
        return: 1
    while: field != 0
        if: lm_trans_emit_struct_field(file, field\value, 1U, namespace_) != 0
            return: 1
        field: field\next
return: lm_trans_put(file, "};\n\n")

fn: lm_trans_register_function_return_layout (
    const: LmP0Text: owner
    const: LmP0Node: return_node
    const: LmTransNamespace: namespace_
) int
    const: LmP0Field: field
    LmTransL4CallableType: field_type
    const: LmP0Text: field_name
    const: LmP0Field: initializer
    size_t: field_index

    if: owner = 0 || return_node = 0 || return_node\kind != c.LM_P0_NODE_STRUCTURE
        return: 1

    field_type: lm_trans_expr_callable_type_new()
    if: field_type = 0
        return: 1
    finally: lm_trans_expr_callable_type_delete(field_type)

    field: return_node\as\structure\first_field
    field_index: 0U
    while: field != 0
        if: lm_trans_node_is_ignored(field\value) = 0
            if: field\value = 0 || field\value\kind != c.LM_P0_NODE_FRAME || lm_trans_named_structure_field_info(field\value\as\frame, namespace_, field_type, @ field_name, @ initializer) = 0
                return: 1
            if: lm_trans_named_structure_push_field_relations(owner, field_name, field_type, field_index) != 0
                return: 1
            field_index: field_index + 1U
        ---
        field: field\next
return: 0

fn: lm_trans_emit_function_return_structure_once (
    FILE: file
    const: LmP0Text: function_name
    const: LmP0Node: return_node
    const: LmTransNamespace: namespace_
) int
    @: char type_name
    LmP0Text: type_name_text
    const: @: char stored_name
    FILE: declaration_file
    int: emitted
    int: status

    type_name: lm_trans_function_return_struct_type_name_new(function_name)
    if: type_name = 0
        return: 1

    declaration_file: lm_trans_tmpfile()
    if: declaration_file = 0
        lm_own_delete(type_name, 0)
        return: 1
    status: lm_trans_emit_function_return_structure(declaration_file, function_name, return_node, namespace_)
    if: status = 0
        status: lm_trans_typedef_projection_emit_prepared_cstr(file, type_name, declaration_file, @ emitted)
    c.fclose(declaration_file)
    if: status != 0
        lm_own_delete(type_name, 0)
        return: 1

    stored_name: lm_trans_string_stack_find(lm_trans_emitted_function_return_structs, type_name)
    if: stored_name != 0
        lm_own_delete(type_name, 0)
        return: 0

    type_name_text: lm_trans_text_from_cstr(type_name)
    if: type_name_text = 0
        lm_own_delete(type_name, 0)
        return: 1
    if: lm_trans_register_function_return_layout(type_name_text, return_node, namespace_) != 0
        lm_trans_text_ref_destroy(@ type_name_text)
        lm_own_delete(type_name, 0)
        return: 1
    lm_trans_text_ref_destroy(@ type_name_text)

    if: lm_own_ptr_stack_push(lm_trans_emitted_function_return_structs, type_name) != 0
        lm_own_delete(type_name, 0)
        return: 1
return: 0

sub: lm_trans_statement_stack_destroy (LmTransStatementStack: stack)
    if: stack != 0
        lm_trans_ptr_stack_delete(@ stack\jobs)
end: lm_trans_statement_stack_destroy

fn: lm_trans_statement_stack_push (LmTransStatementStack: stack; LmTransStatementJob: job) int
    if: stack = 0 || stack\jobs = 0 || job = 0
        return: 1
return: lm_own_ptr_stack_push(stack\jobs, job)

fn: lm_trans_statement_stack_push_list (
    LmTransStatementStack: stack
    const: LmP0Field: field
    unsigned: indent
    int: unwrap_single_structure
    const: LmP0Frame: repeat_frame
    int: register_catches
) int
    LmTransStatementJob: job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: @lm_trans_statement_job_emit_list
    job\destroy: @lm_trans_statement_job_destroy_list
    job\list: (cast: (LmTransStatementListJob) lm_own_new_zero(c.sizeof(job\list[0])))
    if: job\list = 0
        lm_trans_statement_job_delete(job)
        return: 1
    job\list\field: field
    job\list\indent: indent
    job\list\unwrap_single_structure: unwrap_single_structure
    job\list\repeat_frame: repeat_frame
    job\list\register_catches: register_catches
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_stack_push_node (
    LmTransStatementStack: stack
    const: LmP0Node: node
    unsigned: indent
    const: LmP0Frame: repeat_frame
) int
    LmTransStatementJob: job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: @lm_trans_statement_job_emit_node
    job\destroy: @lm_trans_statement_job_destroy_node
    job\node: (cast: (LmTransStatementNodeJob) lm_own_new_zero(c.sizeof(job\node[0])))
    if: job\node = 0
        lm_trans_statement_job_delete(job)
        return: 1
    job\node\node: node
    job\node\indent: indent
    job\node\repeat_frame: repeat_frame
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_stack_push_frame_job (
    LmTransStatementStack: stack
    LmTransStatementJobHandler: handler
    const: LmP0Frame: frame
    unsigned: indent
) int
    LmTransStatementJob: job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: handler
    job\destroy: @lm_trans_statement_job_destroy_frame
    job\frame: (cast: (LmTransStatementFrameJob) lm_own_new_zero(c.sizeof(job\frame[0])))
    if: job\frame = 0
        lm_trans_statement_job_delete(job)
        return: 1
    job\frame\frame: frame
    job\frame\indent: indent
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_stack_push_simple (
    LmTransStatementStack: stack
    LmTransStatementJobHandler: handler
) int
    LmTransStatementJob: job
    int: status

    job: lm_trans_statement_job_new()
    if: job = 0
        return: 1
    job\run: handler
    status: lm_trans_statement_stack_push(stack, job)
    if: status != 0
        lm_trans_statement_job_delete(job)
return: status

fn: lm_trans_statement_stack_push_indent_text (
    LmTransStatementStack: stack
    unsigned: indent
    const: @(char text)
) int
    LmTransStatementJob: job
    int: status

    job: lm_trans_statement_job_new()
