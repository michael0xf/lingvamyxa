fn: lm_trans_statement_text_new () @: LmP0Text
return: lm_trans_text_ref_new_cstr("")

fn: lm_trans_statement_binding_new () @: LmTransBinding
return: (cast: (@: LmTransBinding) lm_own_new_zero(c.sizeof(c.LmTransBinding)))

fn: lm_trans_statement_c_declarator_new () @: LmTransCDeclarator
    @: LmTransCDeclarator declarator

    declarator: (cast: (@: LmTransCDeclarator) lm_own_new_zero(c.sizeof(c.LmTransCDeclarator)))
    if: declarator != 0
        declarator\type_head: lm_trans_statement_text_new()
        declarator\name: lm_trans_statement_text_new()
        declarator\array_head: lm_trans_statement_text_new()
        if: declarator\type_head = 0 || declarator\name = 0 || declarator\array_head = 0
            lm_trans_text_ref_destroy(@ declarator\type_head)
            lm_trans_text_ref_destroy(@ declarator\name)
            lm_trans_text_ref_destroy(@ declarator\array_head)
            lm_trans_statement_c_declarator_destroy(declarator)
            return: 0
return: declarator

sub: lm_trans_statement_c_declarator_destroy (@: LmTransCDeclarator declarator)
    if: declarator != 0
        lm_trans_text_ref_destroy(@ declarator\type_head)
        lm_trans_text_ref_destroy(@ declarator\name)
        lm_trans_text_ref_destroy(@ declarator\array_head)
    lm_own_delete(declarator, 0)
end: lm_trans_statement_c_declarator_destroy

fn: lm_trans_statement_call_lowering_new () @: LmTransCallLowering
return: lm_trans_expr_call_lowering_new()

fn: lm_trans_statement_job_new () @: LmTransStatementJob
return: (cast: (@: LmTransStatementJob) lm_own_new_zero(c.sizeof(c.LmTransStatementJob)))

sub: lm_trans_statement_job_destroy_list (@: LmTransStatementJob job)
    if: job != 0
        lm_own_delete(job\list, 0)
        job\list: 0
end: lm_trans_statement_job_destroy_list

sub: lm_trans_statement_job_destroy_node (@: LmTransStatementJob job)
    if: job != 0
        lm_own_delete(job\node, 0)
        job\node: 0
end: lm_trans_statement_job_destroy_node

sub: lm_trans_statement_job_destroy_frame (@: LmTransStatementJob job)
    if: job != 0
        lm_own_delete(job\frame, 0)
        job\frame: 0
end: lm_trans_statement_job_destroy_frame

sub: lm_trans_statement_job_destroy_text (@: LmTransStatementJob job)
    if: job != 0
        lm_own_delete(job\text, 0)
        job\text: 0
end: lm_trans_statement_job_destroy_text

sub: lm_trans_statement_job_destroy (@: LmTransStatementJob job)
    if: job != 0
        lm_trans_statement_job_destroy_list(job)
        lm_trans_statement_job_destroy_node(job)
        lm_trans_statement_job_destroy_frame(job)
        lm_trans_statement_job_destroy_text(job)
        job\destroy: 0
end: lm_trans_statement_job_destroy

sub: lm_trans_statement_job_delete (@: LmTransStatementJob job)
    lm_trans_statement_job_destroy(job)
    lm_own_delete(job, 0)
end: lm_trans_statement_job_delete

sub: lm_trans_statement_job_delete_any (@: void object)
    lm_trans_statement_job_delete((cast: (@: LmTransStatementJob) object))
end: lm_trans_statement_job_delete_any

fn: lm_trans_statement_stack_new () @: LmTransStatementStack
return: (cast: (@: LmTransStatementStack) lm_own_new_zero(c.sizeof(c.LmTransStatementStack)))

fn: lm_trans_statement_head_binding_new () @: LmTransHeadBinding
return: (cast: (@: LmTransHeadBinding) lm_own_new_zero(c.sizeof(c.LmTransHeadBinding)))

fn: lm_trans_statement_function_header_new () @: LmTransFunctionHeader
return: lm_trans_function_header_new()

fn: lm_trans_statement_lowering_new () @: LmTransStatementLowering
return: (cast: (@: LmTransStatementLowering) lm_own_new_zero(c.sizeof(c.LmTransStatementLowering)))

fn: lm_trans_statement_capture_new () @: LmTransCapture
    @: LmTransCapture capture

    capture: (cast: (@: LmTransCapture) lm_own_new_zero(c.sizeof(capture[0])))
    if: capture != 0 && lm_trans_capture_init_fields(capture) != 0
        lm_trans_capture_destroy(capture)
        return: 0
return: capture

fn: lm_trans_statement_node_new () @: LmP0Node
return: (cast: (@: LmP0Node) lm_own_new_zero(c.sizeof(c.LmP0Node)))

