fn: lm_trans_emit_message_thread_runtime_prelude (FILE: file) int
    int: status

    if: file = 0
        return: 1
    if: lm_trans_emitted_message_thread_runtime_prelude
        return: 0

    lm_trans_emitted_message_thread_runtime_prelude: 1
    if: lm_trans_put(file, "#include <string.h>\n") != 0
        return: 1
    if: lm_trans_put(file, "struct LmOwnArena;\n") != 0
        return: 1
    if: lm_trans_put(file, "struct LmMessageThread;\n") != 0
        return: 1
    if: lm_trans_put(file, "struct LmMessageThreadRuntime;\n") != 0
        return: 1
