        if: field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && lm_trans_namespace_value_is_array_reference(namespace_, field\value\as\atom)
            rank: lm_trans_namespace_value_array_reference_rank(namespace_, field\value\as\atom)
            index_count: 0U
