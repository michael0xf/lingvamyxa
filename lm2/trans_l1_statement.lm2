fn: lm_trans_emit_message_thread_main_exit_safe_point (
    FILE: file
    unsigned: indent
    int: has_pool
) int
    if: lm_trans_emit_message_thread_main_exit_query(file, indent, 1) != 0
        return: 1
    if: has_pool
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (!lm_lmx_application_exit_ready && lm_lmx_application_pool != 0) {\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "(void)lm_message_thread_pool_pump(lm_lmx_application_pool, 1U);\n") != 0
            return: 1
        if: lm_trans_emit_message_thread_main_exit_query(file, indent + 1U, 1) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        ---
    return: lm_trans_emit_message_thread_main_exit_stop_if_ready(file, indent, has_pool)

