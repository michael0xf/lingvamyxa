    if: has_pool
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "if (!lm_lmx_application_exit_ready && lm_lmx_application_pool != 0) {\n") != 0
            return: 1
        if: lm_trans_emit_indent(file, indent + 1U) != 0 || lm_trans_put(file, "(void)lm_message_thread_pool_pump(lm_lmx_application_pool, 1U);\n") != 0
            return: 1
        if: lm_trans_emit_message_thread_main_exit_query(file, indent + 1U, 1) != 0
            return: 1
        if: lm_trans_emit_indent(file, indent) != 0 || lm_trans_put(file, "}\n") != 0
            return: 1
        ---
    return: lm_trans_emit_message_thread_main_exit_stop_if_ready(file, indent, has_pool)

fn: lm_trans_emit_message_thread_main_indexed_text (
    FILE: file
    const: @(char format)
    size_t: index
) int
    c.array: [1024]: char buffer
    int: written

    if: file = 0 || format = 0
        return: 1
    written: c.snprintf(buffer, c.sizeof(buffer), format, index, index, index, index)
    if: written < 0 || (cast: size_t written) >= c.sizeof(buffer)
        return: 1
return: lm_trans_put(file, buffer)

fn: lm_trans_emit_message_thread_main_root (
    FILE: file
    unsigned: indent
    const: (LmTransNamespace: namespace_)
) int
    const: @: char dispatcher_name
    size_t: thread_count
    size_t: index
    const: LmTransThreadDeclaration: declaration

    thread_count: 0U
    if: namespace_ != 0 && namespace_\thread_declarations != 0
        thread_count: namespace_\thread_declarations\count

    if: lm_trans_emit_message_thread_main_helper(lm_trans_prelude_file(file)) != 0
