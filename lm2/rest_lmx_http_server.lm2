        external:
            fn: lm_rest_lmx_http_server_start (LmMessageThreadRuntime: runtime; const: (LmRestLmxHttpServerOptionsV1: options); @: LmRestLmxHttpServer out_server) int
                LmRestLmxHttpServer: server 0
                c.struct: c.mg_callbacks callbacks
                c.array: [4]: LmCivetwebServerPort ports
                c.array: [320]: char listening_ports
                c.array: [32]: char worker_count
                c.array: [32]: char request_timeout
                c.array: const: [13]: @: char configuration
                const: @: char base_path
                int: port_count
                int: written

                if: out_server = 0
                    return: 1
                out_server[0]: 0
                if: runtime = 0 || lm_rest_lmx_http_server_options_are_valid(options) = 0
                    return: 1
                base_path: options\base_path
                if: c.strcmp(base_path, "/") = 0
                    base_path: ""
                server: (cast: (LmRestLmxHttpServer) c.calloc(1U, c.sizeof(server[0])))
                if: server = 0
                    return: 1
                server\runtime: runtime
                server\base_path: lm_rest_lmx_http_copy_text(base_path)
                if: server\base_path = 0
                    c.free(server)
                    return: 1
                server\base_path_length: c.strlen(server\base_path)
                server\max_body_bytes: options\max_body_bytes

                if: c.strchr(options\bind_address, ':') != 0 && options\bind_address[0] != '['
                    written: c.snprintf(listening_ports, c.sizeof(listening_ports), "[%s]:%u", options\bind_address, options\port)
                else:
                    written: c.snprintf(listening_ports, c.sizeof(listening_ports), "%s:%u", options\bind_address, options\port)
                ---
                if: written < 0 || (cast: size_t written) >= c.sizeof(listening_ports)
                    c.free(server\base_path)
                    c.free(server)
                    return: 1
                written: c.snprintf(worker_count, c.sizeof(worker_count), "%u", options\worker_count)
                if: written < 0 || (cast: size_t written) >= c.sizeof(worker_count)
                    c.free(server\base_path)
                    c.free(server)
                    return: 1
                written: c.snprintf(request_timeout, c.sizeof(request_timeout), "%u", options\request_timeout_ms)
                if: written < 0 || (cast: size_t written) >= c.sizeof(request_timeout)
                    c.free(server\base_path)
                    c.free(server)
                    return: 1

                configuration[0]: "listening_ports"
                configuration[1]: listening_ports
                configuration[2]: "num_threads"
                configuration[3]: worker_count
                configuration[4]: "request_timeout_ms"
                configuration[5]: request_timeout
                configuration[6]: "enable_keep_alive"
                configuration[7]: "no"
                configuration[8]: "decode_url"
                configuration[9]: "no"
                configuration[10]: "additional_header"
                configuration[11]: "Allow: POST"
                configuration[12]: 0

                c.memset(@ callbacks, 0, c.sizeof(callbacks))
                c.callbacks.begin_request: @lm_rest_lmx_http_begin_request
                c.mg_init_library(c.MG_FEATURES_DEFAULT)
                server\library_initialized: 1
                server\context: c.mg_start(@ callbacks, server, configuration)
                if: server\context = 0
                    c.mg_exit_library()
                    c.free(server\base_path)
                    c.free(server)
                    return: 1
                c.memset(ports, 0, c.sizeof(ports))
                port_count: c.mg_get_server_ports(server\context, (cast: int (c.sizeof(ports) / c.sizeof(ports[0]))), ports)
                if: port_count < 1 || c.ports[0].port <= 0 || c.ports[0].port > 65535 || c.ports[0].is_ssl
                    c.mg_stop(server\context)
                    server\context: 0
                    c.mg_exit_library()
                    c.free(server\base_path)
                    c.free(server)
                    return: 1
                server\listening_port: (cast: unsigned c.ports[0].port)
                out_server[0]: server
                return: 0
            end: lm_rest_lmx_http_server_start
        end: external

        external:
            fn: lm_rest_lmx_http_server_start_default (LmMessageThreadRuntime: runtime; @: LmRestLmxHttpServer out_server) int
                const: @: char bind_address c.getenv("LM_REST_LMX_LISTEN_ADDRESS")
                const: @: char port_text c.getenv("LM_REST_LMX_LISTEN_PORT")
                const: @: char base_path c.getenv("LM_REST_LMX_BASE_PATH")
                const: @: char max_body_text c.getenv("LM_REST_LMX_MAX_BODY_BYTES")
                const: @: char worker_count_text c.getenv("LM_REST_LMX_WORKER_COUNT")
                const: @: char timeout_text c.getenv("LM_REST_LMX_REQUEST_TIMEOUT_MS")
                c.struct: c.LmRestLmxHttpServerOptionsV1 options_storage
                LmRestLmxHttpServerOptionsV1: options (cast: (LmRestLmxHttpServerOptionsV1) @ options_storage)

                c.memset(options, 0, c.sizeof(options[0]))
                options\abi_size: c.sizeof(options[0])
                options\bind_address: bind_address
                if: options\bind_address = 0
                    options\bind_address: "127.0.0.1"
                options\port: 8080U
                options\base_path: base_path
                if: options\base_path = 0
                    options\base_path: ""
                options\max_body_bytes: 1024U * 1024U
                options\worker_count: 4U
                options\request_timeout_ms: 10000U
                if: (port_text != 0 && lm_rest_lmx_http_parse_unsigned(port_text, @ options\port) != 0) || (max_body_text != 0 && lm_rest_lmx_http_parse_size(max_body_text, @ options\max_body_bytes) != 0) || (worker_count_text != 0 && lm_rest_lmx_http_parse_unsigned(worker_count_text, @ options\worker_count) != 0) || (timeout_text != 0 && lm_rest_lmx_http_parse_unsigned(timeout_text, @ options\request_timeout_ms) != 0)
                    return: 1
                return: lm_rest_lmx_http_server_start(runtime, options, out_server)
            end: lm_rest_lmx_http_server_start_default
        end: external

        external:
            fn: lm_rest_lmx_http_server_stop (@: LmRestLmxHttpServer server) int
                LmRestLmxHttpServer: instance 0

                if: server = 0
                    return: 1
                instance: server[0]
                if: instance = 0
                    return: 0
                if: instance\context != 0
                    c.mg_stop(instance\context)
                    instance\context: 0
                if: instance\library_initialized
                    c.mg_exit_library()
                    instance\library_initialized: 0
                c.free(instance\base_path)
                instance\base_path: 0
                instance\runtime: 0
                c.free(instance)
                server[0]: 0
                return: 0
            end: lm_rest_lmx_http_server_stop
        end: external

        external:
            fn: lm_rest_lmx_http_server_port (const: (LmRestLmxHttpServer: server); @: unsigned out_port) int
                if: server = 0 || out_port = 0 || server\context = 0 || server\listening_port = 0U
                    return: 1
                out_port[0]: server\listening_port
                return: 0
            end: lm_rest_lmx_http_server_port
        end: external

    default:
        external:
            fn: lm_rest_lmx_http_server_provider_name () const: @: char
                return: "none"
            end: lm_rest_lmx_http_server_provider_name
        end: external

        external:
            fn: lm_rest_lmx_http_server_start (LmMessageThreadRuntime: runtime; const: (LmRestLmxHttpServerOptionsV1: options); @: LmRestLmxHttpServer out_server) int
                c.LM_REST_LMX_SERVER_UNUSED(options)
                if: out_server = 0
                    return: 1
                out_server[0]: 0
                if: runtime = 0
                    return: 1
                return: 0
            end: lm_rest_lmx_http_server_start
        end: external

        external:
            fn: lm_rest_lmx_http_server_start_default (LmMessageThreadRuntime: runtime; @: LmRestLmxHttpServer out_server) int
                return: lm_rest_lmx_http_server_start(runtime, 0, out_server)
            end: lm_rest_lmx_http_server_start_default
        end: external

        external:
            fn: lm_rest_lmx_http_server_stop (@: LmRestLmxHttpServer server) int
                if: server = 0
                    return: 1
                if: server[0] = 0
                    return: 0
                return: 1
            end: lm_rest_lmx_http_server_stop
        end: external

        external:
            fn: lm_rest_lmx_http_server_port (const: (LmRestLmxHttpServer: server); @: unsigned out_port) int
                c.LM_REST_LMX_SERVER_UNUSED(server)
                c.LM_REST_LMX_SERVER_UNUSED(out_port)
                return: 1
            end: lm_rest_lmx_http_server_port
        end: external
end: ifdef
