            length: c.strlen(address)
            if: length > 255U
                return: 0
            index: 0U
            while: index < length
                uchar: value text[index]

                if: ((value >= (cast: uchar 'a') && value <= (cast: uchar 'z')) || (value >= (cast: uchar 'A') && value <= (cast: uchar 'Z')) || (value >= (cast: uchar '0') && value <= (cast: uchar '9')) || value = (cast: uchar '.') || value = (cast: uchar '-') || value = (cast: uchar ':') || value = (cast: uchar '[') || value = (cast: uchar ']')) = 0
