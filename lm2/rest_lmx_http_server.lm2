        fn: lm_rest_lmx_http_send_status (LmCivetwebConnection: connection; unsigned: status) int
            if: status = 202U
                c.mg_printf(connection, "HTTP/1.1 202 Accepted\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                return: 202
            if: status != 400U && status != 404U && status != 405U && status != 411U && status != 413U && status != 415U && status != 503U
                status: 500U
            c.mg_send_http_error(connection, (cast: int status), "%s", "")
            return: (cast: int status)
        end: lm_rest_lmx_http_send_status

        fn: lm_rest_lmx_http_admission_status (int: status) unsigned
            if: status = 0
                return: 202U
            if: status = c.LM_MESSAGE_STATUS_ROUTE_NOT_FOUND
                return: 404U
            if: status = c.LM_MESSAGE_STATUS_INVALID_ADDRESS
                return: 400U
            if: status = c.LM_MESSAGE_STATUS_APPLICATION_STOPPING
                return: 503U
            return: 500U
        end: lm_rest_lmx_http_admission_status

        fn: lm_rest_lmx_http_route (const: (LmRestLmxHttpServer: server); const: @(char raw_uri); @: unsigned out_status) const: @: char
