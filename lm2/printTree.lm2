import: "lm4/parser_abi.lm4"

L4: loadHeaders

include: "<stdio.h>"

external:
    fn: main (int: argc; @@: char argv) int
        @: LmP0Document document 0
        const: @: LmP0Diagnostic diagnostic
        @: char dump
        int: status

        c.setvbuf(c.stdout, 0, c._IONBF, 0)
        c.setvbuf(c.stderr, 0, c._IONBF, 0)

        if: argc != 2
            c.fputs("usage: printTree.lm0[.exe] <source.lmx>\n", c.stdout)
            return: 0

        status: lm_p0_parse_file(argv[1], @ document)
        if: status != 0
            diagnostic: lm_p0_document_diagnostic(document)
            if: diagnostic != 0
                c.fprintf:
                    c.stderr "P0 parse error %d at %zu:%zu: %s\n"
                    diagnostic\code diagnostic\line diagnostic\column diagnostic\message
            ---
            if: diagnostic = 0
                c.fputs("P0 parse error while reading ", c.stderr)
                c.fputs(argv[1], c.stderr)
                c.fputs("\n", c.stderr)
            lm_p0_document_destroy(document)
            return: 1

        dump: lm_p0_dump_alloc(document)
        if: dump = 0
            c.fputs("P0 dump allocation failed\n", c.stderr)
            lm_p0_document_destroy(document)
            return: 1

        c.fputs(dump, c.stdout)
        c.fflush(c.stdout)
        lm_p0_free(dump)
        lm_p0_document_destroy(document)
        return: 0
    end: main
end: external
