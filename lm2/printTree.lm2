include: "<stdio.h>" "parser.lm1.h"

external:
    fn: main (int: argc; @@: char argv) int
        c.setvbuf: c.stdout 0 c._IONBF 0
        c.setvbuf: c.stderr 0 c._IONBF 0
        if: argc = 2
            @: LmP0Document document 0
            const: @: LmP0Diagnostic diagnostic
            @: char dump
            int: status
            status: c.lm_p0_parse_file(argv[1], @ document)
            if: status != 0
                diagnostic: c.lm_p0_document_diagnostic(document)
                if: diagnostic != 0
                    c.fprintf:
                        c.stderr "P0 parse error %d at %zu:%zu: %s\n"
                        diagnostic\code diagnostic\line diagnostic\column diagnostic\message
                    c.lm_p0_document_destroy: document
                    return: 1
                c.fprintf: c.stderr "P0 parse error while reading %s\n" argv[1]
                c.lm_p0_document_destroy: document
                return: 1
            dump: c.lm_p0_dump_alloc(document)
            if: dump = 0
                c.fprintf: c.stderr "P0 dump allocation failed\n"
                c.lm_p0_document_destroy: document
                return: 1
            c.fputs: dump c.stdout
            c.fflush: c.stdout
            c.lm_p0_free: dump
            c.lm_p0_document_destroy: document
            return: 0
        c.printf: "usage: printTree.lm0[.exe] <source.lmx>\n"
        return: 0
    end: main
end: external
