    if: out_covered != 0
        out_covered[0]: 0
    if: view = 0 || path = 0 || out_covered = 0
        return: 0

    table_count: lm_registry_view_source_table_count(view)
    table_index: 0U
    while: table_index < table_count
        descriptor: lm_registry_view_source_table_at(view, table_index)
