    fn: lm_l4_nth_field (const: @(LmP0Structure structure); size_t: index) const: @: LmP0Field
        const: @: LmP0Field field
        size_t: i

        if: structure = 0
            return: 0

        field: structure\first_field
        i: 0U
        while: field != 0 && i < index
            field: field\next
            i: i + 1U

        return: field
    end: lm_l4_nth_field

    fn: lm_l4_trailer_single_atom (const: @(LmP0Trailer trailer); @: LmP0Text out_text) int
        const: @: LmP0Field field

        if: trailer = 0 || out_text = 0
            return: 0

        field: c.trailer->body.first_field
        if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
            return: 0

        out_text[0]: c.field->value->as.atom
        return: 1
    end: lm_l4_trailer_single_atom

    fn: lm_l4_identifier_value (LmP0Text: atom; @: LmP0Text out_payload) int
        if: out_payload = 0 || c.atom.data = 0
            return: 0

        if: c.atom.length >= 2U && c.atom.data[0] = '`' && c.atom.data[atom.length - 1U] = '`'
            out_payload[0]: atom
            out_payload\data: c.atom.data + 1U
            out_payload\length: c.atom.length - 2U
            return: 1

        out_payload[0]: atom
        return: 1
    end: lm_l4_identifier_value

    fn: lm_l4_frame_single_atom (const: @(LmP0Frame frame); const: @(char head); @: LmP0Text out_atom) int
        const: @: LmP0Field field

        if: frame = 0 || out_atom = 0
            return: 0
        if: head != 0 && lm_l4_text_equals(frame\head, head) = 0
            return: 0

        field: lm_l4_nth_field(c.&frame->body, 0U)
        if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
            return: -1

        out_atom[0]: c.field->value->as.atom
        return: 1
    end: lm_l4_frame_single_atom

    fn: lm_l4_column_name (const: @(LmP0Field field); @: LmL4Column out_column) int
        const: @: LmP0Node node
        const: @: LmP0Field body_field
        size_t: descriptor_count

        if: field = 0 || out_column = 0
            return: 0

        c.memset(out_column, 0, c.sizeof(out_column[0]))
        node: field\value
        if: node = 0
            return: -1

        if: node\kind = c.LM_P0_NODE_ATOM
            out_column\name: c.node->as.atom
            return: 1

        if: node\kind = c.LM_P0_NODE_FRAME
            if: lm_l4_frame_single_atom(c.&node->as.frame, 0, c.&out_column->name) <= 0
                return: -1
            out_column\descriptors[0]: c.node->as.frame.head
            out_column\descriptor_count: 1U
            return: 1

        if: node\kind != c.LM_P0_NODE_STRUCTURE
            return: -1

        body_field: c.node->as.structure.first_field
        while: body_field != 0 && lm_l4_node_is_ignored(body_field\value) != 0
            body_field: body_field\next

        if: body_field = 0 || body_field\value = 0 || body_field\value\kind != c.LM_P0_NODE_ATOM
            return: -1
        out_column\name: c.body_field->value->as.atom

        descriptor_count: 0U
        body_field: body_field\next
        while: body_field != 0
            if: body_field\value != 0 && lm_l4_node_is_ignored(body_field\value) = 0
                if: body_field\value\kind != c.LM_P0_NODE_ATOM
                    return: -1
                if: descriptor_count >= c.sizeof(out_column\descriptors) / c.sizeof(out_column\descriptors[0])
                    return: -1
                out_column\descriptors[descriptor_count]: c.body_field->value->as.atom
                descriptor_count: descriptor_count + 1U
            body_field: body_field\next

        out_column\descriptor_count: descriptor_count
        return: 1
    end: lm_l4_column_name

    fn: lm_l4_columns_from_frame (const: @(LmL4Loader loader); const: @(LmP0Frame frame); @: LmL4Column columns; size_t: columns_capacity; @: size_t out_count) int
        const: @: LmP0Field field
        LmL4Column: column
        LmP0Text: first_column
        size_t: count
        int: status

        if: frame = 0 || columns = 0 || out_count = 0 || columns_capacity = 0U || lm_l4_text_equals(frame\head, "columns") = 0
            return: 0

        count: 0U
        field: c.frame->body.first_field
        while: field != 0
            if: field\value != 0 && lm_l4_node_is_ignored(field\value) = 0
                status: lm_l4_column_name(field, @ column)
                if: status <= 0
                    lm_l4_error(loader, "columns expects atoms or anonymous descriptor structures")
                    return: -1
                if: count >= columns_capacity
                    lm_l4_error(loader, "table has too many columns")
                    return: -1
                columns[count]: column
                count: count + 1U
            field: field\next

        if: count < 2U
            lm_l4_error(loader, "table expects at least two columns")
            return: -1
        if: lm_l4_identifier_value(c.columns[0].name, @ first_column) = 0 || lm_l4_text_equals(first_column, "class") = 0
            lm_l4_error(loader, "first table column must be class")
            return: -1

        out_count[0]: count
        return: 1
    end: lm_l4_columns_from_frame

    fn: lm_l4_validate_named_trailer (const: @(LmL4Loader loader); const: @(LmP0Frame frame); LmP0Text: expected_name) int
        LmP0Text: actual
        LmP0Text: actual_payload
        LmP0Text: expected_payload

        if: frame = 0 || frame\trailer = 0
            return: 0
        if: lm_l4_text_equals(c.frame->trailer->spelling, "end") = 0
            return: 0
        if: lm_l4_trailer_single_atom(frame\trailer, @ actual) = 0
            lm_l4_error(loader, "end trailer expects exactly one target name")
            return: 1
        if: lm_l4_identifier_value(actual, @ actual_payload) = 0 || lm_l4_identifier_value(expected_name, @ expected_payload) = 0 || lm_l4_text_same(actual_payload, expected_payload) = 0
            lm_l4_error(loader, "end trailer target does not match head/name")
            return: 1

        return: 0
    end: lm_l4_validate_named_trailer

    fn: lm_l4_row_from_frame (const: @(LmL4Loader loader); @: void context; const: @(LmP0Frame frame)) int
        const: @: LmP0Field table_field
        const: @: LmP0Field key_field
        const: @: LmP0Field payload_field

        if: frame = 0 || lm_l4_text_equals(frame\head, "row") = 0
            return: 0

        table_field: lm_l4_nth_field(c.&frame->body, 0U)
        key_field: lm_l4_nth_field(c.&frame->body, 1U)
        payload_field: lm_l4_nth_field(c.&frame->body, 2U)
        if: table_field = 0 || key_field = 0 || payload_field = 0 || payload_field\next != 0 || table_field\value = 0 || key_field\value = 0 || payload_field\value = 0 || table_field\value\kind != c.LM_P0_NODE_ATOM || key_field\value\kind != c.LM_P0_NODE_ATOM
            lm_l4_error(loader, "row expects table and key atoms plus one payload field")
            return: -1

        if: loader = 0 || loader\push_row = 0
            lm_l4_error(loader, "row consumer is not configured")
            return: -1
        if: c.loader->push_row(context, c.table_field->value->as.atom, c.key_field->value->as.atom, payload_field\value) != 0
            return: -1

        return: 1
    end: lm_l4_row_from_frame

    fn: lm_l4_rows_from_frame (const: @(LmL4Loader loader); @: void context; const: @(LmP0Frame frame); LmP0Text: table_name; const: @(LmL4Column columns); size_t: column_count) int
        const: @: LmP0Field field
        const: @: LmP0Node key_node
        const: @: LmP0Node cell_node
        size_t: field_index
        size_t: column_index
        int: split_by_column

        if: frame = 0 || lm_l4_text_equals(frame\head, "rows") = 0
            return: 0
        if: loader = 0 || loader\push_cell = 0
            lm_l4_error(loader, "cell consumer is not configured")
            return: -1
        if: columns = 0 || column_count < 2U
            lm_l4_error(loader, "rows require at least two columns")
            return: -1

        field_index: 0U
        key_node: 0
        split_by_column: column_count != 2U
        field: c.frame->body.first_field
        while: field != 0
            if: field\value != 0 && lm_l4_node_is_ignored(field\value) = 0
                column_index: field_index % column_count
                if: column_index = 0U
                    key_node: field\value
                    if: key_node\kind != c.LM_P0_NODE_ATOM
                        lm_l4_error(loader, "table rows currently expect atom cells in the key column")
                        return: -1
                    if: loader\note_key != 0 && c.loader->note_key(context, table_name, c.&columns[0], c.key_node->as.atom) != 0
                        return: -1
                    ---
                if: column_index != 0U
                    cell_node: field\value
                    if: key_node = 0 || c.loader->push_cell(context, table_name, c.&columns[column_index], split_by_column, c.key_node->as.atom, cell_node) != 0
                        return: -1
                    ---
                field_index: field_index + 1U
            field: field\next

        if: (field_index % column_count) != 0U
            lm_l4_error(loader, "rows field count is not divisible by column count; use explicit NULL for empty cells")
            return: -1
        if: field_index = 0U
            lm_l4_error(loader, "table rows must not be empty")
            return: -1

        return: 1
    end: lm_l4_rows_from_frame

    fn: lm_l4_table_from_frame (const: @(LmL4Loader loader); @: void context; const: @(LmP0Frame frame)) int
        const: @: LmP0Field field
        const: @: LmP0Node node
        []: LmL4Column columns 128
        LmP0Text: table_name
        size_t: column_count
        int: have_name
        int: have_columns
        int: have_rows
        int: status

        if: frame = 0 || lm_l4_text_equals(frame\head, "table") = 0
            return: 0

        have_name: 0
        have_columns: 0
        have_rows: 0
        column_count: 0U
        field: c.frame->body.first_field
        while: field != 0
            node: field\value
            if: node != 0 && lm_l4_node_is_ignored(node) = 0
                if: node\kind != c.LM_P0_NODE_FRAME
                    lm_l4_error(loader, "table body expects name/columns/rows frames")
                    return: -1
                status: lm_l4_frame_single_atom(c.&node->as.frame, "name", @ table_name)
                if: status < 0
                    lm_l4_error(loader, "table name expects exactly one atom")
                    return: -1
                if: status > 0
                    have_name: 1
                    field: field\next
                    continue
                if: lm_l4_text_equals(c.node->as.frame.head, "columns") != 0
                    if: have_name = 0
                        lm_l4_error(loader, "table columns must appear after name")
                        return: -1
                    status: lm_l4_columns_from_frame(loader, c.&node->as.frame, columns, c.sizeof(columns) / c.sizeof(columns[0]), @ column_count)
                    if: status <= 0
                        return: -1
                    if: loader != 0 && loader\push_column_metadata != 0 && c.loader->push_column_metadata(context, table_name, columns, column_count) != 0
                        lm_l4_error(loader, "cannot store table column metadata")
                        return: -1
                    have_columns: 1
                    field: field\next
                    continue
                if: lm_l4_text_equals(c.node->as.frame.head, "rows") != 0
                    if: have_name = 0 || have_columns = 0
                        lm_l4_error(loader, "table rows must appear after name and columns")
                        return: -1
                    status: lm_l4_rows_from_frame(loader, context, c.&node->as.frame, table_name, columns, column_count)
                    if: status <= 0
                        return: -1
                    have_rows: 1
                    field: field\next
                    continue
                lm_l4_error(loader, "table body expects name/columns/rows frames")
                return: -1
            field: field\next

        if: have_name = 0 || have_columns = 0 || have_rows = 0
            lm_l4_error(loader, "table requires name, columns and rows")
            return: -1
        if: lm_l4_validate_named_trailer(loader, frame, table_name) != 0
            return: -1

        return: 1
    end: lm_l4_table_from_frame

    fn: lm_l4_seen_table_add (@: LmOwnPtrStack seen; LmP0Text: table_name) int
        LmP0Text: payload
        @: char name
        size_t: i
        size_t: payload_length
        @: char existing

        if: seen = 0
            return: -1
        if: lm_l4_identifier_value(table_name, @ payload) = 0
            return: -1
        payload_length: c.payload.length

        i: 0U
        while: i < seen\count
            existing: c.lm_own_ptr_stack_at(seen, i)
            if: existing != 0 && lm_l4_text_equals(payload, existing) != 0
                return: 1
            i: i + 1U

        name: c.malloc(payload_length + 1U)
        if: name = 0
            return: -1
        if: payload_length > 0U
            c.memcpy(name, c.payload.data, payload_length)
        name[payload_length]: '\0'
        if: c.lm_own_ptr_stack_push(seen, name) != 0
            c.free(name)
            return: -1
        return: 0
    end: lm_l4_seen_table_add

    fn: lm_l4_check_table_frame_unique (const: @(LmL4Loader loader); const: @(LmP0Frame frame); @: LmOwnPtrStack seen) int
        const: @: LmP0Field field
        const: @: LmP0Node node
        LmP0Text: table_name
        int: status

        if: frame = 0 || lm_l4_text_equals(frame\head, "table") = 0
            return: 0

        status: 0
        field: c.frame->body.first_field
        while: field != 0
            node: field\value
            if: node = 0 || lm_l4_node_is_ignored(node) != 0 || node\kind != c.LM_P0_NODE_FRAME
                field: field\next
                continue
            status: lm_l4_frame_single_atom(c.&node->as.frame, "name", @ table_name)
            if: status < 0
                lm_l4_error(loader, "table name expects exactly one atom")
                return: -1
            if: status > 0
                break
            field: field\next
        if: status = 0
            return: 0

        status: lm_l4_seen_table_add(seen, table_name)
        if: status < 0
            lm_l4_error(loader, "cannot record table name")
            return: -1
        if: status > 0
            lm_l4_error(loader, "duplicate table in one L4 schema")
            return: -1

        return: 0
    end: lm_l4_check_table_frame_unique

    fn: lm_l4_receiver_table (const: @(LmL4Loader loader); @: void context; const: @(LmP0Frame frame)) int
        int: status

        if: c.lm_l4_seen_tables_get() != 0 && lm_l4_check_table_frame_unique(loader, frame, c.lm_l4_seen_tables_get()) != 0
            return: 1

        status: lm_l4_table_from_frame(loader, context, frame)
        if: status <= 0
            if: status = 0
                lm_l4_error(loader, "table receiver expects table frame")
            return: 1
        return: 0
    end: lm_l4_receiver_table

    fn: lm_l4_receiver_row (const: @(LmL4Loader loader); @: void context; const: @(LmP0Frame frame)) int
        int: status

        status: lm_l4_row_from_frame(loader, context, frame)
        if: status <= 0
            if: status = 0
                lm_l4_error(loader, "row receiver expects row frame")
            return: 1
        return: 0
    end: lm_l4_receiver_row

    fn: lm_l4_find_receiver (const: @(LmL4Loader loader); LmP0Text: head) const: @: LmL4Receiver
        size_t: i

        if: loader = 0 || loader\receivers = 0
            return: 0

        i: 0U
        while: i < loader\receiver_count
            if: c.loader->receivers[i].name != 0 && lm_l4_text_equals(head, c.loader->receivers[i].name) != 0
                return: c.&loader->receivers[i]
            i: i + 1U
        return: 0
    end: lm_l4_find_receiver

    fn: lm_l4_dispatch_frame (const: @(LmL4Loader loader); @: void context; const: @(LmP0Frame frame)) int
        const: @: LmL4Receiver receiver

        if: frame = 0
            return: 1
        receiver: lm_l4_find_receiver(loader, frame\head)
        if: receiver = 0 || receiver\frame = 0
            lm_l4_error(loader, "registry body expects registered L4 receiver frames")
            return: 1
        return: c.receiver->frame(loader, context, frame)
    end: lm_l4_dispatch_frame

    fn: lm_l4_load_rows (const: @(LmL4Loader loader); @: void context; const: @(LmP0Structure structure)) int
        const: @: LmP0Field field
        const: @: LmP0Node node
        @: LmOwnPtrStack seen
        @: LmOwnPtrStack previous_seen
        int: owns_seen
        int: status

        if: structure = 0
            return: 0

        owns_seen: c.lm_l4_seen_tables_get() = 0
        seen: 0
        previous_seen: 0
        if: owns_seen != 0
            seen: c.malloc(c.sizeof(seen[0]))
            if: seen = 0
                lm_l4_error(loader, "cannot allocate table duplicate tracker")
                return: 1
            c.lm_own_ptr_stack_init: seen c.free
            previous_seen: c.lm_l4_seen_tables_get()
            c.lm_l4_seen_tables_set: seen
        status: 0

        field: structure\first_field
        while: field != 0 && status = 0
            node: field\value
            if: lm_l4_node_is_ignored(node) != 0
                field: field\next
                continue
            if: node\kind != c.LM_P0_NODE_FRAME
                lm_l4_error(loader, "registry body expects registered L4 receiver frames")
                status: 1
                field: field\next
                continue
            if: lm_l4_dispatch_frame(loader, context, c.&node->as.frame) != 0
                status: 1
            field: field\next

        if: owns_seen != 0
            c.lm_l4_seen_tables_set: previous_seen
            c.lm_own_ptr_stack_destroy: seen
            c.free(seen)
        return: status
    end: lm_l4_load_rows

    fn: lm_l4_load_root (const: @(LmL4Loader loader); @: void context; const: @(LmP0Node root); int: implicit_l4; @: size_t out_row_count) int
        const: @: LmP0Field field
        const: @: LmP0Node node
        @: LmOwnPtrStack seen
        @: LmOwnPtrStack previous_seen
        int: loaded
        int: status

        if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
            lm_l4_error(loader, "root must be a Structure")
            return: 1
        if: out_row_count != 0
            out_row_count[0]: 0U

        seen: c.malloc(c.sizeof(seen[0]))
        if: seen = 0
            lm_l4_error(loader, "cannot allocate table duplicate tracker")
            return: 1
        c.lm_own_ptr_stack_init: seen c.free
        previous_seen: c.lm_l4_seen_tables_get()
        c.lm_l4_seen_tables_set: seen
        loaded: 0
        status: 0

        field: c.root->as.structure.first_field
        while: field != 0 && status = 0
            node: field\value
            if: lm_l4_node_is_ignored(node) != 0
                field: field\next
                continue
            if: node\kind != c.LM_P0_NODE_FRAME
                lm_l4_error(loader, "root fields must be L4/registry frames, or registered L4 receiver frames in .lm4 files")
                status: 1
                field: field\next
                continue
            if: lm_l4_text_equals(c.node->as.frame.head, "L4") != 0 || lm_l4_text_equals(c.node->as.frame.head, "registry") != 0
                if: lm_l4_load_rows(loader, context, c.&node->as.frame.body) != 0
                    status: 1
                if: status = 0 && lm_l4_validate_named_trailer(loader, c.&node->as.frame, c.node->as.frame.head) != 0
                    status: 1
                if: status = 0
                    loaded: 1
                field: field\next
                continue
            if: implicit_l4 != 0
                if: lm_l4_dispatch_frame(loader, context, c.&node->as.frame) != 0
                    status: 1
                if: status = 0
                    loaded: 1
                field: field\next
                continue
            lm_l4_error(loader, "root fields must be L4/registry frames")
            status: 1
            field: field\next

        if: status = 0 && loaded = 0
            lm_l4_error(loader, "no rows loaded")
            status: 1

        c.lm_l4_seen_tables_set: previous_seen
        c.lm_own_ptr_stack_destroy: seen
        c.free(seen)
        return: status
    end: lm_l4_load_root
