static int lm_l4_receiver_ignore(
    const LmL4Loader *loader,
    void *context,
    const LmP0Frame *frame
) {
    (void)loader;
    (void)context;
    (void)frame;
    return 0;
}

static const LmL4Receiver lm_l4_default_receivers[] = {
    { "table", lm_l4_receiver_table },
    { "row", lm_l4_receiver_row },
    { "fn", lm_l4_receiver_ignore }
};

