fn: lm_trans_node_is_ignored (const: (LmP0Node: node)) int
return: node = 0 || (node\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX)) != 0U

fn: lm_trans_node_is_positional_skip (const: (LmP0Node: node)) int
return: node != 0 && (node\flags & c.LM_P0_NODE_POSITIONAL_SKIP) != 0U

fn: lm_trans_trailer_single_atom (const: (LmP0Trailer: trailer); LmP0Text: out_text) int
    const: LmP0Text: atom
    const: LmP0Field: field

    if: trailer = 0 || out_text = 0
        return: 0

    field: trailer\body\first_field
    if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0

    atom: field\value\as\atom
    out_text[0]: c.*atom
return: 1

fn: lm_trans_symbol_class_name (const: @(char class_name)) const: @: char
    if: class_name != 0
        return: class_name
return: "symbol"

fn: lm_trans_symbol_class_is (const: @(char class_name); const: @(char expected)) int
return: class_name != 0 && expected != 0 && c.strcmp(class_name, expected) = 0

fn: lm_trans_symbol_is (const: (LmTransSymbol: symbol); const: @(char class_name)) int
return: symbol != 0 && lm_trans_symbol_class_is(symbol\class_name, class_name) != 0

LmOwnPtrStack: lm_trans_callable_projection_cache
const: LmRegistryView: lm_trans_callable_projection_cache_view
size_t: lm_trans_callable_projection_cache_generation
int: lm_trans_callable_projection_cache_view_mode

sub: lm_trans_callable_projection_cache_entry_delete_any (@: void object)
    LmTransCallableProjectionCacheEntry: entry

    entry: cast: (LmTransCallableProjectionCacheEntry) object
    if: entry = 0
        return
    lm_own_delete(entry\class_name, 0)
    entry\class_name: 0
    entry\projection: 0
    lm_own_delete(entry, 0)
end: lm_trans_callable_projection_cache_entry_delete_any

sub: lm_trans_callable_projection_cache_reset ()
    lm_trans_ptr_stack_delete(@ lm_trans_callable_projection_cache)
    lm_trans_callable_projection_cache_view: 0
    lm_trans_callable_projection_cache_generation: 0U
    lm_trans_callable_projection_cache_view_mode: 0
end: lm_trans_callable_projection_cache_reset

fn: lm_trans_callable_projection_cache_sync () int
    const: LmRegistryView: view
    const: LmRegistryView: current
    size_t: generation

    view: 0
    if: lm_trans_registry != 0
        view: lm_trans_registry\view
    current: view
    generation: 0U
    while: current != 0
        generation: generation + current\mutation_generation
        current: current\parent
    if: lm_trans_callable_projection_cache != 0 && lm_trans_callable_projection_cache_view = view && lm_trans_callable_projection_cache_generation = generation && lm_trans_callable_projection_cache_view_mode = lm_trans_registry\view_mode
        return: 1
    lm_trans_callable_projection_cache_reset()
    if: view = 0
        return: 0
    lm_trans_callable_projection_cache: lm_trans_ptr_stack_new(lm_trans_callable_projection_cache_entry_delete_any)
    if: lm_trans_callable_projection_cache = 0
        return: 0
    lm_trans_callable_projection_cache_view: view
    lm_trans_callable_projection_cache_generation: generation
    lm_trans_callable_projection_cache_view_mode: lm_trans_registry\view_mode
return: 1

fn: lm_trans_callable_projection_cache_entry_new (const: @(char class_name); const: @(char projection)) LmTransCallableProjectionCacheEntry
    LmTransCallableProjectionCacheEntry: entry

    if: class_name = 0
        return: 0
    entry: lm_own_new_zero(c.sizeof(entry[0]))
    if: entry = 0
        return: 0
    entry\class_name: lm_table_descriptor_copy_cstr(class_name)
    if: entry\class_name = 0
        lm_own_delete(entry, 0)
        return: 0
    entry\projection: projection
return: entry

fn: lm_trans_callable_projection_from_class (const: @(char class_name)) const: @: char
    const: LmTransCallableProjectionCacheEntry: entry
    LmTransCallableProjectionCacheEntry: new_entry
    LmP0Text: class_text
    const: @: char projection
    size_t: index
    int: cache_ready

    if: class_name = 0
        return: 0
    cache_ready: lm_trans_callable_projection_cache_sync()
    if: cache_ready != 0
        index: 0U
        while: index < lm_trans_callable_projection_cache\count
            entry: cast: (const: LmTransCallableProjectionCacheEntry) lm_own_ptr_stack_at(lm_trans_callable_projection_cache, index)
            if: entry != 0 && entry\class_name != 0 && c.strcmp(entry\class_name, class_name) = 0
                return: entry\projection
            index: index + 1U
    ---
    class_text: lm_trans_text_from_cstr(class_name)
    if: class_text = 0
        return: 0
    projection: lm_trans_callable_projection_payload(0, class_text)
    lm_trans_text_ref_destroy(@ class_text)
    if: cache_ready != 0
        new_entry: lm_trans_callable_projection_cache_entry_new(class_name, projection)
        if: new_entry != 0
            if: lm_own_ptr_stack_push(lm_trans_callable_projection_cache, new_entry) != 0
                lm_trans_callable_projection_cache_entry_delete_any(new_entry)
            ---
        ---
return: projection

fn: lm_trans_symbol_callable_projection (const: (LmTransSymbol: symbol)) const: @: char
    if: symbol = 0 || symbol\class_name = 0
        return: 0
return: lm_trans_callable_projection_from_class(symbol\class_name)

fn: lm_trans_callable_projection_class_is (const: @(char class_name); const: @(char projection)) int
    const: @: char actual

    if: class_name = 0 || projection = 0
        return: 0
    actual: lm_trans_callable_projection_from_class(class_name)
return: actual != 0 && c.strcmp(actual, projection) = 0

fn: lm_trans_callable_projection_is_executable (const: @(char projection)) int
return: projection != 0 && (c.strcmp(projection, "c.function-symbol") = 0 || c.strcmp(projection, "c.procedure-symbol") = 0 || c.strcmp(projection, "c.function-pointer") = 0 || c.strcmp(projection, "c.closure-struct") = 0)

fn: lm_trans_atom_statement_receiver_binding (const: (LmP0Text: atom)) const: @: char
return: lm_trans_namespace_registry_source_path_n2_named_typed_value(0, atom, "receiver.atom.statement", "class", "class", "receiver", "binding")

fn: lm_trans_symbol_has_callable_projection (const: (LmTransSymbol: symbol); const: @(char projection)) int
    const: @: char actual

    actual: lm_trans_symbol_callable_projection(symbol)
return: actual != 0 && projection != 0 && c.strcmp(actual, projection) = 0

fn: lm_trans_symbol_is_executable_callable (const: (LmTransSymbol: symbol)) int
return: symbol != 0 && symbol\callable_is_thread_handler = 0 && symbol\has_callable_shape != 0 && lm_trans_callable_projection_is_executable(lm_trans_symbol_callable_projection(symbol)) != 0

fn: lm_trans_symbol_is_value_callable (const: (LmTransSymbol: symbol)) int
return: lm_trans_symbol_is_executable_callable(symbol) != 0 && symbol\callable_returns_value != 0

fn: lm_trans_callable_value_new () LmTransCallableValue
    LmTransCallableValue: value

    value: lm_own_new_zero(c.sizeof(value[0]))
return: value

sub: lm_trans_callable_value_delete (LmTransCallableValue: value)
    lm_own_delete(value, 0)
end: lm_trans_callable_value_delete

fn: lm_trans_callable_value_from_symbol (
    const: LmTransSymbol: symbol
    const: LmP0Text: fallback_name
    LmTransCallableValue: out
) int
    if: out = 0
        return: 1

    out\symbol: symbol
    out\code_name: fallback_name
    out\closure_call_name: 0
    out\env_arg: 0
    out\has_env_arg: 0
    out\has_closure_call: 0
    out\uses_closure_struct: 0

    if: symbol = 0
        return: 0

    if: symbol\has_c_name
        out\code_name: symbol\c_name
    if: symbol\has_closure_call_name
        out\closure_call_name: symbol\closure_call_name
        out\has_closure_call: 1
    if: symbol\has_env_arg
        out\env_arg: symbol\env_arg
        out\has_env_arg: 1
    out\uses_closure_struct: lm_trans_symbol_has_callable_projection(symbol, "c.closure-struct")
return: 0

fn: lm_trans_callable_value_from_resolved_symbol (
    const: LmTransSymbol: symbol
    const: LmP0Text: fallback_name
    LmTransCallableValue: out
) int
return: lm_trans_callable_value_from_symbol(symbol, fallback_name, out)

fn: lm_trans_callable_value_resolve (
    const: LmTransNamespace: namespace_
    const: LmP0Text: name
    LmTransCallableValue: out
) const: LmTransSymbol
    const: LmTransSymbol: symbol

    symbol: lm_trans_namespace_find(namespace_, name)
    if: lm_trans_callable_value_from_resolved_symbol(symbol, name, out) != 0
        return: 0
return: symbol

sub: lm_trans_symbol_destroy_fields (LmTransSymbol: symbol)
    if: symbol != 0
        c.lm_trans_text_ref_destroy(c.&symbol->name)
        lm_own_delete(symbol\name_storage, 0)
        symbol\name_storage: 0
        c.lm_trans_text_ref_destroy(c.&symbol->c_name)
        lm_own_delete(symbol\c_name_storage, 0)
        symbol\c_name_storage: 0
        symbol\has_c_name: 0
        c.lm_trans_text_ref_destroy(c.&symbol->env_arg)
        lm_own_delete(symbol\env_arg_storage, 0)
        symbol\env_arg_storage: 0
        symbol\has_env_arg: 0
        c.lm_trans_text_ref_destroy(c.&symbol->closure_call_name)
        lm_own_delete(symbol\closure_call_name_storage, 0)
        symbol\closure_call_name_storage: 0
        symbol\has_closure_call_name: 0
        c.lm_trans_ptr_stack_delete(c.&symbol->param_names)
        symbol\has_signature: 0
        symbol\callable_params_node: 0
        symbol\callable_return_node: 0
        symbol\has_callable_shape: 0
        symbol\callable_returns_value: 0
        symbol\callable_is_struct_return: 0
        lm_trans_descriptor_delete_any(symbol\descriptor)
        symbol\descriptor: 0
end: lm_trans_symbol_destroy_fields

sub: lm_trans_symbol_destroy_fields_any (@: void object)
    LmTransSymbol: symbol

    symbol: object
    lm_trans_symbol_destroy_fields(symbol)
end: lm_trans_symbol_destroy_fields_any

sub: lm_trans_symbol_destroy (LmTransSymbol: symbol)
    lm_own_delete(symbol, c.lm_trans_symbol_destroy_fields_any)
end: lm_trans_symbol_destroy

sub: lm_trans_symbol_delete_any (@: void object)
    LmTransSymbol: symbol

    symbol: object
    lm_trans_symbol_destroy(symbol)
end: lm_trans_symbol_delete_any

sub: lm_trans_free_any (@: void object)
    lm_own_delete(object, 0)
end: lm_trans_free_any
