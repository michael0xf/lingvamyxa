return: 0

fn: lm_trans_registry_load_l4_structure (const: (LmP0Structure: structure); int: allow_node_cells) int
    const: LmP0Field: field
    const: LmP0Node: node
    int: loaded
    int: handled

    field: 0
    if: structure != 0
        field: structure\first_field
    while: field != 0
        node: field\value
        if: lm_trans_node_is_ignored(node) = 0
            handled: 0
            if: node\kind = c.LM_P0_NODE_ATOM
                if: lm_trans_registry_load_l4_atom(node\as\atom, allow_node_cells, @ loaded) != 0
                    return: 1
                if: loaded = 0
                    c.fprintf(c.stderr, "trans L4 error: unknown L4 atom receiver\n")
                    return: 1
                handled: 1
            ---
            if: node\kind = c.LM_P0_NODE_FRAME
                if: lm_trans_registry_load_l4_frame(node\as\frame, allow_node_cells, @ loaded) != 0
                    return: 1
                if: loaded = 0
                    c.fprintf(c.stderr, "trans L4 error: unknown L4 receiver\n")
                    return: 1
                handled: 1
            ---
            if: handled = 0
                c.fprintf(c.stderr, "trans L4 error: L4 body expects registered L4 atom or frame receivers\n")
                return: 1
        ---
        field: field\next
return: 0

fn: lm_trans_l4_root_receiver_registry (const: (LmP0Frame: frame); int: allow_node_cells) int
    if: frame = 0
        return: 1
    if: lm_trans_registry_load_l4_structure(frame\body, allow_node_cells) != 0
        return: 1
return: 0

fn: lm_trans_registry_load_l4_root_frame (const: (LmP0Frame: frame); int: allow_node_cells; @: int out_loaded) int
    LmTransL4HeadBinding: binding
