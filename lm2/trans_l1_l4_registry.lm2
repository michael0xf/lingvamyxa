    binding: lm_trans_l4_atom_pointer_binding_find(atom, bindings)
    if: binding = 0
        c.fprintf:
            c.stderr
            "trans registry inconsistency: %s[\"%.*s\"] has no direct L4 atom pointer binding\n"
            namespace_table (cast: int atom\length) atom\data
        return: 1

    if: c.strcmp(receiver_type, binding\receiver_type) != 0
        c.fprintf:
            c.stderr
            "trans registry inconsistency: %s[\"%.*s\"] has receiver marker %s, expected %s\n"
            namespace_table (cast: int atom\length) atom\data receiver_type binding\receiver_type
        return: 1

    out\receiver_type: receiver_type
    out\receiver_binding: 0
    out\atom: binding\handler
return: 0

fn: lm_trans_l4_atom_binding_resolve (const: (LmP0Text: atom); LmTransL4AtomBinding: out) int
    const: LmOwnPtrStack: bindings

    bindings: 0
    if: lm_trans_registry != 0
        bindings: lm_trans_registry\l4_atom_pointer_bindings
return: lm_trans_l4_atom_binding_resolve_from_pointer_table(atom, "namespace.l4.atom", bindings, out)

fn: lm_trans_registry_load_l4_frame (const: (LmP0Frame: frame); int: allow_node_cells; @: int out_loaded) int
    LmTransL4HeadBinding: binding
    int: status

    if: out_loaded != 0
        out_loaded[0]: 0
    if: frame = 0
        return: 1
    binding: lm_own_new_zero(c.sizeof(binding[0]))
    if: binding = 0
        return: 1
    if: lm_trans_l4_head_binding_resolve(frame\head, binding) != 0
        lm_own_delete(binding, 0)
        return: 1
    if: binding\frame = 0
        lm_own_delete(binding, 0)
        return: 0
    status: binding\frame(frame, allow_node_cells)
    lm_own_delete(binding, 0)
    if: status != 0
        return: 1
    if: out_loaded != 0
        out_loaded[0]: 1
return: 0

fn: lm_trans_registry_load_l4_atom (const: (LmP0Text: atom); int: allow_node_cells; @: int out_loaded) int
    LmTransL4AtomBinding: binding
    int: status

    if: out_loaded != 0
        out_loaded[0]: 0
