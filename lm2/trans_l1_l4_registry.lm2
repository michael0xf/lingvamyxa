    if: binding = 0
        return: 1
    if: lm_trans_l4_atom_binding_resolve(atom, binding) != 0
        lm_own_delete(binding, 0)
        return: 1
    if: binding\atom = 0
        lm_own_delete(binding, 0)
        return: 0
    status: binding\atom(atom, allow_node_cells)
    lm_own_delete(binding, 0)
    if: status != 0
