    if: lm_trans_l4_root_head_binding_resolve(frame\head, binding) != 0
        lm_own_delete(binding, 0)
        return: 1
    if: binding\frame = 0
        lm_own_delete(binding, 0)
        return: 0
    status: binding\frame(frame, allow_node_cells)
    lm_own_delete(binding, 0)
    if: status != 0
        return: 1
    if: out_loaded != 0
        out_loaded[0]: 1
return: 0

fn: lm_trans_registry_l4_push_row (@: void context; const: (LmP0Text: table_atom); const: (LmP0Text: key_atom); const: (LmP0Node: payload_node)) int
    LmTransL4LoadContext: load_context
    LmP0Text: table_value
    LmP0Text: key_value
    int: status

    load_context: cast: (LmTransL4LoadContext) context
    if: table_atom = 0 || key_atom = 0 || payload_node = 0
        return: -1
    if: payload_node\kind = c.LM_P0_NODE_ATOM
        return: lm_trans_registry_push_row_atoms(table_atom, key_atom, payload_node\as\atom)
    if: load_context = 0 || load_context\allow_node_cells = 0
        c.fprintf(c.stderr, "trans registry error: node row payloads are not allowed in this registry load\n")
        return: -1

    table_value: lm_trans_l4_text_view_new("")
    key_value: lm_trans_l4_text_view_new("")
    if: table_value = 0 || key_value = 0
        lm_trans_l4_text_view_delete(@ table_value)
        lm_trans_l4_text_view_delete(@ key_value)
        return: -1
    if: lm_trans_registry_identifier_value(table_atom, table_value) = 0 || lm_trans_registry_identifier_value(key_atom, key_value) = 0
        lm_trans_l4_text_view_delete(@ table_value)
        lm_trans_l4_text_view_delete(@ key_value)
        return: -1
    status: lm_trans_registry_push_row_node_values(table_value, key_value, payload_node)
    lm_trans_l4_text_view_delete(@ table_value)
    lm_trans_l4_text_view_delete(@ key_value)
return: status

fn: lm_trans_registry_l4_source_descriptor_new (const: (LmP0Text: table_name); @: LmL4Column columns; size_t: column_count) LmTableDescriptor
    LmP0Text: table_value
    LmP0Text: column_value
    LmP0Text: descriptor_value
    LmP0Text: type_value
    LmTableDescriptor: descriptor
    LmTableColumnDescriptor: target_column
    size_t: column_index
    size_t: descriptor_index

    if: table_name = 0 || columns = 0 || column_count = 0U
        return: 0
    table_value: lm_trans_l4_text_view_new("")
    column_value: lm_trans_l4_text_view_new("")
    descriptor_value: lm_trans_l4_text_view_new("")
    type_value: lm_trans_l4_text_view_new("")
    descriptor: 0
    if: table_value = 0 || column_value = 0 || descriptor_value = 0 || type_value = 0 || lm_trans_registry_identifier_value(table_name, table_value) = 0
        lm_trans_l4_text_view_delete(@ table_value)
        lm_trans_l4_text_view_delete(@ column_value)
        lm_trans_l4_text_view_delete(@ descriptor_value)
        lm_trans_l4_text_view_delete(@ type_value)
        return: 0

    descriptor: lm_table_descriptor_new_empty_slice(table_value\data, table_value\length)
    column_index: 0U
    while: descriptor != 0 && column_index < column_count
        if: columns[column_index] = 0 || columns[column_index]\name = 0 || lm_trans_registry_identifier_value(columns[column_index]\name, column_value) = 0
            lm_table_descriptor_delete_any(descriptor)
            descriptor: 0
            break
        if: columns[column_index]\type_name != 0
            if: lm_trans_registry_identifier_value(columns[column_index]\type_name, type_value) = 0
                lm_table_descriptor_delete_any(descriptor)
                descriptor: 0
                break
            target_column: lm_table_column_descriptor_new_slice(column_value\data, column_value\length, type_value\data, type_value\length, columns[column_index]\address_depth, columns[column_index]\array_rank, columns[column_index]\is_const)
        else:
            target_column: lm_table_column_descriptor_new_slice(column_value\data, column_value\length, 0, 0U, columns[column_index]\address_depth, columns[column_index]\array_rank, columns[column_index]\is_const)
        if: target_column = 0
            lm_table_descriptor_delete_any(descriptor)
            descriptor: 0
            break

        descriptor_index: 0U
        while: descriptor_index < columns[column_index]\descriptor_count
            if: columns[column_index]\descriptors[descriptor_index] = 0 || lm_trans_registry_identifier_value(columns[column_index]\descriptors[descriptor_index], descriptor_value) = 0 || lm_table_column_descriptor_add_descriptor_slice(target_column, descriptor_value\data, descriptor_value\length) != 0
                lm_table_column_descriptor_delete_any(target_column)
                lm_table_descriptor_delete_any(descriptor)
                descriptor: 0
                break
            descriptor_index: descriptor_index + 1U
        if: descriptor = 0
            break
        if: lm_table_descriptor_take_column(descriptor, target_column) != 0
            lm_table_column_descriptor_delete_any(target_column)
            lm_table_descriptor_delete_any(descriptor)
            descriptor: 0
            break
        column_index: column_index + 1U

    lm_trans_l4_text_view_delete(@ table_value)
    lm_trans_l4_text_view_delete(@ column_value)
    lm_trans_l4_text_view_delete(@ descriptor_value)
    lm_trans_l4_text_view_delete(@ type_value)
return: descriptor

fn: lm_trans_registry_l4_push_table_row (@: void context; const: (LmP0Text: table_name); @: LmL4Column columns; size_t: column_count; const: @: LmP0Node cells) int
    LmTransL4LoadContext: load_context
    LmTableDescriptor: descriptor
    LmTableRow: row
    LmTableCell: cell
    const: LmP0Node: node
    const: LmP0Text: atom
    LmP0Text: value
    LmTransRegistryFact: projection
    size_t: column_index
    int: cell_status
    int: explicit_none
    int: wants_node

    c.LM_UNUSED(table_name)
    load_context: cast: (LmTransL4LoadContext) context
    if: load_context = 0 || load_context\source_table = 0 || load_context\projection_facts = 0 || columns = 0 || cells = 0 || column_count = 0U
        return: -1
    descriptor: load_context\source_table
    if: lm_table_descriptor_column_count(descriptor) != column_count || load_context\projection_facts\count + 1U != column_count
        return: -1
    row: lm_table_row_new(0)
    value: lm_trans_l4_text_view_new("")
    if: row = 0 || value = 0
        lm_table_row_delete_any(row)
        lm_trans_l4_text_view_delete(@ value)
        return: -1

    column_index: 0U
    while: column_index < column_count
        node: cells[column_index]
        atom: 0
        if: node != 0 && node\kind = c.LM_P0_NODE_ATOM
            atom: node\as\atom
        explicit_none: atom != 0 && lm_trans_registry_payload_is_null(atom) != 0
        projection: 0
        cell_status: 0
        wants_node: 0

        if: column_index = 0U
            if: atom = 0 || lm_trans_registry_identifier_value(atom, value) = 0
                lm_table_row_delete_any(row)
                lm_trans_l4_text_view_delete(@ value)
                return: -1
            cell: lm_table_cell_new_slice(atom\data, atom\length, value\data, value\length, 0, 0, explicit_none)
        else:
            wants_node: lm_trans_registry_column_has_descriptor(columns[column_index], "node")
            if: wants_node != 0
                if: explicit_none != 0
                    cell: lm_table_cell_new_slice(atom\data, atom\length, 0, 0U, 0, 0, 1)
                else:
                    projection: lm_own_ptr_stack_at(load_context\projection_facts, column_index - 1U)
                    if: projection = 0 || projection\payload_node = 0
                        lm_table_row_delete_any(row)
                        lm_trans_l4_text_view_delete(@ value)
                        return: -1
                    if: atom != 0
                        cell: lm_table_cell_new_slice(atom\data, atom\length, 0, 0U, projection\payload_node, projection, 0)
                    else:
                        cell: lm_table_cell_new_slice(0, 0U, 0, 0U, projection\payload_node, projection, 0)
            ---
            else:
                if: atom = 0
                    lm_table_row_delete_any(row)
                    lm_trans_l4_text_view_delete(@ value)
                    return: -1
                cell_status: lm_trans_registry_cell_value(atom, columns[column_index], value)
                if: cell_status < 0
                    lm_table_row_delete_any(row)
                    lm_trans_l4_text_view_delete(@ value)
                    return: -1
                if: cell_status = 0
                    cell: lm_table_cell_new_slice(atom\data, atom\length, 0, 0U, 0, 0, explicit_none)
                else:
                    projection: lm_own_ptr_stack_at(load_context\projection_facts, column_index - 1U)
                    if: projection = 0 || projection\payload = 0
                        lm_table_row_delete_any(row)
                        lm_trans_l4_text_view_delete(@ value)
                        return: -1
                    cell_status: lm_table_descriptor_cstr_equals_slice(projection\payload, value\data, value\length)
                    if: cell_status = 0
                        lm_table_row_delete_any(row)
                        lm_trans_l4_text_view_delete(@ value)
                        return: -1
                    cell: lm_table_cell_new_slice(atom\data, atom\length, projection\payload, c.strlen(projection\payload), 0, projection, 0)
        ---

        if: cell = 0 || lm_table_row_take_cell(row, cell) != 0
            lm_table_cell_delete_any(cell)
            lm_table_row_delete_any(row)
            lm_trans_l4_text_view_delete(@ value)
            return: -1
        column_index: column_index + 1U

    lm_trans_l4_text_view_delete(@ value)
    if: lm_table_descriptor_take_materialized_row(descriptor, row) != 0
        lm_table_row_delete_any(row)
        return: -1
    lm_own_ptr_stack_truncate(load_context\projection_facts, 0U)
    load_context\materialized_direct_rows: load_context\materialized_direct_rows + 1U
return: 0

fn: lm_trans_registry_l4_note_key (@: void context; const: (LmP0Text: table_name); const: (LmL4Column: column); const: (LmP0Text: key_atom)) int
    LmTransL4LoadContext: load_context

    c.LM_UNUSED(table_name)
    if: key_atom = 0
        return: -1
    load_context: cast: (LmTransL4LoadContext) context
    if: load_context != 0
        if: load_context\projection_facts = 0 || load_context\projection_facts\count != 0U
            return: -1
        load_context\expected_direct_rows: load_context\expected_direct_rows + 1U
    if: lm_trans_registry_column_is_class_typed(column) != 0
        return: lm_trans_registry_note_class_present(key_atom)
return: 0

fn: lm_trans_registry_l4_push_cell (@: void context; const: (LmP0Text: table_name); const: (LmL4Column: column); int: split_by_column; const: (LmP0Text: key_atom); const: (LmP0Node: payload_node)) int
    LmTransL4LoadContext: load_context
    const: LmRegistryViewRow: view_row
    LmTransRegistryFact: projection
    size_t: fact_count_before
    int: allow_node_cells

    load_context: cast: (LmTransL4LoadContext) context
    if: table_name = 0 || key_atom = 0 || load_context = 0 || load_context\projection_facts = 0 || c.lm_trans_registry = 0
        return: -1
    allow_node_cells: load_context\allow_node_cells != 0
    fact_count_before: c.lm_trans_registry->loaded_fact_count
    if: lm_trans_registry_push_table_cell(table_name, column, split_by_column, key_atom, payload_node, allow_node_cells) != 0
        return: -1
    projection: 0
    if: c.lm_trans_registry->loaded_fact_count > fact_count_before
        view_row: lm_registry_view_fact_at(c.lm_trans_registry->view, c.lm_trans_registry->loaded_fact_count - 1U)
        if: view_row = 0 || view_row\source = 0
            return: -1
        projection: cast: (LmTransRegistryFact) view_row\source
    ---
    if: lm_own_ptr_stack_push(load_context\projection_facts, projection) != 0
        return: -1
    if: lm_trans_registry_column_is_class_typed(column) != 0 && payload_node != 0 && payload_node\kind = c.LM_P0_NODE_ATOM && lm_trans_registry_payload_is_null(payload_node\as\atom) = 0
        return: lm_trans_registry_note_class_present(payload_node\as\atom)
return: 0

fn: lm_trans_registry_l4_push_column_metadata (@: void context; const: (LmP0Text: table_name); @: LmL4Column columns; size_t: column_count) int
    LmTransL4LoadContext: load_context
    LmTableDescriptor: candidate
    LmTableDescriptor: existing

    load_context: cast: (LmTransL4LoadContext) context
    if: load_context = 0 || table_name = 0 || c.lm_trans_registry = 0 || c.lm_trans_registry->view = 0
        return: -1
    candidate: lm_trans_registry_l4_source_descriptor_new(table_name, columns, column_count)
    if: candidate = 0
        return: -1
    existing: lm_registry_view_find_local_source_table_slice(c.lm_trans_registry->view, candidate\name, c.strlen(candidate\name))
    if: existing != 0 && lm_table_descriptor_schema_same(existing, candidate) != 0
        lm_table_descriptor_delete_any(candidate)
        load_context\source_table: existing
    else:
        if: lm_registry_view_take_local_source_table(c.lm_trans_registry->view, candidate) != 0
            lm_table_descriptor_delete_any(candidate)
            return: -1
        load_context\source_table: candidate
    ---
    load_context\source_table_initial_row_count: lm_table_descriptor_materialized_row_count(load_context\source_table)
return: lm_trans_registry_push_column_metadata(table_name, columns, column_count)

fn: lm_trans_registry_l4_join_table (@: void context; const: (LmP0Text: source_table); const: (LmP0Text: target_table)) int
    LmTransL4LoadContext: load_context
    LmP0Text: source_value
    LmP0Text: target_value
    size_t: target_row_count

    load_context: cast: (LmTransL4LoadContext) context
    if: load_context = 0 || load_context\source_table = 0 || source_table = 0 || target_table = 0
        return: -1
    source_value: lm_trans_l4_text_view_new("")
    target_value: lm_trans_l4_text_view_new("")
    if: source_value = 0 || target_value = 0
        lm_trans_l4_text_view_delete(@ source_value)
        lm_trans_l4_text_view_delete(@ target_value)
        return: -1
    if: lm_trans_registry_identifier_value(source_table, source_value) = 0 || lm_trans_registry_identifier_value(target_table, target_value) = 0
        lm_trans_l4_text_view_delete(@ source_value)
        lm_trans_l4_text_view_delete(@ target_value)
        return: -1
    if: lm_table_descriptor_cstr_equals_slice(load_context\source_table\name, target_value\data, target_value\length) = 0
        lm_trans_l4_text_view_delete(@ source_value)
        lm_trans_l4_text_view_delete(@ target_value)
        return: -1
    target_row_count: lm_table_descriptor_materialized_row_count(load_context\source_table)
    if: lm_registry_view_append_materialized_rows(c.lm_trans_registry->view, load_context\source_table, source_value\data, source_value\length) != 0
        c.fprintf(c.stderr, "trans registry error: cannot copy source rows in join %.*s -> %.*s\n", (cast: int source_value\length), source_value\data, (cast: int target_value\length), target_value\data)
        lm_trans_l4_text_view_delete(@ source_value)
        lm_trans_l4_text_view_delete(@ target_value)
        return: -1
    if: lm_trans_registry_join_table(source_table, target_table) != 0
        lm_own_ptr_stack_truncate(load_context\source_table\materialized_rows, target_row_count)
        lm_trans_l4_text_view_delete(@ source_value)
        lm_trans_l4_text_view_delete(@ target_value)
        return: -1
    lm_trans_l4_text_view_delete(@ source_value)
    lm_trans_l4_text_view_delete(@ target_value)
return: 0

fn: lm_trans_registry_l4_formal_param_unwrap_index (const: (LmL4Loader: loader); @: void context; const: (LmP0Frame: frame); @: size_t out_index) int
    c.LM_UNUSED(loader)
    c.LM_UNUSED(context)
return: lm_trans_frame_formal_param_unwrap_index(frame, out_index)

fn: lm_trans_registry_l4_positional_name_index (const: (LmL4Loader: loader); @: void context; const: (LmP0Frame: frame); @: size_t out_index) int
    c.LM_UNUSED(loader)
    c.LM_UNUSED(context)
return: lm_trans_frame_positional_name_index(frame, out_index)

fn: lm_trans_registry_l4_resolve_frame (const: (LmL4Loader: loader); const: (LmP0Text: head)) LmL4FrameReceiver
    const: @: char receiver_type
    int: head_length
    const: @: char head_data

    c.LM_UNUSED(loader)
    head_length: 0
    head_data: ""
    if: head != 0
        head_length: cast: int head\length
        head_data: head\data
    receiver_type: lm_trans_l4_namespace_receiver_type_value(head, "namespace.l4")
    if: receiver_type = 0
        return: 0
    if: c.strcmp(receiver_type, "l4.frame") != 0
        c.fprintf:
            c.stderr
            "trans registry inconsistency: namespace.l4[\"%.*s\"] has receiver marker %s, expected l4.frame\n"
            head_length head_data receiver_type
        return: 0
    if: lm_trans_text_equals(head, "table") != 0
        return: @ lm_l4_receiver_table
    if: lm_trans_text_equals(head, "join") != 0
        return: @ lm_l4_receiver_join
    if: lm_trans_text_equals(head, "row") != 0
        return: @ lm_l4_receiver_row
    if: lm_trans_text_equals(head, "fn") != 0 || lm_trans_text_equals(head, "callable") != 0
        return: @ lm_l4_receiver_ignore
    c.fprintf:
        c.stderr
        "trans registry inconsistency: namespace.l4[\"%.*s\"] has no direct frame receiver binding\n"
        head_length head_data
return: 0

fn: lm_trans_registry_l4_dispatch_frame (const: (LmL4Loader: loader); @: void context; const: (LmP0Frame: frame)) int
    LmL4FrameReceiver: receiver
    int: head_length
    const: @: char head_data

    if: frame = 0
        return: 1
    head_length: 0
    head_data: ""
    if: frame\head != 0
        head_length: cast: int frame\head\length
        head_data: frame\head\data
    receiver: lm_trans_registry_l4_resolve_frame(loader, frame\head)
    if: receiver = 0
        c.fprintf:
            c.stderr
            "trans registry error: registry body expects registered L4 receiver frames, got \"%.*s\"\n"
            head_length head_data
        return: 1
return: receiver(loader, context, frame)

fn: lm_trans_registry_l4_loader_new () LmL4Loader
    LmL4Loader: loader

    loader: lm_own_new_zero(c.sizeof(loader[0]))
    if: loader = 0
        return: 0
    loader\error_prefix: "trans"
    loader\push_row: @ lm_trans_registry_l4_push_row
    loader\push_cell: @ lm_trans_registry_l4_push_cell
    loader\note_key: @ lm_trans_registry_l4_note_key
    loader\push_column_metadata: @ lm_trans_registry_l4_push_column_metadata
    loader\push_table_row: @ lm_trans_registry_l4_push_table_row
    loader\join_table: @ lm_trans_registry_l4_join_table
    loader\dispatch_frame: @ lm_trans_registry_l4_dispatch_frame
    loader\formal_param_unwrap_index: @ lm_trans_registry_l4_formal_param_unwrap_index
    loader\positional_name_index: @ lm_trans_registry_l4_positional_name_index
return: loader

fn: lm_trans_registry_l4_runtime_init () int
    if: lm_trans_registry = 0
        return: 1
    if: lm_trans_registry\l4_loader = 0
        lm_trans_registry\l4_loader: lm_trans_registry_l4_loader_new()
        if: lm_trans_registry\l4_loader = 0
            return: 1
    ---
    if: lm_trans_l4_pointer_bindings_init() != 0 || lm_trans_l4_payload_pointer_bindings_init() != 0
        return: 1
return: 0

fn: lm_trans_registry_load_root (const: (LmP0Node: root); int: implicit_l4; int: allow_node_cells) int
    const: LmP0Field: field
    const: LmP0Node: node
    int: loaded
    int: item_loaded

    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        c.fprintf(c.stderr, "trans L4 error: root must be a Structure\n")
        return: 1

    loaded: 0
    field: root\as\structure\first_field
    while: field != 0
        node: field\value
        if: lm_trans_node_is_ignored(node) = 0
            if: node\kind != c.LM_P0_NODE_FRAME
                c.fprintf(c.stderr, "trans L4 error: root fields must be registered L4 root receiver frames, or registered L4 receiver frames in .lm4 files\n")
                return: 1
            if: lm_trans_registry_load_l4_root_frame(node\as\frame, allow_node_cells, @ item_loaded) != 0
                return: 1
            if: item_loaded != 0
                loaded: 1
            else:
                if: implicit_l4 != 0
                    if: lm_trans_registry_load_l4_frame(node\as\frame, allow_node_cells, @ item_loaded) != 0
                        return: 1
                    if: item_loaded = 0
                        c.fprintf(c.stderr, "trans L4 error: root fields must be registered L4 root receiver frames, or registered L4 receiver frames in .lm4 files\n")
                        return: 1
                    loaded: 1
                else:
                    c.fprintf(c.stderr, "trans L4 error: root fields must be registered L4 root receiver frames\n")
                    return: 1
        ---
        field: field\next
    if: loaded = 0
        c.fprintf(c.stderr, "trans L4 error: no rows loaded\n")
        return: 1
return: 0

fn: lm_trans_path_has_extension (const: @(char path); const: @(char extension)) int
    size_t: path_length
    size_t: extension_length
    size_t: i
    char: left
    char: right

    if: path = 0 || extension = 0
        return: 0

    path_length: c.strlen(path)
    extension_length: c.strlen(extension)
    if: path_length < extension_length
        return: 0

    i: 0U
    while: i < extension_length
        left: path[path_length - extension_length + i]
        right: extension[i]
        if: left >= 'A' && left <= 'Z'
            left: cast: char (left - 'A' + 'a')
        if: right >= 'A' && right <= 'Z'
            right: cast: char (right - 'A' + 'a')
        if: left != right
            return: 0
        i: i + 1U
return: 1

fn: lm_trans_registry_path_already_loaded (const: @(char registry_path)) int
    size_t: i
    const: @: char loaded_path

    if: registry_path = 0 || lm_trans_registry = 0 || lm_trans_registry\loaded_paths = 0
        return: 0

    i: 0U
    while: i < lm_trans_registry\loaded_paths\count
        loaded_path: lm_own_ptr_stack_at(lm_trans_registry\loaded_paths, i)
        if: loaded_path != 0 && c.strcmp(loaded_path, registry_path) = 0
            return: 1
        i: i + 1U
return: 0

fn: lm_trans_registry_note_loaded_path (const: @(char registry_path)) int
    @: char copy

    if: registry_path = 0
        return: 1
    if: lm_trans_registry_path_already_loaded(registry_path) != 0
        return: 0

    copy: lm_trans_text_copy_cstr_from_cstr(registry_path)
    if: copy = 0
        return: 1
    if: lm_own_ptr_stack_push(lm_trans_registry\loaded_paths, copy) != 0
        lm_own_delete(copy, 0)
        return: 1
return: 0

fn: lm_trans_registry_load_import_frame (const: (LmP0Frame: frame); const: @(char source_path)) int
    const: LmP0Field: field
    const: LmP0Node: node
    LmP0Text: path_value
    @: char candidate_name
    [4096]: char registry_path
    int: loaded

    if: frame = 0
        return: 1

    field: frame\body\first_field
    if: field = 0
        c.fprintf(c.stderr, "trans registry import error: import receiver expects at least one path\n")
        return: 1

    path_value: lm_trans_l4_text_view_new("")
    if: path_value = 0
        return: 1
    while: field != 0
        node: field\value
        if: lm_trans_node_is_ignored(node) = 0
            if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || lm_trans_registry_literal_value(node\as\atom, path_value) = 0
                c.fprintf(c.stderr, "trans registry import error: import path must be an atom/string\n")
                lm_trans_l4_text_view_delete(@ path_value)
                return: 1

            candidate_name: lm_trans_text_copy_cstr(path_value)
            if: candidate_name = 0
                lm_trans_l4_text_view_delete(@ path_value)
                return: 1
            if: lm_trans_registry_candidate_path(source_path, candidate_name, registry_path, 4096U) != 0
                lm_own_delete(candidate_name, 0)
                c.fprintf(c.stderr, "trans registry import error: import path is too long\n")
                lm_trans_l4_text_view_delete(@ path_value)
                return: 1
            lm_own_delete(candidate_name, 0)

            if: lm_trans_registry_path_already_loaded(registry_path) = 0
                if: lm_trans_registry_load_file_path(registry_path, 1, @ loaded) != 0
                    lm_trans_l4_text_view_delete(@ path_value)
                    return: 1
                if: loaded = 0
                    c.fprintf(c.stderr, "trans registry import error: cannot read %s\n", registry_path)
                    lm_trans_l4_text_view_delete(@ path_value)
                    return: 1
        ---
        field: field\next

    lm_trans_l4_text_view_delete(@ path_value)
return: 0

fn: lm_trans_registry_import_frame_new (const: (LmP0Field: field); int: descend_l2) LmTransRegistryImportFrame
    LmTransRegistryImportFrame: frame

    frame: lm_own_new_zero(c.sizeof(frame[0]))
    if: frame != 0
        frame\field: field
        frame\descend_l2: descend_l2
return: frame

fn: lm_trans_registry_load_imports_from_structure (const: (LmP0Structure: structure); const: @(char source_path); int: descend_l2) int
    LmOwnPtrStack: stack
    LmTransRegistryImportFrame: frame
    const: LmP0Node: node
    LmTransHeadBinding: binding
    @: void popped
    int: status

    binding: lm_own_new_zero(c.sizeof(binding[0]))
    if: binding = 0
        return: 1
    if: structure = 0 || structure\first_field = 0
        lm_own_delete(binding, 0)
        return: 0

    stack: lm_trans_ptr_stack_new(lm_own_delete_plain)
    if: stack = 0
        lm_own_delete(binding, 0)
        return: 1
    frame: lm_trans_registry_import_frame_new(structure\first_field, descend_l2)
    if: frame = 0
        lm_trans_ptr_stack_delete(@ stack)
        lm_own_delete(binding, 0)
        return: 1
    if: lm_own_ptr_stack_push(stack, frame) != 0
        lm_own_delete(frame, 0)
        lm_trans_ptr_stack_delete(@ stack)
        lm_own_delete(binding, 0)
        return: 1

    status: 0
    while: status = 0 && stack\count != 0U
        frame: lm_own_ptr_stack_top(stack)
        if: frame = 0 || frame\field = 0
            popped: lm_own_ptr_stack_pop(stack)
            lm_own_delete(popped, 0)
            continue

        node: frame\field\value
        frame\field: frame\field\next
        if: node != 0 && lm_trans_node_is_ignored(node) = 0 && node\kind = c.LM_P0_NODE_FRAME
            if: lm_trans_head_binding_resolve(0, node\as\frame\head, binding) != 0
                status: 1
                break
            if: binding\statement_frame = @ lm_trans_statement_emit_import
                if: lm_trans_registry_load_import_frame(node\as\frame, source_path) != 0
                    status: 1
                    break
            ---
            else:
                if: frame\descend_l2 != 0 && lm_trans_frame_is_l2_level_receiver(node\as\frame) != 0 && node\as\frame\body != 0 && node\as\frame\body\first_field != 0
                    frame: lm_trans_registry_import_frame_new(node\as\frame\body\first_field, 0)
                    if: frame = 0
                        status: 1
                        break
                    if: lm_own_ptr_stack_push(stack, frame) != 0
                        lm_own_delete(frame, 0)
                        status: 1
                        break
            ---
        ---
    lm_trans_ptr_stack_delete(@ stack)
    lm_own_delete(binding, 0)
return: status

fn: lm_trans_registry_load_inline_root (const: (LmP0Node: root); const: @(char source_path)) int
    const: LmP0Field: field
    const: LmP0Node: node
    int: loaded

    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE
        return: 1

    if: lm_trans_registry_load_imports_from_structure(root\as\structure, source_path, 1) != 0
        return: 1

    field: root\as\structure\first_field
    while: field != 0
        node: field\value
        if: node != 0 && lm_trans_node_is_ignored(node) = 0 && node\kind = c.LM_P0_NODE_FRAME
            if: lm_trans_registry_load_l4_root_frame(node\as\frame, 1, @ loaded) != 0
                return: 1
        ---
        field: field\next
return: 0

fn: lm_trans_path_separator (char: ch) int
return: ch = '/' || ch = '\\'

fn: lm_trans_path_is_absolute (const: @(char path)) int
    if: path = 0 || path[0] = '\0'
        return: 0
    if: lm_trans_path_separator(path[0]) != 0
        return: 1
return: ((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z')) && path[1] = ':' && lm_trans_path_separator(path[2]) != 0

fn: lm_trans_path_segment_equals (const: @(char path); size_t: offset; const: @(char segment)) int
    size_t: i

    if: path = 0 || segment = 0
        return: 0
    i: 0U
    while: segment[i] != '\0'
        if: path[offset + i] != segment[i]
            return: 0
        i: i + 1U
return: path[offset + i] = '\0' || lm_trans_path_separator(path[offset + i]) != 0

fn: lm_trans_project_root_length_from_source (const: @(char source_path)) size_t
    size_t: length
    size_t: i

    if: source_path = 0 || lm_trans_path_is_absolute(source_path) = 0
        return: 0U

    length: c.strlen(source_path)
    i: 0U
    while: i < length
        if: (i = 0U || lm_trans_path_separator(source_path[i - 1U]) != 0) && (lm_trans_path_segment_equals(source_path, i, "lm2") != 0 || lm_trans_path_segment_equals(source_path, i, "lm4") != 0 || lm_trans_path_segment_equals(source_path, i, "tests") != 0)
            return: i
        i: i + 1U
return: 0U

fn: lm_trans_registry_project_path_for_source (const: @(char source_path); const: @(char file_name); @: char buffer; size_t: size) int
    size_t: root_length
    size_t: file_length

    if: buffer = 0 || file_name = 0 || size = 0U
        return: 1

    root_length: lm_trans_project_root_length_from_source(source_path)
    file_length: c.strlen(file_name)
    if: root_length = 0U
        if: file_length >= size
            return: 1
        c.strcpy(buffer, file_name)
        return: 0

    if: root_length + file_length >= size
        c.fprintf(c.stderr, "trans error: registry path is too long\n")
        return: 1
    c.memcpy(buffer, source_path, root_length)
    c.strcpy(buffer + root_length, file_name)
return: 0

fn: lm_trans_registry_path_for_source (const: @(char source_path); const: @(char file_name); @: char buffer; size_t: size) int
    size_t: length
    size_t: i
    size_t: slash

    if: buffer = 0 || file_name = 0 || size = 0U
        return: 1

    if: source_path = 0 || source_path[0] = '\0'
        if: c.strlen(file_name) >= size
            return: 1
        c.strcpy(buffer, file_name)
        return: 0

    length: c.strlen(source_path)
    slash: 0U
    i: 0U
    while: i < length
        if: lm_trans_path_separator(source_path[i]) != 0
            slash: i + 1U
        i: i + 1U

    if: slash = 0U
        if: c.strlen(file_name) >= size
            return: 1
        c.strcpy(buffer, file_name)
        return: 0

    if: slash + c.strlen(file_name) >= size
        c.fprintf(c.stderr, "trans error: registry path is too long\n")
        return: 1
    c.memcpy(buffer, source_path, slash)
    c.strcpy(buffer + slash, file_name)
return: 0

fn: lm_trans_registry_load_file_path (const: @(char registry_path); int: required; @: int out_loaded) int
    LmP0Document: document
    const: LmP0Diagnostic: diagnostic
    int: status

    if: out_loaded != 0
        out_loaded[0]: 0
    if: registry_path = 0 || registry_path[0] = '\0'
        if: required != 0
            c.fprintf(c.stderr, "trans registry error: empty registry path\n")
            return: 1
        return: 0
    ---
    if: lm_trans_registry_path_already_loaded(registry_path) != 0
        if: out_loaded != 0
            out_loaded[0]: 1
        return: 0

    document: 0
    status: lm_p0_parse_file(registry_path, @ document)
    if: status != 0
        diagnostic: lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf:
                c.stderr
                "trans registry parse error %d at %zu:%zu in %s: %s\n"
                diagnostic\code diagnostic\line diagnostic\column registry_path diagnostic\message
            lm_p0_document_destroy(document)
            return: 1

        lm_p0_document_destroy(document)
        if: required != 0
            c.fprintf(c.stderr, "trans registry error: cannot read %s\n", registry_path)
            return: 1
        return: 0
    ---

    if: lm_trans_path_has_extension(registry_path, ".lm4") != 0
        status: lm_trans_registry_load_root(lm_p0_document_root(document), 1, 1)
    else:
        status: lm_trans_registry_load_inline_root(lm_p0_document_root(document), registry_path)
    if: status != 0
        lm_p0_document_destroy(document)
        return: 1

    lm_p0_document_destroy(document)
    if: lm_trans_registry_note_loaded_path(registry_path) != 0
        return: 1

    if: out_loaded != 0
        out_loaded[0]: 1
return: 0

fn: lm_trans_registry_candidate_path (const: @(char source_path); const: @(char candidate_name); @: char registry_path; size_t: registry_path_size) int
    if: candidate_name = 0 || registry_path = 0 || registry_path_size = 0U
        return: 1
    if: c.strncmp(candidate_name, "lm2/", 4U) = 0 || c.strncmp(candidate_name, "lm4/", 4U) = 0
        return: lm_trans_registry_project_path_for_source(source_path, candidate_name, registry_path, registry_path_size)
return: lm_trans_registry_path_for_source(source_path, candidate_name, registry_path, registry_path_size)

fn: lm_trans_registry_seed_l4_receivers () int
    if: lm_trans_registry_push_row_values(lm_trans_text_from_cstr("namespace.l4"), lm_trans_text_from_cstr("table"), lm_trans_text_from_cstr("l4.frame")) != 0
        return: 1
    if: lm_trans_registry_push_row_values(lm_trans_text_from_cstr("namespace.l4"), lm_trans_text_from_cstr("join"), lm_trans_text_from_cstr("l4.frame")) != 0
        return: 1
    if: lm_trans_registry_push_row_values(lm_trans_text_from_cstr("namespace.l4"), lm_trans_text_from_cstr("row"), lm_trans_text_from_cstr("l4.frame")) != 0
        return: 1
    if: lm_trans_registry_push_row_values(lm_trans_text_from_cstr("namespace.l4"), lm_trans_text_from_cstr("fn"), lm_trans_text_from_cstr("l4.frame")) != 0
        return: 1
    if: lm_trans_registry_push_row_values(lm_trans_text_from_cstr("namespace.l4"), lm_trans_text_from_cstr("callable"), lm_trans_text_from_cstr("l4.frame")) != 0
        return: 1
    if: lm_trans_registry_push_row_values(lm_trans_text_from_cstr("namespace.l4"), lm_trans_text_from_cstr("sub"), lm_trans_text_from_cstr("l4.frame")) != 0
        return: 1
    if: lm_trans_registry_push_row_values(lm_trans_text_from_cstr("namespace.l4.root"), lm_trans_text_from_cstr("L4"), lm_trans_text_from_cstr("l4.root")) != 0
        return: 1
    if: lm_trans_registry_push_row_values(lm_trans_text_from_cstr("namespace.l4.root"), lm_trans_text_from_cstr("registry"), lm_trans_text_from_cstr("l4.root")) != 0
        return: 1
return: 0

fn: lm_trans_registry_core_candidate_name (size_t: index) const: @: char
    if: index = 0U
        return: "lm4/core.lm4"
    if: index = 1U
        return: "core.lm4"
    if: index = 2U
        return: "lm2/core.lm4"
return: 0

fn: lm_trans_registry_candidate_name (size_t: index) const: @: char
    if: index = 0U
        return: "lm4/trans_registry.lm4"
    if: index = 1U
        return: "trans_registry.lm4"
    if: index = 2U
        return: "trans_registry.lmx"
    if: index = 3U
        return: "lm2/trans_registry.lm4"
    if: index = 4U
        return: "lm2/trans_registry.lmx"
return: 0

fn: lm_trans_registry_load_for_source (const: @(char source_path)) int
    [4096]: char registry_path
    const: @: char candidate_name
    const: @: char override_path
    const: @: char view_mode
    int: override_enabled
    int: loaded
    int: registry_loaded
    size_t: candidate_index

    lm_trans_registry_destroy()
    if: lm_trans_registry_init() != 0
        return: 1
    lm_trans_registry\loaded: 1
    view_mode: c.getenv("LM_TRANS_REGISTRY_VIEW")
    if: view_mode = 0 || view_mode[0] = '\0' || c.strcmp(view_mode, "0") = 0 || c.strcmp(view_mode, "legacy") = 0
        lm_trans_registry\view_mode: 0
    else:
        lm_trans_registry\view_mode: 1
        if: c.strcmp(view_mode, "view") = 0
            lm_trans_registry\view_mode: 2
        ---
    lm_trans_registry\identifiers: lm_trans_identifier_table_new()
    lm_trans_registry\value_arena: lm_own_new_zero(c.sizeof(lm_trans_registry\value_arena[0]))
    lm_trans_registry\loaded_paths: lm_trans_ptr_stack_new(lm_own_delete_plain)
    if: lm_trans_registry\identifiers = 0 || lm_trans_registry\value_arena = 0 || lm_own_arena_init(lm_trans_registry\value_arena) != 0 || lm_trans_registry\loaded_paths = 0
        lm_trans_registry_destroy()
        return: 1
    lm_trans_registry\source_path: lm_trans_text_copy_cstr_from_cstr(source_path)
    if: lm_trans_registry\source_path = 0
        lm_trans_registry_destroy()
        return: 1
    lm_trans_registry\loaded_fact_count: 0U

    if: lm_trans_registry_l4_runtime_init() != 0
        lm_trans_registry_destroy()
        return: 1

    if: lm_trans_registry_seed_l4_receivers() != 0
        lm_trans_registry_destroy()
        return: 1

    candidate_index: 0U
    candidate_name: lm_trans_registry_core_candidate_name(candidate_index)
    while: candidate_name != 0
        if: lm_trans_registry_candidate_path(source_path, candidate_name, registry_path, 4096U) != 0
            lm_trans_registry_destroy()
            return: 1
        if: lm_trans_registry_load_file_path(registry_path, 0, @ loaded) != 0
            lm_trans_registry_destroy()
            return: 1
        if: loaded != 0
            break
        candidate_index: candidate_index + 1U
        candidate_name: lm_trans_registry_core_candidate_name(candidate_index)

    override_path: c.getenv("LM_TRANS_REGISTRY")
    override_enabled: override_path != 0 && override_path[0] != '\0'
    registry_loaded: 0
    if: override_enabled != 0
        if: c.strlen(override_path) >= 4096U
            c.fprintf(c.stderr, "trans error: LM_TRANS_REGISTRY path is too long\n")
            lm_trans_registry_destroy()
            return: 1
        c.strcpy(registry_path, override_path)
        if: lm_trans_registry_load_file_path(registry_path, 1, @ loaded) != 0
            lm_trans_registry_destroy()
            return: 1
        if: loaded != 0
            registry_loaded: 1
    ---
    else:
        candidate_index: 0U
        candidate_name: lm_trans_registry_candidate_name(candidate_index)
        while: candidate_name != 0
            if: lm_trans_registry_candidate_path(source_path, candidate_name, registry_path, 4096U) != 0
                lm_trans_registry_destroy()
                return: 1
            if: lm_trans_registry_load_file_path(registry_path, 0, @ loaded) != 0
                lm_trans_registry_destroy()
                return: 1
            if: loaded != 0
                registry_loaded: 1
                break
            candidate_index: candidate_index + 1U
            candidate_name: lm_trans_registry_candidate_name(candidate_index)
    ---

    if: registry_loaded = 0
        c.fprintf(c.stderr, "trans registry error: cannot read trans_registry.lm4\n")
        lm_trans_registry_destroy()
        return: 1
    if: lm_trans_registry_assert_view_parity() != 0
        lm_trans_registry_destroy()
        return: 1
return: 0

fn: lm_trans_emit_module_prelude_plan (FILE: file) int
    LmTransNamespace: namespace_
    int: emitted
    int: status

    namespace_: lm_trans_namespace_new()
    if: namespace_ = 0
        return: 1

    emitted: 0
    status: lm_trans_namespace_attach_registry(namespace_)
    if: status = 0
        status: lm_trans_emit_core_include_table(file, namespace_, @ emitted)
    if: status = 0
        status: lm_trans_emit_configured_prelude_sequences(file, namespace_, @ emitted)
    if: status = 0 && emitted != 0
        status: lm_trans_put(file, "\n")

    lm_trans_namespace_delete(namespace_)
return: status

fn: lm_trans_emit_document (const: @(char source_path); const: @(char output_path)) int
    LmP0Document: document
    const: LmP0Diagnostic: diagnostic
    const: LmP0Node: root
    FILE: output
    FILE: prelude_output
    FILE: body_output
    FILE: previous_prelude_output
    @: char prelude_path
    @: char body_path
    int: status
    int: close_status
    int: emitted

    document: 0
    output: 0
    prelude_output: 0
    body_output: 0
    previous_prelude_output: lm_trans_prelude_output
    prelude_path: 0
    body_path: 0
    if: lm_trans_registry_load_for_source(source_path) != 0
        return: 1

    status: lm_p0_parse_file(source_path, @ document)
    if: status != 0
        diagnostic: lm_p0_document_diagnostic(document)
        if: diagnostic != 0
            c.fprintf:
                c.stderr
                "trans parse error %d at %zu:%zu: %s\n"
                diagnostic\code diagnostic\line diagnostic\column diagnostic\message
        ---
        else:
            c.fprintf(c.stderr, "trans parse error while reading %s\n", source_path)
        ---
        lm_p0_document_destroy(document)
        lm_trans_registry_destroy()
        return: 1

    root: lm_p0_document_root(document)
    if: lm_trans_registry_load_inline_root(root, source_path) != 0 || lm_trans_registry_assert_view_parity() != 0
        lm_p0_document_destroy(document)
        lm_trans_registry_destroy()
        return: 1

    prelude_path: lm_trans_temp_output_path_new(output_path, ".prelude.tmp")
    body_path: lm_trans_temp_output_path_new(output_path, ".body.tmp")
    if: prelude_path = 0 || body_path = 0
        c.fprintf(c.stderr, "trans error: cannot allocate temporary output paths\n")
        lm_own_delete(prelude_path, 0)
        lm_own_delete(body_path, 0)
        lm_p0_document_destroy(document)
        lm_trans_registry_destroy()
        return: 1

    prelude_output: c.fopen(prelude_path, "w+b")
    body_output: c.fopen(body_path, "w+b")
    if: prelude_output = 0 || body_output = 0
        c.fprintf(c.stderr, "trans error: cannot create temporary output streams\n")
        if: prelude_output != 0
            c.fclose(prelude_output)
        if: body_output != 0
            c.fclose(body_output)
        c.remove(prelude_path)
        c.remove(body_path)
        lm_own_delete(prelude_path, 0)
        lm_own_delete(body_path, 0)
        lm_p0_document_destroy(document)
        lm_trans_registry_destroy()
        return: 1
    ---

    lm_trans_prelude_output: prelude_output
    lm_trans_current_source_path: source_path
    lm_trans_next_array_value_helper_id: 0U
    lm_trans_emitted_l5_runtime_prelude: 0
    lm_trans_emitted_l5_main_helper: 0
    lm_trans_emitted_l5_assert_helper: 0
    emitted: 0
    lm_trans_declared_import_paths: lm_trans_ptr_stack_new(lm_own_delete_plain)
    lm_trans_declared_import_documents: lm_trans_ptr_stack_new(lm_trans_import_document_delete)
    lm_trans_emitted_import_prelude_paths: lm_trans_ptr_stack_new(lm_own_delete_plain)
    lm_trans_emitted_import_function_paths: lm_trans_ptr_stack_new(lm_own_delete_plain)
    lm_trans_emitted_callable_adapters: lm_trans_ptr_stack_new(lm_own_delete_plain)
    lm_trans_emitted_callable_binders: lm_trans_ptr_stack_new(lm_own_delete_plain)
    lm_trans_emitted_array_value_helpers: lm_trans_ptr_stack_new(lm_own_delete_plain)
    lm_trans_emitted_function_return_structs: lm_trans_ptr_stack_new(lm_own_delete_plain)
    if: lm_trans_declared_import_paths = 0 || lm_trans_declared_import_documents = 0 || lm_trans_emitted_import_prelude_paths = 0 || lm_trans_emitted_import_function_paths = 0 || lm_trans_emitted_callable_adapters = 0 || lm_trans_emitted_callable_binders = 0 || lm_trans_emitted_array_value_helpers = 0 || lm_trans_emitted_function_return_structs = 0
        c.fprintf(c.stderr, "trans error: out of memory while creating module state stacks\n")
        status: 1
    else:
        status: lm_trans_emit_module_prelude_plan(prelude_output)
    ---
    if: status = 0
        status: lm_trans_emit_root_sequence(body_output, root, lm_trans_path_has_extension(source_path, ".lm2"), @ emitted)

    lm_trans_ptr_stack_delete(@ lm_trans_emitted_function_return_structs)
    lm_trans_ptr_stack_delete(@ lm_trans_emitted_array_value_helpers)
    lm_trans_ptr_stack_delete(@ lm_trans_emitted_callable_binders)
    lm_trans_ptr_stack_delete(@ lm_trans_emitted_callable_adapters)
    lm_trans_ptr_stack_delete(@ lm_trans_emitted_import_function_paths)
    lm_trans_ptr_stack_delete(@ lm_trans_emitted_import_prelude_paths)
    lm_trans_ptr_stack_delete(@ lm_trans_declared_import_documents)
    lm_trans_ptr_stack_delete(@ lm_trans_declared_import_paths)
    lm_trans_current_source_path: 0
    lm_trans_prelude_output: previous_prelude_output
    if: status = 0 && emitted = 0
        c.fprintf(c.stderr, "trans error: root L1 or L2 frame was not found\n")
        status: 1

    if: status = 0
        output: c.fopen(output_path, "wb")
        if: output = 0
            c.fprintf(c.stderr, "trans error: cannot open output file %s\n", output_path)
            status: 1
    ---
    if: status = 0 && (lm_trans_copy_stream(output, prelude_output) != 0 || lm_trans_copy_stream(output, body_output) != 0)
        c.fprintf(c.stderr, "trans error: cannot write output file %s\n", output_path)
        status: 1

    close_status: 0
    if: output != 0
        close_status: c.fclose(output)
    c.fclose(prelude_output)
    c.fclose(body_output)
    c.remove(prelude_path)
    c.remove(body_path)
    lm_own_delete(prelude_path, 0)
    lm_own_delete(body_path, 0)
    if: status != 0
        lm_p0_document_destroy(document)
        lm_trans_registry_destroy()
        return: 1

    if: close_status != 0
        c.fprintf(c.stderr, "trans error: cannot write output file %s\n", output_path)
        lm_p0_document_destroy(document)
        lm_trans_registry_destroy()
        return: 1

    lm_p0_document_destroy(document)
    lm_trans_registry_destroy()
return: 0

external:
    fn: main (int: argc; @@: char argv) int
        c.setvbuf(c.stdout, 0, c._IONBF, 0)
        c.setvbuf(c.stderr, 0, c._IONBF, 0)

        if: argc < 0
            return: lm_l4_load_root(0, 0, 0, 0)

        if: argc != 3
            c.fprintf(c.stderr, "usage: trans.lm0[.exe] <source.lm2> <output.lm1.c>\n")
            return: 1
    return: lm_trans_emit_document(argv[1], argv[2])
end: external
