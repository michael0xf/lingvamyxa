fn: lm_trans_materialize_zero_arg_callable (FILE: file; LmTransExprStack: stack; const: (LmTransExprSegment: segment); const: (LmTransNamespace: namespace_); @: int out_consumed) int
    const: LmTransSymbol: forced_symbol
    LmP0Text: forced_name
    int: status
