fn: lm_trans_expr_stack_push_lazy_binder_fields (FILE: file; LmTransExprStack: stack; const: (LmP0Text: binder_name); const: (LmP0Field: first); const: (LmTransSymbol: source_symbol); size_t: bound_count; const: (LmTransNamespace: namespace_)) int
    LmOwnPtrStack: segments
    const: LmP0Field: field
    const: LmP0Field: next
    LmTransExprSegment: segment
    size_t: index
    int: status
    if: (lm_trans_expr_stack_push_text(stack, ")") != 0)
        return: 1
    segments: lm_trans_expr_segment_stack_new()
    if: (segments = 0)
        return: 1
    status: lm_trans_expr_segments_resize_blank(segments, bound_count)
    field: first
    index: 0U
    while: ((status = 0) && (field != 0))
        if: (index >= bound_count)
            c.fprintf(c.stderr, "trans L2 error: too many lazy-bind arguments\n")
            status: 1
            break
        segment: (cast: (LmTransExprSegment) lm_own_ptr_stack_at(segments, index))
        if: (segment = 0)
            status: 1
            break
        if: lm_trans_node_is_positional_skip(field\value)
            if: (lm_trans_expr_segment_set_default(segment, source_symbol, index) = 0)
                c.fprintf(c.stderr, "trans L2 error: skipped lazy-bind argument has no default\n")
                status: 1
                break
            index: index + 1U
            field: field\next
            continue
        next: lm_trans_expr_segment_end(field)
        segment\first: field
        segment\stop: next
        if: lm_trans_expr_segment_set_expected_param(segment, source_symbol, index) = 0
            status: 1
            break
        segment\present: 1
        index: index + 1U
        field: next
    while: ((status = 0) && (index < bound_count))
        segment: (cast: (LmTransExprSegment) lm_own_ptr_stack_at(segments, index))
        if: (segment = 0)
            status: 1
            break
        if: (lm_trans_expr_segment_set_default(segment, source_symbol, index) = 0)
            c.fprintf(c.stderr, "trans L2 error: missing lazy-bind argument has no default\n")
            status: 1
            break
        index: index + 1U
    if: (status = 0)
        status: lm_trans_expr_stack_push_segments(file, stack, segments, namespace_)
    lm_trans_expr_segment_stack_delete(@ segments)
    if: (status != 0)
        return: 1
    if: ((lm_trans_expr_stack_push_text(stack, "(") != 0) || (lm_trans_expr_stack_push_name_text(stack, binder_name) != 0))
        return: 1
    return: 0
end: lm_trans_expr_stack_push_lazy_binder_fields

