end: lm_trans_type_suffix_stack_push

fn: lm_trans_emit_type_pointer_suffix (FILE: file; size_t: depth) int
    size_t: i
    if: (lm_trans_put(file, " ") != 0)
        return: 1
    i: 0U
    while: (i < depth)
        if: (lm_trans_put(file, "*") != 0)
            return: 1
