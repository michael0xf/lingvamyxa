static void lm_trans_expr_stack_pop_delete(LmTransExprStack *stack) {
    LmTransExprJob *job;

    job = stack != 0 && stack->jobs != 0
        ? (LmTransExprJob *)lm_own_ptr_stack_pop(stack->jobs)
        : 0;
    lm_trans_expr_job_delete(job);
}

