end: lm_trans_emit_current_return_type

fn: lm_trans_array_type_node_info (const: (LmP0Node: type_node); const: @(LmP0Node out_element_type); @: size_t out_rank) int
    const: LmP0Structure: body
    const: LmP0Field: field
    LmP0Text: dimension
    size_t: dimension_index
    size_t: rank
    if: (out_element_type != 0)
        out_element_type[0]: 0
    if: (out_rank != 0)
        out_rank[0]: 0U
    if: (((type_node = 0) || (type_node\kind != c.LM_P0_NODE_FRAME)) || (lm_trans_text_is_array_receiver_head(type_node\as\frame\head) = 0))
        return: 0
    body: lm_trans_unwrap_single_anonymous_structure(type_node\as\frame\body)
    if: (body != 0)
        field: body\first_field
    else:
        field: 0
    if: (((field = 0) || (field\next != 0)) || (field\value = 0))
        c.fprintf(c.stderr, "trans L2 error: [] type receiver expects exactly one element type\n")
        return: -1
    dimension_index: 0U
    rank: 0U
    dimension: lm_trans_text_ref_new_cstr("")
    if: (dimension = 0)
        return: -1
    while: lm_trans_array_head_next_dimension(type_node\as\frame\head, @ dimension_index, dimension)
        if: (dimension\length != 0U)
            c.fprintf(c.stderr, "trans L2 error: [] type receiver dimensions must be empty in pointer type position\n")
            lm_trans_text_ref_destroy(@ dimension)
            return: -1
        rank: rank + 1U
    if: (out_element_type != 0)
        out_element_type[0]: field\value
    if: (out_rank != 0)
        out_rank[0]: rank
    lm_trans_text_ref_destroy(@ dimension)
    return: 1
end: lm_trans_array_type_node_info

fn: lm_trans_emit_type_and_name (FILE: file; const: (LmP0Node: type_node); const: (LmP0Text: name); size_t: pointer_depth; const: (LmTransNamespace: namespace_)) int
    size_t: i
    if: (type_node = 0)
        return: 1
    c.LM_UNUSED(namespace_)
