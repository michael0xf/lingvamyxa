return: lm_trans_namespace_registry_source_path_n2_named_typed_value(namespace_, head, "receiver.expr", "class", "class", "receiver", "binding")

fn: lm_trans_lookup_expr_frame_receiver_binding (const: (LmTransNamespace: namespace_); const: (LmP0Text: head); LmTransBinding: out) int
    const: @: char binding
    if: (out != 0)
