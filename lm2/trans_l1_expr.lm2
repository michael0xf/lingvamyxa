sub: lm_trans_type_suffix_stack_delete (@: LmOwnPtrStack suffixes)
    if: ((suffixes != 0) && (suffixes[0] != 0))
        lm_own_ptr_stack_destroy(suffixes[0])
        lm_own_delete(suffixes[0], 0)
        suffixes[0]: 0
    ---
