fn: lm_trans_param_descriptor_matches_return (const: (LmP0Node: param); const: (LmP0Node: return_node); const: (LmTransNamespace: namespace_)) int
    const: LmP0Node: current
    const: LmP0Frame: frame
    const: LmP0Field: field
    if: ((param = 0) || (return_node = 0))
        return: 0
    current: param
    while: (current != 0)
        if: lm_trans_expected_param_is_callable_descriptor(current, namespace_)
            return: 0
        if: (current\kind = c.LM_P0_NODE_STRUCTURE)
            field: current\as\structure\first_field
            if: (((field = 0) || (field\next != 0)) || (field\value = 0))
                return: 0
            current: field\value
            continue
        if: ((current\kind = c.LM_P0_NODE_FRAME) && lm_trans_text_equals(current\as\frame\head, "const"))
            field: current\as\frame\body\first_field
            if: (((field = 0) || (field\next != 0)) || (field\value = 0))
                return: 0
            current: field\value
            continue
        break
    if: (current = 0)
        return: 0
    if: (current\kind = c.LM_P0_NODE_ATOM)
        return: ((return_node\kind = c.LM_P0_NODE_ATOM) && lm_trans_identifier_same(current\as\atom, return_node\as\atom))
    if: (current\kind != c.LM_P0_NODE_FRAME)
        return: 0
    frame: current\as\frame
    if: (return_node\kind != c.LM_P0_NODE_ATOM)
        return: 0
    return: lm_trans_identifier_same(frame\head, return_node\as\atom)
end: lm_trans_param_descriptor_matches_return

fn: lm_trans_should_force_zero_arg_callable (const: (LmTransExprSegment: segment); const: (LmTransNamespace: namespace_); LmP0Text: out_name; const: @(LmTransSymbol out_symbol)) int
    const: LmTransSymbol: symbol
    LmTransCallableValue: callable_value
    LmP0Text: atom
