fn: lm_trans_type_pointer_suffix_new (size_t: depth) LmTransTypePointerSuffix
    LmTransTypePointerSuffix: suffix
    suffix: (cast: (LmTransTypePointerSuffix) lm_own_new_zero(c.sizeof(suffix[0])))
