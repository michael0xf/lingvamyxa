    if: (lm_trans_put(file, " ") != 0)
        return: 1
    i: 0U
    while: (i < pointer_depth)
        if: (lm_trans_put(file, "*") != 0)
            return: 1
        i: i + 1U
    return: lm_trans_emit_identifier(file, name)
end: lm_trans_emit_type_and_name

fn: lm_trans_emit_type_head_only (FILE: file; const: (LmP0Text: type_head)) int
    size_t: implicit_depth
    int: status

    if: lm_trans_builtin_c_type_name(type_head)
        return: lm_trans_emit_type_name(file, type_head)
    status: lm_trans_emit_name(file, type_head)
    implicit_depth: lm_trans_layout_type_implicit_address_depth(type_head)
    if: status = 0 && implicit_depth != 0U
        status: lm_trans_emit_type_pointer_suffix(file, implicit_depth)
    return: status
end: lm_trans_emit_type_head_only

fn: lm_trans_emit_c_dimension_text (FILE: file; const: (LmP0Text: dimension); const: (LmTransNamespace: namespace_); const: @(char error_name)) int
    LmP0Document: dimension_document
    const: LmP0Diagnostic: diagnostic
    const: LmP0Node: dimension_root
    const: @: char effective_error_name
    int: parse_status
    if: ((dimension = 0) || (dimension\length = 0U))
        return: 0
    dimension_document: 0
    effective_error_name: "array dimension"
    if: error_name != 0
        effective_error_name: error_name
    parse_status: lm_p0_parse_bytes(dimension\data, dimension\length, @ dimension_document)
    if: (parse_status != 0)
        if: (dimension_document != 0)
            diagnostic: lm_p0_document_diagnostic(dimension_document)
        else:
            diagnostic: 0
        if: (diagnostic != 0)
            c.fprintf(c.stderr, "trans L2 error: %s parse error %d at %zu:%zu: %s\n", effective_error_name, diagnostic\code, diagnostic\line, diagnostic\column, diagnostic\message)
        else:
            c.fprintf(c.stderr, "trans L2 error: %s parse failed\n", effective_error_name)
        if: (dimension_document != 0)
            lm_p0_document_destroy(dimension_document)
        return: 1
    dimension_root: lm_p0_document_root(dimension_document)
    if: (((dimension_root = 0) || (dimension_root\kind != c.LM_P0_NODE_STRUCTURE)) || (dimension_root\as\structure\first_field = 0))
        c.fprintf(c.stderr, "trans L2 error: %s must not be empty\n", effective_error_name)
        lm_p0_document_destroy(dimension_document)
        return: 1
    if: (lm_trans_emit_expr_fields(file, dimension_root\as\structure\first_field, namespace_) != 0)
        lm_p0_document_destroy(dimension_document)
        return: 1
    lm_p0_document_destroy(dimension_document)
    return: 0
end: lm_trans_emit_c_dimension_text

fn: lm_trans_emit_c_declarator (FILE: file; const: (LmTransCDeclarator: declarator); const: (LmTransNamespace: namespace_); const: @(char error_name)) int
    size_t: i
    size_t: head_index
    LmP0Text: head_dimension
    const: LmP0Field: expression_dimension
    const: @: char effective_dimension_error_name
    if: ((file = 0) || (declarator = 0))
        return: 1
    if: declarator\type_is_head
        if: declarator\type_head = 0
            return: 1
        if: lm_trans_emit_type_head_only(file, declarator\type_head) != 0
            return: 1
        ---
    else:
        if: ((declarator\type_node = 0) || (lm_trans_emit_type_node(file, declarator\type_node) != 0))
            return: 1
        ---
    if: (lm_trans_put(file, " ") != 0)
        return: 1
    i: 0U
    while: (i < declarator\pointer_depth)
        if: (lm_trans_put(file, "*") != 0)
            return: 1
        i: i + 1U
    if: ((declarator\name = 0) || (lm_trans_emit_identifier(file, declarator\name) != 0))
        return: 1
    head_index: 0U
    head_dimension: lm_trans_text_ref_new_cstr("")
    if: (head_dimension = 0)
        return: 1
    effective_dimension_error_name: "array dimension"
    if: error_name != 0
        effective_dimension_error_name: error_name
    if: (declarator\array_head = 0)
        return: 1
    expression_dimension: declarator\expression_dimensions
    while: lm_trans_array_head_next_dimension(declarator\array_head, @ head_index, head_dimension)
        if: (lm_trans_put(file, "[") != 0)
            lm_trans_text_ref_destroy(@ head_dimension)
            return: 1
        if: (head_dimension\length != 0U)
            if: (lm_trans_emit_c_dimension_text(file, head_dimension, namespace_, error_name) != 0)
                lm_trans_text_ref_destroy(@ head_dimension)
                return: 1
            ---
        else:
            if: expression_dimension = 0 || expression_dimension\value = 0 || (declarator\atom_dimensions_only && lm_trans_array_body_dimension_can_consume(expression_dimension) = 0)
                if: declarator\allow_empty_dimensions
                    if: (lm_trans_put(file, "]") != 0)
                        lm_trans_text_ref_destroy(@ head_dimension)
                        return: 1
                    continue
                ---
                c.fprintf(c.stderr, "trans L2 error: %s expects a size expression\n", effective_dimension_error_name)
                lm_trans_text_ref_destroy(@ head_dimension)
                return: 1
            if: (lm_trans_emit_expr_node(file, expression_dimension\value, namespace_) != 0)
                lm_trans_text_ref_destroy(@ head_dimension)
                return: 1
            expression_dimension: expression_dimension\next
        if: (lm_trans_put(file, "]") != 0)
            lm_trans_text_ref_destroy(@ head_dimension)
            return: 1
        ---
    lm_trans_text_ref_destroy(@ head_dimension)
    i: 0U
    while: (i < declarator\literal_dimension_count)
        if: (((lm_trans_put(file, "[") != 0) || (lm_trans_emit_size_literal(file, declarator\literal_dimensions[i]) != 0)) || (lm_trans_put(file, "]") != 0))
            return: 1
        i: i + 1U
    return: 0
end: lm_trans_emit_c_declarator

fn: lm_trans_c_declarator_expression_dimension_tail (const: (LmTransCDeclarator: declarator)) const: LmP0Field
    const: LmP0Field: dimension
    size_t: head_index
    LmP0Text: head_dimension

    if: declarator = 0
        return: 0

    dimension: declarator\expression_dimensions
    if: declarator\array_head = 0
        return: dimension

    head_index: 0U
    head_dimension: lm_trans_text_ref_new_cstr("")
    if: head_dimension = 0
        return: dimension
    finally: lm_trans_text_ref_destroy(@ head_dimension)

    while: lm_trans_array_head_next_dimension(declarator\array_head, @ head_index, head_dimension)
        if: head_dimension\length = 0U && dimension != 0 && dimension\value != 0 && (declarator\atom_dimensions_only = 0 || lm_trans_array_body_dimension_can_consume(dimension))
            dimension: dimension\next
        ---

    return: dimension

fn: lm_trans_emit_array_param (FILE: file; const: (LmTransFormalParam: param); LmTransNamespace: namespace_) int
    const: LmTransCDeclarator: declarator
    @: char slice_name_storage
    LmP0Text: slice_name
    int: status

    if: param = 0 || param\declarator = 0 || param\has_name = 0
        return: 1

    declarator: param\declarator
    slice_name_storage: lm_trans_array_slice_name_new(param\name)
    if: slice_name_storage = 0
        return: 1
    finally: lm_own_delete(slice_name_storage, 0)

    slice_name: lm_trans_text_from_cstr(slice_name_storage)
    if: slice_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ slice_name)

    if: lm_trans_put(file, "LmSlice *") != 0 || lm_trans_emit_identifier(file, slice_name) != 0
        return: 1

    status: 0
    if: declarator\type_is_head
        status: lm_trans_namespace_declare_storage_binding(namespace_, param\name, declarator\type_head)
    else:
        if: declarator\type_node != 0 && declarator\type_node\kind = c.LM_P0_NODE_ATOM
            status: lm_trans_namespace_declare_storage_binding(namespace_, param\name, declarator\type_node\as\atom)
        else:
            status: lm_trans_namespace_declare(namespace_, param\name, "variable")
        ---
    if: status != 0
        return: 1
    return: lm_trans_namespace_declare_array_slice_expr(namespace_, param\name, slice_name_storage)
end: lm_trans_emit_array_param

fn: lm_trans_emit_formal_param (
    FILE: file
    const: LmTransFormalParam: param
    LmTransNamespace: namespace_
) int
    int: status

    if: param = 0
        return: 1

    if: param\source_node = 0 || param\source_node\kind != c.LM_P0_NODE_FRAME
        if: lm_trans_node_is_positional_skip(param\source_node)
            c.fprintf(c.stderr, "trans L2 error: skipped function parameter has no default declaration in this profile\n")
            return: 1
        c.fprintf(c.stderr, "trans L2 error: parameter must be a typed frame\n")
        return: 1

    if: param\is_array
        return: lm_trans_emit_array_param(file, param, namespace_)

    if: param\has_name = 0
        c.fprintf(c.stderr, "trans L2 error: typed parameter expects a name\n")
        return: 1

    if: (lm_trans_symbol_is(lm_trans_namespace_find(namespace_, param\type\class_name), "callableDescriptor") && lm_trans_callable_descriptor_is_raw_function_reference(namespace_, param\type\class_name))
        if: (lm_trans_emit_raw_callable_declarator(file, namespace_, param\type\class_name, param\name, "callable descriptor parameter") != 0)
            return: 1
        return: lm_trans_namespace_declare_storage_binding(namespace_, param\name, param\type\class_name)

    status: lm_trans_emit_callable_type_named(file, param\type, param\name)
    if: status = 0
        status: lm_trans_namespace_declare_storage_binding(namespace_, param\name, param\type\class_name)
    return: status
end: lm_trans_emit_formal_param
