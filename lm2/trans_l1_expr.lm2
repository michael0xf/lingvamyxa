        return: 1
    return: lm_trans_put(file, "Return")
end: lm_trans_emit_function_return_struct_type_name

fn: lm_trans_function_return_struct_type_name_new (const: (LmP0Text: function_name)) @: char
    @: char name
    const: @: char suffix
    size_t: suffix_length
    if: (function_name = 0)
        return: 0
    suffix: "Return"
    suffix_length: c.strlen(suffix)
    name: (cast: (@: char) lm_own_new_zero(((function_name\length + suffix_length) + 1U)))
    if: (name = 0)
        return: 0
    c.memcpy(name, function_name\data, function_name\length)
    c.memcpy((name + function_name\length), suffix, (suffix_length + 1U))
    return: name
end: lm_trans_function_return_struct_type_name_new

fn: lm_trans_emit_current_return_type (FILE: file; const: (LmTransNamespace: namespace_)) int
    const: LmP0Node: return_type_node
    if: ((namespace_ != 0) && namespace_\return_type_is_struct)
