fn: lm_trans_emit_type_suffixes (FILE: file; LmOwnPtrStack: suffixes) int
    LmTransTypePointerSuffix: suffix
    while: ((suffixes != 0) && (suffixes\count != 0U))
        suffix: (cast: (LmTransTypePointerSuffix) lm_own_ptr_stack_pop(suffixes))
        if: (suffix != 0)
            if: (lm_trans_emit_type_pointer_suffix(file, suffix\depth) != 0)
