fn: lm_trans_type_suffix_stack_push (@: LmOwnPtrStack suffixes; size_t: depth) int
    LmTransTypePointerSuffix: suffix
    if: (suffixes = 0)
        return: 1
    if: (suffixes[0] = 0)
        suffixes[0]: (cast: (LmOwnPtrStack) lm_own_new_zero(c.sizeof(suffixes[0][0])))
        if: (suffixes[0] = 0)
            return: 1
        lm_own_ptr_stack_init(suffixes[0], lm_own_delete_plain)
    suffix: lm_trans_type_pointer_suffix_new(depth)
    if: (suffix = 0)
        return: 1
    if: (lm_own_ptr_stack_push(suffixes[0], suffix) != 0)
        lm_own_delete(suffix, 0)
