table:
    name: node
    columns: char@(class)       int@(kind)  int@(flag)
    rows:
             structure          1           NULL
             frame              2           NULL
             atom               3           NULL
             disabled           4           NULL
             inactive           NULL        1
             mix                NULL        2
             `positional-skip`  NULL        4
end: node

table:
    name: frame
    columns: char@(class)        int@(flag)
    rows:
             colon               1
             compact             2
             `inline-body`       4
             `separator-closed`  8
end: frame

table:
    name: namespace
    columns: char@(class)  class@(parser_class)
    rows:
             `end`         `trailer.end`
             `return`      `trailer.return`
             `until`       `trailer.until`
end: namespace

table:
    name: trailer
    columns: char@(class)      int@(flag)  binding@(role)             int@(`allow-bare`)  char@(target)
    rows:
             `tail-cutter`     1           NULL                       NULL                NULL
             `trailer.end`     NULL        LM_P0_TRAILER_ROLE_END     0                   NULL
             `trailer.return`  NULL        LM_P0_TRAILER_ROLE_RETURN  1                   fn
             `trailer.until`   NULL        LM_P0_TRAILER_ROLE_UNTIL   0                   NULL
end: trailer
