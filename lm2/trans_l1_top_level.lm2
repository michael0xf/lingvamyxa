fn: lm_trans_top_level_emit_atom_sequence (FILE: file; LmTransNamespace: namespace_; const: (LmTransTopLevelItem: item)) int
    if: item = 0 || item\node = 0 || item\node\kind != c.LM_P0_NODE_ATOM
        return: 1
return: lm_trans_emit_atom_statement_sequence(file, item\node\as\atom, 0U, namespace_)

fn: lm_trans_top_level_declare_atom_sequence (LmTransNamespace: namespace_; const: (LmTransTopLevelItem: item)) int
    const: LmOwnPtrStack: rows
    LmTransRegistryFact: row
    LmP0Node: node
    LmP0NodeAs: node_as
    LmP0Text: item_name
    LmTransTopLevelItem: child
    size_t: i
    int: status

    if: item = 0 || item\node = 0 || item\node\kind != c.LM_P0_NODE_ATOM
        return: 1

    rows: lm_trans_namespace_registry_relation_stack(namespace_, item\node\as\atom, "item")
    if: rows = 0
        c.fprintf(c.stderr, "trans registry error: atom statement sequence \"%.*s\" has no item rows\n", (cast: int item\node\as\atom\length), item\node\as\atom\data)
        return: 1

    node: lm_own_new_zero(c.sizeof(node[0]))
    node_as: lm_own_new_zero(c.sizeof(node_as[0]))
    item_name: lm_trans_text_ref_new_cstr("")
    if: node = 0 || node_as = 0 || item_name = 0
        lm_own_delete(node, 0)
        lm_own_delete(node_as, 0)
        lm_trans_text_ref_destroy(@ item_name)
        return: 1

    node\kind: c.LM_P0_NODE_ATOM
    node\as: node_as

    status: 0
    i: 0U
    while: status = 0 && i < rows\count
        row: lm_own_ptr_stack_at(rows, i)
        if: row != 0 && row\key != 0
            lm_trans_text_assign_cstr(item_name, row\key)
            node_as\atom: item_name
            child: lm_trans_top_level_item_lowered_new(node)
            if: child = 0
                status: 1
                break
            if: child\declare != 0
                status: child\declare(namespace_, child)
            lm_trans_top_level_item_delete(child)
        ---
        i: i + 1U

    lm_own_delete(node, 0)
    lm_own_delete(node_as, 0)
    lm_trans_text_ref_destroy(@ item_name)
return: status

fn: lm_trans_top_level_atom_binding (const: (LmP0Text: atom); LmTransTopLevelItem: out) int
    const: @: char binding

    if: out = 0
        return: -1

    binding: lm_trans_registry_lookup(atom, "receiver.atom.statement")
    if: binding = 0
        return: 0

    if: c.strcmp(binding, "lm_trans_atom_statement_emit_include_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_include
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_os_prelude") = 0
        out\declare: @lm_trans_top_level_declare_atom_os
        out\emit_before_functions: @lm_trans_top_level_emit_atom_os
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_ifdef_prelude") = 0
        out\declare: @lm_trans_top_level_declare_atom_ifdef
        out\emit_before_functions: @lm_trans_top_level_emit_atom_ifdef
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_layout_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_layout
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_constant_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_constant
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_define_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_define
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_alias_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_alias
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_forward_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_forward
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_prototype_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_prototype
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_fn_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_fn
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_guard_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_guard
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_extern_c_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_extern_c
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_unit_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_atom_unit
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(binding, "lm_trans_atom_statement_emit_sequence_prelude") = 0
        out\declare: @lm_trans_top_level_declare_atom_sequence
        out\emit_before_functions: @lm_trans_top_level_emit_atom_sequence
        out\emits_top_level: 1
        return: 1

    c.fprintf(c.stderr, "trans registry error: unknown top-level atom binding %s\n", binding)
return: -1

fn: lm_trans_top_level_statement_binding (const: (LmTransHeadBinding: binding); LmTransTopLevelItem: out) int
    const: @: char receiver

    if: binding = 0 || out = 0 || binding\statement_frame = 0
        return: 0

    receiver: binding\statement_receiver_binding
    if: receiver = 0
        return: 0

    if: c.strcmp(receiver, "lm_trans_statement_emit_include_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_include
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(receiver, "lm_trans_statement_emit_define_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_define
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(receiver, "lm_trans_statement_emit_ifndef_default_prelude") = 0
        out\emit_before_functions: @lm_trans_top_level_emit_ifndef_default
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(receiver, "lm_trans_statement_emit_os_prelude") = 0
        out\declare: @lm_trans_top_level_declare_os
        out\emit_before_functions: @lm_trans_top_level_emit_os
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(receiver, "lm_trans_statement_emit_ifdef_prelude") = 0
        out\declare: @lm_trans_top_level_declare_ifdef
        out\emit_before_functions: @lm_trans_top_level_emit_ifdef
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(receiver, "lm_trans_statement_emit_guard_prelude") = 0
        out\declare: @lm_trans_top_level_declare_guard
        out\emit_before_functions: @lm_trans_top_level_emit_guard
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(receiver, "lm_trans_statement_emit_extern_c_prelude") = 0
        out\declare: @lm_trans_top_level_declare_extern_c
        out\emit_before_functions: @lm_trans_top_level_emit_extern_c
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(receiver, "lm_trans_statement_emit_import") = 0
        out\declare: @lm_trans_top_level_declare_import
        if: lm_trans_import_frame_has_code_path(out\frame)
            out\emit_before_functions: @lm_trans_top_level_emit_import_prelude
            out\emit_function: @lm_trans_top_level_emit_import_functions
        return: 1
    if: c.strcmp(receiver, "lm_trans_statement_emit_table") = 0
        out\emit_after_prototypes: @lm_trans_top_level_emit_table
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(receiver, "lm_trans_statement_emit_join") = 0
        out\emit_after_prototypes: @lm_trans_top_level_emit_join
        out\emits_top_level: 1
        return: 1
    if: c.strcmp(receiver, "lm_trans_statement_emit_merge_named_structure") = 0
        out\declare: @lm_trans_top_level_declare_merge_named_structure
        out\emit_before_functions: @lm_trans_top_level_emit_merge_named_structure_typedef
        out\emit_after_prototypes: @lm_trans_top_level_emit_merge_named_structure_storage
        out\emits_top_level: 1
        return: 1
return: 0

fn: lm_trans_level_receiver_binding_from_head (const: (LmP0Text: head)) const: @: char
    const: @: char receiver_type

    if: head = 0
        return: 0

    receiver_type: lm_trans_registry_lookup(head, "namespace")
    if: receiver_type = 0 || c.strcmp(receiver_type, "receiver.level") != 0
        return: 0
return: lm_trans_registry_lookup(head, "receiver.level")

fn: lm_trans_level_receiver_binding_from_frame (const: (LmP0Frame: frame)) const: @: char
    if: frame != 0
        return: lm_trans_level_receiver_binding_from_head(frame\head)
return: 0

fn: lm_trans_frame_has_level_receiver_binding (const: (LmP0Frame: frame); const: @(char binding)) int
    const: @: char actual

    if: binding = 0
        return: 0

    actual: lm_trans_level_receiver_binding_from_frame(frame)
return: actual != 0 && c.strcmp(actual, binding) = 0

fn: lm_trans_frame_is_l1_level_receiver (const: (LmP0Frame: frame)) int
return: lm_trans_frame_has_level_receiver_binding(frame, "lm_trans_emit_l1_frame")

fn: lm_trans_frame_is_l2_level_receiver (const: (LmP0Frame: frame)) int
return: lm_trans_frame_has_level_receiver_binding(frame, "lm_trans_emit_l2_frame")

fn: lm_trans_top_level_level_binding (const: (LmTransHeadBinding: binding); LmTransTopLevelItem: out) int
    const: @: char receiver

    if: binding = 0 || out = 0 || binding\receiver_type = 0 || c.strcmp(binding\receiver_type, "receiver.level") != 0
        return: 0

    receiver: lm_trans_level_receiver_binding_from_frame(out\frame)
    if: receiver = 0
        c.fprintf(c.stderr, "trans registry error: receiver.level has no binding for top-level frame\n")
        return: -1
    if: lm_trans_frame_is_l1_level_receiver(out\frame)
        out\emit_after_prototypes: @lm_trans_top_level_emit_l1
        out\emits_top_level: 1
        return: 1
    if: lm_trans_frame_is_l2_level_receiver(out\frame)
        out\emit_after_prototypes: @lm_trans_top_level_emit_l2
        out\emits_top_level: 1
        return: 1

    c.fprintf(c.stderr, "trans registry error: unknown receiver.level binding %s\n", receiver)
return: -1

fn: lm_trans_end_frame_target (const: (LmP0Frame: frame)) const: LmP0Text
    const: @: char receiver_type
    const: LmP0Field: field

    if: frame = 0 || frame\head = 0 || frame\body = 0
        return: 0

    receiver_type: lm_trans_registry_lookup(frame\head, "namespace")
    if: receiver_type = 0 || c.strcmp(receiver_type, "receiver.trailer") != 0 || lm_trans_registry_lookup(frame\head, "receiver.trailer") = 0
        return: 0

    field: frame\body\first_field
    if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: field\value\as\atom

fn: lm_trans_end_frame_targets_level_receiver_binding (const: (LmP0Frame: frame); const: @(char binding)) int
