sub: lm_trans_top_level_item_destroy (LmTransTopLevelItem: item)
    if: item != 0
        lm_trans_function_header_destroy(item\function)
        item\function: 0
end: lm_trans_top_level_item_destroy

fn: lm_trans_top_level_item_new () LmTransTopLevelItem
    LmTransTopLevelItem: item

    item: lm_own_new_zero(c.sizeof(item[0]))
return: item

sub: lm_trans_top_level_item_delete (LmTransTopLevelItem: item)
    lm_trans_top_level_item_destroy(item)
    lm_own_delete(item, 0)
end: lm_trans_top_level_item_delete

fn: lm_trans_head_binding_new () LmTransHeadBinding
    LmTransHeadBinding: binding

    binding: lm_own_new_zero(c.sizeof(binding[0]))
return: binding

fn: lm_trans_p0_structure_view_new () LmP0Structure
    LmP0Structure: structure

    structure: lm_own_new_zero(c.sizeof(structure[0]))
return: structure

fn: lm_trans_top_level_item_frame (const: (LmTransTopLevelItem: item)) const: LmP0Frame
    if: item != 0
        return: item\frame
return: 0

fn: lm_trans_top_level_declare_generated_return_class (LmTransNamespace: namespace_; const: (LmTransFunctionHeader: function)) int
    @: char return_type_name_storage
    LmP0Text: return_type_name
    int: status

    if: function = 0 || function\is_struct_return = 0
        return: 0

    return_type_name_storage: lm_trans_function_return_struct_type_name_new(function\c_name)
    if: return_type_name_storage = 0
        return: 1
    return_type_name: lm_trans_text_from_cstr(return_type_name_storage)
    if: return_type_name = 0
        lm_own_delete(return_type_name_storage, 0)
        return: 1

    status: lm_trans_namespace_declare_generated(namespace_, return_type_name, "class")
    lm_trans_text_ref_destroy(@ return_type_name)
    lm_own_delete(return_type_name_storage, 0)
return: status

fn: lm_trans_top_level_declare_function_params (
    LmTransNamespace: namespace_
    const: LmTransFunctionHeader: function
) int
    const: LmP0Field: field
    LmP0Text: name
    LmTransL4CallableType: type
    int: status

    if: namespace_ = 0 || function = 0
        return: 1
    if: function\params_node = 0 || function\params_node\kind != c.LM_P0_NODE_STRUCTURE
        return: 0

    name: lm_trans_text_ref_new_cstr("")
    type: lm_trans_expr_callable_type_new()
    if: name = 0 || type = 0
        lm_trans_text_ref_destroy(@ name)
        lm_trans_expr_callable_type_delete(type)
        return: 1
    finally: lm_trans_text_ref_destroy(@ name)
    finally: lm_trans_expr_callable_type_delete(type)

    status: 0
    field: function\params_node\as\structure\first_field
    while: status = 0 && field != 0
        if: field\value != 0
            if: lm_trans_formal_param_name(field\value, name) = 0 || lm_trans_l4_callable_type_from_node(field\value, type) = 0 || lm_trans_namespace_declare_storage_binding(namespace_, name, type\class_name) != 0
                status: 1
        ---
        field: field\next
return: status

fn: lm_trans_top_level_declare_function_body_named_structures (
    LmTransNamespace: namespace_
    const: LmTransFunctionHeader: function
) int
    const: LmP0Field: field
    const: LmP0Node: node
    int: status

    if: namespace_ = 0 || function = 0 || function\is_descriptor_only
        return: 0

    lm_trans_namespace_enter_scope(namespace_)
    status: lm_trans_top_level_declare_function_params(namespace_, function)
    field: function\body_start
    while: status = 0 && field != 0
        node: field\value
        if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && lm_trans_frame_looks_named_structure_layout_declaration(node\as\frame, namespace_)
            if: lm_trans_declare_named_structure_layout(namespace_, node\as\frame) != 0
                status: 1
        ---
        field: field\next
    lm_trans_namespace_leave_scope(namespace_)
return: status

fn: lm_trans_top_level_declare_function (LmTransNamespace: namespace_; const: (LmTransTopLevelItem: item)) int
    int: status

    if: item = 0 || item\function = 0
        return: 1

    if: lm_trans_registry_note_class_kind(item\function\name, item\function\symbol_class) != 0
        return: 1
    if: lm_trans_namespace_declare(namespace_, item\function\name, item\function\symbol_class) != 0
        return: 1
    if: lm_trans_namespace_set_callable_shape(namespace_, item\function) != 0
        return: 1
    status: lm_trans_top_level_declare_generated_return_class(namespace_, item\function)
    if: status = 0
        status: lm_trans_top_level_declare_function_body_named_structures(namespace_, item\function)
return: status

fn: lm_trans_top_level_declare_function_compatible (LmTransNamespace: namespace_; const: (LmTransTopLevelItem: item)) int
    int: status

    if: item = 0 || item\function = 0
        return: 1

    if: lm_trans_registry_note_class_kind(item\function\name, item\function\symbol_class) != 0
        return: 1
    if: lm_trans_namespace_declare_compatible(namespace_, item\function\name, item\function\symbol_class) != 0
        return: 1
    if: lm_trans_namespace_set_callable_shape(namespace_, item\function) != 0
        return: 1
    status: lm_trans_top_level_declare_generated_return_class(namespace_, item\function)
    if: status = 0
        status: lm_trans_top_level_declare_function_body_named_structures(namespace_, item\function)
return: status

