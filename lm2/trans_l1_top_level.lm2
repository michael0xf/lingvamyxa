    field: function\body_start
    while: field != 0
        node: field\value
        if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && lm_trans_frame_looks_named_structure_declaration(node\as\frame)
            return: 1
        ---
        field: field\next
return: 0

