predef: "libc_abi.lm2"

os:
    win:
        "/* no POSIX feature macro on Windows */"
    default:
        "#define _POSIX_C_SOURCE 199309L"
end: os

include
prototype

os:
    win:
        include: "<direct.h>" "<windows.h>"
    default:
        include: "<time.h>" "<unistd.h>"
end: os

os:
    win:
        fn: lm_finalize_platform_getcwd (@: char buffer; size_t: size) @: char
        return: c._getcwd(buffer, size)

        fn: lm_finalize_platform_chdir (const: @: char path) int
        return: c._chdir(path)

        fn: lm_finalize_platform_exe_suffix () const: @: char
        return: ".exe"

        fn: lm_finalize_platform_path_sep () const: @: char
        return: "\\"

        fn: lm_finalize_platform_is_drive_absolute (const: @: char path) int
        return: path[0] != '\0' && path[1] = ':'

        sub: lm_finalize_platform_sleep_retry ()
            c.Sleep: 250U
        end: lm_finalize_platform_sleep_retry

        fn: lm_finalize_platform_defer_command_format () const: @: char
        return: "cd /d \"%s\" && start \"\" /B \"%s\" --copy"
    default:
        fn: lm_finalize_platform_getcwd (@: char buffer; size_t: size) @: char
        return: c.getcwd(buffer, size)

        fn: lm_finalize_platform_chdir (const: @: char path) int
        return: c.chdir(path)

        fn: lm_finalize_platform_exe_suffix () const: @: char
        return: ""

        fn: lm_finalize_platform_path_sep () const: @: char
        return: "/"

        fn: lm_finalize_platform_is_drive_absolute (const: @: char path) int
        return: path != 0 && 0

        sub: lm_finalize_platform_sleep_retry ()
            c.struct: c.timespec request
            c.request.tv_sec: 0
            c.request.tv_nsec: 250000000L
            c.nanosleep: @ request 0
        end: lm_finalize_platform_sleep_retry

        fn: lm_finalize_platform_defer_command_format () const: @: char
        return: "cd \"%s\" && \"%s\" \"--copy\" >/dev/null 2>&1 &"
end: os

fn: lm_finalize_is_path_separator (char: value) int
return: value = '/' || value = '\\'

fn: lm_finalize_has_path_separator (@: char path) int
return: strchr(path, '/') != 0 || strchr(path, '\\') != 0

fn: lm_finalize_is_absolute_path (@: char path) int
    if: path = 0 || path[0] = '\0'
        return: 0
    if: lm_finalize_is_path_separator(path[0])
        return: 1
    if: lm_finalize_platform_is_drive_absolute(path)
        return: 1
return: 0

fn: lm_finalize_file_exists (@: char path) int
    FILE: file

    file: fopen(path, "rb")
    if: file = 0
        return: 0

    fclose(file)
return: 1

fn: lm_finalize_join_path (@: char buffer; size_t: size; @: char base; @: char tail) int
    size_t: base_length
    size_t: tail_length
    size_t: used

    base_length: strlen(base)
    tail_length: strlen(tail)
    used: base_length

    if: base_length + tail_length + 2U >= size
        c.fprintf: c.stderr "finalize.lm0: path is too long\n"
        return: 1

    memcpy(buffer, base, base_length)
    if: base_length > 0U && tail_length > 0U && lm_finalize_is_path_separator(base[base_length - 1U]) = 0 && lm_finalize_is_path_separator(tail[0]) = 0
        memcpy(buffer + used, lm_finalize_platform_path_sep(), strlen(lm_finalize_platform_path_sep()))
        used: used + strlen(lm_finalize_platform_path_sep())
    memcpy(buffer + used, tail, tail_length + 1U)

return: 0

fn: lm_finalize_has_project_marker (@: char path) int
    c.array: []: char marker_path 2048

    if: lm_finalize_join_path(marker_path, c.sizeof(marker_path), path, "lm2/buildCore.lmx") != 0
        return: 0
    if: lm_finalize_file_exists(marker_path)
        return: 1
return: 0

fn: lm_finalize_trim_last_path_part (@: char path) int
    size_t: length

    length: strlen(path)
    while: length > 0U && lm_finalize_is_path_separator(path[length-1U])
        path[length-1U]: '\0'
        length: length - 1U

    while: length > 0U
        length: length - 1U
        if: lm_finalize_is_path_separator(path[length])
            path[length]: '\0'
            return: 0
    ---

    path[0]: '\0'
return: 0

fn: lm_finalize_enter_project_root (@: char program_path) int
    c.array: []: char search_path 1024
    c.array: []: char executable_path 1024
    c.array: []: char cwd 1024
    int: depth

    if: lm_finalize_platform_getcwd(cwd, c.sizeof(cwd)) = 0
        c.fprintf: c.stderr "finalize.lm0: cannot read current directory\n"
        return: 1

    if: program_path != 0 && program_path[0] != '\0' && lm_finalize_has_path_separator(program_path)
        if: lm_finalize_is_absolute_path(program_path)
            if: strlen(program_path) >= c.sizeof(executable_path)
                c.fprintf: c.stderr "finalize.lm0: executable path is too long\n"
                return: 1
            strcpy(executable_path, program_path)
        if: lm_finalize_is_absolute_path(program_path) = 0
            if: lm_finalize_join_path(executable_path, c.sizeof(executable_path), cwd, program_path) != 0
                return: 1
        ---

        strcpy(search_path, executable_path)
        lm_finalize_trim_last_path_part(search_path)
    ---
    if: program_path = 0 || program_path[0] = '\0' || lm_finalize_has_path_separator(program_path) = 0
        strcpy(search_path, cwd)

    depth: 0
    while: depth < 12 && search_path[0] != '\0'
        if: lm_finalize_has_project_marker(search_path)
            if: lm_finalize_platform_chdir(search_path) != 0
                c.fprintf: c.stderr "finalize.lm0: cannot enter project root %s\n" search_path
                return: 1
            return: 0
        lm_finalize_trim_last_path_part(search_path)
        depth: depth + 1

    c.fprintf: c.stderr "finalize.lm0: cannot locate project root from %s\n" cwd
    return: 1

return: 0

sub: lm_finalize_log (@: char message)
    FILE: log_file

    log_file: fopen("build/lm0/finalize.log", "a")
    if: log_file = 0
        return

    c.fprintf: log_file "%s\n" message
    fclose(log_file)
end: lm_finalize_log

sub: lm_finalize_sleep_retry ()
    lm_finalize_platform_sleep_retry()
end: lm_finalize_sleep_retry

sub: lm_finalize_live_tool_path (@: char path; size_t: size; @: char tool_name)
    c.snprintf:
        path size "build%slm0%s%s.lm0%s"
        lm_finalize_platform_path_sep() lm_finalize_platform_path_sep()
        tool_name lm_finalize_platform_exe_suffix()
end: lm_finalize_live_tool_path

sub: lm_finalize_next_tool_path (@: char path; size_t: size; @: char tool_name)
    c.snprintf:
        path size "build%slm0%snext%s%s.lm0%s"
        lm_finalize_platform_path_sep() lm_finalize_platform_path_sep()
        lm_finalize_platform_path_sep() tool_name lm_finalize_platform_exe_suffix()
end: lm_finalize_next_tool_path

sub: lm_finalize_legacy_next_tool_path (@: char path; size_t: size; @: char tool_name)
    c.snprintf:
        path size "build%slm0%s%s.next.lm0%s"
        lm_finalize_platform_path_sep() lm_finalize_platform_path_sep()
        tool_name lm_finalize_platform_exe_suffix()
end: lm_finalize_legacy_next_tool_path

sub: lm_finalize_live_artifact_path (@: char path; size_t: size; @: char artifact_name)
    c.snprintf:
        path size "build%slm0%s%s"
        lm_finalize_platform_path_sep() lm_finalize_platform_path_sep()
        artifact_name
end: lm_finalize_live_artifact_path

sub: lm_finalize_next_artifact_path (@: char path; size_t: size; @: char artifact_name)
    c.snprintf:
        path size "build%slm0%snext%s%s"
        lm_finalize_platform_path_sep() lm_finalize_platform_path_sep()
        lm_finalize_platform_path_sep() artifact_name
end: lm_finalize_next_artifact_path

fn: lm_finalize_copy_once (@: char source_path; @: char output_path; int: quiet) int
    c.array: []: char buffer 32768
    FILE: source
    FILE: output
    size_t: count
    int: status

    source: fopen(source_path, "rb")
    if: source = 0
        if: quiet = 0
            c.fprintf: c.stderr "finalize.lm0: cannot open input file %s\n" source_path
        return: 1

    output: fopen(output_path, "wb")
    if: output = 0
        if: quiet = 0
            c.fprintf: c.stderr "finalize.lm0: cannot open output file %s\n" output_path
        fclose(source)
        return: 1

    status: 0
    count: fread(buffer, 1U, c.sizeof(buffer), source)
    while: count > 0U
        if: fwrite(buffer, 1U, count, output) != count
            status: 1
            break
        count: fread(buffer, 1U, c.sizeof(buffer), source)

    if: ferror(source)
        status: 1
    if: fclose(output) != 0
        status: 1
    fclose(source)

    if: status != 0
        if: quiet = 0
            c.fprintf: c.stderr "finalize.lm0: cannot copy %s to %s\n" source_path output_path
        return: 1

return: 0

fn: lm_finalize_copy_with_retry (@: char source_path; @: char output_path) int
    int: attempt 0

    while: attempt < 40
        if: lm_finalize_copy_once(source_path, output_path, 1) = 0
            c.printf: "finalize.lm0: copied %s to %s\n" source_path output_path
            return: 0
        lm_finalize_sleep_retry()
        attempt: attempt + 1

    if: lm_finalize_copy_once(source_path, output_path, 0) != 0
        return: 1

    c.printf: "finalize.lm0: copied %s to %s\n" source_path output_path
return: 0

fn: lm_finalize_install_next_tool (@: char tool_name) int
    c.array: []: char source_path 256
    c.array: []: char output_path 256

    lm_finalize_next_tool_path(source_path, c.sizeof(source_path), tool_name)
    lm_finalize_live_tool_path(output_path, c.sizeof(output_path), tool_name)

    if: lm_finalize_copy_with_retry(source_path, output_path) != 0
        lm_finalize_log("copy failed")
        return: 1

return: 0

fn: lm_finalize_install_legacy_next_tool (@: char tool_name) int
    c.array: []: char source_path 256
    c.array: []: char output_path 256

    lm_finalize_legacy_next_tool_path(source_path, c.sizeof(source_path), tool_name)
    lm_finalize_live_tool_path(output_path, c.sizeof(output_path), tool_name)

    if: lm_finalize_copy_with_retry(source_path, output_path) != 0
        lm_finalize_log("copy failed")
        return: 1

    if: remove(source_path) != 0
        c.fprintf: c.stderr "finalize.lm0: cannot remove temporary file %s\n" source_path
        lm_finalize_log("remove failed")
        return: 1

return: 0

fn: lm_finalize_install_next_artifact (@: char artifact_name) int
    c.array: []: char source_path 256
    c.array: []: char output_path 256

    lm_finalize_next_artifact_path(source_path, c.sizeof(source_path), artifact_name)
    lm_finalize_live_artifact_path(output_path, c.sizeof(output_path), artifact_name)

    if: lm_finalize_copy_with_retry(source_path, output_path) != 0
        lm_finalize_log("copy failed")
        return: 1

return: 0

fn: lm_finalize_defer () int
    c.array: []: char root_path 1024
    c.array: []: char finalize_path 1400
    c.array: []: char command 4096
    int: status

    if: lm_finalize_platform_getcwd(root_path, c.sizeof(root_path)) = 0
        c.fprintf: c.stderr "finalize.lm0: cannot get current directory\n"
        return: 1

    c.snprintf:
        finalize_path c.sizeof(finalize_path) "build%slm0%snext%sfinalize.lm0%s"
        lm_finalize_platform_path_sep() lm_finalize_platform_path_sep()
        lm_finalize_platform_path_sep()
        lm_finalize_platform_exe_suffix()
    if: lm_finalize_file_exists(finalize_path) = 0
        lm_finalize_live_tool_path(finalize_path, c.sizeof(finalize_path), "finalize")
    ---

    c.snprintf:
        command c.sizeof(command) lm_finalize_platform_defer_command_format()
        root_path finalize_path

    status: system(command)
    if: status != 0
        c.fprintf: c.stderr "finalize.lm0: cannot schedule deferred finalize step\n"
        lm_finalize_log("defer failed")
        return: 1

    lm_finalize_log("defer scheduled")
    c.printf: "finalize.lm0: scheduled deferred staged install\n"
return: 0

external:
    fn: main (int: argc; @@: char argv) int
        c.array: []: char staged_build_core_path 256

        if: lm_finalize_enter_project_root(argv[0]) != 0
            return: 1

        if: argc = 2 && strcmp(argv[1], "--defer") = 0
            return: lm_finalize_defer()

        if: argc != 1 && (argc != 2 || strcmp(argv[1], "--copy") != 0)
            c.fprintf: c.stderr "usage: finalize.lm0[.exe] [--defer|--copy]\n"
            return: 1

        lm_finalize_log("copy started")

        lm_finalize_next_tool_path(staged_build_core_path, c.sizeof(staged_build_core_path), "buildCore")
        if: lm_finalize_file_exists(staged_build_core_path) = 0
            if: lm_finalize_install_legacy_next_tool("make") != 0
                return: 1

            if: lm_finalize_install_legacy_next_tool("buildCore") != 0
                return: 1

            lm_finalize_log("legacy copy completed")
            return: 0
        ---

        if: lm_finalize_install_next_artifact("libparser.lm0.a") != 0
            return: 1

        if: lm_finalize_install_next_artifact("libown.lm0.a") != 0
            return: 1

        if: lm_finalize_install_next_tool("make") != 0
            return: 1

        if: lm_finalize_install_next_tool("trans") != 0
            return: 1

        if: lm_finalize_install_next_tool("vcpkgFetch") != 0
            return: 1

        if: lm_finalize_install_next_tool("printTree") != 0
            return: 1

        if: lm_finalize_install_next_tool("finalize") != 0
            return: 1

        if: lm_finalize_install_next_tool("buildCore") != 0
            return: 1

        lm_finalize_log("copy completed")
    return: 0
end: external
