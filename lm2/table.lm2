L4: loadHeaders

L4:
    table:
        name: `constant.backend`
        columns: class                                      (backend class)
        rows:
                 LM_TABLE_COLUMN_SPELLING_STRUCTURE         c.define
                 LM_TABLE_COLUMN_SPELLING_FRAME_CLOSE       c.define
                 LM_TABLE_LMX_STRUCTURE                    c.define
                 LM_TABLE_LMX_FIELD_LIST                   c.define
                 LM_TABLE_LMX_TRAILER_START                c.define
    end: `constant.backend`

    table:
        name: `constant.value`
        columns: class                                      (value literal)
        rows:
                 LM_TABLE_COLUMN_SPELLING_STRUCTURE         1
                 LM_TABLE_COLUMN_SPELLING_FRAME_CLOSE       2
                 LM_TABLE_LMX_STRUCTURE                    3
                 LM_TABLE_LMX_FIELD_LIST                   4
                 LM_TABLE_LMX_TRAILER_START                5
    end: `constant.value`

    table:
        name: LmTableBuffer
        columns: class     (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)
        rows:
                 data      char                   0                       1
                 length    size_t                 1                       0
                 capacity  size_t                 2                       0
                 failed    int                    3                       0
    end: LmTableBuffer

    table:
        name: LmTableColumn
        columns: class     (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)
        rows:
                 spelling  char                   0                       1
                 width     size_t                 1                       0
    end: LmTableColumn

    table:
        name: LmTableColumnSpellingFrame
        columns: class  (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)  (`field.const` serial)
        rows:
                 field  LmP0Field              0                       0                                1
                 phase  int                    1                       0                                0
                 first  int                    2                       0                                0
    end: LmTableColumnSpellingFrame

    table:
        name: LmTableEmitTablesFrame
        columns: class  (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)  (`field.const` serial)
        rows:
                 field  LmP0Field              0                       0                                1
    end: LmTableEmitTablesFrame

    table:
        name: LmTableLmxFrame
        columns: class    (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)  (`field.const` serial)
        rows:
                 field    LmP0Field              0                       0                                1
                 trailer  LmP0Trailer            1                       0                                1
                 phase    int                    2                       0                                0
                 first    int                    3                       0                                0
    end: LmTableLmxFrame

    table:
        name: LmTableError
        columns: class    (`field.class` class)  (`field.index` serial)  (`field.address-depth` serial)  (`field.const` serial)
        rows:
                 message  char                   0                       1                                1
    end: LmTableError

    table:
        name: `layout.backend`
        columns: class          (backend class)
        rows:
                 LmTableBuffer  c.struct
                 LmTableColumn  c.struct
                 LmTableColumnSpellingFrame c.struct
                 LmTableEmitTablesFrame c.struct
                 LmTableLmxFrame c.struct
                 LmTableError   c.struct
    end: `layout.backend`
end: L4

import: "lm4/own_abi.lm4"
import: "lm4/parser_abi.lm4"

include: "<stdint.h>" "<stdio.h>" "<stdlib.h>" "<string.h>"

fn: lm_table_text_equals (const: @(char data); size_t: text_length; const: @: char value) int
    size_t: length

    length: c.strlen(value)
return: text_length = length && c.memcmp(data, value, length) = 0

sub: lm_table_error_set (LmTableError: error; const: @: char message)
    if: error = 0 || error\message != 0
        return

    error\message: message
end: lm_table_error_set

fn: lm_table_buffer_reserve (LmTableBuffer: buffer; size_t: extra) int
    @: char new_data
    size_t: new_capacity
    size_t: required

    if: buffer = 0 || buffer\failed != 0
        return: 0

    required: buffer\length + extra + 1U
    if: required <= buffer\capacity
        return: 1

    if: buffer\capacity = 0U
        new_capacity: 256U
    if: buffer\capacity != 0U
        new_capacity: buffer\capacity
    ---

    while: new_capacity < required
        if: new_capacity > c.SIZE_MAX / 2U
            buffer\failed: 1
            return: 0
        new_capacity: new_capacity * 2U

    new_data: lm_own_resize(buffer\data, new_capacity)
    if: new_data = 0
        buffer\failed: 1
        return: 0

    buffer\data: new_data
    buffer\capacity: new_capacity
return: 1

sub: lm_table_buffer_append (LmTableBuffer: buffer; const: @(char data); size_t: length)
    if: lm_table_buffer_reserve(buffer, length) = 0
        return

    if: length != 0U
        c.memcpy(buffer\data + buffer\length, data, length)
    buffer\length: buffer\length + length
    buffer\data[buffer\length]: '\0'
end: lm_table_buffer_append

sub: lm_table_buffer_append_cstr (LmTableBuffer: buffer; const: @: char text)
    lm_table_buffer_append(buffer, text, c.strlen(text))
end: lm_table_buffer_append_cstr

sub: lm_table_buffer_append_text (LmTableBuffer: buffer; const: @(char data); size_t: length)
    lm_table_buffer_append(buffer, data, length)
end: lm_table_buffer_append_text

sub: lm_table_buffer_append_spaces (LmTableBuffer: buffer; size_t: count)
    while: count != 0U
        lm_table_buffer_append_cstr(buffer, " ")
        count: count - 1U
end: lm_table_buffer_append_spaces

fn: lm_table_buffer_take (LmTableBuffer: buffer) @: char
    @: char result

    if: buffer = 0 || buffer\failed != 0
        return: 0

    if: lm_table_buffer_reserve(buffer, 0U) = 0
        return: 0

    result: buffer\data
    buffer\data: 0
    buffer\length: 0U
    buffer\capacity: 0U
return: result

sub: lm_table_buffer_destroy (LmTableBuffer: buffer)
    if: buffer != 0
        lm_own_delete(buffer\data, 0)
        buffer\data: 0
        buffer\length: 0U
        buffer\capacity: 0U
        buffer\failed: 0
end: lm_table_buffer_destroy

fn: lm_table_buffer_new () LmTableBuffer
    return: lm_own_new_zero(1U * c.sizeof(c.LmTableBuffer))

sub: lm_table_buffer_delete (LmTableBuffer: buffer)
    if: buffer != 0
        lm_table_buffer_destroy(buffer)
        lm_own_delete(buffer, 0)
end: lm_table_buffer_delete

fn: lm_table_error_new () LmTableError
    return: lm_own_new_zero(1U * c.sizeof(c.LmTableError))

sub: lm_table_error_delete (LmTableError: error)
    lm_own_delete(error, 0)
end: lm_table_error_delete

fn: lm_table_node_ignored (const: (LmP0Node: node)) int
return: node = 0 || (node\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX)) != 0U

fn: lm_table_visible_field_count (const: (LmP0Structure: structure)) size_t
    const: LmP0Field: field
    size_t: count

    count: 0U
    if: structure = 0
        return: 0U

    field: structure\first_field
    while: field != 0
        if: lm_table_node_ignored(field\value) = 0
            count: count + 1U
        field: field\next

return: count

fn: lm_table_nth_visible_field (const: (LmP0Structure: structure); size_t: index) const: LmP0Node
    const: LmP0Field: field
    size_t: visible_index

    visible_index: 0U
    if: structure = 0
        return: 0

    field: structure\first_field
    while: field != 0
        if: lm_table_node_ignored(field\value) != 0
            field: field\next
            continue
        if: visible_index = index
            return: field\value
        visible_index: visible_index + 1U
        field: field\next

return: 0

fn: lm_table_find_child_frame (const: (LmP0Frame: frame); const: @: char head) const: LmP0Frame
    const: LmP0Field: field
    const: LmP0Node: node

    if: frame = 0
        return: 0

    field: frame\body\first_field
    while: field != 0
        node: field\value
        if: lm_table_node_ignored(node) = 0 && node\kind = c.LM_P0_NODE_FRAME && lm_table_text_equals(node\as\frame\head\data, node\as\frame\head\length, head)
            return: node\as\frame
        field: field\next

return: 0

fn: lm_table_single_body_node (const: (LmP0Frame: frame)) const: LmP0Node
    if: frame = 0 || lm_table_visible_field_count(frame\body) != 1U
        return: 0
return: lm_table_nth_visible_field(frame\body, 0U)

fn: lm_table_name_from_frame (const: (LmP0Frame: table_frame); const: @@(char out_name_data); @: size_t out_name_length; LmTableError: error) int
    const: LmP0Frame: name_frame
    const: LmP0Node: name_node

    name_frame: lm_table_find_child_frame(table_frame, "name")
    name_node: lm_table_single_body_node(name_frame)
    if: name_node = 0 || name_node\kind != c.LM_P0_NODE_ATOM
        lm_table_error_set(error, "table must contain name: <atom>")
        return: 0

    out_name_data[0]: name_node\as\atom\data
    out_name_length[0]: name_node\as\atom\length
return: 1

fn: lm_table_column_spelling_frame_new (const: (LmP0Field: field); int: phase; int: first) LmTableColumnSpellingFrame
    LmTableColumnSpellingFrame: frame

    frame: lm_own_new_zero(c.sizeof(c.LmTableColumnSpellingFrame))
    if: frame = 0
        return: 0
    frame\field: field
    frame\phase: phase
    frame\first: first
return: frame

fn: lm_table_column_spelling_append_node (LmTableBuffer: buffer; const: (LmP0Node: node)) int
    LmTableColumnSpellingFrame: frame
    LmOwnPtrStack: stack
    const: LmP0Node: argument
    const: LmP0Node: current
    int: done
    int: status

    if: node = 0
        return: 0

    stack: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
    if: stack = 0
        return: 0
    lm_own_ptr_stack_init(stack, c.lm_own_delete_plain)

    current: node
    done: 0
    status: 1
    while: status != 0 && done = 0
        if: current != 0
            if: current\kind = c.LM_P0_NODE_ATOM
                lm_table_buffer_append_text(buffer, current\as\atom\data, current\as\atom\length)
                if: buffer\failed != 0
                    status: 0
                current: 0
                continue

            if: current\kind = c.LM_P0_NODE_STRUCTURE
                lm_table_buffer_append_cstr(buffer, "(")
                if: buffer\failed != 0
                    status: 0
                    current: 0
                    continue
                frame: lm_table_column_spelling_frame_new(current\as\structure\first_field, c.LM_TABLE_COLUMN_SPELLING_STRUCTURE, 1)
                if: frame = 0
                    status: 0
                    current: 0
                    continue
                if: lm_own_ptr_stack_push(stack, frame) != 0
                    lm_own_delete(frame, 0)
                    status: 0
                    current: 0
                    continue
                current: 0
                continue

            if: current\kind = c.LM_P0_NODE_FRAME
                argument: lm_table_single_body_node(current\as\frame)
                if: argument = 0
                    status: 0
                    current: 0
                    continue
                lm_table_buffer_append_text(buffer, current\as\frame\head\data, current\as\frame\head\length)
                lm_table_buffer_append_cstr(buffer, "(")
                if: buffer\failed != 0
                    status: 0
                    current: 0
                    continue
                frame: lm_table_column_spelling_frame_new(0, c.LM_TABLE_COLUMN_SPELLING_FRAME_CLOSE, 0)
                if: frame = 0
                    status: 0
                    current: 0
                    continue
                if: lm_own_ptr_stack_push(stack, frame) != 0
                    lm_own_delete(frame, 0)
                    status: 0
                    current: 0
                    continue
                current: argument
                continue

            status: 0
            current: 0
            continue

        frame: lm_own_ptr_stack_top(stack)
        if: frame = 0
            done: 1
            continue

        if: frame\phase = c.LM_TABLE_COLUMN_SPELLING_FRAME_CLOSE
            lm_table_buffer_append_cstr(buffer, ")")
            lm_own_delete(lm_own_ptr_stack_pop(stack), 0)
            if: buffer\failed != 0
                status: 0
            continue

        while: frame\field != 0 && lm_table_node_ignored(frame\field\value) != 0
            frame\field: frame\field\next

        if: frame\field = 0
            if: frame\first
                status: 0
                continue
            lm_table_buffer_append_cstr(buffer, ")")
            lm_own_delete(lm_own_ptr_stack_pop(stack), 0)
            if: buffer\failed != 0
                status: 0
            continue

        if: frame\first = 0
            lm_table_buffer_append_cstr(buffer, " ")
            if: buffer\failed != 0
                status: 0
                continue
            ---

        current: frame\field\value
        frame\field: frame\field\next
        frame\first: 0

    lm_own_ptr_stack_destroy(stack)
    lm_own_delete(stack, 0)
return: status != 0 && buffer\failed = 0

fn: lm_table_column_spelling_alloc (const: (LmP0Node: node); LmTableError: error) @: char
    LmTableBuffer: buffer
    @: char result

    buffer: lm_table_buffer_new()
    if: buffer = 0
        lm_table_error_set(error, "out of memory while creating column formatter")
        return: 0
    finally: lm_table_buffer_delete(buffer)

    if: lm_table_column_spelling_append_node(buffer, node) = 0
        lm_table_error_set(error, "columns: fields must be atoms or descriptor structures")
        return: 0

    result: lm_table_buffer_take(buffer)
    if: result = 0
        lm_table_error_set(error, "out of memory while formatting column")
return: result

sub: lm_table_columns_destroy (@: LmTableColumn columns; size_t: count)
    size_t: index

    if: columns = 0
        return

    index: 0U
    while: index < count
        if: columns[index] != 0
            lm_own_delete(columns[index]\spelling, 0)
            lm_own_delete(columns[index], 0)
        index: index + 1U
    lm_own_delete(columns, 0)
end: lm_table_columns_destroy

fn: lm_table_columns_from_frame (
    const: LmP0Frame: table_frame
    @@: LmTableColumn out_columns
    @: size_t out_count
    LmTableError: error
) int
    const: LmP0Frame: columns_frame
    const: LmP0Node: node
    @: LmTableColumn columns
    size_t: count
    size_t: index

    columns_frame: lm_table_find_child_frame(table_frame, "columns")
    if: columns_frame = 0
        lm_table_error_set(error, "table must contain columns:")
        return: 0

    count: lm_table_visible_field_count(columns_frame\body)
    if: count = 0U
        lm_table_error_set(error, "columns: must not be empty")
        return: 0

    columns: lm_own_new_zero(count * c.sizeof(columns[0]))
    if: columns = 0
        lm_table_error_set(error, "out of memory while reading columns")
        return: 0
    finally: lm_table_columns_destroy(columns, count)

    index: 0U
    while: index < count
        node: lm_table_nth_visible_field(columns_frame\body, index)
        columns[index]: lm_own_new_zero(c.sizeof(c.LmTableColumn))
        if: columns[index] = 0
            lm_table_error_set(error, "out of memory while reading columns")
            return: 0
        columns[index]\spelling: lm_table_column_spelling_alloc(node, error)
        if: columns[index]\spelling = 0
            return: 0
        columns[index]\width: c.strlen(columns[index]\spelling)
        index: index + 1U

    out_columns[0]: columns
    out_count[0]: count
    columns: 0
return: 1

fn: lm_table_rows_frame_from_table (const: (LmP0Frame: table_frame); LmTableError: error) const: LmP0Frame
    const: LmP0Frame: rows_frame

    rows_frame: lm_table_find_child_frame(table_frame, "rows")
    if: rows_frame = 0
        lm_table_error_set(error, "table must contain rows:")
        return: 0

return: rows_frame

fn: lm_table_atom_lmx_append_inline (LmTableBuffer: buffer; const: (LmP0Text: atom)) int
    lm_table_buffer_append_text(buffer, atom\data, atom\length)
return: buffer\failed = 0

fn: lm_table_lmx_frame_new (
    const: LmP0Field: field
    const: LmP0Trailer: trailer
    int: phase
    int: first
) LmTableLmxFrame
    LmTableLmxFrame: frame

    frame: lm_own_new_zero(c.sizeof(c.LmTableLmxFrame))
    if: frame = 0
        return: 0
    frame\field: field
    frame\trailer: trailer
    frame\phase: phase
    frame\first: first
return: frame

fn: lm_table_node_lmx_append_inline (LmTableBuffer: buffer; const: (LmP0Node: node)) int
    LmTableLmxFrame: frame
    LmOwnPtrStack: stack
    const: LmP0Node: current
    int: done
    int: status

    if: node = 0
        return: 0

    stack: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
    if: stack = 0
        return: 0
    lm_own_ptr_stack_init(stack, c.lm_own_delete_plain)

    current: node
    done: 0
    status: 1
    while: status != 0 && done = 0
        if: current != 0
            if: current\kind = c.LM_P0_NODE_ATOM || current\kind = c.LM_P0_NODE_DISABLED
                if: lm_table_atom_lmx_append_inline(buffer, current\as\atom) = 0
                    status: 0
                current: 0
                continue

            if: current\kind = c.LM_P0_NODE_STRUCTURE
                lm_table_buffer_append_cstr(buffer, "(")
                if: buffer\failed != 0
                    status: 0
                    current: 0
                    continue
                frame: lm_table_lmx_frame_new(current\as\structure\first_field, 0, c.LM_TABLE_LMX_STRUCTURE, 1)
                if: frame = 0
                    status: 0
                    current: 0
                    continue
                if: lm_own_ptr_stack_push(stack, frame) != 0
                    lm_own_delete(frame, 0)
                    status: 0
                    current: 0
                    continue
                current: 0
                continue

            if: current\kind = c.LM_P0_NODE_FRAME
                lm_table_buffer_append_text(buffer, current\as\frame\head\data, current\as\frame\head\length)
                lm_table_buffer_append_cstr(buffer, ":")
                if: buffer\failed != 0
                    status: 0
                    current: 0
                    continue
                if: current\as\frame\trailer != 0
                    frame: lm_table_lmx_frame_new(0, current\as\frame\trailer, c.LM_TABLE_LMX_TRAILER_START, 0)
                    if: frame = 0
                        status: 0
                        current: 0
                        continue
                    if: lm_own_ptr_stack_push(stack, frame) != 0
                        lm_own_delete(frame, 0)
                        status: 0
                        current: 0
                        continue
                ---
                frame: lm_table_lmx_frame_new(current\as\frame\body\first_field, 0, c.LM_TABLE_LMX_FIELD_LIST, 0)
                if: frame = 0
                    status: 0
                    current: 0
                    continue
                if: lm_own_ptr_stack_push(stack, frame) != 0
                    lm_own_delete(frame, 0)
                    status: 0
                    current: 0
                    continue
                current: 0
                continue

            status: 0
            current: 0
            continue

        frame: lm_own_ptr_stack_top(stack)
        if: frame = 0
            done: 1
            continue

        if: frame\phase = c.LM_TABLE_LMX_TRAILER_START
            lm_table_buffer_append_cstr(buffer, " ")
            lm_table_buffer_append_text(buffer, frame\trailer\spelling\data, frame\trailer\spelling\length)
            lm_table_buffer_append_cstr(buffer, ":")
            if: buffer\failed != 0
                status: 0
                continue
            frame\field: frame\trailer\body\first_field
            frame\trailer: 0
            frame\phase: c.LM_TABLE_LMX_FIELD_LIST
            continue

        while: frame\field != 0 && lm_table_node_ignored(frame\field\value) != 0
            frame\field: frame\field\next

        if: frame\field = 0
            if: frame\phase = c.LM_TABLE_LMX_STRUCTURE
                lm_table_buffer_append_cstr(buffer, ")")
            lm_own_delete(lm_own_ptr_stack_pop(stack), 0)
            if: buffer\failed != 0
                status: 0
            continue

        if: frame\phase = c.LM_TABLE_LMX_STRUCTURE && frame\first = 0
            lm_table_buffer_append_cstr(buffer, " ")
            if: buffer\failed != 0
                status: 0
                continue
            ---
        if: frame\phase = c.LM_TABLE_LMX_FIELD_LIST
            lm_table_buffer_append_cstr(buffer, " ")
            if: buffer\failed != 0
                status: 0
                continue
            ---

        current: frame\field\value
        frame\field: frame\field\next
        frame\first: 0

    lm_own_ptr_stack_destroy(stack)
    lm_own_delete(stack, 0)
return: status != 0 && buffer\failed = 0

fn: lm_table_node_lmx_alloc (const: (LmP0Node: node); LmTableError: error) @: char
    LmTableBuffer: buffer
    @: char result

    buffer: lm_table_buffer_new()
    if: buffer = 0
        lm_table_error_set(error, "out of memory while creating cell formatter")
        return: 0
    finally: lm_table_buffer_delete(buffer)

    if: lm_table_node_lmx_append_inline(buffer, node) = 0
        lm_table_error_set(error, "rows: cannot format cell node")
        return: 0

    result: lm_table_buffer_take(buffer)
    if: result = 0
        lm_table_error_set(error, "out of memory while formatting cell")
return: result

fn: lm_table_measure_rows (
    const: LmP0Frame: rows_frame
    @: LmTableColumn columns
    size_t: column_count
    @: size_t out_row_count
    LmTableError: error
) int
    const: LmP0Node: node
    @: char spelling
    size_t: cell_count
    size_t: index
    size_t: column_index
    size_t: spelling_length

    cell_count: lm_table_visible_field_count(rows_frame\body)
    if: cell_count = 0U
        out_row_count[0]: 0U
        return: 1

    if: column_count = 0U || (cell_count % column_count) != 0U
        lm_table_error_set(error, "rows: cell count must be divisible by column count; use explicit NULL for empty cells")
        return: 0

    index: 0U
    while: index < cell_count
        node: lm_table_nth_visible_field(rows_frame\body, index)
        if: node = 0
            lm_table_error_set(error, "rows: cell is empty")
            return: 0

        spelling: lm_table_node_lmx_alloc(node, error)
        if: spelling = 0
            return: 0
        spelling_length: c.strlen(spelling)
        column_index: index % column_count
        if: columns[column_index]\width < spelling_length
            columns[column_index]\width: spelling_length
        lm_own_delete(spelling, 0)
        index: index + 1U

    out_row_count[0]: cell_count / column_count
return: 1

fn: lm_table_emit_columns (LmTableBuffer: buffer; @: LmTableColumn columns; size_t: column_count) int
    size_t: index
    size_t: length

    lm_table_buffer_append_cstr(buffer, "    columns: ")
    index: 0U
    while: index < column_count
        length: c.strlen(columns[index]\spelling)
        lm_table_buffer_append_cstr(buffer, columns[index]\spelling)
        if: index + 1U < column_count
            lm_table_buffer_append_spaces(buffer, columns[index]\width - length + 2U)
        index: index + 1U

    lm_table_buffer_append_cstr(buffer, "\n")
return: buffer\failed = 0

fn: lm_table_emit_rows (
    LmTableBuffer: buffer
    const: LmP0Frame: rows_frame
    @: LmTableColumn columns
    size_t: column_count
    size_t: row_count
    LmTableError: error
) int
    const: LmP0Node: node
    @: char spelling
    size_t: row_index
    size_t: column_index
    size_t: cell_index
    size_t: spelling_length

    lm_table_buffer_append_cstr(buffer, "    rows:\n")
    row_index: 0U
    while: row_index < row_count
        lm_table_buffer_append_cstr(buffer, "             ")
        column_index: 0U
        while: column_index < column_count
            cell_index: row_index * column_count + column_index
            node: lm_table_nth_visible_field(rows_frame\body, cell_index)
            spelling: lm_table_node_lmx_alloc(node, error)
            if: spelling = 0
                return: 0
            spelling_length: c.strlen(spelling)
            lm_table_buffer_append_cstr(buffer, spelling)
            if: column_index + 1U < column_count
                lm_table_buffer_append_spaces(buffer, columns[column_index]\width - spelling_length + 2U)
            lm_own_delete(spelling, 0)
            column_index: column_index + 1U
        lm_table_buffer_append_cstr(buffer, "\n")
        row_index: row_index + 1U

return: buffer\failed = 0

sub: lm_table_end_name (
    const: LmP0Frame: table_frame
    const: @: char table_name_data
    size_t: table_name_length
    const: @@: char out_name_data
    @: size_t out_name_length
)
    const: LmP0Node: node

    if: table_frame != 0 && table_frame\trailer != 0 && lm_table_text_equals(table_frame\trailer\spelling\data, table_frame\trailer\spelling\length, "end") && lm_table_visible_field_count(table_frame\trailer\body) = 1U
        node: lm_table_nth_visible_field(table_frame\trailer\body, 0U)
        if: node != 0 && node\kind = c.LM_P0_NODE_ATOM
            out_name_data[0]: node\as\atom\data
            out_name_length[0]: node\as\atom\length
            return
    ---

    out_name_data[0]: table_name_data
    out_name_length[0]: table_name_length
end: lm_table_end_name

fn: lm_table_to_lmx_alloc (const: (LmP0Frame: table_frame); LmTableError: error) @: char
    const: LmP0Frame: rows_frame
    const: @: char table_name_data
    size_t: table_name_length
    const: @: char end_name_data
    size_t: end_name_length
    @: LmTableColumn columns
    LmTableBuffer: buffer
    size_t: column_count
    size_t: row_count
    @: char result

    buffer: lm_table_buffer_new()
    if: buffer = 0
        lm_table_error_set(error, "out of memory while creating table formatter")
        return: 0
    finally: lm_table_buffer_delete(buffer)
    columns: 0
    column_count: 0U
    row_count: 0U
    finally: lm_table_columns_destroy(columns, column_count)

    if: lm_table_name_from_frame(table_frame, @ table_name_data, @ table_name_length, error) = 0
        return: 0
    if: lm_table_columns_from_frame(table_frame, @ columns, @ column_count, error) = 0
        return: 0

    rows_frame: lm_table_rows_frame_from_table(table_frame, error)
    if: rows_frame = 0
        return: 0

    if: lm_table_measure_rows(rows_frame, columns, column_count, @ row_count, error) = 0
        return: 0

    lm_table_end_name(table_frame, table_name_data, table_name_length, @ end_name_data, @ end_name_length)

    lm_table_buffer_append_cstr(buffer, "table:\n")
    lm_table_buffer_append_cstr(buffer, "    name: ")
    lm_table_buffer_append_text(buffer, table_name_data, table_name_length)
    lm_table_buffer_append_cstr(buffer, "\n")
    lm_table_emit_columns(buffer, columns, column_count)
    lm_table_emit_rows(buffer, rows_frame, columns, column_count, row_count, error)
    lm_table_buffer_append_cstr(buffer, "end: ")
    lm_table_buffer_append_text(buffer, end_name_data, end_name_length)
    lm_table_buffer_append_cstr(buffer, "\n")

    result: lm_table_buffer_take(buffer)
    if: result = 0
        lm_table_error_set(error, "out of memory while formatting table")
return: result

fn: lm_table_emit_tables_frame_new (const: (LmP0Field: field)) LmTableEmitTablesFrame
    LmTableEmitTablesFrame: frame

    frame: lm_own_new_zero(c.sizeof(c.LmTableEmitTablesFrame))
    if: frame = 0
        return: 0
    frame\field: field
return: frame

fn: lm_table_emit_one_table_frame (
    LmTableBuffer: output
    const: LmP0Frame: table_frame
    @: int emitted
    LmTableError: error
) int
    @: char table_text

    table_text: lm_table_to_lmx_alloc(table_frame, error)
    if: table_text = 0
        return: 0
    if: emitted[0] != 0
        lm_table_buffer_append_cstr(output, "\n")
    lm_table_buffer_append_cstr(output, table_text)
    lm_own_delete(table_text, 0)
    emitted[0]: 1
return: output\failed = 0

fn: lm_table_emit_tables_from_node (
    LmTableBuffer: output
    const: LmP0Node: node
    @: int emitted
    LmTableError: error
) int
    LmTableEmitTablesFrame: frame
    LmOwnPtrStack: stack
    const: LmP0Node: current
    int: done
    int: status

    if: lm_table_node_ignored(node) != 0
        return: 1

    if: node\kind = c.LM_P0_NODE_FRAME
        if: lm_table_text_equals(node\as\frame\head\data, node\as\frame\head\length, "table")
            return: lm_table_emit_one_table_frame(output, node\as\frame, emitted, error)
        ---
    if: node\kind != c.LM_P0_NODE_FRAME && node\kind != c.LM_P0_NODE_STRUCTURE
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as\structure\first_field = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as\frame\body\first_field = 0
        return: 1

    stack: lm_own_new_zero(c.sizeof(c.LmOwnPtrStack))
    if: stack = 0
        return: 0
    lm_own_ptr_stack_init(stack, c.lm_own_delete_plain)

    if: node\kind = c.LM_P0_NODE_STRUCTURE
        frame: lm_table_emit_tables_frame_new(node\as\structure\first_field)
    if: node\kind = c.LM_P0_NODE_FRAME
        frame: lm_table_emit_tables_frame_new(node\as\frame\body\first_field)
    ---
    if: frame = 0
        lm_own_ptr_stack_destroy(stack)
        lm_own_delete(stack, 0)
        return: 0
    if: lm_own_ptr_stack_push(stack, frame) != 0
        lm_own_delete(frame, 0)
        lm_own_ptr_stack_destroy(stack)
        lm_own_delete(stack, 0)
        return: 0

    current: 0
    done: 0
    status: 1
    while: status != 0 && done = 0
        frame: lm_own_ptr_stack_top(stack)
        if: frame = 0
            done: 1
            continue

        if: frame\field = 0
            lm_own_delete(lm_own_ptr_stack_pop(stack), 0)
            continue

        current: frame\field\value
        frame\field: frame\field\next

        if: lm_table_node_ignored(current) != 0
            continue

        if: current\kind = c.LM_P0_NODE_FRAME
            if: lm_table_text_equals(current\as\frame\head\data, current\as\frame\head\length, "table")
                if: lm_table_emit_one_table_frame(output, current\as\frame, emitted, error) = 0
                    status: 0
                continue
            if: current\as\frame\body\first_field = 0
                continue
            frame: lm_table_emit_tables_frame_new(current\as\frame\body\first_field)
            if: frame = 0
                status: 0
                continue
            if: lm_own_ptr_stack_push(stack, frame) != 0
                lm_own_delete(frame, 0)
                status: 0
                continue
            continue

        if: current\kind = c.LM_P0_NODE_STRUCTURE
            if: current\as\structure\first_field = 0
                continue
            frame: lm_table_emit_tables_frame_new(current\as\structure\first_field)
            if: frame = 0
                status: 0
                continue
            if: lm_own_ptr_stack_push(stack, frame) != 0
                lm_own_delete(frame, 0)
                status: 0
                continue
            ---
        ---

    lm_own_ptr_stack_destroy(stack)
    lm_own_delete(stack, 0)
return: status != 0 && output\failed = 0

fn: lm_table_document_tables_to_lmx_alloc (const: (LmP0Document: document); LmTableError: error) @: char
    const: LmP0Node: root
    LmTableBuffer: output
    int: emitted
    @: char result

    output: lm_table_buffer_new()
    if: output = 0
        lm_table_error_set(error, "out of memory while creating document formatter")
        return: 0
    finally: lm_table_buffer_delete(output)
    emitted: 0
    root: c.lm_p0_document_root(document)

    if: lm_table_emit_tables_from_node(output, root, @ emitted, error) = 0
        return: 0

    result: lm_table_buffer_take(output)
    if: result = 0
        lm_table_error_set(error, "out of memory while formatting document tables")
return: result

external:
    fn: main (int: argc; @@: char argv) int
        LmP0Document: document 0
        const: LmP0Diagnostic: diagnostic
        LmTableError: error
        @: char text
        int: status

        c.setvbuf: c.stdout 0 c._IONBF 0
        c.setvbuf: c.stderr 0 c._IONBF 0

        if: argc != 2
            c.printf: "usage: table.lm0[.exe] <source.lmx>\n"
            return: 0

        error: lm_table_error_new()
        if: error = 0
            c.fprintf: c.stderr "table toLmx error: out of memory while creating error state\n"
            return: 1

        status: c.lm_p0_parse_file(argv[1], @ document)
        if: status != 0
            diagnostic: c.lm_p0_document_diagnostic(document)
            if: diagnostic != 0
                c.fprintf:
                    c.stderr
                    "P0 parse error %d at %zu:%zu: %s\n"
                    diagnostic\code diagnostic\line diagnostic\column diagnostic\message
            ---
            if: diagnostic = 0
                c.fprintf: c.stderr "P0 parse error while reading %s\n" argv[1]
            ---
            c.lm_p0_document_destroy(document)
            lm_table_error_delete(error)
            return: 1

        text: lm_table_document_tables_to_lmx_alloc(document, error)
        if: text = 0
            if: error\message != 0
                c.fprintf: c.stderr "table toLmx error: %s\n" error\message
            if: error\message = 0
                c.fprintf: c.stderr "table toLmx error: %s\n" "unknown error"
            ---
            c.lm_p0_document_destroy(document)
            lm_table_error_delete(error)
            return: 1

        c.fputs: text c.stdout
        lm_own_delete(text, 0)
        c.lm_p0_document_destroy(document)
        lm_table_error_delete(error)
    return: 0
end: external
