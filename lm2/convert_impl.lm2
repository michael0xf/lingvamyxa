predef: "lm2/own_abi.lm2"

external:
    fn: lm_stg_convert_int_long (int: n) long
        return: (cast: long n)
    end: lm_stg_convert_int_long
end: external

external:
    fn: lm_stg_convert_long_int (long: n) int
        if: n > 2147483647 || n < -2147483648
            return: 0
        return: (cast: int n)
    end: lm_stg_convert_long_int
end: external

external:
    fn: lm_stg_convert_int_double (int: n) double
        return: (cast: double n)
    end: lm_stg_convert_int_double
end: external

external:
    fn: lm_stg_convert_double_int (double: n) int
        return: (cast: int n)
    end: lm_stg_convert_double_int
end: external

external:
    fn: lm_stg_convert_Boolean_int (int: flag) int
        if: flag < 0
            return: -1
        if: flag > 0
            return: 1
        return: 0
    end: lm_stg_convert_Boolean_int
end: external

external:
    fn: lm_stg_convert_int_Boolean (int: n) int
        if: n < 0
            return: -1
        if: n > 0
            return: 1
        return: 0
    end: lm_stg_convert_int_Boolean
end: external

external:
    fn: lm_stg_convert_text_int (@: char text) int
        @: char end
        long: n

        if: text = 0
            return: 0
        n: c.strtol(text, @ end, 10)
        return: (cast: int n)
    end: lm_stg_convert_text_int
end: external

external:
    fn: lm_stg_convert_text_double (@: char text) double
        if: text = 0
            return: 0.0
        return: c.strtod(text, 0)
    end: lm_stg_convert_text_double
end: external

