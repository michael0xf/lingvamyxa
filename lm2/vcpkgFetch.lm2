#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "own.lm1.h"

#ifdef _WIN32
#include <direct.h>
#define LM_VCPKG_EXE_SUFFIX ".exe"
#define LM_VCPKG_PATH_SEP "\\"
#define LM_VCPKG_CHDIR _chdir
#define LM_VCPKG_GETCWD _getcwd
#define LM_VCPKG_DEFAULT_TRIPLET "x64-mingw-dynamic"
#elif defined(__APPLE__)
#include <unistd.h>
#define LM_VCPKG_EXE_SUFFIX ""
#define LM_VCPKG_PATH_SEP "/"
#define LM_VCPKG_CHDIR chdir
#define LM_VCPKG_GETCWD getcwd
#define LM_VCPKG_DEFAULT_TRIPLET "x64-osx"
#else
#include <unistd.h>
#define LM_VCPKG_EXE_SUFFIX ""
#define LM_VCPKG_PATH_SEP "/"
#define LM_VCPKG_CHDIR chdir
#define LM_VCPKG_GETCWD getcwd
#define LM_VCPKG_DEFAULT_TRIPLET "x64-linux"
#endif

typedef struct LmVcpkgOptions {
    const char *output_dir;
    const char *manifest_root;
    const char *triplet;
    const char *host_triplet;
    const char *vcpkg_tool;
    const char *vcpkg_root;
    int dry_run;
} LmVcpkgOptions;

static LmVcpkgOptions *lm_vcpkg_options_new(void) {
    return (LmVcpkgOptions *)calloc(1U, sizeof(LmVcpkgOptions));
}

static void lm_vcpkg_options_delete(LmVcpkgOptions *options) {
    lm_own_delete(options, NULL);
}

static int lm_vcpkg_is_path_separator(char value) {
    return value == '/' || value == '\\';
}

static int lm_vcpkg_has_path_separator(const char *path) {
    return strchr(path, '/') != NULL || strchr(path, '\\') != NULL;
}

static int lm_vcpkg_is_absolute_path(const char *path) {
#ifdef _WIN32
    if (path[0] != '\0' && lm_vcpkg_is_path_separator(path[0]) && lm_vcpkg_is_path_separator(path[1])) {
        return 1;
    }
    if (path[0] != '\0' && path[1] == ':' && lm_vcpkg_is_path_separator(path[2])) {
        return 1;
    }
    return 0;
#else
    return path[0] == '/';
#endif
}

static int lm_vcpkg_join_path(char *buffer, size_t size, const char *base, const char *tail) {
    size_t base_length;
    size_t tail_length;
    size_t used;

    base_length = strlen(base);
    tail_length = strlen(tail);
    used = base_length;

    if (base_length + tail_length + 2U >= size) {
        fprintf(stderr, "vcpkgFetch.lm0: path is too long\n");
        return 1;
    }

    memcpy(buffer, base, base_length);
    if (base_length > 0U && tail_length > 0U && !lm_vcpkg_is_path_separator(base[base_length - 1U]) && !lm_vcpkg_is_path_separator(tail[0])) {
        memcpy(buffer + used, LM_VCPKG_PATH_SEP, strlen(LM_VCPKG_PATH_SEP));
        used += strlen(LM_VCPKG_PATH_SEP);
    }
    memcpy(buffer + used, tail, tail_length + 1U);

    return 0;
}

static int lm_vcpkg_trim_last_path_part(char *path) {
    size_t length;

    length = strlen(path);
    while (length > 0U && lm_vcpkg_is_path_separator(path[length - 1U])) {
        path[length - 1U] = '\0';
        --length;
    }

    while (length > 0U) {
        --length;
        if (lm_vcpkg_is_path_separator(path[length])) {
            path[length] = '\0';
            return 0;
        }
    }

    path[0] = '\0';
    return 0;
}

static int lm_vcpkg_file_exists(const char *path) {
    FILE *file;

    file = fopen(path, "rb");
    if (file == NULL) {
        return 0;
    }

    fclose(file);
    return 1;
}

static int lm_vcpkg_has_project_marker(const char *path) {
    char marker_path[2048];

    if (lm_vcpkg_join_path(marker_path, sizeof(marker_path), path, "cmake/vcpkg-sources/vcpkg.json") != 0) {
        return 0;
    }

    return lm_vcpkg_file_exists(marker_path);
}

static int lm_vcpkg_enter_project_root(const char *program_path) {
    char search_path[1024];
    char executable_path[1024];
    char cwd[1024];
    int depth;

    if (LM_VCPKG_GETCWD(cwd, sizeof(cwd)) == NULL) {
        fprintf(stderr, "vcpkgFetch.lm0: cannot read current directory\n");
        return 1;
    }

    if (program_path != NULL && program_path[0] != '\0' && lm_vcpkg_has_path_separator(program_path)) {
        if (lm_vcpkg_is_absolute_path(program_path)) {
            if (strlen(program_path) >= sizeof(executable_path)) {
                fprintf(stderr, "vcpkgFetch.lm0: executable path is too long\n");
                return 1;
            }
            strcpy(executable_path, program_path);
        } else if (lm_vcpkg_join_path(executable_path, sizeof(executable_path), cwd, program_path) != 0) {
            return 1;
        }

        strcpy(search_path, executable_path);
        lm_vcpkg_trim_last_path_part(search_path);
    } else {
        strcpy(search_path, cwd);
    }

    for (depth = 0; depth < 12 && search_path[0] != '\0'; ++depth) {
        if (lm_vcpkg_has_project_marker(search_path)) {
            if (LM_VCPKG_CHDIR(search_path) != 0) {
                fprintf(stderr, "vcpkgFetch.lm0: cannot enter project root %s\n", search_path);
                return 1;
            }
            return 0;
        }
        lm_vcpkg_trim_last_path_part(search_path);
    }

    fprintf(stderr, "vcpkgFetch.lm0: cannot locate project root from %s\n", cwd);
    return 1;
}

static const char *lm_vcpkg_env_or_default(const char *name, const char *fallback) {
    const char *value;

    value = getenv(name);
    if (value == NULL || value[0] == '\0') {
        return fallback;
    }

    return value;
}

static int lm_vcpkg_append(char *buffer, size_t size, size_t *used, const char *text) {
    size_t length;

    length = strlen(text);
    if (*used + length >= size) {
        fprintf(stderr, "vcpkgFetch.lm0: command line is too long\n");
        return 1;
    }

    memcpy(buffer + *used, text, length + 1U);
    *used += length;
    return 0;
}

static int lm_vcpkg_append_quoted(char *buffer, size_t size, size_t *used, const char *arg, int leading_space) {
    if (leading_space && lm_vcpkg_append(buffer, size, used, " ") != 0) {
        return 1;
    }
    if (lm_vcpkg_append(buffer, size, used, "\"") != 0) {
        return 1;
    }
    if (lm_vcpkg_append(buffer, size, used, arg) != 0) {
        return 1;
    }
    return lm_vcpkg_append(buffer, size, used, "\"");
}

static int lm_vcpkg_append_prefixed_arg(
    char *buffer,
    size_t size,
    size_t *used,
    const char *prefix,
    const char *value
) {
    char arg[2048];

    if (strlen(prefix) + strlen(value) >= sizeof(arg)) {
        fprintf(stderr, "vcpkgFetch.lm0: vcpkg argument is too long\n");
        return 1;
    }

    strcpy(arg, prefix);
    strcat(arg, value);

    return lm_vcpkg_append_quoted(buffer, size, used, arg, 1);
}

static int lm_vcpkg_discover_tool(char *buffer, size_t size, const char **root_out) {
    const char *tool_env;
    const char *root_env;
    char candidate[1024];

    *root_out = NULL;

    tool_env = getenv("LM_VCPKG");
    if (tool_env != NULL && tool_env[0] != '\0') {
        if (strlen(tool_env) >= size) {
            fprintf(stderr, "vcpkgFetch.lm0: LM_VCPKG is too long\n");
            return 1;
        }
        strcpy(buffer, tool_env);
        return 0;
    }

    root_env = getenv("VCPKG_ROOT");
    if (root_env != NULL && root_env[0] != '\0') {
        if (lm_vcpkg_join_path(candidate, sizeof(candidate), root_env, "vcpkg" LM_VCPKG_EXE_SUFFIX) != 0) {
            return 1;
        }
        if (lm_vcpkg_file_exists(candidate)) {
            if (strlen(candidate) >= size) {
                fprintf(stderr, "vcpkgFetch.lm0: vcpkg path is too long\n");
                return 1;
            }
            strcpy(buffer, candidate);
            *root_out = root_env;
            return 0;
        }
    }

#ifdef _WIN32
    if (lm_vcpkg_file_exists("C:/vcpkg/vcpkg.exe")) {
        if (strlen("C:/vcpkg/vcpkg.exe") >= size) {
            fprintf(stderr, "vcpkgFetch.lm0: default vcpkg path is too long\n");
            return 1;
        }
        strcpy(buffer, "C:/vcpkg/vcpkg.exe");
        *root_out = "C:/vcpkg";
        return 0;
    }
#endif

    if (strlen("vcpkg") >= size) {
        fprintf(stderr, "vcpkgFetch.lm0: fallback vcpkg command is too long\n");
        return 1;
    }
    strcpy(buffer, "vcpkg");
    return 0;
}

static void lm_vcpkg_print_usage(void) {
    printf("usage: vcpkgFetch.lm0 [options]\n");
    printf("  --output <dir>          downloads-root directory, default: build/vcpkg-downloads\n");
    printf("  --manifest-root <dir>   vcpkg source catalog, default: cmake/vcpkg-sources\n");
    printf("  --triplet <triplet>     target triplet, default: platform-specific\n");
    printf("  --host-triplet <triplet> host triplet, default: target triplet\n");
    printf("  --vcpkg <path>          vcpkg executable, or set LM_VCPKG\n");
    printf("  --vcpkg-root <dir>      vcpkg root, or set VCPKG_ROOT\n");
    printf("  --dry-run               print vcpkg plan without downloading\n");
}

static int lm_vcpkg_parse_options(int argc, char **argv, LmVcpkgOptions *options) {
    int index;

    options->output_dir = lm_vcpkg_env_or_default("LM_VCPKG_DOWNLOADS", "build/vcpkg-downloads");
    options->manifest_root = lm_vcpkg_env_or_default("LM_VCPKG_MANIFEST_ROOT", "cmake/vcpkg-sources");
    options->triplet = lm_vcpkg_env_or_default("LM_VCPKG_TRIPLET", LM_VCPKG_DEFAULT_TRIPLET);
    options->host_triplet = lm_vcpkg_env_or_default("LM_VCPKG_HOST_TRIPLET", "");
    options->vcpkg_tool = lm_vcpkg_env_or_default("LM_VCPKG", "");
    options->vcpkg_root = lm_vcpkg_env_or_default("VCPKG_ROOT", "");
    options->dry_run = 0;

    for (index = 1; index < argc; ++index) {
        if (strcmp(argv[index], "--output") == 0 || strcmp(argv[index], "-o") == 0) {
            if (index + 1 >= argc) {
                fprintf(stderr, "vcpkgFetch.lm0: --output expects a directory\n");
                return 1;
            }
            options->output_dir = argv[++index];
        } else if (strcmp(argv[index], "--manifest-root") == 0) {
            if (index + 1 >= argc) {
                fprintf(stderr, "vcpkgFetch.lm0: --manifest-root expects a directory\n");
                return 1;
            }
            options->manifest_root = argv[++index];
        } else if (strcmp(argv[index], "--triplet") == 0) {
            if (index + 1 >= argc) {
                fprintf(stderr, "vcpkgFetch.lm0: --triplet expects a value\n");
                return 1;
            }
            options->triplet = argv[++index];
        } else if (strcmp(argv[index], "--host-triplet") == 0) {
            if (index + 1 >= argc) {
                fprintf(stderr, "vcpkgFetch.lm0: --host-triplet expects a value\n");
                return 1;
            }
            options->host_triplet = argv[++index];
        } else if (strcmp(argv[index], "--vcpkg") == 0) {
            if (index + 1 >= argc) {
                fprintf(stderr, "vcpkgFetch.lm0: --vcpkg expects a path\n");
                return 1;
            }
            options->vcpkg_tool = argv[++index];
        } else if (strcmp(argv[index], "--vcpkg-root") == 0) {
            if (index + 1 >= argc) {
                fprintf(stderr, "vcpkgFetch.lm0: --vcpkg-root expects a directory\n");
                return 1;
            }
            options->vcpkg_root = argv[++index];
        } else if (strcmp(argv[index], "--dry-run") == 0) {
            options->dry_run = 1;
        } else if (strcmp(argv[index], "--help") == 0 || strcmp(argv[index], "-h") == 0) {
            lm_vcpkg_print_usage();
            return 2;
        } else {
            fprintf(stderr, "vcpkgFetch.lm0: unknown option: %s\n", argv[index]);
            lm_vcpkg_print_usage();
            return 1;
        }
    }

    if (options->host_triplet[0] == '\0') {
        options->host_triplet = options->triplet;
    }

    return 0;
}

static int lm_vcpkg_build_command(const LmVcpkgOptions *options, char *command, size_t size) {
    const char *discovered_root;
    char discovered_tool[1024];
    size_t used;

    discovered_root = NULL;

    if (options->vcpkg_tool[0] != '\0') {
        if (strlen(options->vcpkg_tool) >= sizeof(discovered_tool)) {
            fprintf(stderr, "vcpkgFetch.lm0: vcpkg path is too long\n");
            return 1;
        }
        strcpy(discovered_tool, options->vcpkg_tool);
    } else if (lm_vcpkg_discover_tool(discovered_tool, sizeof(discovered_tool), &discovered_root) != 0) {
        return 1;
    }

    used = 0U;
    command[0] = '\0';

#ifdef _WIN32
    if (lm_vcpkg_append(command, size, &used, "\"") != 0) {
        return 1;
    }
#endif

    if (lm_vcpkg_append_quoted(command, size, &used, discovered_tool, 0) != 0) {
        return 1;
    }
    if (lm_vcpkg_append_quoted(command, size, &used, "install", 1) != 0) {
        return 1;
    }
    if (lm_vcpkg_append_prefixed_arg(command, size, &used, "--x-manifest-root=", options->manifest_root) != 0) {
        return 1;
    }
    if (lm_vcpkg_append_prefixed_arg(command, size, &used, "--downloads-root=", options->output_dir) != 0) {
        return 1;
    }
    if (lm_vcpkg_append_prefixed_arg(command, size, &used, "--triplet=", options->triplet) != 0) {
        return 1;
    }
    if (lm_vcpkg_append_prefixed_arg(command, size, &used, "--host-triplet=", options->host_triplet) != 0) {
        return 1;
    }
    if (options->vcpkg_root[0] != '\0') {
        if (lm_vcpkg_append_prefixed_arg(command, size, &used, "--vcpkg-root=", options->vcpkg_root) != 0) {
            return 1;
        }
    } else if (discovered_root != NULL && discovered_root[0] != '\0') {
        if (lm_vcpkg_append_prefixed_arg(command, size, &used, "--vcpkg-root=", discovered_root) != 0) {
            return 1;
        }
    }
    if (options->dry_run && lm_vcpkg_append_quoted(command, size, &used, "--dry-run", 1) != 0) {
        return 1;
    }
    if (lm_vcpkg_append_quoted(command, size, &used, "--only-downloads", 1) != 0) {
        return 1;
    }
    if (lm_vcpkg_append_quoted(command, size, &used, "--no-print-usage", 1) != 0) {
        return 1;
    }

#ifdef _WIN32
    if (lm_vcpkg_append(command, size, &used, "\"") != 0) {
        return 1;
    }
#endif

    return 0;
}

int main(int argc, char **argv) {
    LmVcpkgOptions *options;
    char command[8192];
    int status;

    options = lm_vcpkg_options_new();
    if (options == NULL) {
        return 1;
    }

    status = lm_vcpkg_parse_options(argc, argv, options);
    if (status == 2) {
        lm_vcpkg_options_delete(options);
        return 0;
    }
    if (status != 0) {
        lm_vcpkg_options_delete(options);
        return 1;
    }

    if (lm_vcpkg_enter_project_root(argv[0]) != 0) {
        lm_vcpkg_options_delete(options);
        return 1;
    }

    if (lm_vcpkg_build_command(options, command, sizeof(command)) != 0) {
        lm_vcpkg_options_delete(options);
        return 1;
    }

    lm_vcpkg_options_delete(options);

    printf("%s\n", command);
    status = system(command);
    if (status != 0) {
        fprintf(stderr, "vcpkgFetch.lm0: command failed with status %d\n", status);
        return 1;
    }

    return 0;
}
