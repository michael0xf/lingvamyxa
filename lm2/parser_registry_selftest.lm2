fn: lm_p0_registry_selftest_expect_path (const: @(char path); size_t: index; const: @(char expected_key); const: @(char expected_value)) int
    const: LmTableCell: key_cell
    const: LmTableCell: payload_cell

    payload_cell: lm_p0_registry_source_path_cell_at(path, index, @ key_cell)
    if: payload_cell = 0 || key_cell = 0 || key_cell\value = 0 || payload_cell\value = 0
        return: 1
    if: c.strcmp(key_cell\value, expected_key) != 0 || c.strcmp(payload_cell\value, expected_value) != 0
        return: 1
return: 0

fn: lm_p0_registry_selftest_expect_lookup (const: @(char path); const: @(char key); const: @(char expected_value)) int
    LmP0Text: key_text
    const: @: char actual
    int: status

    key_text: lm_p0_text_from_cstr(key)
    if: key_text = 0
        return: 1
    actual: lm_p0_registry_lookup(key_text, path)
    status: actual = 0 || c.strcmp(actual, expected_value) != 0
    lm_p0_text_view_delete(key_text)
return: status

