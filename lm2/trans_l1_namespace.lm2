return: 0

fn: lm_trans_namespace_declare_generated (LmTransNamespace: namespace_; const: (LmP0Text: name); const: @(char kind)) int
    const: LmTransSymbol: existing
    LmTransSymbol: symbol

    if: namespace_ = 0 || name = 0
