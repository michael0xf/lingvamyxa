fn: lm_trans_namespace_materialize_registry_receiver_facade_rows (LmTransNamespace: namespace_; const: (LmOwnPtrStack: rows); const: @(char source_path)) int
    size_t: i
    LmTransRegistryFact: row
    const: @: char receiver_type

    if: rows = 0 || source_path = 0
        return: 0

    i: 0U
    while: i < rows\count
        row: (cast: (LmTransRegistryFact) lm_own_ptr_stack_at(rows, i))
        if: row != 0 && row\key != 0 && row\payload != 0
            if: c.strcmp(source_path, "namespace") = 0
                receiver_type: lm_trans_registry_source_n2_typed_value(namespace_, "namespace", "class", "class", "receiver.type", "class", row)
            else:
                receiver_type: lm_trans_registry_source_path_typed_value(namespace_, source_path, "class", "class", "class", row)
            if: lm_trans_namespace_declare_registry_receiver(namespace_, row\key, receiver_type) != 0
                return: 1
            ---
        ---
        i: i + 1U
return: 0

fn: lm_trans_namespace_materialize_registry_receiver_source_path (LmTransNamespace: namespace_; const: (LmOwnPtrStack: facade_rows); const: @(char source_path); int: materialize) int
    const: LmTableDescriptor: descriptor
    const: LmTableRow: source_row
    const: LmTableCell: key_cell
    const: LmTableCell: receiver_cell
    const: @: char receiver_type
    LmTransRegistryFact: facade_row
    LmTransRegistryFact: selected_facade_row
    @: int facade_matched
    size_t: descriptor_count
    size_t: descriptor_index
    size_t: source_path_length
    size_t: column_count
    size_t: column_index
    size_t: row_count
    size_t: row_index
    size_t: facade_index

    if: namespace_ = 0 || namespace_\registry_view = 0 || source_path = 0
        return: 1

    facade_matched: 0
    finally: lm_own_delete(facade_matched, 0)
    if: facade_rows != 0 && facade_rows\count != 0U
        facade_matched: (cast: (@: int) lm_own_new_zero(facade_rows\count * c.sizeof(facade_matched[0])))
        if: facade_matched = 0
            return: 1
        ---
    ---

    source_path_length: c.strlen(source_path)
    descriptor_count: lm_registry_view_source_table_count(namespace_\registry_view)
    descriptor_index: 0U
    while: descriptor_index < descriptor_count
        descriptor: lm_registry_view_source_table_at(namespace_\registry_view, descriptor_index)
        column_count: lm_table_descriptor_column_count(descriptor)
        row_count: lm_table_descriptor_materialized_row_count(descriptor)
        row_index: 0U
        while: row_index < row_count
            source_row: lm_table_descriptor_materialized_row_at(descriptor, row_index)
            key_cell: lm_table_row_cell_at(source_row, 0U)
            column_index: 1U
            while: column_index < column_count
                if: lm_table_descriptor_source_path_column_matches(descriptor, column_index, source_path, source_path_length) != 0
                    receiver_cell: lm_table_row_cell_at(source_row, column_index)
                    if: key_cell != 0 && key_cell\value != 0 && receiver_cell != 0 && receiver_cell\value != 0
                        facade_row: 0
                        facade_index: 0U
                        while: facade_rows != 0 && facade_index < facade_rows\count
                            facade_row: (cast: (LmTransRegistryFact) lm_own_ptr_stack_at(facade_rows, facade_index))
                            if: facade_matched[facade_index] = 0 && facade_row != 0 && facade_row\key != 0 && facade_row\payload != 0 && c.strcmp(key_cell\value, facade_row\key) = 0 && c.strcmp(receiver_cell\value, facade_row\payload) = 0
                                facade_matched[facade_index]: 1
                                break
                            facade_row: 0
                            facade_index: facade_index + 1U
                        ---
                        if: facade_row = 0
                            lm_trans_registry_view_parity_fail("namespace source row multiset", source_path)
                            return: 1
                        if: materialize
                            selected_facade_row: 0
                            facade_index: 0U
                            while: facade_rows != 0 && facade_index < facade_rows\count
                                selected_facade_row: (cast: (LmTransRegistryFact) lm_own_ptr_stack_at(facade_rows, facade_index))
                                if: selected_facade_row != 0 && selected_facade_row\key != 0 && selected_facade_row\payload != 0 && c.strcmp(key_cell\value, selected_facade_row\key) = 0
                                    break
                                selected_facade_row: 0
                                facade_index: facade_index + 1U
                            ---
                            if: c.strcmp(source_path, "namespace") = 0
                                receiver_type: lm_trans_registry_source_n2_typed_value(namespace_, "namespace", "class", "class", "receiver.type", "class", selected_facade_row)
                            else:
                                receiver_type: lm_trans_registry_source_path_typed_value(namespace_, source_path, "class", "class", "class", selected_facade_row)
                            if: lm_trans_namespace_declare_registry_receiver(namespace_, key_cell\value, receiver_type) != 0
                                return: 1
                    ---
                ---
                column_index: column_index + 1U
            row_index: row_index + 1U
        descriptor_index: descriptor_index + 1U

    facade_index: 0U
    while: facade_rows != 0 && facade_index < facade_rows\count
        facade_row: (cast: (LmTransRegistryFact) lm_own_ptr_stack_at(facade_rows, facade_index))
        if: facade_matched[facade_index] = 0 && facade_row != 0 && facade_row\key != 0 && facade_row\payload != 0
            lm_trans_registry_view_parity_fail("namespace source row multiset", source_path)
            return: 1
        facade_index: facade_index + 1U
    ---
return: 0

fn: lm_trans_namespace_materialize_class_relation_stack (LmTransNamespace: namespace_; const: (LmP0Text: owner); const: @(char relation_name)) const: LmOwnPtrStack
    @: char relation_path
    size_t: relation_path_length
    const: LmOwnPtrStack: rows

    if: owner = 0 || owner\data = 0 || relation_name = 0
        return: 0

    rows: lm_trans_namespace_registry_relation_stack(namespace_, owner, relation_name)
    if: rows != 0
        return: rows

    relation_path: lm_trans_registry_source_relation_path_new(owner\data, relation_name, @ relation_path_length)
    if: relation_path = 0
        return: 0
    rows: lm_trans_registry_relation_stack_for_table(relation_path)
    lm_own_delete(relation_path, 0)
return: rows

fn: lm_trans_namespace_relation_name_is_class_metadata (const: @(char relation_name)) int
    if: relation_name = 0
        return: 0
return: c.strncmp(relation_name, "class.", 6) = 0

fn: lm_trans_namespace_materialize_class_descriptor_relations (
    const: LmTransNamespace: namespace_
    const: (LmP0Text: class_name)
    LmTransDescriptor: descriptor
) int
    LmTransIdentifierTable: identifiers
    LmTransIdentifierCard: class_card
    LmTransIdentifierRelation: relation
    const: LmOwnPtrStack: rows
    const: LmTransRegistryFact: latest_row
    size_t: relation_bucket_index

    if: namespace_ = 0 || class_name = 0 || class_name\data = 0 || descriptor = 0
        return: 1
    if: descriptor\class_relations = 0
        descriptor\class_relations: lm_trans_ptr_stack_new(lm_trans_descriptor_relation_delete_any)
        if: descriptor\class_relations = 0
            return: 1

    identifiers: namespace_\registry_identifiers
    class_card: 0
    if: identifiers != 0
        class_card: lm_trans_identifier_table_find_card(identifiers, class_name)
    if: class_card = 0 && c.lm_trans_registry != 0 && c.lm_trans_registry\identifiers != 0 && c.lm_trans_registry->identifiers != identifiers
        class_card: lm_trans_identifier_table_find_card(c.lm_trans_registry->identifiers, class_name)

    if: class_card = 0
        return: 0

    relation_bucket_index: 0U
    while: relation_bucket_index < class_card\relation_bucket_count
        relation: class_card\relation_buckets[relation_bucket_index]
        while: relation != 0
            if: lm_trans_namespace_relation_name_is_class_metadata(relation\name) != 0
                rows: lm_trans_namespace_materialize_class_relation_stack(namespace_, class_name, relation\name)
                if: rows != 0
                    latest_row: lm_trans_registry_relation_stack_latest_row(rows, class_name)
                    if: latest_row != 0 && latest_row\payload != 0
                        if: lm_trans_descriptor_set_class_relation(descriptor, relation\name, latest_row\payload) != 0
                            return: 1
            relation: relation\next
        relation_bucket_index: relation_bucket_index + 1U
    return: 0

fn: lm_trans_namespace_materialize_class_typed_relation_value (
    const: (LmTransNamespace: namespace_)
    const: (LmP0Text: owner)
    const: @(char relation_name)
    const: @(char n2_value_column_name)
    const: @(char value_descriptor)
    const: (LmTransRegistryFact: facade_row)
) const: @: char
    @: char relation_path
    size_t: relation_path_length
    @: char value

    if: owner = 0 || owner\data = 0 || relation_name = 0 || n2_value_column_name = 0 || value_descriptor = 0
        return: 0

    value: 0
    if: facade_row != 0 && facade_row\payload != 0
        value: facade_row\payload

    relation_path: lm_trans_registry_source_relation_path_new(owner\data, relation_name, @ relation_path_length)
    if: relation_path = 0
        return: value
    value: lm_trans_namespace_registry_source_path_n2_named_typed_value(namespace_, owner, relation_path, "class", "class", n2_value_column_name, value_descriptor)
    lm_own_delete(relation_path, 0)
return: value

fn: lm_trans_namespace_materialize_class_descriptor_add_field (
    const: (LmTransNamespace: namespace_)
    const: (LmP0Text: class_name)
    (LmTransDescriptor: descriptor)
    const: (LmP0Text: field_name)
    (LmTransRegistryFact: field_row)
    (LmOwnPtrStack: index_rows)
    (LmOwnPtrStack: address_depth_rows)
    (LmOwnPtrStack: const_rows)
    (LmOwnPtrStack: array_count_rows)
    const: @(char type_relation_name)
    const: @(char type_n2_column_name)
    int: is_union
) int
    const: @(char type_payload)
    const: @(char index_payload)
    const: @(char address_depth_payload)
    const: @(char const_payload)
    const: @(char array_count_payload)
    LmP0Text: type_name
    LmTransRegistryFact: index_row
    LmTransRegistryFact: address_depth_row
    LmTransRegistryFact: const_row
    LmTransRegistryFact: array_count_row
    size_t: field_index
    size_t: field_address_depth
    size_t: field_array_count
    int: field_is_const
    int: has_array_count

    if: class_name = 0 || descriptor = 0 || field_name = 0 || field_row = 0
        return: 1

    if: field_name\length = 0U || field_row\key = 0 || field_row\payload = 0
        return: 1

    type_payload: lm_trans_namespace_materialize_class_typed_relation_value(namespace_, class_name, type_relation_name, type_n2_column_name, "class", field_row)
    if: type_payload = 0
        return: 1
    type_name: lm_trans_text_from_cstr(type_payload)
    if: type_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ type_name)

    index_row: lm_trans_registry_relation_stack_latest_row(index_rows, field_name)
    address_depth_row: lm_trans_registry_relation_stack_latest_row(address_depth_rows, field_name)
    const_row: lm_trans_registry_relation_stack_latest_row(const_rows, field_name)
    array_count_row: lm_trans_registry_relation_stack_latest_row(array_count_rows, field_name)

    index_payload: lm_trans_namespace_materialize_class_typed_relation_value(namespace_, class_name, "field.index", "index", "size_t", index_row)
    if: index_payload = 0 || lm_trans_parse_size_payload(index_payload, @ field_index) = 0
        c.fprintf(c.stderr, "trans L2 struct descriptor error: class %.*s.%.*s requires field.index\n", (cast: int class_name\length), class_name\data, (cast: int field_name\length), field_name\data)
        return: 1

    field_address_depth: 0U
    field_array_count: 0U
    has_array_count: 0
    field_is_const: 0

    address_depth_payload: lm_trans_namespace_materialize_class_typed_relation_value(namespace_, class_name, "field.address-depth", "depth", "size_t", address_depth_row)
    if: address_depth_payload != 0 && lm_trans_parse_size_payload(address_depth_payload, @ field_address_depth) = 0
            c.fprintf(c.stderr, "trans L2 struct descriptor error: class %.*s.%.*s has invalid field.address-depth\n", (cast: int class_name\length), class_name\data, (cast: int field_name\length), field_name\data)
            return: 1

    const_payload: lm_trans_namespace_materialize_class_typed_relation_value(namespace_, class_name, "field.const", "value", "int", const_row)
    if: const_payload != 0
        if: lm_trans_parse_size_payload(const_payload, @ field_address_depth) = 0
            c.fprintf(c.stderr, "trans L2 struct descriptor error: class %.*s.%.*s has invalid field.const\n", (cast: int class_name\length), class_name\data, (cast: int field_name\length), field_name\data)
            return: 1
        field_is_const: field_address_depth != 0U

    array_count_payload: lm_trans_namespace_materialize_class_typed_relation_value(namespace_, class_name, "field.array-count", "count", "size_t", array_count_row)
    if: array_count_payload != 0
        if: lm_trans_parse_size_payload(array_count_payload, @ field_array_count) = 0
            c.fprintf(c.stderr, "trans L2 struct descriptor error: class %.*s.%.*s has invalid field.array-count\n", (cast: int class_name\length), class_name\data, (cast: int field_name\length), field_name\data)
            return: 1
        has_array_count: 1

    if: lm_trans_descriptor_add_structural_field(descriptor, field_name, type_name, field_index, field_address_depth, field_array_count, has_array_count, field_is_const, is_union) != 0
        return: 1
return: 0

fn: lm_trans_namespace_materialize_class_descriptors (LmTransNamespace: namespace_) int
    const: @(char class_present_table)
    const: LmP0Text: class_present_text
    LmOwnPtrStack: class_rows
    LmOwnPtrStack: class_rows_fields
    LmOwnPtrStack: union_rows_fields
    LmOwnPtrStack: index_rows
    LmOwnPtrStack: address_depth_rows
    LmOwnPtrStack: const_rows
    LmOwnPtrStack: array_count_rows
    LmOwnPtrStack: processed_classes
    LmOwnPtrStack: seen_fields
    size_t: class_index
    size_t: field_index
    LmTransRegistryFact: class_row
    LmTransRegistryFact: field_row
    @(char class_key)
    @(char seen_name)
    @(char seen_name_owner)
    LmP0Text: class_name
    LmP0Text: field_name
    LmTransDescriptor: descriptor
    int: descriptor_is_new

    class_present_table: "class.present"
    class_present_text: lm_trans_text_from_cstr(class_present_table)
    if: class_present_text = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ class_present_text)

    class_rows: lm_trans_namespace_registry_relation_stack(namespace_, class_present_text, "row")
    if: class_rows = 0
        class_rows: lm_trans_registry_relation_stack_for_table(class_present_table)
    if: class_rows = 0
        return: 0

    processed_classes: lm_trans_ptr_stack_new(c.lm_own_delete_plain)
    if: processed_classes = 0
        return: 1
    finally: lm_trans_ptr_stack_delete(@ processed_classes)

    class_index: 0U
    while: class_index < class_rows\count
        class_row: (cast: (LmTransRegistryFact) lm_own_ptr_stack_at(class_rows, class_index))
        if: class_row = 0 || class_row\key = 0 || class_row\payload = 0
            class_index: class_index + 1U
            continue
        class_key: class_row\key
        class_name: lm_trans_text_from_cstr(class_key)
        if: class_name = 0
            return: 1
        finally: lm_trans_text_ref_destroy(@ class_name)
        if: lm_trans_is_c_reference_name(class_name) != 0
            class_index: class_index + 1U
            continue

        seen_name: lm_trans_text_copy_cstr(class_name)
        if: seen_name = 0
            return: 1
        if: lm_trans_string_stack_has(processed_classes, seen_name) != 0
            lm_own_delete(seen_name, 0)
            class_index: class_index + 1U
            continue
        if: lm_own_ptr_stack_push(processed_classes, seen_name) != 0
            lm_own_delete(seen_name, 0)
            return: 1

        if: lm_trans_namespace_find(namespace_, class_name) = 0 && lm_trans_namespace_declare(namespace_, class_name, "class") != 0
            return: 1

        if: lm_trans_namespace_find(namespace_, class_name) = 0
            return: 1

        class_rows_fields: lm_trans_namespace_materialize_class_relation_stack(namespace_, class_name, "field.class")
        union_rows_fields: lm_trans_namespace_materialize_class_relation_stack(namespace_, class_name, "field.union")
        index_rows: lm_trans_namespace_materialize_class_relation_stack(namespace_, class_name, "field.index")
        address_depth_rows: lm_trans_namespace_materialize_class_relation_stack(namespace_, class_name, "field.address-depth")
        const_rows: lm_trans_namespace_materialize_class_relation_stack(namespace_, class_name, "field.const")
        array_count_rows: lm_trans_namespace_materialize_class_relation_stack(namespace_, class_name, "field.array-count")

        descriptor: lm_trans_namespace_descriptor(namespace_, class_name)
        descriptor_is_new: 0
        if: descriptor = 0
            descriptor: lm_trans_descriptor_new()
            if: descriptor = 0 || lm_trans_descriptor_mark_structural_fields(descriptor) != 0
                return: 1
            descriptor_is_new: 1
            finally: if: descriptor_is_new != 0
                        lm_trans_descriptor_delete(descriptor)

        if: lm_trans_namespace_materialize_class_descriptor_relations(namespace_, class_name, descriptor) != 0
            return: 1

        if: descriptor\has_structural_fields != 0 && descriptor\structural_fields != 0
            seen_fields: lm_trans_ptr_stack_new(c.lm_own_delete_plain)
            if: seen_fields = 0
                return: 1
            finally: lm_trans_ptr_stack_delete(@ seen_fields)

            if: class_rows_fields != 0
                field_index: 0U
                while: field_index < class_rows_fields\count
                    field_row: (cast: (LmTransRegistryFact) lm_own_ptr_stack_at(class_rows_fields, field_index))
                    if: field_row != 0 && field_row\key != 0 && field_row\payload != 0
                        field_name: lm_trans_text_from_cstr(field_row\key)
                        if: field_name = 0
                            return: 1
                        finally: lm_trans_text_ref_destroy(@ field_name)

                        seen_name_owner: lm_trans_text_copy_cstr(field_name)
                        if: seen_name_owner = 0
                            return: 1
                        if: lm_trans_string_stack_has(seen_fields, seen_name_owner) != 0
                            lm_own_delete(seen_name_owner, 0)
                        else:
                            if: lm_own_ptr_stack_push(seen_fields, seen_name_owner) != 0
                                lm_own_delete(seen_name_owner, 0)
                                return: 1
                            if: lm_trans_namespace_materialize_class_descriptor_add_field(namespace_, class_name, descriptor, field_name, field_row, index_rows, address_depth_rows, const_rows, array_count_rows, "field.class", "field", 0) != 0
                                return: 1
                    ---
                    field_index: field_index + 1U
                ---

            if: union_rows_fields != 0
                field_index: 0U
                while: field_index < union_rows_fields\count
                    field_row: (cast: (LmTransRegistryFact) lm_own_ptr_stack_at(union_rows_fields, field_index))
                    if: field_row != 0 && field_row\key != 0 && field_row\payload != 0
                        field_name: lm_trans_text_from_cstr(field_row\key)
                        if: field_name = 0
                            return: 1
                        finally: lm_trans_text_ref_destroy(@ field_name)

                        seen_name_owner: lm_trans_text_copy_cstr(field_name)
                        if: seen_name_owner = 0
                            return: 1
                        if: lm_trans_string_stack_has(seen_fields, seen_name_owner) != 0
                            lm_own_delete(seen_name_owner, 0)
                        else:
                            if: lm_own_ptr_stack_push(seen_fields, seen_name_owner) != 0
                                lm_own_delete(seen_name_owner, 0)
                                return: 1
                            if: lm_trans_namespace_materialize_class_descriptor_add_field(namespace_, class_name, descriptor, field_name, field_row, index_rows, address_depth_rows, const_rows, array_count_rows, "field.union", "union", 1) != 0
                                return: 1
                ---
                field_index: field_index + 1U
            ---

        if: descriptor_is_new != 0
            if: lm_trans_namespace_attach_descriptor(namespace_, class_name, descriptor) != 0
                return: 1
            descriptor: 0

        class_index: class_index + 1U
    ---
return: 0

fn: lm_trans_namespace_materialize_registry_receivers (LmTransNamespace: namespace_) int
    LmP0Text: table_name
    const: LmOwnPtrStack: direct_rows
    const: LmOwnPtrStack: wide_rows
    int: private_registry

    if: namespace_ = 0
        return: 1

    table_name: lm_trans_text_from_cstr("namespace")
    if: table_name = 0
        return: 1
    finally: lm_trans_text_ref_destroy(@ table_name)

    direct_rows: lm_trans_namespace_registry_relation_stack(namespace_, table_name, "row")
    wide_rows: lm_trans_namespace_registry_relation_stack(namespace_, table_name, "receiver.type")
    if: direct_rows = 0 && wide_rows = 0
        return: 0
    private_registry: namespace_\registry_identifiers != 0 && (c.lm_trans_registry = 0 || namespace_\registry_identifiers != c.lm_trans_registry->identifiers)
    if: private_registry = 0 && lm_trans_registry_view_parity_enabled() != 0
        if: lm_trans_namespace_materialize_registry_receiver_source_path(namespace_, direct_rows, "namespace", lm_trans_registry_view_is_selected()) != 0
            return: 1
        if: lm_trans_namespace_materialize_registry_receiver_source_path(namespace_, wide_rows, "namespace.receiver.type", lm_trans_registry_view_is_selected()) != 0
            return: 1
        if: lm_trans_registry_view_is_selected() != 0
            return: lm_trans_namespace_declare_visible_symbol_if_missing(namespace_, "@", "receiver.statement")
    ---
    if: lm_trans_namespace_materialize_registry_receiver_facade_rows(namespace_, direct_rows, "namespace") != 0
        return: 1
    if: lm_trans_namespace_materialize_registry_receiver_facade_rows(namespace_, wide_rows, "namespace.receiver.type") != 0
        return: 1
return: lm_trans_namespace_declare_visible_symbol_if_missing(namespace_, "@", "receiver.statement")

fn: lm_trans_namespace_materialize_registry_heads (LmTransNamespace: namespace_) int
    if: lm_trans_namespace_materialize_class_descriptors(namespace_) != 0
        return: 1

    return: lm_trans_namespace_materialize_registry_receivers(namespace_)

fn: lm_trans_namespace_attach_registry (LmTransNamespace: namespace_) int
    if: namespace_ = 0 || lm_trans_registry = 0 || lm_trans_registry\view = 0
        return: 1
    namespace_\registry_identifiers: lm_trans_registry\identifiers
    namespace_\registry_view: lm_trans_registry\view
return: lm_trans_namespace_materialize_registry_heads(namespace_)

fn: lm_trans_namespace_declare_c_name (LmTransNamespace: namespace_; const: (LmP0Text: name); const: @(char kind); const: (LmP0Text: c_name)) int
return: lm_trans_namespace_declare_with_c_name(namespace_, name, kind, c_name)

fn: lm_trans_namespace_declare_relation_text (LmTransNamespace: namespace_; const: (LmP0Text: name); const: @(char relation_name); const: (LmP0Text: payload)) int
    LmTransSymbol: symbol

    if: namespace_ = 0 || name = 0 || relation_name = 0 || payload = 0
        return: 1

    symbol: lm_trans_symbol_new(name, relation_name, namespace_\depth)
    if: symbol = 0
        return: 1
    if: lm_trans_symbol_set_c_name(symbol, payload) != 0
        lm_trans_symbol_destroy(symbol)
        return: 1
    if: namespace_\items = 0 || lm_own_ptr_stack_push(namespace_\items, symbol) != 0
        lm_trans_symbol_destroy(symbol)
        return: 1
    if: lm_trans_identifier_table_add_relation_symbol(namespace_\identifiers, symbol) != 0
        symbol: lm_own_ptr_stack_pop(namespace_\items)
        lm_trans_symbol_destroy(symbol)
        return: 1
return: 0

fn: lm_trans_namespace_set_env_arg (LmTransNamespace: namespace_; const: (LmP0Text: name); const: (LmP0Text: env_arg)) int
    LmTransSymbol: symbol

    symbol: lm_trans_namespace_find_mutable(namespace_, name)
    if: symbol = 0
        return: 1
return: lm_trans_symbol_set_env_arg(symbol, env_arg)

fn: lm_trans_namespace_set_closure_call_name (LmTransNamespace: namespace_; const: (LmP0Text: name); const: (LmP0Text: closure_call_name)) int
    LmTransSymbol: symbol

    symbol: lm_trans_namespace_find_mutable(namespace_, name)
    if: symbol = 0
        return: 1
return: lm_trans_symbol_set_closure_call_name(symbol, closure_call_name)

fn: lm_trans_symbol_copy_signature (LmTransSymbol: target; const: (LmTransSymbol: source)) int
    size_t: i
    const: LmP0Text: source_name
    LmP0Text: copy

    if: target = 0 || source = 0
        return: 1

    if: target\param_names = 0
        target\param_names: lm_trans_ptr_stack_new(lm_trans_text_ref_delete_any)
        if: target\param_names = 0
            return: 1
        ---
    else:
        lm_own_ptr_stack_destroy(target\param_names)
        lm_own_ptr_stack_init(target\param_names, lm_trans_text_ref_delete_any)
    if: source\param_names = 0
        return: 0
    i: 0U
    while: i < source\param_names\count
        source_name: lm_own_ptr_stack_at(source\param_names, i)
        if: source_name = 0
            return: 1
        copy: lm_trans_text_ref_new(source_name)
        if: copy = 0
            return: 1
        if: lm_own_ptr_stack_push(target\param_names, copy) != 0
            lm_trans_text_ref_delete_any(copy)
            return: 1
        i: i + 1U
    ---
    target\has_signature: source\has_signature
    target\callable_params_node: source\callable_params_node
    target\callable_return_node: source\callable_return_node
    target\has_callable_shape: source\has_callable_shape
    target\callable_returns_value: source\callable_returns_value
    target\callable_is_struct_return: source\callable_is_struct_return
    target\callable_is_external: source\callable_is_external
    target\callable_has_thread_context: source\callable_has_thread_context
    target\callable_is_thread_handler: source\callable_is_thread_handler
return: 0

fn: lm_trans_namespace_declare_compatible (LmTransNamespace: namespace_; const: (LmP0Text: name); const: @(char kind)) int
    const: LmTransSymbol: existing

    existing: lm_trans_namespace_find(namespace_, name)
    if: existing != 0
        if: lm_trans_symbol_is(existing, kind)
            return: 0
    ---

return: lm_trans_namespace_declare(namespace_, name, kind)

fn: lm_trans_class_c_projection (const: (LmP0Text: name)) const: @: char
    if: name = 0
        return: 0
return: lm_trans_namespace_registry_source_path_n2_named_typed_value(0, name, "class.c.projection", "class", "class", "spelling", "char")

fn: lm_trans_class_c_spelling (const: (LmP0Text: name)) const: @: char
    const: @: char spelling

    if: name = 0
        return: 0
    spelling: lm_trans_class_c_projection(name)
    if: spelling != 0
        return: spelling
return: lm_trans_namespace_registry_source_path_n2_named_typed_value(0, name, "class.spelling", "class", "class", "spelling", "char")

fn: lm_trans_class_c_tail_value (const: (LmP0Text: name)) const: @: char
    if: name = 0
        return: 0
return: lm_trans_namespace_registry_source_path_n2_named_typed_value(0, name, "class.cTail", "class", "class", "spelling", "char")

fn: lm_trans_class_is_reference_base (const: (LmP0Text: name)) int
return: lm_trans_namespace_class_is_reference_base(0, name)

fn: lm_trans_builtin_c_type_tail (const: (LmP0Text: name)) int
    if: name = 0
        return: 0
    if: lm_trans_class_is_reference_base(name)
        return: 0
return: lm_trans_class_c_spelling(name) != 0 || lm_trans_class_c_tail_value(name) != 0

fn: lm_trans_builtin_c_type_name (const: (LmP0Text: name)) int
    LmP0Text: tail
    int: result

    if: name = 0
        return: 0
    if: lm_trans_text_starts_with(name, "c.") && name\length > 2U
        tail: lm_trans_text_ref_tail_new(name, 2U)
        if: tail = 0
            return: 0
        result: lm_trans_builtin_c_type_tail(tail)
        lm_trans_text_ref_destroy(@ tail)
        return: result

return: lm_trans_builtin_c_type_tail(name)

fn: lm_trans_emit_name (FILE: file; const: (LmP0Text: name)) int
    const: @: char spelling
    LmP0Text: tail
    int: status

    if: name = 0
        return: 1
    if: lm_trans_text_starts_with(name, "c.")
        tail: lm_trans_text_ref_tail_new(name, 2U)
        if: tail = 0
            return: 1
        spelling: lm_trans_class_c_spelling(tail)
        if: spelling != 0
            status: lm_trans_put(file, spelling)
            lm_trans_text_ref_destroy(@ tail)
            return: status
        status: lm_trans_write_text(file, tail)
        lm_trans_text_ref_destroy(@ tail)
        return: status

return: lm_trans_emit_identifier(file, name)

fn: lm_trans_emit_type_name (FILE: file; const: (LmP0Text: name)) int
    const: @: char spelling
    LmP0Text: tail
    int: status

    if: name = 0
        return: 1
    if: lm_trans_text_starts_with(name, "c.") && name\length > 2U
        tail: lm_trans_text_ref_tail_new(name, 2U)
        if: tail = 0
            return: 1
        spelling: lm_trans_class_c_spelling(tail)
        if: spelling != 0
            status: lm_trans_put(file, spelling)
            lm_trans_text_ref_destroy(@ tail)
            return: status
        status: lm_trans_write_text(file, tail)
        lm_trans_text_ref_destroy(@ tail)
        return: status

    spelling: lm_trans_class_c_spelling(name)
    if: spelling != 0
        return: lm_trans_put(file, spelling)
return: lm_trans_emit_identifier(file, name)

fn: lm_trans_c_reference_has_path_dot (const: (LmP0Text: name)) int
    size_t: i

    if: lm_trans_is_c_reference_name(name) = 0
        return: 0

    i: 2U
    while: i < name\length
        if: name\data[i] = '.'
            return: 1
        i: i + 1U

return: 0

fn: lm_trans_node_is_c_reference_atom (const: (LmP0Node: node)) int
return: node != 0 && node\kind = c.LM_P0_NODE_ATOM && lm_trans_is_c_reference_name(node\as\atom)
