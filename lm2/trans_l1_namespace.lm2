fn: lm_trans_text_ref_new (const: @(LmP0Text text)) @: LmP0Text
    @: LmP0Text copy

    copy: lm_own_new_zero(c.sizeof(copy[0]))
    if: copy != 0 && text != 0
        copy[0]: text[0]
return: copy

fn: lm_trans_text_ref_new_cstr (const: @(char text)) @: LmP0Text
    @: LmP0Text copy

    copy: lm_own_new_zero(c.sizeof(copy[0]))
    if: copy != 0 && text != 0
        copy\data: text
        copy\length: c.strlen(text)
return: copy

fn: lm_trans_text_ref_tail_new (const: @(LmP0Text text); size_t: offset) @: LmP0Text
    @: LmP0Text tail

    if: text = 0 || offset > text\length
        return: 0

    tail: lm_own_new_zero(c.sizeof(tail[0]))
    if: tail != 0
        tail\data: text\data + offset
        tail\length: text\length - offset
return: tail

sub: lm_trans_text_ref_destroy (@@(LmP0Text text))
    if: text != 0 && text[0] != 0
        lm_own_delete(text[0], 0)
        text[0]: 0
end: lm_trans_text_ref_destroy

sub: lm_trans_text_ref_delete_any (@: void object)
    lm_own_delete(object, 0)
end: lm_trans_text_ref_delete_any

fn: lm_trans_function_header_init_fields (@: LmTransFunctionHeader function) int
    if: function = 0
        return: 1
    if: function\name = 0
        function\name: lm_trans_text_ref_new_cstr("")
    if: function\c_name = 0
        function\c_name: lm_trans_text_ref_new_cstr("")
    if: function\env_type_name = 0
        function\env_type_name: lm_trans_text_ref_new_cstr("")
return: function\name = 0 || function\c_name = 0 || function\env_type_name = 0

fn: lm_trans_function_header_new () @: LmTransFunctionHeader
    @: LmTransFunctionHeader function

    function: lm_own_new_zero(c.sizeof(function[0]))
    if: function != 0 && lm_trans_function_header_init_fields(function) != 0
        lm_trans_text_ref_destroy(@ function\name)
        lm_trans_text_ref_destroy(@ function\c_name)
        lm_trans_text_ref_destroy(@ function\env_type_name)
        lm_own_delete(function, 0)
        return: 0
return: function

sub: lm_trans_function_header_destroy_fields (@: LmTransFunctionHeader function)
    if: function != 0
        lm_trans_text_ref_destroy(@ function\name)
        lm_trans_text_ref_destroy(@ function\c_name)
        lm_trans_text_ref_destroy(@ function\env_type_name)
end: lm_trans_function_header_destroy_fields

sub: lm_trans_function_header_destroy (@: LmTransFunctionHeader function)
    lm_trans_function_header_destroy_fields(function)
    lm_own_delete(function, 0)
end: lm_trans_function_header_destroy

fn: lm_trans_function_header_copy (@: LmTransFunctionHeader target; const: @(LmTransFunctionHeader source)) int
    @: LmP0Text name
    @: LmP0Text c_name
    @: LmP0Text env_type_name

    if: target = 0 || source = 0 || lm_trans_function_header_init_fields(target) != 0
        return: 1

    name: target\name
    c_name: target\c_name
    env_type_name: target\env_type_name
    target[0]: source[0]
    target\name: name
    target\c_name: c_name
    target\env_type_name: env_type_name
    if: source\name != 0
        target\name[0]: source\name[0]
    else:
        target\name\data: ""
        target\name\length: 0U
    if: source\c_name != 0
        target\c_name[0]: source\c_name[0]
    else:
        target\c_name\data: ""
        target\c_name\length: 0U
    if: source\env_type_name != 0
        target\env_type_name[0]: source\env_type_name[0]
    else:
        target\env_type_name\data: ""
        target\env_type_name\length: 0U
return: 0

fn: lm_trans_ptr_stack_new (LmOwnDelete: delete_item) @: LmOwnPtrStack
    @: LmOwnPtrStack stack

    stack: lm_own_new_zero(c.sizeof(stack[0]))
    if: stack != 0
        lm_own_ptr_stack_init(stack, delete_item)
return: stack

sub: lm_trans_ptr_stack_delete (@@(LmOwnPtrStack stack))
    if: stack != 0 && stack[0] != 0
        lm_own_ptr_stack_destroy(stack[0])
        lm_own_delete(stack[0], 0)
        stack[0]: 0
end: lm_trans_ptr_stack_delete

fn: lm_trans_function_state_new () @: LmTransFunctionState
return: lm_own_new_zero(c.sizeof(c.LmTransFunctionState))

sub: lm_trans_function_state_destroy (@: LmTransFunctionState state)
    if: state != 0
        lm_trans_text_ref_destroy(@ state\current_return_type_name)
        if: state\has_previous_control_stacks
            lm_trans_ptr_stack_delete(@ state\previous_cleanups)
            lm_trans_ptr_stack_delete(@ state\previous_loops)
            state\has_previous_control_stacks: 0
end: lm_trans_function_state_destroy

sub: lm_trans_function_state_destroy_any (@: void object)
    lm_trans_function_state_destroy(cast: (@: LmTransFunctionState) object)
end: lm_trans_function_state_destroy_any

sub: lm_trans_function_state_delete (@: LmTransFunctionState state)
    lm_own_delete(state, lm_trans_function_state_destroy_any)
end: lm_trans_function_state_delete

fn: lm_trans_registry_has_expr_emitter_binding (const: @(LmP0Text key); const: @(char table)) int
    const: @: char binding
    @: LmTransBinding resolved
    const: @: char table_name

    if: key = 0
        return: 0

    binding: lm_trans_registry_lookup(key, table)
    if: binding = 0
        return: 0
    resolved: lm_own_new_zero(c.sizeof(resolved[0]))
    if: resolved = 0
        c.exit(2)
    if: lm_trans_binding_resolve(binding, resolved) = 0 || resolved\expr_emit = 0 || resolved\expr_state = 0
        table_name: table
        if: table_name = 0
            table_name: "<none>"
        c.fprintf(c.stderr, "trans registry inconsistency: %s[\"%.*s\"] has unknown expression emitter binding %s\n", table_name, (cast: int key\length), key\data, binding)
        lm_own_delete(resolved, 0)
        c.exit(2)
    lm_own_delete(resolved, 0)
return: 1

fn: lm_trans_expr_emitter_binding_table (const: @(char class_name)) const: @: char
    @: LmP0Text class_text
    const: @: char table

    class_text: lm_trans_text_ref_new_cstr(class_name)
    if: class_text = 0
        c.exit(2)
    table: lm_trans_registry_lookup(class_text, "expr_emitter_binding")
    if: table != 0 && lm_trans_registry_assert_payload_table_exists("expr_emitter_binding", class_text, table) != 0
        lm_trans_text_ref_destroy(@ class_text)
        c.exit(2)
    lm_trans_text_ref_destroy(@ class_text)
return: table

fn: lm_trans_expr_spelling_binding_table (const: @(char class_name)) const: @: char
    @: LmP0Text class_text
    const: @: char table

    class_text: lm_trans_text_ref_new_cstr(class_name)
    if: class_text = 0
        c.exit(2)
    table: lm_trans_registry_lookup(class_text, "expr_spelling_binding")
    if: table != 0 && lm_trans_registry_assert_payload_table_exists("expr_spelling_binding", class_text, table) != 0
        lm_trans_text_ref_destroy(@ class_text)
        c.exit(2)
    lm_trans_text_ref_destroy(@ class_text)
    if: table != 0
        return: table
return: class_name

fn: lm_trans_registry_has_expr_emitter_class (const: @(LmP0Text key); const: @(char class_name)) int
    const: @: char table

    table: lm_trans_expr_emitter_binding_table(class_name)
return: table != 0 && lm_trans_registry_has_expr_emitter_binding(key, table)

fn: lm_trans_registry_has_expr_emitter_binding_class (const: @(LmP0Text key); const: @(char class_name)) int
return: lm_trans_registry_has_expr_emitter_class(key, class_name)

fn: lm_trans_registry_has_any_expr_emitter_binding (const: @(LmP0Text key)) int
    size_t: i
    @: LmTransRegistryFact row
    const: @: LmOwnPtrStack rows

    rows: lm_trans_registry_relation_stack(lm_trans_text_from_cstr("expr_emitter_binding"), "row")
    if: rows = 0
        return: 0

    i: 0U
    while: i < rows\count
        row: lm_own_ptr_stack_at(rows, i)
        if: row != 0 && row\payload != 0 && row\key != 0
            if: lm_trans_registry_assert_payload_table_exists("expr_emitter_binding", lm_trans_text_from_cstr(row\key), row\payload) != 0
                c.exit(2)
            if: lm_trans_registry_has_expr_emitter_binding(key, row\payload)
                return: 1
            ---
        i: i + 1U
return: 0

fn: lm_trans_text_is_operator_atom (const: @(LmP0Text text)) int
return: lm_trans_registry_has_any_expr_emitter_binding(text)

fn: lm_trans_copy_stream (@: FILE target; @: FILE source) int
    [4096]: char buffer
    size_t: count

    if: target = 0 || source = 0
        return: 1
    if: c.fflush(source) != 0 || c.fseek(source, 0L, c.SEEK_SET) != 0
        return: 1

    count: c.fread(buffer, 1U, c.sizeof(buffer), source)
    while: count != 0U
        if: c.fwrite(buffer, 1U, count, target) != count
            return: 1
        count: c.fread(buffer, 1U, c.sizeof(buffer), source)

    if: c.ferror(source)
        return: 1
return: 0

fn: lm_trans_temp_output_path_new (const: @(char output_path); const: @(char suffix)) @: char
    size_t: output_length
    size_t: suffix_length
    @: char result

    if: output_path = 0 || suffix = 0
        return: 0

    output_length: c.strlen(output_path)
    suffix_length: c.strlen(suffix)
    result: lm_own_new_zero(output_length + suffix_length + 1U)
    if: result = 0
        return: 0
    c.memcpy(result, output_path, output_length)
    c.memcpy(result + output_length, suffix, suffix_length + 1U)
return: result

fn: lm_trans_unwrap_single_anonymous_structure (const: @(LmP0Structure structure)) const: @: LmP0Structure
    const: @: LmP0Field field
    const: @: LmP0Structure current

    current: structure
    while: current != 0
        field: current\first_field
        if: field = 0 || field\next != 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_STRUCTURE
            break
        current: field\value\as\structure
return: current

fn: lm_trans_hash_bytes (const: @(char data); size_t: length) ulong
    ulong: hash
    size_t: i

    hash: 2166136261UL
    i: 0U
    while: i < length
        hash: hash ^ (cast: uchar data[i])
        hash: hash * 16777619UL
        i: i + 1U
return: hash

fn: lm_trans_hash_cstr (const: @(char text)) ulong
    if: text != 0
        return: lm_trans_hash_bytes(text, c.strlen(text))
return: 0UL

sub: lm_trans_ptr_stack_remove_pointer (@: LmOwnPtrStack stack; const: @(void item))
    size_t: i

    if: stack = 0 || item = 0
        return

    i: stack\count
    while: i > 0U
        i: i - 1U
        if: stack\items[i] = item
            while: i + 1U < stack\count
                stack\items[i]: stack\items[i + 1U]
                i: i + 1U
            stack\count: stack\count - 1U
            stack\items[stack\count]: 0
            return
end: lm_trans_ptr_stack_remove_pointer

sub: lm_trans_identifier_relation_destroy (@: LmTransIdentifierRelation relation)
    if: relation != 0
        lm_trans_ptr_stack_delete(@ relation\symbols)
    lm_own_delete(relation, 0)
end: lm_trans_identifier_relation_destroy

sub: lm_trans_identifier_card_destroy (@: LmTransIdentifierCard card)
    size_t: i
    @: LmTransIdentifierRelation relation
    @: LmTransIdentifierRelation next

    if: card = 0
        return

    lm_trans_ptr_stack_delete(@ card\symbols)
    if: card\relation_buckets != 0
        i: 0U
        while: i < card\relation_bucket_count
            relation: card\relation_buckets[i]
            while: relation != 0
                next: relation\next
                lm_trans_identifier_relation_destroy(relation)
                relation: next
            i: i + 1U
        ---
    lm_own_delete(card\relation_buckets, 0)
    card\relation_buckets: 0
    card\relation_bucket_count: 0U
    lm_trans_text_ref_destroy(@ card\name)
    lm_own_delete(card\name_storage, 0)
    card\name_storage: 0
    lm_own_delete(card, 0)
end: lm_trans_identifier_card_destroy

sub: lm_trans_identifier_table_init (@: LmTransIdentifierTable table)
    if: table != 0
        table\buckets: 0
        table\bucket_count: 0U
        table\count: 0U
end: lm_trans_identifier_table_init

fn: lm_trans_identifier_table_ensure_buckets (@: LmTransIdentifierTable table) int
    size_t: bucket_count

    if: table = 0
        return: 1
    if: table\buckets != 0
        return: 0

    bucket_count: 257U
    table\buckets: lm_own_new_zero(bucket_count * c.sizeof(table\buckets[0]))
    if: table\buckets = 0
        return: 1
    table\bucket_count: bucket_count
return: 0

sub: lm_trans_identifier_table_destroy (@: LmTransIdentifierTable table)
    size_t: i
    @: LmTransIdentifierCard card
    @: LmTransIdentifierCard next

    if: table = 0
        return

    if: table\buckets != 0
        i: 0U
        while: i < table\bucket_count
            card: table\buckets[i]
            while: card != 0
                next: card\next
                lm_trans_identifier_card_destroy(card)
                card: next
            i: i + 1U
        ---
    lm_own_delete(table\buckets, 0)
    table\buckets: 0
    table\bucket_count: 0U
    table\count: 0U
end: lm_trans_identifier_table_destroy

fn: lm_trans_identifier_table_new () @: LmTransIdentifierTable
    @: LmTransIdentifierTable table

    table: lm_own_new_zero(c.sizeof(table[0]))
    if: table != 0
        lm_trans_identifier_table_init(table)
return: table

sub: lm_trans_identifier_table_delete (@@(LmTransIdentifierTable table))
    if: table != 0 && table[0] != 0
        lm_trans_identifier_table_destroy(table[0])
        lm_own_delete(table[0], 0)
        table[0]: 0
end: lm_trans_identifier_table_delete

fn: lm_trans_identifier_table_find_card (const: @(LmTransIdentifierTable table); const: @(LmP0Text name)) @: LmTransIdentifierCard
    @: LmP0Text payload
    ulong: hash
    size_t: bucket
    @: LmTransIdentifierCard card

    payload: lm_trans_text_ref_new(0)
    if: payload = 0
        return: 0
    if: table = 0 || table\buckets = 0 || table\bucket_count = 0U || lm_trans_identifier_payload(name, payload) = 0
        lm_trans_text_ref_destroy(@ payload)
        return: 0

    hash: lm_trans_hash_bytes(payload\data, payload\length)
    bucket: hash % table\bucket_count
    card: table\buckets[bucket]
    while: card != 0
        if: card\hash = hash && card\name != 0 && lm_trans_text_same(card\name, payload)
            lm_trans_text_ref_destroy(@ payload)
            return: card
        card: card\next
    lm_trans_text_ref_destroy(@ payload)
return: 0

fn: lm_trans_identifier_table_get_card (@: LmTransIdentifierTable table; const: @(LmP0Text name)) @: LmTransIdentifierCard
    @: LmP0Text payload
    ulong: hash
    size_t: bucket
    @: LmTransIdentifierCard card
    @: char copy

    payload: lm_trans_text_ref_new(0)
    if: payload = 0
        return: 0
    if: table = 0 || lm_trans_identifier_payload(name, payload) = 0 || lm_trans_identifier_table_ensure_buckets(table) != 0
        lm_trans_text_ref_destroy(@ payload)
        return: 0

    card: lm_trans_identifier_table_find_card(table, name)
    if: card != 0
        lm_trans_text_ref_destroy(@ payload)
        return: card

    hash: lm_trans_hash_bytes(payload\data, payload\length)
    bucket: hash % table\bucket_count
    card: lm_own_new_zero(c.sizeof(card[0]))
    if: card = 0
        lm_trans_text_ref_destroy(@ payload)
        return: 0

    copy: lm_trans_text_copy_cstr(payload)
    if: copy = 0
        lm_trans_text_ref_destroy(@ payload)
        lm_trans_identifier_card_destroy(card)
        return: 0
    card\name_storage: copy
    card\name: lm_trans_text_ref_new_cstr(copy)
    if: card\name = 0
        lm_trans_text_ref_destroy(@ payload)
        lm_trans_identifier_card_destroy(card)
        return: 0

    card\symbols: lm_trans_ptr_stack_new(0)
    if: card\symbols = 0
        lm_trans_text_ref_destroy(@ payload)
        lm_trans_identifier_card_destroy(card)
        return: 0
    card\relation_bucket_count: 31U
    card\relation_buckets: lm_own_new_zero(card\relation_bucket_count * c.sizeof(card\relation_buckets[0]))
    if: card\relation_buckets = 0
        lm_trans_text_ref_destroy(@ payload)
        lm_trans_identifier_card_destroy(card)
        return: 0

    card\hash: hash
    card\next: table\buckets[bucket]
    table\buckets[bucket]: card
    table\count: table\count + 1U
    lm_trans_text_ref_destroy(@ payload)
return: card

fn: lm_trans_identifier_card_find_relation (const: @(LmTransIdentifierCard card); const: @(char relation_name)) @: LmTransIdentifierRelation
    ulong: hash
    size_t: bucket
    @: LmTransIdentifierRelation relation

    if: card = 0 || relation_name = 0 || card\relation_buckets = 0 || card\relation_bucket_count = 0U
        return: 0

    hash: lm_trans_hash_cstr(relation_name)
    bucket: hash % card\relation_bucket_count
    relation: card\relation_buckets[bucket]
    while: relation != 0
        if: relation\name != 0 && c.strcmp(relation\name, relation_name) = 0
            return: relation
        relation: relation\next
return: 0

fn: lm_trans_identifier_card_get_relation (@: LmTransIdentifierCard card; const: @(char relation_name)) @: LmTransIdentifierRelation
    ulong: hash
    size_t: bucket
    @: LmTransIdentifierRelation relation

    if: card = 0 || relation_name = 0 || card\relation_buckets = 0 || card\relation_bucket_count = 0U
        return: 0

    hash: lm_trans_hash_cstr(relation_name)
    bucket: hash % card\relation_bucket_count
    relation: card\relation_buckets[bucket]
    while: relation != 0
        if: relation\name != 0 && c.strcmp(relation\name, relation_name) = 0
            return: relation
        relation: relation\next

    relation: lm_own_new_zero(c.sizeof(relation[0]))
    if: relation = 0
        return: 0
    relation\name: relation_name
    relation\symbols: lm_trans_ptr_stack_new(0)
    if: relation\symbols = 0
        lm_own_delete(relation, 0)
        return: 0
    relation\next: card\relation_buckets[bucket]
    card\relation_buckets[bucket]: relation
return: relation

fn: lm_trans_identifier_table_add_symbol (@: LmTransIdentifierTable table; @: LmTransSymbol symbol) int
    @: LmTransIdentifierCard card
    @: LmTransIdentifierRelation relation

    if: table = 0 || symbol = 0 || symbol\name = 0
        return: 1

    card: lm_trans_identifier_table_get_card(table, symbol\name)
    if: card = 0
        return: 1
    relation: lm_trans_identifier_card_get_relation(card, symbol\class_name)
    if: relation = 0
        return: 1
    if: lm_own_ptr_stack_push(card\symbols, symbol) != 0
        return: 1
    if: lm_own_ptr_stack_push(relation\symbols, symbol) != 0
        lm_trans_ptr_stack_remove_pointer(card\symbols, symbol)
        return: 1
return: 0

fn: lm_trans_identifier_table_add_relation_symbol (@: LmTransIdentifierTable table; @: LmTransSymbol symbol) int
    @: LmTransIdentifierCard card
    @: LmTransIdentifierRelation relation

    if: table = 0 || symbol = 0 || symbol\name = 0
        return: 1

    card: lm_trans_identifier_table_get_card(table, symbol\name)
    if: card = 0
        return: 1
    relation: lm_trans_identifier_card_get_relation(card, symbol\class_name)
    if: relation = 0
        return: 1
return: lm_own_ptr_stack_push(relation\symbols, symbol)

sub: lm_trans_identifier_table_remove_symbol (@: LmTransIdentifierTable table; const: @(LmTransSymbol symbol))
    @: LmTransIdentifierCard card
    @: LmTransIdentifierRelation relation

    if: table = 0 || symbol = 0 || symbol\name = 0
        return

    card: lm_trans_identifier_table_find_card(table, symbol\name)
    if: card = 0
        return
    lm_trans_ptr_stack_remove_pointer(card\symbols, symbol)
    relation: lm_trans_identifier_card_get_relation(card, symbol\class_name)
    if: relation != 0
        lm_trans_ptr_stack_remove_pointer(relation\symbols, symbol)
end: lm_trans_identifier_table_remove_symbol

fn: lm_trans_identifier_table_find_latest_symbol (const: @(LmTransIdentifierTable table); const: @(LmP0Text name)) @: LmTransSymbol
    @: LmTransIdentifierCard card

    card: lm_trans_identifier_table_find_card(table, name)
    if: card = 0
        return: 0
return: lm_own_ptr_stack_top(card\symbols)

fn: lm_trans_symbol_new (const: @(LmP0Text name); const: @(char kind); unsigned: depth) @: LmTransSymbol
    @: LmTransSymbol symbol

    symbol: lm_own_new_zero(c.sizeof(symbol[0]))
    if: symbol = 0
        return: 0

    symbol\name: lm_trans_text_ref_new(name)
    if: symbol\name = 0
        lm_trans_symbol_destroy(symbol)
        return: 0
    symbol\c_name: lm_trans_text_ref_new_cstr("")
    symbol\env_arg: lm_trans_text_ref_new_cstr("")
    symbol\closure_call_name: lm_trans_text_ref_new_cstr("")
    if: symbol\c_name = 0 || symbol\env_arg = 0 || symbol\closure_call_name = 0
        lm_trans_symbol_destroy(symbol)
        return: 0

    symbol\param_names: lm_trans_ptr_stack_new(lm_trans_text_ref_delete_any)
    if: symbol\param_names = 0
        lm_trans_symbol_destroy(symbol)
        return: 0
    symbol\class_name: kind
    symbol\depth: depth
return: symbol

fn: lm_trans_symbol_set_owned_name (@: LmTransSymbol symbol; const: @(LmP0Text name)) int
    @: char copy

    if: symbol = 0 || symbol\name = 0 || name = 0
        return: 1

    copy: lm_own_new_zero(name\length + 1U)
    if: copy = 0
        return: 1
    c.memcpy(copy, name\data, name\length)
    copy[name\length]: '\0'

    lm_own_delete(symbol\name_storage, 0)
    symbol\name_storage: copy
    symbol\name\data: copy
    symbol\name\length: name\length
return: 0

fn: lm_trans_symbol_set_c_name (@: LmTransSymbol symbol; const: @(LmP0Text c_name)) int
    @: char copy

    if: symbol = 0 || symbol\c_name = 0 || c_name = 0
        return: 1

    copy: lm_own_new_zero(c_name\length + 1U)
    if: copy = 0
        return: 1
    c.memcpy(copy, c_name\data, c_name\length)
    copy[c_name\length]: '\0'

    lm_own_delete(symbol\c_name_storage, 0)
    symbol\c_name_storage: copy
    symbol\c_name\data: copy
    symbol\c_name\length: c_name\length
    symbol\has_c_name: 1
return: 0

fn: lm_trans_symbol_set_env_arg (@: LmTransSymbol symbol; const: @(LmP0Text env_arg)) int
    @: char copy

    if: symbol = 0 || symbol\env_arg = 0 || env_arg = 0
        return: 1

    copy: lm_own_new_zero(env_arg\length + 1U)
    if: copy = 0
        return: 1
    c.memcpy(copy, env_arg\data, env_arg\length)
    copy[env_arg\length]: '\0'

    lm_own_delete(symbol\env_arg_storage, 0)
    symbol\env_arg_storage: copy
    symbol\env_arg\data: copy
    symbol\env_arg\length: env_arg\length
    symbol\has_env_arg: 1
return: 0

fn: lm_trans_symbol_set_closure_call_name (@: LmTransSymbol symbol; const: @(LmP0Text closure_call_name)) int
    @: char copy

    if: symbol = 0 || symbol\closure_call_name = 0 || closure_call_name = 0
        return: 1

    copy: lm_own_new_zero(closure_call_name\length + 1U)
    if: copy = 0
        return: 1
    c.memcpy(copy, closure_call_name\data, closure_call_name\length)
    copy[closure_call_name\length]: '\0'

    lm_own_delete(symbol\closure_call_name_storage, 0)
    symbol\closure_call_name_storage: copy
    symbol\closure_call_name\data: copy
    symbol\closure_call_name\length: closure_call_name\length
    symbol\has_closure_call_name: 1
return: 0

fn: lm_trans_capture_init_fields (@: LmTransCapture capture) int
    if: capture = 0
        return: 1
    if: capture\name = 0
        capture\name: lm_trans_text_ref_new_cstr("")
    if: capture\type_head = 0
        capture\type_head: lm_trans_text_ref_new_cstr("")
return: capture\name = 0 || capture\type_head = 0

fn: lm_trans_capture_reset (@: LmTransCapture capture) int
    if: lm_trans_capture_init_fields(capture) != 0
        return: 1
    capture\name\data: ""
    capture\name\length: 0U
    capture\type_head\data: ""
    capture\type_head\length: 0U
    capture\type_node: 0
    capture\pointer_depth: 0U
    capture\type_is_head: 0
return: 0

fn: lm_trans_capture_new (const: @(LmP0Text name); const: @(LmP0Text type_head); const: @(LmP0Node type_node); size_t: pointer_depth; int: type_is_head) @: LmTransCapture
    @: LmTransCapture capture

    if: name = 0 || type_head = 0
        return: 0
    capture: lm_own_new_zero(c.sizeof(capture[0]))
    if: capture != 0
        if: lm_trans_capture_init_fields(capture) != 0
            lm_trans_text_ref_destroy(@ capture\name)
            lm_trans_text_ref_destroy(@ capture\type_head)
            lm_own_delete(capture, 0)
            return: 0
        capture\name[0]: name[0]
        capture\type_head[0]: type_head[0]
        capture\type_node: type_node
        capture\pointer_depth: pointer_depth
        capture\type_is_head: type_is_head
return: capture

sub: lm_trans_capture_destroy (@: LmTransCapture capture)
    if: capture != 0
        lm_trans_text_ref_destroy(@ capture\name)
        lm_trans_text_ref_destroy(@ capture\type_head)
    lm_own_delete(capture, 0)
end: lm_trans_capture_destroy

sub: lm_trans_capture_delete_any (@: void object)
    lm_trans_capture_destroy(cast: (@: LmTransCapture) object)
end: lm_trans_capture_delete_any

sub: lm_trans_hoisted_function_destroy (@: LmTransHoistedFunction function)
    if: function != 0
        lm_trans_function_header_destroy(function\function)
        function\function: 0
        lm_trans_ptr_stack_delete(@ function\captures)
        lm_own_delete(function\c_name_storage, 0)
        function\c_name_storage: 0
        lm_own_delete(function\env_type_storage, 0)
        function\env_type_storage: 0
        lm_own_delete(function\env_var_storage, 0)
        function\env_var_storage: 0
        lm_own_delete(function\closure_call_storage, 0)
        function\closure_call_storage: 0
        lm_trans_text_ref_destroy(@ function\env_var_name)
        lm_trans_text_ref_destroy(@ function\closure_call_name)
    lm_own_delete(function, 0)
end: lm_trans_hoisted_function_destroy

sub: lm_trans_hoisted_function_delete_any (@: void object)
    lm_trans_hoisted_function_destroy(cast: (@: LmTransHoistedFunction) object)
end: lm_trans_hoisted_function_delete_any

fn: lm_trans_cleanup_new (unsigned: id) @: LmTransCleanup
    @: LmTransCleanup cleanup

    cleanup: lm_own_new_zero(c.sizeof(cleanup[0]))
    if: cleanup != 0
        cleanup\id: id
return: cleanup

sub: lm_trans_cleanup_destroy (@: LmTransCleanup cleanup)
    lm_own_delete(cleanup, 0)
end: lm_trans_cleanup_destroy

sub: lm_trans_cleanup_delete_any (@: void object)
    lm_trans_cleanup_destroy(cast: (@: LmTransCleanup) object)
end: lm_trans_cleanup_delete_any

fn: lm_trans_loop_new (size_t: cleanup_base) @: LmTransLoop
    @: LmTransLoop loop

    loop: lm_own_new_zero(c.sizeof(loop[0]))
    if: loop != 0
        loop\cleanup_base: cleanup_base
return: loop

sub: lm_trans_loop_destroy (@: LmTransLoop loop)
    lm_own_delete(loop, 0)
end: lm_trans_loop_destroy

sub: lm_trans_loop_delete_any (@: void object)
    lm_trans_loop_destroy(cast: (@: LmTransLoop) object)
end: lm_trans_loop_delete_any

fn: lm_trans_namespace_new () @: LmTransNamespace
    @: LmTransNamespace namespace_

    namespace_: lm_own_new_zero(c.sizeof(namespace_[0]))
    if: namespace_ != 0
        namespace_\items: lm_trans_ptr_stack_new(lm_trans_symbol_delete_any)
        namespace_\identifiers: lm_trans_identifier_table_new()
        namespace_\registry_identifiers: 0
        if: lm_trans_registry != 0
            namespace_\registry_identifiers: lm_trans_registry\identifiers
        namespace_\cleanups: lm_trans_ptr_stack_new(lm_trans_cleanup_delete_any)
        namespace_\loops: lm_trans_ptr_stack_new(lm_trans_loop_delete_any)
        if: namespace_\items = 0 || namespace_\identifiers = 0 || namespace_\cleanups = 0 || namespace_\loops = 0
            lm_trans_identifier_table_delete(@ namespace_\identifiers)
            lm_trans_ptr_stack_delete(@ namespace_\items)
            lm_trans_ptr_stack_delete(@ namespace_\cleanups)
            lm_trans_ptr_stack_delete(@ namespace_\loops)
            lm_own_delete(namespace_, 0)
            return: 0
return: namespace_

sub: lm_trans_namespace_destroy (@: LmTransNamespace namespace_)
    if: namespace_ != 0
        lm_trans_identifier_table_delete(@ namespace_\identifiers)
        namespace_\registry_identifiers: 0
        lm_trans_ptr_stack_delete(@ namespace_\items)
        lm_trans_ptr_stack_delete(@ namespace_\cleanups)
        lm_trans_ptr_stack_delete(@ namespace_\loops)
        namespace_\depth: 0U
        namespace_\next_cleanup_id: 0U
        namespace_\return_type_node: 0
        namespace_\return_type_is_struct: 0
        lm_trans_text_ref_destroy(@ namespace_\return_type_name)
        namespace_\next_return_id: 0U
        namespace_\hoisted_functions: 0
end: lm_trans_namespace_destroy

sub: lm_trans_namespace_destroy_any (@: void object)
    lm_trans_namespace_destroy(cast: (@: LmTransNamespace) object)
end: lm_trans_namespace_destroy_any

sub: lm_trans_namespace_delete (@: LmTransNamespace namespace_)
    lm_own_delete(namespace_, lm_trans_namespace_destroy_any)
end: lm_trans_namespace_delete

sub: lm_trans_namespace_enter_scope (@: LmTransNamespace namespace_)
    if: namespace_ != 0
        namespace_\depth: namespace_\depth + 1U
end: lm_trans_namespace_enter_scope

sub: lm_trans_namespace_leave_scope (@: LmTransNamespace namespace_)
    @: LmTransSymbol symbol

    if: namespace_ = 0
        return

    while: namespace_\items != 0 && namespace_\items\count > 0U
        symbol: lm_own_ptr_stack_top(namespace_\items)
        if: symbol = 0 || symbol\depth != namespace_\depth
            break
        symbol: lm_own_ptr_stack_pop(namespace_\items)
        lm_trans_identifier_table_remove_symbol(namespace_\identifiers, symbol)
        lm_trans_symbol_destroy(symbol)

    if: namespace_\depth > 0U
        namespace_\depth: namespace_\depth - 1U
end: lm_trans_namespace_leave_scope

fn: lm_trans_cleanup_push (@: LmTransNamespace namespace_; unsigned: id) int
    @: LmTransCleanup cleanup

    if: namespace_ = 0
        return: 1

    cleanup: lm_trans_cleanup_new(id)
    if: cleanup = 0
        return: 1
    if: namespace_\cleanups = 0 || lm_own_ptr_stack_push(namespace_\cleanups, cleanup) != 0
        lm_trans_cleanup_destroy(cleanup)
        return: 1
return: 0

sub: lm_trans_cleanup_pop (@: LmTransNamespace namespace_)
    @: LmTransCleanup cleanup

    if: namespace_ != 0
        cleanup: lm_own_ptr_stack_pop(namespace_\cleanups)
        lm_trans_cleanup_destroy(cleanup)
end: lm_trans_cleanup_pop

fn: lm_trans_loop_push (@: LmTransNamespace namespace_) int
    @: LmTransLoop loop

    if: namespace_ = 0
        return: 1

    if: namespace_\cleanups = 0 || namespace_\loops = 0
        return: 1
    loop: lm_trans_loop_new(namespace_\cleanups\count)
    if: loop = 0
        return: 1
    if: lm_own_ptr_stack_push(namespace_\loops, loop) != 0
        lm_trans_loop_destroy(loop)
        return: 1
return: 0

sub: lm_trans_loop_pop (@: LmTransNamespace namespace_)
    @: LmTransLoop loop

    if: namespace_ != 0
        loop: lm_own_ptr_stack_pop(namespace_\loops)
        lm_trans_loop_destroy(loop)
end: lm_trans_loop_pop

fn: lm_trans_loop_cleanup_base (const: @(LmTransNamespace namespace_)) size_t
    const: @: LmTransLoop loop

    if: namespace_ = 0 || namespace_\loops = 0 || namespace_\loops\count = 0U
        if: namespace_ != 0 && namespace_\cleanups != 0
            return: namespace_\cleanups\count
        return: 0U

    loop: lm_own_ptr_stack_top(namespace_\loops)
    if: loop != 0
        return: loop\cleanup_base
return: namespace_\cleanups\count

fn: lm_trans_emit_sync_name (@: FILE file; unsigned: id) int
    if: c.fprintf(file, "lm_sync_%u", id) < 0
        return: 1
return: 0

fn: lm_trans_emit_return_name (@: FILE file; unsigned: id) int
    if: c.fprintf(file, "lm_return_%u", id) < 0
        return: 1
return: 0

fn: lm_trans_namespace_find (const: @(LmTransNamespace namespace_); const: @(LmP0Text name)) const: @: LmTransSymbol
    if: namespace_ = 0
        return: 0
return: lm_trans_identifier_table_find_latest_symbol(namespace_\identifiers, name)

fn: lm_trans_namespace_find_mutable (@: LmTransNamespace namespace_; const: @(LmP0Text name)) @: LmTransSymbol
    if: namespace_ = 0
        return: 0
return: lm_trans_identifier_table_find_latest_symbol(namespace_\identifiers, name)

fn: lm_trans_namespace_relation_symbol_latest (const: @(LmTransNamespace namespace_); const: @(LmP0Text name); const: @(char relation_name)) const: @: LmTransSymbol
    @: LmTransIdentifierCard card
    @: LmTransIdentifierRelation relation

    if: namespace_ = 0 || namespace_\identifiers = 0 || name = 0 || relation_name = 0
        return: 0
    card: lm_trans_identifier_table_find_card(namespace_\identifiers, name)
    if: card = 0
        return: 0
    relation: lm_trans_identifier_card_find_relation(card, relation_name)
    if: relation = 0
        return: 0
return: lm_own_ptr_stack_top(relation\symbols)

fn: lm_trans_namespace_relation_text_latest (const: @(LmTransNamespace namespace_); const: @(LmP0Text name); const: @(char relation_name); @: LmP0Text out_text) int
    const: @: LmTransSymbol symbol

    if: out_text != 0
        out_text\data: ""
        out_text\length: 0U
    if: out_text = 0
        return: 0

    symbol: lm_trans_namespace_relation_symbol_latest(namespace_, name, relation_name)
    if: symbol = 0 || symbol\has_c_name = 0 || symbol\c_name = 0
        return: 0
    out_text[0]: symbol\c_name[0]
return: 1

fn: lm_trans_is_c_reference_name (const: @(LmP0Text name)) int
return: name != 0 && lm_trans_text_starts_with(name, "c.") && name\length > 2U

fn: lm_trans_is_reserved_head_name (const: @(LmP0Text name)) int
    const: @: char namespace_class

    if: name = 0
        return: 0
    namespace_class: lm_trans_registry_lookup_table_link_checked(name, "namespace", "receiver.type")
return: namespace_class != 0

fn: lm_trans_head_binding_resolve (const: @(LmTransNamespace namespace_); const: @(LmP0Text head); @: LmTransHeadBinding out) int
    @: LmTransBinding resolved
    int: receiver_status

    if: head = 0 || out = 0
        return: 1

    resolved: lm_own_new_zero(c.sizeof(resolved[0]))
    if: resolved = 0
        return: 1
    c.memset(out, 0, c.sizeof(out[0]))
    out\symbol: lm_trans_namespace_find(namespace_, head)
    out\receiver_type: lm_trans_namespace_registry_lookup_table_link_checked(namespace_, head, "namespace", "receiver.type")

    out\function_receiver_binding: lm_trans_namespace_registry_lookup(namespace_, head, "receiver.function")
    if: out\function_receiver_binding != 0
        receiver_status: lm_trans_binding_resolve(out\function_receiver_binding, resolved)
        if: receiver_status = 0 || resolved\function_receiver = 0
            c.fprintf(c.stderr, "trans registry inconsistency: receiver.function[\"%.*s\"] has unknown function binding %s\n", (cast: int head\length), head\data, out\function_receiver_binding)
            lm_own_delete(resolved, 0)
            return: 1
        out\function_receiver: resolved\function_receiver

    out\statement_receiver_binding: lm_trans_namespace_registry_lookup(namespace_, head, "receiver.statement")
    if: out\statement_receiver_binding != 0
        if: lm_trans_binding_resolve(out\statement_receiver_binding, resolved) = 0 || resolved\statement_frame = 0
            c.fprintf(c.stderr, "trans registry inconsistency: receiver.statement[\"%.*s\"] has unknown statement binding %s\n", (cast: int head\length), head\data, out\statement_receiver_binding)
            lm_own_delete(resolved, 0)
            return: 1
        out\statement_frame: resolved\statement_frame

    lm_own_delete(resolved, 0)
return: 0

fn: lm_trans_namespace_declare_with_c_name (@: LmTransNamespace namespace_; const: @(LmP0Text name); const: @(char kind); const: @(LmP0Text c_name)) int
    @: LmTransSymbol symbol

    if: namespace_ = 0 || name = 0
        return: 1

    if: lm_trans_is_c_reference_name(name)
        c.fprintf(c.stderr, "trans L2 error: C-surface spelling \"%.*s\" cannot be declared as a Lingvamyxa name\n", (cast: int name\length), name\data)
        return: 1

    symbol: lm_trans_symbol_new(name, kind, namespace_\depth)
    if: symbol = 0
        return: 1
    if: c_name != 0 && lm_trans_symbol_set_c_name(symbol, c_name) != 0
        lm_trans_symbol_destroy(symbol)
        return: 1
    if: namespace_\items = 0 || lm_own_ptr_stack_push(namespace_\items, symbol) != 0
        lm_trans_symbol_destroy(symbol)
        return: 1
    if: lm_trans_identifier_table_add_symbol(namespace_\identifiers, symbol) != 0
        symbol: lm_own_ptr_stack_pop(namespace_\items)
        lm_trans_symbol_destroy(symbol)
        return: 1
return: 0

fn: lm_trans_namespace_declare (@: LmTransNamespace namespace_; const: @(LmP0Text name); const: @(char kind)) int
return: lm_trans_namespace_declare_with_c_name(namespace_, name, kind, 0)

fn: lm_trans_namespace_declare_generated (@: LmTransNamespace namespace_; const: @(LmP0Text name); const: @(char kind)) int
    const: @: LmTransSymbol existing
    @: LmTransSymbol symbol

    if: namespace_ = 0 || name = 0
        return: 1

    existing: lm_trans_namespace_find(namespace_, name)
    if: existing != 0
        if: lm_trans_symbol_is(existing, kind)
            return: 0
        c.fprintf(c.stderr, "trans L2 error: generated name \"%.*s\" is already visible as %s\n", (cast: int name\length), name\data, lm_trans_symbol_class_name(existing\class_name))
        return: 1

    symbol: lm_trans_symbol_new(name, kind, namespace_\depth)
    if: symbol = 0
        return: 1
    if: lm_trans_symbol_set_owned_name(symbol, name) != 0
        lm_trans_symbol_destroy(symbol)
        return: 1
    if: namespace_\items = 0 || lm_own_ptr_stack_push(namespace_\items, symbol) != 0
        lm_trans_symbol_destroy(symbol)
        return: 1
    if: lm_trans_identifier_table_add_symbol(namespace_\identifiers, symbol) != 0
        symbol: lm_own_ptr_stack_pop(namespace_\items)
        lm_trans_symbol_destroy(symbol)
        return: 1
return: 0

fn: lm_trans_namespace_attach_registry (@: LmTransNamespace namespace_) int
    if: namespace_ = 0 || lm_trans_registry = 0
        return: 1
    namespace_\registry_identifiers: lm_trans_registry\identifiers
return: 0

fn: lm_trans_namespace_declare_c_name (@: LmTransNamespace namespace_; const: @(LmP0Text name); const: @(char kind); const: @(LmP0Text c_name)) int
return: lm_trans_namespace_declare_with_c_name(namespace_, name, kind, c_name)

fn: lm_trans_namespace_declare_relation_text (@: LmTransNamespace namespace_; const: @(LmP0Text name); const: @(char relation_name); const: @(LmP0Text payload)) int
    @: LmTransSymbol symbol

    if: namespace_ = 0 || name = 0 || relation_name = 0 || payload = 0
        return: 1

    symbol: lm_trans_symbol_new(name, relation_name, namespace_\depth)
    if: symbol = 0
        return: 1
    if: lm_trans_symbol_set_c_name(symbol, payload) != 0
        lm_trans_symbol_destroy(symbol)
        return: 1
    if: namespace_\items = 0 || lm_own_ptr_stack_push(namespace_\items, symbol) != 0
        lm_trans_symbol_destroy(symbol)
        return: 1
    if: lm_trans_identifier_table_add_relation_symbol(namespace_\identifiers, symbol) != 0
        symbol: lm_own_ptr_stack_pop(namespace_\items)
        lm_trans_symbol_destroy(symbol)
        return: 1
return: 0

fn: lm_trans_namespace_set_env_arg (@: LmTransNamespace namespace_; const: @(LmP0Text name); const: @(LmP0Text env_arg)) int
    @: LmTransSymbol symbol

    symbol: lm_trans_namespace_find_mutable(namespace_, name)
    if: symbol = 0
        return: 1
return: lm_trans_symbol_set_env_arg(symbol, env_arg)

fn: lm_trans_namespace_set_closure_call_name (@: LmTransNamespace namespace_; const: @(LmP0Text name); const: @(LmP0Text closure_call_name)) int
    @: LmTransSymbol symbol

    symbol: lm_trans_namespace_find_mutable(namespace_, name)
    if: symbol = 0
        return: 1
return: lm_trans_symbol_set_closure_call_name(symbol, closure_call_name)

fn: lm_trans_symbol_copy_signature (@: LmTransSymbol target; const: @(LmTransSymbol source)) int
    size_t: i
    const: @: LmP0Text source_name
    @: LmP0Text copy

    if: target = 0 || source = 0
        return: 1

    if: target\param_names = 0
        target\param_names: lm_trans_ptr_stack_new(lm_trans_text_ref_delete_any)
        if: target\param_names = 0
            return: 1
        ---
    else:
        lm_own_ptr_stack_destroy(target\param_names)
        lm_own_ptr_stack_init(target\param_names, lm_trans_text_ref_delete_any)
    if: source\param_names = 0
        return: 0
    i: 0U
    while: i < source\param_names\count
        source_name: lm_own_ptr_stack_at(source\param_names, i)
        if: source_name = 0
            return: 1
        copy: lm_trans_text_ref_new(source_name)
        if: copy = 0
            return: 1
        if: lm_own_ptr_stack_push(target\param_names, copy) != 0
            lm_trans_text_ref_delete_any(copy)
            return: 1
        i: i + 1U
    ---
    target\has_signature: source\has_signature
    target\callable_params_node: source\callable_params_node
    target\callable_return_node: source\callable_return_node
    target\has_callable_shape: source\has_callable_shape
    target\callable_returns_value: source\callable_returns_value
    target\callable_is_struct_return: source\callable_is_struct_return
    target\callable_is_external: source\callable_is_external
return: 0

fn: lm_trans_namespace_declare_compatible (@: LmTransNamespace namespace_; const: @(LmP0Text name); const: @(char kind)) int
    const: @: LmTransSymbol existing

    existing: lm_trans_namespace_find(namespace_, name)
    if: existing != 0
        if: lm_trans_symbol_is(existing, kind)
            return: 0
    ---

return: lm_trans_namespace_declare(namespace_, name, kind)

fn: lm_trans_class_c_spelling (const: @(LmP0Text name)) const: @: char
    if: name = 0
        return: 0
return: lm_trans_registry_lookup(name, "class.spelling")

fn: lm_trans_builtin_c_type_tail (const: @(LmP0Text name)) int
    if: name = 0
        return: 0
return: lm_trans_class_c_spelling(name) != 0 || lm_trans_registry_has(name, "class.cTail")

fn: lm_trans_builtin_c_type_name (const: @(LmP0Text name)) int
    @: LmP0Text tail
    int: result

    if: name = 0
        return: 0
    if: lm_trans_text_starts_with(name, "c.") && name\length > 2U
        tail: lm_trans_text_ref_tail_new(name, 2U)
        if: tail = 0
            return: 0
        result: lm_trans_builtin_c_type_tail(tail)
        lm_trans_text_ref_destroy(@ tail)
        return: result

return: lm_trans_builtin_c_type_tail(name)

fn: lm_trans_emit_name (@: FILE file; const: @(LmP0Text name)) int
    const: @: char spelling
    @: LmP0Text tail
    int: status

    if: name = 0
        return: 1
    if: lm_trans_text_starts_with(name, "c.")
        tail: lm_trans_text_ref_tail_new(name, 2U)
        if: tail = 0
            return: 1
        spelling: lm_trans_class_c_spelling(tail)
        if: spelling != 0
            status: lm_trans_put(file, spelling)
            lm_trans_text_ref_destroy(@ tail)
            return: status
        status: lm_trans_write_text(file, tail)
        lm_trans_text_ref_destroy(@ tail)
        return: status

return: lm_trans_emit_identifier(file, name)

fn: lm_trans_emit_type_name (@: FILE file; const: @(LmP0Text name)) int
    const: @: char spelling
    @: LmP0Text tail
    int: status

    if: name = 0
        return: 1
    if: lm_trans_text_starts_with(name, "c.") && name\length > 2U
        tail: lm_trans_text_ref_tail_new(name, 2U)
        if: tail = 0
            return: 1
        spelling: lm_trans_class_c_spelling(tail)
        if: spelling != 0
            status: lm_trans_put(file, spelling)
            lm_trans_text_ref_destroy(@ tail)
            return: status
        status: lm_trans_write_text(file, tail)
        lm_trans_text_ref_destroy(@ tail)
        return: status

    spelling: lm_trans_class_c_spelling(name)
    if: spelling != 0
        return: lm_trans_put(file, spelling)
return: lm_trans_emit_identifier(file, name)

fn: lm_trans_c_reference_has_path_dot (const: @(LmP0Text name)) int
    size_t: i

    if: lm_trans_is_c_reference_name(name) = 0
        return: 0

    i: 2U
    while: i < name\length
        if: name\data[i] = '.'
            return: 1
        i: i + 1U

return: 0

fn: lm_trans_node_is_c_reference_atom (const: @(LmP0Node node)) int
return: node != 0 && node\kind = c.LM_P0_NODE_ATOM && lm_trans_is_c_reference_name(node\as\atom)
