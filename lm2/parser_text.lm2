import: "lm4/own_abi.lm4"

fn: lm_p0_text_equals (const: (LmP0Text: text); const: @(char value)) int
    size_t: value_length

    if: text = 0 || value = 0
        return: 0
    value_length: c.strlen(value)
return: text\length = value_length && c.memcmp(text\data, value, value_length) = 0

fn: lm_p0_identifier_payload (const: (LmP0Text: atom); LmP0Text: out_payload) int
    if: atom = 0 || out_payload = 0 || atom\data = 0
        return: 0

    out_payload\data: atom\data
    out_payload\length: atom\length
    if: atom\length >= 2U && atom\data[0] = '`' && atom\data[atom\length - 1U] = '`'
        out_payload\data: atom\data + 1U
        out_payload\length: atom\length - 2U

return: 1

fn: lm_p0_registry_identifier_value (const: (LmP0Text: atom); LmP0Text: out_payload) int
    if: atom = 0 || out_payload = 0
        return: 0
    if: atom\length > 0U && (atom\data[0] = '"' || atom\data[0] = '\'')
        return: 0
return: lm_p0_identifier_payload(atom, out_payload)

fn: lm_p0_registry_literal_value (const: (LmP0Text: atom); LmP0Text: out_payload) int
    char: quote

    if: atom = 0 || out_payload = 0 || atom\data = 0
        return: 0

    out_payload\data: atom\data
    out_payload\length: atom\length
    if: atom\length < 2U
        return: 1

    quote: atom\data[0]
    if: (quote = '"' || quote = '\'') && atom\data[atom\length - 1U] = quote
        out_payload\data: atom\data + 1U
        out_payload\length: atom\length - 2U
        return: 1

return: lm_p0_identifier_payload(atom, out_payload)

fn: lm_p0_registry_payload_is_null (const: (LmP0Text: atom)) int
    LmP0Text: payload
    int: is_null

    payload: lm_p0_text_view_new_cstr("")
    if: payload = 0
        return: 0
    if: lm_p0_registry_identifier_value(atom, payload) = 0
        lm_p0_text_view_delete(payload)
        return: 0
    is_null: payload\length = 4U && c.memcmp(payload\data, "NULL", 4U) = 0
    lm_p0_text_view_delete(payload)
return: is_null

fn: lm_p0_is_horizontal_space (char: value) int
return: value = ' ' || value = '\t'

fn: lm_p0_is_line_break (char: value) int
return: value = '\n' || value = '\r'

fn: lm_p0_line_break_width_at (const: @(char source); size_t: length; size_t: index) size_t
    if: index >= length
        return: 0U
    if: source[index] = '\r'
        if: index + 1U < length && source[index + 1U] = '\n'
            return: 2U
        return: 1U
    if: source[index] = '\n'
        return: 1U
return: 0U

fn: lm_p0_is_field_space (char: value) int
return: lm_p0_is_horizontal_space(value) || lm_p0_is_line_break(value)

fn: lm_p0_is_field_separator (char: value) int
return: value = ',' || value = ';'

fn: lm_p0_is_short_form_separator (char: value) int
return: value = ';'

fn: lm_p0_is_quoted_token_boundary (char: value) int
return: lm_p0_is_field_space(value) || lm_p0_is_field_separator(value) || value = '(' || value = ')' || value = '#'

fn: lm_p0_starts_python_string (const: @(char text); size_t: length; size_t: index) int
    char: quote

    if: index + 2U >= length
        return: 0
    quote: text[index]
    if: quote != '"' && quote != '\''
        return: 0
return: text[index + 1U] = quote && text[index + 2U] = quote

fn: lm_p0_is_decimal_digit (char: value) int
return: value >= '0' && value <= '9'

fn: lm_p0_copy_bytes (const: @(char source); size_t: length) @: char
return: lm_own_copy_bytes(source, length)

fn: lm_p0_text_view_new_cstr (const: @(char text)) LmP0Text
    LmP0Text: result

    result: lm_own_new_zero(1U * c.sizeof(c.LmP0Text))
    if: result = 0
        return: 0
    if: text != 0
        result\data: text
    if: text = 0
        result\data: ""
    result\length: c.strlen(result\data)
return: result

sub: lm_p0_text_view_delete (LmP0Text: text)
    lm_own_delete(text, 0)
end: lm_p0_text_view_delete

fn: lm_p0_text_from_cstr (const: @(char text)) LmP0Text
    return: lm_p0_text_view_new_cstr(text)

fn: lm_p0_text_assign_cstr (LmP0Text: out_text; const: @(char text)) int
    if: out_text = 0
        return: 0
    if: text = 0
        text: ""
    out_text\data: text
    out_text\length: c.strlen(text)
return: 1

fn: lm_p0_text_copy_cstr (const: (LmP0Text: text)) @: char
    if: text = 0
        return: 0
return: lm_p0_copy_bytes(text\data, text\length)

fn: lm_p0_registry_value_copy_cstr (const: (LmP0Text: value)) @: char
return: lm_p0_text_copy_cstr(value)
